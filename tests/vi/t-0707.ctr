# kiểm thử ép kiểu / chuyển đổi / ràng buộc
Chương-trình quản-lý-bộ-nhớ: 4.
Server init.

>> bộ-đếm := 0.
>> csdl := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'], mật-khẩu: ['pass123'], tên-cơ-sở-dữ-liệu: ['xobase'], kết-nối.

>> Định-dạng-hai-chữ-số := Định-dạng mới: ['%02d'].

# Ngày giờ
{
	>> năm     := Số giữa: 1995 và: 2050, chuỗi.
	>> tháng    := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 12), chuỗi.
	>> ngày      := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 28), chuỗi.
	>> giờ     := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 23), chuỗi.
	>> phút   := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 59), chuỗi.
	>> giây   := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 59), chuỗi.
	>> ngày-giờ := ['YYYY-MM-DD HH:II:SS'].	
	ngày-giờ
		YYYY: năm,
		MM: tháng,
		DD: ngày,
		HH: giờ,
		II: phút,
		SS: giây.
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: ngày-giờ),
	lấy: { :hàng
		(hàng mydatetime = ngày-giờ) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: ngày-giờ,
				<observation>: hàng mydatetime
			).
		}.
	
	}.
	bộ-đếm cộng: 1.
} * 100.

# Ngày
{
	>> năm     := Số giữa: 1995 và: 2050, chuỗi.
	>> tháng    := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 12), chuỗi.
	>> ngày      := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 28), chuỗi.
	>> ngày-tháng     := ['YYYY-MM-DD'].
	ngày-tháng
		YYYY: năm,
		MM: tháng,
		DD: ngày.
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: ngày-tháng),
	lấy: { :hàng
		(hàng mydate = ngày-tháng) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: ngày-tháng,
				<observation>: hàng mydate
			).
		}.
	}.
	bộ-đếm cộng: 1.
} * 100.


# Giờ
{
	>> giờ     := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 23), chuỗi.
	>> phút   := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 59), chuỗi.
	>> giây   := Định-dạng-hai-chữ-số áp-dụng-số-nguyên: (Số giữa: 1 và: 59), chuỗi.
	>> thời-gian := ['HH:II:SS'].
	thời-gian
		HH: giờ,
		II: phút,
		SS: giây.
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: thời-gian),
	lấy: { :hàng
		(hàng mytime = thời-gian) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: ngày-giờ,
				<observation>: hàng mytime
			).
		}.
	}.
	bộ-đếm cộng: 1.
} * 100.


# Chuỗi (varchar/text)
>> str1 := Danh-sách mới điền: 100000 bằng: ['x'], nối: [''].
{
	>> str2 := Két mã-thông-báo: 40.
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	lấy: { :hàng
		(hàng str1 = str1 và: hàng str2 = str2) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: ngày-giờ,
				<observation>: hàng mytime
			).
		}.
	}.
	bộ-đếm cộng: 1.
} * 100.


# Số
{
	>> n1  := Số giữa: 1 và: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 từ-chuỗi: ['9223372036854775807'] ) -
		( Int64 từ-chuỗi: ['99999'] ) +
		( Int64 từ-chuỗi: n1 chuỗi )
	).
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	lấy: { :hàng
		(hàng n1 = n1) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: n1,
				<observation>: hàng n1
			).
		}.
		(hàng n2 = n2) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: n1,
				<observation>: hàng n2
			).
		}.
		(hàng n3 = n2 làm-tròn) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: n1,
				<observation>: hàng n3
			).
		}.
		(hàng big = big) sai: {
			tác-vụ-này lỗi: (
				['Mong đợi: <expected> nhưng nhận được: <observation>']
				<expected>: big,
				<observation>: hàng big
			).
		}.
		
	}.
	bộ-đếm cộng: 1.
} * 100.


Xuất ghi: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: bộ-đếm
), xuống-dòng.