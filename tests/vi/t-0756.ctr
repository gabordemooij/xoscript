Xuất ghi: ['Test object'], xuống-dòng.
>> greeter := Đối-tượng mới.
greeter khi: ['name:'] làm: { :tên
	riêng xname := tên. 
}.
greeter khi: ['greet'] làm: {
	Xuất ghi: ['Hello '] + riêng xname, xuống-dòng.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
>> c := Đối-tượng load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
