>> t := Đúng.
(t = Đúng) đúng: { Xuất ghi: ['T']. }.
(t = Sai) đúng: { Xuất ghi: ['F']. }.
Xuất ghi: ['|'].
>> t := Sai.
(t = Đúng) đúng: { Xuất ghi: ['T']. }.
(t = Sai) đúng: { Xuất ghi: ['F']. }.
Xuất ghi: ['|'].
>> f := Đúng.
(t = Đúng và: f = Sai) đúng: { Xuất ghi: ['T']. }.
(t = Sai và: f = Đúng) đúng: { Xuất ghi: ['F']. }.
Xuất ghi: ['|'].
>> n := Rỗng.
(n Rỗng?) đúng: { Xuất ghi: ['T']. }.
(n Rỗng?) sai: { Xuất ghi: ['F']. }.
Xuất ghi: ['|'].
(f Boolean?) đúng: { Xuất ghi: ['T']. }.
(f Boolean?) sai: { Xuất ghi: ['F']. }.



