# một nhóm không thuộc kết quả khớp không được gây sập và phải giữ số thứ tự nhóm
Server init.
>> hiển-thị := { :mẫu-regex :subject
	>> p := Mẫu mới: mẫu-regex.
	p khớp: subject làm: { :m :g
		Xuất ghi: g đếm, ghi: [' '], ghi: (g nối: ['|']), xuống-dòng.
		<- m.
	}.
}.
hiển-thị áp-dụng: ['(a)|(b)'] và: ['b'].
hiển-thị áp-dụng: ['(a)|(b)'] và: ['a'].
hiển-thị áp-dụng: ['(x)?y'] và: ['y'].
hiển-thị áp-dụng: ['(x)?(y)(z)?'] và: ['xy'].
