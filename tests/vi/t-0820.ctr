# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mẫu mới: pattern.
	p khớp: subject làm: { :m :g
		Xuất ghi: g đếm, ghi: [' '], ghi: (g nối: ['|']), xuống-dòng. <- m.
	}.
}.
show áp-dụng: ['(a)|(b)'] và: ['b'].
show áp-dụng: ['(a)|(b)'] và: ['a'].
show áp-dụng: ['(x)?y'] và: ['y'].
show áp-dụng: ['(x)?(y)(z)?'] và: ['xy'].
