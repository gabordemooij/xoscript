

Chuỗi khi: ['đánh-giá'] làm: {
	>> mã := Tệp mới: ['/tmp/eval.ctr'].
	mã ghi: (bản-thân chuỗi + ['.']).
	Chương-trình dùng: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Danh-sách ← (['Dấu nháy '] + Q + [' là xấu xa?']) ; 1.
>> x := q chuỗi.
Xuất ghi: x, xuống-dòng.
>> y := Rỗng.
(['y := '] + x ) đánh-giá.
Xuất ghi: y ? 0, xuống-dòng.

q := Từ-điển đặt: ['\[''] tại: ['\['quote\']'].
x := q chuỗi.
Xuất ghi: x, xuống-dòng.
y := Rỗng.
(['y := '] + x ) đánh-giá.

>> q := (Từ-điển mới) đặt:['\[''] tại:['\['quote\[''].
Xuất ghi: y ? ['\['quote\']'], xuống-dòng.
