Lôgic khi: ['xor:'] làm: { :a :b <- ((a và: b phủ-định) hoặc: (a phủ-định và: b)).
}.

>> o := Đối-tượng mới.
o khi: ['hello'] làm: { ['Trống']. }.
{ o khi: 2 làm: 3.} bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
{ o khi: ['kiểm-thử'] làm: 3.} bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
{ o khi: ['hello'] làm: { ['Trống']. }.} bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ >> z := 4 ÷ 0. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ (Đúng và: Rỗng) đúng: { Xuất ghi: ['X'].}. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ ([''] xor: 0) đúng: { Xuất ghi: ['X'].}. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ (1 < ['2']) đúng: { Xuất ghi: ['OK']. }. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ (1 < ['2.0']) đúng: { Xuất ghi: ['OK']. }. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ (1 < ['x2.0']) đúng: { Xuất ghi: ['KHÔNG!']. }. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy. 
{ Xuất ghi: (['chào! OK bạn'] từ: ['6'] độ-dài: ['2']). } chạy. 
