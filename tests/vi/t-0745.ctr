Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :dict
	riêng dict := dict. 
}.

a khi: ['item'] làm: { <- riêng dict.
}.

a item: (
Từ-điển mới
	hello: ['world']).

>> old-dict-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-dict-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

Xuất ghi: b item, xuống-dòng.
