Out write: ['Test object'], stop.
>> a := Object new. 

a on: ['item:'] do: { :num
	own num := num. 
}.

a on: ['item'] do: {
	<- own num.
}.

a item: 123.

Out write: a item, stop.

>> old-num-address := a item prototype memory-address.
a save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype memory-address = old-num-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.

Out write: b item, stop.
