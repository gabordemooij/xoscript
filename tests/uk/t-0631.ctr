#ffi test


Server init.

Програма керування-памʼяттю: 4.

# for this test you need set a path to libc (puts)
>> libname := Програма налаштування: ['FFITESTLIB'].



Server звʼязати: (
 Список новий ;
 libname ;
 ['puts'] ;
 ( Список новий ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s звільнити.

# test with struct

>> a := Blob новий: 8.
a bytes: (
	Список <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Список <<: ['int'], ; ['int']).

Server звʼязати: (
	Список <<: ['@structtest'], ;
	['@structtest'] ;
	(Список <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Вивід написати: ['Sum test:'] + (ffitest ffisum: a), новий-рядок.

struct звільнити-struct.
struct звільнити.
a звільнити.
