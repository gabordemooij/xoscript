>> makeAdder := { :x
	>> f := { :y <- (свій x + y). } задати: ['x'] значення: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i свій q поставити: (свій f застосувати: (свій q ? i)) у: i. } 
	задати: ['q'] значення: array,
	задати: ['f'] значення: func.
	{ :i mapping застосувати: i. } × (array кількість).
}.

>> a := Список ← 1; 2; 3.
mapper застосувати: a і: (makeAdder застосувати: 100).
Вивід написати: (a позиція: 0), новий-рядок.
Вивід написати: (a ? 1), новий-рядок.
Вивід написати: (a ? 2), новий-рядок.
