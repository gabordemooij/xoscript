>> створити-суматор := { :x
	>> f := { :y <- (свій x + y). } задати: ['x'] значення: x. <- f.
}.
>> відображувач := { :масив :функ
	>> відображення := { :i свій q поставити: (свій f застосувати: (свій q ? i)) у: i. } 
	задати: ['q'] значення: масив,
	задати: ['f'] значення: функ.
	{ :i відображення застосувати: i. } × (масив кількість).
}.

>> a := Список ← 1; 2; 3.
відображувач застосувати: a і: (створити-суматор застосувати: 100).
Вивід написати: (a позиція: 0), новий-рядок.
Вивід написати: (a ? 1), новий-рядок.
Вивід написати: (a ? 2), новий-рядок.
