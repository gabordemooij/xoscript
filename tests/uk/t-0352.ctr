Число при: ['roman'] виконати: {
	>> число := сам копіювати.
	>> roman := [''].
	{
		{
			(число ≥ 1000) істина: {
				roman додати-в-кінець: ['Ⅿ'].
				число відняти: 1000.
			}, перервати.
		
			(число ≥ 500) істина: {
				roman додати-в-кінець: ['Ⅾ'].
				число відняти: 500.
			}, перервати.
		
			(число ≥ 100) істина: {
				roman додати-в-кінець: ['Ⅽ'].
				число відняти: 100.
			}, перервати.
		
			(число ≥ 50) істина: {
				roman додати-в-кінець: ['Ⅼ'].
				число відняти: 50.
			}, перервати.
		
			(число ≥ 50) істина: {
				roman додати-в-кінець: ['Ⅼ'].
				число відняти: 50.
			}, перервати.
		
			(число ≥ 10) істина: {
				roman додати-в-кінець: ['Ⅹ'].
				число відняти: 10.
			}, перервати.
			
			(число ≥ 9) істина: {
				roman додати-в-кінець: ['Ⅸ'].
				число відняти: 9.
			}, перервати.
			
			(число ≥ 5) істина: {
				roman додати-в-кінець: ['Ⅴ'].
				число відняти: 5.
			}, перервати.
			
			(число ≥ 4) істина: {
				roman додати-в-кінець: ['Ⅳ'].
				число відняти: 4.
			}, перервати.
			
			(число ≥ 1) істина: {
				roman додати-в-кінець: ['Ⅰ'].
				число відняти: 1.
			}, перервати.
		} процедура.
	} поки: { <- число > 0. }. <- roman.
}.

Вивід написати: 1 roman, новий-рядок.
Вивід написати: 2 roman, новий-рядок.
Вивід написати: 4 roman, новий-рядок.
Вивід написати: 8 roman, новий-рядок.
Вивід написати: 16 roman, новий-рядок.
Вивід написати: 32 roman, новий-рядок.
Вивід написати: 64 roman, новий-рядок.
Вивід написати: 128 roman, новий-рядок.
Вивід написати: 256 roman, новий-рядок.
Вивід написати: 1024 roman, новий-рядок.
