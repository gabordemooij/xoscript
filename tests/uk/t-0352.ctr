Число при: ['римське'] виконати: {
	>> число := сам копіювати.
	>> римське := [''].
	{
		{
			(число ≥ 1000) істина: {
				римське додати-в-кінець: ['Ⅿ'].
				число відняти: 1000.
			}, перервати.
		
			(число ≥ 500) істина: {
				римське додати-в-кінець: ['Ⅾ'].
				число відняти: 500.
			}, перервати.
		
			(число ≥ 100) істина: {
				римське додати-в-кінець: ['Ⅽ'].
				число відняти: 100.
			}, перервати.
		
			(число ≥ 50) істина: {
				римське додати-в-кінець: ['Ⅼ'].
				число відняти: 50.
			}, перервати.
		
			(число ≥ 50) істина: {
				римське додати-в-кінець: ['Ⅼ'].
				число відняти: 50.
			}, перервати.
		
			(число ≥ 10) істина: {
				римське додати-в-кінець: ['Ⅹ'].
				число відняти: 10.
			}, перервати.
			
			(число ≥ 9) істина: {
				римське додати-в-кінець: ['Ⅸ'].
				число відняти: 9.
			}, перервати.
			
			(число ≥ 5) істина: {
				римське додати-в-кінець: ['Ⅴ'].
				число відняти: 5.
			}, перервати.
			
			(число ≥ 4) істина: {
				римське додати-в-кінець: ['Ⅳ'].
				число відняти: 4.
			}, перервати.
			
			(число ≥ 1) істина: {
				римське додати-в-кінець: ['Ⅰ'].
				число відняти: 1.
			}, перервати.
		} процедура.
	} поки: { <- число > 0. }. <- римське.
}.

Вивід написати: 1 римське, новий-рядок.
Вивід написати: 2 римське, новий-рядок.
