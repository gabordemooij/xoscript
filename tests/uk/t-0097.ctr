
Текст при: ['html'] виконати: { <- (
		сам
		замінити: ['&'] на: ['&amp;'],
		замінити: ['<'] на: ['&lt;'],
		замінити: ['>'] на: ['&gt;'],
		замінити: ['"'] на: ['&quot;']
	).
}.

>> HtmlBrush := Обʼєкт новий.

HtmlBrush при: ['відповісти:'] виконати: { :tag
	Вивід написати: (['<tag>↵'] tag: tag ).
}.

HtmlBrush при: ['відповісти:і:'] виконати: { :tag :content
	tag := ( tag від: 0 довжина: (tag довжина - 1) ).
	Вивід написати: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush при: ['content:'] виконати: { :text
	Вивід написати: text html, новий-рядок.
}.

HtmlBrush при: ['attr:value:'] виконати: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush новий.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
