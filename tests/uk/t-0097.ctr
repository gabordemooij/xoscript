
Текст при: ['html'] виконати: { <- (
		сам
		замінити: ['&'] на: ['&amp;'],
		замінити: ['<'] на: ['&lt;'],
		замінити: ['>'] на: ['&gt;'],
		замінити: ['"'] на: ['&quot;']
	).
}.

>> Html-пензель := Обʼєкт новий.

Html-пензель при: ['відповісти:'] виконати: { :тег
	Вивід написати: (['<tag>↵'] tag: тег ).
}.

Html-пензель при: ['відповісти:і:'] виконати: { :тег :content
	тег := ( тег від: 0 довжина: (тег довжина - 1) ).
	Вивід написати: (['<tag content>↵'] tag: тег, content: content).
}.

Html-пензель при: ['content:'] виконати: { :напис
	Вивід написати: напис html, новий-рядок.
}.

Html-пензель при: ['атр:значення:'] виконати: { :атр :value <- ['attr="value"'] attr: атр, value: value.
}.

>> h := Html-пензель новий.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h атр: ['class'] значення: ['bold']),
		/span
	/body
/html.
		
