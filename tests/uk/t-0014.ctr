>> Вітальник := Обʼєкт новий.
Вітальник при: ['створити'] виконати: {
	>> вт := Обʼєкт новий.
	вт при: ['setName:'] виконати: { :нове-імʼя
		свій імʼя := нове-імʼя.
	}.
	вт при: ['привітати'] виконати: {
		Вивід написати: свій імʼя.
	}. <- вт.
}.
>> a := Вітальник створити.
>> b := Вітальник створити.
a setName: ['ОДИН'].
b setName: ['ДВА'].
a привітати.
b привітати.
>> c := a новий.
c setName: ['ТРИ'].
c привітати.
>> d := a новий.
d setName: ['ЧОТИРИ'].
d привітати.
c привітати.
