>> Greeter := Обʼєкт новий.
Greeter при: ['make'] виконати: {
	>> gr := Обʼєкт новий.
	gr при: ['setName:'] виконати: { :aname
		свій імʼя := aname.
	}.
	gr при: ['greet'] виконати: {
		Вивід написати: свій імʼя.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a новий.
c setName: ['THREE'].
c greet.
>> d := a новий.
d setName: ['FOUR'].
d greet.
c greet.
