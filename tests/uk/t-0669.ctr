# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сховище 
	хеш-пароля: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сховище 
	хеш-пароля: hash перевірити: a1.
	# fail 
>> b := Сховище
	хеш-пароля: hash перевірити: a2.
	# ok!

Вивід написати: a, новий-рядок.
Вивід написати: b, новий-рядок.

