# Хешування паролів
Server init.

# Користувач задає пароль
>> пар := ['pass123'].

# Ви зберігаєте його ось так
>> відбиток := Сховище 
	хеш-пароля: пар.

# Потім користувач входить
# Спроба 1
>> a1 := ['abcd123'].
# Спроба 2
>> a2 := ['pass123'].

# Перевірка
>> a := Сховище 
	хеш-пароля: відбиток перевірити: a1.
	# невдача 
>> b := Сховище
	хеш-пароля: відбиток перевірити: a2.
	# ок!

Вивід написати: a, новий-рядок.
Вивід написати: b, новий-рядок.

