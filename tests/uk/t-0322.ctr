

>> Матрьошка := Обʼєкт новий.
Матрьошка при: ['double:'] виконати: { :секрет
	свій секрет := секрет × 2.
}.
Матрьошка при: ['новий:'] виконати: { :секрет
	>> відповідь := Ніщо.
	>> t := (секрет > 255).
	Вивід написати: (секрет + [' | '] + t), новий-рядок.
	t істина: {
		відповідь := секрет.
	}, інакше: {
		відповідь := Матрьошка рекурсивний новий: (сам double: секрет).
	}. <- відповідь.
}.

>> x := Матрьошка новий: 2.
