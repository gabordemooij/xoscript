

>> Matryoshka := Обʼєкт новий.
Matryoshka при: ['double:'] виконати: { :secret
	свій secret := secret × 2.
}.
Matryoshka при: ['новий:'] виконати: { :secret
	>> answer := Ніщо.
	>> t := (secret > 255).
	Вивід написати: (secret + [' | '] + t), новий-рядок.
	t істина: {
		answer := secret.
	}, інакше: {
		answer := Matryoshka рекурсивний новий: (сам double: secret).
	}. <- answer.
}.

>> x := Matryoshka новий: 2.
