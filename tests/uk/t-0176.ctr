

>> використана-памʼять1 := 0.
>> використана-памʼять2 := 0.
>> використана-памʼять3 := 0.
>> використана-памʼять4 := 0.

Програма керування-памʼяттю: 0.

>> txt := ['Word Salad'].
Вивід написати: ['Довжина тексту: '] + txt довжина, новий-рядок.
Вивід написати: ['Символ на позиції 2:'] + ( txt символ: 2 ), новий-рядок.
Вивід написати: (( txt знайти: ['S'] ) - 0), новий-рядок.

Програма прибрати.

використана-памʼять1 := (Програма памʼять ? 0).


txt := ['Word Salad'].
Вивід написати: ['Довжина тексту: '] + txt довжина, новий-рядок.
Вивід написати: ['Символ на позиції 2:'] + ( txt символ: 2 ), новий-рядок.
Вивід написати: (( txt знайти: ['S'] ) - 0), новий-рядок.

Програма прибрати.
використана-памʼять2 := (Програма памʼять ? 0).


txt := ['Word Salad'].
Вивід написати: ['Довжина тексту: '] + txt довжина, новий-рядок.
Вивід написати: ['Символ на позиції 2:'] + ( txt символ: 2 ), новий-рядок.
Вивід написати: (( txt знайти: ['S'] ) - 0), новий-рядок.

Програма прибрати.
використана-памʼять3 := (Програма памʼять ? 0).



( використана-памʼять1 = використана-памʼять2 і: використана-памʼять1 = використана-памʼять3, і: використана-памʼять2 = використана-памʼять3 ) істина: {
