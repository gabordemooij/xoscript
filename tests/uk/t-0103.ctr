>> a := Список ← Обʼєкт ; Істина ; Хиба ; Логічний ; 1 ; Число ; ['Str'] ; Текст ; { ['Empty']. }.
Вивід написати: (a кількість), новий-рядок.
{ :i
	Вивід написати: 
	['a '] + 
	((a ? i) тип) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ніщо?) або: [''] або: ['NOT']) + 
	[' Nil.'],
	новий-рядок.
} × (a кількість).
Вивід написати: ['but.. Nil is.. '] + ((Ніщо Ніщо?) або: ['certainly NIL!'] або: ['not NIL??']), новий-рядок.