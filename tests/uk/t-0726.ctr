# test buffers PKI/Sign 
Server init.

>> long := ( Список новий заповнити: 1000 чим: ['a'] ) зʼєднати: [''].

# sign a message
Вивід написати: ( 
	Сховище підписати: ['abc'] ключем: long
), новий-рядок.

Вивід написати: ( 
	Сховище
		перевірити: ['abc'] 
		підпис: long 
		ключем: long
), новий-рядок.

Вивід написати: (
	Сховище хеш-пароля: long перевірити: long
), новий-рядок.
