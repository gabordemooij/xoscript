# тест буферів PKI/підпис 
Server init.

>> довгий := ( Список новий заповнити: 1000 чим: ['a'] ) зʼєднати: [''].

# підписати повідомлення
Вивід написати: ( 
	Сховище підписати: ['abc'] ключем: довгий
), новий-рядок.

Вивід написати: ( 
	Сховище
		перевірити: ['abc'] 
		підпис: довгий 
		ключем: довгий
), новий-рядок.

Вивід написати: (
	Сховище хеш-пароля: довгий перевірити: довгий
), новий-рядок.
