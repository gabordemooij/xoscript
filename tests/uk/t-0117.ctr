>> t := Істина.
(t = Істина) істина: { Вивід написати: ['T']. }.
(t = Хиба) істина: { Вивід написати: ['F']. }.
Вивід написати: ['|'].
>> t := Хиба.
(t = Істина) істина: { Вивід написати: ['T']. }.
(t = Хиба) істина: { Вивід написати: ['F']. }.
Вивід написати: ['|'].
>> f := Істина.
(t = Істина і: f = Хиба) істина: { Вивід написати: ['T']. }.
(t = Хиба і: f = Істина) істина: { Вивід написати: ['F']. }.
Вивід написати: ['|'].
>> n := Ніщо.
(n Ніщо?) істина: { Вивід написати: ['T']. }.
(n Ніщо?) хиба: { Вивід написати: ['F']. }.
Вивід написати: ['|'].
(f Boolean?) істина: { Вивід написати: ['T']. }.
(f Boolean?) хиба: { Вивід написати: ['F']. }.



