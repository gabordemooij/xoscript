# тест означень

Програма прибрати.

>> Фрукт := Обʼєкт новий.
Фрукт при: ['новий'] виконати: {
	>> f := сам новий.
	f apples: 0. <- f.
}.
Фрукт при: ['apples:'] виконати: { :a свій яблука := a. }.
Фрукт при: ['яблука'] виконати: { <- свій яблука. }.
Фрукт при: ['+'] виконати: { :f
	>> n := Фрукт новий.
	n apples: (f яблука + свій яблука). <- n.
}.
Число при: ['яблука'] виконати: { <- ((Фрукт новий) apples: сам).
}.

Фрукт при: ['текст'] виконати: { <- свій яблука + [' яблук '].
}.

>> q := 3 яблука + 4 яблука.
Вивід написати: q, новий-рядок.




q := 3 яблука + 4 яблука.
Вивід написати: q, новий-рядок.



q := 3 яблука + 4 яблука.
Вивід написати: q, новий-рядок.


