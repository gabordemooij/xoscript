# test qualifiers

Програма прибрати.

>> Fruit := Обʼєкт новий.
Fruit при: ['новий'] виконати: {
	>> f := сам новий.
	f apples: 0. <- f.
}.
Fruit при: ['apples:'] виконати: { :a свій apples := a. }.
Fruit при: ['apples'] виконати: { <- свій apples. }.
Fruit при: ['+'] виконати: { :f
	>> n := Fruit новий.
	n apples: (f apples + свій apples). <- n.
}.
Число при: ['apples'] виконати: { <- ((Fruit новий) apples: сам).
}.

Fruit при: ['текст'] виконати: { <- свій apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Вивід написати: q, новий-рядок.




q := 3 apples + 4 apples.
Вивід написати: q, новий-рядок.



q := 3 apples + 4 apples.
Вивід написати: q, новий-рядок.


