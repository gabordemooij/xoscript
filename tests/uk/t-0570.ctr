#Linux

 >> t := Момент новий.
 
t зона: ['Europe/Amsterdam'].
t рік: 2020, місяць: 8, день: 2, година: 21, хвилина: 2, секунда: 1.

>> a := t година.
>> ams := t зона.

t зона: ['US/Hawaii'].
>> b := t година.
>> hw := t зона.

Вивід
написати: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		або: ['later'] або: ['earlier']
	)
),
новий-рядок.
 