Текст при: ['evaluate'] виконати: {
	>> код := Файл новий: ['/tmp/eval.ctr'].
	код написати: (сам текст + ['.']).
	Програма використати: ['/tmp/eval.ctr'].
}.

>> a := Список ← 1 ; 2 ; 3.
>> b := (a текст).

Вивід написати: b, новий-рядок. 
(['b := '] + b) evaluate.

Вивід написати: b ? 2, новий-рядок. 

Вивід написати: (( Список ← 1 ; 2 ; 3 )), новий-рядок. 

Вивід написати: ((Словник новий) поставити: 1 у: 2), новий-рядок. 

>> x := ( (Список ← 1 ; ( Список ← 9 ) ; Істина ) ) текст.
Вивід написати: x, новий-рядок. 
(['x := '] + x) evaluate.

Вивід написати: x ? 1 ? 0, новий-рядок. 

>> y := (Словник новий) поставити: (Список ← 1) у: (Список ← 2).
Вивід написати: y, новий-рядок. 

(['y := '] + y) текст evaluate.

Вивід написати: (y на: (Список ← 2) текст ), новий-рядок.

Вивід написати: (Список новий), новий-рядок. 
Вивід написати: (Словник новий), новий-рядок. 
