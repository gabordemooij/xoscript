# Тест очищувача utf8
Server init.

>> випадки-utf8 := Словник новий
	# Лише ASCII
	поставити: ( Список новий ; 65 ; 65 ; 65 ; 65 ; 0 ) у: ['AAAA'],
	# коректна 2-байтова послідовність
	поставити: ( Список новий ; 194 ; 162 ; 0 ) у: ['¢'],
	# Коректний 3-байтовий UTF-8
    поставити: ( Список новий ; 226 ; 130 ; 172 ; 0 ) у: ['€'],
	# Коректний 4-байтовий UTF-8
    поставити: ( Список новий ; 240 ; 144 ; 141 ; 136 ; 0 ) у: ['𐍈'],
	# Неприпустимий байт продовження в послідовності E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, але належить до тієї самої помилки
    поставити: ( Список новий ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) у: ['A?A'],
	# Надлишкове кодування ASCII 'A' (має стати ?),
    поставити: ( Список новий ; 65 ; 193 ; 129 ; 0 ) у: ['A?'],
	# Неприпустимий перший байт (0xFF)
    поставити: ( Список новий ; 255 ; 0 ) у: ['?'],
	# Незавершена багатобайтова послідовність у кінці
    поставити: ( Список новий ; 66 ; 226 ; 0 ) у: ['B?'],
    # Порожній текст
    #put: ( List new ) at: [''],
	# Кілька змішаних послідовностей
    поставити: ( Список новий ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) у: ['A€?𐍈B'].
	 
випадки-utf8 кожен: { :key :value
	>> blob := Blob новий: value кількість, bytes: value.
	>> str := blob текст.
	(str = key) істина: {
		Вивід написати: ['OK'], новий-рядок.
	}, інакше: {
		Вивід написати: ['Санітайзер UTF8 не впорався з: '] + key + [' отримано: '] + str, новий-рядок.
	}.
	blob звільнити.
}.
