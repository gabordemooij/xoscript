Число при: ['factorial'] виконати: {
	>> total := 1.
	{ :index total помножити-на: (сам - (index)). } × сам. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Вивід написати: a.
>> b := 2 + 3 factorial.
Вивід написати: b.
>> c := 3 factorial + 2.
Вивід написати: c.
>> d := 2 + (3 factorial).
Вивід написати: d.
Вивід написати: 2 + 3 factorial + 1.
