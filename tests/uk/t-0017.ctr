Число при: ['факторіал'] виконати: {
	>> разом := 1.
	{ :індекс разом помножити-на: (сам - (індекс)). } × сам. <- разом.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Вивід написати: a.
>> b := 2 + 3 факторіал.
Вивід написати: b.
>> c := 3 факторіал + 2.
Вивід написати: c.
>> d := 2 + (3 факторіал).
Вивід написати: d.
Вивід написати: 2 + 3 факторіал + 1.
