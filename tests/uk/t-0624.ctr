# Цей тест перевіряє, що string_fill_in не втрачає свій слот (gc'ed) у режимі 4
# посилання у world.c
>> Журнал := Обʼєкт новий.

Журнал при: ['say:'] виконати: { :str
	Вивід написати: str, новий-рядок.
}.

>> Предмет := Обʼєкт новий.

Предмет при: ['новий:'] виконати: { :id
	<- сам новий id: id.
}.

Предмет при: ['id:'] виконати: { :id
	свій id := id.
}.

Предмет при: ['id'] виконати: { <- свій id. }.


Предмет при: ['текст'] виконати: {
	>> str := ['Item#~no'].
	str ~no: свій id.
	<- str.
}.


>> Print := Обʼєкт новий.

Print при: ['items'] виконати: { 
	
	свій предмет := Предмет новий: 1.
	
	# тут або segfault, або неправильний рядок
	Журнал say: (
		['~item printed.'] ~item: свій предмет
	).
	
	
}.

Print items.