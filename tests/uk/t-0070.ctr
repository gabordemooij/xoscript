>> числа := ['1,2,3'] розділити: [','].
Вивід написати: ['Я отримав: '] + числа кількість + [' чисел.'],новий-рядок.
{ :i Вивід написати: ['number #'] + i + [':'] + (числа позиція: i), новий-рядок.} × 3.
>> напої := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
напої := напої розділити: [' Or '].
Вивід написати: ['Ми подаємо'], новий-рядок.
{ :i Вивід написати: ['->'] + (напої позиція: i), новий-рядок. } × (напої кількість).
Вивід написати: (напої зʼєднати: [',']), новий-рядок.
Вивід написати: (числа зʼєднати: ['||']).
