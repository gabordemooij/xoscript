Вивід написати: ['Тестовий обʼєкт'], новий-рядок.
>> вітальник := Обʼєкт новий.
вітальник при: ['name:'] виконати: { :імʼя
	свій х-імʼя := імʼя. 
}.
вітальник при: ['привітати'] виконати: {
	Вивід написати: ['Привіт, '] + свій х-імʼя, новий-рядок.
}.
вітальник name: ['Sherlock'].
вітальник save-as: ['/tmp/a.bin'].
вітальник save-as: ['/tmp/b.bin'].
Вивід написати: ['========== ПЕРЕЗАВАНТАЖЕННЯ SNAP:'], новий-рядок.
>> b := Обʼєкт load-from: ['/tmp/a.bin'].
>> c := Обʼєкт load-from: ['/tmp/b.bin'].
b привітати.
b name: ['Watson'], привітати.
c name: ['Moriarty'], привітати.
