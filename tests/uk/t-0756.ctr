Вивід написати: ['Test object'], новий-рядок.
>> greeter := Обʼєкт новий.
greeter при: ['name:'] виконати: { :імʼя
	свій xname := імʼя. 
}.
greeter при: ['greet'] виконати: {
	Вивід написати: ['Hello '] + свій xname, новий-рядок.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Вивід написати: ['========== RELOADING SNAP:'], новий-рядок.
>> b := Обʼєкт load-from: ['/tmp/a.bin'].
>> c := Обʼєкт load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
