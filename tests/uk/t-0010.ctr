>> Animal := Обʼєкт новий.
Animal при: ['make'] виконати: {
	>> animal := Обʼєкт новий.
	animal при: ['makeSound'] виконати: {
		Вивід написати: свій sound.
	}. <- animal.
}.
>> Cat := Обʼєкт новий.
Cat при: ['make'] виконати: {
	>> cat := Animal make.
	cat при: ['init'] виконати: {
		свій sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
