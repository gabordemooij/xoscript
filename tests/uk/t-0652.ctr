# test number -> string -> number
{

	>> x := Число між: 0 і: 1000000.
	>> d := Число між: 1 і: 7.
	>> e := 10 степінь: d.

	x поділити-на: e.
	>> y := x текст число.

	(x = y) хиба: {
		Вивід написати: x, новий-рядок.
		Вивід написати: y, новий-рядок.
		Програма кінець.
	}.

} * 1000.
Вивід написати: ['OK'], новий-рядок.