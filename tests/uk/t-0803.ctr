	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> зʼєдн2 := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
#...
>> вид := зʼєдн1 запит: ['DELETE FROM book WHERE id > 0'].
{  вид виконати. зʼєдн1 підтвердити. } перехопити: { :e зʼєдн1 відкотити.  }, запустити.

>> вставка := зʼєдн1 запит: ['INSERT INTO book (id) VALUES(null)'].
вставка виконати.

>> кількість := зʼєдн1 запит: ['SELECT COUNT(*) AS num FROM book'].
кількість отримати: { :ряд Вивід написати: ряд num, новий-рядок. }.

# не відображається
