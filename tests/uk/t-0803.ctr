	підключити.

>> conn2 := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
#...
>> del := conn1 запит: ['DELETE FROM book WHERE id > 0'].
{  del виконати. conn1 підтвердити. } перехопити: { :e conn1 відкотити.  }, запустити.

>> insert := conn1 запит: ['INSERT INTO book (id) VALUES(null)'].
insert виконати.

>> кількість := conn1 запит: ['SELECT COUNT(*) AS num FROM book'].
кількість отримати: { :row Вивід написати: row num, новий-рядок. }.

# does not show up
# insert not committed on connection 1
>> кількість := conn2 запит: ['SELECT COUNT(*) AS num FROM book'].
кількість отримати: { :row Вивід написати: row num, новий-рядок. }.
