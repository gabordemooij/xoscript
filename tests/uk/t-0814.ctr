# формат cookie сесії, тип вмісту json, лише вебпротоколи, svg показується вбудовано
Server ініціалізувати.
Програма використати: ['../../../src/xo/uk/webtools.xo'].

>> Фальшивий-запит := Обʼєкт новий.
Фальшивий-запит при: ['value:'] виконати: { :величина
	свій величина := величина.
}.
Фальшивий-запит при: ['cookie:'] виконати: { :імʼя
	<- свій величина.
}.

>> Тестова-сесія := Сесія-тимчасовий-файл новий.
Тестова-сесія при: ['завантажити'] виконати: {
	<- Словник новий.
}.
Тестова-сесія при: ['ідентифікатор-сесії'] виконати: {
	<- свій id.
}.

>> кукі := Список новий
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

кукі кожен: { :i :кука
	>> http-запит := Фальшивий-запит новий.
	http-запит value: кука.
	>> менеджер := Тестова-сесія новий.
	>> веб := Веб-документ новий.
	веб http-запит: http-запит.
	веб менеджер-сесій: менеджер.
	веб почати-сесію.
	Вивід написати: ( менеджер ідентифікатор-сесії = кука ), новий-рядок.
}.

>> веб := Веб-документ новий.
веб json: (Словник новий поставити: ['b'] у: ['a']).
Вивід написати: ['\n'], новий-рядок.

{ Мережа get: ['file:///etc/hostname']. } перехопити: { :e
	Вивід написати: e, новий-рядок.
}, запустити.

>> svg := Файл новий: ['/tmp/test0814.svg'].
svg написати: ['<svg xmlns="x"></svg>'].
Вивід новий-рядок.
Server передати: ['test0814.svg'] префікс: ['/tmp/'].
svg видалити.
