Вивід написати: ['Тестовий обʼєкт'], новий-рядок.
>> a := Обʼєкт новий. 
a при: ['item:'] виконати: { :int64
	свій int64 := int64. 
}.
a при: ['предмет'] виконати: {
	<- свій int64.
}.
a item: ( Int64 з-тексту: ['9999'] ).
Вивід написати: a предмет, новий-рядок.
>> стара-адреса-int64 := a предмет прототип адреса-памʼяті.
a save-as: ['/tmp/a.bin'].
Вивід написати: ['========== ПЕРЕЗАВАНТАЖЕННЯ SNAP:'], новий-рядок.
>> b := Обʼєкт load-from: ['/tmp/a.bin'].
(b предмет прототип адреса-памʼяті = стара-адреса-int64) істина: {
	Вивід написати: ['Посилання на обʼєкт знову приєднано.'], новий-рядок.
}.
Вивід написати: ( b предмет ), новий-рядок.
