Список при: ['сума'] виконати: {
	>> разом := 0.
	сам кожен: { :індекс :елемент
		разом додати: елемент.
	}. <- разом.
}.

>> a := Істина.



a при: ['текст'] виконати: {
	>> відповідь := Ніщо.
	( сам = Істина ) істина: {
		відповідь := ['Ага'].
	}, інакше: {
		відповідь := ['Не-а'].
	}. <- відповідь.
}.

a при: ['число'] виконати: {
	>> відповідь := Ніщо.
	( сам = Істина ) істина: {
		відповідь := 10.
	}, інакше: {
		відповідь := 20.
	}. <- відповідь.
}.

>> b := 666.

b при: ['текст'] виконати: { <- ['Диявол'].
}.

b при: ['логічний'] виконати: { <- Хиба.
}.


Вивід написати: a, новий-рядок.  
Вивід написати: (90 + a), новий-рядок. 
Вивід написати: b, новий-рядок. 
Вивід написати: (Істина і: b), новий-рядок.

a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666. 
a := a + ( Список ← 1 ).
Вивід написати: a, новий-рядок.
Вивід написати: ((Словник новий) поставити: Ніщо у: Ніщо), новий-рядок.
Вивід написати: a сума, новий-рядок. 


{
	a при: ['текст'] виконати: { <- Ніщо. }.
	a := [''] + a.
} перехопити: { :помилка
	Вивід написати: ['Помилку зафіксовано: '] + помилка, новий-рядок.
