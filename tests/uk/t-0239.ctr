Список при: ['sum'] виконати: {
	>> total := 0.
	сам кожен: { :index :element
		total додати: element.
	}. <- total.
}.

>> a := Істина.



a при: ['текст'] виконати: {
	>> answer := Ніщо.
	( сам = Істина ) істина: {
		answer := ['Yep'].
	}, інакше: {
		answer := ['Nope'].
	}. <- answer.
}.

a при: ['число'] виконати: {
	>> answer := Ніщо.
	( сам = Істина ) істина: {
		answer := 10.
	}, інакше: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b при: ['текст'] виконати: { <- ['Devil'].
}.

b при: ['логічний'] виконати: { <- Хиба.
}.


Вивід написати: a, новий-рядок.  
Вивід написати: (90 + a), новий-рядок. 
Вивід написати: b, новий-рядок. 
Вивід написати: (Істина і: b), новий-рядок.

a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666. 
a := a + ( Список ← 1 ).
Вивід написати: a, новий-рядок.
Вивід написати: ((Словник новий) поставити: Ніщо у: Ніщо), новий-рядок.
Вивід написати: a sum, новий-рядок. 


{
	a при: ['текст'] виконати: { <- Ніщо. }.
	a := [''] + a.
} перехопити: { :error
	Вивід написати: ['Error noted: '] + error, новий-рядок.
}, запустити.



