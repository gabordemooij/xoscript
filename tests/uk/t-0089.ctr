>> randomizer := { :a :b
	>> мінімум := ( a < b ) або: a або: b.
	>> максимум := ( a > b ) або: a або: b.
	>> x := Ніщо.
	{
		x := Число між: a і: b.
		((x < мінімум) або: (x > максимум)) істина: { 
			Вивід написати: (['Invalid value!']).
			Програма кінець.
		}.
	} 
	× 100. <- x.
}.
