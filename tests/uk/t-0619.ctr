>> HTML := Обʼєкт новий.
HTML при: ['відповісти:'] виконати: { :tag 
	Вивід написати: (['<tag>'] tag: tag), новий-рядок.
}.
HTML при: ['відповісти:і:'] виконати: { :tag :html 
	Вивід написати: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), новий-рядок.
}.
>> html := HTML новий.
html body h1: ['header'].

