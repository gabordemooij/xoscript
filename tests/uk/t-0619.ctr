>> HTML := Обʼєкт новий.
HTML при: ['відповісти:'] виконати: { :тег 
	Вивід написати: (['<tag>'] tag: тег), новий-рядок.
}.
HTML при: ['відповісти:і:'] виконати: { :тег :html 
	Вивід написати: (
		['<tag>innerHTML</tag>']
		tag: тег - [':'],
		innerHTML: html
	), новий-рядок.
}.
>> html := HTML новий.
html body h1: ['header'].

