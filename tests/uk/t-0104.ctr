
{ :i
	Вивід написати: ['This is step #'] + ( ( i ) + 1 ), новий-рядок.
} × 6.

{ :i
	Вивід написати: ['This is step #'] + ( 3 - ( i ) ), новий-рядок.
} × 6.

{ :i
	Вивід написати: ['НІКОЛИ!'], новий-рядок.
} × 0.



{ :i
	Вивід написати: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), новий-рядок.
} × 11.
