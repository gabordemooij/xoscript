>> рахунок := Обʼєкт новий.
рахунок при: ['запустити'] виконати: {
        свій число := 0.
}.

рахунок при: ['число'] виконати: {
        свій число додати: 1.
        <- свій число копіювати.
}.

>> річний-рахунок := рахунок новий.
річний-рахунок при: ['start:'] виконати: { :рік
	свій число := рік.
}.

річний-рахунок start: 202000.
Вивід написати: річний-рахунок число, новий-рядок.
Вивід написати: річний-рахунок число, новий-рядок.
