>> invoice := Обʼєкт новий.
invoice при: ['запустити'] виконати: {
        свій число := 0.
}.

invoice при: ['число'] виконати: {
        свій число додати: 1. <- свій число копіювати.
}.

>> year-invoice := invoice новий.
year-invoice при: ['start:'] виконати: { :рік
	свій число := рік.
}.

year-invoice start: 202000.
Вивід написати: year-invoice число, новий-рядок.
Вивід написати: year-invoice число, новий-рядок.
