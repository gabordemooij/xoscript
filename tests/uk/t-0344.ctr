# тест перехоплення всього (практичний)
>> HTML := Текст новий.
HTML при: ['encode:'] виконати: { :зміст
	сам додати-в-кінець: (зміст
	замінити: ['&'] на: ['&amp;'], 
	замінити: ['<'] на: ['&lt;'],
	замінити: ['>'] на: ['&gt;'],
	замінити: ['"'] на: ['&quot;']).
}.
>> блог := HTML новий.
блог додати-в-кінець: ['<h1>'],
     encode: ['Koffie & Thee'],
     додати-в-кінець: ['</h1>'].
Вивід написати: блог, новий-рядок.


>> Римське-число := Число новий.
Римське-число при: ['як-текст'] виконати: {
	>> a := [''].
	{ a додати-в-кінець: ['I']. } × сам. <- a.
}.

>> x := Римське-число новий.
x додати: 3.
Вивід написати: x як-текст, новий-рядок.

>> Квант := Логічний новий.
Квант при: ['true?'] виконати: { <- ['можливо Істина']. }.
Вивід написати: (Квант новий true?), новий-рядок.

>> Nihil := Ніщо новий.
Nihil при: ['текст'] виконати: { <- ['Nihil']. }.
Вивід написати: (Nihil новий), новий-рядок.
