# catch-all test (practical)
>> HTML := Текст новий.
HTML при: ['encode:'] виконати: { :tekst
	сам додати-в-кінець: (tekst
	замінити: ['&'] на: ['&amp;'], 
	замінити: ['<'] на: ['&lt;'],
	замінити: ['>'] на: ['&gt;'],
	замінити: ['"'] на: ['&quot;']).
}.
>> blog := HTML новий.
blog додати-в-кінець: ['<h1>'],
     encode: ['Koffie & Thee'],
     додати-в-кінець: ['</h1>'].
Вивід написати: blog, новий-рядок.


>> Roman := Число новий.
Roman при: ['stringy'] виконати: {
	>> a := [''].
	{ a додати-в-кінець: ['I']. } × сам. <- a.
}.

>> x := Roman новий.
x додати: 3.
Вивід написати: x stringy, новий-рядок.

>> Quantum := Логічний новий.
Quantum при: ['true?'] виконати: { <- ['maybe True']. }.
Вивід написати: (Quantum новий true?), новий-рядок.

>> Nihil := Ніщо новий.
Nihil при: ['текст'] виконати: { <- ['Nihil']. }.
Вивід написати: (Nihil новий), новий-рядок.
