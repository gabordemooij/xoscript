
>> країни := Список новий
	~ ['Швейцарія']
	~ ['Італія']
	~ ['Німеччина'].

>> їжа := Список новий
	~ ['Рьошті']
	~ ['Спагеті']
	~ ['Квашена капуста'].


>> лічильник := 0.
їжа за: країни, кожен: { :key :value
	лічильник додати: 1.
}.

Вивід написати: (['we serve counter dishes'] counter: лічильник), новий-рядок.

>> лічильник := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] символи сортувати: { :v
	лічильник додати: 0.
}.

Вивід написати: (['we sort counter dishes'] counter: лічильник), новий-рядок.


>> лічильник := 0.
{
	{
		лічильник додати: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Вивід написати: (['we calculate counter numbers.'] counter: лічильник), новий-рядок.

