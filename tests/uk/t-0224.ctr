
>> countries := Список новий
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Список новий
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods за: countries, кожен: { :key :value
	counter додати: 1.
}.

Вивід написати: (['we serve counter dishes'] counter: counter), новий-рядок.

