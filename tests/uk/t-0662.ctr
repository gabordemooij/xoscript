>> t := Ніщо.

# you can control the time zone for
# parsing like this:
Момент зона: ['CET'].
t := Момент з: ['1981-02-03 04:05:06'].
Вивід написати: t, новий-рядок.

# now using CEST time zone:
Момент зона: ['CEST'].
t := Момент з: ['1981-02-03 04:05:06'].
Вивід написати: t, новий-рядок.

# error if string cannot be parsed
{ Момент з: ['1900']. } перехопити: { Ніщо. }, запустити.
