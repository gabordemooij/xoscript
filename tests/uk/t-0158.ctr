>> x := [' hallo '].

>> y := x великі-літери.
Вивід написати: x, новий-рядок.
Вивід написати: (x дорівнює: y), новий-рядок.

>> y := x малі-літери.
Вивід написати: x, новий-рядок.
Вивід написати: (x дорівнює: y), новий-рядок.

>> y := x обрізати.
Вивід написати: x, новий-рядок.
Вивід написати: (x дорівнює: y), новий-рядок.

>> y := x зсув: 1.
Вивід написати: x, новий-рядок.
Вивід написати: (x дорівнює: y), новий-рядок.

>> y := x від: 1 довжина: 2.
Вивід написати: x, новий-рядок.
Вивід написати: (x дорівнює: y), новий-рядок.