>> повторювач := Обʼєкт новий.
повторювач при: ['відповісти:'] виконати: { :що
	Вивід написати: що + [' '].
}.
повторювач при: ['відповісти:і:'] виконати: { :що :say
	Вивід написати: що, написати: say + [' '].
}.
повторювач при: ['відповісти:і:і:'] виконати: { :що :say :ще
	Вивід написати: що, написати: say, написати: ще.
}.
повторювач повторити.
повторювач everything: ['Я кажу.'].
повторювач and: ['I '] everything: ['роблю.'].
