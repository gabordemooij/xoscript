>> repeater := Обʼєкт новий.
repeater при: ['відповісти:'] виконати: { :what
	Вивід написати: what + [' '].
}.
repeater при: ['відповісти:і:'] виконати: { :what :say
	Вивід написати: what, написати: say + [' '].
}.
repeater при: ['відповісти:і:і:'] виконати: { :what :say :more
	Вивід написати: what, написати: say, написати: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
