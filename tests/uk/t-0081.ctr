>> мапа1 := Словник новий.
>> ключ1 := Список новий.
>> ключ2 := Список новий.

мапа1
	поставити: ['hello'] у: ключ1,
	поставити: ['world'] у: ключ2.


Вивід
	написати: ['Map #1 contains: '] + (мапа1 на: ключ1),
	написати: [' і '] + (мапа1 на: ключ2), новий-рядок.

>> Масив-з-ключами := Список новий.
Масив-з-ключами при: ['у-текст'] виконати: { <- (сам кількість) у-текст.
}.

>> map2 := Словник новий.
ключ1 := Масив-з-ключами новий.
ключ2 := Масив-з-ключами новий.

ключ1 додати-в-кінець: 1.

map2
	поставити: ['hello'] у: ключ1,
	поставити: ['world'] у: ключ2.

Вивід
	написати: ['Map #2 contains: '] + (map2 на: ключ1),
	написати: [' і '] + (map2 на: ключ2), новий-рядок.
