>> map1 := Словник новий.
>> key1 := Список новий.
>> key2 := Список новий.

map1
	поставити: ['hello'] у: key1,
	поставити: ['world'] у: key2.


Вивід
	написати: ['Map #1 contains: '] + (map1 на: key1),
	написати: [' and '] + (map1 на: key2), новий-рядок.

>> KeyeableArray := Список новий.
KeyeableArray при: ['toString'] виконати: { <- (сам кількість) toString.
}.

>> map2 := Словник новий.
key1 := KeyeableArray новий.
key2 := KeyeableArray новий.

key1 додати-в-кінець: 1.

map2
	поставити: ['hello'] у: key1,
	поставити: ['world'] у: key2.

Вивід
	написати: ['Map #2 contains: '] + (map2 на: key1),
	написати: [' and '] + (map2 на: key2), новий-рядок.
