
>> Size := Обʼєкт новий.
Size при: ['is:'] виконати: { :число
	число при: ['+'] виконати: { :число
		>> unit := число означення.
		>> factor := 1.
		
		unit
		випадок: ['inch'] виконати: { factor := 0.0833. }. <- сам + (число * factor).
	}. <- число.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Вивід написати: plank + edge, новий-рядок.
