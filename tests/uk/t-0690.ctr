# тест бази даних
# потрібну конфігурацію див. у прикладі server.xo

Server init.
Вивід написати: ['Тест бази даних'], новий-рядок.

>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'], пароль: ['pass123'], назва-бази: ['xobase'], підключити.

Вивід написати: ['Чи можемо підʼєднатися? '] + бд підключено?, новий-рядок.

>> параметри-пошуку := бд запит: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Список новий ; ['abc'] ; 12.35 ; 6 ). # параметризовані запити

{  параметри-пошуку виконати. бд підтвердити. } перехопити: { :e бд відкотити.  }, запустити.

Вивід написати: ['Чи можемо вставити? '] + ( параметри-пошуку insert-id > 0 ), новий-рядок.

>> x := 0.
>> параметри-пошуку :=
бд запит: ['SELECT * FROM book order by id desc limit 2'], 
отримати: { :ряд 
	x додати: 1.
	Істина перервати. # має прибрати за собою, без 'Commands out of sync'
}.

>> параметри-пошуку :=
бд запит: ['SELECT * FROM book order by id desc limit 2'], 
отримати: { :ряд
	x додати: 1.
	Істина перервати.
}.

(x > 0) істина: {
	Вивід написати: ['Чи можемо перервати посеред fetch? '].
}.

Вивід написати: Істина, новий-рядок.