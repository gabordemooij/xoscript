Server init.
>> f := Формат новий: ['%d'].
>> a := Blob новий: 4.
a bytes: ( Список новий ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новий: 4.
b bytes: ( Список новий ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a від: 0 довжина: 3, кожен: { :i :byte
	Вивід написати: ( f застосувати-ціле: byte ), новий-рядок.
}.
a ^ b.
