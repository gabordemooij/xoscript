

>> використана-памʼять1 := 0.
>> використана-памʼять2 := 0.
>> використана-памʼять3 := 0.
>> використана-памʼять4 := 0.

>> x := 100.

Програма керування-памʼяттю: 0.

{
>> txt := ['привіт '] + ['world'].
txt := txt + [' - чи можемо ми використовувати рядки.. '].
txt := txt + ['без витоку '] + x + ['+ байтів ?'].
txt додати-в-кінець: ['!!'].
Вивід написати: txt.
} запустити.

Програма прибрати.

використана-памʼять1 := (Програма памʼять ? 0).


{
>> txt := ['привіт '] + ['world'].
txt := txt + [' - чи можемо ми використовувати рядки.. '].
txt := txt + ['без витоку '] + x + ['+ байтів ?'].
txt додати-в-кінець: ['!!'].
Вивід написати: txt.
} запустити.

Програма прибрати.
використана-памʼять2 := (Програма памʼять ? 0).


{
>> txt := ['привіт '] + ['world'].
txt := txt + [' - чи можемо ми використовувати рядки.. '].
txt := txt + ['без витоку '] + x + ['+ байтів ?'].
txt додати-в-кінець: ['!!'].
Вивід написати: txt.
} запустити.

Програма прибрати.
використана-памʼять3 := (Програма памʼять ? 0).



( використана-памʼять1 = використана-памʼять2 і: використана-памʼять1 = використана-памʼять3, і: використана-памʼять2 = використана-памʼять3 ) істина: {
	Вивід написати: ['Тут немає витоків памʼяті'].
}, хиба: {
	Вивід написати: ['Витік памʼяті...'].
}.
