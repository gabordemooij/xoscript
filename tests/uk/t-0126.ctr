#Linux
>> Slurp := Обʼєкт новий.

Slurp при: ['новий'] виконати: {
	свій str := [''].
}.

Slurp при: ['nieuw'] виконати: {
	свій str := [''].
}.

Slurp при: ['відповісти:'] виконати: { :blah
		свій str додати-в-кінець: blah.
}.

Slurp при: ['відповісти:і:'] виконати: { :blah :blahah
		свій str додати-в-кінець: (blah від: 0 довжина: (blah довжина - 1)).
		свій str додати-в-кінець: [' '].
		свій str додати-в-кінець: blahah.
}.

Slurp при: ['obtain'] виконати: {
	>> buffer := свій str.
	свій str := ['']. <- buffer.
}.


Вивід написати: (Програма система: (Slurp новий echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Файл новий: ['/tmp/from.txt'], видалити. } перехопити: { ['Empty']. }, запустити.
{ Файл новий: ['/tmp/to.txt'], видалити. } перехопити: { ['Empty']. }, запустити.


Файл новий: ['/tmp/to.txt'], існує хиба: {
	Вивід написати: ['Confirmed. Target file does not exist.\
'].
}.
Файл новий: ['/tmp/from.txt'], існує хиба: {
	Вивід написати: ['Confirmed. Source file does not exist.\
'].
}.



Програма система: (Slurp новий touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Програма система: (Slurp новий cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Файл новий: ['/tmp/to.txt'], існує істина: {
	Вивід написати: ['Confirmed. Target file has been created by shell.\
'].
}.


Вивід написати: ['Contents of file is:'] + (Файл новий: ['/tmp/to.txt'], читати), новий-рядок.
