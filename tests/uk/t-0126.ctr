#Linux
>> Ковтач := Обʼєкт новий.

Ковтач при: ['новий'] виконати: {
	свій str := [''].
}.

Ковтач при: ['nieuw'] виконати: {
	свій str := [''].
}.

Ковтач при: ['відповісти:'] виконати: { :blah
		свій str додати-в-кінець: blah.
}.

Ковтач при: ['відповісти:і:'] виконати: { :blah :blahah
		свій str додати-в-кінець: (blah від: 0 довжина: (blah довжина - 1)).
		свій str додати-в-кінець: [' '].
		свій str додати-в-кінець: blahah.
}.

Ковтач при: ['здобути'] виконати: {
	>> буфер := свій str.
	свій str := ['']. <- буфер.
}.


Вивід написати: (Програма система: (Ковтач новий echo: ['Привіт, я вмію писати в консоль через плавний API!'], здобути)).


{ Файл новий: ['/tmp/from.txt'], видалити. } перехопити: { ['Порожньо']. }, запустити.
{ Файл новий: ['/tmp/to.txt'], видалити. } перехопити: { ['Порожньо']. }, запустити.


Файл новий: ['/tmp/to.txt'], існує хиба: {
	Вивід написати: ['Confirmed. Target file does not exist.\
'].
}.
Файл новий: ['/tmp/from.txt'], існує хиба: {
	Вивід написати: ['Confirmed. Source file does not exist.\
'].
}.



Програма система: (Ковтач новий touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], здобути).



Програма система: (Ковтач новий cp: ['/tmp/from.txt /tmp/to.txt'], здобути).

Файл новий: ['/tmp/to.txt'], існує істина: {
	Вивід написати: ['Confirmed. Target file has been created by shell.\
'].
}.


Вивід написати: ['Вміст файлу:'] + (Файл новий: ['/tmp/to.txt'], читати), новий-рядок.
