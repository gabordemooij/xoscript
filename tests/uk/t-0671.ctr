# відкритий ключ (для захисту API тощо)
Server init.

# згенерувати ключі
>> ключі := Сховище згенерувати-ключі.

# приватний (секретний) ключ
>> тк := ключі перший.

# відкритий ключ
>> вк := ключі останній.

# підписати повідомлення
>> підп := Сховище підписати: ['abc'] ключем: тк.

# перевірити повідомлення (ок)
Вивід написати: ( 
	Сховище
		перевірити: ['abc'] 
		підпис: підп 
		ключем: вк 
), новий-рядок.

# перевірити повідомлення (невдача)
Вивід написати: ( 
	Сховище 
		перевірити: ['abd'] 
		підпис: підп 
		ключем: вк 
), новий-рядок.