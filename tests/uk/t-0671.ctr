# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сховище згенерувати-ключі.

# private (secret) key
>> sk := keys перший.

# public key
>> pk := keys останній.

# sign a message
>> sig := Сховище підписати: ['abc'] ключем: sk.

# check message (ok)
Вивід написати: ( 
	Сховище
		перевірити: ['abc'] 
		підпис: sig 
		ключем: pk 
), новий-рядок.

# check message (fail)
Вивід написати: ( 
	Сховище 
		перевірити: ['abd'] 
		підпис: sig 
		ключем: pk 
), новий-рядок.