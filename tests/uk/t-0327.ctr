

Список при: ['fixture:'] виконати: { :f
	свій фікстура := f.
}.

Список при: ['кількість'] виконати: { <- свій фікстура.
}.

Список при: ['aantal'] виконати: { <- свій фікстура.
}.


>> x := Ніщо.
{

	x := ['hello'] 
	замінити:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] символ: 2)
			)
		)
	на: (
		(['...hal'] + ['lo']) 
			великі-літери 
			lowecase 
			великі-літери 
			зсув: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Список ← 0 ; 1 ; 4; 9 ; (Список ← 0 ; 3; 1) ; 4
							) передостанній
						) ? 1
					) + 
					((Список ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					кількість
				)
			)
	).

} × 10.
Вивід написати: x, новий-рядок.

