

>> об := Обʼєкт новий.

об при: ['привітати'] виконати: {
	<- ['привіт'].
}.

# має вивести hi123hi123ok
об при: ['справа'] виконати: {
	свій властивість := 123.
	{
		# спробувати привʼязує сам/свій до обʼєкта, а не до блоку
		Вивід написати: сам привітати.
		Вивід написати: свій властивість.
		1 / 0.
	} перехопити: {
		Вивід написати: сам привітати.
		Вивід написати: свій властивість.
		Вивід написати: ['ok'].
	}, спробувати.
}.

об справа.