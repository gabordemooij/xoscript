
>> довідник := (
	Словник новий
		поставити: ['b'] у: ['a'],
		поставити: ['a'] у: ['b'],
		поставити: ['z'] у: ['x'],
		поставити: ['hello'] у: ['hallo'],
		поставити: ['human'] у: ['human']
).

>> порівняння := Список новий.
довідник кожен: { :a :b
	порівняння ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a порівняти: b)
	).
}.

порівняння сортувати: { :a :b <- ( a порівняти: b ). }.
Вивід написати: ( порівняння зʼєднати: ['↵'] ), новий-рядок.
порівняння зʼєднати: ['↵'].
