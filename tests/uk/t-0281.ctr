>> q := Список ← 1 ; 2 ; 3.
{ q ? ['1']. } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? Істина. } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? Хиба. } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? Ніщо. } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? (Список новий). } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? (Обʼєкт новий). } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
{ q ? ({ ['Порожньо']. }). } перехопити: { Вивід написати: ['перехоплено!'], новий-рядок. }, запустити.
Вивід написати: ['перехопили всіх'], новий-рядок.
