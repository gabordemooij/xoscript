>> q := Список ← 1 ; 2 ; 3.
{ q ? ['1']. } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? Істина. } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? Хиба. } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? Ніщо. } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? (Список новий). } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? (Обʼєкт новий). } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
{ q ? ({ ['Empty']. }). } перехопити: { Вивід написати: ['caught!'], новий-рядок. }, запустити.
Вивід написати: ['caught them all'], новий-рядок.
