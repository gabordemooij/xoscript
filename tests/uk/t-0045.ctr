Програма керування-памʼяттю: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } перехопити: {
		oops додати: 1.
	}, запустити.
} × 1000.

{
	Вивід написати: ['hi there!'].
	це-завдання помилка: ['oops'].
	Вивід написати: ['hi there!'].
	{ Вивід написати: ['dont print this']. } запустити.
} перехопити: { :e 
	Вивід написати: ['got ya!']. 
	Вивід написати: e.
}, запустити.
