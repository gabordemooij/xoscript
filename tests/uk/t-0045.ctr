Програма керування-памʼяттю: 4.

>> йой := 0.
{
	{ 3 ÷ 0. } перехопити: {
		йой додати: 1.
	}, запустити.
} × 1000.

{
	Вивід написати: ['привіт усім!'].
	це-завдання помилка: ['oops'].
