


>> використана-памʼять1 := 0.
>> використана-памʼять2 := 0.
>> використана-памʼять3 := 0.
>> використана-памʼять4 := 0.

Програма керування-памʼяттю: 0.
>> палітра := Ніщо.
>> кольори := Ніщо.

{
палітра := Словник новий.
палітра 
	поставити: ['#F00'] у: ['червоний'],
	поставити: ['#0F0'] у: ['зелений'],
	поставити: ['#00F'] у: ['синій'].
Вивід написати: ['кількість RGB-кодів у палітрі: '] + ( палітра кількість ), новий-рядок.
Вивід написати: ['RGB-код зеленого: '] + ( палітра ? ['зелений'] ), новий-рядок.
кольори := [''].
( палітра кожен: { :імʼя :код
		кольори := кольори + ( імʼя + [':'] + код ).
} ).
Вивід написати: ['Усі кольори в палітрі: '] + кольори, новий-рядок.
} запустити.
Програма прибрати.
використана-памʼять1 := (Програма памʼять ? 0).

