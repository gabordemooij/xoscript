

Текст при: ['обчислити'] виконати: {
	>> код := Файл новий: ['/tmp/eval.ctr'].
	код написати: сам текст + ['.'].
	Програма використати: ['/tmp/eval.ctr'].
}.

>> a := (Список ← (
	(Словник новий)
		поставити: ['domain'] у: ['mywebsite.com'],
		поставити: (Список ←
			((Словник новий)
				поставити: ['головна'] у: ['title'],
				поставити: ['<html></html>'] у: ['body'],
				поставити: ['2017-01-01'] у: ['створено']
			) ;
			((Словник новий)
				поставити: ['aboutus(c)'] у: ['title'],
				поставити: ['<credits>Author Inc.</credits>'] у: ['body']
			)
		) у: ['сторінки']
	)
) текст.

Вивід написати: a тип, новий-рядок.
Вивід написати: a, новий-рядок.

>> b := Ніщо.
(['b := '] + a) обчислити.
Вивід написати: b ? 0 ? ['сторінки'] ? 1 ? ['body'], новий-рядок.

>> c := b ? 0.
>> d := c текст.
Вивід написати: d тип, новий-рядок.

>> e := Ніщо.
(['e := '] + d) обчислити.
Вивід написати: e ? ['сторінки'] ? 0, новий-рядок.
