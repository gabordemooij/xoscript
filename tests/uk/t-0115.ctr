{
	це-завдання помилка: ['Dont fail.'].
	unknown doSomething.
} перехопити: {
	Вивід написати: ['Caught!'].
}, запустити.

{
	це-завдання помилка: ['Dont fail.'].
	свій unknown doSomething.
} перехопити: {
	Вивід написати: ['Caught!'].
}, запустити.

{
	це-завдання помилка: ['Dont fail.'].
	unknown := 122.
} перехопити: {
	Вивід написати: ['Caught!'].
}, запустити.


{
	це-завдання помилка: ['Dont fail.'].
	Істина перервати.
	Вивід написати: ['FAIL'].
} перехопити: {
	Вивід написати: ['Caught!'].
}, запустити.

{
	{
		це-завдання помилка: ['Dont fail.'].
		Істина перервати.
		Вивід написати: ['FAIL'].
	} перехопити: { :x
		(x = ['Dont fail.']) істина: { це-завдання помилка: ['Nested Caught!']. }.
	}, запустити.
} перехопити: { :e
	Вивід написати: e.
}, запустити.
