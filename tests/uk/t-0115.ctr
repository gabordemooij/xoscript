{
	це-завдання помилка: ['Не підведи.'].
	невідомий зробити-щось.
} перехопити: {
	Вивід написати: ['Перехоплено!'].
}, запустити.

{
	це-завдання помилка: ['Не підведи.'].
	свій невідомий зробити-щось.
} перехопити: {
	Вивід написати: ['Перехоплено!'].
}, запустити.

{
	це-завдання помилка: ['Не підведи.'].
	невідомий := 122.
} перехопити: {
	Вивід написати: ['Перехоплено!'].
}, запустити.


{
	це-завдання помилка: ['Не підведи.'].
	Істина перервати.
	Вивід написати: ['ПРОВАЛ'].
} перехопити: {
	Вивід написати: ['Перехоплено!'].
}, запустити.

{
	{
		це-завдання помилка: ['Не підведи.'].
		Істина перервати.
		Вивід написати: ['ПРОВАЛ'].
	} перехопити: { :x
		(x = ['Не підведи.']) істина: { це-завдання помилка: ['Вкладене перехоплення!']. }.
	}, запустити.
} перехопити: { :e
	Вивід написати: e.
}, запустити.
