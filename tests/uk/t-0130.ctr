# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Програма налаштування: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server звʼязати: ( Список новий ;
 libname ; ['fopen'] ;
 ( Список новий ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
звʼязати: ( Список новий ;
 Ніщо ; # means same lib
 ['fread'] ;
 ( Список новий ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # means same object (i.e. Stream)
 ['fread']
),
звʼязати: (
 Список новий ;
 Ніщо ; # means same lib
 ['fwrite'] ;
 ( Список новий ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # means same lib
 ['fwrite']
),
звʼязати: (
 Список новий ;
 Ніщо ; # means same lib
 ['rewind'] ;
 ( Список новий ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> шлях := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: шлях mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream повідомлення: ['fwrite'] аргументи: (Список новий ; str ; 1 ; 6 ; fd ).
Вивід написати: bytes-written, новий-рядок.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob новий: 20.

# read from file
>> bytes-read := Stream повідомлення: ['fread'] аргументи: (Список новий ; buf ; 1 ; 6 ; fd ).
Вивід написати: bytes-read, новий-рядок.
Вивід написати: buf, новий-рядок.

# free memory
str  звільнити.
шлях звільнити.
mode звільнити.
buf  звільнити.


