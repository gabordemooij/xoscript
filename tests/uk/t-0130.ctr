# використання FFI з плагіном Server

# підключення до libc (залежить від платформи)
>> назва-бібліотеки := Програма налаштування: ['FFITESTLIB'].

# звʼязуємо функції stdio з C для розширених операцій із файлами
Server звʼязати: ( Список новий ;
 назва-бібліотеки ; ['fopen'] ;
 ( Список новий ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
звʼязати: ( Список новий ;
 Ніщо ; # означає ту саму бібліотеку
 ['fread'] ;
 ( Список новий ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # означає той самий обʼєкт (тобто Потік)
 ['fread']
),
звʼязати: (
 Список новий ;
 Ніщо ; # означає ту саму бібліотеку
 ['fwrite'] ;
 ( Список новий ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # означає ту саму бібліотеку
 ['fwrite']
),
звʼязати: (
 Список новий ;
 Ніщо ; # означає ту саму бібліотеку
 ['rewind'] ;
 ( Список новий ; ['pointer'] ) ;
 ['int'] ;
 Ніщо ; # означає ту саму бібліотеку
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> шлях := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# відкрити файл за допомогою fopen(path, mode)
>> fd := Stream path: шлях mode: mode.

# записати байти з буфера рядок у файл
>> записано-байтів := Stream повідомлення: ['fwrite'] аргументи: (Список новий ; str ; 1 ; 6 ; fd ).
Вивід написати: записано-байтів, новий-рядок.

# перемотати вказівник файлу на початок
Stream rewind: fd.

# виділити буфер
>> буф := Blob новий: 20.

# читати з файлу
>> прочитано-байтів := Stream повідомлення: ['fread'] аргументи: (Список новий ; буф ; 1 ; 6 ; fd ).
Вивід написати: прочитано-байтів, новий-рядок.
Вивід написати: буф, новий-рядок.

# звільнити памʼять
str  звільнити.
шлях звільнити.
mode звільнити.
буф  звільнити.


