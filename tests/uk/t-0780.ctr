Server init.

# кодувальник JSON підтримує лише UTF-8, без сурогатних пар

>> словники := Список новий ;
	# {"key":"normal"} звичайний ASCII
	( Словник новий поставити: ['звичайний'] у: ['key'] ) ;
	# {"key":"hello world"} символ пробілу
	( Словник новий поставити: ['hello world'] у: ['key'] ) ;
	# {"key":"quote: \""} подвійна лапка
	( Словник новий поставити: ['"'] у: ['key'] ) ;
	# {"key":"backslash: \\"} зворотна скісна риска
	( Словник новий поставити: ['backslash: \\'] у: ['key'] ) ;
	# {"key":"slash: /"} скісна риска
	( Словник новий поставити: ['скісна: /'] у: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Словник новий поставити: ['backspace: \b'] у: ['key'] ) ;
	# {"key":"formfeed: \f"} екранування form-feed
	( Словник новий поставити: ['formfeed: \f'] у: ['key'] ) ;
	# {"key":"newline: \n"} новий рядок
	( Словник новий поставити: ['newline: \n'] у: ['key'] ) ;
	( Словник новий поставити: ['newline: ↵'] у: ['key'] ) ;
	( Словник новий поставити: ['newline: 
	'] у: ['key'] ) ;
	# {"key":"carriage return: \r"} повернення каретки
	( Словник новий поставити: ['carriage return: \r'] у: ['key'] ) ;
	# {"key":"tab: \t"} табуляція
	( Словник новий поставити: ['tab \t'] у: ['key'] ) ;
	( Словник новий поставити: ['tab ⇿'] у: ['key'] ) ;
	( Словник новий поставити: ['табуляція  '] у: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Словник новий поставити: ['NUL \u0000'] у: ['key'] ) ;
	( Словник новий поставити: ['NUL \0'] у: ['key'] ) ;
	# {"key":"control: \u0001"} керівний символ 0x01
	( Словник новий поставити: ['control: \u0001'] у: ['key'] ) ;
	# {"key":"control: \u001F"} керівний символ 0x1F
	( Словник новий поставити: ['control: \u001F'] у: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-байтовий символ
	( Словник новий поставити: ['юнікод: é'] у: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-байтовий символ
	( Словник новий поставити: ['юнікод: €'] у: ['key'] ) ;
	# {"key":"unicode: 日本語"} кілька 3-байтових символів UTF-8
	( Словник новий поставити: ['юнікод: 日本語'] у: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-байтовий символ
	( Словник новий поставити: ['юнікод: 😀'] у: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} емодзі + zero-width joiner
	( Словник новий поставити: ['юнікод: 🧑‍💻'] у: ['key'] ) ;
	# {"key":"combining: é"} комбінований діакритичний знак
	( Словник новий поставити: ['combining: e\u0301'] у: ['key'] ) ;
	# {"key":"escaped unicode: é"} екранування Unicode BMP
	( Словник новий поставити: ['escaped unicode: \u00e9'] у: ['key'] ) ;
	# {"key":"escaped unicode: €"} екранування Unicode BMP
	( Словник новий поставити: ['escaped unicode: \u20ac'] у: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} сурогатна пара UTF-16
	( Словник новий поставити: ['escaped unicode: \ud83d\ude00'] у: ['key'] ) ;
	# {"key":""} порожнє значення
	( Словник новий поставити: [''] у: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} спеціальні символи ASCII
	( Словник новий поставити: ['@ < > & = % + ? #'] у: ['key'] ) ;
	# {"key":"single quote: '"} одинарна лапка
	( Словник новий поставити: ['''] у: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} кілька екранувань JSON
	( Словник новий поставити: ['multiple: \" \\ \n \r \t'] у: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} довший ASCII-рядок
	( Словник новий поставити: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] у: ['key'] ) ;
	# {"key":" value"} пробіл на початку
	( Словник новий поставити: [' значення'] у: ['key'] ) ;
	# {"key":"value "} пробіл у кінці
	( Словник новий поставити: ['значення '] у: ['key'] ) ;
	# {"key":" \t\n\r "} пробільні символи
	( Словник новий поставити: [' \t\n\r '] у: ['key'] )
	.

словники кожен: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Словник новий поставити: d key у: ['key']).
	>> b := JSON jsonify: (Словник новий поставити: ['value'] у: d key).
	>> e := JSON обʼєкт: a.
	>> f := JSON обʼєкт: b.
	((e key = d key і: (f ? d key = ['value'])) або: (e key = ['NUL ?'])) істина: {
		Вивід написати: ['OK'], новий-рядок.
	}, інакше: {
		Вивід написати: ['Неможливо коректно закодувати/декодувати: '] + d + j, новий-рядок.
		Програма кінець.
	}.
}.
