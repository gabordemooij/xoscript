
>> Прямокутник := Обʼєкт новий.

Прямокутник при: ['площа'] виконати: {
	<- свій довжина * свій ширина.
}.

Прямокутник при: ['length:'] виконати: { :довжина
	свій довжина := довжина.
}.

Прямокутник при: ['width:'] виконати: { :ширина
	свій ширина := ширина.
}.

Прямокутник при: ['новий'] виконати: {
	# це не призведе до нескінченного циклу
	>> прямокутник := сам новий.
	прямокутник length: 0, width: 0.
	<- прямокутник.
}.

>> a := Прямокутник новий.
Вивід написати: a площа, новий-рядок. #0

>> b := Прямокутник новий length: 2, width: 3.
Вивід написати: b площа, новий-рядок. #6

