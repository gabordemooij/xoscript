
>> Rectangle := Обʼєкт новий.

Rectangle при: ['area'] виконати: { <- свій довжина * свій width.
}.

Rectangle при: ['length:'] виконати: { :довжина
	свій довжина := довжина.
}.

Rectangle при: ['width:'] виконати: { :width
	свій width := width.
}.

Rectangle при: ['новий'] виконати: {
	# this will not result into an infinite loop
	>> rectangle := сам новий.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle новий.
Вивід написати: a area, новий-рядок. #0

>> b := Rectangle новий length: 2, width: 3.
Вивід написати: b area, новий-рядок. #6

