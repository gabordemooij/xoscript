
Текст при: ['evaluate'] виконати: {
	>> код := Файл новий: ['/tmp/eval.ctr'].
	код написати: (сам текст + ['.']).
	Програма використати: ['/tmp/eval.ctr'].
}.

>> map :=
	(Словник новий)
	поставити: ['Hi There'] у: ['two'],
	поставити: (Список ← ['hello'] ; ['world'] ; (Список ← 1 ; 2; 9) ; Хиба) у: ['one'],
	поставити: ( (Словник новий) поставити: ['wrrld'] у: ['misspelled'] ) у: ['three'],
	поставити: (Список ← ((Словник новий) поставити: ['treasure'] у: ['hidden']) ; 2) у: ['four']. 
>> str := map текст.
>> map2 := Ніщо.
(['map2 := '] + str ) evaluate.
Вивід написати: map2 ? ['one'] ? 0.
Вивід написати: map2 ? ['one'] ? 1.
Вивід написати: map2 ? ['four'] ? 0 ? ['hidden'].
Вивід написати: map2 ? ['one'] ? 2 ? 2.
