
Текст при: ['обчислити'] виконати: {
	>> код := Файл новий: ['/tmp/eval.ctr'].
	код написати: (сам текст + ['.']).
	Програма використати: ['/tmp/eval.ctr'].
}.

>> map :=
	(Словник новий)
	поставити: ['Вітаю всіх'] у: ['two'],
	поставити: (Список ← ['hello'] ; ['world'] ; (Список ← 1 ; 2; 9) ; Хиба) у: ['один'],
	поставити: ( (Словник новий) поставити: ['свт'] у: ['з-помилкою'] ) у: ['three'],
	поставити: (Список ← ((Словник новий) поставити: ['скарб'] у: ['приховане']) ; 2) у: ['чотири']. 
>> str := map текст.
>> map2 := Ніщо.
(['map2 := '] + str ) обчислити.
Вивід написати: map2 ? ['один'] ? 0.
Вивід написати: map2 ? ['один'] ? 1.
Вивід написати: map2 ? ['чотири'] ? 0 ? ['приховане'].
Вивід написати: map2 ? ['один'] ? 2 ? 2.
