
Список при: ['product'] виконати: {
	>> total := 1.
	сам кожен: { :index :element
		total помножити-на: element.
	}. <- total.
}.

>> a := Список ← 1 ; 2 ; 3.
Вивід написати: a product, новий-рядок.
Вивід написати: (Список ← 2 ; 4 ; 8) product, новий-рядок. 
Вивід написати: (Список ← -2 ; 10) product, новий-рядок. 
Вивід написати: (Список ← 0.5 ; -2) product, новий-рядок. 
