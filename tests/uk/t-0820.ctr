# група, що не є частиною збігу, не має спричиняти збій і має зберігати номери груп
Server init.
>> показати := { :взірець :subject
	>> p := Шаблон новий: взірець.
	p збіг: subject виконати: { :m :g
		Вивід написати: g кількість, написати: [' '], написати: (g зʼєднати: ['|']), новий-рядок.
		<- m.
	}.
}.
показати застосувати: ['(a)|(b)'] і: ['b'].
показати застосувати: ['(a)|(b)'] і: ['a'].
показати застосувати: ['(x)?y'] і: ['y'].
показати застосувати: ['(x)?(y)(z)?'] і: ['xy'].
