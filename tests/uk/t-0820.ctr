# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Шаблон новий: pattern.
	p збіг: subject виконати: { :m :g
		Вивід написати: g кількість, написати: [' '], написати: (g зʼєднати: ['|']), новий-рядок. <- m.
	}.
}.
show застосувати: ['(a)|(b)'] і: ['b'].
show застосувати: ['(a)|(b)'] і: ['a'].
show застосувати: ['(x)?y'] і: ['y'].
show застосувати: ['(x)?(y)(z)?'] і: ['xy'].
