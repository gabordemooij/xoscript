Server init.
>> a := Blob новий: 4.
a bytes: ( Список новий ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новий: 4.
b bytes: ( Список новий ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# успадкований blob не отримує буфер, тож він марний
# він пройде ctr_accept(), але оскільки buffer ptr == null, повер
>> c := a новий.
{ 
>> n := a ^ c.
Вивід написати: ['xorred:'], новий-рядок. 
Вивід написати: n, новий-рядок. 
} перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
a звільнити.
b звільнити.
