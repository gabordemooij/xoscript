# a format must fit the type of the value, the type can come from a client
>> спробувати := { :format :value
	{ Вивід написати: ( (Формат новий: format) застосувати: value ), новий-рядок. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
}.
>> try-int := { :format :value
	{ Вивід написати: ( (Формат новий: format) застосувати-ціле: value ), новий-рядок. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
}.

# fits
спробувати застосувати: ['|%s|'] і: ['text'].
спробувати застосувати: ['%06.2f'] і: 5.5.
спробувати застосувати: ['100%% %s'] і: ['sure'].
try-int застосувати: ['%03d'] і: 7.
try-int застосувати: ['%x'] і: 255.
спробувати застосувати: ['%d'] і: (Int64 новий з-тексту: ['12']).
спробувати застосувати: ['%lld'] і: (Int64 новий з-тексту: ['12']).
спробувати застосувати: ['%.1lf'] і: 5.5.
try-int застосувати: ['%hd'] і: 7.

# does not fit
спробувати застосувати: ['%s'] і: 12345.
спробувати застосувати: ['%d'] і: 12345.
спробувати застосувати: ['%f'] і: ['text'].
try-int застосувати: ['%d'] і: ['text'].
try-int застосувати: ['%s'] і: 5.
спробувати застосувати: ['%s %s'] і: ['text'].
спробувати застосувати: ['%n'] і: ['text'].
спробувати застосувати: ['%*s'] і: ['text'].
спробувати застосувати: ['%'] і: ['text'].

# length modifier does not fit
спробувати застосувати: ['%ls'] і: ['text'].
спробувати застосувати: ['%Lf'] і: 5.5.
try-int застосувати: ['%ld'] і: 7.
try-int застосувати: ['%lld'] і: 7.
спробувати застосувати: ['%Ld'] і: (Int64 новий з-тексту: ['12']).

# a width that does not fit printf must give an error, not a crash
спробувати застосувати: ['%99999999999s'] і: ['text'].
