# формат має відповідати типу значення, тип може надійти від клієнта
>> спробувати := { :шаблон-формату :value
	{ Вивід написати: ( (Формат новий: шаблон-формату) застосувати: value ), новий-рядок. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
}.
>> спробувати-ціле := { :шаблон-формату :value
	{ Вивід написати: ( (Формат новий: шаблон-формату) застосувати-ціле: value ), новий-рядок. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
}.

# підходить
спробувати застосувати: ['|%s|'] і: ['text'].
спробувати застосувати: ['%06.2f'] і: 5.5.
спробувати застосувати: ['100%% %s'] і: ['звісно'].
спробувати-ціле застосувати: ['%03d'] і: 7.
спробувати-ціле застосувати: ['%x'] і: 255.
спробувати застосувати: ['%d'] і: (Int64 новий з-тексту: ['12']).
спробувати застосувати: ['%lld'] і: (Int64 новий з-тексту: ['12']).
спробувати застосувати: ['%.1lf'] і: 5.5.
спробувати-ціле застосувати: ['%hd'] і: 7.

# не підходить
спробувати застосувати: ['%s'] і: 12345.
спробувати застосувати: ['%d'] і: 12345.
спробувати застосувати: ['%f'] і: ['text'].
спробувати-ціле застосувати: ['%d'] і: ['text'].
спробувати-ціле застосувати: ['%s'] і: 5.
спробувати застосувати: ['%s %s'] і: ['text'].
спробувати застосувати: ['%n'] і: ['text'].
спробувати застосувати: ['%*s'] і: ['text'].
спробувати застосувати: ['%'] і: ['text'].

# модифікатор довжини не підходить
спробувати застосувати: ['%ls'] і: ['text'].
спробувати застосувати: ['%Lf'] і: 5.5.
спробувати-ціле застосувати: ['%ld'] і: 7.
спробувати-ціле застосувати: ['%lld'] і: 7.
спробувати застосувати: ['%Ld'] і: (Int64 новий з-тексту: ['12']).

# ширина, що не підходить для printf, має давати помилку, а не збій
спробувати застосувати: ['%99999999999s'] і: ['text'].
