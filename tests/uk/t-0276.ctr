>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Обʼєкт новий.
⚄ при: ['drawFrom:length:'] виконати: { :pool :кількість
	
	>> result := [''].
	
	{
		>> index := Число random % (pool довжина).
		result додати-в-кінець: ( pool символ: (index + 1) ).
		
	} × кількість. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? довжина.
Вивід написати: (['x↵'] x random довжина).
Вивід написати: (['y↵'] y ?? довжина).

