>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Обʼєкт новий.
⚄ при: ['витягти-з:кількістю:'] виконати: { :запас :кількість
	
	>> результат := [''].
	
	{
		>> індекс := Число random % (запас довжина).
		результат додати-в-кінець: ( запас символ: (індекс + 1) ).
		
	} × кількість. <- результат.
}.

>> random := ⚄ витягти-з: ?? кількістю: ?? довжина.
Вивід написати: (['x↵'] x random довжина).
Вивід написати: (['y↵'] y ?? довжина).

