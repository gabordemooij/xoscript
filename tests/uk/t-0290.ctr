# тест операцій зі списками


>> тістечка := Список ←
	['apple'] ;
	['ягода'] ;
	['шоколад'] ;
	['сир'].


>> купити := тістечка замінити: 1 довжина: 2 на: ( Список ← ['кориця'] ; ['ананас'] ).
Вивід написати: (купити зʼєднати: [',']), новий-рядок.


>> купити := тістечка замінити: 1 довжина: 12 на: ( Список ← ['кориця'] ; ['ананас'] ).
Вивід написати: (купити зʼєднати: [',']), новий-рядок.


>> купити := тістечка замінити: 2 довжина: 10 на: ( Список новий ).
Вивід написати: (купити зʼєднати: [',']), новий-рядок.


>> купити := тістечка замінити: 0 довжина: 1 на: ( Список новий ).
Вивід написати: (купити зʼєднати: [',']), новий-рядок.


>> купити := тістечка замінити: ['0'] довжина: ['1'] на: ['x'].
Вивід написати: (купити зʼєднати: [',']), новий-рядок.
