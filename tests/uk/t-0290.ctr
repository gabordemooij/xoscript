# test list operations


>> cakes := Список ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes замінити: 1 довжина: 2 на: ( Список ← ['cinnamon'] ; ['pineapple'] ).
Вивід написати: (buy зʼєднати: [',']), новий-рядок.


>> buy := cakes замінити: 1 довжина: 12 на: ( Список ← ['cinnamon'] ; ['pineapple'] ).
Вивід написати: (buy зʼєднати: [',']), новий-рядок.


>> buy := cakes замінити: 2 довжина: 10 на: ( Список новий ).
Вивід написати: (buy зʼєднати: [',']), новий-рядок.


>> buy := cakes замінити: 0 довжина: 1 на: ( Список новий ).
Вивід написати: (buy зʼєднати: [',']), новий-рядок.


>> buy := cakes замінити: ['0'] довжина: ['1'] на: ['x'].
Вивід написати: (buy зʼєднати: [',']), новий-рядок.
