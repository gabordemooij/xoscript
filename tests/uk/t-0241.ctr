

Текст при: ['evaluate'] виконати: {
	>> код := Файл новий: ['/tmp/eval.ctr'].
	код написати: (сам текст + ['.']).
	Програма використати: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Список ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q текст.
Вивід написати: x, новий-рядок.
>> y := Ніщо.
(['y := '] + x ) evaluate.
Вивід написати: y ? 0, новий-рядок.

q := Словник поставити: ['\[''] у: ['\['quote\']'].
x := q текст.
Вивід написати: x, новий-рядок.
y := Ніщо.
(['y := '] + x ) evaluate.

>> q := (Словник новий) поставити:['\[''] у:['\['quote\[''].
Вивід написати: y ? ['\['quote\']'], новий-рядок.
