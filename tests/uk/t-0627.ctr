

# create a 64-bit integer for exact calculations
>> a := Int64 з-тексту: ['123'].

# to string
Вивід написати: a, новий-рядок.

# divide
Вивід написати: a / (Int64 з-тексту: ['3']), новий-рядок.

# multiply
Вивід написати: a * (Int64 з-тексту: ['2']), новий-рядок.

# add
Вивід написати: a + (Int64 з-тексту: ['1']), новий-рядок.

# subtract
Вивід написати: a - (Int64 з-тексту: ['2']), новий-рядок.

# compare
Вивід написати: ( a =   (Int64 з-тексту: ['123'])), новий-рядок.
Вивід написати: ( a !=: (Int64 з-тексту: ['124'])), новий-рядок.
Вивід написати: ( a <   (Int64 з-тексту: ['124'])), новий-рядок.
Вивід написати: ( a >   (Int64 з-тексту: ['122'])), новий-рядок.
Вивід написати: ( a >=: (Int64 з-тексту: ['123'])), новий-рядок.
Вивід написати: ( a <=: (Int64 з-тексту: ['123'])), новий-рядок.





	