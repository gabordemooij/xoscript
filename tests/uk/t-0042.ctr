>> items := Словник новий.
items поставити: ['black'] у: ['coffee'], поставити: ['earl grey'] у: ['tea'].
Вивід написати: (items на: ['coffee']), написати: (items на: ['tea']).
Вивід написати: ['there are'] + items кількість + [' items in the array.'].
items поставити: ['capuccino'] у: ['coffee'].
Вивід написати: ['Now my coffee is.. '] + (items на: ['coffee']).
items поставити: ['aaa'] у: ['1'].
items поставити: ['bbb'] у: ['2'].
Вивід написати: (items на: ['a']).
