>> items := Словник новий.
items поставити: ['чорний'] у: ['coffee'], поставити: ['earl grey'] у: ['чай'].
Вивід написати: (items на: ['coffee']), написати: (items на: ['чай']).
Вивід написати: ['маємо'] + items кількість + [' елементів у масиві.'].
items поставити: ['капучино'] у: ['coffee'].
Вивід написати: ['Тепер моя кава.. '] + (items на: ['coffee']).
items поставити: ['aaa'] у: ['1'].
items поставити: ['bbb'] у: ['2'].
Вивід написати: (items на: ['a']).
