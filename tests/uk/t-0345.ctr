# test catch-all methods
>> x13 := Обʼєкт новий.
x13 при: ['a'] виконати: { :a Вивід написати: 0, новий-рядок. }.
x13 при: ['a:'] виконати: { :a Вивід написати: a, новий-рядок. <- 5. }.
x13 при: ['a:b:'] виконати: { :a :b Вивід написати: (a + b), новий-рядок. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
