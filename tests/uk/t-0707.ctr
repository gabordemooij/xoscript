# тест приведення типів / перетворень / привʼязок
Програма керування-памʼяттю: 4.
Server init.

>> лічильник := 0.
>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'], пароль: ['pass123'], назва-бази: ['xobase'], підключити.

>> Двоцифровий-формат := Формат новий: ['%02d'].

# Дата й час
{
	>> рік     := Число між: 1995 і: 2050, текст.
	>> місяць    := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 12), текст.
	>> день      := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 28), текст.
	>> година     := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 23), текст.
	>> хвилина   := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 59), текст.
	>> секунда   := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 59), текст.
	>> дата-час := ['YYYY-MM-DD HH:II:SS'].	
	дата-час
		YYYY: рік,
		MM: місяць,
		DD: день,
		HH: година,
		II: хвилина,
		SS: секунда.
	>> параметри-пошуку :=
	бд запит: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: дата-час),
	отримати: { :ряд
		(ряд mydatetime = дата-час) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: дата-час,
				<observation>: ряд mydatetime
			).
		}.
	
	}.
	лічильник додати: 1.
} * 100.

# Дата
{
	>> рік     := Число між: 1995 і: 2050, текст.
	>> місяць    := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 12), текст.
	>> день      := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 28), текст.
	>> дата     := ['YYYY-MM-DD'].
	дата
		YYYY: рік,
		MM: місяць,
		DD: день.
	>> параметри-пошуку :=
	бд запит: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: дата),
	отримати: { :ряд
		(ряд mydate = дата) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: дата,
				<observation>: ряд mydate
			).
		}.
	}.
	лічильник додати: 1.
} * 100.


# Час
{
	>> година     := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 23), текст.
	>> хвилина   := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 59), текст.
	>> секунда   := Двоцифровий-формат застосувати-ціле: (Число між: 1 і: 59), текст.
	>> час := ['HH:II:SS'].
	час
		HH: година,
		II: хвилина,
		SS: секунда.
	>> параметри-пошуку :=
	бд запит: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: час),
	отримати: { :ряд
		(ряд mytime = час) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: дата-час,
				<observation>: ряд mytime
			).
		}.
	}.
	лічильник додати: 1.
} * 100.


# Тексти (varchar/text)
>> str1 := Список новий заповнити: 100000 чим: ['x'], зʼєднати: [''].
{
	>> str2 := Сховище токен: 40.
	>> параметри-пошуку :=
	бд запит: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	отримати: { :ряд
		(ряд str1 = str1 і: ряд str2 = str2) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: дата-час,
				<observation>: ряд mytime
			).
		}.
	}.
	лічильник додати: 1.
} * 100.


# Числа
{
	>> n1  := Число між: 1 і: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 з-тексту: ['9223372036854775807'] ) -
		( Int64 з-тексту: ['99999'] ) +
		( Int64 з-тексту: n1 текст )
	).
	>> параметри-пошуку :=
	бд запит: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	отримати: { :ряд
		(ряд n1 = n1) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: n1,
				<observation>: ряд n1
			).
		}.
		(ряд n2 = n2) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: n1,
				<observation>: ряд n2
			).
		}.
		(ряд n3 = n2 округлити) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: n1,
				<observation>: ряд n3
			).
		}.
		(ряд big = big) хиба: {
			це-завдання помилка: (
				['Очікувалося: <expected>, отримано: <observation>']
				<expected>: big,
				<observation>: ряд big
			).
		}.
		
	}.
	лічильник додати: 1.
} * 100.


Вивід написати: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: лічильник
), новий-рядок.