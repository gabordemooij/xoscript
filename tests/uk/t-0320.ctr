


>> Кавоварка := Обʼєкт новий.
Кавоварка при: ['order:'] виконати: { :id
	>> coffee := ['Американо'].
	( id = 1 ) істина: {
		coffee := ['Капучино'].
	}.
	( id = 2 ) істина: {
		coffee := ['Еспресо'].
	}.
	( id = 3 ) істина: {
		coffee := ['Лате'].
	}. <- coffee.
}.
>> Проста-кавоварка := Обʼєкт новий.
Проста-кавоварка при: ['замовлення'] виконати: { <- ['Чорна']. }.
>> червона-чашка := Кавоварка order: 1.
Вивід написати: червона-чашка, новий-рядок.
червона-чашка := ['Чай']. 
