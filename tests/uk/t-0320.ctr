


>> CoffeeMachine := Обʼєкт новий.
CoffeeMachine при: ['order:'] виконати: { :id
	>> coffee := ['Americano'].
	( id = 1 ) істина: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) істина: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) істина: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Обʼєкт новий.
SimpleCoffeeMachine при: ['order'] виконати: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Вивід написати: redCup, новий-рядок.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Вивід написати: greenCup, новий-рядок.
>> yellowCup := CoffeeMachine order: 1.
Вивід написати: yellowCup, новий-рядок.
>> blueCup := CoffeeMachine order: 0.
Вивід написати: blueCup, новий-рядок.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Вивід написати: blackCup, новий-рядок.
blackCup додати-в-кінець: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Вивід написати: orangeCup, новий-рядок.
