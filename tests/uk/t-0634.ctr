# Програма shell-escape створює канонічний синтаксис posix shell
# сумісно з: bash/dash, zsh, ksh

>> c := Програма shell-escape: ['abc'].
Вивід написати: c, новий-рядок.
Вивід написати: ( Програма система: ['echo '] + c ), новий-рядок.

c := Програма shell-escape: ['a'b'c'].
Вивід написати: c, новий-рядок.
Вивід написати: ( Програма система: ['echo '] + c ), новий-рядок.

c := Програма shell-escape: ['a\'c'].
Вивід написати: c, новий-рядок.
Вивід написати: ( Програма система: ['echo '] + c ), новий-рядок.