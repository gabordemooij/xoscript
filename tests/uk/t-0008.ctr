>> Greeter := Обʼєкт новий.
Greeter при: ['make'] виконати: {
	>> greeter := Обʼєкт новий.
	greeter при: ['name:'] виконати: { :імʼя
		Вивід написати: ['setting a name'].
		свій myName := імʼя.
	}.
	greeter при: ['greet'] виконати: {
		Вивід написати: ['Hello'].
		Вивід написати: свій myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
