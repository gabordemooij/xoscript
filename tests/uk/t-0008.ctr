>> Вітальник := Обʼєкт новий.
Вітальник при: ['створити'] виконати: {
	>> вітальник := Обʼєкт новий.
	вітальник при: ['name:'] виконати: { :імʼя
		Вивід написати: ['задаємо імʼя'].
		свій моє-імʼя := імʼя.
	}.
	вітальник при: ['привітати'] виконати: {
		Вивід написати: ['Hello'].
		Вивід написати: свій моє-імʼя.
	}. <- вітальник.
}.
>> вітальник := Вітальник створити.
вітальник name: ['сонечко!'].
вітальник привітати.
