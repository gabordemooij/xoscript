# Встановлення будильника

# завершує програму через 1 сек.
Програма будильник: 1.

Вивід написати: ['макс. 1 с.'], новий-рядок.
Момент чекати: 2.
Вивід написати: ['триває задовго.'], новий-рядок.

# примітка:
# Встановлення будильника незворотне,
# зловмисник не може його вимкнути.
# Після першого виклику будильник заблоковано.
# Крім того, будильник дуже суворий:
# програму *БУДЕ* зупинено після
# заданого інтервалу часу, навіть якщо вона
# перебуває в блокуючому читанні чи чомусь подібному.

# примітка:
# Будильник — важкий засіб, краще задайте базові
# тайм-аути у вебсервері.



