
Вивід написати: ['Перервати цикл for, 0-4.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 4) перервати.
} × 10.

>> x := 0.
>> x-менше-за-10 := { <- ( x < 10 ). }.

Вивід написати: ['Перервати цикл while-true, 0-4.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x додати: 1.
	((x < 5) не) перервати.
} поки: x-менше-за-10.

Вивід написати: ['Перервати цикл while-false, 5,4.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x відняти: 1.
	(x = 3) перервати.
} поки: { <- (x > 0). }.

Вивід написати: ['Перервати цикл times, 1-4.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 4) перервати.
} × 5.

Вивід написати: ['Перервати блок, не друкувати рядок.'], новий-рядок.
{ Істина перервати. Вивід написати: ['не пиши це!'], новий-рядок. } запустити.

Вивід написати: ['Перервати блок, не запускати catch...'], новий-рядок.
{ Істина перервати. Вивід написати: ['не пиши це!'], новий-рядок. } перехопити: { Вивід написати: ['Не перехоплюй це!']. }, запустити.

Вивід написати: ['Тест циклу each по масиву: 0,1'], новий-рядок.
(Список ← 1 ; 2 ; 3) перетворити: { :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 1) перервати.
}.

Вивід написати: ['Тест циклу each по мапі: лише c'], новий-рядок.
>> m := Словник новий.
m поставити: ['first'] у: ['a'], поставити: ['second'] у: ['b'], поставити: ['третій'] у: ['c'].
m кожен: { :k :v
	Вивід написати: ['iteration'] + v + k, новий-рядок.
	Істина перервати.
}.

