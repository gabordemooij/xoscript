
Вивід написати: ['Break for-loop, 0-4.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 4) перервати.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Вивід написати: ['Break while-true loop, 0-4.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x додати: 1.
	((x < 5) не) перервати.
} поки: xIsLessThan10.

Вивід написати: ['Break while-false loop, 5,4.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x відняти: 1.
	(x = 3) перервати.
} поки: { <- (x > 0). }.

Вивід написати: ['Break times loop, 1-4.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 4) перервати.
} × 5.

Вивід написати: ['Break block, dont print line.'], новий-рядок.
{ Істина перервати. Вивід написати: ['dont write this!'], новий-рядок. } запустити.

Вивід написати: ['Break block, dont fire catch...'], новий-рядок.
{ Істина перервати. Вивід написати: ['dont write this!'], новий-рядок. } перехопити: { Вивід написати: ['Dont catch this!']. }, запустити.

Вивід написати: ['Test Array each-loop: 0,1'], новий-рядок.
(Список ← 1 ; 2 ; 3) перетворити: { :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 1) перервати.
}.

Вивід написати: ['Test Map each-loop: c only'], новий-рядок.
>> m := Словник новий.
m поставити: ['first'] у: ['a'], поставити: ['second'] у: ['b'], поставити: ['third'] у: ['c'].
m кожен: { :k :v
	Вивід написати: ['iteration'] + v + k, новий-рядок.
	Істина перервати.
}.

