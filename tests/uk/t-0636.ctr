# test url parsing

Server init.
>> url := URL з: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Вивід написати: ['scheme = '] + url схема, новий-рядок.
Вивід написати: ['host = '] + url хост, новий-рядок.
Вивід написати: ['port = '] + url порт, новий-рядок.
Вивід написати: ['path = '] + url шлях, новий-рядок.
Вивід написати: ['query = '] + url параметри-пошуку, новий-рядок.
Вивід написати: ['fragment = '] + url фрагмент, новий-рядок.
