# тест розбору url

Server init.
>> url := URL з: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Вивід написати: ['схема = '] + url схема, новий-рядок.
Вивід написати: ['хост = '] + url хост, новий-рядок.
Вивід написати: ['порт = '] + url порт, новий-рядок.
Вивід написати: ['шлях = '] + url шлях, новий-рядок.
Вивід написати: ['запит = '] + url параметри-пошуку, новий-рядок.
Вивід написати: ['фрагмент = '] + url фрагмент, новий-рядок.
