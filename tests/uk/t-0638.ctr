
Server init.
>> зп := HTTP-Запит новий.
Вивід написати: ['HTTP-GET d[]=']  + ( зп get-список: ['d[]'] ), новий-рядок. # GET
Вивід написати: ['HTTP-GET f[]=']  + ( зп get-список: ['f[]'] ), новий-рядок. # GET
Вивід написати: ['HTTP-POST e[]='] + ( зп post-список: ['e[]'] ), новий-рядок. # GET
Вивід написати: ['HTTP-POST c=']   + ( зп post: ['c'] ), новий-рядок. # GET
Вивід написати: ['HTTP-POST xx=']  + ( зп post: ['xx'] ), новий-рядок. # GET
