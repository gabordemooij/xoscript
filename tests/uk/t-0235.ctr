>> Slurp := Обʼєкт новий.
Slurp при: ['новий'] виконати: {
	свій str := [''].
}.

Slurp при: ['відповісти:'] виконати: { :blah
		(свій str ≠ ['']) істина: {
			свій str додати-в-кінець: [' '].
		}.
		свій str додати-в-кінець: blah.
}.
Slurp при: ['відповісти:і:'] виконати: { :blah :blahah
		(свій str ≠ ['']) істина: {
			свій str додати-в-кінець: [' '].
		}.
		(blah довжина > 1) істина: {
			свій str додати-в-кінець: (blah від: 0 довжина: (blah довжина - 1)).
		}, інакше: {
			свій str додати-в-кінець: blah.
		}.
		свій str додати-в-кінець: [' '].
		свій str додати-в-кінець: blahah.
}.
Slurp при: ['obtain'] виконати: {
	>> buffer := свій str.
	свій str := ['']. <- buffer.
}.

>> s := Slurp новий.
s hello: ['world'].
Вивід написати: ( s obtain ), новий-рядок.
