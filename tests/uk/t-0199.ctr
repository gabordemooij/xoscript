
Програма керування-памʼяттю: 4.

>> Тварина := Обʼєкт новий.
Тварина при: ['створити'] виконати: {
	>> тварина := Обʼєкт новий.
	тварина при: ['видати-звук'] виконати: {
		Вивід написати: свій звук.
	}. <- тварина.
}.
>> Кіт := Обʼєкт новий.
Кіт при: ['створити'] виконати: {
	>> кіт := Тварина створити.
	кіт при: ['init'] виконати: {
		свій звук := ['meow!'].
	}.
	кіт init. <- кіт.
}.
>> tom := Кіт створити.
tom видати-звук.
