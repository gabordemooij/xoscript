>> a := 3.
>> b := a копіювати.
a відняти: 1.
Вивід написати: [' a = '] + a.
Вивід написати: [' b = '] + b.
a := 3.
b := a + 4.
Вивід написати: [' a = '] + a.
Вивід написати: [' b = '] + b.
>> x := 3.
>> y := x копіювати.
x додати: 10.
y відняти: 1.
Вивід написати: [' x = '] + x.
Вивід написати: [' y = '] + y.
>> q := Обʼєкт новий.
q при: ['setProperty:'] виконати: { :x
	свій prop := x.
}.
q при: ['getProperty'] виконати: { <- свій prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Вивід написати: [' p = '] + (p getProperty).
