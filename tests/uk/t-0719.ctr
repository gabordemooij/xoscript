Server init.
>> фмт := Формат новий: ['%#3x'].

>> blob := Blob новий: 4.
blob bytes: ( 
	Список новий ; 0 ; 1 ; 2 ; 3
).

>> file := Файл новий: ['/tmp/blob'].
file blob: blob.
blob звільнити.

>> читати := file blob.
читати 
від: 0 
довжина: 4, 
робити кожен: { :i :b 
	Вивід
	написати: (фмт застосувати-ціле: b),
	новий-рядок.
}.
читати звільнити.
