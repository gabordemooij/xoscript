# тест означень

>> $ := Обʼєкт новий.

$ при: ['відповісти:'] виконати: { :x
	
	>> операція := x символ: 0.
	>> знак-валюти := x символ: 1.
	>> гроші := x зсув: 2.
	
	>> вартість := 0.

	( операція = ['+'] ) істина: {
		( знак-валюти = ['£'] ) істина: { вартість := 1.28 × гроші. }.
	}. <- вартість.
}.



>> x := $ +£20.

Вивід написати: x, новий-рядок.


>> Фрукт := Обʼєкт новий.

Фрукт при: ['новий'] виконати: {
	>> f := сам новий.
	f apples: 0.
	f oranges: 0. <- f.
}.

Фрукт при: ['apples:'] виконати: { :a свій яблука := a. }.
Фрукт при: ['oranges:'] виконати: { :p свій апельсини := p. }.
Фрукт при: ['яблука'] виконати: { <- свій яблука. }.
Фрукт при: ['апельсини'] виконати: { <- свій апельсини. }.

Фрукт при: ['+'] виконати: { :f
	
	>> n := Фрукт новий.
	f додати: 1.
	
	n apples: (f яблука + свій яблука).
	n oranges:  (f апельсини  + свій апельсини). <- n.
}.

Фрукт при: ['текст'] виконати: { <- ( свій яблука текст + [' яблук і '] + свій апельсини + [' апельсинів'] ).
}.

Число при: ['яблука'] виконати: { <- ((Фрукт новий) apples: сам).
}.

Число при: ['apple'] виконати: { <- ((Фрукт новий) apples: сам).
}.

Число при: ['апельсини'] виконати: { <- ((Фрукт новий) oranges: сам).
}.




Вивід написати: (1 apple + 3 апельсини + 4 яблука), новий-рядок.


Текст при: ['двічі'] виконати: { <- ((сам текст) + (сам текст)).
}.



Вивід написати: ['❤❤❤'] двічі.



