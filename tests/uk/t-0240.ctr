# test qualifiers

>> $ := Обʼєкт новий.

$ при: ['відповісти:'] виконати: { :x
	
	>> operation := x символ: 0.
	>> valuta := x символ: 1.
	>> money := x зсув: 2.
	
	>> amount := 0.

	( operation = ['+'] ) істина: {
		( valuta = ['£'] ) істина: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Вивід написати: x, новий-рядок.


>> Fruit := Обʼєкт новий.

Fruit при: ['новий'] виконати: {
	>> f := сам новий.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit при: ['apples:'] виконати: { :a свій apples := a. }.
Fruit при: ['oranges:'] виконати: { :p свій oranges := p. }.
Fruit при: ['apples'] виконати: { <- свій apples. }.
Fruit при: ['oranges'] виконати: { <- свій oranges. }.

Fruit при: ['+'] виконати: { :f
	
	>> n := Fruit новий.
	f додати: 1.
	
	n apples: (f apples + свій apples).
	n oranges:  (f oranges  + свій oranges). <- n.
}.

Fruit при: ['текст'] виконати: { <- ( свій apples текст + [' apples and '] + свій oranges + [' oranges'] ).
}.

Число при: ['apples'] виконати: { <- ((Fruit новий) apples: сам).
}.

Число при: ['apple'] виконати: { <- ((Fruit новий) apples: сам).
}.

Число при: ['oranges'] виконати: { <- ((Fruit новий) oranges: сам).
}.




Вивід написати: (1 apple + 3 oranges + 4 apples), новий-рядок.


Текст при: ['twice'] виконати: { <- ((сам текст) + (сам текст)).
}.



Вивід написати: ['❤❤❤'] twice.



