# повідомлення про помилки бази даних не можна обробляти як рядки формату
Server init.

>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> параметри-пошуку := бд запит: ['SELECT %% FROM'].
{ параметри-пошуку виконати. } перехопити: { :e
	Вивід написати: ( e містить: ['%%'] ), новий-рядок.
}, запустити.
