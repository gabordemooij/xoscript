# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> параметри-пошуку := db запит: ['SELECT %% FROM'].
{ параметри-пошуку виконати. } перехопити: { :e
	Вивід написати: ( e містить: ['%%'] ), новий-рядок.
}, запустити.
