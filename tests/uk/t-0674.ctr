# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> шлях := ['/tmp/dat.csv'].
>> csv := Файл новий: шлях.
csv написати: s.

# accepts CRLF LF CR, varying row length
csv роздільник: [';'] лапки: ['"'] рядки: { :line
	Програма прибрати.
	Вивід написати: line, новий-рядок.
	Програма прибрати.
}.

# unequal lines
s додати-в-кінець: ['\njustone'].
csv написати: s.
{
	csv роздільник: [';'] лапки: ['"'] рядки: { :line
		Вивід написати: line, новий-рядок.
	}.
} перехопити: { :e 
	Вивід написати: e, новий-рядок.
}, запустити.

# invalid format
s := ['"he"llo";world'].
csv написати: s.
{
	csv роздільник: [';'] лапки: ['"'] рядки: { :line
		Вивід написати: line, новий-рядок.
	}.
} перехопити: { :e 
	Вивід написати: e, новий-рядок.
}, запустити.
