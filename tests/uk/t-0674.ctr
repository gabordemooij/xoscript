# успішний сценарій
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> шлях := ['/tmp/dat.csv'].
>> csv := Файл новий: шлях.
csv написати: s.

# приймає CRLF LF CR, різна довжина рядків
csv роздільник: [';'] лапки: ['"'] рядки: { :line
	Програма прибрати.
	Вивід написати: line, новий-рядок.
	Програма прибрати.
}.

# нерівні рядки
s додати-в-кінець: ['\njustone'].
csv написати: s.
{
	csv роздільник: [';'] лапки: ['"'] рядки: { :line
		Вивід написати: line, новий-рядок.
	}.
} перехопити: { :e 
	Вивід написати: e, новий-рядок.
}, запустити.

# неприпустимий формат
s := ['"he"llo";world'].
csv написати: s.
{
	csv роздільник: [';'] лапки: ['"'] рядки: { :line
		Вивід написати: line, новий-рядок.
	}.
} перехопити: { :e 
	Вивід написати: e, новий-рядок.
}, запустити.
