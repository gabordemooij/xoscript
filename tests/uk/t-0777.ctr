#OBSD
>> dirname := [''].
{ dirname додати-в-кінець: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Програма система: command.
Програма chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename додати-в-кінець: ['YYYYYYYY']. } * 20.
Файл новий: filename, написати: ['sometext'].
{ Файл список: ['/tmp/'] + dirname. } * 1000.
Вивід написати: ['no crash'], новий-рядок.

