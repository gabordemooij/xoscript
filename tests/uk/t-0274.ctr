

Список при: ['column:'] виконати: { :column
	>> result := Список новий.
	сам кожен: { :index :row
		row кожен: { :index :cell
			(index = column) істина: { result додати-в-кінець: cell. }.
		}.
	}. <- result.
}.


>> a := Список ←
	(Список ← 1 ; 2 ; 3) ;
	(Список ← 4 ; 5 ; 6) ;
	(Список ← 7 ; 8 ; 9).

>> b := a column: 1.
Вивід написати: b, новий-рядок.

b := a column: 20.
Вивід написати: b, новий-рядок.

b := a column: -100.
Вивід написати: b, новий-рядок.
