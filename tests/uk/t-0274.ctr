

Список при: ['column:'] виконати: { :стовпець
	>> результат := Список новий.
	сам кожен: { :індекс :ряд
		ряд кожен: { :індекс :клітинка
			(індекс = стовпець) істина: { результат додати-в-кінець: клітинка. }.
		}.
	}. <- результат.
}.


>> a := Список ←
	(Список ← 1 ; 2 ; 3) ;
	(Список ← 4 ; 5 ; 6) ;
	(Список ← 7 ; 8 ; 9).

>> b := a column: 1.
Вивід написати: b, новий-рядок.

b := a column: 20.
Вивід написати: b, новий-рядок.

b := a column: -100.
Вивід написати: b, новий-рядок.
