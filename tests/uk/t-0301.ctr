


>> вино := Обʼєкт новий.


вино при: ['у-текст'] виконати: { <- ['merlot'].
}.

вино при: ['naarTekst'] виконати: { <- ['merlot'].
}.


вино при: ['='] виконати: { :other wine <- ( сам у-текст = other wine ).
}.

вино при: ['=='] виконати: { :other wine <- ( сам у-текст = other wine ).
}.



вино
	випадок: ['cabernet'] виконати: { Вивід написати: ['це Каберне!']. },
	випадок: ['syrah']    виконати: { Вивід написати: ['це Сіра!'].    },
	випадок: ['merlot']   виконати: { Вивід написати: ['це Мерло!'].   },
	випадок: ['malbec']   виконати: { Вивід написати: ['це Мальбек!'].   }.

Вивід новий-рядок.
