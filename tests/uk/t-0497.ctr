Server init.

# записати тестовий файл
>> f := Файл новий: ['/tmp/test.gif'].
f написати: ['GIF87a01234567810'].

# віддати файл
Server передати: ['test.gif'] префікс: ['/tmp/'].

Вивід новий-рядок.

Вивід написати: ['Поза контейнером (безпека):'], новий-рядок.
{ Server передати: ['../passwd'] префікс: ['/tmp/']. }
перехопити: { :e Вивід написати: e, новий-рядок. },
запустити.

Вивід написати: ['Недійсний префікс:'], новий-рядок.
{ Server передати: ['test.gif'] префікс: ['z:\\']. }
перехопити: { :e Вивід написати: e, новий-рядок. },
запустити.

Вивід написати: ['Неіснуючий файл:'], новий-рядок.
{ Server передати: ['xxx.xxx'] префікс: ['/tmp/']. }
перехопити: { :e Вивід написати: e, новий-рядок. },
запустити.
