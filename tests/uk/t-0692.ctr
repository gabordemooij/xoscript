Server init.

Вивід написати: (
	Шаблон новий: ['^\\w+$'],
	збіг: ['test@example.com'] 
), новий-рядок. # 0 match, fails on @ and .

Вивід написати: (
	Шаблон новий: ['^[^@]+@[^\.]+\.\\w+$'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match

Вивід написати: (
	Шаблон новий: ['[^@]+@[^\.]+\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match

Вивід написати: (
	Шаблон новий: ['([^@]+)@([^\.]+)\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match, groups dont matter

Вивід написати: (
	Шаблон новий: ['[a-z]'],
	збіг: ['test@example.com'] 
), новий-рядок. # 14 matches

Вивід написати: (
	Шаблон новий: ['.*'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match (all)

Вивід написати: (
	Шаблон новий: ['(.*)'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match (all)

Вивід написати: (
	Шаблон новий: ['\\s*[^@]+@[^\.]+\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 match, prefix space optional, gets ignored