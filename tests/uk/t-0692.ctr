Server init.

Вивід написати: (
	Шаблон новий: ['^\\w+$'],
	збіг: ['test@example.com'] 
), новий-рядок. # 0 збігів, не проходить на @ і .

Вивід написати: (
	Шаблон новий: ['^[^@]+@[^\.]+\.\\w+$'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг

Вивід написати: (
	Шаблон новий: ['[^@]+@[^\.]+\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг

Вивід написати: (
	Шаблон новий: ['([^@]+)@([^\.]+)\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг, групи не мають значення

Вивід написати: (
	Шаблон новий: ['[a-z]'],
	збіг: ['test@example.com'] 
), новий-рядок. # 14 збігів

Вивід написати: (
	Шаблон новий: ['.*'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг (усе)

Вивід написати: (
	Шаблон новий: ['(.*)'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг (усе)

Вивід написати: (
	Шаблон новий: ['\\s*[^@]+@[^\.]+\.\\w+'],
	збіг: ['test@example.com'] 
), новий-рядок. # 1 збіг, пробіл-префікс необовʼязковий, ігнорується