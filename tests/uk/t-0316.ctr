>> Дідусь := Обʼєкт новий.
Дідусь при: ['привітати'] виконати: {
	Вивід написати: ['Ave!'], новий-рядок.
}.
>> Батько := Дідусь новий.
Батько при: ['привітати'] виконати: {
	Вивід написати: ['Hello'], новий-рядок.
	сам привітати.
}.
>> Син := Батько новий.
Син при: ['привітати'] виконати: {
	Вивід написати: ['Вітаю'], новий-рядок.
	сам привітати.
}.

Син привітати.

>> Кільце := Обʼєкт новий.
Кільце при: ['circle:'] виконати: { :x
	Вивід написати: x, новий-рядок.
	(x < 3) істина: { сам рекурсивний circle: x + 1. }.
}.

Кільце circle: 1.

>> x := 1.
>> збільшити := { (x ≤ 3) істина: { Вивід написати: x, новий-рядок. x додати: 1.  збільшити запустити. }. }.
збільшити запустити.