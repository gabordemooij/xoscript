>> Grandfather := Обʼєкт новий.
Grandfather при: ['greet'] виконати: {
	Вивід написати: ['Ave!'], новий-рядок.
}.
>> Father := Grandfather новий.
Father при: ['greet'] виконати: {
	Вивід написати: ['Hello'], новий-рядок.
	сам greet.
}.
>> Son := Father новий.
Son при: ['greet'] виконати: {
	Вивід написати: ['Hi'], новий-рядок.
	сам greet.
}.

Son greet.

>> Roundabout := Обʼєкт новий.
Roundabout при: ['circle:'] виконати: { :x
	Вивід написати: x, новий-рядок.
	(x < 3) істина: { сам рекурсивний circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) істина: { Вивід написати: x, новий-рядок. x додати: 1.  increment запустити. }. }.
increment запустити.