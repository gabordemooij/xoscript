

>> g  := Server новий.
>> v  := Сховище новий.
>> ок := 0.

>> секрети := Список новий ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> паролі := секрети копіювати.
паролі кожен: { :i :p
	секрети кожен: { :n :s
		{
			>> зашифроване := v шифрувати: s ключ: p.
			>> розшифроване := v розшифрувати: зашифроване ключ: p.
			(розшифроване = s) істина: {
				ок додати: 1.
			}, інакше: {
				Вивід написати: ['не вдалося зашифрувати/розшифрувати: '], новий-рядок.
				Вивід написати: s, новий-рядок.
				Вивід написати: ['зашифровано: '] + зашифроване, новий-рядок.
				Вивід написати: ['розшифровано: '] + зашифроване, новий-рядок.
				Програма кінець.
			}.
		} перехопити: { :пом
			(s = [''] або: p = ['']) істина: {
				ок додати: 1.
			}, інакше: {
				Вивід написати: пом, новий-рядок.
				Програма кінець.
			}.
		}, запустити.
	}.
}.

Вивід написати: ( ок + [' шифрувань сейфа перевірено.'] ), новий-рядок.