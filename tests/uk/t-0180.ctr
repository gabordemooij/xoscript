Текст при: ['html'] виконати: { <- (
		сам
		замінити: ['&'] на: ['&amp;'],
		замінити: ['<'] на: ['&lt;'],
		замінити: ['>'] на: ['&gt;'],
		замінити: ['''] на: ['&apos;'],
		замінити: ['"'] на: ['&quot;']
	).
}.

>> використана-памʼять1 := 0.
