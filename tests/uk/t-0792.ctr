Server init.

>> БД := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
	
>> SQL := ['SELECT "hello" AS "world" '].

# швидший спосіб: отримати запит із БД:
