Server init.

>> DB := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB запит: SQL.

# now you don't have to set DB
query2 отримати: { :row
	Вивід написати: row world, новий-рядок.
}.
