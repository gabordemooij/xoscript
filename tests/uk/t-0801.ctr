Server init.

>> db := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> del := db запит: ['DELETE FROM book WHERE id > 0'].
{  del виконати. db підтвердити. } перехопити: { :e db відкотити.  }, запустити.

>> кількість := db запит: ['SELECT COUNT(*) AS num FROM book'].
кількість отримати: { :row Вивід написати: row num, новий-рядок. }.
