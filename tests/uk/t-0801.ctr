Server init.

>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> вид := бд запит: ['DELETE FROM book WHERE id > 0'].
{  вид виконати. бд підтвердити. } перехопити: { :e бд відкотити.  }, запустити.

>> кількість := бд запит: ['SELECT COUNT(*) AS num FROM book'].
кількість отримати: { :ряд Вивід написати: ряд num, новий-рядок. }.
