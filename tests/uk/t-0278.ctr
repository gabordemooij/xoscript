>> Справи := Обʼєкт новий.

Справи при: ['новий'] виконати: {
	свій list := Список новий.
}.

Справи при: ['nieuw'] виконати: {
	свій list := Список новий.
}.

Справи при: ['+'] виконати: { :справа
	свій list додати-в-кінець: справа.
}.

Справи при: ['number of tasks?'] виконати: { <-  свій list кількість.
}.

>> список-справ := 
	Справи новий 
	+ ['приготувати вечерю'] 
	+ ['прибрати кімнату'].
	
Вивід написати: ['You have $ tasks to do'] $ список-справ number of tasks?.
