>> To-Do := Обʼєкт новий.

To-Do при: ['новий'] виконати: {
	свій list := Список новий.
}.

To-Do при: ['nieuw'] виконати: {
	свій list := Список новий.
}.

To-Do при: ['+'] виконати: { :task
	свій list додати-в-кінець: task.
}.

To-Do при: ['number of tasks?'] виконати: { <-  свій list кількість.
}.

>> todos := 
	To-Do новий 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Вивід написати: ['You have $ tasks to do'] $ todos number of tasks?.
