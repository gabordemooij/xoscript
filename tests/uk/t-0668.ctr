# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob новий: 8, bytes: (
	Список новий ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Вивід написати: ( utf16 декодувати: ['utf16le'] ), новий-рядок.

utf16 звільнити.
>> utf32 := Blob новий: 13, bytes: (
	Список новий ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Вивід написати: ( utf32 декодувати: ['utf32be'] ), новий-рядок.
utf32 звільнити.