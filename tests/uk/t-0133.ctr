


>> Deck := Список новий.
Deck при: ['print'] виконати: {
        >> len := сам кількість - 1.
        { :i
                >> len2 := сам кількість - 1.
                Вивід написати: ['len: '].
                Вивід написати: len, новий-рядок.
                Вивід написати: ['len2: '].
                Вивід написати: len2, новий-рядок.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
