


>> Колода := Список новий.
Колода при: ['друкувати'] виконати: {
        >> len := сам кількість - 1.
        { :i
                >> довж2 := сам кількість - 1.
                Вивід написати: ['довж: '].
                Вивід написати: len, новий-рядок.
                Вивід написати: ['довж2: '].
                Вивід написати: довж2, новий-рядок.
        } × len.
}.

>> d := Колода ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d друкувати.
