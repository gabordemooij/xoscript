Вивід написати: ['Continue for-loop, No - before 6 and up.'], новий-рядок.
{ :i
	Вивід написати: (i + 1), новий-рядок.
	((i + 1) > 4) продовжувати.
	Вивід написати: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Вивід новий-рядок.
Вивід написати: ['Continue while-true, No --> before 5 and up.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x додати: 1.
	((x < 5) не) продовжувати.
	Вивід написати: ['-->'].
} поки: xIsLessThan10.
Вивід новий-рядок.
Вивід написати: ['Continue while-false, No - before 3 only.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x відняти: 1.
	(x = 3) продовжувати.
	Вивід написати: ['-'].
} поки: { <- ( x > 0). }.

Вивід новий-рядок.
Вивід написати: ['Continue times-loop, No ||| before 3.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 2) продовжувати.
	Вивід написати: ['|||'].
} × 5.

Вивід новий-рядок.

{ Істина продовжувати. Вивід написати: ['dont write this!'], новий-рядок. } запустити.

{ Істина продовжувати. Вивід написати: ['dont write this!'], новий-рядок. } перехопити: { Вивід написати: ['Dont catch this!']. }, запустити.

Вивід написати: ['Test Array each-loop: 0, ... ,2'], новий-рядок.
(Список ← 1 ; 2 ; 3) перетворити: { :i
	(i = 1) продовжувати.
	Вивід написати: ['iteration #'] + (i - 0), новий-рядок.
}.

Вивід написати: ['Test Map each-loop: c only'], новий-рядок.
>> m := Словник новий.
m поставити: ['first'] у: ['a'], поставити: ['second'] у: ['b'], поставити: ['third'] у: ['c'].
m кожен: { :k :v
	(k ≠ ['c']) продовжувати.
	Вивід написати: ['iteration'] + k + v, новий-рядок.
}.

