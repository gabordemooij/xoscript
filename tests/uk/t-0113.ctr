Вивід написати: ['Продовжити цикл for, Ні - до 6 і вище.'], новий-рядок.
{ :i
	Вивід написати: (i + 1), новий-рядок.
	((i + 1) > 4) продовжувати.
	Вивід написати: ['-'].
} × 10.

>> x := 0.
>> x-менше-за-10 := { <- ( x < 10 ). }.
Вивід новий-рядок.
Вивід написати: ['Продовжити while-true, Ні --> до 5 і вище.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x додати: 1.
	((x < 5) не) продовжувати.
	Вивід написати: ['-->'].
} поки: x-менше-за-10.
Вивід новий-рядок.
Вивід написати: ['Продовжити while-false, Ні - лише до 3.'], новий-рядок.
{
	Вивід написати: ['iteration #'] + x, новий-рядок.
	x відняти: 1.
	(x = 3) продовжувати.
	Вивід написати: ['-'].
} поки: { <- ( x > 0). }.

Вивід новий-рядок.
Вивід написати: ['Продовжити цикл times, Ні ||| до 3.'], новий-рядок.
{ :i
	Вивід написати: ['iteration #'] + i, новий-рядок.
	(i = 2) продовжувати.
	Вивід написати: ['|||'].
} × 5.

Вивід новий-рядок.

{ Істина продовжувати. Вивід написати: ['не пиши це!'], новий-рядок. } запустити.

{ Істина продовжувати. Вивід написати: ['не пиши це!'], новий-рядок. } перехопити: { Вивід написати: ['Не перехоплюй це!']. }, запустити.

Вивід написати: ['Тест циклу each по масиву: 0, ... ,2'], новий-рядок.
(Список ← 1 ; 2 ; 3) перетворити: { :i
	(i = 1) продовжувати.
	Вивід написати: ['iteration #'] + (i - 0), новий-рядок.
}.

Вивід написати: ['Тест циклу each по мапі: лише c'], новий-рядок.
>> m := Словник новий.
m поставити: ['first'] у: ['a'], поставити: ['second'] у: ['b'], поставити: ['третій'] у: ['c'].
m кожен: { :k :v
	(k ≠ ['c']) продовжувати.
	Вивід написати: ['iteration'] + k + v, новий-рядок.
}.

