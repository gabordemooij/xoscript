#Linux

(Файл новий: ['/tmp/testje']) існує хиба: {
	Програма система: ['mkdir /tmp/testje'].	
}.

(Файл новий: ['/tmp/testje/file1']) існує хиба: {
	Програма система: ['touch /tmp/testje/file1'].	
}.

(Файл новий: ['/tmp/testje/folder1']) існує хиба: {
	Програма система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл список: ['/tmp/testje'].

>> q := Список новий.

l кожен: { :k :v v кожен: { :x :y q додати-в-кінець: y. }. }.

>> s := q текст.

(s містить: ['file1']) істина:   { Вивід написати: ['OK'], новий-рядок. }.
(s містить: ['file2']) істина:   { Вивід написати: ['XX'], новий-рядок. }.
(s містить: ['folder1']) істина: { Вивід написати: ['OK'], новий-рядок. }.
