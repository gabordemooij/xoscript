#Linux
>> OS := Програма налаштування: ['OS'].

>> годинник := Момент новий.
	
(OS = ['Haiku']) істина: {
	годинник зона: ['CET'],
	рік: 2017, місяць: 7, день: 13,
	година: 18, хвилина: 0, секунда: 0.
}, інакше: {
	годинник зона: ['Europe/Amsterdam'],
	рік: 2017, місяць: 7, день: 13,
	година: 18, хвилина: 0, секунда: 0.
}.

годинник при: ['розповісти'] виконати: {
	Вивід написати: сам, новий-рядок.
}.


годинник додати: 2    година, розповісти.
годинник додати: 1    година, розповісти.
годинник додати: 19 хвилина, розповісти.
годинник додати: 1  хвилина, розповісти.
годинник додати: 1  хвилина, розповісти.
годинник додати: 19 секунда, розповісти.
годинник додати: 1  секунда, розповісти.
годинник додати: 1  секунда, розповісти.
годинник додати: 2    рік, розповісти.
годинник додати: 1    рік, розповісти.

(OS = ['Haiku']) істина: {
годинник додати: 5   місяць.
годинник зона: ['CEST'], розповісти.
}, інакше: {
	годинник додати: 5   місяць, розповісти.
}.

годинник додати: 1   місяць, розповісти.
годинник додати: 19    день, розповісти.
годинник додати: 1    година, розповісти.
годинник додати: 120  ярд, розповісти.
