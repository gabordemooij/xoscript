#Linux
>> OS := Програма налаштування: ['OS'].

>> clock := Момент новий.
	
(OS = ['Haiku']) істина: {
	clock зона: ['CET'],
	рік: 2017, місяць: 7, день: 13,
	година: 18, хвилина: 0, секунда: 0.
}, інакше: {
	clock зона: ['Europe/Amsterdam'],
	рік: 2017, місяць: 7, день: 13,
	година: 18, хвилина: 0, секунда: 0.
}.

clock при: ['tell'] виконати: {
	Вивід написати: сам, новий-рядок.
}.


clock додати: 2    година, tell.
clock додати: 1    година, tell.
clock додати: 19 хвилина, tell.
clock додати: 1  хвилина, tell.
clock додати: 1  хвилина, tell.
clock додати: 19 секунда, tell.
clock додати: 1  секунда, tell.
clock додати: 1  секунда, tell.
clock додати: 2    рік, tell.
clock додати: 1    рік, tell.

(OS = ['Haiku']) істина: {
clock додати: 5   місяць.
clock зона: ['CEST'], tell.
}, інакше: {
	clock додати: 5   місяць, tell.
}.

clock додати: 1   місяць, tell.
clock додати: 19    день, tell.
clock додати: 1    година, tell.
clock додати: 120  yard, tell.
