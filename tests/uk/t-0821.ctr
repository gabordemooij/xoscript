# лапка, що ніколи не закривається, має давати помилку, а не нескінченний цикл
>> шлях := ['/tmp/test0821.csv'].
>> file := Файл новий: шлях.

file написати: ['a,b\n"1,2\n'].
{
	file роздільник: [','] лапки: ['"'] рядки: { :line
		Вивід написати: line, новий-рядок.
	}.
} перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.

# закрита лапка й далі працює
file написати: ['a,b\n"1,2",3'].
file роздільник: [','] лапки: ['"'] рядки: { :line
	Вивід написати: line, новий-рядок.
}.
file видалити.
