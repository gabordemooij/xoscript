Програма керування-памʼяттю: 0.
Список при: ['sum'] виконати: {
	>> total := 0.
	сам кожен: { :index :element
		total додати: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл новий: ['/tmp/test.txt'].
f написати: ['Lorem Ipsum'].
f закрити.
  

f := Файл новий: ['/tmp/test.txt'].
>> text := f читати.
f закрити.



Програма прибрати.
usedMemory1 := (Програма памʼять ? 1).



f := Файл новий: ['/tmp/test.txt'].
text := f читати.
f закрити.

Програма прибрати.
usedMemory2 := (Програма памʼять ? 1).


f := Файл новий: ['/tmp/test.txt'].
text := f читати.
f закрити.

Програма прибрати.
usedMemory3 := (Програма памʼять ? 1).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) істина: {
	Вивід написати: ['No memory leaks here'].
}, хиба: {
	Вивід написати: ['Leaking memory...'].
}.
