Програма керування-памʼяттю: 0.
Список при: ['сума'] виконати: {
	>> разом := 0.
	сам кожен: { :індекс :елемент
		разом додати: елемент.
	}. <- разом.
}.

>> використана-памʼять1 := 0.
>> використана-памʼять2 := 0.
>> використана-памʼять3 := 0.
>> використана-памʼять4 := 0.



>> f := Файл новий: ['/tmp/test.txt'].
f написати: ['Lorem Ipsum'].
f закрити.
  

f := Файл новий: ['/tmp/test.txt'].
>> напис := f читати.
f закрити.



Програма прибрати.
використана-памʼять1 := (Програма памʼять ? 1).



f := Файл новий: ['/tmp/test.txt'].
напис := f читати.
f закрити.

Програма прибрати.
використана-памʼять2 := (Програма памʼять ? 1).


f := Файл новий: ['/tmp/test.txt'].
напис := f читати.
f закрити.

Програма прибрати.
використана-памʼять3 := (Програма памʼять ? 1).



( використана-памʼять1 = використана-памʼять2 і: використана-памʼять1 = використана-памʼять3, і: використана-памʼять2 = використана-памʼять3 ) істина: {
	Вивід написати: ['Тут немає витоків памʼяті'].
}, хиба: {
	Вивід написати: ['Витік памʼяті...'].
}.
