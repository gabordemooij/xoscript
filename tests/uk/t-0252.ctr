#Linux
>> clock := Момент новий.
clock зона: ['UTC-1'].
clock рік: 1981, місяць: 1, день: 5,
      година: 13, хвилина: 15, секунда: 13.

Вивід написати: clock, новий-рядок.
clock зона: ['UTC+0'].

Вивід написати: (
	(clock рік простий) + ['-'] + (clock місяць) + ['-'] + (clock день) + [' '] +
	(clock година) + [':'] + (clock хвилина) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock тиждень) + (clock зона)
), новий-рядок.


clock зона: ['UTC-1'].
Вивід написати: (
	(clock рік простий) + ['-'] + (clock місяць) + ['-'] + (clock день) + [' '] +
	(clock година) + [':'] + (clock хвилина) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock тиждень) + (clock зона)
), новий-рядок.
