#Linux
>> годинник := Момент новий.
годинник зона: ['UTC-1'].
годинник рік: 1981, місяць: 1, день: 5,
      година: 13, хвилина: 15, секунда: 13.

Вивід написати: годинник, новий-рядок.
годинник зона: ['UTC+0'].

Вивід написати: (
	(годинник рік простий) + ['-'] + (годинник місяць) + ['-'] + (годинник день) + [' '] +
	(годинник година) + [':'] + (годинник хвилина) + [':'] + (годинник секунда) + [' '] +
	['W'] + (годинник тиждень) + (годинник зона)
), новий-рядок.


годинник зона: ['UTC-1'].
Вивід написати: (
	(годинник рік простий) + ['-'] + (годинник місяць) + ['-'] + (годинник день) + [' '] +
	(годинник година) + [':'] + (годинник хвилина) + [':'] + (годинник секунда) + [' '] +
	['W'] + (годинник тиждень) + (годинник зона)
), новий-рядок.
