

Список при: ['sum'] виконати: {
	>> total := 0.
	сам кожен: { :index :element
		total додати: element.
	}. <- total.
}.

Список при: ['product'] виконати: {
	>> total := 1.
	сам кожен: { :index :element
		total помножити-на: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма керування-памʼяттю: 0.

{

>> a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666.
a := a + ( Список ← 1 ).
Вивід написати: ( ['sum: '] + ( a sum ) ), новий-рядок.
Вивід написати: ( ['min: '] + ( a мінімум ) ), новий-рядок.
Вивід написати: ( ['max: '] + ( a максимум ) ), новий-рядок.
Вивід написати: ( ['3rd: '] + ( a ? 2 ) ), новий-рядок.
Вивід написати: ( ['prd: '] + ( a product ) ), новий-рядок.
a сортувати: { :a :b <- (b - a). }.
a кожен: { :i :e Вивід написати: ( i - 0 ), новий-рядок. }.

} запустити.

Програма прибрати.
usedMemory1 := (Програма памʼять ? 0).


