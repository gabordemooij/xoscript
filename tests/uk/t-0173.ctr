

Список при: ['сума'] виконати: {
	>> разом := 0.
	сам кожен: { :індекс :елемент
		разом додати: елемент.
	}. <- разом.
}.

Список при: ['добуток'] виконати: {
	>> разом := 1.
	сам кожен: { :індекс :елемент
		разом помножити-на: елемент.
	}. <- разом.
}.

>> використана-памʼять1 := 0.
>> використана-памʼять2 := 0.
>> використана-памʼять3 := 0.
>> використана-памʼять4 := 0.

Програма керування-памʼяттю: 0.

{

>> a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666.
a := a + ( Список ← 1 ).
Вивід написати: ( ['сума: '] + ( a сума ) ), новий-рядок.
Вивід написати: ( ['мін: '] + ( a мінімум ) ), новий-рядок.
Вивід написати: ( ['макс: '] + ( a максимум ) ), новий-рядок.
Вивід написати: ( ['3-й: '] + ( a ? 2 ) ), новий-рядок.
Вивід написати: ( ['добуток: '] + ( a добуток ) ), новий-рядок.
a сортувати: { :a :b <- (b - a). }.
a кожен: { :i :e Вивід написати: ( i - 0 ), новий-рядок. }.

} запустити.

Програма прибрати.
використана-памʼять1 := (Програма памʼять ? 0).


{

