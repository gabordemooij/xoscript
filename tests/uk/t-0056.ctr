>> z := Обʼєкт новий.
z при: ['value:'] виконати: { :v
	свій value := v. <- сам.
}.
z при: ['value'] виконати: { <- свій value. }.
(z setValue: 1) value: 2.
Вивід написати: z value.
>> x := z.
Вивід написати: x value.
z := Ніщо.
Вивід написати: z value.
Вивід написати: x value.
Вивід написати: ['hello'].
Вивід написати: 3 + 2.
Вивід написати: (3 > 2).
