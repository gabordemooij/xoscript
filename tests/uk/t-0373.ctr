# compliance test

# use international numbers

Вивід написати: ['1000 -> '].
Вивід написати: 1000, новий-рядок. #1000

Вивід написати: ['1.5 -> '].
Вивід написати: 1.5, новий-рядок.  #1.5

Вивід написати: ['1001.5 -> '].
Вивід написати: 1.5 + 1000, новий-рядок. #1001.5

# use 0-indexed arrays
>> x := Список новий ; 1 ; 2 ; 3.
>> y := Список новий ; ['a'] ; ['b'] ; ['c'].

Вивід написати: ['1 -> '].
Вивід написати: x ? 0, новий-рядок. #1

Вивід написати: ['1 -> '].
Вивід написати: (x на: 0), новий-рядок. #1

Вивід написати: ['1 -> '].
Вивід написати: x перший, новий-рядок. #1

Вивід написати: ['3 -> '].
Вивід написати: x останній, новий-рядок. #3

Вивід написати: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Вивід написати: (x за: y), новий-рядок.

Вивід написати: ['1 -> '].
Вивід написати: (x від: 0 довжина: 1) перший, новий-рядок. #1

Вивід написати: ['0 -> '].
Вивід написати: (x знайти: 1), новий-рядок. #0

x поставити: 9 у: 0.

Вивід написати: ['9 -> '].
Вивід написати: (x на: 0), новий-рядок. #9

x додати-на-початок: 8.
Вивід написати: ['8 -> '].
Вивід написати: (x на: 0), новий-рядок. #9


x додати-в-кінець: 10.
Вивід написати: ['10 -> '].
Вивід написати: (x на: 4), новий-рядок. #10








