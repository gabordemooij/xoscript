Вивід написати: ['Тестовий обʼєкт'], новий-рядок.
>> a := Обʼєкт новий. 

a при: ['item:'] виконати: { :вив
	свій вив := вив. 
}.

a при: ['предмет'] виконати: {
	<- свій вив.
}.

a при: ['привітати'] виконати: {
	Вивід написати: ['привіт від початкового виводу!'], новий-рядок.
}.

a item: Вивід.

Вивід написати: a предмет, новий-рядок.

>> стара-адреса-вив := a предмет прототип адреса-памʼяті.
a save-as: ['/tmp/a.bin'].
Вивід написати: ['========== ПЕРЕЗАВАНТАЖЕННЯ SNAP:'], новий-рядок.

>> b := Обʼєкт load-from: ['/tmp/a.bin'].

(b предмет прототип адреса-памʼяті = стара-адреса-вив) істина: {
	Вивід написати: ['Посилання на обʼєкт знову приєднано.'], новий-рядок.
}.

b предмет написати: ['вітаю від завантаженого виводу!'], новий-рядок.
b привітати.
