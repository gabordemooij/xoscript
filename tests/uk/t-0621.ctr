>> фрази := Список новий
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> повідомлення := ['Phrase: ~decoded base64: ~encoded'].
	
фрази кожен: { :_ :фраза 
	>> e := Server base64-кодувати: фраза.
	>> d := Server base64-декодувати: e.
	Вивід написати: (
		повідомлення копіювати ~encoded: e, ~decoded: d
	), новий-рядок.
}.
