>> phrases := Список новий
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases кожен: { :_ :phrase 
	>> e := Server base64-кодувати: phrase.
	>> d := Server base64-декодувати: e.
	Вивід написати: (
		message копіювати ~encoded: e, ~decoded: d
	), новий-рядок.
}.
