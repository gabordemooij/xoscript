

Текст при: ['html'] виконати: { <- (
		сам
		замінити: ['&'] на: ['&amp;'],
		замінити: ['<'] на: ['&lt;'],
		замінити: ['>'] на: ['&gt;'],
		замінити: ['"'] на: ['&quot;']
	).
}.


Вивід написати: ([' left trimmed '] обрізати) + [' '] + ( ['and right trimmed'] обрізати) + ['!'], новий-рядок.
Вивід написати: ['<html>"html & entities"</html>'] html.
