['Тисячі та десяткові'].

>> x := 100000000.5.
>> y := 100000000.5.

Вивід написати: (x + y), новий-рядок.

>> x := 10040.07.
>> y := 10305.60.

Вивід написати: (x + y), новий-рядок.

['Десяткове'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Вивід написати: (x + y + z), новий-рядок.

['Дивно, але коректно'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Вивід написати: (x + y + z), новий-рядок.

>> q := 0.1.2.

Вивід написати: (q), новий-рядок.

>> q := 012.

Вивід написати: (q), новий-рядок.
