
>> Вітальник := Обʼєкт новий.
Вітальник при: ['новий'] виконати: {
	свій імʼя := ['?'].
}.
Вітальник при: ['name:'] виконати: { :імʼя
	свій імʼя := імʼя.
}.
Вітальник при: ['привітати'] виконати: {
	Вивід написати: (['hello[you]'] [you]: свій імʼя).
}.
>> друг := Вітальник новий.
друг name: ['1'].
друг привітати.
