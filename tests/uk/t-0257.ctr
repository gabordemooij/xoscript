
>> Greeter := Обʼєкт новий.
Greeter при: ['новий'] виконати: {
	свій імʼя := ['?'].
}.
Greeter при: ['name:'] виконати: { :імʼя
	свій імʼя := імʼя.
}.
Greeter при: ['greet'] виконати: {
	Вивід написати: (['hello[you]'] [you]: свій імʼя).
}.
>> friend := Greeter новий.
friend name: ['1'].
friend greet.
