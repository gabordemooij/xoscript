

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма керування-памʼяттю: 0.

>> a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666.
a робити вилучити-останній вилучити-перший додати-на-початок: ['hi'], додати-в-кінець: 999, зроблено.
Вивід написати: ( a зʼєднати: [','] ), новий-рядок.

Програма прибрати.
usedMemory1 := (Програма памʼять ? 0).


a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666.
a вилучити-останній. a вилучити-перший. a додати-на-початок: ['hi'], додати-в-кінець: 999.
Вивід написати: ( a зʼєднати: [','] ), новий-рядок.


Програма прибрати.
usedMemory2 := (Програма памʼять ? 0).


a := Список ← ['hello'] ; ['world'] ; Істина ; Ніщо ; 666.
a робити вилучити-останній вилучити-перший додати-на-початок: ['hi'], додати-в-кінець: 999, зроблено.
Вивід написати: ( a зʼєднати: [','] ), новий-рядок.


Програма прибрати.
usedMemory3 := (Програма памʼять ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) істина: {
