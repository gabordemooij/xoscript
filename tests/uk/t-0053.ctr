60 × {
	>> x := (Число random % 6) + 1.
	(x ≤ 6) хиба: { Вивід написати: ['FAIL']. }.
	(x ≥0) хиба: { Вивід написати: ['FAIL']. }.
	x := (Число random % 3) + 1.
	(x < 3) хиба: { Вивід написати: ['FAIL']. }.
	(x>-1) хиба: { Вивід написати: ['FAIL']. }.
	x := ((Логічний flip) число).
	(x = 0 або: x = 1) хиба: { Вивід написати: ['FAIL']. }.
	x := ((Істина flip) число).
	(x = 0 або: x = 1) хиба: { Вивід написати: ['FAIL']. }.
	x := (Логічний flip або: ['HEAD'] або: ['TAIL']).
	((x = ['HEAD']) або: (x = ['TAIL'])) хиба: { Вивід написати: ['FAIL']. }.
}.
Вивід написати: ['DONE'].

