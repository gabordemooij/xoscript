60 × {
	>> x := (Число random % 6) + 1.
	(x ≤ 6) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	(x ≥0) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	x := (Число random % 3) + 1.
	(x < 3) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	(x>-1) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	x := ((Логічний flip) число).
	(x = 0 або: x = 1) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	x := ((Істина flip) число).
	(x = 0 або: x = 1) хиба: { Вивід написати: ['ПРОВАЛ']. }.
	x := (Логічний flip або: ['ОРЕЛ'] або: ['РЕШКА']).
	((x = ['ОРЕЛ']) або: (x = ['РЕШКА'])) хиба: { Вивід написати: ['ПРОВАЛ']. }.
}.
Вивід написати: ['ГОТОВО'].

