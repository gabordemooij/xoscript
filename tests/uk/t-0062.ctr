Логічний при: ['xor:'] виконати: { :a :b <- ((a і: b не) або: (a не і: b)).
}.

>> o := Обʼєкт новий.
o при: ['hello'] виконати: { ['Empty']. }.
{ o при: 2 виконати: 3.} перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
{ o при: ['тест'] виконати: 3.} перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.
{ o при: ['hello'] виконати: { ['Empty']. }.} перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ >> z := 4 ÷ 0. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ (Істина і: Ніщо) істина: { Вивід написати: ['X'].}. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ ([''] xor: 0) істина: { Вивід написати: ['X'].}. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ (1 < ['2']) істина: { Вивід написати: ['OK']. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ (1 < ['2.0']) істина: { Вивід написати: ['OK']. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ (1 < ['x2.0']) істина: { Вивід написати: ['NO!']. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити. 
{ Вивід написати: (['hello OK there'] від: ['6'] довжина: ['2']). } запустити. 
