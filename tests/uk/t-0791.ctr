Server init.

>> DB := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметри-пошуку := Maria-Запит новий: SQL.

# set database
параметри-пошуку база-даних: DB.

параметри-пошуку отримати: { :row
	Вивід написати: row world, новий-рядок.
}.
