Server init.

>> БД := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.
	
>> SQL := ['SELECT "hello" AS "world" '].

# створити запит вручну
>> параметри-пошуку := Maria-Запит новий: SQL.

# задати базу даних
параметри-пошуку база-даних: БД.

параметри-пошуку отримати: { :ряд
	Вивід написати: ряд world, новий-рядок.
}.
