Вивід написати: ['Тестовий обʼєкт'], новий-рядок.
>> a := Обʼєкт новий. 

a при: ['state:'] виконати: { :list
	свій list := list. 
}.

a при: ['стан'] виконати: {
	Вивід написати: свій list, новий-рядок.
}.

a state: ( Список новий ; ['елемент-списку'] ; ['елемент2'] ).
a стан.

a save-as: ['/tmp/a.bin'].
Вивід написати: ['========== ПЕРЕЗАВАНТАЖЕННЯ SNAP:'], новий-рядок.
>> b := Обʼєкт load-from: ['/tmp/a.bin'].
b стан.