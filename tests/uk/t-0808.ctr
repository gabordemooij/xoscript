# ключі та підписи сховища, що декодуються задовгими, не мають переповнювати стек
Server init.

>> ключі := Сховище згенерувати-ключі.
>> тк := ключі перший.
>> вк := ключі останній.
>> підп := Сховище підписати: ['abc'] ключем: тк.

# 88 символів без доповнення декодуються в 66 байтів
>> довгий := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 символи без доповнення декодуються в 33 байти
>> короткий := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Сховище підписати: ['abc'] ключем: довгий. } перехопити: { :e
	Вивід написати: e, новий-рядок.
}, запустити.

{ Сховище перевірити: ['abc'] підпис: довгий ключем: вк. } перехопити: { :e
	Вивід написати: e, новий-рядок.
}, запустити.

{ Сховище перевірити: ['abc'] підпис: підп ключем: короткий. } перехопити: { :e
	Вивід написати: e, новий-рядок.
}, запустити.
