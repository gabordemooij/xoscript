# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> параметри-пошуку := db запит: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-пошуку параметри: (Список новий ; ['1']).
{ параметри-пошуку отримати: { :row Вивід написати: row, новий-рядок. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.

>> параметри-пошуку := db запит: ['SELECT ? AS a'].
{ параметри-пошуку отримати: { :row Вивід написати: row, новий-рядок. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.

# the right number still works, more parameters are ignored as before
>> параметри-пошуку := db запит: ['SELECT ? AS a, ? AS b'].
параметри-пошуку параметри: (Список новий ; ['1'] ; ['2']).
параметри-пошуку отримати: { :row Вивід написати: (row на: ['a']), написати: (row на: ['b']), новий-рядок. }.
параметри-пошуку параметри: (Список новий ; ['1'] ; ['2'] ; ['3']).
параметри-пошуку отримати: { :row Вивід написати: (row на: ['a']), написати: (row на: ['b']), новий-рядок. }.
