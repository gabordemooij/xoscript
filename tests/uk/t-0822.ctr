# менше параметрів, ніж заповнювачів, має давати помилку, а не читати за межами привʼязок
Server init.

>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'],
	пароль: ['pass123'],
	назва-бази: ['xobase'],
	підключити.

>> параметри-пошуку := бд запит: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-пошуку параметри: (Список новий ; ['1']).
{ параметри-пошуку отримати: { :ряд Вивід написати: ряд, новий-рядок. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.

>> параметри-пошуку := бд запит: ['SELECT ? AS a'].
{ параметри-пошуку отримати: { :ряд Вивід написати: ряд, новий-рядок. }. } перехопити: { :e Вивід написати: e, новий-рядок. }, запустити.

# правильна кількість і далі працює, зайві параметри ігноруються, як і раніше
>> параметри-пошуку := бд запит: ['SELECT ? AS a, ? AS b'].
параметри-пошуку параметри: (Список новий ; ['1'] ; ['2']).
параметри-пошуку отримати: { :ряд Вивід написати: (ряд на: ['a']), написати: (ряд на: ['b']), новий-рядок. }.
параметри-пошуку параметри: (Список новий ; ['1'] ; ['2'] ; ['3']).
параметри-пошуку отримати: { :ряд Вивід написати: (ряд на: ['a']), написати: (ряд на: ['b']), новий-рядок. }.
