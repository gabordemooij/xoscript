# test number -> string -> number
{

	>> x := Skaičius tarp: 0 ir: 1000000.
	>> d := Skaičius tarp: 1 ir: 7.
	>> e := 10 kelti-laipsniu: d.

	x padalinti-iš: e.
	>> y := x tekstas skaičius.

	(x = y) netiesa: {
		Išvestis rašyti: x, nauja-eilutė.
		Išvestis rašyti: y, nauja-eilutė.
		Programa baigti.
	}.

} * 1000.
Išvestis rašyti: ['OK'], nauja-eilutė.