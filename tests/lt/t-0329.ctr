Išvestis rašyti: ((Sąrašas naujas
	kai: ['plaque:'] daryti: { :x savas o := x. },
	kai: ['plaque']  daryti: { <- savas o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Sąrašas ← 1)
	~ (Sąrašas ← 1 ; 2)
	~ (Sąrašas ← 1 ; 2 ; 3)
	~ (Sąrašas ← 1 ; 2 ; 3 ; 4)
	~ (Sąrašas ← 1 ; 2 ; 3 ; 4 ; 5)
) kiekvienas: { :i :el
	{ Išvestis rašyti: ši-užduotis. } × el kiekis.
	Išvestis nauja-eilutė.
}) plaque, nauja-eilutė.


