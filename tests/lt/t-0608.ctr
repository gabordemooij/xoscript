
>> Size := Objektas naujas.
Size kai: ['is:'] daryti: { :skaičius
	skaičius kai: ['+'] daryti: { :skaičius
		>> unit := skaičius apibūdinimas.
		>> factor := 1.
		
		unit
		atvejis: ['inch'] daryti: { factor := 0.0833. }. <- pats + (skaičius * factor).
	}. <- skaičius.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Išvestis rašyti: plank + edge, nauja-eilutė.
