# Test utf8 sanitizer
Server init.

>> utf8cases := Žodynas naujas
	# ASCII only
	įdėti: ( Sąrašas naujas ; 65 ; 65 ; 65 ; 65 ; 0 ) į: ['AAAA'],
	# valid 2 byte sequence
	įdėti: ( Sąrašas naujas ; 194 ; 162 ; 0 ) į: ['¢'],
	# Valid 3-byte UTF-8
    įdėti: ( Sąrašas naujas ; 226 ; 130 ; 172 ; 0 ) į: ['€'],
	# Valid 4-byte UTF-8
    įdėti: ( Sąrašas naujas ; 240 ; 144 ; 141 ; 136 ; 0 ) į: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    įdėti: ( Sąrašas naujas ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) į: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    įdėti: ( Sąrašas naujas ; 65 ; 193 ; 129 ; 0 ) į: ['A?'],
	# Invalid first byte (0xFF)
    įdėti: ( Sąrašas naujas ; 255 ; 0 ) į: ['?'],
	# Incomplete multi-byte sequence at end
    įdėti: ( Sąrašas naujas ; 66 ; 226 ; 0 ) į: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    įdėti: ( Sąrašas naujas ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) į: ['A€?𐍈B'].
	 
utf8cases kiekvienas: { :key :value
	>> blob := Blob naujas: value kiekis, bytes: value.
	>> str := blob tekstas.
	(str = key) tiesa: {
		Išvestis rašyti: ['OK'], nauja-eilutė.
	}, kitu-atveju: {
		Išvestis rašyti: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, nauja-eilutė.
	}.
	blob atlaisvinti.
}.
