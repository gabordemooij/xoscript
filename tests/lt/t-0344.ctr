# catch-all test (practical)
>> HTML := Tekstas naujas.
HTML kai: ['encode:'] daryti: { :tekst
	pats pridėti: (tekst
	pakeisti: ['&'] į: ['&amp;'], 
	pakeisti: ['<'] į: ['&lt;'],
	pakeisti: ['>'] į: ['&gt;'],
	pakeisti: ['"'] į: ['&quot;']).
}.
>> blog := HTML naujas.
blog pridėti: ['<h1>'],
     encode: ['Koffie & Thee'],
     pridėti: ['</h1>'].
Išvestis rašyti: blog, nauja-eilutė.


>> Roman := Skaičius naujas.
Roman kai: ['stringy'] daryti: {
	>> a := [''].
	{ a pridėti: ['I']. } × pats. <- a.
}.

>> x := Roman naujas.
x sudėti: 3.
Išvestis rašyti: x stringy, nauja-eilutė.

>> Quantum := Loginis naujas.
Quantum kai: ['true?'] daryti: { <- ['maybe True']. }.
Išvestis rašyti: (Quantum naujas true?), nauja-eilutė.

>> Nihil := Niekas naujas.
Nihil kai: ['tekstas'] daryti: { <- ['Nihil']. }.
Išvestis rašyti: (Nihil naujas), nauja-eilutė.
