>> items := Žodynas naujas.
items įdėti: ['green'] į: ['color-1'].
items įdėti: ['orange'] į: ['color-2'].
items įdėti: ['red'] į: ['color-3'].
>> i := 0.
>> s := [''].
items kiekvienas: { :key :color
	Išvestis rašyti: ['color #'] + i + [' is: '] + color + [' '].
	i sudėti: 1.
}.
Išvestis rašyti: i + [' colors!'].
