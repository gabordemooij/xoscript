


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.
>> palette := Niekas.
>> colors := Niekas.

{
palette := Žodynas naujas.
palette 
	įdėti: ['#F00'] į: ['red'],
	įdėti: ['#0F0'] į: ['green'],
	įdėti: ['#00F'] į: ['blue'].
Išvestis rašyti: ['number of RGB codes in palette: '] + ( palette kiekis ), nauja-eilutė.
Išvestis rašyti: ['RGB code of green is: '] + ( palette ? ['green'] ), nauja-eilutė.
colors := [''].
( palette kiekvienas: { :pavadinimas :kodas
		colors := colors + ( pavadinimas + [':'] + kodas ).
} ).
Išvestis rašyti: ['All colors in palette: '] + colors, nauja-eilutė.
} paleisti.
Programa išvalyti.
usedMemory1 := (Programa atmintis ? 0).

{
palette := Žodynas naujas.
palette 
	įdėti: ['#F00'] į: ['red'],
	įdėti: ['#0F0'] į: ['green'],
	įdėti: ['#00F'] į: ['blue'].
Išvestis rašyti: ['number of RGB codes in palette: '] + ( palette kiekis ), nauja-eilutė.
Išvestis rašyti: ['RGB code of green is: '] + ( palette ? ['green'] ), nauja-eilutė.
colors := [''].
( palette kiekvienas: { :pavadinimas :kodas
		colors := colors + ( pavadinimas + [':'] + kodas ).
} ).
Išvestis rašyti: ['All colors in palette: '] + colors, nauja-eilutė.
} paleisti.
Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).

{
palette := Žodynas naujas.
palette 
	įdėti: ['#F00'] į: ['red'],
	įdėti: ['#0F0'] į: ['green'],
	įdėti: ['#00F'] į: ['blue'].
Išvestis rašyti: ['number of RGB codes in palette: '] + ( palette kiekis ), nauja-eilutė.
Išvestis rašyti: ['RGB code of green is: '] + ( palette ? ['green'] ), nauja-eilutė.
colors := [''].
( palette kiekvienas: { :pavadinimas :kodas
		colors := colors + ( pavadinimas + [':'] + kodas ).
} ).
Išvestis rašyti: ['All colors in palette: '] + colors, nauja-eilutė.
} paleisti.
Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
