

>> Cat := Objektas naujas.

Cat kai: ['naujas'] daryti: {
	savas sound := ['meow!'].
}.

Cat kai: ['nieuw'] daryti: {
	savas sound := ['meow!'].
}.

Cat kai: ['makeSound'] daryti: { <- savas sound.
}.

Cat kai: ['greet'] daryti: { <- pats makeSound.
}.

>> cat := Cat naujas.
Išvestis rašyti: cat greet.
