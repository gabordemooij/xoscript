# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seifas generuoti-raktus.

# private (secret) key
>> sk := keys pirmas.

# public key
>> pk := keys paskutinis.

# sign a message
>> sig := Seifas pasirašyti: ['abc'] raktu: sk.

# check message (ok)
Išvestis rašyti: ( 
	Seifas
		patikrinti: ['abc'] 
		parašas: sig 
		raktu: pk 
), nauja-eilutė.

# check message (fail)
Išvestis rašyti: ( 
	Seifas 
		patikrinti: ['abd'] 
		parašas: sig 
		raktu: pk 
), nauja-eilutė.