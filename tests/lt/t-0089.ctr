>> randomizer := { :a :b
	>> minimumas := ( a < b ) arba: a arba: b.
	>> maksimumas := ( a > b ) arba: a arba: b.
	>> x := Niekas.
	{
		x := Skaičius tarp: a ir: b.
		((x < minimumas) arba: (x > maksimumas)) tiesa: { 
			Išvestis rašyti: (['Invalid value!']).
			Programa baigti.
		}.
	} 
	× 100. <- x.
}.
randomizer taikyti: 0 ir: 0.
randomizer taikyti: 1 ir: 0.
randomizer taikyti: 1 ir: 1.
randomizer taikyti: 0 ir: 1.
randomizer taikyti: -1 ir: 0.
