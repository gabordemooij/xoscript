

Sąrašas kai: ['fixture:'] daryti: { :f
	savas fixture := f.
}.

Sąrašas kai: ['kiekis'] daryti: { <- savas fixture.
}.

Sąrašas kai: ['aantal'] daryti: { <- savas fixture.
}.


>> x := Niekas.
{

	x := ['hello'] 
	pakeisti:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] simbolis: 2)
			)
		)
	į: (
		(['...hal'] + ['lo']) 
			didžiosios-raidės 
			lowecase 
			didžiosios-raidės 
			poslinkis: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Sąrašas ← 0 ; 1 ; 4; 9 ; (Sąrašas ← 0 ; 3; 1) ; 4
							) priešpaskutinis
						) ? 1
					) + 
					((Sąrašas ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					kiekis
				)
			)
	).

} × 10.
Išvestis rašyti: x, nauja-eilutė.

