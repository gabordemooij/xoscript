Išvestis rašyti: ['Continue for-loop, No - before 6 and up.'], nauja-eilutė.
{ :i
	Išvestis rašyti: (i + 1), nauja-eilutė.
	((i + 1) > 4) tęsti.
	Išvestis rašyti: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Išvestis nauja-eilutė.
Išvestis rašyti: ['Continue while-true, No --> before 5 and up.'], nauja-eilutė.
{
	Išvestis rašyti: ['iteration #'] + x, nauja-eilutė.
	x sudėti: 1.
	((x < 5) ne) tęsti.
	Išvestis rašyti: ['-->'].
} kol: xIsLessThan10.
Išvestis nauja-eilutė.
Išvestis rašyti: ['Continue while-false, No - before 3 only.'], nauja-eilutė.
{
	Išvestis rašyti: ['iteration #'] + x, nauja-eilutė.
	x atimti: 1.
	(x = 3) tęsti.
	Išvestis rašyti: ['-'].
} kol: { <- ( x > 0). }.

Išvestis nauja-eilutė.
Išvestis rašyti: ['Continue times-loop, No ||| before 3.'], nauja-eilutė.
{ :i
	Išvestis rašyti: ['iteration #'] + i, nauja-eilutė.
	(i = 2) tęsti.
	Išvestis rašyti: ['|||'].
} × 5.

Išvestis nauja-eilutė.

{ Tiesa tęsti. Išvestis rašyti: ['dont write this!'], nauja-eilutė. } paleisti.

{ Tiesa tęsti. Išvestis rašyti: ['dont write this!'], nauja-eilutė. } pagauti: { Išvestis rašyti: ['Dont catch this!']. }, paleisti.

Išvestis rašyti: ['Test Array each-loop: 0, ... ,2'], nauja-eilutė.
(Sąrašas ← 1 ; 2 ; 3) atvaizduoti: { :i
	(i = 1) tęsti.
	Išvestis rašyti: ['iteration #'] + (i - 0), nauja-eilutė.
}.

Išvestis rašyti: ['Test Map each-loop: c only'], nauja-eilutė.
>> m := Žodynas naujas.
m įdėti: ['first'] į: ['a'], įdėti: ['second'] į: ['b'], įdėti: ['third'] į: ['c'].
m kiekvienas: { :k :v
	(k ≠ ['c']) tęsti.
	Išvestis rašyti: ['iteration'] + k + v, nauja-eilutė.
}.

