>> makeAdder := { :x
	>> f := { :y <- (savas x + y). } nustatyti: ['x'] reikšmė: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i savas q įdėti: (savas f taikyti: (savas q ? i)) į: i. } 
	nustatyti: ['q'] reikšmė: array,
	nustatyti: ['f'] reikšmė: func.
	{ :i mapping taikyti: i. } × (array kiekis).
}.

>> a := Sąrašas ← 1; 2; 3.
mapper taikyti: a ir: (makeAdder taikyti: 100).
Išvestis rašyti: (a padėtis: 0), nauja-eilutė.
Išvestis rašyti: (a ? 1), nauja-eilutė.
Išvestis rašyti: (a ? 2), nauja-eilutė.
