#Linux
>> OS := Programa nustatymas: ['OS'].

>> clock := Momentas naujas.
	
(OS = ['Haiku']) tiesa: {
	clock zona: ['CET'],
	metai: 2017, mėnesis: 7, diena: 13,
	valanda: 18, minutė: 0, sekundė: 0.
}, kitu-atveju: {
	clock zona: ['Europe/Amsterdam'],
	metai: 2017, mėnesis: 7, diena: 13,
	valanda: 18, minutė: 0, sekundė: 0.
}.

clock kai: ['tell'] daryti: {
	Išvestis rašyti: pats, nauja-eilutė.
}.


clock sudėti: 2    valanda, tell.
clock sudėti: 1    valanda, tell.
clock sudėti: 19 minutė, tell.
clock sudėti: 1  minutė, tell.
clock sudėti: 1  minutė, tell.
clock sudėti: 19 sekundė, tell.
clock sudėti: 1  sekundė, tell.
clock sudėti: 1  sekundė, tell.
clock sudėti: 2    metai, tell.
clock sudėti: 1    metai, tell.

(OS = ['Haiku']) tiesa: {
clock sudėti: 5   mėnesis.
clock zona: ['CEST'], tell.
}, kitu-atveju: {
	clock sudėti: 5   mėnesis, tell.
}.

clock sudėti: 1   mėnesis, tell.
clock sudėti: 19    diena, tell.
clock sudėti: 1    valanda, tell.
clock sudėti: 120  yard, tell.
