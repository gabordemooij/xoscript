Server init.
Išvestis rašyti: ['Database datetime test'], nauja-eilutė.

>> db := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'], 
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.

>> paieškos-parametrai :=
db užklausa: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
gauti: { :row
	Išvestis rašyti: row datetimetest, nauja-eilutė.
}.
