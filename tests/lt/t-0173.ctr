

Sąrašas kai: ['sum'] daryti: {
	>> total := 0.
	pats kiekvienas: { :index :element
		total sudėti: element.
	}. <- total.
}.

Sąrašas kai: ['product'] daryti: {
	>> total := 1.
	pats kiekvienas: { :index :element
		total padauginti-iš: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

{

>> a := Sąrašas ← ['hello'] ; ['world'] ; Tiesa ; Niekas ; 666.
a := a + ( Sąrašas ← 1 ).
Išvestis rašyti: ( ['sum: '] + ( a sum ) ), nauja-eilutė.
Išvestis rašyti: ( ['min: '] + ( a minimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['max: '] + ( a maksimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['3rd: '] + ( a ? 2 ) ), nauja-eilutė.
Išvestis rašyti: ( ['prd: '] + ( a product ) ), nauja-eilutė.
a rūšiuoti: { :a :b <- (b - a). }.
a kiekvienas: { :i :e Išvestis rašyti: ( i - 0 ), nauja-eilutė. }.

} paleisti.

Programa išvalyti.
usedMemory1 := (Programa atmintis ? 0).


{

>> a := Sąrašas ← ['hello'] ; ['world'] ; Tiesa ; Niekas ; 666.
a := a + ( Sąrašas ← 1 ).
Išvestis rašyti: ( ['sum: '] + ( a sum ) ), nauja-eilutė.
Išvestis rašyti: ( ['min: '] + ( a minimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['max: '] + ( a maksimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['3rd: '] + ( a ? 2 ) ), nauja-eilutė.
Išvestis rašyti: ( ['prd: '] + ( a product ) ), nauja-eilutė.
a rūšiuoti: { :a :b <- (b - a). }.
a kiekvienas: { :i :e Išvestis rašyti: ( i - 0 ), nauja-eilutė. }.

} paleisti.



Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


{

>> a := Sąrašas ← ['hello'] ; ['world'] ; Tiesa ; Niekas ; 666.
a := a + ( Sąrašas ← 1 ).
Išvestis rašyti: ( ['sum: '] + ( a sum ) ), nauja-eilutė.
Išvestis rašyti: ( ['min: '] + ( a minimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['max: '] + ( a maksimumas ) ), nauja-eilutė.
Išvestis rašyti: ( ['3rd: '] + ( a ? 2 ) ), nauja-eilutė.
Išvestis rašyti: ( ['prd: '] + ( a product ) ), nauja-eilutė.
a rūšiuoti: { :a :b <- (b - a). }.
a kiekvienas: { :i :e Išvestis rašyti: ( i - 0 ), nauja-eilutė. }.

} paleisti.



Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).

( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
