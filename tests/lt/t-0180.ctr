Tekstas kai: ['html'] daryti: { <- (
		pats
		pakeisti: ['&'] į: ['&amp;'],
		pakeisti: ['<'] į: ['&lt;'],
		pakeisti: ['>'] į: ['&gt;'],
		pakeisti: ['''] į: ['&apos;'],
		pakeisti: ['"'] į: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Išvestis rašyti: txt kopijuoti html, nauja-eilutė.
Išvestis rašyti: txt kopijuoti mažosios-raidės, nauja-eilutė.
Išvestis rašyti: txt kopijuoti didžiosios-raidės, nauja-eilutė.
} paleisti.

Programa išvalyti.

usedMemory1 := (Programa atmintis ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Išvestis rašyti: txt kopijuoti html, nauja-eilutė.
Išvestis rašyti: txt kopijuoti mažosios-raidės, nauja-eilutė.
Išvestis rašyti: txt kopijuoti didžiosios-raidės, nauja-eilutė.
} paleisti.

Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Išvestis rašyti: txt kopijuoti html, nauja-eilutė.
Išvestis rašyti: txt kopijuoti mažosios-raidės, nauja-eilutė.
Išvestis rašyti: txt kopijuoti didžiosios-raidės, nauja-eilutė.
} paleisti.

Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
