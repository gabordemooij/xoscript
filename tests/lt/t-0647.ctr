Server init.
Išvestis rašyti: ['Database time test'], nauja-eilutė.

>> db := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'], 
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.

>> paieškos-parametrai :=
db užklausa: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
gauti: { :row
	Išvestis rašyti: row timetest, nauja-eilutė.
}.
