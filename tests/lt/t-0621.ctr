>> phrases := Sąrašas naujas
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kiekvienas: { :_ :phrase 
	>> e := Server base64-koduoti: phrase.
	>> d := Server base64-dekoduoti: e.
	Išvestis rašyti: (
		message kopijuoti ~encoded: e, ~decoded: d
	), nauja-eilutė.
}.
