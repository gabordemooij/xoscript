
Tekstas kai: ['evaluate'] daryti: {
	>> kodas := Failas naujas: ['/tmp/eval.ctr'].
	kodas rašyti: (pats tekstas + ['.']).
	Programa naudoti: ['/tmp/eval.ctr'].
}.

>> map :=
	(Žodynas naujas)
	įdėti: ['Hi There'] į: ['two'],
	įdėti: (Sąrašas ← ['hello'] ; ['world'] ; (Sąrašas ← 1 ; 2; 9) ; Netiesa) į: ['one'],
	įdėti: ( (Žodynas naujas) įdėti: ['wrrld'] į: ['misspelled'] ) į: ['three'],
	įdėti: (Sąrašas ← ((Žodynas naujas) įdėti: ['treasure'] į: ['hidden']) ; 2) į: ['four']. 
>> str := map tekstas.
>> map2 := Niekas.
(['map2 := '] + str ) evaluate.
Išvestis rašyti: map2 ? ['one'] ? 0.
Išvestis rašyti: map2 ? ['one'] ? 1.
Išvestis rašyti: map2 ? ['four'] ? 0 ? ['hidden'].
Išvestis rašyti: map2 ? ['one'] ? 2 ? 2.
