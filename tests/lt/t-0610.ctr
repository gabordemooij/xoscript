
>> Rectangle := Objektas naujas.

Rectangle kai: ['area'] daryti: { <- savas ilgis * savas width.
}.

Rectangle kai: ['length:'] daryti: { :ilgis
	savas ilgis := ilgis.
}.

Rectangle kai: ['width:'] daryti: { :width
	savas width := width.
}.

Rectangle kai: ['naujas'] daryti: {
	# this will not result into an infinite loop
	>> rectangle := pats naujas.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle naujas.
Išvestis rašyti: a area, nauja-eilutė. #0

>> b := Rectangle naujas length: 2, width: 3.
Išvestis rašyti: b area, nauja-eilutė. #6

