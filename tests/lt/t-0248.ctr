

Tekstas kai: ['evaluate'] daryti: {
	>> kodas := Failas naujas: ['/tmp/eval.ctr'].
	kodas rašyti: pats tekstas + ['.'].
	Programa naudoti: ['/tmp/eval.ctr'].
}.

>> a := (Sąrašas ← (
	(Žodynas naujas)
		įdėti: ['domain'] į: ['mywebsite.com'],
		įdėti: (Sąrašas ←
			((Žodynas naujas)
				įdėti: ['home'] į: ['title'],
				įdėti: ['<html></html>'] į: ['body'],
				įdėti: ['2017-01-01'] į: ['created']
			) ;
			((Žodynas naujas)
				įdėti: ['aboutus(c)'] į: ['title'],
				įdėti: ['<credits>Author Inc.</credits>'] į: ['body']
			)
		) į: ['pages']
	)
) tekstas.

Išvestis rašyti: a tipas, nauja-eilutė.
Išvestis rašyti: a, nauja-eilutė.

>> b := Niekas.
(['b := '] + a) evaluate.
Išvestis rašyti: b ? 0 ? ['pages'] ? 1 ? ['body'], nauja-eilutė.

>> c := b ? 0.
>> d := c tekstas.
Išvestis rašyti: d tipas, nauja-eilutė.

>> e := Niekas.
(['e := '] + d) evaluate.
Išvestis rašyti: e ? ['pages'] ? 0, nauja-eilutė.
