>> items := Žodynas naujas.
items įdėti: ['black'] į: ['coffee'], įdėti: ['earl grey'] į: ['tea'].
Išvestis rašyti: (items vietoje: ['coffee']), rašyti: (items vietoje: ['tea']).
Išvestis rašyti: ['there are'] + items kiekis + [' items in the array.'].
items įdėti: ['capuccino'] į: ['coffee'].
Išvestis rašyti: ['Now my coffee is.. '] + (items vietoje: ['coffee']).
items įdėti: ['aaa'] į: ['1'].
items įdėti: ['bbb'] į: ['2'].
Išvestis rašyti: (items vietoje: ['a']).
