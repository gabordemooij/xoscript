

>> Matryoshka := Objektas naujas.
Matryoshka kai: ['double:'] daryti: { :secret
	savas secret := secret × 2.
}.
Matryoshka kai: ['naujas:'] daryti: { :secret
	>> answer := Niekas.
	>> t := (secret > 255).
	Išvestis rašyti: (secret + [' | '] + t), nauja-eilutė.
	t tiesa: {
		answer := secret.
	}, kitu-atveju: {
		answer := Matryoshka rekursinis naujas: (pats double: secret).
	}. <- answer.
}.

>> x := Matryoshka naujas: 2.
