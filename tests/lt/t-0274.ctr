

Sąrašas kai: ['column:'] daryti: { :column
	>> result := Sąrašas naujas.
	pats kiekvienas: { :index :row
		row kiekvienas: { :index :cell
			(index = column) tiesa: { result pridėti: cell. }.
		}.
	}. <- result.
}.


>> a := Sąrašas ←
	(Sąrašas ← 1 ; 2 ; 3) ;
	(Sąrašas ← 4 ; 5 ; 6) ;
	(Sąrašas ← 7 ; 8 ; 9).

>> b := a column: 1.
Išvestis rašyti: b, nauja-eilutė.

b := a column: 20.
Išvestis rašyti: b, nauja-eilutė.

b := a column: -100.
Išvestis rašyti: b, nauja-eilutė.
