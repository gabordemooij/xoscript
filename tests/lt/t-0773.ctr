Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 
a kai: ['item:'] daryti: { :int64
	savas int64 := int64. 
}.
a kai: ['item'] daryti: { <- savas int64.
}.
a item: ( Int64 iš-teksto: ['9999'] ).
Išvestis rašyti: a item, nauja-eilutė.
>> old-int64-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.
>> b := Objektas load-from: ['/tmp/a.bin'].
(b item prototipas atminties-adresas = old-int64-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.
Išvestis rašyti: ( b item ), nauja-eilutė.
