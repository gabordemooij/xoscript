#Linux

(Failas naujas: ['/tmp/testje']) egzistuoja netiesa: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Failas naujas: ['/tmp/testje/file1']) egzistuoja netiesa: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Failas naujas: ['/tmp/testje/folder1']) egzistuoja netiesa: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Failas sąrašas: ['/tmp/testje'].

>> q := Sąrašas naujas.

l kiekvienas: { :k :v v kiekvienas: { :x :y q pridėti: y. }. }.

>> s := q tekstas.

(s apima: ['file1']) tiesa:   { Išvestis rašyti: ['OK'], nauja-eilutė. }.
(s apima: ['file2']) tiesa:   { Išvestis rašyti: ['XX'], nauja-eilutė. }.
(s apima: ['folder1']) tiesa: { Išvestis rašyti: ['OK'], nauja-eilutė. }.
