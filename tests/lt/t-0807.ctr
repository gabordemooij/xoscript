# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'],
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.

>> paieškos-parametrai := db užklausa: ['SELECT %% FROM'].
{ paieškos-parametrai vykdyti. } pagauti: { :e
	Išvestis rašyti: ( e apima: ['%%'] ), nauja-eilutė.
}, paleisti.
