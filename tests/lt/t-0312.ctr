>> Slurp := Objektas naujas.
Slurp kai: ['naujas'] daryti: {
	savas str := [''].
}.
Slurp išmokti: ['nieuw'] reiškia: ['naujas'].
Slurp kai: ['atsakyti:'] daryti: { :blah
		(savas str ≠ ['']) tiesa: {
			savas str pridėti: [' '].
		}.
		savas str pridėti: blah.
}.
Slurp kai: ['atsakyti:ir:'] daryti: { :blah :blahah
		(savas str ≠ ['']) tiesa: {
			savas str pridėti: [' '].
		}.
		(blah ilgis > 1) tiesa: {
			savas str pridėti: (blah nuo: 0 ilgis: (blah ilgis - 1)).
		}, kitu-atveju: {
			savas str pridėti: blah.
		}.
		savas str pridėti: [' '].
		savas str pridėti: blahah.
}.
Slurp kai: ['obtain'] daryti: {
	>> buffer := savas str.
	savas str := ['']. <- buffer.
}.


>> paieškos-parametrai := Slurp naujas
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Išvestis rašyti: paieškos-parametrai obtain, nauja-eilutė.
