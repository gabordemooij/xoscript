# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> kelias := ['/tmp/dat.csv'].
>> csv := Failas naujas: kelias.
csv rašyti: s.

# accepts CRLF LF CR, varying row length
csv skyriklis: [';'] kabutė: ['"'] eilutės: { :line
	Programa išvalyti.
	Išvestis rašyti: line, nauja-eilutė.
	Programa išvalyti.
}.

# unequal lines
s pridėti: ['\njustone'].
csv rašyti: s.
{
	csv skyriklis: [';'] kabutė: ['"'] eilutės: { :line
		Išvestis rašyti: line, nauja-eilutė.
	}.
} pagauti: { :e 
	Išvestis rašyti: e, nauja-eilutė.
}, paleisti.

# invalid format
s := ['"he"llo";world'].
csv rašyti: s.
{
	csv skyriklis: [';'] kabutė: ['"'] eilutės: { :line
		Išvestis rašyti: line, nauja-eilutė.
	}.
} pagauti: { :e 
	Išvestis rašyti: e, nauja-eilutė.
}, paleisti.
