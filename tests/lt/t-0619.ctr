>> HTML := Objektas naujas.
HTML kai: ['atsakyti:'] daryti: { :tag 
	Išvestis rašyti: (['<tag>'] tag: tag), nauja-eilutė.
}.
HTML kai: ['atsakyti:ir:'] daryti: { :tag :html 
	Išvestis rašyti: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nauja-eilutė.
}.
>> html := HTML naujas.
html body h1: ['header'].

