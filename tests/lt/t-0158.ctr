>> x := [' hallo '].

>> y := x didžiosios-raidės.
Išvestis rašyti: x, nauja-eilutė.
Išvestis rašyti: (x lygu: y), nauja-eilutė.

>> y := x mažosios-raidės.
Išvestis rašyti: x, nauja-eilutė.
Išvestis rašyti: (x lygu: y), nauja-eilutė.

>> y := x apkarpyti.
Išvestis rašyti: x, nauja-eilutė.
Išvestis rašyti: (x lygu: y), nauja-eilutė.

>> y := x poslinkis: 1.
Išvestis rašyti: x, nauja-eilutė.
Išvestis rašyti: (x lygu: y), nauja-eilutė.

>> y := x nuo: 1 ilgis: 2.
Išvestis rašyti: x, nauja-eilutė.
Išvestis rašyti: (x lygu: y), nauja-eilutė.