>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objektas naujas.
⚄ kai: ['drawFrom:length:'] daryti: { :pool :kiekis
	
	>> result := [''].
	
	{
		>> index := Skaičius random % (pool ilgis).
		result pridėti: ( pool simbolis: (index + 1) ).
		
	} × kiekis. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? ilgis.
Išvestis rašyti: (['x↵'] x random ilgis).
Išvestis rašyti: (['y↵'] y ?? ilgis).

