


>> wine := Objektas naujas.


wine kai: ['toString'] daryti: { <- ['merlot'].
}.

wine kai: ['naarTekst'] daryti: { <- ['merlot'].
}.


wine kai: ['='] daryti: { :other wine <- ( pats toString = other wine ).
}.

wine kai: ['=='] daryti: { :other wine <- ( pats toString = other wine ).
}.



wine
	atvejis: ['cabernet'] daryti: { Išvestis rašyti: ['it's a Cabernet!']. },
	atvejis: ['syrah']    daryti: { Išvestis rašyti: ['it's a Syrah!'].    },
	atvejis: ['merlot']   daryti: { Išvestis rašyti: ['it's a Merlot!'].   },
	atvejis: ['malbec']   daryti: { Išvestis rašyti: ['it's a Malbec!'].   }.

Išvestis nauja-eilutė.
