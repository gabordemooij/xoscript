Sąrašas kai: ['sum'] daryti: {
	>> total := 0.
	pats kiekvienas: { :index :element
		total sudėti: element.
	}. <- total.
}.

>> a := Tiesa.



a kai: ['tekstas'] daryti: {
	>> answer := Niekas.
	( pats = Tiesa ) tiesa: {
		answer := ['Yep'].
	}, kitu-atveju: {
		answer := ['Nope'].
	}. <- answer.
}.

a kai: ['skaičius'] daryti: {
	>> answer := Niekas.
	( pats = Tiesa ) tiesa: {
		answer := 10.
	}, kitu-atveju: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kai: ['tekstas'] daryti: { <- ['Devil'].
}.

b kai: ['loginis'] daryti: { <- Netiesa.
}.


Išvestis rašyti: a, nauja-eilutė.  
Išvestis rašyti: (90 + a), nauja-eilutė. 
Išvestis rašyti: b, nauja-eilutė. 
Išvestis rašyti: (Tiesa ir: b), nauja-eilutė.

a := Sąrašas ← ['hello'] ; ['world'] ; Tiesa ; Niekas ; 666. 
a := a + ( Sąrašas ← 1 ).
Išvestis rašyti: a, nauja-eilutė.
Išvestis rašyti: ((Žodynas naujas) įdėti: Niekas į: Niekas), nauja-eilutė.
Išvestis rašyti: a sum, nauja-eilutė. 


{
	a kai: ['tekstas'] daryti: { <- Niekas. }.
	a := [''] + a.
} pagauti: { :error
	Išvestis rašyti: ['Error noted: '] + error, nauja-eilutė.
}, paleisti.



{
	a kai: ['skaičius'] daryti: { <- Niekas. }.
	a := 3 × a.
} pagauti: { :error
	Išvestis rašyti: ['Error noted: '] + error, nauja-eilutė.
}, paleisti.


{
	a kai: ['loginis'] daryti: { <- Niekas. }.
	a := Tiesa ir: a. 
} pagauti: { :error
	Išvestis rašyti: ['Error noted: '] + error, nauja-eilutė.
}, paleisti.





