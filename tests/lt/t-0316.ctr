>> Grandfather := Objektas naujas.
Grandfather kai: ['greet'] daryti: {
	Išvestis rašyti: ['Ave!'], nauja-eilutė.
}.
>> Father := Grandfather naujas.
Father kai: ['greet'] daryti: {
	Išvestis rašyti: ['Hello'], nauja-eilutė.
	pats greet.
}.
>> Son := Father naujas.
Son kai: ['greet'] daryti: {
	Išvestis rašyti: ['Hi'], nauja-eilutė.
	pats greet.
}.

Son greet.

>> Roundabout := Objektas naujas.
Roundabout kai: ['circle:'] daryti: { :x
	Išvestis rašyti: x, nauja-eilutė.
	(x < 3) tiesa: { pats rekursinis circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tiesa: { Išvestis rašyti: x, nauja-eilutė. x sudėti: 1.  increment paleisti. }. }.
increment paleisti.