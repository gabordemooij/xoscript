# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programa nustatymas: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server susieti: ( Sąrašas naujas ;
 libname ; ['fopen'] ;
 ( Sąrašas naujas ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
susieti: ( Sąrašas naujas ;
 Niekas ; # means same lib
 ['fread'] ;
 ( Sąrašas naujas ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niekas ; # means same object (i.e. Stream)
 ['fread']
),
susieti: (
 Sąrašas naujas ;
 Niekas ; # means same lib
 ['fwrite'] ;
 ( Sąrašas naujas ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niekas ; # means same lib
 ['fwrite']
),
susieti: (
 Sąrašas naujas ;
 Niekas ; # means same lib
 ['rewind'] ;
 ( Sąrašas naujas ; ['pointer'] ) ;
 ['int'] ;
 Niekas ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> kelias := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: kelias mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream žinutė: ['fwrite'] argumentai: (Sąrašas naujas ; str ; 1 ; 6 ; fd ).
Išvestis rašyti: bytes-written, nauja-eilutė.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob naujas: 20.

# read from file
>> bytes-read := Stream žinutė: ['fread'] argumentai: (Sąrašas naujas ; buf ; 1 ; 6 ; fd ).
Išvestis rašyti: bytes-read, nauja-eilutė.
Išvestis rašyti: buf, nauja-eilutė.

# free memory
str  atlaisvinti.
kelias atlaisvinti.
mode atlaisvinti.
buf  atlaisvinti.


