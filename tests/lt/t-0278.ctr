>> To-Do := Objektas naujas.

To-Do kai: ['naujas'] daryti: {
	savas list := Sąrašas naujas.
}.

To-Do kai: ['nieuw'] daryti: {
	savas list := Sąrašas naujas.
}.

To-Do kai: ['+'] daryti: { :task
	savas list pridėti: task.
}.

To-Do kai: ['number of tasks?'] daryti: { <-  savas list kiekis.
}.

>> todos := 
	To-Do naujas 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Išvestis rašyti: ['You have $ tasks to do'] $ todos number of tasks?.
