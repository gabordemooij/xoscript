{
	ši-užduotis klaida: ['Dont fail.'].
	unknown doSomething.
} pagauti: {
	Išvestis rašyti: ['Caught!'].
}, paleisti.

{
	ši-užduotis klaida: ['Dont fail.'].
	savas unknown doSomething.
} pagauti: {
	Išvestis rašyti: ['Caught!'].
}, paleisti.

{
	ši-užduotis klaida: ['Dont fail.'].
	unknown := 122.
} pagauti: {
	Išvestis rašyti: ['Caught!'].
}, paleisti.


{
	ši-užduotis klaida: ['Dont fail.'].
	Tiesa stabdyti.
	Išvestis rašyti: ['FAIL'].
} pagauti: {
	Išvestis rašyti: ['Caught!'].
}, paleisti.

{
	{
		ši-užduotis klaida: ['Dont fail.'].
		Tiesa stabdyti.
		Išvestis rašyti: ['FAIL'].
	} pagauti: { :x
		(x = ['Dont fail.']) tiesa: { ši-užduotis klaida: ['Nested Caught!']. }.
	}, paleisti.
} pagauti: { :e
	Išvestis rašyti: e.
}, paleisti.
