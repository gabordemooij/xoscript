# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Šablonas naujas: pattern.
	p atitikmuo: subject daryti: { :m :g
		Išvestis rašyti: g kiekis, rašyti: [' '], rašyti: (g sujungti: ['|']), nauja-eilutė. <- m.
	}.
}.
show taikyti: ['(a)|(b)'] ir: ['b'].
show taikyti: ['(a)|(b)'] ir: ['a'].
show taikyti: ['(x)?y'] ir: ['y'].
show taikyti: ['(x)?(y)(z)?'] ir: ['xy'].
