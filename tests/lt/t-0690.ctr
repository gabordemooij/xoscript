# database test
# see example server.xo for required config

Server init.
Išvestis rašyti: ['Database test'], nauja-eilutė.

>> db := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'], slaptažodis: ['pass123'], duomenų-bazės-vardas: ['xobase'], prisijungti.

Išvestis rašyti: ['Can we connect? '] + db prisijungta?, nauja-eilutė.

>> paieškos-parametrai := db užklausa: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametrai: ( Sąrašas naujas ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  paieškos-parametrai vykdyti. db patvirtinti. } pagauti: { :e db atšaukti.  }, paleisti.

Išvestis rašyti: ['Can we insert? '] + ( paieškos-parametrai insert-id > 0 ), nauja-eilutė.

>> x := 0.
>> paieškos-parametrai :=
db užklausa: ['SELECT * FROM book order by id desc limit 2'], 
gauti: { :row 
	x sudėti: 1.
	Tiesa stabdyti. # must clean up, no 'Commands out of sync'
}.

>> paieškos-parametrai :=
db užklausa: ['SELECT * FROM book order by id desc limit 2'], 
gauti: { :row
	x sudėti: 1.
	Tiesa stabdyti.
}.

(x > 0) tiesa: {
	Išvestis rašyti: ['Can we break in the middle of a fetch? '].
}.

Išvestis rašyti: Tiesa, nauja-eilutė.