

>> obj := Objektas naujas.

obj kai: ['greet'] daryti: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kai: ['task'] daryti: {
	savas property := 123.
	{
		# try binds self/own to object instead of block
		Išvestis rašyti: pats greet.
		Išvestis rašyti: savas property.
		1 / 0.
	} pagauti: {
		Išvestis rašyti: pats greet.
		Išvestis rašyti: savas property.
		Išvestis rašyti: ['ok'].
	}, bandyti.
}.

obj task.