Programa atminties-valdymas: 4.

>> Doubler := Objektas naujas.
>> Multiplier := Objektas naujas.
Doubler kai: ['double:and:'] daryti: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kai: ['multiply:and:'] daryti: { :x :y <- (x × y).
}.

Išvestis rašyti: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nauja-eilutė.
