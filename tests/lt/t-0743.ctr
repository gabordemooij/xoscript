>> V := Objektas.
V kai: ['tekstas'] daryti: {
	Išvestis rašyti: ['cast'], nauja-eilutė. <- ['abc'].
}.

Išvestis rašyti: ( Programa nustatymas: ['abc'] ), nauja-eilutė.

# params should not get gc'ed
Programa nustatymas: ([''] + V naujas) reikšmė: ([''] + V naujas).

Išvestis rašyti: ( Programa nustatymas: ['abc'] ), nauja-eilutė.
