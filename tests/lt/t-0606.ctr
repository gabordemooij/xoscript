>> Point := Objektas naujas.
Point kai: ['x-coordinate:'] daryti: { :x savas x := x. }.
Point kai: ['y-coordinate:'] daryti: { :y savas y := y. }.
Point kai: ['x-coordinate']  daryti: { <- savas x kopijuoti. }.
Point kai: ['y-coordinate']  daryti: { <- savas y kopijuoti. }.

Point kai: ['='] daryti: { :other <- ( savas x = other x-coordinate
		 ir: savas y = other y-coordinate ).
}.

>> pier := Point naujas x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point naujas x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point naujas x-coordinate: 5, y-coordinate: 6.

Išvestis rašyti: pier = town-hall, nauja-eilutė.
Išvestis rašyti: pier = restaurant, nauja-eilutė.
