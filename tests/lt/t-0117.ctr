>> t := Tiesa.
(t = Tiesa) tiesa: { Išvestis rašyti: ['T']. }.
(t = Netiesa) tiesa: { Išvestis rašyti: ['F']. }.
Išvestis rašyti: ['|'].
>> t := Netiesa.
(t = Tiesa) tiesa: { Išvestis rašyti: ['T']. }.
(t = Netiesa) tiesa: { Išvestis rašyti: ['F']. }.
Išvestis rašyti: ['|'].
>> f := Tiesa.
(t = Tiesa ir: f = Netiesa) tiesa: { Išvestis rašyti: ['T']. }.
(t = Netiesa ir: f = Tiesa) tiesa: { Išvestis rašyti: ['F']. }.
Išvestis rašyti: ['|'].
>> n := Niekas.
(n Niekas?) tiesa: { Išvestis rašyti: ['T']. }.
(n Niekas?) netiesa: { Išvestis rašyti: ['F']. }.
Išvestis rašyti: ['|'].
(f Boolean?) tiesa: { Išvestis rašyti: ['T']. }.
(f Boolean?) netiesa: { Išvestis rašyti: ['F']. }.



