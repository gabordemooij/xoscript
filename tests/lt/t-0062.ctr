Loginis kai: ['xor:'] daryti: { :a :b <- ((a ir: b ne) arba: (a ne ir: b)).
}.

>> o := Objektas naujas.
o kai: ['hello'] daryti: { ['Empty']. }.
{ o kai: 2 daryti: 3.} pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti.
{ o kai: ['testas'] daryti: 3.} pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti.
{ o kai: ['hello'] daryti: { ['Empty']. }.} pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ >> z := 4 ÷ 0. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ (Tiesa ir: Niekas) tiesa: { Išvestis rašyti: ['X'].}. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ ([''] xor: 0) tiesa: { Išvestis rašyti: ['X'].}. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ (1 < ['2']) tiesa: { Išvestis rašyti: ['OK']. }. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ (1 < ['2.0']) tiesa: { Išvestis rašyti: ['OK']. }. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ (1 < ['x2.0']) tiesa: { Išvestis rašyti: ['NO!']. }. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti. 
{ Išvestis rašyti: (['hello OK there'] nuo: ['6'] ilgis: ['2']). } paleisti. 
