Skaičius kai: ['roman'] daryti: {
	>> skaičius := pats kopijuoti.
	>> roman := [''].
	{
		{
			(skaičius ≥ 1000) tiesa: {
				roman pridėti: ['Ⅿ'].
				skaičius atimti: 1000.
			}, stabdyti.
		
			(skaičius ≥ 500) tiesa: {
				roman pridėti: ['Ⅾ'].
				skaičius atimti: 500.
			}, stabdyti.
		
			(skaičius ≥ 100) tiesa: {
				roman pridėti: ['Ⅽ'].
				skaičius atimti: 100.
			}, stabdyti.
		
			(skaičius ≥ 50) tiesa: {
				roman pridėti: ['Ⅼ'].
				skaičius atimti: 50.
			}, stabdyti.
		
			(skaičius ≥ 50) tiesa: {
				roman pridėti: ['Ⅼ'].
				skaičius atimti: 50.
			}, stabdyti.
		
			(skaičius ≥ 10) tiesa: {
				roman pridėti: ['Ⅹ'].
				skaičius atimti: 10.
			}, stabdyti.
			
			(skaičius ≥ 9) tiesa: {
				roman pridėti: ['Ⅸ'].
				skaičius atimti: 9.
			}, stabdyti.
			
			(skaičius ≥ 5) tiesa: {
				roman pridėti: ['Ⅴ'].
				skaičius atimti: 5.
			}, stabdyti.
			
			(skaičius ≥ 4) tiesa: {
				roman pridėti: ['Ⅳ'].
				skaičius atimti: 4.
			}, stabdyti.
			
			(skaičius ≥ 1) tiesa: {
				roman pridėti: ['Ⅰ'].
				skaičius atimti: 1.
			}, stabdyti.
		} procedūra.
	} kol: { <- skaičius > 0. }. <- roman.
}.

Išvestis rašyti: 1 roman, nauja-eilutė.
Išvestis rašyti: 2 roman, nauja-eilutė.
Išvestis rašyti: 4 roman, nauja-eilutė.
Išvestis rašyti: 8 roman, nauja-eilutė.
Išvestis rašyti: 16 roman, nauja-eilutė.
Išvestis rašyti: 32 roman, nauja-eilutė.
Išvestis rašyti: 64 roman, nauja-eilutė.
Išvestis rašyti: 128 roman, nauja-eilutė.
Išvestis rašyti: 256 roman, nauja-eilutė.
Išvestis rašyti: 1024 roman, nauja-eilutė.
