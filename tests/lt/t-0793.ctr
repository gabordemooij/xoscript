Server init.

>> DB := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'],
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.

{
	DB užklausa:
	['DROP TABLE movies'],
	vykdyti.
} pagauti: { Niekas. }, paleisti.

DB užklausa:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
vykdyti.

DB užklausa: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrai: ( Sąrašas naujas ; ['Halloween'] ),
vykdyti.

DB užklausa: ['SELECT * FROM movies'],
gauti: { :movie
	Išvestis rašyti: movie title, nauja-eilutė.
}.

