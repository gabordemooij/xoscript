Server init.
>> f := Formatas naujas: ['%d'].
>> a := Blob naujas: 4.
a bytes: ( Sąrašas naujas ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob naujas: 4.
b bytes: ( Sąrašas naujas ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a nuo: 0 ilgis: 3, kiekvienas: { :i :byte
	Išvestis rašyti: ( f taikyti-sveikajam: byte ), nauja-eilutė.
}.
a ^ b.
a nuo: 0 ilgis: 3, kiekvienas: { :i :byte
	Išvestis rašyti: ( f taikyti-sveikajam: byte ), nauja-eilutė.
}.
a ^ b.
a nuo: 0 ilgis: 3, kiekvienas: { :i :byte
	Išvestis rašyti: ( f taikyti-sveikajam: byte ), nauja-eilutė.
}.
a atlaisvinti.
b atlaisvinti.

{ a ^ Objektas. } pagauti: { :e Išvestis rašyti: e, nauja-eilutė. }, paleisti.
