Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :octhelper
	savas octhelper := octhelper. 
}.

a kai: ['item'] daryti: { <- savas octhelper.
}.

a item: Oct naujas.

>> old-octhelper-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.

>> b := Objektas load-from: ['/tmp/a.bin'].

(b item prototipas atminties-adresas = old-octhelper-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.
