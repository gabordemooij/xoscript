Išvestis rašyti: ['Test object'], nauja-eilutė.
>> greeter := Objektas naujas.
greeter kai: ['name:'] daryti: { :pavadinimas
	savas xname := pavadinimas. 
}.
greeter kai: ['greet'] daryti: {
	Išvestis rašyti: ['Hello '] + savas xname, nauja-eilutė.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.
>> b := Objektas load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
