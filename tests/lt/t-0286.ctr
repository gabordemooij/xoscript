['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Išvestis rašyti: (x + y), nauja-eilutė.

>> x := 10040.07.
>> y := 10305.60.

Išvestis rašyti: (x + y), nauja-eilutė.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Išvestis rašyti: (x + y + z), nauja-eilutė.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Išvestis rašyti: (x + y + z), nauja-eilutė.

>> q := 0.1.2.

Išvestis rašyti: (q), nauja-eilutė.

>> q := 012.

Išvestis rašyti: (q), nauja-eilutė.
