
>> dictionary := (
	Žodynas naujas
		įdėti: ['b'] į: ['a'],
		įdėti: ['a'] į: ['b'],
		įdėti: ['z'] į: ['x'],
		įdėti: ['hello'] į: ['hallo'],
		įdėti: ['human'] į: ['human']
).

>> comparisons := Sąrašas naujas.
dictionary kiekvienas: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a palyginti: b)
	).
}.

comparisons rūšiuoti: { :a :b <- ( a palyginti: b ). }.
Išvestis rašyti: ( comparisons sujungti: ['↵'] ), nauja-eilutė.
comparisons sujungti: ['↵'].
