>> t := Niekas.

# you can control the time zone for
# parsing like this:
Momentas zona: ['CET'].
t := Momentas iš: ['1981-02-03 04:05:06'].
Išvestis rašyti: t, nauja-eilutė.

# now using CEST time zone:
Momentas zona: ['CEST'].
t := Momentas iš: ['1981-02-03 04:05:06'].
Išvestis rašyti: t, nauja-eilutė.

# error if string cannot be parsed
{ Momentas iš: ['1900']. } pagauti: { Niekas. }, paleisti.
