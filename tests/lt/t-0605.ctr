>> invoice := Objektas naujas.
invoice kai: ['paleisti'] daryti: {
        savas skaičius := 0.
}.

invoice kai: ['skaičius'] daryti: {
        savas skaičius sudėti: 1. <- savas skaičius kopijuoti.
}.

>> year-invoice := invoice naujas.
year-invoice kai: ['start:'] daryti: { :metai
	savas skaičius := metai.
}.

year-invoice start: 202000.
Išvestis rašyti: year-invoice skaičius, nauja-eilutė.
Išvestis rašyti: year-invoice skaičius, nauja-eilutė.
