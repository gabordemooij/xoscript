# test Program version

# this feature is disabled by default
Išvestis rašyti: (
	Programa funkcija: 
	['RECURSIVE_STRINTPOL']
), nauja-eilutė.


# but if we set the time back
>> today := Momentas 
zona: ['CEST'],
iš: ['2026-02-15 10:00:00'].
Programa versija: today.

# it will be enabled like it used to be (from now on)
Išvestis rašyti: (
	Programa funkcija: 
	['RECURSIVE_STRINTPOL']
), nauja-eilutė.