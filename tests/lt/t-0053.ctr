60 × {
	>> x := (Skaičius random % 6) + 1.
	(x ≤ 6) netiesa: { Išvestis rašyti: ['FAIL']. }.
	(x ≥0) netiesa: { Išvestis rašyti: ['FAIL']. }.
	x := (Skaičius random % 3) + 1.
	(x < 3) netiesa: { Išvestis rašyti: ['FAIL']. }.
	(x>-1) netiesa: { Išvestis rašyti: ['FAIL']. }.
	x := ((Loginis flip) skaičius).
	(x = 0 arba: x = 1) netiesa: { Išvestis rašyti: ['FAIL']. }.
	x := ((Tiesa flip) skaičius).
	(x = 0 arba: x = 1) netiesa: { Išvestis rašyti: ['FAIL']. }.
	x := (Loginis flip arba: ['HEAD'] arba: ['TAIL']).
	((x = ['HEAD']) arba: (x = ['TAIL'])) netiesa: { Išvestis rašyti: ['FAIL']. }.
}.
Išvestis rašyti: ['DONE'].

