Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :hexhelper
	savas hexhelper := hexhelper. 
}.

a kai: ['item'] daryti: { <- savas hexhelper.
}.

a item: Hx naujas.

>> old-hexhelper-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.

>> b := Objektas load-from: ['/tmp/a.bin'].

(b item prototipas atminties-adresas = old-hexhelper-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.
