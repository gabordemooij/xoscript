Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Šablonas naujas: ['([ac])'].
>> result := pattern atitikmuo: subject daryti: { :m :x
	Išvestis rašyti: m, nauja-eilutė.
	Išvestis rašyti: x, nauja-eilutė. <- Niekas.
}.
Išvestis rašyti: result, nauja-eilutė.