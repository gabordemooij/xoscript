



>> CoffeeGrounds := Objektas naujas.
CoffeeGrounds kai: ['extract'] daryti: { <- ['coffee']. }.

>> CoffeeMachine := Objektas naujas.
CoffeeMachine kai: ['init'] daryti: {
	savas coffeegrounds := CoffeeGrounds naujas.
}.
CoffeeMachine kai: ['naujas'] daryti: { <- CoffeeMachine `new init.
}.

CoffeeMachine kai: ['makeTea'] daryti: { <- (savas tealeaves extract). }.
CoffeeMachine kai: ['makeCoffee'] daryti: { <- (savas coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine naujas.

Išvestis rašyti:
	coffeeDream 
	makeCoffee.

Išvestis rašyti:
	coffeeDream 
	makeTea.
