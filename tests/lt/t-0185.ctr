

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

>> a := -2 modulis.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programa išvalyti.

usedMemory1 := (Programa atmintis ? 0).


a := -2 modulis.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


a := -2 modulis.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
