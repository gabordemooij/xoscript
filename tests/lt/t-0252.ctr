#Linux
>> clock := Momentas naujas.
clock zona: ['UTC-1'].
clock metai: 1981, mėnesis: 1, diena: 5,
      valanda: 13, minutė: 15, sekundė: 13.

Išvestis rašyti: clock, nauja-eilutė.
clock zona: ['UTC+0'].

Išvestis rašyti: (
	(clock metai paprastas) + ['-'] + (clock mėnesis) + ['-'] + (clock diena) + [' '] +
	(clock valanda) + [':'] + (clock minutė) + [':'] + (clock sekundė) + [' '] +
	['W'] + (clock savaitė) + (clock zona)
), nauja-eilutė.


clock zona: ['UTC-1'].
Išvestis rašyti: (
	(clock metai paprastas) + ['-'] + (clock mėnesis) + ['-'] + (clock diena) + [' '] +
	(clock valanda) + [':'] + (clock minutė) + [':'] + (clock sekundė) + [' '] +
	['W'] + (clock savaitė) + (clock zona)
), nauja-eilutė.
