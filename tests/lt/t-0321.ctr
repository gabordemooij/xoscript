# test qualifiers

Programa išvalyti.

>> Fruit := Objektas naujas.
Fruit kai: ['naujas'] daryti: {
	>> f := pats naujas.
	f apples: 0. <- f.
}.
Fruit kai: ['apples:'] daryti: { :a savas apples := a. }.
Fruit kai: ['apples'] daryti: { <- savas apples. }.
Fruit kai: ['+'] daryti: { :f
	>> n := Fruit naujas.
	n apples: (f apples + savas apples). <- n.
}.
Skaičius kai: ['apples'] daryti: { <- ((Fruit naujas) apples: pats).
}.

Fruit kai: ['tekstas'] daryti: { <- savas apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Išvestis rašyti: q, nauja-eilutė.




q := 3 apples + 4 apples.
Išvestis rašyti: q, nauja-eilutė.



q := 3 apples + 4 apples.
Išvestis rašyti: q, nauja-eilutė.


