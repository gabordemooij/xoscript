Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :fmt
	savas fmt := fmt. 
}.

a kai: ['item'] daryti: { <- savas fmt.
}.

a item: ( Formatas naujas: ['|%s|'] ).

Išvestis rašyti: a item, nauja-eilutė.

>> old-fmt-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.

>> b := Objektas load-from: ['/tmp/a.bin'].

(b item prototipas atminties-adresas = old-fmt-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.

Išvestis rašyti: ( b item taikyti: ['hello'] ), nauja-eilutė.
