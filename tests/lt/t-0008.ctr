>> Greeter := Objektas naujas.
Greeter kai: ['make'] daryti: {
	>> greeter := Objektas naujas.
	greeter kai: ['name:'] daryti: { :pavadinimas
		Išvestis rašyti: ['setting a name'].
		savas myName := pavadinimas.
	}.
	greeter kai: ['greet'] daryti: {
		Išvestis rašyti: ['Hello'].
		Išvestis rašyti: savas myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
