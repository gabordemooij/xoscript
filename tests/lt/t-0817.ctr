# a value ending in the first part of an opening quote must survive serialization
>> reikšmės := Sąrašas naujas
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

reikšmės kiekvienas: { :i :value
	>> d := Žodynas naujas.
	d įdėti: value į: ['k'].
	d įdėti: ['second'] į: ['j'].
	>> r := d kodas objektas.
	Išvestis rašyti: r kiekis, nauja-eilutė.
	Išvestis rašyti: ( (r vietoje: ['k']) = value ), nauja-eilutė.
}.
