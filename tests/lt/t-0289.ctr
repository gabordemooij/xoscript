#Linux
>> OS := Programa sistema: (Komanda uname -s), apkarpyti.

>> Slurp := Objektas naujas.
Slurp kai: ['naujas'] daryti: {
	savas str := [''].
}.
Slurp kai: ['atsakyti:'] daryti: { :blah
		(savas str ≠ ['']) tiesa: {
			savas str pridėti: [' '].
		}.
		savas str pridėti: blah.
}.
Slurp kai: ['atsakyti:ir:'] daryti: { :blah :blahah
		(savas str ≠ ['']) tiesa: {
			savas str pridėti: [' '].
		}.
		(blah ilgis > 1) tiesa: {
			savas str pridėti: (blah nuo: 0 ilgis: (blah ilgis - 1)).
		}, kitu-atveju: {
			savas str pridėti: blah.
		}.
		savas str pridėti: [' '].
		savas str pridėti: blahah.
}.
Slurp kai: ['obtain'] daryti: {
	>> buffer := savas str.
	savas str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text pridėti: ['hello'].
} × 1000.


Išvestis rašyti: (
	Programa sistema: (
		Slurp naujas
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

