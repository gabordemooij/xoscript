>> Greeter := Objektas naujas.
Greeter kai: ['make'] daryti: {
	>> gr := Objektas naujas.
	gr kai: ['setName:'] daryti: { :aname
		savas pavadinimas := aname.
	}.
	gr kai: ['greet'] daryti: {
		Išvestis rašyti: savas pavadinimas.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a naujas.
c setName: ['THREE'].
c greet.
>> d := a naujas.
d setName: ['FOUR'].
d greet.
c greet.
