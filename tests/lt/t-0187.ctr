Skaičius kai: ['factorial'] daryti: {
	>> total := 1.
	{ :index total padauginti-iš: (pats - index). } × pats. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

{
2 exponent factorial.
Išvestis rašyti: (11 liekana: 3), nauja-eilutė.
Išvestis rašyti: (3.4 apvalinti), nauja-eilutė.
Išvestis rašyti: (7.1 apvalinti-aukštyn), nauja-eilutė.
Išvestis rašyti: (7.9 apvalinti-žemyn), nauja-eilutė.
}
paleisti.

Programa išvalyti.

usedMemory1 := (Programa atmintis ? 0).

{
2 exponent factorial.
Išvestis rašyti: (11 liekana: 3), nauja-eilutė.
Išvestis rašyti: (3.4 apvalinti), nauja-eilutė.
Išvestis rašyti: (7.1 apvalinti-aukštyn), nauja-eilutė.
Išvestis rašyti: (7.9 apvalinti-žemyn), nauja-eilutė.
}
paleisti.

Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


{
2 exponent factorial.
Išvestis rašyti: (11 liekana: 3), nauja-eilutė.
Išvestis rašyti: (3.4 apvalinti), nauja-eilutė.
Išvestis rašyti: (7.1 apvalinti-aukštyn), nauja-eilutė.
Išvestis rašyti: (7.9 apvalinti-žemyn), nauja-eilutė.
} paleisti.

Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
