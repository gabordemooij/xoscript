>> a := 3.
>> b := a kopijuoti.
a atimti: 1.
Išvestis rašyti: [' a = '] + a.
Išvestis rašyti: [' b = '] + b.
a := 3.
b := a + 4.
Išvestis rašyti: [' a = '] + a.
Išvestis rašyti: [' b = '] + b.
>> x := 3.
>> y := x kopijuoti.
x sudėti: 10.
y atimti: 1.
Išvestis rašyti: [' x = '] + x.
Išvestis rašyti: [' y = '] + y.
>> q := Objektas naujas.
q kai: ['setProperty:'] daryti: { :x
	savas prop := x.
}.
q kai: ['getProperty'] daryti: { <- savas prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Išvestis rašyti: [' p = '] + (p getProperty).
