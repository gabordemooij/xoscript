# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seifas 
	slaptažodžio-maiša: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seifas 
	slaptažodžio-maiša: hash patikrinti: a1.
	# fail 
>> b := Seifas
	slaptažodžio-maiša: hash patikrinti: a2.
	# ok!

Išvestis rašyti: a, nauja-eilutė.
Išvestis rašyti: b, nauja-eilutė.

