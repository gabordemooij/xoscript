

# create a 64-bit integer for exact calculations
>> a := Int64 iš-teksto: ['123'].

# to string
Išvestis rašyti: a, nauja-eilutė.

# divide
Išvestis rašyti: a / (Int64 iš-teksto: ['3']), nauja-eilutė.

# multiply
Išvestis rašyti: a * (Int64 iš-teksto: ['2']), nauja-eilutė.

# add
Išvestis rašyti: a + (Int64 iš-teksto: ['1']), nauja-eilutė.

# subtract
Išvestis rašyti: a - (Int64 iš-teksto: ['2']), nauja-eilutė.

# compare
Išvestis rašyti: ( a =   (Int64 iš-teksto: ['123'])), nauja-eilutė.
Išvestis rašyti: ( a !=: (Int64 iš-teksto: ['124'])), nauja-eilutė.
Išvestis rašyti: ( a <   (Int64 iš-teksto: ['124'])), nauja-eilutė.
Išvestis rašyti: ( a >   (Int64 iš-teksto: ['122'])), nauja-eilutė.
Išvestis rašyti: ( a >=: (Int64 iš-teksto: ['123'])), nauja-eilutė.
Išvestis rašyti: ( a <=: (Int64 iš-teksto: ['123'])), nauja-eilutė.





	