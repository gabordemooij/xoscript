# test qualifiers

>> $ := Objektas naujas.

$ kai: ['atsakyti:'] daryti: { :x
	
	>> operation := x simbolis: 0.
	>> valuta := x simbolis: 1.
	>> money := x poslinkis: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tiesa: {
		( valuta = ['£'] ) tiesa: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Išvestis rašyti: x, nauja-eilutė.


>> Fruit := Objektas naujas.

Fruit kai: ['naujas'] daryti: {
	>> f := pats naujas.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kai: ['apples:'] daryti: { :a savas apples := a. }.
Fruit kai: ['oranges:'] daryti: { :p savas oranges := p. }.
Fruit kai: ['apples'] daryti: { <- savas apples. }.
Fruit kai: ['oranges'] daryti: { <- savas oranges. }.

Fruit kai: ['+'] daryti: { :f
	
	>> n := Fruit naujas.
	f sudėti: 1.
	
	n apples: (f apples + savas apples).
	n oranges:  (f oranges  + savas oranges). <- n.
}.

Fruit kai: ['tekstas'] daryti: { <- ( savas apples tekstas + [' apples and '] + savas oranges + [' oranges'] ).
}.

Skaičius kai: ['apples'] daryti: { <- ((Fruit naujas) apples: pats).
}.

Skaičius kai: ['apple'] daryti: { <- ((Fruit naujas) apples: pats).
}.

Skaičius kai: ['oranges'] daryti: { <- ((Fruit naujas) oranges: pats).
}.




Išvestis rašyti: (1 apple + 3 oranges + 4 apples), nauja-eilutė.


Tekstas kai: ['twice'] daryti: { <- ((pats tekstas) + (pats tekstas)).
}.



Išvestis rašyti: ['❤❤❤'] twice.



