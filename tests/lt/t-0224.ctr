
>> countries := Sąrašas naujas
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Sąrašas naujas
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods pagal: countries, kiekvienas: { :key :value
	counter sudėti: 1.
}.

Išvestis rašyti: (['we serve counter dishes'] counter: counter), nauja-eilutė.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] simboliai rūšiuoti: { :v
	counter sudėti: 0.
}.

Išvestis rašyti: (['we sort counter dishes'] counter: counter), nauja-eilutė.


>> counter := 0.
{
	{
		counter sudėti: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Išvestis rašyti: (['we calculate counter numbers.'] counter: counter), nauja-eilutė.

