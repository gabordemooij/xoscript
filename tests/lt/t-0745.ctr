Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :dict
	savas dict := dict. 
}.

a kai: ['item'] daryti: { <- savas dict.
}.

a item: (
Žodynas naujas
	hello: ['world']).

>> old-dict-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.

>> b := Objektas load-from: ['/tmp/a.bin'].

(b item prototipas atminties-adresas = old-dict-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.

Išvestis rašyti: b item, nauja-eilutė.
