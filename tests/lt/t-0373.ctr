# compliance test

# use international numbers

Išvestis rašyti: ['1000 -> '].
Išvestis rašyti: 1000, nauja-eilutė. #1000

Išvestis rašyti: ['1.5 -> '].
Išvestis rašyti: 1.5, nauja-eilutė.  #1.5

Išvestis rašyti: ['1001.5 -> '].
Išvestis rašyti: 1.5 + 1000, nauja-eilutė. #1001.5

# use 0-indexed arrays
>> x := Sąrašas naujas ; 1 ; 2 ; 3.
>> y := Sąrašas naujas ; ['a'] ; ['b'] ; ['c'].

Išvestis rašyti: ['1 -> '].
Išvestis rašyti: x ? 0, nauja-eilutė. #1

Išvestis rašyti: ['1 -> '].
Išvestis rašyti: (x vietoje: 0), nauja-eilutė. #1

Išvestis rašyti: ['1 -> '].
Išvestis rašyti: x pirmas, nauja-eilutė. #1

Išvestis rašyti: ['3 -> '].
Išvestis rašyti: x paskutinis, nauja-eilutė. #3

Išvestis rašyti: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Išvestis rašyti: (x pagal: y), nauja-eilutė.

Išvestis rašyti: ['1 -> '].
Išvestis rašyti: (x nuo: 0 ilgis: 1) pirmas, nauja-eilutė. #1

Išvestis rašyti: ['0 -> '].
Išvestis rašyti: (x rasti: 1), nauja-eilutė. #0

x įdėti: 9 į: 0.

Išvestis rašyti: ['9 -> '].
Išvestis rašyti: (x vietoje: 0), nauja-eilutė. #9

x pridėti-pradžioje: 8.
Išvestis rašyti: ['8 -> '].
Išvestis rašyti: (x vietoje: 0), nauja-eilutė. #9


x pridėti: 10.
Išvestis rašyti: ['10 -> '].
Išvestis rašyti: (x vietoje: 4), nauja-eilutė. #10








