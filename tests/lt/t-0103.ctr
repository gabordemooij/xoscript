>> a := Sąrašas ← Objektas ; Tiesa ; Netiesa ; Loginis ; 1 ; Skaičius ; ['Str'] ; Tekstas ; { ['Empty']. }.
Išvestis rašyti: (a kiekis), nauja-eilutė.
{ :i
	Išvestis rašyti: 
	['a '] + 
	((a ? i) tipas) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Niekas?) arba: [''] arba: ['NOT']) + 
	[' Nil.'],
	nauja-eilutė.
} × (a kiekis).
Išvestis rašyti: ['but.. Nil is.. '] + ((Niekas Niekas?) arba: ['certainly NIL!'] arba: ['not NIL??']), nauja-eilutė.