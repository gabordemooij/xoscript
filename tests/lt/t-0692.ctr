Server init.

Išvestis rašyti: (
	Šablonas naujas: ['^\\w+$'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 0 match, fails on @ and .

Išvestis rašyti: (
	Šablonas naujas: ['^[^@]+@[^\.]+\.\\w+$'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match

Išvestis rašyti: (
	Šablonas naujas: ['[^@]+@[^\.]+\.\\w+'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match

Išvestis rašyti: (
	Šablonas naujas: ['([^@]+)@([^\.]+)\.\\w+'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match, groups dont matter

Išvestis rašyti: (
	Šablonas naujas: ['[a-z]'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 14 matches

Išvestis rašyti: (
	Šablonas naujas: ['.*'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match (all)

Išvestis rašyti: (
	Šablonas naujas: ['(.*)'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match (all)

Išvestis rašyti: (
	Šablonas naujas: ['\\s*[^@]+@[^\.]+\.\\w+'],
	atitikmuo: ['test@example.com'] 
), nauja-eilutė. # 1 match, prefix space optional, gets ignored