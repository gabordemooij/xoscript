>> z := Objektas naujas.
z kai: ['value:'] daryti: { :v
	savas value := v. <- pats.
}.
z kai: ['value'] daryti: { <- savas value. }.
(z setValue: 1) value: 2.
Išvestis rašyti: z value.
>> x := z.
Išvestis rašyti: x value.
z := Niekas.
Išvestis rašyti: z value.
Išvestis rašyti: x value.
Išvestis rašyti: ['hello'].
Išvestis rašyti: 3 + 2.
Išvestis rašyti: (3 > 2).
