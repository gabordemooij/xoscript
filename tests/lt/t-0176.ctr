

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

>> txt := ['Word Salad'].
Išvestis rašyti: ['Text Length: '] + txt ilgis, nauja-eilutė.
Išvestis rašyti: ['Character at 2:'] + ( txt simbolis: 2 ), nauja-eilutė.
Išvestis rašyti: (( txt rasti: ['S'] ) - 0), nauja-eilutė.

Programa išvalyti.

usedMemory1 := (Programa atmintis ? 0).


txt := ['Word Salad'].
Išvestis rašyti: ['Text Length: '] + txt ilgis, nauja-eilutė.
Išvestis rašyti: ['Character at 2:'] + ( txt simbolis: 2 ), nauja-eilutė.
Išvestis rašyti: (( txt rasti: ['S'] ) - 0), nauja-eilutė.

Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


txt := ['Word Salad'].
Išvestis rašyti: ['Text Length: '] + txt ilgis, nauja-eilutė.
Išvestis rašyti: ['Character at 2:'] + ( txt simbolis: 2 ), nauja-eilutė.
Išvestis rašyti: (( txt rasti: ['S'] ) - 0), nauja-eilutė.

Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
