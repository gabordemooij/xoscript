
{ :i
	Išvestis rašyti: ['This is step #'] + ( ( i ) + 1 ), nauja-eilutė.
} × 6.

{ :i
	Išvestis rašyti: ['This is step #'] + ( 3 - ( i ) ), nauja-eilutė.
} × 6.

{ :i
	Išvestis rašyti: ['NEVER!'], nauja-eilutė.
} × 0.



{ :i
	Išvestis rašyti: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), nauja-eilutė.
} × 11.
