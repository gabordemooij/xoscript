Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :moment
	savas moment := moment. 
}.

a kai: ['item'] daryti: { <- savas moment.
}.

>> today := Sąrašas naujas ; ( Momentas naujas zona: ['CEST'], metai: 2026, mėnesis: 7 ).
a item: today.
Išvestis rašyti: a item ? 0, nauja-eilutė.
a save-as: ['/tmp/a.bin'].
