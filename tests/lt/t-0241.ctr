

Tekstas kai: ['evaluate'] daryti: {
	>> kodas := Failas naujas: ['/tmp/eval.ctr'].
	kodas rašyti: (pats tekstas + ['.']).
	Programa naudoti: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Sąrašas ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tekstas.
Išvestis rašyti: x, nauja-eilutė.
>> y := Niekas.
(['y := '] + x ) evaluate.
Išvestis rašyti: y ? 0, nauja-eilutė.

q := Žodynas įdėti: ['\[''] į: ['\['quote\']'].
x := q tekstas.
Išvestis rašyti: x, nauja-eilutė.
y := Niekas.
(['y := '] + x ) evaluate.

>> q := (Žodynas naujas) įdėti:['\[''] į:['\['quote\[''].
Išvestis rašyti: y ? ['\['quote\']'], nauja-eilutė.
