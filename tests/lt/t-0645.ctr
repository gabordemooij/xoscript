Server init.
Išvestis rašyti: ['Database date test'], nauja-eilutė.

>> db := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'], 
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.

>> paieškos-parametrai :=
db užklausa: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
gauti: { :row
	Išvestis rašyti: row datetest, nauja-eilutė.
}.
