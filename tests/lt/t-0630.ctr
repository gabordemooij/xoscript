#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Šablonas naujas: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern atitikmuo: subject daryti: { :m :x
	Išvestis rašyti: m, nauja-eilutė.
	Išvestis rašyti: x, nauja-eilutė. <- ['XXX'].
}.
Išvestis rašyti: result, nauja-eilutė.