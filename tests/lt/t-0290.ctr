# test list operations


>> cakes := Sąrašas ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes pakeisti: 1 ilgis: 2 su: ( Sąrašas ← ['cinnamon'] ; ['pineapple'] ).
Išvestis rašyti: (buy sujungti: [',']), nauja-eilutė.


>> buy := cakes pakeisti: 1 ilgis: 12 su: ( Sąrašas ← ['cinnamon'] ; ['pineapple'] ).
Išvestis rašyti: (buy sujungti: [',']), nauja-eilutė.


>> buy := cakes pakeisti: 2 ilgis: 10 su: ( Sąrašas naujas ).
Išvestis rašyti: (buy sujungti: [',']), nauja-eilutė.


>> buy := cakes pakeisti: 0 ilgis: 1 su: ( Sąrašas naujas ).
Išvestis rašyti: (buy sujungti: [',']), nauja-eilutė.


>> buy := cakes pakeisti: ['0'] ilgis: ['1'] su: ['x'].
Išvestis rašyti: (buy sujungti: [',']), nauja-eilutė.
