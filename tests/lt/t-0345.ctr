# test catch-all methods
>> x13 := Objektas naujas.
x13 kai: ['a'] daryti: { :a Išvestis rašyti: 0, nauja-eilutė. }.
x13 kai: ['a:'] daryti: { :a Išvestis rašyti: a, nauja-eilutė. <- 5. }.
x13 kai: ['a:b:'] daryti: { :a :b Išvestis rašyti: (a + b), nauja-eilutė. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
