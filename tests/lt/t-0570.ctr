#Linux

 >> t := Momentas naujas.
 
t zona: ['Europe/Amsterdam'].
t metai: 2020, mėnesis: 8, diena: 2, valanda: 21, minutė: 2, sekundė: 1.

>> a := t valanda.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t valanda.
>> hw := t zona.

Išvestis
rašyti: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		arba: ['later'] arba: ['earlier']
	)
),
nauja-eilutė.
 