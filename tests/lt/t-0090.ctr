Išvestis rašyti: ['1,2,3,4,5,6,7,8,9,A,'], nauja-eilutė.
>> Scope := Objektas naujas.
Scope kai: ['initialize:'] daryti: { :x savas property := x. }.
Scope kai: ['confirm'] daryti: { Išvestis rašyti: [',']. }.
Scope kai: ['testas'] daryti: {
	Išvestis rašyti: savas property.
	pats confirm.
	( 1 = 1 ) tiesa: { Išvestis rašyti: savas property. pats confirm. }.
	( 1 = 0 ) netiesa: { Išvestis rašyti: savas property. pats confirm. }.
	>> y := 2. { Išvestis rašyti: savas property. pats confirm. } kol: { y atimti: 1. <- (y > 0). }.
	{ Išvestis rašyti: savas property. pats confirm. } × 1.
	(Sąrašas ← 1) kiekvienas: {  Išvestis rašyti: savas property. pats confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Žodynas naujas one: ['item']) kiekvienas: { Išvestis rašyti: savas property. pats confirm. }.
	{ 1 ÷ 0. } pagauti: { Išvestis rašyti: savas property. pats confirm. }, paleisti.
	Išvestis nauja-eilutė.
}.
>> scope1 := Scope naujas.
scope1 initialize: ['X'].
scope1 testas.
>> function := { 
	savas property := ['Y'].
	Išvestis rašyti: savas property.
	pats confirm.
	( 1 = 1 ) tiesa: { Išvestis rašyti: savas property. pats confirm. }.
	( 1 = 0 ) netiesa: { Išvestis rašyti: savas property. pats confirm. }.
	>> y := 2. { Išvestis rašyti: savas property. pats confirm. } kol: { y atimti: 1. <- (y > 0). }.
	{ Išvestis rašyti: savas property. pats confirm. } × 1.
	(Sąrašas ← 1) kiekvienas: {  Išvestis rašyti: savas property. pats confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Žodynas naujas one: ['item']) kiekvienas: { Išvestis rašyti: savas property. pats confirm. }.
	{ 1 ÷ 0. } pagauti: { Išvestis rašyti: savas property. pats confirm. }, paleisti.
	Išvestis nauja-eilutė.
}.
