Server init.
>> fmt := Formatas naujas: ['%#3x'].

>> blob := Blob naujas: 4.
blob bytes: ( 
	Sąrašas naujas ; 0 ; 1 ; 2 ; 3
).

>> file := Failas naujas: ['/tmp/blob'].
file blob: blob.
blob atlaisvinti.

>> skaityti := file blob.
skaityti 
nuo: 0 
ilgis: 4, 
daryti kiekvienas: { :i :b 
	Išvestis
	rašyti: (fmt taikyti-sveikajam: b),
	nauja-eilutė.
}.
skaityti atlaisvinti.
