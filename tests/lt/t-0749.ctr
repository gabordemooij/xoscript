Išvestis rašyti: ['Test object'], nauja-eilutė.
>> a := Objektas naujas. 

a kai: ['item:'] daryti: { :loginis
	savas loginis := loginis. 
}.

a kai: ['item'] daryti: { <- savas loginis.
}.

a item: Netiesa.

Išvestis rašyti: a item, nauja-eilutė.

>> old-bool-address := a item prototipas atminties-adresas.
a save-as: ['/tmp/a.bin'].
Išvestis rašyti: ['========== RELOADING SNAP:'], nauja-eilutė.

>> b := Objektas load-from: ['/tmp/a.bin'].

(b item prototipas atminties-adresas = old-bool-address) tiesa: {
	Išvestis rašyti: ['Object link re-attached.'], nauja-eilutė.
}.

Išvestis rašyti: b item, nauja-eilutė.
