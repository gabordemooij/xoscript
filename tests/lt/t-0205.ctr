>> str := ['write:'].
Išvestis žinutė: ['rašyti:'] argumentai: (Sąrašas ← ['Hello World']), nauja-eilutė. 

Skaičius kai: ['isbetween:and:'] daryti: { :a :b <- ((pats ≥ a) ir: (pats ≤ b)).
}.

str := ['isbetween:and:'].
Išvestis rašyti: (3 žinutė: str argumentai: (Sąrašas ← 2 ; 8)), nauja-eilutė.
Išvestis rašyti: (3 žinutė: str argumentai: (Sąrašas ← 1 ; 2)), nauja-eilutė.


>> CoffeeMachine := Objektas naujas.
CoffeeMachine kai: ['makeCoffeeWithSugar:milk:'] daryti: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Sąrašas ← 4 ; 2.
Išvestis rašyti: ( CoffeeMachine žinutė: order argumentai: coffeeConfiguration ), nauja-eilutė.
