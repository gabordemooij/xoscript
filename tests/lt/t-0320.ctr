


>> CoffeeMachine := Objektas naujas.
CoffeeMachine kai: ['order:'] daryti: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tiesa: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tiesa: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tiesa: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objektas naujas.
SimpleCoffeeMachine kai: ['order'] daryti: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Išvestis rašyti: redCup, nauja-eilutė.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Išvestis rašyti: greenCup, nauja-eilutė.
>> yellowCup := CoffeeMachine order: 1.
Išvestis rašyti: yellowCup, nauja-eilutė.
>> blueCup := CoffeeMachine order: 0.
Išvestis rašyti: blueCup, nauja-eilutė.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Išvestis rašyti: blackCup, nauja-eilutė.
blackCup pridėti: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Išvestis rašyti: orangeCup, nauja-eilutė.
