
>> Greeter := Objektas naujas.
Greeter kai: ['naujas'] daryti: {
	savas pavadinimas := ['?'].
}.
Greeter kai: ['name:'] daryti: { :pavadinimas
	savas pavadinimas := pavadinimas.
}.
Greeter kai: ['greet'] daryti: {
	Išvestis rašyti: (['hello[you]'] [you]: savas pavadinimas).
}.
>> friend := Greeter naujas.
friend name: ['1'].
friend greet.
