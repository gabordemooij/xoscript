
Server init.
>> rq := HTTP-Užklausa naujas.
Išvestis rašyti: ['HTTP-GET d[]=']  + ( rq get-sąrašas: ['d[]'] ), nauja-eilutė. # GET
Išvestis rašyti: ['HTTP-GET f[]=']  + ( rq get-sąrašas: ['f[]'] ), nauja-eilutė. # GET
Išvestis rašyti: ['HTTP-POST e[]='] + ( rq post-sąrašas: ['e[]'] ), nauja-eilutė. # GET
Išvestis rašyti: ['HTTP-POST c=']   + ( rq post: ['c'] ), nauja-eilutė. # GET
Išvestis rašyti: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nauja-eilutė. # GET
