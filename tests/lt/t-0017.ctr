Skaičius kai: ['factorial'] daryti: {
	>> total := 1.
	{ :index total padauginti-iš: (pats - (index)). } × pats. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Išvestis rašyti: a.
>> b := 2 + 3 factorial.
Išvestis rašyti: b.
>> c := 3 factorial + 2.
Išvestis rašyti: c.
>> d := 2 + (3 factorial).
Išvestis rašyti: d.
Išvestis rašyti: 2 + 3 factorial + 1.
