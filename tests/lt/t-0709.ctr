# Can we use UTF8 in regex?
Server init.
>> p := Šablonas naujas: ['\\w'].
Išvestis rašyti: ( p atitikmuo: ['x'] ), nauja-eilutė.
Išvestis rašyti: ( p atitikmuo: ['é'] ), nauja-eilutė.
>> p := Šablonas naujas: ['(*UTF)(*UCP)\\w'].
Išvestis rašyti: ( p atitikmuo: ['é'] ), nauja-eilutė.
# should give 101