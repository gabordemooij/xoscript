# test buffers PKI/Sign 
Server init.

>> long := ( Sąrašas naujas užpildyti: 1000 su: ['a'] ) sujungti: [''].

# sign a message
Išvestis rašyti: ( 
	Seifas pasirašyti: ['abc'] raktu: long
), nauja-eilutė.

Išvestis rašyti: ( 
	Seifas
		patikrinti: ['abc'] 
		parašas: long 
		raktu: long
), nauja-eilutė.

Išvestis rašyti: (
	Seifas slaptažodžio-maiša: long patikrinti: long
), nauja-eilutė.
