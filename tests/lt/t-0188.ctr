

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa atminties-valdymas: 0.

{ :i Išvestis rašyti: i. } × 4.
Išvestis nauja-eilutė.
{ :i Išvestis rašyti: (4 - i). } × 4.
Išvestis nauja-eilutė.
( 1 > 2 ) netiesa: { Išvestis rašyti: ['BLOCK 1'], nauja-eilutė. }.
( 2 > 1 ) tiesa:  { Išvestis rašyti: ['BLOCK 2'], nauja-eilutė. }.

>> i := 0.
{ Išvestis rašyti: i. i sudėti: 1. } kol: { <- ( i < 3). }.
Išvestis nauja-eilutė.

i := 3.
{ Išvestis rašyti: i. i := i - 1. } kol: { <- ( i > 0). }.
Išvestis nauja-eilutė.


Programa išvalyti.

usedMemory1 := (Programa atmintis ? 0).


{ :i  Išvestis rašyti: i. } × 4.
Išvestis nauja-eilutė.
{ :i  Išvestis rašyti: (4 - i). } × 4.
Išvestis nauja-eilutė.
( 1 > 2 ) netiesa: { Išvestis rašyti: ['BLOCK 1'], nauja-eilutė. }.
( 2 > 1 ) tiesa:  { Išvestis rašyti: ['BLOCK 2'], nauja-eilutė. }.

>> i := 0.
{ Išvestis rašyti: i. i sudėti: 1. } kol: { <- ( i < 3). }.
Išvestis nauja-eilutė.

i := 3.
{ Išvestis rašyti: i. i := i - 1. } kol: { <- ( i > 0). }.
Išvestis nauja-eilutė.



Programa išvalyti.
usedMemory2 := (Programa atmintis ? 0).


{ :i Išvestis rašyti: i. } × 4.
Išvestis nauja-eilutė.
{ :i Išvestis rašyti: (4 - i). } × 4.
Išvestis nauja-eilutė.
( 1 > 2 ) netiesa: { Išvestis rašyti: ['BLOCK 1'], nauja-eilutė. }.
( 2 > 1 ) tiesa:  { Išvestis rašyti: ['BLOCK 2'], nauja-eilutė. }.

>> i := 0.
{ Išvestis rašyti: i. i sudėti: 1. } kol: { <- ( i < 3). }.
Išvestis nauja-eilutė.

i := 3.
{ Išvestis rašyti: i. i := i - 1. } kol: { <- ( i > 0). }.
Išvestis nauja-eilutė.

Programa išvalyti.
usedMemory3 := (Programa atmintis ? 0).



( usedMemory1 = usedMemory2 ir: usedMemory1 = usedMemory3, ir: usedMemory2 = usedMemory3 ) tiesa: {
	Išvestis rašyti: ['No memory leaks here'].
}, netiesa: {
	Išvestis rašyti: ['Leaking memory...'].
}.
