
Programa atminties-valdymas: 4.

>> Animal := Objektas naujas.
Animal kai: ['make'] daryti: {
	>> animal := Objektas naujas.
	animal kai: ['makeSound'] daryti: {
		Išvestis rašyti: savas sound.
	}. <- animal.
}.
>> Cat := Objektas naujas.
Cat kai: ['make'] daryti: {
	>> cat := Animal make.
	cat kai: ['init'] daryti: {
		savas sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
