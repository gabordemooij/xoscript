Server init.

>> DB := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'],
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB užklausa: SQL.

# now you don't have to set DB
query2 gauti: { :row
	Išvestis rašyti: row world, nauja-eilutė.
}.
