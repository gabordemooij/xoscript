# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob naujas: 8, bytes: (
	Sąrašas naujas ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Išvestis rašyti: ( utf16 dekoduoti: ['utf16le'] ), nauja-eilutė.

utf16 atlaisvinti.
>> utf32 := Blob naujas: 13, bytes: (
	Sąrašas naujas ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Išvestis rašyti: ( utf32 dekoduoti: ['utf32be'] ), nauja-eilutė.
utf32 atlaisvinti.