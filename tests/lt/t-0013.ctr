
>> Animal := Objektas naujas.
Animal kai: ['naujas'] daryti: { <- pats naujas init.
}.

Animal kai: ['init'] daryti: {
	savas sound := ['?'].
	savas legs := 4.
}.

>> Dog := Animal naujas.
Dog kai: ['init'] daryti: {
	pats init.
	savas sound := ['barks'].
}.

Animal kai: ['tekstas'] daryti: { <- savas legs tekstas + savas sound.
}.

>> poodle := Dog naujas.
Išvestis rašyti: poodle, nauja-eilutė.

