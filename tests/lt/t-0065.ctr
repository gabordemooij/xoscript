Skaičius kai: ['factorial'] daryti: {
	>> total := 1.
	{ :index total padauginti-iš: (pats - (index)). } × pats. <- total.
}.
>> Printer := Objektas naujas.
Printer kai: ['print:and:'] daryti: { :x :y
	Išvestis rašyti: ['a='] + x + [', b='] + y, nauja-eilutė.
}.
>> a := 4.5. >> b := a apvalinti-žemyn.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a apvalinti-aukštyn.
Printer print: a and: b.
a := 4.5. b := a apvalinti-žemyn.
Printer print: a and: b.
a := 4.5. b := a apvalinti.
Printer print: a and: b.
a := 4.2. b := a apvalinti.
Printer print: a and: b.

Išvestis rašyti: (9 liekana: 5), nauja-eilutė.
