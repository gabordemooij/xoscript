Server init.

>> DB := Maria-DB naujas mazgas: ['localhost'],
	naudotojas: ['xo'],
	slaptažodis: ['pass123'],
	duomenų-bazės-vardas: ['xobase'],
	prisijungti.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paieškos-parametrai := Maria-Užklausa naujas: SQL.

# set database
paieškos-parametrai duomenų-bazė: DB.

paieškos-parametrai gauti: { :row
	Išvestis rašyti: row world, nauja-eilutė.
}.
