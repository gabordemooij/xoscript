>> map1 := Žodynas naujas.
>> key1 := Sąrašas naujas.
>> key2 := Sąrašas naujas.

map1
	įdėti: ['hello'] į: key1,
	įdėti: ['world'] į: key2.


Išvestis
	rašyti: ['Map #1 contains: '] + (map1 vietoje: key1),
	rašyti: [' and '] + (map1 vietoje: key2), nauja-eilutė.

>> KeyeableArray := Sąrašas naujas.
KeyeableArray kai: ['toString'] daryti: { <- (pats kiekis) toString.
}.

>> map2 := Žodynas naujas.
key1 := KeyeableArray naujas.
key2 := KeyeableArray naujas.

key1 pridėti: 1.

map2
	įdėti: ['hello'] į: key1,
	įdėti: ['world'] į: key2.

Išvestis
	rašyti: ['Map #2 contains: '] + (map2 vietoje: key1),
	rašyti: [' and '] + (map2 vietoje: key2), nauja-eilutė.
