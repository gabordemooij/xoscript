
{ :i
	Às-chur sgrìobh: ['This is step #'] + ( ( i ) + 1 ), loidhne-ùr.
} × 6.

{ :i
	Às-chur sgrìobh: ['This is step #'] + ( 3 - ( i ) ), loidhne-ùr.
} × 6.

{ :i
	Às-chur sgrìobh: ['NEVER!'], loidhne-ùr.
} × 0.



{ :i
	Às-chur sgrìobh: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), loidhne-ùr.
} × 11.
