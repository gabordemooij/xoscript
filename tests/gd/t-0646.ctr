Server init.
Às-chur sgrìobh: ['Database datetime test'], loidhne-ùr.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'], 
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg :=
db ceist: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
faigh: { :row
	Às-chur sgrìobh: row datetimetest, loidhne-ùr.
}.
