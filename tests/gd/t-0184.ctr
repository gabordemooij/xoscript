

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

Àireamh air: ['addNum:'] dèan: { :x
	fhèin cuir-ris-àireamh: x.
}.

Àireamh air: ['subtractNum:'] dèan: { :x
	fhèin thoir-air-falbh: x.
}.

Àireamh air: ['multiplyBy:'] dèan: { :x
	fhèin iomadaich-le: x.
}.

Àireamh air: ['divideBy:'] dèan: { :x
	fhèin roinn-le: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhachd: 8).  
a := a + (2 cumhachd: -1). 
a := a + (49 freumh-ceàrnagach).   
a addNum: ((Liosta ← 0 ; 1) as-àirde).          
a addNum: ((Liosta ← 2 ; 3) as-ìsle).
Às-chur sgrìobh: a.

Prògram sgioblaich.

usedMemory1 := (Prògram cuimhne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhachd: 8).  
a := a + (2 cumhachd: -1). 
a := a + (49 freumh-ceàrnagach).   
a addNum: ((Liosta ← 0 ; 1) as-àirde).          
a addNum: ((Liosta ← 2 ; 3) as-ìsle).
Às-chur sgrìobh: a.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhachd: 8).  
a := a + (2 cumhachd: -1). 
a := a + (49 freumh-ceàrnagach).   
a addNum: ((Liosta ← 0 ; 1) as-àirde).          
a addNum: ((Liosta ← 2 ; 3) as-ìsle).
Às-chur sgrìobh: a.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
