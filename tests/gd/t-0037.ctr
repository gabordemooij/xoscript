>> a := 3.
>> b := a dèan-lethbhreac.
a thoir-air-falbh: 1.
Às-chur sgrìobh: [' a = '] + a.
Às-chur sgrìobh: [' b = '] + b.
a := 3.
b := a + 4.
Às-chur sgrìobh: [' a = '] + a.
Às-chur sgrìobh: [' b = '] + b.
>> x := 3.
>> y := x dèan-lethbhreac.
x cuir-ris-àireamh: 10.
y thoir-air-falbh: 1.
Às-chur sgrìobh: [' x = '] + x.
Às-chur sgrìobh: [' y = '] + y.
>> q := Oibseact ùr.
q air: ['setProperty:'] dèan: { :x
	leis prop := x.
}.
q air: ['getProperty'] dèan: { <- leis prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Às-chur sgrìobh: [' p = '] + (p getProperty).
