Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :hexhelper
	leis hexhelper := hexhelper. 
}.

a air: ['item'] dèan: { <- leis hexhelper.
}.

a item: Hx ùr.

>> old-hexhelper-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-hexhelper-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
