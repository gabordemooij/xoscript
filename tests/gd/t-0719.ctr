Server init.
>> fmt := Fòrmat ùr: ['%#3x'].

>> blob := Blob ùr: 4.
blob bytes: ( 
	Liosta ùr ; 0 ; 1 ; 2 ; 3
).

>> file := Faidhle ùr: ['/tmp/blob'].
file blob: blob.
blob saor.

>> leugh := file blob.
leugh 
bho: 0 
faid: 4, 
dèan gach: { :i :b 
	Às-chur
	sgrìobh: (fmt cuir-an-gnìomh-slàn-àireamh: b),
	loidhne-ùr.
}.
leugh saor.
