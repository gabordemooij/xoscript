#Linux
>> Slurp := Oibseact ùr.

Slurp air: ['ùr'] dèan: {
	leis str := [''].
}.

Slurp air: ['nieuw'] dèan: {
	leis str := [''].
}.

Slurp air: ['freagair:'] dèan: { :blah
		leis str cuir-ris: blah.
}.

Slurp air: ['freagair:agus:'] dèan: { :blah :blahah
		leis str cuir-ris: (blah bho: 0 faid: (blah faid - 1)).
		leis str cuir-ris: [' '].
		leis str cuir-ris: blahah.
}.

Slurp air: ['obtain'] dèan: {
	>> buffer := leis str.
	leis str := ['']. <- buffer.
}.


Às-chur sgrìobh: (Prògram siostam: (Slurp ùr echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faidhle ùr: ['/tmp/from.txt'], cuir-às. } glac: { ['Empty']. }, tòisich.
{ Faidhle ùr: ['/tmp/to.txt'], cuir-às. } glac: { ['Empty']. }, tòisich.


Faidhle ùr: ['/tmp/to.txt'], ann breugach: {
	Às-chur sgrìobh: ['Confirmed. Target file does not exist.\
'].
}.
Faidhle ùr: ['/tmp/from.txt'], ann breugach: {
	Às-chur sgrìobh: ['Confirmed. Source file does not exist.\
'].
}.



Prògram siostam: (Slurp ùr touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Prògram siostam: (Slurp ùr cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faidhle ùr: ['/tmp/to.txt'], ann fìor: {
	Às-chur sgrìobh: ['Confirmed. Target file has been created by shell.\
'].
}.


Às-chur sgrìobh: ['Contents of file is:'] + (Faidhle ùr: ['/tmp/to.txt'], leugh), loidhne-ùr.
