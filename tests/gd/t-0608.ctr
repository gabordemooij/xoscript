
>> Size := Oibseact ùr.
Size air: ['is:'] dèan: { :àireamh
	àireamh air: ['+'] dèan: { :àireamh
		>> unit := àireamh comharrachadh.
		>> factor := 1.
		
		unit
		cùis: ['inch'] dèan: { factor := 0.0833. }. <- fhèin + (àireamh * factor).
	}. <- àireamh.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Às-chur sgrìobh: plank + edge, loidhne-ùr.
