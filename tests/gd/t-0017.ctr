Àireamh air: ['factorial'] dèan: {
	>> total := 1.
	{ :index total iomadaich-le: (fhèin - (index)). } × fhèin. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Às-chur sgrìobh: a.
>> b := 2 + 3 factorial.
Às-chur sgrìobh: b.
>> c := 3 factorial + 2.
Às-chur sgrìobh: c.
>> d := 2 + (3 factorial).
Às-chur sgrìobh: d.
Às-chur sgrìobh: 2 + 3 factorial + 1.
