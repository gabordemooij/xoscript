Server init.

>> DB := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paramadairean-luirg := Maria-Ceist ùr: SQL.

# set database
paramadairean-luirg stòr-dàta: DB.

paramadairean-luirg faigh: { :row
	Às-chur sgrìobh: row world, loidhne-ùr.
}.
