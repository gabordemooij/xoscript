>> z := Oibseact ùr.
z air: ['value:'] dèan: { :v
	leis value := v. <- fhèin.
}.
z air: ['value'] dèan: { <- leis value. }.
(z setValue: 1) value: 2.
Às-chur sgrìobh: z value.
>> x := z.
Às-chur sgrìobh: x value.
z := Neoni.
Às-chur sgrìobh: z value.
Às-chur sgrìobh: x value.
Às-chur sgrìobh: ['hello'].
Às-chur sgrìobh: 3 + 2.
Às-chur sgrìobh: (3 > 2).
