

Liosta air: ['column:'] dèan: { :column
	>> result := Liosta ùr.
	fhèin gach: { :index :row
		row gach: { :index :cell
			(index = column) fìor: { result cuir-ris: cell. }.
		}.
	}. <- result.
}.


>> a := Liosta ←
	(Liosta ← 1 ; 2 ; 3) ;
	(Liosta ← 4 ; 5 ; 6) ;
	(Liosta ← 7 ; 8 ; 9).

>> b := a column: 1.
Às-chur sgrìobh: b, loidhne-ùr.

b := a column: 20.
Às-chur sgrìobh: b, loidhne-ùr.

b := a column: -100.
Às-chur sgrìobh: b, loidhne-ùr.
