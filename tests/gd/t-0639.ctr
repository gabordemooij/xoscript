
Server init.
Às-chur sgrìobh: ['Database test'], loidhne-ùr.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'], 
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg :=
db ceist: ['SELECT REPEAT('Blah',1000) AS blah'], 
faigh: { :row 
	Às-chur sgrìobh: row blah faid, loidhne-ùr.
}.
