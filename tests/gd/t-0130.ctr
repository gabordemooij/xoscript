# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Prògram suidheachadh: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server ceangal: ( Liosta ùr ;
 libname ; ['fopen'] ;
 ( Liosta ùr ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
ceangal: ( Liosta ùr ;
 Neoni ; # means same lib
 ['fread'] ;
 ( Liosta ùr ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neoni ; # means same object (i.e. Stream)
 ['fread']
),
ceangal: (
 Liosta ùr ;
 Neoni ; # means same lib
 ['fwrite'] ;
 ( Liosta ùr ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neoni ; # means same lib
 ['fwrite']
),
ceangal: (
 Liosta ùr ;
 Neoni ; # means same lib
 ['rewind'] ;
 ( Liosta ùr ; ['pointer'] ) ;
 ['int'] ;
 Neoni ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> slighe := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: slighe mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream teachdaireachd: ['fwrite'] argamaidean: (Liosta ùr ; str ; 1 ; 6 ; fd ).
Às-chur sgrìobh: bytes-written, loidhne-ùr.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ùr: 20.

# read from file
>> bytes-read := Stream teachdaireachd: ['fread'] argamaidean: (Liosta ùr ; buf ; 1 ; 6 ; fd ).
Às-chur sgrìobh: bytes-read, loidhne-ùr.
Às-chur sgrìobh: buf, loidhne-ùr.

# free memory
str  saor.
slighe saor.
mode saor.
buf  saor.


