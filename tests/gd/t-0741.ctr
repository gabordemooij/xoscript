Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :octhelper
	leis octhelper := octhelper. 
}.

a air: ['item'] dèan: { <- leis octhelper.
}.

a item: Oct ùr.

>> old-octhelper-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-octhelper-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
