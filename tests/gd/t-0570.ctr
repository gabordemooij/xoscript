#Linux

 >> t := Àm ùr.
 
t sòn: ['Europe/Amsterdam'].
t bliadhna: 2020, mìos: 8, latha: 2, uair: 21, mionaid: 2, diog: 1.

>> a := t uair.
>> ams := t sòn.

t sòn: ['US/Hawaii'].
>> b := t uair.
>> hw := t sòn.

Às-chur
sgrìobh: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		an-dàrna-cuid: ['later'] no: ['earlier']
	)
),
loidhne-ùr.
 