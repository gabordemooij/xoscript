Prògram stiùireadh-cuimhne: 4.

>> Doubler := Oibseact ùr.
>> Multiplier := Oibseact ùr.
Doubler air: ['double:and:'] dèan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier air: ['multiply:and:'] dèan: { :x :y <- (x × y).
}.

Às-chur sgrìobh: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), loidhne-ùr.
