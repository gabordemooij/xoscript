
Liosta air: ['product'] dèan: {
	>> total := 1.
	fhèin gach: { :index :element
		total iomadaich-le: element.
	}. <- total.
}.

>> a := Liosta ← 1 ; 2 ; 3.
Às-chur sgrìobh: a product, loidhne-ùr.
Às-chur sgrìobh: (Liosta ← 2 ; 4 ; 8) product, loidhne-ùr. 
Às-chur sgrìobh: (Liosta ← -2 ; 10) product, loidhne-ùr. 
Às-chur sgrìobh: (Liosta ← 0.5 ; -2) product, loidhne-ùr. 
