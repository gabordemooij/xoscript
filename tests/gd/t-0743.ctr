>> V := Oibseact.
V air: ['sreang'] dèan: {
	Às-chur sgrìobh: ['cast'], loidhne-ùr. <- ['abc'].
}.

Às-chur sgrìobh: ( Prògram suidheachadh: ['abc'] ), loidhne-ùr.

# params should not get gc'ed
Prògram suidheachadh: ([''] + V ùr) luach: ([''] + V ùr).

Às-chur sgrìobh: ( Prògram suidheachadh: ['abc'] ), loidhne-ùr.
