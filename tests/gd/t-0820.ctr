# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pàtran ùr: pattern.
	p maids: subject dèan: { :m :g
		Às-chur sgrìobh: g cunnt, sgrìobh: [' '], sgrìobh: (g ceangail: ['|']), loidhne-ùr. <- m.
	}.
}.
show cuir-an-gnìomh: ['(a)|(b)'] agus: ['b'].
show cuir-an-gnìomh: ['(a)|(b)'] agus: ['a'].
show cuir-an-gnìomh: ['(x)?y'] agus: ['y'].
show cuir-an-gnìomh: ['(x)?(y)(z)?'] agus: ['xy'].
