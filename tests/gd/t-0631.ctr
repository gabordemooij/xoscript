#ffi test


Server init.

Prògram stiùireadh-cuimhne: 4.

# for this test you need set a path to libc (puts)
>> libname := Prògram suidheachadh: ['FFITESTLIB'].



Server ceangal: (
 Liosta ùr ;
 libname ;
 ['puts'] ;
 ( Liosta ùr ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s saor.

# test with struct

>> a := Blob ùr: 8.
a bytes: (
	Liosta <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liosta <<: ['int'], ; ['int']).

Server ceangal: (
	Liosta <<: ['@structtest'], ;
	['@structtest'] ;
	(Liosta <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Às-chur sgrìobh: ['Sum test:'] + (ffitest ffisum: a), loidhne-ùr.

struct saor-struct.
struct saor.
a saor.
