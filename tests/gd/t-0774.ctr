Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 
a air: ['item:'] dèan: { :lst
	leis lst := lst. 
}.
a air: ['item'] dèan: { <- leis lst.
}.
a item: (
	Liosta ùr ; 1 ; (
		Liosta ùr ; ['a'] ; (
			Liosta ùr ; ( Àm ùr: 1 )
		) ; ( Int64 bho-shreang: ['321'] )
	)
).
Às-chur sgrìobh: a item, loidhne-ùr.
>> old-lst-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
(b item prìomh-shamhla seòladh-cuimhne = old-lst-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
Às-chur sgrìobh: ( b item ), loidhne-ùr.
