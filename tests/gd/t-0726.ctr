# test buffers PKI/Sign 
Server init.

>> long := ( Liosta ùr lìon: 1000 le: ['a'] ) ceangail: [''].

# sign a message
Às-chur sgrìobh: ( 
	Tasgaidh soidhnich: ['abc'] le: long
), loidhne-ùr.

Às-chur sgrìobh: ( 
	Tasgaidh
		dearbh: ['abc'] 
		soidhneadh: long 
		le: long
), loidhne-ùr.

Às-chur sgrìobh: (
	Tasgaidh hais-facail-faire: long dearbh: long
), loidhne-ùr.
