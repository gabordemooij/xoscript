# test list operations


>> cakes := Liosta ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes cuir-an-àite: 1 faid: 2 le: ( Liosta ← ['cinnamon'] ; ['pineapple'] ).
Às-chur sgrìobh: (buy ceangail: [',']), loidhne-ùr.


>> buy := cakes cuir-an-àite: 1 faid: 12 le: ( Liosta ← ['cinnamon'] ; ['pineapple'] ).
Às-chur sgrìobh: (buy ceangail: [',']), loidhne-ùr.


>> buy := cakes cuir-an-àite: 2 faid: 10 le: ( Liosta ùr ).
Às-chur sgrìobh: (buy ceangail: [',']), loidhne-ùr.


>> buy := cakes cuir-an-àite: 0 faid: 1 le: ( Liosta ùr ).
Às-chur sgrìobh: (buy ceangail: [',']), loidhne-ùr.


>> buy := cakes cuir-an-àite: ['0'] faid: ['1'] le: ['x'].
Às-chur sgrìobh: (buy ceangail: [',']), loidhne-ùr.
