>> makeAdder := { :x
	>> f := { :y <- (leis x + y). } suidhich: ['x'] luach: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i leis q cuir: (leis f cuir-an-gnìomh: (leis q ? i)) aig: i. } 
	suidhich: ['q'] luach: array,
	suidhich: ['f'] luach: func.
	{ :i mapping cuir-an-gnìomh: i. } × (array cunnt).
}.

>> a := Liosta ← 1; 2; 3.
mapper cuir-an-gnìomh: a agus: (makeAdder cuir-an-gnìomh: 100).
Às-chur sgrìobh: (a àite: 0), loidhne-ùr.
Às-chur sgrìobh: (a ? 1), loidhne-ùr.
Às-chur sgrìobh: (a ? 2), loidhne-ùr.
