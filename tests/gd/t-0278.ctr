>> To-Do := Oibseact ùr.

To-Do air: ['ùr'] dèan: {
	leis list := Liosta ùr.
}.

To-Do air: ['nieuw'] dèan: {
	leis list := Liosta ùr.
}.

To-Do air: ['+'] dèan: { :task
	leis list cuir-ris: task.
}.

To-Do air: ['number of tasks?'] dèan: { <-  leis list cunnt.
}.

>> todos := 
	To-Do ùr 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Às-chur sgrìobh: ['You have $ tasks to do'] $ todos number of tasks?.
