
Àireamh ionnsaich: ['plus:'] ciallachadh: ['+'].
Àireamh air: ['+'] dèan: { :x
	>> rate := 1.
	>> currency := x comharrachadh.
	(currency = ['euros']) fìor: {
		rate := 2.
	}. <- (fhèin plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars comharraich: ['dollars'].
euros comharraich: ['euros'].
>> money := dollars + euros.
Às-chur sgrìobh: money, loidhne-ùr.
