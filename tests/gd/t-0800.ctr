Server init.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg := db ceist: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paramadairean: ( Liosta ùr ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  paramadairean-luirg ruith-àithne. db dearbhaich. } glac: { :e db till-air-ais.  }, tòisich.

Às-chur sgrìobh: ['Can we insert? '] + ( paramadairean-luirg insert-id > 0 ), loidhne-ùr.
