Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['state:'] dèan: { :list
	leis list := list. 
}.

a air: ['state'] dèan: {
	Às-chur sgrìobh: leis list, loidhne-ùr.
}.

a state: ( Liosta ùr ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
b state.