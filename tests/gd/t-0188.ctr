

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

{ :i Às-chur sgrìobh: i. } × 4.
Às-chur loidhne-ùr.
{ :i Às-chur sgrìobh: (4 - i). } × 4.
Às-chur loidhne-ùr.
( 1 > 2 ) breugach: { Às-chur sgrìobh: ['BLOCK 1'], loidhne-ùr. }.
( 2 > 1 ) fìor:  { Às-chur sgrìobh: ['BLOCK 2'], loidhne-ùr. }.

>> i := 0.
{ Às-chur sgrìobh: i. i cuir-ris-àireamh: 1. } fhad-sa: { <- ( i < 3). }.
Às-chur loidhne-ùr.

i := 3.
{ Às-chur sgrìobh: i. i := i - 1. } fhad-sa: { <- ( i > 0). }.
Às-chur loidhne-ùr.


Prògram sgioblaich.

usedMemory1 := (Prògram cuimhne ? 0).


{ :i  Às-chur sgrìobh: i. } × 4.
Às-chur loidhne-ùr.
{ :i  Às-chur sgrìobh: (4 - i). } × 4.
Às-chur loidhne-ùr.
( 1 > 2 ) breugach: { Às-chur sgrìobh: ['BLOCK 1'], loidhne-ùr. }.
( 2 > 1 ) fìor:  { Às-chur sgrìobh: ['BLOCK 2'], loidhne-ùr. }.

>> i := 0.
{ Às-chur sgrìobh: i. i cuir-ris-àireamh: 1. } fhad-sa: { <- ( i < 3). }.
Às-chur loidhne-ùr.

i := 3.
{ Às-chur sgrìobh: i. i := i - 1. } fhad-sa: { <- ( i > 0). }.
Às-chur loidhne-ùr.



Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


{ :i Às-chur sgrìobh: i. } × 4.
Às-chur loidhne-ùr.
{ :i Às-chur sgrìobh: (4 - i). } × 4.
Às-chur loidhne-ùr.
( 1 > 2 ) breugach: { Às-chur sgrìobh: ['BLOCK 1'], loidhne-ùr. }.
( 2 > 1 ) fìor:  { Às-chur sgrìobh: ['BLOCK 2'], loidhne-ùr. }.

>> i := 0.
{ Às-chur sgrìobh: i. i cuir-ris-àireamh: 1. } fhad-sa: { <- ( i < 3). }.
Às-chur loidhne-ùr.

i := 3.
{ Às-chur sgrìobh: i. i := i - 1. } fhad-sa: { <- ( i > 0). }.
Às-chur loidhne-ùr.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
