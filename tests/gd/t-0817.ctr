# a value ending in the first part of an opening quote must survive serialization
>> luachan := Liosta ùr
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

luachan gach: { :i :value
	>> d := Faclair ùr.
	d cuir: value aig: ['k'].
	d cuir: ['second'] aig: ['j'].
	>> r := d còd oibseact.
	Às-chur sgrìobh: r cunnt, loidhne-ùr.
	Às-chur sgrìobh: ( (r aig: ['k']) = value ), loidhne-ùr.
}.
