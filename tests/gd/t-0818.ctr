# edge cases from a request must give an error or a result, not a crash
Server init.

Às-chur sgrìobh: ['<'] + (['abc'] bho: 0 faid: 0, litrichean-mòra) + ['>'], loidhne-ùr.
Às-chur sgrìobh: ['<'] + (['abc'] bho: 0 faid: 0, litrichean-beaga) + ['>'], loidhne-ùr.
Às-chur sgrìobh: ['<'] + (['abc'] frith-àireamh: 3, litrichean-mòra) + ['>'], loidhne-ùr.
Às-chur sgrìobh: [''] litrichean-mòra bytes, loidhne-ùr.
Às-chur sgrìobh: ['aB'] litrichean-mòra, loidhne-ùr.
Às-chur sgrìobh: ['aB'] litrichean-beaga, loidhne-ùr.

Às-chur sgrìobh: (Àm ùr: 0) bliadhna, loidhne-ùr.
{ Àm ùr: ['9e300'] àireamh. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
{ Àm ùr: ['-9e300'] àireamh. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
{ Àm ùr: ['nan'] àireamh. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
{ Àm ùr: 9000000000000000000. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
