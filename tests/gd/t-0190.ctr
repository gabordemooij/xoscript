#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

{
Àm ùine.
Àm fuirich: 1.
Às-chur sgrìobh: Prògram argamaidean, loidhne-ùr.
Prògram argamaid: 0.
Àireamh random.
Às-chur sgrìobh: (Prògram siostam: ['echo 'Hello'']).
} tòisich.

Prògram sgioblaich.
usedMemory1 := (Prògram cuimhne ? 0).

{
Àm ùine.
Àm fuirich: 1.
Às-chur sgrìobh: Prògram argamaidean, loidhne-ùr.
Prògram argamaid: 0.
Àireamh random.
Às-chur sgrìobh: (Prògram siostam: ['echo 'Hello'']).
} tòisich.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).

{
Àm ùine.
Àm fuirich: 1.
Às-chur sgrìobh: Prògram argamaidean, loidhne-ùr.
Prògram argamaid: 0.
Àireamh random.
Às-chur sgrìobh: (Prògram siostam: ['echo 'Hello'']).
} tòisich.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
