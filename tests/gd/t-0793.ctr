Server init.

>> DB := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

{
	DB ceist:
	['DROP TABLE movies'],
	ruith-àithne.
} glac: { Neoni. }, tòisich.

DB ceist:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ruith-àithne.

DB ceist: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paramadairean: ( Liosta ùr ; ['Halloween'] ),
ruith-àithne.

DB ceist: ['SELECT * FROM movies'],
faigh: { :movie
	Às-chur sgrìobh: movie title, loidhne-ùr.
}.

