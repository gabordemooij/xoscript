
Server init.
Às-chur sgrìobh: ['Database test'], loidhne-ùr.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'], 
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg :=
db ceist: ['SELECT UNHEX('CAFE') AS blobby'],
faigh: { :row
	Às-chur sgrìobh: ( row blobby bho: 0 faid: 2 ), loidhne-ùr.
	row blobby saor.
}.
