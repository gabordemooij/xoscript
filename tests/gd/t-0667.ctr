# test Program version

# this feature is disabled by default
Às-chur sgrìobh: (
	Prògram gleus: 
	['RECURSIVE_STRINTPOL']
), loidhne-ùr.


# but if we set the time back
>> today := Àm 
sòn: ['CEST'],
bho: ['2026-02-15 10:00:00'].
Prògram tionndadh: today.

# it will be enabled like it used to be (from now on)
Às-chur sgrìobh: (
	Prògram gleus: 
	['RECURSIVE_STRINTPOL']
), loidhne-ùr.