Prògram stiùireadh-cuimhne: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } glac: {
		oops cuir-ris-àireamh: 1.
	}, tòisich.
} × 1000.

{
	Às-chur sgrìobh: ['hi there!'].
	an-obair-seo mearachd: ['oops'].
	Às-chur sgrìobh: ['hi there!'].
	{ Às-chur sgrìobh: ['dont print this']. } tòisich.
} glac: { :e 
