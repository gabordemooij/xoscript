>> numbers := ['1,2,3'] sgoilt: [','].
Às-chur sgrìobh: ['I got: '] + numbers cunnt + [' numbers.'],loidhne-ùr.
{ :i Às-chur sgrìobh: ['number #'] + i + [':'] + (numbers àite: i), loidhne-ùr.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages sgoilt: [' Or '].
Às-chur sgrìobh: ['We serve'], loidhne-ùr.
{ :i Às-chur sgrìobh: ['->'] + (beverages àite: i), loidhne-ùr. } × (beverages cunnt).
Às-chur sgrìobh: (beverages ceangail: [',']), loidhne-ùr.
Às-chur sgrìobh: (numbers ceangail: ['||']).
