
>> a := Liosta ← (Liosta ← 100 ; 200 ; 300) ; (Liosta ← 9 ; 8 ; 7).
Às-chur sgrìobh: ['at 0,1 :'].
Às-chur sgrìobh: a ? 0 ? 1, loidhne-ùr. 
Às-chur sgrìobh: ['at 1,2 :'].
Às-chur sgrìobh: a ? 1 ? 2, loidhne-ùr. 
>> menu := Faclair ùr.
menu cuir: (Liosta ← ['pizza'] ; ['spaghetti']) aig: ['Italian Cuisine'].
menu cuir: (Liosta ← ['bifteki'] ; ['suflaki']) aig: ['Greek Cuisine'].
Às-chur sgrìobh: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), loidhne-ùr. 
Às-chur sgrìobh: ['but not on the same plate.'], loidhne-ùr.
