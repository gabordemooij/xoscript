Server init.

Às-chur sgrìobh: (
	Pàtran ùr: ['^\\w+$'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 0 match, fails on @ and .

Às-chur sgrìobh: (
	Pàtran ùr: ['^[^@]+@[^\.]+\.\\w+$'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match

Às-chur sgrìobh: (
	Pàtran ùr: ['[^@]+@[^\.]+\.\\w+'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match

Às-chur sgrìobh: (
	Pàtran ùr: ['([^@]+)@([^\.]+)\.\\w+'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match, groups dont matter

Às-chur sgrìobh: (
	Pàtran ùr: ['[a-z]'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 14 matches

Às-chur sgrìobh: (
	Pàtran ùr: ['.*'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match (all)

Às-chur sgrìobh: (
	Pàtran ùr: ['(.*)'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match (all)

Às-chur sgrìobh: (
	Pàtran ùr: ['\\s*[^@]+@[^\.]+\.\\w+'],
	maids: ['test@example.com'] 
), loidhne-ùr. # 1 match, prefix space optional, gets ignored