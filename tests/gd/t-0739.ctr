Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :binhelper
	leis binhelper := binhelper. 
}.

a air: ['item'] dèan: { <- leis binhelper.
}.

a item: Bin ùr.

>> old-binhelper-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-binhelper-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.


