>> items := Faclair ùr.
items cuir: ['green'] aig: ['color-1'].
items cuir: ['orange'] aig: ['color-2'].
items cuir: ['red'] aig: ['color-3'].
>> i := 0.
>> s := [''].
items gach: { :key :color
	Às-chur sgrìobh: ['color #'] + i + [' is: '] + color + [' '].
	i cuir-ris-àireamh: 1.
}.
Às-chur sgrìobh: i + [' colors!'].
