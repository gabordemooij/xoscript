
>> g := ['global'].
{ >> g := ['local']. Às-chur sgrìobh: g, loidhne-ùr. } tòisich. 
Às-chur sgrìobh: g, loidhne-ùr. 
>> message := ['Bye'].
>> Secret := Oibseact ùr.
Secret air: ['deuchainn'] dèan: {
	>> message := ['Hello'].
	leis message := ['World'].
	Às-chur sgrìobh: message + [' '] + leis message, loidhne-ùr.
}.
Secret deuchainn.
Às-chur sgrìobh: message.
