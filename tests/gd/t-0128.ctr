
Liosta air: ['sum'] dèan: {
	>> total := 0.
	fhèin gach: { :index :element
		total cuir-ris-àireamh: element.
	}. <- total.
}.

>> a := Liosta ← 9 ; 8 ; 7.
Às-chur sgrìobh: (a sum), loidhne-ùr. 
>> a := Liosta ← 1 ; 9.
Às-chur sgrìobh: (a sum), loidhne-ùr. 
>> a := Liosta ← ['o'] ; 2.
Às-chur sgrìobh: (a sum), loidhne-ùr. 
Às-chur sgrìobh: (Liosta ùr sum), loidhne-ùr. 
