['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Às-chur sgrìobh: (x + y), loidhne-ùr.

>> x := 10040.07.
>> y := 10305.60.

Às-chur sgrìobh: (x + y), loidhne-ùr.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Às-chur sgrìobh: (x + y + z), loidhne-ùr.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Às-chur sgrìobh: (x + y + z), loidhne-ùr.

>> q := 0.1.2.

Às-chur sgrìobh: (q), loidhne-ùr.

>> q := 012.

Às-chur sgrìobh: (q), loidhne-ùr.
