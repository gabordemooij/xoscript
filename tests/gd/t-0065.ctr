Àireamh air: ['factorial'] dèan: {
	>> total := 1.
	{ :index total iomadaich-le: (fhèin - (index)). } × fhèin. <- total.
}.
>> Printer := Oibseact ùr.
Printer air: ['print:and:'] dèan: { :x :y
	Às-chur sgrìobh: ['a='] + x + [', b='] + y, loidhne-ùr.
}.
>> a := 4.5. >> b := a cruinnich-sìos.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a cruinnich-suas.
Printer print: a and: b.
a := 4.5. b := a cruinnich-sìos.
Printer print: a and: b.
a := 4.5. b := a cruinnich.
Printer print: a and: b.
a := 4.2. b := a cruinnich.
Printer print: a and: b.

Às-chur sgrìobh: (9 modalas: 5), loidhne-ùr.
Às-chur sgrìobh: -666 luach-iomlan, loidhne-ùr.
Às-chur sgrìobh: 49 freumh-ceàrnagach, loidhne-ùr.
Às-chur sgrìobh: (2 cumhachd: 3), loidhne-ùr.
>> l := (Liosta ← 9 ; 6).
Às-chur sgrìobh: l as-ìsle.

