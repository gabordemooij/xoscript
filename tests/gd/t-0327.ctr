

Liosta air: ['fixture:'] dèan: { :f
	leis fixture := f.
}.

Liosta air: ['cunnt'] dèan: { <- leis fixture.
}.

Liosta air: ['aantal'] dèan: { <- leis fixture.
}.


>> x := Neoni.
{

	x := ['hello'] 
	cuir-an-àite:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caractar: 2)
			)
		)
	le: (
		(['...hal'] + ['lo']) 
			litrichean-mòra 
			lowecase 
			litrichean-mòra 
			frith-àireamh: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liosta ← 0 ; 1 ; 4; 9 ; (Liosta ← 0 ; 3; 1) ; 4
							) leth-dheireannach
						) ? 1
					) + 
					((Liosta ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					cunnt
				)
			)
	).

} × 10.
Às-chur sgrìobh: x, loidhne-ùr.

