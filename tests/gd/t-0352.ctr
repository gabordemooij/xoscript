Àireamh air: ['roman'] dèan: {
	>> àireamh := fhèin dèan-lethbhreac.
	>> roman := [''].
	{
		{
			(àireamh ≥ 1000) fìor: {
				roman cuir-ris: ['Ⅿ'].
				àireamh thoir-air-falbh: 1000.
			}, bris.
		
			(àireamh ≥ 500) fìor: {
				roman cuir-ris: ['Ⅾ'].
				àireamh thoir-air-falbh: 500.
			}, bris.
		
			(àireamh ≥ 100) fìor: {
				roman cuir-ris: ['Ⅽ'].
				àireamh thoir-air-falbh: 100.
			}, bris.
		
			(àireamh ≥ 50) fìor: {
				roman cuir-ris: ['Ⅼ'].
				àireamh thoir-air-falbh: 50.
			}, bris.
		
			(àireamh ≥ 50) fìor: {
				roman cuir-ris: ['Ⅼ'].
				àireamh thoir-air-falbh: 50.
			}, bris.
		
			(àireamh ≥ 10) fìor: {
				roman cuir-ris: ['Ⅹ'].
				àireamh thoir-air-falbh: 10.
			}, bris.
			
			(àireamh ≥ 9) fìor: {
				roman cuir-ris: ['Ⅸ'].
				àireamh thoir-air-falbh: 9.
			}, bris.
			
			(àireamh ≥ 5) fìor: {
				roman cuir-ris: ['Ⅴ'].
				àireamh thoir-air-falbh: 5.
			}, bris.
			
			(àireamh ≥ 4) fìor: {
				roman cuir-ris: ['Ⅳ'].
				àireamh thoir-air-falbh: 4.
			}, bris.
			
			(àireamh ≥ 1) fìor: {
				roman cuir-ris: ['Ⅰ'].
				àireamh thoir-air-falbh: 1.
			}, bris.
		} modh-obrach.
	} fhad-sa: { <- àireamh > 0. }. <- roman.
}.

Às-chur sgrìobh: 1 roman, loidhne-ùr.
Às-chur sgrìobh: 2 roman, loidhne-ùr.
Às-chur sgrìobh: 4 roman, loidhne-ùr.
Às-chur sgrìobh: 8 roman, loidhne-ùr.
Às-chur sgrìobh: 16 roman, loidhne-ùr.
Às-chur sgrìobh: 32 roman, loidhne-ùr.
Às-chur sgrìobh: 64 roman, loidhne-ùr.
Às-chur sgrìobh: 128 roman, loidhne-ùr.
Às-chur sgrìobh: 256 roman, loidhne-ùr.
Às-chur sgrìobh: 1024 roman, loidhne-ùr.
