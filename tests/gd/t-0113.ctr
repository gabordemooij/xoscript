Às-chur sgrìobh: ['Continue for-loop, No - before 6 and up.'], loidhne-ùr.
{ :i
	Às-chur sgrìobh: (i + 1), loidhne-ùr.
	((i + 1) > 4) lean-ort.
	Às-chur sgrìobh: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Às-chur loidhne-ùr.
Às-chur sgrìobh: ['Continue while-true, No --> before 5 and up.'], loidhne-ùr.
{
	Às-chur sgrìobh: ['iteration #'] + x, loidhne-ùr.
	x cuir-ris-àireamh: 1.
	((x < 5) chan-e) lean-ort.
	Às-chur sgrìobh: ['-->'].
} fhad-sa: xIsLessThan10.
Às-chur loidhne-ùr.
Às-chur sgrìobh: ['Continue while-false, No - before 3 only.'], loidhne-ùr.
{
	Às-chur sgrìobh: ['iteration #'] + x, loidhne-ùr.
	x thoir-air-falbh: 1.
	(x = 3) lean-ort.
	Às-chur sgrìobh: ['-'].
} fhad-sa: { <- ( x > 0). }.

Às-chur loidhne-ùr.
Às-chur sgrìobh: ['Continue times-loop, No ||| before 3.'], loidhne-ùr.
{ :i
	Às-chur sgrìobh: ['iteration #'] + i, loidhne-ùr.
	(i = 2) lean-ort.
	Às-chur sgrìobh: ['|||'].
} × 5.

Às-chur loidhne-ùr.

{ Fìor lean-ort. Às-chur sgrìobh: ['dont write this!'], loidhne-ùr. } tòisich.

{ Fìor lean-ort. Às-chur sgrìobh: ['dont write this!'], loidhne-ùr. } glac: { Às-chur sgrìobh: ['Dont catch this!']. }, tòisich.

Às-chur sgrìobh: ['Test Array each-loop: 0, ... ,2'], loidhne-ùr.
(Liosta ← 1 ; 2 ; 3) mapaich: { :i
	(i = 1) lean-ort.
	Às-chur sgrìobh: ['iteration #'] + (i - 0), loidhne-ùr.
}.

Às-chur sgrìobh: ['Test Map each-loop: c only'], loidhne-ùr.
>> m := Faclair ùr.
m cuir: ['first'] aig: ['a'], cuir: ['second'] aig: ['b'], cuir: ['third'] aig: ['c'].
m gach: { :k :v
	(k ≠ ['c']) lean-ort.
	Às-chur sgrìobh: ['iteration'] + k + v, loidhne-ùr.
}.

