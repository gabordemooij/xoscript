

>> Matryoshka := Oibseact ùr.
Matryoshka air: ['double:'] dèan: { :secret
	leis secret := secret × 2.
}.
Matryoshka air: ['ùr:'] dèan: { :secret
	>> answer := Neoni.
	>> t := (secret > 255).
	Às-chur sgrìobh: (secret + [' | '] + t), loidhne-ùr.
	t fìor: {
		answer := secret.
	}, eile: {
		answer := Matryoshka ath-chuairteach ùr: (fhèin double: secret).
	}. <- answer.
}.

>> x := Matryoshka ùr: 2.
