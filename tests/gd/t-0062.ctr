Boole air: ['xor:'] dèan: { :a :b <- ((a agus: b chan-e) no: (a chan-e agus: b)).
}.

>> o := Oibseact ùr.
o air: ['hello'] dèan: { ['Empty']. }.
{ o air: 2 dèan: 3.} glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
{ o air: ['deuchainn'] dèan: 3.} glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
{ o air: ['hello'] dèan: { ['Empty']. }.} glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ >> z := 4 ÷ 0. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ (Fìor agus: Neoni) fìor: { Às-chur sgrìobh: ['X'].}. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ ([''] xor: 0) fìor: { Às-chur sgrìobh: ['X'].}. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ (1 < ['2']) fìor: { Às-chur sgrìobh: ['OK']. }. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ (1 < ['2.0']) fìor: { Às-chur sgrìobh: ['OK']. }. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ (1 < ['x2.0']) fìor: { Às-chur sgrìobh: ['NO!']. }. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich. 
{ Às-chur sgrìobh: (['hello OK there'] bho: ['6'] faid: ['2']). } tòisich. 
