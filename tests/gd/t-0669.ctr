# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Tasgaidh 
	hais-facail-faire: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Tasgaidh 
	hais-facail-faire: hash dearbh: a1.
	# fail 
>> b := Tasgaidh
	hais-facail-faire: hash dearbh: a2.
	# ok!

Às-chur sgrìobh: a, loidhne-ùr.
Às-chur sgrìobh: b, loidhne-ùr.

