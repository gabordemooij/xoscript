Às-chur sgrìobh: ['1,2,3,4,5,6,7,8,9,A,'], loidhne-ùr.
>> Scope := Oibseact ùr.
Scope air: ['initialize:'] dèan: { :x leis property := x. }.
Scope air: ['confirm'] dèan: { Às-chur sgrìobh: [',']. }.
Scope air: ['deuchainn'] dèan: {
	Às-chur sgrìobh: leis property.
	fhèin confirm.
	( 1 = 1 ) fìor: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	( 1 = 0 ) breugach: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	>> y := 2. { Às-chur sgrìobh: leis property. fhèin confirm. } fhad-sa: { y thoir-air-falbh: 1. <- (y > 0). }.
	{ Às-chur sgrìobh: leis property. fhèin confirm. } × 1.
	(Liosta ← 1) gach: {  Às-chur sgrìobh: leis property. fhèin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Faclair ùr one: ['item']) gach: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	{ 1 ÷ 0. } glac: { Às-chur sgrìobh: leis property. fhèin confirm. }, tòisich.
	Às-chur loidhne-ùr.
}.
>> scope1 := Scope ùr.
scope1 initialize: ['X'].
scope1 deuchainn.
>> function := { 
	leis property := ['Y'].
	Às-chur sgrìobh: leis property.
	fhèin confirm.
	( 1 = 1 ) fìor: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	( 1 = 0 ) breugach: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	>> y := 2. { Às-chur sgrìobh: leis property. fhèin confirm. } fhad-sa: { y thoir-air-falbh: 1. <- (y > 0). }.
	{ Às-chur sgrìobh: leis property. fhèin confirm. } × 1.
	(Liosta ← 1) gach: {  Às-chur sgrìobh: leis property. fhèin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Faclair ùr one: ['item']) gach: { Às-chur sgrìobh: leis property. fhèin confirm. }.
	{ 1 ÷ 0. } glac: { Às-chur sgrìobh: leis property. fhèin confirm. }, tòisich.
	Às-chur loidhne-ùr.
}.
function air: ['confirm'] dèan: { Às-chur sgrìobh: [',']. }.
function cuir-an-gnìomh: 1 agus: 2.
