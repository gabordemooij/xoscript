

# create a 64-bit integer for exact calculations
>> a := Int64 bho-shreang: ['123'].

# to string
Às-chur sgrìobh: a, loidhne-ùr.

# divide
Às-chur sgrìobh: a / (Int64 bho-shreang: ['3']), loidhne-ùr.

# multiply
Às-chur sgrìobh: a * (Int64 bho-shreang: ['2']), loidhne-ùr.

# add
Às-chur sgrìobh: a + (Int64 bho-shreang: ['1']), loidhne-ùr.

# subtract
Às-chur sgrìobh: a - (Int64 bho-shreang: ['2']), loidhne-ùr.

# compare
Às-chur sgrìobh: ( a =   (Int64 bho-shreang: ['123'])), loidhne-ùr.
Às-chur sgrìobh: ( a !=: (Int64 bho-shreang: ['124'])), loidhne-ùr.
Às-chur sgrìobh: ( a <   (Int64 bho-shreang: ['124'])), loidhne-ùr.
Às-chur sgrìobh: ( a >   (Int64 bho-shreang: ['122'])), loidhne-ùr.
Às-chur sgrìobh: ( a >=: (Int64 bho-shreang: ['123'])), loidhne-ùr.
Às-chur sgrìobh: ( a <=: (Int64 bho-shreang: ['123'])), loidhne-ùr.





	