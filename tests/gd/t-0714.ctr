>> a := Oibseact ùr. 
a air: ['greet'] dèan: { Às-chur sgrìobh: ['welcome!'], loidhne-ùr. }.
a air: ['greet2'] dèan: { Às-chur sgrìobh: ['welcome2!'], loidhne-ùr. }.
a save-as: ['/tmp/a.bin'].

Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
b greet2.