
>> Animal := Oibseact ùr.
Animal air: ['ùr'] dèan: { <- fhèin ùr init.
}.

Animal air: ['init'] dèan: {
	leis sound := ['?'].
	leis legs := 4.
}.

>> Dog := Animal ùr.
Dog air: ['init'] dèan: {
	fhèin init.
	leis sound := ['barks'].
}.

Animal air: ['sreang'] dèan: { <- leis legs sreang + leis sound.
}.

>> poodle := Dog ùr.
Às-chur sgrìobh: poodle, loidhne-ùr.

