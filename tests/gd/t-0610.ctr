
>> Rectangle := Oibseact ùr.

Rectangle air: ['area'] dèan: { <- leis faid * leis width.
}.

Rectangle air: ['length:'] dèan: { :faid
	leis faid := faid.
}.

Rectangle air: ['width:'] dèan: { :width
	leis width := width.
}.

Rectangle air: ['ùr'] dèan: {
	# this will not result into an infinite loop
	>> rectangle := fhèin ùr.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ùr.
Às-chur sgrìobh: a area, loidhne-ùr. #0

>> b := Rectangle ùr length: 2, width: 3.
Às-chur sgrìobh: b area, loidhne-ùr. #6

