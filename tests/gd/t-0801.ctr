Server init.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> del := db ceist: ['DELETE FROM book WHERE id > 0'].
{  del ruith-àithne. db dearbhaich. } glac: { :e db till-air-ais.  }, tòisich.

>> cunnt := db ceist: ['SELECT COUNT(*) AS num FROM book'].
cunnt faigh: { :row Às-chur sgrìobh: row num, loidhne-ùr. }.
