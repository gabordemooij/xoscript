>> echo := Oibseact ùr.
echo air: ['freagair:'] dèan: { :sound
	{ Às-chur sgrìobh: sound. } × 2.
}.
echo ho!. 


echo := Oibseact ùr.
echo air: ['freagair:agus:'] dèan: { :sound :x
	{ Às-chur sgrìobh: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Oibseact ùr.
echo air: ['freagair:agus:agus:'] dèan: { :operation :sound :x
	{ Às-chur sgrìobh: sound. } × x.
}.
echo shout: ['la'] times: 4. 


