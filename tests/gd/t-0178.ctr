

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

>> txt := ['Word Salad'].
Às-chur sgrìobh: ['last index of ord = '] + (( txt deireannach: ['ord'] ) - 0), loidhne-ùr.
Às-chur sgrìobh: ['index of ord = '] + (( txt lorg: ['ord'] ) - 0), loidhne-ùr.
Às-chur sgrìobh: ['index of ad = '] + (( txt lorg: ['ad'] ) - 0), loidhne-ùr.
Às-chur sgrìobh: ['last index of W = '] + (( txt deireannach: ['W'] ) - 0), loidhne-ùr.
Às-chur sgrìobh: ['last index of d = '] + (( txt deireannach: ['d'] ) - 0), loidhne-ùr.
Às-chur sgrìobh: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), loidhne-ùr.
Às-chur sgrìobh: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), loidhne-ùr.
Às-chur sgrìobh: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), loidhne-ùr.
Às-chur sgrìobh: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), loidhne-ùr.

