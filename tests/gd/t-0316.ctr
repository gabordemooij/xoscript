>> Grandfather := Oibseact ùr.
Grandfather air: ['greet'] dèan: {
	Às-chur sgrìobh: ['Ave!'], loidhne-ùr.
}.
>> Father := Grandfather ùr.
Father air: ['greet'] dèan: {
	Às-chur sgrìobh: ['Hello'], loidhne-ùr.
	fhèin greet.
}.
>> Son := Father ùr.
Son air: ['greet'] dèan: {
	Às-chur sgrìobh: ['Hi'], loidhne-ùr.
	fhèin greet.
}.

Son greet.

>> Roundabout := Oibseact ùr.
Roundabout air: ['circle:'] dèan: { :x
	Às-chur sgrìobh: x, loidhne-ùr.
	(x < 3) fìor: { fhèin ath-chuairteach circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) fìor: { Às-chur sgrìobh: x, loidhne-ùr. x cuir-ris-àireamh: 1.  increment tòisich. }. }.
increment tòisich.