Sreang air: ['evaluate'] dèan: {
	>> còd := Faidhle ùr: ['/tmp/eval.ctr'].
	còd sgrìobh: (fhèin sreang + ['.']).
	Prògram cleachd: ['/tmp/eval.ctr'].
}.

>> a := Liosta ← 1 ; 2 ; 3.
>> b := (a sreang).

Às-chur sgrìobh: b, loidhne-ùr. 
(['b := '] + b) evaluate.

Às-chur sgrìobh: b ? 2, loidhne-ùr. 

Às-chur sgrìobh: (( Liosta ← 1 ; 2 ; 3 )), loidhne-ùr. 

Às-chur sgrìobh: ((Faclair ùr) cuir: 1 aig: 2), loidhne-ùr. 

>> x := ( (Liosta ← 1 ; ( Liosta ← 9 ) ; Fìor ) ) sreang.
Às-chur sgrìobh: x, loidhne-ùr. 
(['x := '] + x) evaluate.

Às-chur sgrìobh: x ? 1 ? 0, loidhne-ùr. 

>> y := (Faclair ùr) cuir: (Liosta ← 1) aig: (Liosta ← 2).
Às-chur sgrìobh: y, loidhne-ùr. 

(['y := '] + y) sreang evaluate.

Às-chur sgrìobh: (y aig: (Liosta ← 2) sreang ), loidhne-ùr.

Às-chur sgrìobh: (Liosta ùr), loidhne-ùr. 
Às-chur sgrìobh: (Faclair ùr), loidhne-ùr. 
