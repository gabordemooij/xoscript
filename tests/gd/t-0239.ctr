Liosta air: ['sum'] dèan: {
	>> total := 0.
	fhèin gach: { :index :element
		total cuir-ris-àireamh: element.
	}. <- total.
}.

>> a := Fìor.



a air: ['sreang'] dèan: {
	>> answer := Neoni.
	( fhèin = Fìor ) fìor: {
		answer := ['Yep'].
	}, eile: {
		answer := ['Nope'].
	}. <- answer.
}.

a air: ['àireamh'] dèan: {
	>> answer := Neoni.
	( fhèin = Fìor ) fìor: {
		answer := 10.
	}, eile: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b air: ['sreang'] dèan: { <- ['Devil'].
}.

b air: ['boole'] dèan: { <- Breugach.
}.


Às-chur sgrìobh: a, loidhne-ùr.  
Às-chur sgrìobh: (90 + a), loidhne-ùr. 
Às-chur sgrìobh: b, loidhne-ùr. 
Às-chur sgrìobh: (Fìor agus: b), loidhne-ùr.

a := Liosta ← ['hello'] ; ['world'] ; Fìor ; Neoni ; 666. 
a := a + ( Liosta ← 1 ).
Às-chur sgrìobh: a, loidhne-ùr.
Às-chur sgrìobh: ((Faclair ùr) cuir: Neoni aig: Neoni), loidhne-ùr.
Às-chur sgrìobh: a sum, loidhne-ùr. 


{
	a air: ['sreang'] dèan: { <- Neoni. }.
	a := [''] + a.
} glac: { :error
	Às-chur sgrìobh: ['Error noted: '] + error, loidhne-ùr.
}, tòisich.



{
	a air: ['àireamh'] dèan: { <- Neoni. }.
	a := 3 × a.
} glac: { :error
	Às-chur sgrìobh: ['Error noted: '] + error, loidhne-ùr.
}, tòisich.


{
	a air: ['boole'] dèan: { <- Neoni. }.
	a := Fìor agus: a. 
} glac: { :error
	Às-chur sgrìobh: ['Error noted: '] + error, loidhne-ùr.
}, tòisich.





