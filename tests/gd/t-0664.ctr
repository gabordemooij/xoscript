# recursive interpolation not allowed

Às-chur sgrìobh: 
['recursive string interolation enabled: '] + (
	Prògram gleus: 
	['RECURSIVE_STRINTPOL']
), loidhne-ùr.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Às-chur sgrìobh: a, loidhne-ùr.


