# compliance test

# use international numbers

Às-chur sgrìobh: ['1000 -> '].
Às-chur sgrìobh: 1000, loidhne-ùr. #1000

Às-chur sgrìobh: ['1.5 -> '].
Às-chur sgrìobh: 1.5, loidhne-ùr.  #1.5

Às-chur sgrìobh: ['1001.5 -> '].
Às-chur sgrìobh: 1.5 + 1000, loidhne-ùr. #1001.5

# use 0-indexed arrays
>> x := Liosta ùr ; 1 ; 2 ; 3.
>> y := Liosta ùr ; ['a'] ; ['b'] ; ['c'].

Às-chur sgrìobh: ['1 -> '].
Às-chur sgrìobh: x ? 0, loidhne-ùr. #1

Às-chur sgrìobh: ['1 -> '].
Às-chur sgrìobh: (x aig: 0), loidhne-ùr. #1

Às-chur sgrìobh: ['1 -> '].
Às-chur sgrìobh: x ciad, loidhne-ùr. #1

Às-chur sgrìobh: ['3 -> '].
Às-chur sgrìobh: x deireannach, loidhne-ùr. #3

Às-chur sgrìobh: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Às-chur sgrìobh: (x le: y), loidhne-ùr.

Às-chur sgrìobh: ['1 -> '].
Às-chur sgrìobh: (x bho: 0 faid: 1) ciad, loidhne-ùr. #1

Às-chur sgrìobh: ['0 -> '].
Às-chur sgrìobh: (x lorg: 1), loidhne-ùr. #0

x cuir: 9 aig: 0.

Às-chur sgrìobh: ['9 -> '].
Às-chur sgrìobh: (x aig: 0), loidhne-ùr. #9

x cuir-air-thoiseach: 8.
Às-chur sgrìobh: ['8 -> '].
Às-chur sgrìobh: (x aig: 0), loidhne-ùr. #9


x cuir-ris: 10.
Às-chur sgrìobh: ['10 -> '].
Às-chur sgrìobh: (x aig: 4), loidhne-ùr. #10








