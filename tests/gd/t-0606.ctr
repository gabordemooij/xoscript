>> Point := Oibseact ùr.
Point air: ['x-coordinate:'] dèan: { :x leis x := x. }.
Point air: ['y-coordinate:'] dèan: { :y leis y := y. }.
Point air: ['x-coordinate']  dèan: { <- leis x dèan-lethbhreac. }.
Point air: ['y-coordinate']  dèan: { <- leis y dèan-lethbhreac. }.

Point air: ['='] dèan: { :other <- ( leis x = other x-coordinate
		 agus: leis y = other y-coordinate ).
}.

>> pier := Point ùr x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ùr x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ùr x-coordinate: 5, y-coordinate: 6.

Às-chur sgrìobh: pier = town-hall, loidhne-ùr.
Às-chur sgrìobh: pier = restaurant, loidhne-ùr.
