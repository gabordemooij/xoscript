#Linux
>> clock := Àm ùr.
clock sòn: ['UTC-1'].
clock bliadhna: 1981, mìos: 1, latha: 5,
      uair: 13, mionaid: 15, diog: 13.

Às-chur sgrìobh: clock, loidhne-ùr.
clock sòn: ['UTC+0'].

Às-chur sgrìobh: (
	(clock bliadhna lom) + ['-'] + (clock mìos) + ['-'] + (clock latha) + [' '] +
	(clock uair) + [':'] + (clock mionaid) + [':'] + (clock diog) + [' '] +
	['W'] + (clock seachdain) + (clock sòn)
), loidhne-ùr.


clock sòn: ['UTC-1'].
Às-chur sgrìobh: (
	(clock bliadhna lom) + ['-'] + (clock mìos) + ['-'] + (clock latha) + [' '] +
	(clock uair) + [':'] + (clock mionaid) + [':'] + (clock diog) + [' '] +
	['W'] + (clock seachdain) + (clock sòn)
), loidhne-ùr.
