# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> slighe := ['/tmp/dat.csv'].
>> csv := Faidhle ùr: slighe.
csv sgrìobh: s.

# accepts CRLF LF CR, varying row length
csv sgaradair: [';'] comharra-labhairt: ['"'] loidhnichean: { :line
	Prògram sgioblaich.
	Às-chur sgrìobh: line, loidhne-ùr.
	Prògram sgioblaich.
}.

# unequal lines
s cuir-ris: ['\njustone'].
csv sgrìobh: s.
{
	csv sgaradair: [';'] comharra-labhairt: ['"'] loidhnichean: { :line
		Às-chur sgrìobh: line, loidhne-ùr.
	}.
} glac: { :e 
	Às-chur sgrìobh: e, loidhne-ùr.
}, tòisich.

# invalid format
s := ['"he"llo";world'].
csv sgrìobh: s.
{
	csv sgaradair: [';'] comharra-labhairt: ['"'] loidhnichean: { :line
		Às-chur sgrìobh: line, loidhne-ùr.
	}.
} glac: { :e 
	Às-chur sgrìobh: e, loidhne-ùr.
}, tòisich.
