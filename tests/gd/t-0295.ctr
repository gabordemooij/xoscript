
>> dictionary := (
	Faclair ùr
		cuir: ['b'] aig: ['a'],
		cuir: ['a'] aig: ['b'],
		cuir: ['z'] aig: ['x'],
		cuir: ['hello'] aig: ['hallo'],
		cuir: ['human'] aig: ['human']
).

>> comparisons := Liosta ùr.
dictionary gach: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a dèan-coimeas: b)
	).
}.

comparisons seòrsaich: { :a :b <- ( a dèan-coimeas: b ). }.
Às-chur sgrìobh: ( comparisons ceangail: ['↵'] ), loidhne-ùr.
comparisons ceangail: ['↵'].
