# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Tasgaidh gin-iuchraichean.

# private (secret) key
>> sk := keys ciad.

# public key
>> pk := keys deireannach.

# sign a message
>> sig := Tasgaidh soidhnich: ['abc'] le: sk.

# check message (ok)
Às-chur sgrìobh: ( 
	Tasgaidh
		dearbh: ['abc'] 
		soidhneadh: sig 
		le: pk 
), loidhne-ùr.

# check message (fail)
Às-chur sgrìobh: ( 
	Tasgaidh 
		dearbh: ['abd'] 
		soidhneadh: sig 
		le: pk 
), loidhne-ùr.