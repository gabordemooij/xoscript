Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :dict
	leis dict := dict. 
}.

a air: ['item'] dèan: { <- leis dict.
}.

a item: (
Faclair ùr
	hello: ['world']).

>> old-dict-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-dict-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.

Às-chur sgrìobh: b item, loidhne-ùr.
