# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Oibseact ùr.

Log air: ['say:'] dèan: { :str
	Às-chur sgrìobh: str, loidhne-ùr.
}.

>> Item := Oibseact ùr.

Item air: ['ùr:'] dèan: { :id <- fhèin ùr id: id.
}.

Item air: ['id:'] dèan: { :id
	leis id := id.
}.

Item air: ['id'] dèan: { <- leis id. }.


Item air: ['sreang'] dèan: {
	>> str := ['Item#~no'].
	str ~no: leis id. <- str.
}.


>> Print := Oibseact ùr.

Print air: ['items'] dèan: { 
	
	leis item := Item ùr: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: leis item
	).
	
	
}.

Print items.