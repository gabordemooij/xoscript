#Linux
>> OS := Prògram suidheachadh: ['OS'].

>> clock := Àm ùr.
	
(OS = ['Haiku']) fìor: {
	clock sòn: ['CET'],
	bliadhna: 2017, mìos: 7, latha: 13,
	uair: 18, mionaid: 0, diog: 0.
}, eile: {
	clock sòn: ['Europe/Amsterdam'],
	bliadhna: 2017, mìos: 7, latha: 13,
	uair: 18, mionaid: 0, diog: 0.
}.

clock air: ['tell'] dèan: {
	Às-chur sgrìobh: fhèin, loidhne-ùr.
}.


clock cuir-ris-àireamh: 2    uair, tell.
clock cuir-ris-àireamh: 1    uair, tell.
clock cuir-ris-àireamh: 19 mionaid, tell.
clock cuir-ris-àireamh: 1  mionaid, tell.
clock cuir-ris-àireamh: 1  mionaid, tell.
clock cuir-ris-àireamh: 19 diog, tell.
clock cuir-ris-àireamh: 1  diog, tell.
clock cuir-ris-àireamh: 1  diog, tell.
clock cuir-ris-àireamh: 2    bliadhna, tell.
clock cuir-ris-àireamh: 1    bliadhna, tell.

(OS = ['Haiku']) fìor: {
clock cuir-ris-àireamh: 5   mìos.
clock sòn: ['CEST'], tell.
}, eile: {
	clock cuir-ris-àireamh: 5   mìos, tell.
}.

clock cuir-ris-àireamh: 1   mìos, tell.
clock cuir-ris-àireamh: 19    latha, tell.
clock cuir-ris-àireamh: 1    uair, tell.
clock cuir-ris-àireamh: 120  yard, tell.
