

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

>> txt := ['1.6'].
>> n := txt àireamh.
>> t := txt boole.
Às-chur sgrìobh: n, loidhne-ùr.
Às-chur sgrìobh: t, loidhne-ùr.
Às-chur sgrìobh: n seòrsa, loidhne-ùr.
Às-chur sgrìobh: t seòrsa, loidhne-ùr.

Prògram sgioblaich.

usedMemory1 := (Prògram cuimhne ? 0).


txt := ['1.6'].
n := txt àireamh.
t := txt boole.
Às-chur sgrìobh: n, loidhne-ùr.
Às-chur sgrìobh: t, loidhne-ùr.
Às-chur sgrìobh: n seòrsa, loidhne-ùr.
Às-chur sgrìobh: t seòrsa, loidhne-ùr.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


txt := ['1.6'].
n := txt àireamh.
t := txt boole.
Às-chur sgrìobh: n, loidhne-ùr.
Às-chur sgrìobh: t, loidhne-ùr.
Às-chur sgrìobh: n seòrsa, loidhne-ùr.
Às-chur sgrìobh: t seòrsa, loidhne-ùr.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
