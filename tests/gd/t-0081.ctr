>> map1 := Faclair ùr.
>> key1 := Liosta ùr.
>> key2 := Liosta ùr.

map1
	cuir: ['hello'] aig: key1,
	cuir: ['world'] aig: key2.


Às-chur
	sgrìobh: ['Map #1 contains: '] + (map1 aig: key1),
	sgrìobh: [' and '] + (map1 aig: key2), loidhne-ùr.

>> KeyeableArray := Liosta ùr.
KeyeableArray air: ['toString'] dèan: { <- (fhèin cunnt) toString.
}.

>> map2 := Faclair ùr.
key1 := KeyeableArray ùr.
key2 := KeyeableArray ùr.

key1 cuir-ris: 1.

map2
	cuir: ['hello'] aig: key1,
	cuir: ['world'] aig: key2.

Às-chur
	sgrìobh: ['Map #2 contains: '] + (map2 aig: key1),
	sgrìobh: [' and '] + (map2 aig: key2), loidhne-ùr.
