


>> Deck := Liosta ùr.
Deck air: ['print'] dèan: {
        >> len := fhèin cunnt - 1.
        { :i
                >> len2 := fhèin cunnt - 1.
                Às-chur sgrìobh: ['len: '].
                Às-chur sgrìobh: len, loidhne-ùr.
                Às-chur sgrìobh: ['len2: '].
                Às-chur sgrìobh: len2, loidhne-ùr.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
