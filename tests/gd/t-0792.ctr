Server init.

>> DB := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ceist: SQL.

# now you don't have to set DB
query2 faigh: { :row
	Às-chur sgrìobh: row world, loidhne-ùr.
}.
