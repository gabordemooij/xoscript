# catch-all test (practical)
>> HTML := Sreang ùr.
HTML air: ['encode:'] dèan: { :tekst
	fhèin cuir-ris: (tekst
	cuir-an-àite: ['&'] le: ['&amp;'], 
	cuir-an-àite: ['<'] le: ['&lt;'],
	cuir-an-àite: ['>'] le: ['&gt;'],
	cuir-an-àite: ['"'] le: ['&quot;']).
}.
>> blog := HTML ùr.
blog cuir-ris: ['<h1>'],
     encode: ['Koffie & Thee'],
     cuir-ris: ['</h1>'].
Às-chur sgrìobh: blog, loidhne-ùr.


>> Roman := Àireamh ùr.
Roman air: ['stringy'] dèan: {
	>> a := [''].
	{ a cuir-ris: ['I']. } × fhèin. <- a.
}.

>> x := Roman ùr.
x cuir-ris-àireamh: 3.
Às-chur sgrìobh: x stringy, loidhne-ùr.

>> Quantum := Boole ùr.
Quantum air: ['true?'] dèan: { <- ['maybe True']. }.
Às-chur sgrìobh: (Quantum ùr true?), loidhne-ùr.

>> Nihil := Neoni ùr.
Nihil air: ['sreang'] dèan: { <- ['Nihil']. }.
Às-chur sgrìobh: (Nihil ùr), loidhne-ùr.
