60 × {
	>> x := (Àireamh random % 6) + 1.
	(x ≤ 6) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	(x ≥0) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	x := (Àireamh random % 3) + 1.
	(x < 3) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	(x>-1) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	x := ((Boole flip) àireamh).
	(x = 0 no: x = 1) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	x := ((Fìor flip) àireamh).
	(x = 0 no: x = 1) breugach: { Às-chur sgrìobh: ['FAIL']. }.
	x := (Boole flip an-dàrna-cuid: ['HEAD'] no: ['TAIL']).
	((x = ['HEAD']) no: (x = ['TAIL'])) breugach: { Às-chur sgrìobh: ['FAIL']. }.
}.
Às-chur sgrìobh: ['DONE'].

