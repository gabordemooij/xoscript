Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :fmt
	leis fmt := fmt. 
}.

a air: ['item'] dèan: { <- leis fmt.
}.

a item: ( Fòrmat ùr: ['|%s|'] ).

Às-chur sgrìobh: a item, loidhne-ùr.

>> old-fmt-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-fmt-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.

Às-chur sgrìobh: ( b item cuir-an-gnìomh: ['hello'] ), loidhne-ùr.
