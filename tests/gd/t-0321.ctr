# test qualifiers

Prògram sgioblaich.

>> Fruit := Oibseact ùr.
Fruit air: ['ùr'] dèan: {
	>> f := fhèin ùr.
	f apples: 0. <- f.
}.
Fruit air: ['apples:'] dèan: { :a leis apples := a. }.
Fruit air: ['apples'] dèan: { <- leis apples. }.
Fruit air: ['+'] dèan: { :f
	>> n := Fruit ùr.
	n apples: (f apples + leis apples). <- n.
}.
Àireamh air: ['apples'] dèan: { <- ((Fruit ùr) apples: fhèin).
}.

Fruit air: ['sreang'] dèan: { <- leis apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Às-chur sgrìobh: q, loidhne-ùr.




q := 3 apples + 4 apples.
Às-chur sgrìobh: q, loidhne-ùr.



q := 3 apples + 4 apples.
Às-chur sgrìobh: q, loidhne-ùr.


