>> phrases := Liosta ùr
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases gach: { :_ :phrase 
	>> e := Server base64-còdaich: phrase.
	>> d := Server base64-dì-chòdaich: e.
	Às-chur sgrìobh: (
		message dèan-lethbhreac ~encoded: e, ~decoded: d
	), loidhne-ùr.
}.
