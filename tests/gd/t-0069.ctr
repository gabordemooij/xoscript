

Sreang air: ['html'] dèan: { <- (
		fhèin
		cuir-an-àite: ['&'] le: ['&amp;'],
		cuir-an-àite: ['<'] le: ['&lt;'],
		cuir-an-àite: ['>'] le: ['&gt;'],
		cuir-an-àite: ['"'] le: ['&quot;']
	).
}.


Às-chur sgrìobh: ([' left trimmed '] beàrr) + [' '] + ( ['and right trimmed'] beàrr) + ['!'], loidhne-ùr.
Às-chur sgrìobh: ['<html>"html & entities"</html>'] html.
