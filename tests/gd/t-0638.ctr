
Server init.
>> rq := HTTP-Iarrtas ùr.
Às-chur sgrìobh: ['HTTP-GET d[]=']  + ( rq get-liosta: ['d[]'] ), loidhne-ùr. # GET
Às-chur sgrìobh: ['HTTP-GET f[]=']  + ( rq get-liosta: ['f[]'] ), loidhne-ùr. # GET
Às-chur sgrìobh: ['HTTP-POST e[]='] + ( rq post-liosta: ['e[]'] ), loidhne-ùr. # GET
Às-chur sgrìobh: ['HTTP-POST c=']   + ( rq post: ['c'] ), loidhne-ùr. # GET
Às-chur sgrìobh: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), loidhne-ùr. # GET
