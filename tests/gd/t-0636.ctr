# test url parsing

Server init.
>> url := URL bho: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Às-chur sgrìobh: ['scheme = '] + url sgeama, loidhne-ùr.
Às-chur sgrìobh: ['host = '] + url òstair, loidhne-ùr.
Às-chur sgrìobh: ['port = '] + url port, loidhne-ùr.
Às-chur sgrìobh: ['path = '] + url slighe, loidhne-ùr.
Às-chur sgrìobh: ['query = '] + url paramadairean-luirg, loidhne-ùr.
Às-chur sgrìobh: ['fragment = '] + url bloigh, loidhne-ùr.
