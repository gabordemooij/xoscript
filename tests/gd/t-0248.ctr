

Sreang air: ['evaluate'] dèan: {
	>> còd := Faidhle ùr: ['/tmp/eval.ctr'].
	còd sgrìobh: fhèin sreang + ['.'].
	Prògram cleachd: ['/tmp/eval.ctr'].
}.

>> a := (Liosta ← (
	(Faclair ùr)
		cuir: ['domain'] aig: ['mywebsite.com'],
		cuir: (Liosta ←
			((Faclair ùr)
				cuir: ['home'] aig: ['title'],
				cuir: ['<html></html>'] aig: ['body'],
				cuir: ['2017-01-01'] aig: ['created']
			) ;
			((Faclair ùr)
				cuir: ['aboutus(c)'] aig: ['title'],
				cuir: ['<credits>Author Inc.</credits>'] aig: ['body']
			)
		) aig: ['pages']
	)
) sreang.

Às-chur sgrìobh: a seòrsa, loidhne-ùr.
Às-chur sgrìobh: a, loidhne-ùr.

>> b := Neoni.
(['b := '] + a) evaluate.
Às-chur sgrìobh: b ? 0 ? ['pages'] ? 1 ? ['body'], loidhne-ùr.

>> c := b ? 0.
>> d := c sreang.
Às-chur sgrìobh: d seòrsa, loidhne-ùr.

>> e := Neoni.
(['e := '] + d) evaluate.
Às-chur sgrìobh: e ? ['pages'] ? 0, loidhne-ùr.
