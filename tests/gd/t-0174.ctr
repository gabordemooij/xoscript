


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.
>> palette := Neoni.
>> colors := Neoni.

{
palette := Faclair ùr.
palette 
	cuir: ['#F00'] aig: ['red'],
	cuir: ['#0F0'] aig: ['green'],
	cuir: ['#00F'] aig: ['blue'].
Às-chur sgrìobh: ['number of RGB codes in palette: '] + ( palette cunnt ), loidhne-ùr.
Às-chur sgrìobh: ['RGB code of green is: '] + ( palette ? ['green'] ), loidhne-ùr.
colors := [''].
( palette gach: { :ainm :còd
		colors := colors + ( ainm + [':'] + còd ).
} ).
Às-chur sgrìobh: ['All colors in palette: '] + colors, loidhne-ùr.
} tòisich.
Prògram sgioblaich.
usedMemory1 := (Prògram cuimhne ? 0).

{
palette := Faclair ùr.
palette 
	cuir: ['#F00'] aig: ['red'],
	cuir: ['#0F0'] aig: ['green'],
	cuir: ['#00F'] aig: ['blue'].
Às-chur sgrìobh: ['number of RGB codes in palette: '] + ( palette cunnt ), loidhne-ùr.
Às-chur sgrìobh: ['RGB code of green is: '] + ( palette ? ['green'] ), loidhne-ùr.
colors := [''].
( palette gach: { :ainm :còd
		colors := colors + ( ainm + [':'] + còd ).
} ).
Às-chur sgrìobh: ['All colors in palette: '] + colors, loidhne-ùr.
} tòisich.
Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).

{
palette := Faclair ùr.
palette 
	cuir: ['#F00'] aig: ['red'],
	cuir: ['#0F0'] aig: ['green'],
	cuir: ['#00F'] aig: ['blue'].
Às-chur sgrìobh: ['number of RGB codes in palette: '] + ( palette cunnt ), loidhne-ùr.
Às-chur sgrìobh: ['RGB code of green is: '] + ( palette ? ['green'] ), loidhne-ùr.
colors := [''].
( palette gach: { :ainm :còd
		colors := colors + ( ainm + [':'] + còd ).
} ).
Às-chur sgrìobh: ['All colors in palette: '] + colors, loidhne-ùr.
} tòisich.
Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
