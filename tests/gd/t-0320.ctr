


>> CoffeeMachine := Oibseact ùr.
CoffeeMachine air: ['order:'] dèan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) fìor: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) fìor: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) fìor: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Oibseact ùr.
SimpleCoffeeMachine air: ['order'] dèan: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Às-chur sgrìobh: redCup, loidhne-ùr.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Às-chur sgrìobh: greenCup, loidhne-ùr.
>> yellowCup := CoffeeMachine order: 1.
Às-chur sgrìobh: yellowCup, loidhne-ùr.
>> blueCup := CoffeeMachine order: 0.
Às-chur sgrìobh: blueCup, loidhne-ùr.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Às-chur sgrìobh: blackCup, loidhne-ùr.
blackCup cuir-ris: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Às-chur sgrìobh: orangeCup, loidhne-ùr.
