Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> greeter := Oibseact ùr.
greeter air: ['name:'] dèan: { :ainm
	leis xname := ainm. 
}.
greeter air: ['greet'] dèan: {
	Às-chur sgrìobh: ['Hello '] + leis xname, loidhne-ùr.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
