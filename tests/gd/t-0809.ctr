# backslashes must survive code serialization, strings must not end early
>> luachan := Liosta ùr
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

luachan gach: { :i :value
	>> d := Faclair ùr.
	d cuir: value aig: ['k'].
	>> r := d còd oibseact.
	Às-chur sgrìobh: r cunnt, loidhne-ùr.
	Às-chur sgrìobh: ( (r aig: ['k']) = value ), loidhne-ùr.
}.
