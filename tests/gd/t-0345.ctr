# test catch-all methods
>> x13 := Oibseact ùr.
x13 air: ['a'] dèan: { :a Às-chur sgrìobh: 0, loidhne-ùr. }.
x13 air: ['a:'] dèan: { :a Às-chur sgrìobh: a, loidhne-ùr. <- 5. }.
x13 air: ['a:b:'] dèan: { :a :b Às-chur sgrìobh: (a + b), loidhne-ùr. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
