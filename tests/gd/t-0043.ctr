>> repeater := Oibseact ùr.
repeater air: ['freagair:'] dèan: { :what
	Às-chur sgrìobh: what + [' '].
}.
repeater air: ['freagair:agus:'] dèan: { :what :say
	Às-chur sgrìobh: what, sgrìobh: say + [' '].
}.
repeater air: ['freagair:agus:agus:'] dèan: { :what :say :more
	Às-chur sgrìobh: what, sgrìobh: say, sgrìobh: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
