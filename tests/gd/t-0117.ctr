>> t := Fìor.
(t = Fìor) fìor: { Às-chur sgrìobh: ['T']. }.
(t = Breugach) fìor: { Às-chur sgrìobh: ['F']. }.
Às-chur sgrìobh: ['|'].
>> t := Breugach.
(t = Fìor) fìor: { Às-chur sgrìobh: ['T']. }.
(t = Breugach) fìor: { Às-chur sgrìobh: ['F']. }.
Às-chur sgrìobh: ['|'].
>> f := Fìor.
(t = Fìor agus: f = Breugach) fìor: { Às-chur sgrìobh: ['T']. }.
(t = Breugach agus: f = Fìor) fìor: { Às-chur sgrìobh: ['F']. }.
Às-chur sgrìobh: ['|'].
>> n := Neoni.
(n Neoni?) fìor: { Às-chur sgrìobh: ['T']. }.
(n Neoni?) breugach: { Às-chur sgrìobh: ['F']. }.
Às-chur sgrìobh: ['|'].
(f Boolean?) fìor: { Às-chur sgrìobh: ['T']. }.
(f Boolean?) breugach: { Às-chur sgrìobh: ['F']. }.



