Àireamh air: ['factorial'] dèan: {
	>> total := 1.
	{ :index total iomadaich-le: (fhèin - index). } × fhèin. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

{
2 exponent factorial.
Às-chur sgrìobh: (11 modalas: 3), loidhne-ùr.
Às-chur sgrìobh: (3.4 cruinnich), loidhne-ùr.
Às-chur sgrìobh: (7.1 cruinnich-suas), loidhne-ùr.
Às-chur sgrìobh: (7.9 cruinnich-sìos), loidhne-ùr.
}
tòisich.

Prògram sgioblaich.

usedMemory1 := (Prògram cuimhne ? 0).

{
2 exponent factorial.
Às-chur sgrìobh: (11 modalas: 3), loidhne-ùr.
Às-chur sgrìobh: (3.4 cruinnich), loidhne-ùr.
Às-chur sgrìobh: (7.1 cruinnich-suas), loidhne-ùr.
Às-chur sgrìobh: (7.9 cruinnich-sìos), loidhne-ùr.
}
tòisich.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


{
2 exponent factorial.
Às-chur sgrìobh: (11 modalas: 3), loidhne-ùr.
Às-chur sgrìobh: (3.4 cruinnich), loidhne-ùr.
Às-chur sgrìobh: (7.1 cruinnich-suas), loidhne-ùr.
Às-chur sgrìobh: (7.9 cruinnich-sìos), loidhne-ùr.
} tòisich.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
