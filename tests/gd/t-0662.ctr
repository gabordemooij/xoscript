>> t := Neoni.

# you can control the time zone for
# parsing like this:
Àm sòn: ['CET'].
t := Àm bho: ['1981-02-03 04:05:06'].
Às-chur sgrìobh: t, loidhne-ùr.

# now using CEST time zone:
Àm sòn: ['CEST'].
t := Àm bho: ['1981-02-03 04:05:06'].
Às-chur sgrìobh: t, loidhne-ùr.

# error if string cannot be parsed
{ Àm bho: ['1900']. } glac: { Neoni. }, tòisich.
