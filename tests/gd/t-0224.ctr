
>> countries := Liosta ùr
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liosta ùr
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods le: countries, gach: { :key :value
	counter cuir-ris-àireamh: 1.
}.

Às-chur sgrìobh: (['we serve counter dishes'] counter: counter), loidhne-ùr.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caractaran seòrsaich: { :v
	counter cuir-ris-àireamh: 0.
}.

Às-chur sgrìobh: (['we sort counter dishes'] counter: counter), loidhne-ùr.


>> counter := 0.
{
	{
		counter cuir-ris-àireamh: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Às-chur sgrìobh: (['we calculate counter numbers.'] counter: counter), loidhne-ùr.

