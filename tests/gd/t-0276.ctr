>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Oibseact ùr.
⚄ air: ['drawFrom:length:'] dèan: { :pool :cunnt
	
	>> result := [''].
	
	{
		>> index := Àireamh random % (pool faid).
		result cuir-ris: ( pool caractar: (index + 1) ).
		
	} × cunnt. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? faid.
Às-chur sgrìobh: (['x↵'] x random faid).
Às-chur sgrìobh: (['y↵'] y ?? faid).

