

Prògram sgioblaich.


>> Veggy := Oibseact ùr.
Veggy air: ['ùr'] dèan: {
	>> v := fhèin ùr.
	v init. <- v.
}.

Veggy air: ['init'] dèan: { leis veggies := 0. }.

Veggy air: ['carrots:'] dèan: { :a leis veggies := a. <- Neoni. }.
Veggy air: ['carrots'] dèan: { <- leis veggies. }.
Veggy air: ['+'] dèan: { :f
	>> n := Veggy ùr.
	n carrots: (f carrots + leis veggies). <- n.
}.

Veggy air: ['sreang'] dèan: { <- leis veggies sreang.
}.

Àireamh air: ['carrots'] dèan: {
	>> x := Veggy ùr.
	x carrots: fhèin. <- x.
}.

Àireamh air: ['add:and:'] dèan: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Às-chur sgrìobh: q, loidhne-ùr.
