


>> wine := Oibseact ùr.


wine air: ['toString'] dèan: { <- ['merlot'].
}.

wine air: ['naarTekst'] dèan: { <- ['merlot'].
}.


wine air: ['='] dèan: { :other wine <- ( fhèin toString = other wine ).
}.

wine air: ['=='] dèan: { :other wine <- ( fhèin toString = other wine ).
}.



wine
	cùis: ['cabernet'] dèan: { Às-chur sgrìobh: ['it's a Cabernet!']. },
	cùis: ['syrah']    dèan: { Às-chur sgrìobh: ['it's a Syrah!'].    },
	cùis: ['merlot']   dèan: { Às-chur sgrìobh: ['it's a Merlot!'].   },
	cùis: ['malbec']   dèan: { Às-chur sgrìobh: ['it's a Malbec!'].   }.

Às-chur loidhne-ùr.
