>> Greeter := Oibseact ùr.
Greeter air: ['make'] dèan: {
	>> greeter := Oibseact ùr.
	greeter air: ['name:'] dèan: { :ainm
		Às-chur sgrìobh: ['setting a name'].
		leis myName := ainm.
	}.
	greeter air: ['performGreeting'] dèan: {
		Às-chur sgrìobh: ['Hello'].
		Às-chur sgrìobh: leis myName.
	}.
	greeter air: ['greet'] dèan: {
		fhèin performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
