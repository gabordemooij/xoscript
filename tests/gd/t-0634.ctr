# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Prògram shell-escape: ['abc'].
Às-chur sgrìobh: c, loidhne-ùr.
Às-chur sgrìobh: ( Prògram siostam: ['echo '] + c ), loidhne-ùr.

c := Prògram shell-escape: ['a'b'c'].
Às-chur sgrìobh: c, loidhne-ùr.
Às-chur sgrìobh: ( Prògram siostam: ['echo '] + c ), loidhne-ùr.

c := Prògram shell-escape: ['a\'c'].
Às-chur sgrìobh: c, loidhne-ùr.
Às-chur sgrìobh: ( Prògram siostam: ['echo '] + c ), loidhne-ùr.