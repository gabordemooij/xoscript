>> q := Liosta ← 1 ; 2 ; 3.
{ q ? ['1']. } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? Fìor. } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? Breugach. } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? Neoni. } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? (Liosta ùr). } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? (Oibseact ùr). } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
{ q ? ({ ['Empty']. }). } glac: { Às-chur sgrìobh: ['caught!'], loidhne-ùr. }, tòisich.
Às-chur sgrìobh: ['caught them all'], loidhne-ùr.
