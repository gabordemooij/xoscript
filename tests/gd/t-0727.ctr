Server init.
>> f := Fòrmat ùr: ['%d'].
>> a := Blob ùr: 4.
a bytes: ( Liosta ùr ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ùr: 4.
b bytes: ( Liosta ùr ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a bho: 0 faid: 3, gach: { :i :byte
	Às-chur sgrìobh: ( f cuir-an-gnìomh-slàn-àireamh: byte ), loidhne-ùr.
}.
a ^ b.
a bho: 0 faid: 3, gach: { :i :byte
	Às-chur sgrìobh: ( f cuir-an-gnìomh-slàn-àireamh: byte ), loidhne-ùr.
}.
a ^ b.
a bho: 0 faid: 3, gach: { :i :byte
	Às-chur sgrìobh: ( f cuir-an-gnìomh-slàn-àireamh: byte ), loidhne-ùr.
}.
a saor.
b saor.

{ a ^ Oibseact. } glac: { :e Às-chur sgrìobh: e, loidhne-ùr. }, tòisich.
