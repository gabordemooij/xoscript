>> items := Faclair ùr.
items cuir: ['black'] aig: ['coffee'], cuir: ['earl grey'] aig: ['tea'].
Às-chur sgrìobh: (items aig: ['coffee']), sgrìobh: (items aig: ['tea']).
Às-chur sgrìobh: ['there are'] + items cunnt + [' items in the array.'].
items cuir: ['capuccino'] aig: ['coffee'].
Às-chur sgrìobh: ['Now my coffee is.. '] + (items aig: ['coffee']).
items cuir: ['aaa'] aig: ['1'].
items cuir: ['bbb'] aig: ['2'].
Às-chur sgrìobh: (items aig: ['a']).
