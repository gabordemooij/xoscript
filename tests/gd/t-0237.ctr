
Sreang air: ['evaluate'] dèan: {
	>> còd := Faidhle ùr: ['/tmp/eval.ctr'].
	còd sgrìobh: (fhèin sreang + ['.']).
	Prògram cleachd: ['/tmp/eval.ctr'].
}.

>> map :=
	(Faclair ùr)
	cuir: ['Hi There'] aig: ['two'],
	cuir: (Liosta ← ['hello'] ; ['world'] ; (Liosta ← 1 ; 2; 9) ; Breugach) aig: ['one'],
	cuir: ( (Faclair ùr) cuir: ['wrrld'] aig: ['misspelled'] ) aig: ['three'],
	cuir: (Liosta ← ((Faclair ùr) cuir: ['treasure'] aig: ['hidden']) ; 2) aig: ['four']. 
>> str := map sreang.
>> map2 := Neoni.
(['map2 := '] + str ) evaluate.
Às-chur sgrìobh: map2 ? ['one'] ? 0.
Às-chur sgrìobh: map2 ? ['one'] ? 1.
Às-chur sgrìobh: map2 ? ['four'] ? 0 ? ['hidden'].
Às-chur sgrìobh: map2 ? ['one'] ? 2 ? 2.
