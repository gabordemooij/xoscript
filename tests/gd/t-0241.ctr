

Sreang air: ['evaluate'] dèan: {
	>> còd := Faidhle ùr: ['/tmp/eval.ctr'].
	còd sgrìobh: (fhèin sreang + ['.']).
	Prògram cleachd: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liosta ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q sreang.
Às-chur sgrìobh: x, loidhne-ùr.
>> y := Neoni.
(['y := '] + x ) evaluate.
Às-chur sgrìobh: y ? 0, loidhne-ùr.

q := Faclair cuir: ['\[''] aig: ['\['quote\']'].
x := q sreang.
Às-chur sgrìobh: x, loidhne-ùr.
y := Neoni.
(['y := '] + x ) evaluate.

>> q := (Faclair ùr) cuir:['\[''] aig:['\['quote\[''].
Às-chur sgrìobh: y ? ['\['quote\']'], loidhne-ùr.
