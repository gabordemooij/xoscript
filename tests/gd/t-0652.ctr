# test number -> string -> number
{

	>> x := Àireamh eadar: 0 agus: 1000000.
	>> d := Àireamh eadar: 1 agus: 7.
	>> e := 10 cumhachd: d.

	x roinn-le: e.
	>> y := x sreang àireamh.

	(x = y) breugach: {
		Às-chur sgrìobh: x, loidhne-ùr.
		Às-chur sgrìobh: y, loidhne-ùr.
		Prògram deireadh.
	}.

} * 1000.
Às-chur sgrìobh: ['OK'], loidhne-ùr.