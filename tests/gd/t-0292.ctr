>> winery := { <- (	Faclair ùr
		cuir: 2 aig: ['merlot'],
		cuir: 3 aig: ['malbec'],
		cuir: 4 aig: ['syrah']
	).
}.

Às-chur sgrìobh: (((winery tòisich) - ['nothing']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['merlot']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['malbec']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['syrah']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['merlot'] - ['malbec']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['merlot'] - ['syrah']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['malbec'] -['syrah']) cunnt), loidhne-ùr.
Às-chur sgrìobh: (((winery tòisich) - ['malbec'] - ['syrah'] - ['merlot']) cunnt), loidhne-ùr.

