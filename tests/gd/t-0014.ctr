>> Greeter := Oibseact ùr.
Greeter air: ['make'] dèan: {
	>> gr := Oibseact ùr.
	gr air: ['setName:'] dèan: { :aname
		leis ainm := aname.
	}.
	gr air: ['greet'] dèan: {
		Às-chur sgrìobh: leis ainm.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ùr.
c setName: ['THREE'].
c greet.
>> d := a ùr.
d setName: ['FOUR'].
d greet.
c greet.
