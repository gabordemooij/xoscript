

>> obj := Oibseact ùr.

obj air: ['greet'] dèan: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj air: ['task'] dèan: {
	leis property := 123.
	{
		# try binds self/own to object instead of block
		Às-chur sgrìobh: fhèin greet.
		Às-chur sgrìobh: leis property.
		1 / 0.
	} glac: {
		Às-chur sgrìobh: fhèin greet.
		Às-chur sgrìobh: leis property.
		Às-chur sgrìobh: ['ok'].
	}, feuch.
}.

obj task.