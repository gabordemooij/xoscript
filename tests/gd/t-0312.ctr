>> Slurp := Oibseact ùr.
Slurp air: ['ùr'] dèan: {
	leis str := [''].
}.
Slurp ionnsaich: ['nieuw'] ciallachadh: ['ùr'].
Slurp air: ['freagair:'] dèan: { :blah
		(leis str ≠ ['']) fìor: {
			leis str cuir-ris: [' '].
		}.
		leis str cuir-ris: blah.
}.
Slurp air: ['freagair:agus:'] dèan: { :blah :blahah
		(leis str ≠ ['']) fìor: {
			leis str cuir-ris: [' '].
		}.
		(blah faid > 1) fìor: {
			leis str cuir-ris: (blah bho: 0 faid: (blah faid - 1)).
		}, eile: {
			leis str cuir-ris: blah.
		}.
		leis str cuir-ris: [' '].
		leis str cuir-ris: blahah.
}.
Slurp air: ['obtain'] dèan: {
	>> buffer := leis str.
	leis str := ['']. <- buffer.
}.


>> paramadairean-luirg := Slurp ùr
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Às-chur sgrìobh: paramadairean-luirg obtain, loidhne-ùr.
