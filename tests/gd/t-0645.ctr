Server init.
Às-chur sgrìobh: ['Database date test'], loidhne-ùr.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'], 
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg :=
db ceist: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
faigh: { :row
	Às-chur sgrìobh: row datetest, loidhne-ùr.
}.
