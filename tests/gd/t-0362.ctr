Às-chur sgrìobh: (['a:b:'] - [':']), loidhne-ùr.
Às-chur sgrìobh: (['Lorem Ipsum'] - ['Ipsum']), loidhne-ùr.
Às-chur sgrìobh: (['a.................b.......................c...........'] - ['.']), loidhne-ùr.
Às-chur sgrìobh: (['a--b--c---d'] - ['--']), loidhne-ùr.
Às-chur sgrìobh: (['-'] - ['--']), loidhne-ùr.
Às-chur sgrìobh: ([''] - ['--']), loidhne-ùr.
Às-chur sgrìobh: (['--'] - ['']), loidhne-ùr.
Às-chur sgrìobh: ([''] - ['']), loidhne-ùr.
>> x := ['xx'].
>> y := x - ['x'].
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: y, loidhne-ùr.
>> x := ['a,bb,c'].
>> y := x cuir-an-àite: [''] le: ['xx'].
Às-chur sgrìobh: ((x co-ionann: y) an-dàrna-cuid: ['OK'] no: ['BUG! Did return a copy by accident!']), loidhne-ùr.