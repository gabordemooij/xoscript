# test qualifiers

>> $ := Oibseact ùr.

$ air: ['freagair:'] dèan: { :x
	
	>> operation := x caractar: 0.
	>> valuta := x caractar: 1.
	>> money := x frith-àireamh: 2.
	
	>> amount := 0.

	( operation = ['+'] ) fìor: {
		( valuta = ['£'] ) fìor: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Às-chur sgrìobh: x, loidhne-ùr.


>> Fruit := Oibseact ùr.

Fruit air: ['ùr'] dèan: {
	>> f := fhèin ùr.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit air: ['apples:'] dèan: { :a leis apples := a. }.
Fruit air: ['oranges:'] dèan: { :p leis oranges := p. }.
Fruit air: ['apples'] dèan: { <- leis apples. }.
Fruit air: ['oranges'] dèan: { <- leis oranges. }.

Fruit air: ['+'] dèan: { :f
	
	>> n := Fruit ùr.
	f cuir-ris-àireamh: 1.
	
	n apples: (f apples + leis apples).
	n oranges:  (f oranges  + leis oranges). <- n.
}.

Fruit air: ['sreang'] dèan: { <- ( leis apples sreang + [' apples and '] + leis oranges + [' oranges'] ).
}.

Àireamh air: ['apples'] dèan: { <- ((Fruit ùr) apples: fhèin).
}.

Àireamh air: ['apple'] dèan: { <- ((Fruit ùr) apples: fhèin).
}.

Àireamh air: ['oranges'] dèan: { <- ((Fruit ùr) oranges: fhèin).
}.




Às-chur sgrìobh: (1 apple + 3 oranges + 4 apples), loidhne-ùr.


Sreang air: ['twice'] dèan: { <- ((fhèin sreang) + (fhèin sreang)).
}.



Às-chur sgrìobh: ['❤❤❤'] twice.



