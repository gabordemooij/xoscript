{
	an-obair-seo mearachd: ['Dont fail.'].
	unknown doSomething.
} glac: {
	Às-chur sgrìobh: ['Caught!'].
}, tòisich.

{
	an-obair-seo mearachd: ['Dont fail.'].
	leis unknown doSomething.
} glac: {
	Às-chur sgrìobh: ['Caught!'].
}, tòisich.

{
	an-obair-seo mearachd: ['Dont fail.'].
	unknown := 122.
} glac: {
	Às-chur sgrìobh: ['Caught!'].
}, tòisich.


{
	an-obair-seo mearachd: ['Dont fail.'].
	Fìor bris.
	Às-chur sgrìobh: ['FAIL'].
} glac: {
	Às-chur sgrìobh: ['Caught!'].
}, tòisich.

{
	{
		an-obair-seo mearachd: ['Dont fail.'].
		Fìor bris.
		Às-chur sgrìobh: ['FAIL'].
	} glac: { :x
		(x = ['Dont fail.']) fìor: { an-obair-seo mearachd: ['Nested Caught!']. }.
	}, tòisich.
} glac: { :e
	Às-chur sgrìobh: e.
}, tòisich.
