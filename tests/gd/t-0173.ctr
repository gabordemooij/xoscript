

Liosta air: ['sum'] dèan: {
	>> total := 0.
	fhèin gach: { :index :element
		total cuir-ris-àireamh: element.
	}. <- total.
}.

Liosta air: ['product'] dèan: {
	>> total := 1.
	fhèin gach: { :index :element
		total iomadaich-le: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

{

>> a := Liosta ← ['hello'] ; ['world'] ; Fìor ; Neoni ; 666.
a := a + ( Liosta ← 1 ).
Às-chur sgrìobh: ( ['sum: '] + ( a sum ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['min: '] + ( a as-ìsle ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['max: '] + ( a as-àirde ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['3rd: '] + ( a ? 2 ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['prd: '] + ( a product ) ), loidhne-ùr.
a seòrsaich: { :a :b <- (b - a). }.
a gach: { :i :e Às-chur sgrìobh: ( i - 0 ), loidhne-ùr. }.

} tòisich.

Prògram sgioblaich.
usedMemory1 := (Prògram cuimhne ? 0).


{

>> a := Liosta ← ['hello'] ; ['world'] ; Fìor ; Neoni ; 666.
a := a + ( Liosta ← 1 ).
Às-chur sgrìobh: ( ['sum: '] + ( a sum ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['min: '] + ( a as-ìsle ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['max: '] + ( a as-àirde ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['3rd: '] + ( a ? 2 ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['prd: '] + ( a product ) ), loidhne-ùr.
a seòrsaich: { :a :b <- (b - a). }.
a gach: { :i :e Às-chur sgrìobh: ( i - 0 ), loidhne-ùr. }.

} tòisich.



Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


{

>> a := Liosta ← ['hello'] ; ['world'] ; Fìor ; Neoni ; 666.
a := a + ( Liosta ← 1 ).
Às-chur sgrìobh: ( ['sum: '] + ( a sum ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['min: '] + ( a as-ìsle ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['max: '] + ( a as-àirde ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['3rd: '] + ( a ? 2 ) ), loidhne-ùr.
Às-chur sgrìobh: ( ['prd: '] + ( a product ) ), loidhne-ùr.
a seòrsaich: { :a :b <- (b - a). }.
a gach: { :i :e Às-chur sgrìobh: ( i - 0 ), loidhne-ùr. }.

} tòisich.



Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).

( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
