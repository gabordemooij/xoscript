>> usedMemory5 := (Prògram cuimhne ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) fìor: {
	Às-chur sgrìobh: ['Memory usage remains stable.'], loidhne-ùr.
}, eile: {
	Às-chur sgrìobh: ['Used memory not stable.'], loidhne-ùr.
	Às-chur sgrìobh: usedMemory1, loidhne-ùr.
	Às-chur sgrìobh: usedMemory2, loidhne-ùr.
