Server init.
Às-chur sgrìobh: ['Database time test'], loidhne-ùr.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'], 
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg :=
db ceist: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
faigh: { :row
	Às-chur sgrìobh: row timetest, loidhne-ùr.
}.
