
Sreang air: ['html'] dèan: { <- (
		fhèin
		cuir-an-àite: ['&'] le: ['&amp;'],
		cuir-an-àite: ['<'] le: ['&lt;'],
		cuir-an-àite: ['>'] le: ['&gt;'],
		cuir-an-àite: ['"'] le: ['&quot;']
	).
}.

>> HtmlBrush := Oibseact ùr.

HtmlBrush air: ['freagair:'] dèan: { :tag
	Às-chur sgrìobh: (['<tag>↵'] tag: tag ).
}.

HtmlBrush air: ['freagair:agus:'] dèan: { :tag :content
	tag := ( tag bho: 0 faid: (tag faid - 1) ).
	Às-chur sgrìobh: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush air: ['content:'] dèan: { :text
	Às-chur sgrìobh: text html, loidhne-ùr.
}.

HtmlBrush air: ['attr:value:'] dèan: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ùr.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
