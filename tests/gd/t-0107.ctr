
Às-chur sgrìobh: ['Break for-loop, 0-4.'], loidhne-ùr.
{ :i
	Às-chur sgrìobh: ['iteration #'] + i, loidhne-ùr.
	(i = 4) bris.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Às-chur sgrìobh: ['Break while-true loop, 0-4.'], loidhne-ùr.
{
	Às-chur sgrìobh: ['iteration #'] + x, loidhne-ùr.
	x cuir-ris-àireamh: 1.
	((x < 5) chan-e) bris.
} fhad-sa: xIsLessThan10.

Às-chur sgrìobh: ['Break while-false loop, 5,4.'], loidhne-ùr.
{
	Às-chur sgrìobh: ['iteration #'] + x, loidhne-ùr.
	x thoir-air-falbh: 1.
	(x = 3) bris.
} fhad-sa: { <- (x > 0). }.

Às-chur sgrìobh: ['Break times loop, 1-4.'], loidhne-ùr.
{ :i
	Às-chur sgrìobh: ['iteration #'] + i, loidhne-ùr.
	(i = 4) bris.
} × 5.

Às-chur sgrìobh: ['Break block, dont print line.'], loidhne-ùr.
{ Fìor bris. Às-chur sgrìobh: ['dont write this!'], loidhne-ùr. } tòisich.

Às-chur sgrìobh: ['Break block, dont fire catch...'], loidhne-ùr.
{ Fìor bris. Às-chur sgrìobh: ['dont write this!'], loidhne-ùr. } glac: { Às-chur sgrìobh: ['Dont catch this!']. }, tòisich.

Às-chur sgrìobh: ['Test Array each-loop: 0,1'], loidhne-ùr.
(Liosta ← 1 ; 2 ; 3) mapaich: { :i
	Às-chur sgrìobh: ['iteration #'] + i, loidhne-ùr.
	(i = 1) bris.
}.

Às-chur sgrìobh: ['Test Map each-loop: c only'], loidhne-ùr.
>> m := Faclair ùr.
m cuir: ['first'] aig: ['a'], cuir: ['second'] aig: ['b'], cuir: ['third'] aig: ['c'].
m gach: { :k :v
	Às-chur sgrìobh: ['iteration'] + v + k, loidhne-ùr.
	Fìor bris.
}.

