
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> còd := {
	>> o := (
		Faclair ùr
		aa: (Liosta ← 1 ; 2),
		bb: (Liosta ← 3 ; 4)
	).
	>> s := o sreang.
	>> o2 := s oibseact.
	(s  seòrsa = Sreang seòrsa) fìor: { Às-chur sgrìobh: ['OK1'], loidhne-ùr. }.
	(o2 seòrsa = Faclair seòrsa) fìor: { Às-chur sgrìobh: ['OK2'], loidhne-ùr. }.
}.

Prògram stiùireadh-cuimhne: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Prògram sgioblaich.
usedMemory1 := (Prògram cuimhne ? 1).
còd tòisich.
Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 1).
còd tòisich.
Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 1).
còd tòisich.
Prògram sgioblaich.
usedMemory4 := (Prògram cuimhne ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) fìor: { Às-chur sgrìobh: ['OK3'], loidhne-ùr. }.
 
