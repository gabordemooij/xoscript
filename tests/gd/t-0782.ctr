Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> cmd := Àithne ùr.
Às-chur sgrìobh: cmd ls /tmp, loidhne-ùr.
>> old-cmd-address := cmd prìomh-shamhla seòladh-cuimhne.
cmd save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
(b prìomh-shamhla seòladh-cuimhne = old-cmd-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
Às-chur sgrìobh: b ls, loidhne-ùr.


