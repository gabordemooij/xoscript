# Test ASCII variants

# Numbers

Às-chur sgrìobh: (2 !=: 3), loidhne-ùr.
Às-chur sgrìobh: (2 <=: 2), loidhne-ùr.
Às-chur sgrìobh: (2 >=: 2), loidhne-ùr.

# Strings

Às-chur sgrìobh: (['b'] >=: ['a']), loidhne-ùr.
Às-chur sgrìobh: (['b'] !=: ['a']), loidhne-ùr.
Às-chur sgrìobh: (['b'] <=: ['c']), loidhne-ùr.

# Bools

Às-chur sgrìobh: (Fìor !=: Breugach), loidhne-ùr.

# Objects

Às-chur sgrìobh: (Oibseact ùr !=: Oibseact ùr), loidhne-ùr.

# ASCII list symbol <-:

Às-chur sgrìobh: (Liosta <<: 1, ; 2 ; 3) cunnt = 3, loidhne-ùr.

