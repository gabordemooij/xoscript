>> str := ['write:'].
Às-chur teachdaireachd: ['sgrìobh:'] argamaidean: (Liosta ← ['Hello World']), loidhne-ùr. 

Àireamh air: ['isbetween:and:'] dèan: { :a :b <- ((fhèin ≥ a) agus: (fhèin ≤ b)).
}.

str := ['isbetween:and:'].
Às-chur sgrìobh: (3 teachdaireachd: str argamaidean: (Liosta ← 2 ; 8)), loidhne-ùr.
Às-chur sgrìobh: (3 teachdaireachd: str argamaidean: (Liosta ← 1 ; 2)), loidhne-ùr.


>> CoffeeMachine := Oibseact ùr.
CoffeeMachine air: ['makeCoffeeWithSugar:milk:'] dèan: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liosta ← 4 ; 2.
Às-chur sgrìobh: ( CoffeeMachine teachdaireachd: order argamaidean: coffeeConfiguration ), loidhne-ùr.
