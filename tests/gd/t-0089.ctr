>> randomizer := { :a :b
	>> as-ìsle := ( a < b ) an-dàrna-cuid: a no: b.
	>> as-àirde := ( a > b ) an-dàrna-cuid: a no: b.
	>> x := Neoni.
	{
		x := Àireamh eadar: a agus: b.
		((x < as-ìsle) no: (x > as-àirde)) fìor: { 
			Às-chur sgrìobh: (['Invalid value!']).
			Prògram deireadh.
		}.
	} 
	× 100. <- x.
}.
randomizer cuir-an-gnìomh: 0 agus: 0.
randomizer cuir-an-gnìomh: 1 agus: 0.
