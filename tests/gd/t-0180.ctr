Sreang air: ['html'] dèan: { <- (
		fhèin
		cuir-an-àite: ['&'] le: ['&amp;'],
		cuir-an-àite: ['<'] le: ['&lt;'],
		cuir-an-àite: ['>'] le: ['&gt;'],
		cuir-an-àite: ['''] le: ['&apos;'],
		cuir-an-àite: ['"'] le: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prògram stiùireadh-cuimhne: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Às-chur sgrìobh: txt dèan-lethbhreac html, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-beaga, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-mòra, loidhne-ùr.
} tòisich.

Prògram sgioblaich.

usedMemory1 := (Prògram cuimhne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Às-chur sgrìobh: txt dèan-lethbhreac html, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-beaga, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-mòra, loidhne-ùr.
} tòisich.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Às-chur sgrìobh: txt dèan-lethbhreac html, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-beaga, loidhne-ùr.
Às-chur sgrìobh: txt dèan-lethbhreac litrichean-mòra, loidhne-ùr.
} tòisich.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
