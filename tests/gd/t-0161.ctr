Prògram stiùireadh-cuimhne: 0.
Liosta air: ['sum'] dèan: {
	>> total := 0.
	fhèin gach: { :index :element
		total cuir-ris-àireamh: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faidhle ùr: ['/tmp/test.txt'].
f sgrìobh: ['Lorem Ipsum'].
f dùin.
  

f := Faidhle ùr: ['/tmp/test.txt'].
>> text := f leugh.
f dùin.



Prògram sgioblaich.
usedMemory1 := (Prògram cuimhne ? 1).



f := Faidhle ùr: ['/tmp/test.txt'].
text := f leugh.
f dùin.

Prògram sgioblaich.
usedMemory2 := (Prògram cuimhne ? 1).


f := Faidhle ùr: ['/tmp/test.txt'].
text := f leugh.
f dùin.

Prògram sgioblaich.
usedMemory3 := (Prògram cuimhne ? 1).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fìor: {
	Às-chur sgrìobh: ['No memory leaks here'].
}, breugach: {
	Às-chur sgrìobh: ['Leaking memory...'].
}.
