Server init.

# write a test file
>> f := Faidhle ùr: ['/tmp/test.gif'].
f sgrìobh: ['GIF87a01234567810'].

# serve the file
Server cuir-air-adhart: ['test.gif'] ro-leasachan: ['/tmp/'].

Às-chur loidhne-ùr.

Às-chur sgrìobh: ['Outside container (security):'], loidhne-ùr.
{ Server cuir-air-adhart: ['../passwd'] ro-leasachan: ['/tmp/']. }
glac: { :e Às-chur sgrìobh: e, loidhne-ùr. },
tòisich.

Às-chur sgrìobh: ['Invalid prefix:'], loidhne-ùr.
{ Server cuir-air-adhart: ['test.gif'] ro-leasachan: ['z:\\']. }
glac: { :e Às-chur sgrìobh: e, loidhne-ùr. },
tòisich.

Às-chur sgrìobh: ['Non-existant file:'], loidhne-ùr.
{ Server cuir-air-adhart: ['xxx.xxx'] ro-leasachan: ['/tmp/']. }
glac: { :e Às-chur sgrìobh: e, loidhne-ùr. },
tòisich.
