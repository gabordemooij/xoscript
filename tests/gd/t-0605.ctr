>> invoice := Oibseact ùr.
invoice air: ['tòisich'] dèan: {
        leis àireamh := 0.
}.

invoice air: ['àireamh'] dèan: {
        leis àireamh cuir-ris-àireamh: 1. <- leis àireamh dèan-lethbhreac.
}.

>> year-invoice := invoice ùr.
year-invoice air: ['start:'] dèan: { :bliadhna
	leis àireamh := bliadhna.
}.

year-invoice start: 202000.
Às-chur sgrìobh: year-invoice àireamh, loidhne-ùr.
Às-chur sgrìobh: year-invoice àireamh, loidhne-ùr.
