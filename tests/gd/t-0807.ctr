# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB ùr òstair: ['localhost'],
	ainm-cleachdaiche: ['xo'],
	facal-faire: ['pass123'],
	ainm-stòir-dàta: ['xobase'],
	ceangail-ris.

>> paramadairean-luirg := db ceist: ['SELECT %% FROM'].
{ paramadairean-luirg ruith-àithne. } glac: { :e
	Às-chur sgrìobh: ( e tha-ann: ['%%'] ), loidhne-ùr.
}, tòisich.
