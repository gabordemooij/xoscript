Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 
a air: ['item:'] dèan: { :int64
	leis int64 := int64. 
}.
a air: ['item'] dèan: { <- leis int64.
}.
a item: ( Int64 bho-shreang: ['9999'] ).
Às-chur sgrìobh: a item, loidhne-ùr.
>> old-int64-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
(b item prìomh-shamhla seòladh-cuimhne = old-int64-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
Às-chur sgrìobh: ( b item ), loidhne-ùr.
