>> x := Oibseact ùr.
>> y := Oibseact ùr.
>> z := x.
Às-chur sgrìobh: (x = z), loidhne-ùr.
Às-chur sgrìobh: (x = y), loidhne-ùr.
Às-chur sgrìobh: (x ≠ y), loidhne-ùr.
Às-chur sgrìobh: (x ≠ z), loidhne-ùr.
>> m := Àm ùr bliadhna: 2070, mìos: 11.
>> n := m dèan-lethbhreac.
Às-chur sgrìobh: (m = n), loidhne-ùr.
Às-chur sgrìobh: (m ≠ n), loidhne-ùr.
Às-chur sgrìobh: (m co-ionann: m), loidhne-ùr.
Às-chur sgrìobh: (m co-ionann: n), loidhne-ùr.
n mìos: 12.
Às-chur sgrìobh: (m ≠ n), loidhne-ùr.
Às-chur sgrìobh: (m = n), loidhne-ùr.


