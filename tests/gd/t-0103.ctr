>> a := Liosta ← Oibseact ; Fìor ; Breugach ; Boole ; 1 ; Àireamh ; ['Str'] ; Sreang ; { ['Empty']. }.
Às-chur sgrìobh: (a cunnt), loidhne-ùr.
{ :i
	Às-chur sgrìobh: 
	['a '] + 
	((a ? i) seòrsa) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Neoni?) an-dàrna-cuid: [''] no: ['NOT']) + 
	[' Nil.'],
	loidhne-ùr.
} × (a cunnt).
Às-chur sgrìobh: ['but.. Nil is.. '] + ((Neoni Neoni?) an-dàrna-cuid: ['certainly NIL!'] no: ['not NIL??']), loidhne-ùr.