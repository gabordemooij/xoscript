#Linux

(Faidhle ùr: ['/tmp/testje']) ann breugach: {
	Prògram siostam: ['mkdir /tmp/testje'].	
}.

(Faidhle ùr: ['/tmp/testje/file1']) ann breugach: {
	Prògram siostam: ['touch /tmp/testje/file1'].	
}.

(Faidhle ùr: ['/tmp/testje/folder1']) ann breugach: {
	Prògram siostam: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faidhle liosta: ['/tmp/testje'].

>> q := Liosta ùr.

l gach: { :k :v v gach: { :x :y q cuir-ris: y. }. }.

>> s := q sreang.

(s tha-ann: ['file1']) fìor:   { Às-chur sgrìobh: ['OK'], loidhne-ùr. }.
(s tha-ann: ['file2']) fìor:   { Às-chur sgrìobh: ['XX'], loidhne-ùr. }.
(s tha-ann: ['folder1']) fìor: { Às-chur sgrìobh: ['OK'], loidhne-ùr. }.
