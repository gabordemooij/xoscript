>> x := [' hallo '].

>> y := x litrichean-mòra.
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: (x co-ionann: y), loidhne-ùr.

>> y := x litrichean-beaga.
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: (x co-ionann: y), loidhne-ùr.

>> y := x beàrr.
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: (x co-ionann: y), loidhne-ùr.

>> y := x frith-àireamh: 1.
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: (x co-ionann: y), loidhne-ùr.

>> y := x bho: 1 faid: 2.
Às-chur sgrìobh: x, loidhne-ùr.
Às-chur sgrìobh: (x co-ionann: y), loidhne-ùr.