Às-chur sgrìobh: ((Liosta ùr
	air: ['plaque:'] dèan: { :x leis o := x. },
	air: ['plaque']  dèan: { <- leis o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liosta ← 1)
	~ (Liosta ← 1 ; 2)
	~ (Liosta ← 1 ; 2 ; 3)
	~ (Liosta ← 1 ; 2 ; 3 ; 4)
	~ (Liosta ← 1 ; 2 ; 3 ; 4 ; 5)
) gach: { :i :el
	{ Às-chur sgrìobh: an-obair-seo. } × el cunnt.
	Às-chur loidhne-ùr.
}) plaque, loidhne-ùr.


