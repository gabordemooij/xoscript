# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ùr: 8, bytes: (
	Liosta ùr ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Às-chur sgrìobh: ( utf16 dì-chòdaich: ['utf16le'] ), loidhne-ùr.

utf16 saor.
>> utf32 := Blob ùr: 13, bytes: (
	Liosta ùr ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Às-chur sgrìobh: ( utf32 dì-chòdaich: ['utf32be'] ), loidhne-ùr.
utf32 saor.