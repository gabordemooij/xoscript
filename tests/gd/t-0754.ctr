Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> a := Oibseact ùr. 

a air: ['item:'] dèan: { :out
	leis out := out. 
}.

a air: ['item'] dèan: { <- leis out.
}.

a air: ['greet'] dèan: {
	Às-chur sgrìobh: ['hi from original out!'], loidhne-ùr.
}.

a item: Às-chur.

Às-chur sgrìobh: a item, loidhne-ùr.

>> old-out-address := a item prìomh-shamhla seòladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.

>> b := Oibseact load-from: ['/tmp/a.bin'].

(b item prìomh-shamhla seòladh-cuimhne = old-out-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.

b item sgrìobh: ['hello from loaded out!'], loidhne-ùr.
b greet.
