



>> CoffeeGrounds := Oibseact ùr.
CoffeeGrounds air: ['extract'] dèan: { <- ['coffee']. }.

>> CoffeeMachine := Oibseact ùr.
CoffeeMachine air: ['init'] dèan: {
	leis coffeegrounds := CoffeeGrounds ùr.
}.
CoffeeMachine air: ['ùr'] dèan: { <- CoffeeMachine `new init.
}.

CoffeeMachine air: ['makeTea'] dèan: { <- (leis tealeaves extract). }.
CoffeeMachine air: ['makeCoffee'] dèan: { <- (leis coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ùr.

Às-chur sgrìobh:
	coffeeDream 
	makeCoffee.

Às-chur sgrìobh:
	coffeeDream 
	makeTea.
