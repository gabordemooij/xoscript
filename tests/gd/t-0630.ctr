#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Pàtran ùr: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern maids: subject dèan: { :m :x
	Às-chur sgrìobh: m, loidhne-ùr.
	Às-chur sgrìobh: x, loidhne-ùr. <- ['XXX'].
}.
Às-chur sgrìobh: result, loidhne-ùr.