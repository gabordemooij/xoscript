>> HTML := Oibseact ùr.
HTML air: ['freagair:'] dèan: { :tag 
	Às-chur sgrìobh: (['<tag>'] tag: tag), loidhne-ùr.
}.
HTML air: ['freagair:agus:'] dèan: { :tag :html 
	Às-chur sgrìobh: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), loidhne-ùr.
}.
>> html := HTML ùr.
html body h1: ['header'].

