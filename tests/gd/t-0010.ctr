>> Animal := Oibseact ùr.
Animal air: ['make'] dèan: {
	>> animal := Oibseact ùr.
	animal air: ['makeSound'] dèan: {
		Às-chur sgrìobh: leis sound.
	}. <- animal.
}.
>> Cat := Oibseact ùr.
Cat air: ['make'] dèan: {
	>> cat := Animal make.
	cat air: ['init'] dèan: {
		leis sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
