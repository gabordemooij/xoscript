
>> city := Liosta ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liosta ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature le: city.
>> cities := weather inntrigidhean seòrsaich: { :a :b <- (a dèan-coimeas: b). }.
>> temperatures := weather luachan seòrsaich: { :a :b <- (a dèan-coimeas: b) àicheil?. }.

Às-chur sgrìobh: (cities ceangail: [',']), loidhne-ùr.
Às-chur sgrìobh: (temperatures ceangail: [',']), loidhne-ùr.
