#Linux
>> OS := Prògram siostam: (Àithne uname -s), beàrr.

>> Slurp := Oibseact ùr.
Slurp air: ['ùr'] dèan: {
	leis str := [''].
}.
Slurp air: ['freagair:'] dèan: { :blah
		(leis str ≠ ['']) fìor: {
			leis str cuir-ris: [' '].
		}.
		leis str cuir-ris: blah.
}.
Slurp air: ['freagair:agus:'] dèan: { :blah :blahah
		(leis str ≠ ['']) fìor: {
			leis str cuir-ris: [' '].
		}.
		(blah faid > 1) fìor: {
			leis str cuir-ris: (blah bho: 0 faid: (blah faid - 1)).
		}, eile: {
			leis str cuir-ris: blah.
		}.
		leis str cuir-ris: [' '].
		leis str cuir-ris: blahah.
}.
Slurp air: ['obtain'] dèan: {
	>> buffer := leis str.
	leis str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text cuir-ris: ['hello'].
} × 1000.


Às-chur sgrìobh: (
	Prògram siostam: (
		Slurp ùr
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

