Às-chur sgrìobh: ['Test object'], loidhne-ùr.
>> l := Liosta ùr ; 1 ; ( Liosta ùr ; (Àm ùr: 1) ; (Int64 bho-shreang: ['321']) ; (Liosta ùr ; 3)).
Às-chur sgrìobh: l, loidhne-ùr.
>> old-lst-address := l prìomh-shamhla seòladh-cuimhne.
l save-as: ['/tmp/a.bin'].
Às-chur sgrìobh: ['========== RELOADING SNAP:'], loidhne-ùr.
>> b := Oibseact load-from: ['/tmp/a.bin'].
(b prìomh-shamhla seòladh-cuimhne = old-lst-address) fìor: {
	Às-chur sgrìobh: ['Object link re-attached.'], loidhne-ùr.
}.
Às-chur sgrìobh: b, loidhne-ùr.
