


>> wine := Gwrthrych newydd.


wine ar: ['toString'] gwneud: { <- ['merlot'].
}.

wine ar: ['naarTekst'] gwneud: { <- ['merlot'].
}.


wine ar: ['='] gwneud: { :other wine <- ( hun toString = other wine ).
}.

wine ar: ['=='] gwneud: { :other wine <- ( hun toString = other wine ).
}.



wine
	achos: ['cabernet'] gwneud: { Allbwn ysgrifennu: ['it's a Cabernet!']. },
	achos: ['syrah']    gwneud: { Allbwn ysgrifennu: ['it's a Syrah!'].    },
	achos: ['merlot']   gwneud: { Allbwn ysgrifennu: ['it's a Merlot!'].   },
	achos: ['malbec']   gwneud: { Allbwn ysgrifennu: ['it's a Malbec!'].   }.

Allbwn llinell-newydd.
