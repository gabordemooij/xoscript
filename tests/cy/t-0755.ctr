Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> greeter := Gwrthrych newydd.
greeter ar: ['name:'] gwneud: { :enw
	eiddo xname := enw. 
}.
greeter ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: ['Hello '] + eiddo xname, llinell-newydd.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
