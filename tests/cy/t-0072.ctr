>> echo := Gwrthrych newydd.
echo ar: ['ymateb:'] gwneud: { :sound
	{ Allbwn ysgrifennu: sound. } × 2.
}.
echo ho!. 


echo := Gwrthrych newydd.
echo ar: ['ymateb:a:'] gwneud: { :sound :x
	{ Allbwn ysgrifennu: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Gwrthrych newydd.
echo ar: ['ymateb:a:a:'] gwneud: { :operation :sound :x
	{ Allbwn ysgrifennu: sound. } × x.
}.
echo shout: ['la'] times: 4. 


