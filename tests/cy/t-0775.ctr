Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> l := Rhestr newydd ; 1 ; ( Rhestr newydd ; (Ennyd newydd: 1) ; (Int64 o-linyn: ['321']) ; (Rhestr newydd ; 3)).
Allbwn ysgrifennu: l, llinell-newydd.
>> old-lst-address := l prototeip cyfeiriad-cof.
l save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
(b prototeip cyfeiriad-cof = old-lst-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
Allbwn ysgrifennu: b, llinell-newydd.
