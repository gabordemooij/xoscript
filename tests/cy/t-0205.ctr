>> str := ['write:'].
Allbwn neges: ['ysgrifennu:'] dadleuon: (Rhestr ← ['Hello World']), llinell-newydd. 

Rhif ar: ['isbetween:and:'] gwneud: { :a :b <- ((hun ≥ a) a: (hun ≤ b)).
}.

str := ['isbetween:and:'].
Allbwn ysgrifennu: (3 neges: str dadleuon: (Rhestr ← 2 ; 8)), llinell-newydd.
Allbwn ysgrifennu: (3 neges: str dadleuon: (Rhestr ← 1 ; 2)), llinell-newydd.


>> CoffeeMachine := Gwrthrych newydd.
CoffeeMachine ar: ['makeCoffeeWithSugar:milk:'] gwneud: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Rhestr ← 4 ; 2.
Allbwn ysgrifennu: ( CoffeeMachine neges: order dadleuon: coffeeConfiguration ), llinell-newydd.
