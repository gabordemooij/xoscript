Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :out
	eiddo out := out. 
}.

a ar: ['item'] gwneud: { <- eiddo out.
}.

a ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: ['hi from original out!'], llinell-newydd.
}.

a item: Allbwn.

Allbwn ysgrifennu: a item, llinell-newydd.

>> old-out-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-out-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.

b item ysgrifennu: ['hello from loaded out!'], llinell-newydd.
b greet.
