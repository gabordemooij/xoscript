Server init.
>> a := Blob newydd: 4.
a bytes: ( Rhestr newydd ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob newydd: 4.
b bytes: ( Rhestr newydd ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Ffeil newydd: ['noblob???'] ).
} dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn.
a rhyddhau.
b rhyddhau.
