>> list := Rhestr newydd.
list ~ ['hello'].
Allbwn ysgrifennu: list cyfrif.
list atodi: ['world'].
Allbwn ysgrifennu: list cyfrif.
Allbwn ysgrifennu: list tynnu-olaf, ysgrifennu: list cyfrif.
list atodi: ['there'].
Allbwn ysgrifennu: list cyfrif.
Allbwn ysgrifennu: (list safle: 0), ysgrifennu: (list safle: 1).
list rhoi: ['xmas'] yn: 1.
list rhoi: ['merry'] yn: 0.
Allbwn ysgrifennu: list cyfrif.
Allbwn ysgrifennu: (list safle: 0), ysgrifennu: (list safle: 1).
