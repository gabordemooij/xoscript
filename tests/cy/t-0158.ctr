>> x := [' hallo '].

>> y := x priflythrennau.
Allbwn ysgrifennu: x, llinell-newydd.
Allbwn ysgrifennu: (x hafal: y), llinell-newydd.

>> y := x llythrennau-bach.
Allbwn ysgrifennu: x, llinell-newydd.
Allbwn ysgrifennu: (x hafal: y), llinell-newydd.

>> y := x tocio.
Allbwn ysgrifennu: x, llinell-newydd.
Allbwn ysgrifennu: (x hafal: y), llinell-newydd.

>> y := x atred: 1.
Allbwn ysgrifennu: x, llinell-newydd.
Allbwn ysgrifennu: (x hafal: y), llinell-newydd.

>> y := x o: 1 hyd: 2.
Allbwn ysgrifennu: x, llinell-newydd.
Allbwn ysgrifennu: (x hafal: y), llinell-newydd.