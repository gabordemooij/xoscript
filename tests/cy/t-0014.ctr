>> Greeter := Gwrthrych newydd.
Greeter ar: ['make'] gwneud: {
	>> gr := Gwrthrych newydd.
	gr ar: ['setName:'] gwneud: { :aname
		eiddo enw := aname.
	}.
	gr ar: ['greet'] gwneud: {
		Allbwn ysgrifennu: eiddo enw.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a newydd.
c setName: ['THREE'].
c greet.
>> d := a newydd.
d setName: ['FOUR'].
d greet.
c greet.
