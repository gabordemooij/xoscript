
Llinyn ar: ['evaluate'] gwneud: {
	>> cod := Ffeil newydd: ['/tmp/eval.ctr'].
	cod ysgrifennu: (hun llinyn + ['.']).
	Rhaglen defnyddio: ['/tmp/eval.ctr'].
}.

>> map :=
	(Geiriadur newydd)
	rhoi: ['Hi There'] yn: ['two'],
	rhoi: (Rhestr ← ['hello'] ; ['world'] ; (Rhestr ← 1 ; 2; 9) ; Gau) yn: ['one'],
	rhoi: ( (Geiriadur newydd) rhoi: ['wrrld'] yn: ['misspelled'] ) yn: ['three'],
	rhoi: (Rhestr ← ((Geiriadur newydd) rhoi: ['treasure'] yn: ['hidden']) ; 2) yn: ['four']. 
>> str := map llinyn.
>> map2 := Dim.
(['map2 := '] + str ) evaluate.
Allbwn ysgrifennu: map2 ? ['one'] ? 0.
Allbwn ysgrifennu: map2 ? ['one'] ? 1.
Allbwn ysgrifennu: map2 ? ['four'] ? 0 ? ['hidden'].
Allbwn ysgrifennu: map2 ? ['one'] ? 2 ? 2.
