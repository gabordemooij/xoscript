# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob newydd: 8, bytes: (
	Rhestr newydd ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Allbwn ysgrifennu: ( utf16 datgodio: ['utf16le'] ), llinell-newydd.

utf16 rhyddhau.
>> utf32 := Blob newydd: 13, bytes: (
	Rhestr newydd ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Allbwn ysgrifennu: ( utf32 datgodio: ['utf32be'] ), llinell-newydd.
utf32 rhyddhau.