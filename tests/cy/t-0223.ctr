>> x := Ennyd newydd.
x parth: ['CEST'],
blwyddyn:2017,
mis:01,
dydd:10,
awr: 10,
munud: 0,
eiliad: 0.

Allbwn ysgrifennu: x, llinell-newydd.

Allbwn ysgrifennu: x amser, llinell-newydd.

x ychwanegu: 1 eiliad.
x ychwanegu: 2 munud.
x ychwanegu: 3 awr.
x ychwanegu: 4 dydd.
x ychwanegu: 1 mis.
x ychwanegu: 6 blwyddyn.

Allbwn ysgrifennu: x, llinell-newydd.

x tynnu-ymaith: 1 eiliad.
x tynnu-ymaith: 2 munud.
x tynnu-ymaith: 3 awr.
x tynnu-ymaith: 4 dydd.
x tynnu-ymaith: 1 mis.
x tynnu-ymaith: 6 blwyddyn.

Allbwn ysgrifennu: x, llinell-newydd.

>> y := x copïo.
>> z := x.

Allbwn ysgrifennu: y, llinell-newydd.
Allbwn ysgrifennu: z, llinell-newydd.
Allbwn ysgrifennu: (x parth = y parth), llinell-newydd.
Allbwn ysgrifennu: (x amser = y amser), llinell-newydd.
Allbwn ysgrifennu: (x = z), llinell-newydd.
Allbwn ysgrifennu: x diwrnod-blwyddyn, llinell-newydd.
Allbwn ysgrifennu: x diwrnod-wythnos, llinell-newydd.
Allbwn ysgrifennu: x wythnos, llinell-newydd.
