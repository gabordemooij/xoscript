Server init.
>> f := Fformat newydd: ['%d'].
>> a := Blob newydd: 4.
a bytes: ( Rhestr newydd ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob newydd: 4.
b bytes: ( Rhestr newydd ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a o: 0 hyd: 3, pob: { :i :byte
	Allbwn ysgrifennu: ( f cymhwyso-cyfanrif: byte ), llinell-newydd.
}.
a ^ b.
a o: 0 hyd: 3, pob: { :i :byte
	Allbwn ysgrifennu: ( f cymhwyso-cyfanrif: byte ), llinell-newydd.
}.
a ^ b.
a o: 0 hyd: 3, pob: { :i :byte
	Allbwn ysgrifennu: ( f cymhwyso-cyfanrif: byte ), llinell-newydd.
}.
a rhyddhau.
b rhyddhau.

{ a ^ Gwrthrych. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn.
