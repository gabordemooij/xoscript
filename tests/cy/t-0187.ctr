Rhif ar: ['factorial'] gwneud: {
	>> total := 1.
	{ :index total lluosi-gyda: (hun - index). } × hun. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

{
2 exponent factorial.
Allbwn ysgrifennu: (11 modwlo: 3), llinell-newydd.
Allbwn ysgrifennu: (3.4 talgrynnu), llinell-newydd.
Allbwn ysgrifennu: (7.1 talgrynnu-i-fyny), llinell-newydd.
Allbwn ysgrifennu: (7.9 talgrynnu-i-lawr), llinell-newydd.
}
cychwyn.

Rhaglen tacluso.

usedMemory1 := (Rhaglen cof ? 0).

{
2 exponent factorial.
Allbwn ysgrifennu: (11 modwlo: 3), llinell-newydd.
