Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 
a ar: ['item:'] gwneud: { :lst
	eiddo lst := lst. 
}.
a ar: ['item'] gwneud: { <- eiddo lst.
}.
a item: (
	Rhestr newydd ; 1 ; (
		Rhestr newydd ; ['a'] ; (
			Rhestr newydd ; ( Ennyd newydd: 1 )
		) ; ( Int64 o-linyn: ['321'] )
	)
).
Allbwn ysgrifennu: a item, llinell-newydd.
>> old-lst-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
(b item prototeip cyfeiriad-cof = old-lst-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
Allbwn ysgrifennu: ( b item ), llinell-newydd.
