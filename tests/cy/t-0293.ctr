
>> city := Rhestr ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Rhestr ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature gan: city.
>> cities := weather cofnodion trefnu: { :a :b <- (a cymharu: b). }.
>> temperatures := weather gwerthoedd trefnu: { :a :b <- (a cymharu: b) negyddol?. }.

Allbwn ysgrifennu: (cities cyfuno: [',']), llinell-newydd.
Allbwn ysgrifennu: (temperatures cyfuno: [',']), llinell-newydd.
