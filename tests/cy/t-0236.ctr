>> Slurp := Gwrthrych newydd.
Slurp ar: ['newydd'] gwneud: {
	eiddo str := [''].
}.


Slurp ar: ['ymateb:'] gwneud: { :blah
		(eiddo str ≠ ['']) gwir: {
			eiddo str atodi: [' '].
		}.
		eiddo str atodi: blah.
}.
Slurp ar: ['ymateb:a:'] gwneud: { :blah :blahah
		(eiddo str ≠ ['']) gwir: {
			eiddo str atodi: [' '].
		}.
		(blah hyd > 1) gwir: {
			eiddo str atodi: (blah o: 0 hyd: (blah hyd - 1)).
		}, arall: {
			eiddo str atodi: blah.
		}.
		eiddo str atodi: [' '].
		eiddo str atodi: blahah.
}.
Slurp ar: ['obtain'] gwneud: {
	>> buffer := eiddo str.
	eiddo str := ['']. <- buffer.
}.

>> paramedrau-chwilio := Slurp newydd.
paramedrau-chwilio select: ['*'], from users where: ['id = 2'].
Allbwn ysgrifennu: (paramedrau-chwilio obtain), llinell-newydd.
