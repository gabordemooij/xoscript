Server init.

Allbwn ysgrifennu: (
	Patrwm newydd: ['^\\w+$'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 0 match, fails on @ and .

Allbwn ysgrifennu: (
	Patrwm newydd: ['^[^@]+@[^\.]+\.\\w+$'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match

Allbwn ysgrifennu: (
	Patrwm newydd: ['[^@]+@[^\.]+\.\\w+'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match

Allbwn ysgrifennu: (
	Patrwm newydd: ['([^@]+)@([^\.]+)\.\\w+'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match, groups dont matter

Allbwn ysgrifennu: (
	Patrwm newydd: ['[a-z]'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 14 matches

Allbwn ysgrifennu: (
	Patrwm newydd: ['.*'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match (all)

Allbwn ysgrifennu: (
	Patrwm newydd: ['(.*)'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match (all)

Allbwn ysgrifennu: (
	Patrwm newydd: ['\\s*[^@]+@[^\.]+\.\\w+'],
	cydweddu: ['test@example.com'] 
), llinell-newydd. # 1 match, prefix space optional, gets ignored