Server init.
>> fmt := Fformat newydd: ['%#3x'].

>> blob := Blob newydd: 4.
blob bytes: ( 
	Rhestr newydd ; 0 ; 1 ; 2 ; 3
).

>> file := Ffeil newydd: ['/tmp/blob'].
file blob: blob.
blob rhyddhau.

>> darllen := file blob.
darllen 
o: 0 
hyd: 4, 
gwneud pob: { :i :b 
	Allbwn
	ysgrifennu: (fmt cymhwyso-cyfanrif: b),
	llinell-newydd.
}.
darllen rhyddhau.
