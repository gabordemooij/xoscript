


>> CoffeeMachine := Gwrthrych newydd.
CoffeeMachine ar: ['order:'] gwneud: { :id
	>> coffee := ['Americano'].
	( id = 1 ) gwir: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) gwir: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) gwir: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Gwrthrych newydd.
SimpleCoffeeMachine ar: ['order'] gwneud: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Allbwn ysgrifennu: redCup, llinell-newydd.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Allbwn ysgrifennu: greenCup, llinell-newydd.
>> yellowCup := CoffeeMachine order: 1.
Allbwn ysgrifennu: yellowCup, llinell-newydd.
>> blueCup := CoffeeMachine order: 0.
Allbwn ysgrifennu: blueCup, llinell-newydd.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Allbwn ysgrifennu: blackCup, llinell-newydd.
blackCup atodi: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Allbwn ysgrifennu: orangeCup, llinell-newydd.
