
>> dictionary := (
	Geiriadur newydd
		rhoi: ['b'] yn: ['a'],
		rhoi: ['a'] yn: ['b'],
		rhoi: ['z'] yn: ['x'],
		rhoi: ['hello'] yn: ['hallo'],
		rhoi: ['human'] yn: ['human']
).

>> comparisons := Rhestr newydd.
dictionary pob: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a cymharu: b)
	).
}.

comparisons trefnu: { :a :b <- ( a cymharu: b ). }.
Allbwn ysgrifennu: ( comparisons cyfuno: ['↵'] ), llinell-newydd.
comparisons cyfuno: ['↵'].
