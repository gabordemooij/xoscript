# backslashes must survive code serialization, strings must not end early
>> gwerthoedd := Rhestr newydd
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

gwerthoedd pob: { :i :value
	>> d := Geiriadur newydd.
	d rhoi: value yn: ['k'].
	>> r := d cod gwrthrych.
	Allbwn ysgrifennu: r cyfrif, llinell-newydd.
	Allbwn ysgrifennu: ( (r yn: ['k']) = value ), llinell-newydd.
}.
