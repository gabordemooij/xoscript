
>> santaLaugh := ['ho'].
>> laugh := [''].
{ laugh := laugh + santaLaugh. } × 3.
Allbwn ysgrifennu: laugh, llinell-newydd.

>> locked := Gau.
>> security := Gwir.
security gwir: { locked := Gwir. }.
Allbwn ysgrifennu: locked, llinell-newydd.

>> n := 7.
(Gwir) gwir: { n := 9. }.
Allbwn ysgrifennu: n.
