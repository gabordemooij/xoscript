>> a := Gwrthrych newydd. 
a ar: ['greet'] gwneud: { Allbwn ysgrifennu: ['welcome!'], llinell-newydd. }.
a ar: ['greet2'] gwneud: { Allbwn ysgrifennu: ['welcome2!'], llinell-newydd. }.
a save-as: ['/tmp/a.bin'].

Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
b greet2.