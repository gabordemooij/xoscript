['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Allbwn ysgrifennu: (x + y), llinell-newydd.

>> x := 10040.07.
>> y := 10305.60.

Allbwn ysgrifennu: (x + y), llinell-newydd.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Allbwn ysgrifennu: (x + y + z), llinell-newydd.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Allbwn ysgrifennu: (x + y + z), llinell-newydd.

>> q := 0.1.2.

Allbwn ysgrifennu: (q), llinell-newydd.

>> q := 012.

Allbwn ysgrifennu: (q), llinell-newydd.
