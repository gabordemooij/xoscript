

# create a 64-bit integer for exact calculations
>> a := Int64 o-linyn: ['123'].

# to string
Allbwn ysgrifennu: a, llinell-newydd.

# divide
Allbwn ysgrifennu: a / (Int64 o-linyn: ['3']), llinell-newydd.

# multiply
Allbwn ysgrifennu: a * (Int64 o-linyn: ['2']), llinell-newydd.

# add
Allbwn ysgrifennu: a + (Int64 o-linyn: ['1']), llinell-newydd.

# subtract
Allbwn ysgrifennu: a - (Int64 o-linyn: ['2']), llinell-newydd.

# compare
Allbwn ysgrifennu: ( a =   (Int64 o-linyn: ['123'])), llinell-newydd.
Allbwn ysgrifennu: ( a !=: (Int64 o-linyn: ['124'])), llinell-newydd.
Allbwn ysgrifennu: ( a <   (Int64 o-linyn: ['124'])), llinell-newydd.
Allbwn ysgrifennu: ( a >   (Int64 o-linyn: ['122'])), llinell-newydd.
Allbwn ysgrifennu: ( a >=: (Int64 o-linyn: ['123'])), llinell-newydd.
Allbwn ysgrifennu: ( a <=: (Int64 o-linyn: ['123'])), llinell-newydd.





	