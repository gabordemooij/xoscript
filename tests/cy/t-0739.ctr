Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :binhelper
	eiddo binhelper := binhelper. 
}.

a ar: ['item'] gwneud: { <- eiddo binhelper.
}.

a item: Bin newydd.

>> old-binhelper-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-binhelper-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.


