# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Cromgell 
	stwnsh-cyfrinair: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Cromgell 
	stwnsh-cyfrinair: hash gwirio: a1.
	# fail 
>> b := Cromgell
	stwnsh-cyfrinair: hash gwirio: a2.
	# ok!

Allbwn ysgrifennu: a, llinell-newydd.
Allbwn ysgrifennu: b, llinell-newydd.

