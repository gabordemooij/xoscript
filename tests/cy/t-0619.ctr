>> HTML := Gwrthrych newydd.
HTML ar: ['ymateb:'] gwneud: { :tag 
	Allbwn ysgrifennu: (['<tag>'] tag: tag), llinell-newydd.
}.
HTML ar: ['ymateb:a:'] gwneud: { :tag :html 
	Allbwn ysgrifennu: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), llinell-newydd.
}.
>> html := HTML newydd.
html body h1: ['header'].

