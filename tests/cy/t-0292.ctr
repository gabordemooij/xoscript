>> winery := { <- (	Geiriadur newydd
		rhoi: 2 yn: ['merlot'],
		rhoi: 3 yn: ['malbec'],
		rhoi: 4 yn: ['syrah']
	).
}.

Allbwn ysgrifennu: (((winery cychwyn) - ['nothing']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['merlot']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['malbec']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['syrah']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['merlot'] - ['malbec']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['merlot'] - ['syrah']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['malbec'] -['syrah']) cyfrif), llinell-newydd.
Allbwn ysgrifennu: (((winery cychwyn) - ['malbec'] - ['syrah'] - ['merlot']) cyfrif), llinell-newydd.

