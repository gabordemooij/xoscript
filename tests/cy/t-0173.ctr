

Rhestr ar: ['sum'] gwneud: {
	>> total := 0.
	hun pob: { :index :element
		total ychwanegu: element.
	}. <- total.
}.

Rhestr ar: ['product'] gwneud: {
	>> total := 1.
	hun pob: { :index :element
		total lluosi-gyda: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

{

>> a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
a := a + ( Rhestr ← 1 ).
Allbwn ysgrifennu: ( ['sum: '] + ( a sum ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['min: '] + ( a lleiafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['max: '] + ( a mwyafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['3rd: '] + ( a ? 2 ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['prd: '] + ( a product ) ), llinell-newydd.
a trefnu: { :a :b <- (b - a). }.
a pob: { :i :e Allbwn ysgrifennu: ( i - 0 ), llinell-newydd. }.

} cychwyn.

Rhaglen tacluso.
usedMemory1 := (Rhaglen cof ? 0).


{

>> a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
a := a + ( Rhestr ← 1 ).
Allbwn ysgrifennu: ( ['sum: '] + ( a sum ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['min: '] + ( a lleiafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['max: '] + ( a mwyafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['3rd: '] + ( a ? 2 ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['prd: '] + ( a product ) ), llinell-newydd.
a trefnu: { :a :b <- (b - a). }.
a pob: { :i :e Allbwn ysgrifennu: ( i - 0 ), llinell-newydd. }.

} cychwyn.



Rhaglen tacluso.
usedMemory2 := (Rhaglen cof ? 0).


{

>> a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
a := a + ( Rhestr ← 1 ).
Allbwn ysgrifennu: ( ['sum: '] + ( a sum ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['min: '] + ( a lleiafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['max: '] + ( a mwyafswm ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['3rd: '] + ( a ? 2 ) ), llinell-newydd.
Allbwn ysgrifennu: ( ['prd: '] + ( a product ) ), llinell-newydd.
a trefnu: { :a :b <- (b - a). }.
a pob: { :i :e Allbwn ysgrifennu: ( i - 0 ), llinell-newydd. }.

} cychwyn.



Rhaglen tacluso.
usedMemory3 := (Rhaglen cof ? 0).

( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) gwir: {
	Allbwn ysgrifennu: ['No memory leaks here'].
}, gau: {
	Allbwn ysgrifennu: ['Leaking memory...'].
}.
