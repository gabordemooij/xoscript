Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :nil
	eiddo nil := nil. 
}.

a ar: ['item'] gwneud: { <- eiddo nil.
}.

a item: Dim.

Allbwn ysgrifennu: a item, llinell-newydd.

>> old-nil-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-nil-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.

Allbwn ysgrifennu: b item, llinell-newydd.
