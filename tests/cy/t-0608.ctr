
>> Size := Gwrthrych newydd.
Size ar: ['is:'] gwneud: { :rhif
	rhif ar: ['+'] gwneud: { :rhif
		>> unit := rhif goleddfydd.
		>> factor := 1.
		
		unit
		achos: ['inch'] gwneud: { factor := 0.0833. }. <- hun + (rhif * factor).
	}. <- rhif.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Allbwn ysgrifennu: plank + edge, llinell-newydd.
