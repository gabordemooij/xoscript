{
	y-dasg-hon gwall: ['Dont fail.'].
	unknown doSomething.
} dal: {
	Allbwn ysgrifennu: ['Caught!'].
}, cychwyn.

{
	y-dasg-hon gwall: ['Dont fail.'].
	eiddo unknown doSomething.
} dal: {
	Allbwn ysgrifennu: ['Caught!'].
}, cychwyn.

{
	y-dasg-hon gwall: ['Dont fail.'].
	unknown := 122.
} dal: {
	Allbwn ysgrifennu: ['Caught!'].
}, cychwyn.


{
	y-dasg-hon gwall: ['Dont fail.'].
	Gwir torri.
	Allbwn ysgrifennu: ['FAIL'].
} dal: {
	Allbwn ysgrifennu: ['Caught!'].
}, cychwyn.

{
	{
		y-dasg-hon gwall: ['Dont fail.'].
		Gwir torri.
		Allbwn ysgrifennu: ['FAIL'].
	} dal: { :x
		(x = ['Dont fail.']) gwir: { y-dasg-hon gwall: ['Nested Caught!']. }.
	}, cychwyn.
} dal: { :e
	Allbwn ysgrifennu: e.
}, cychwyn.
