


>> Deck := Rhestr newydd.
Deck ar: ['print'] gwneud: {
        >> len := hun cyfrif - 1.
        { :i
                >> len2 := hun cyfrif - 1.
                Allbwn ysgrifennu: ['len: '].
                Allbwn ysgrifennu: len, llinell-newydd.
                Allbwn ysgrifennu: ['len2: '].
                Allbwn ysgrifennu: len2, llinell-newydd.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
