Rhif ar: ['roman'] gwneud: {
	>> rhif := hun copïo.
	>> roman := [''].
	{
		{
			(rhif ≥ 1000) gwir: {
				roman atodi: ['Ⅿ'].
				rhif tynnu-ymaith: 1000.
			}, torri.
		
			(rhif ≥ 500) gwir: {
				roman atodi: ['Ⅾ'].
				rhif tynnu-ymaith: 500.
			}, torri.
		
			(rhif ≥ 100) gwir: {
				roman atodi: ['Ⅽ'].
				rhif tynnu-ymaith: 100.
			}, torri.
		
			(rhif ≥ 50) gwir: {
				roman atodi: ['Ⅼ'].
				rhif tynnu-ymaith: 50.
			}, torri.
		
			(rhif ≥ 50) gwir: {
				roman atodi: ['Ⅼ'].
				rhif tynnu-ymaith: 50.
			}, torri.
		
			(rhif ≥ 10) gwir: {
				roman atodi: ['Ⅹ'].
				rhif tynnu-ymaith: 10.
			}, torri.
			
			(rhif ≥ 9) gwir: {
				roman atodi: ['Ⅸ'].
				rhif tynnu-ymaith: 9.
			}, torri.
			
			(rhif ≥ 5) gwir: {
				roman atodi: ['Ⅴ'].
				rhif tynnu-ymaith: 5.
			}, torri.
			
			(rhif ≥ 4) gwir: {
				roman atodi: ['Ⅳ'].
				rhif tynnu-ymaith: 4.
			}, torri.
			
			(rhif ≥ 1) gwir: {
				roman atodi: ['Ⅰ'].
				rhif tynnu-ymaith: 1.
			}, torri.
		} gweithdrefn.
	} tra: { <- rhif > 0. }. <- roman.
}.

Allbwn ysgrifennu: 1 roman, llinell-newydd.
Allbwn ysgrifennu: 2 roman, llinell-newydd.
Allbwn ysgrifennu: 4 roman, llinell-newydd.
Allbwn ysgrifennu: 8 roman, llinell-newydd.
Allbwn ysgrifennu: 16 roman, llinell-newydd.
Allbwn ysgrifennu: 32 roman, llinell-newydd.
Allbwn ysgrifennu: 64 roman, llinell-newydd.
Allbwn ysgrifennu: 128 roman, llinell-newydd.
Allbwn ysgrifennu: 256 roman, llinell-newydd.
Allbwn ysgrifennu: 1024 roman, llinell-newydd.
