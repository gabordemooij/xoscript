# a value ending in the first part of an opening quote must survive serialization
>> gwerthoedd := Rhestr newydd
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

gwerthoedd pob: { :i :value
	>> d := Geiriadur newydd.
	d rhoi: value yn: ['k'].
	d rhoi: ['second'] yn: ['j'].
	>> r := d cod gwrthrych.
	Allbwn ysgrifennu: r cyfrif, llinell-newydd.
	Allbwn ysgrifennu: ( (r yn: ['k']) = value ), llinell-newydd.
}.
