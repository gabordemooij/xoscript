	a ar: ['rhif'] gwneud: { <- Gwir. }.
	a := 3 × a.
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.


{
	a ar: ['boolean'] gwneud: { <- 1. }.
	a := Gwir a: a.
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.





