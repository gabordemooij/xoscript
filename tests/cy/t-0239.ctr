Rhestr ar: ['sum'] gwneud: {
	>> total := 0.
	hun pob: { :index :element
		total ychwanegu: element.
	}. <- total.
}.

>> a := Gwir.



a ar: ['llinyn'] gwneud: {
	>> answer := Dim.
	( hun = Gwir ) gwir: {
		answer := ['Yep'].
	}, arall: {
		answer := ['Nope'].
	}. <- answer.
}.

a ar: ['rhif'] gwneud: {
	>> answer := Dim.
	( hun = Gwir ) gwir: {
		answer := 10.
	}, arall: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ar: ['llinyn'] gwneud: { <- ['Devil'].
}.

b ar: ['boole'] gwneud: { <- Gau.
}.


Allbwn ysgrifennu: a, llinell-newydd.  
Allbwn ysgrifennu: (90 + a), llinell-newydd. 
Allbwn ysgrifennu: b, llinell-newydd. 
Allbwn ysgrifennu: (Gwir a: b), llinell-newydd.

a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666. 
a := a + ( Rhestr ← 1 ).
Allbwn ysgrifennu: a, llinell-newydd.
Allbwn ysgrifennu: ((Geiriadur newydd) rhoi: Dim yn: Dim), llinell-newydd.
Allbwn ysgrifennu: a sum, llinell-newydd. 


{
	a ar: ['llinyn'] gwneud: { <- Dim. }.
	a := [''] + a.
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.



{
	a ar: ['rhif'] gwneud: { <- Dim. }.
	a := 3 × a.
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.


{
	a ar: ['boole'] gwneud: { <- Dim. }.
	a := Gwir a: a. 
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.





{
	a ar: ['llinyn'] gwneud: { <- Gau. }.
	a := [''] + a.
} dal: { :error
	Allbwn ysgrifennu: ['Error noted: '] + error, llinell-newydd.
}, cychwyn.



