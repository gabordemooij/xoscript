
Server init.
>> rq := HTTP-Cais newydd.
Allbwn ysgrifennu: ['HTTP-GET d[]=']  + ( rq get-rhestr: ['d[]'] ), llinell-newydd. # GET
Allbwn ysgrifennu: ['HTTP-GET f[]=']  + ( rq get-rhestr: ['f[]'] ), llinell-newydd. # GET
Allbwn ysgrifennu: ['HTTP-POST e[]='] + ( rq post-rhestr: ['e[]'] ), llinell-newydd. # GET
Allbwn ysgrifennu: ['HTTP-POST c=']   + ( rq post: ['c'] ), llinell-newydd. # GET
Allbwn ysgrifennu: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), llinell-newydd. # GET
