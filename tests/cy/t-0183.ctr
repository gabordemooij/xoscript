

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

>> o := Gwrthrych newydd.
>> o2 := Gwrthrych newydd.
Allbwn ysgrifennu: o Dim?, llinell-newydd.
Allbwn ysgrifennu: o math, llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o ), llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o2 ), llinell-newydd.
Allbwn ysgrifennu: o fy-hun, llinell-newydd.
Allbwn ysgrifennu: ( o gwneud wedi-gorffen ), llinell-newydd.

Rhaglen tacluso.

usedMemory1 := (Rhaglen cof ? 0).


o := Gwrthrych newydd.
o2 := Gwrthrych newydd.
Allbwn ysgrifennu: o Dim?, llinell-newydd.
Allbwn ysgrifennu: o math, llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o ), llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o2 ), llinell-newydd.
Allbwn ysgrifennu: o fy-hun, llinell-newydd.
Allbwn ysgrifennu: ( o gwneud wedi-gorffen ), llinell-newydd.

Rhaglen tacluso.
usedMemory2 := (Rhaglen cof ? 0).


o := Gwrthrych newydd.
o2 := Gwrthrych newydd.
Allbwn ysgrifennu: o Dim?, llinell-newydd.
Allbwn ysgrifennu: o math, llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o ), llinell-newydd.
Allbwn ysgrifennu: ( o hafal: o2 ), llinell-newydd.
Allbwn ysgrifennu: o fy-hun, llinell-newydd.
Allbwn ysgrifennu: ( o gwneud wedi-gorffen ), llinell-newydd.

Rhaglen tacluso.
usedMemory3 := (Rhaglen cof ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) gwir: {
	Allbwn ysgrifennu: ['No memory leaks here'].
}, gau: {
	Allbwn ysgrifennu: ['Leaking memory...'].
}.
