
>> a := Gwrthrych newydd.

a ar: ['cod'] gwneud: {
	>> answer := ['‘A‘']’’. <- answer.
}.

>> b := ['B'].

Allbwn ysgrifennu: Rhestr ← a ; b, llinell-newydd.
Allbwn ysgrifennu: (Geiriadur newydd rhoi: a yn: a), llinell-newydd.
Allbwn ysgrifennu: Rhestr ← ( Rhestr ← a ), llinell-newydd.
Allbwn ysgrifennu: (Geiriadur newydd rhoi: (Geiriadur newydd rhoi: a yn: a) yn: (Geiriadur newydd rhoi: a yn: a)), llinell-newydd.
Allbwn ysgrifennu: (Geiriadur newydd rhoi: (Rhestr ← a) yn: (Rhestr ← a)), llinell-newydd.
Allbwn ysgrifennu: Rhestr ← (Geiriadur newydd rhoi: a yn: a), llinell-newydd.

