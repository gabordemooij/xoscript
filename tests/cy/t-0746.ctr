Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :dict
	eiddo dict := dict. 
}.

a ar: ['item'] gwneud: { <- eiddo dict.
}.

a item: (
Geiriadur newydd
	hello: ['world'],
	world: (Geiriadur newydd rhoi: ['a'] yn: ['b'])).

Allbwn ysgrifennu: a item, llinell-newydd.

>> old-dict-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-dict-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.

Allbwn ysgrifennu: b item, llinell-newydd.
