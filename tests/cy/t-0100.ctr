Llinyn ar: ['html'] gwneud: { <- (
		hun
		disodli: ['&'] gyda: ['&amp;'],
		disodli: ['<'] gyda: ['&lt;'],
		disodli: ['>'] gyda: ['&gt;'],
		disodli: ['"'] gyda: ['&quot;']
	).
}.

>> list := Rhestr newydd.

['Verbatim Syntax'] nodau pob: { :rhif :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (rhif), Letter: letter).
}.

Allbwn list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list cyfuno: ['↵']).

Allbwn ysgrifennu: template.

