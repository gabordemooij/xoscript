>> t := Dim.

# you can control the time zone for
# parsing like this:
Ennyd parth: ['CET'].
t := Ennyd o: ['1981-02-03 04:05:06'].
Allbwn ysgrifennu: t, llinell-newydd.

# now using CEST time zone:
Ennyd parth: ['CEST'].
t := Ennyd o: ['1981-02-03 04:05:06'].
Allbwn ysgrifennu: t, llinell-newydd.

# error if string cannot be parsed
{ Ennyd o: ['1900']. } dal: { Dim. }, cychwyn.
