>> q := Gwrthrych newydd.
q ar: ['setProperty:'] gwneud: { :x
	eiddo prop := x.
}.
q ar: ['getProperty'] gwneud: { <- eiddo prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Allbwn ysgrifennu: [' p = '] + (p getProperty).
