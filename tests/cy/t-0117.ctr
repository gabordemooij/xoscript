>> t := Gwir.
(t = Gwir) gwir: { Allbwn ysgrifennu: ['T']. }.
(t = Gau) gwir: { Allbwn ysgrifennu: ['F']. }.
Allbwn ysgrifennu: ['|'].
>> t := Gau.
