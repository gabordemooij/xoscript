# test buffers PKI/Sign 
Server init.

>> long := ( Rhestr newydd llenwi: 1000 gyda: ['a'] ) cyfuno: [''].

# sign a message
Allbwn ysgrifennu: ( 
	Cromgell llofnodi: ['abc'] gyda: long
), llinell-newydd.

Allbwn ysgrifennu: ( 
	Cromgell
		gwirio: ['abc'] 
		llofnod: long 
		gyda: long
), llinell-newydd.

Allbwn ysgrifennu: (
	Cromgell stwnsh-cyfrinair: long gwirio: long
), llinell-newydd.
