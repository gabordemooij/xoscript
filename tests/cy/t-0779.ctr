Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> p := Llwybr /tmp.
Allbwn ysgrifennu: p, llinell-newydd.
>> old-p-address := p prototeip cyfeiriad-cof.
p save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
(b prototeip cyfeiriad-cof = old-p-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
Allbwn ysgrifennu: b, llinell-newydd.
