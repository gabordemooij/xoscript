# test type casts / conversions / bindings
Rhaglen rheoli-cof: 4.
Server init.

>> counter := 0.
>> db := Maria-DB newydd gwesteiwr: ['localhost'],
	enw-defnyddiwr: ['xo'], cyfrinair: ['pass123'], enw-cronfa: ['xobase'], cysylltu.

>> TwoDigitFormat := Fformat newydd: ['%02d'].

# Datetime
{
	>> blwyddyn := Rhif rhwng: 1995 a: 2050, llinyn.
	>> mis := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 12), llinyn.
	>> dydd := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 28), llinyn.
	>> awr := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 23), llinyn.
	>> munud := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 59), llinyn.
	>> eiliad := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 59), llinyn.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: blwyddyn,
		MM: mis,
		DD: dydd,
		HH: awr,
		II: munud,
		SS: eiliad.
	>> paramedrau-chwilio :=
	db ymholiad: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	nôl: { :row
		(row mydatetime = datetime) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter ychwanegu: 1.
} * 100.

