	>> dydd := TwoDigitFormat cymhwyso-cyfanrif: (Rhif rhwng: 1 a: 28), llinyn.
	>> date := ['YYYY-MM-DD'].
	date
		YYYY: blwyddyn,
		MM: mis,
		DD: dydd.
	>> paramedrau-chwilio :=
	db ymholiad: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	nôl: { :row
		(row mydate = date) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: date,
				<observation>: row mydate
