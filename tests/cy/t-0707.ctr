# Strings (varchar/text)
>> str1 := Rhestr newydd llenwi: 100000 gyda: ['x'], cyfuno: [''].
{
	>> str2 := Cromgell tocyn: 40.
	>> paramedrau-chwilio :=
	db ymholiad: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	nôl: { :row
		(row str1 = str1 a: row str2 = str2) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter ychwanegu: 1.
} * 100.


# Numbers
{
	>> n1 := Rhif rhwng: 1 a: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 o-linyn: ['9223372036854775807'] ) -
		( Int64 o-linyn: ['99999'] ) +
		( Int64 o-linyn: n1 llinyn )
	).
	>> paramedrau-chwilio :=
	db ymholiad: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	nôl: { :row
		(row n1 = n1) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 talgrynnu) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) gau: {
			y-dasg-hon gwall: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter ychwanegu: 1.
} * 100.


Allbwn ysgrifennu: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), llinell-newydd.