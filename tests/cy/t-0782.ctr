Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> cmd := Gorchymyn newydd.
Allbwn ysgrifennu: cmd ls /tmp, llinell-newydd.
>> old-cmd-address := cmd prototeip cyfeiriad-cof.
cmd save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
(b prototeip cyfeiriad-cof = old-cmd-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
Allbwn ysgrifennu: b ls, llinell-newydd.


