

Llinyn ar: ['evaluate'] gwneud: {
	>> cod := Ffeil newydd: ['/tmp/eval.ctr'].
	cod ysgrifennu: hun llinyn + ['.'].
	Rhaglen defnyddio: ['/tmp/eval.ctr'].
}.

>> a := (Rhestr ← (
	(Geiriadur newydd)
		rhoi: ['domain'] yn: ['mywebsite.com'],
		rhoi: (Rhestr ←
			((Geiriadur newydd)
				rhoi: ['home'] yn: ['title'],
				rhoi: ['<html></html>'] yn: ['body'],
				rhoi: ['2017-01-01'] yn: ['created']
			) ;
			((Geiriadur newydd)
				rhoi: ['aboutus(c)'] yn: ['title'],
				rhoi: ['<credits>Author Inc.</credits>'] yn: ['body']
			)
		) yn: ['pages']
	)
) llinyn.

Allbwn ysgrifennu: a math, llinell-newydd.
Allbwn ysgrifennu: a, llinell-newydd.

>> b := Dim.
(['b := '] + a) evaluate.
Allbwn ysgrifennu: b ? 0 ? ['pages'] ? 1 ? ['body'], llinell-newydd.

>> c := b ? 0.
>> d := c llinyn.
Allbwn ysgrifennu: d math, llinell-newydd.

>> e := Dim.
(['e := '] + d) evaluate.
Allbwn ysgrifennu: e ? ['pages'] ? 0, llinell-newydd.
