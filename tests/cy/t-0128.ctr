
Rhestr ar: ['sum'] gwneud: {
	>> total := 0.
	hun pob: { :index :element
		total ychwanegu: element.
	}. <- total.
}.

>> a := Rhestr ← 9 ; 8 ; 7.
Allbwn ysgrifennu: (a sum), llinell-newydd. 
>> a := Rhestr ← 1 ; 9.
Allbwn ysgrifennu: (a sum), llinell-newydd. 
>> a := Rhestr ← ['o'] ; 2.
Allbwn ysgrifennu: (a sum), llinell-newydd. 
Allbwn ysgrifennu: (Rhestr newydd sum), llinell-newydd. 
