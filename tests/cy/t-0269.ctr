#Linux

(Ffeil newydd: ['/tmp/testje']) yn-bodoli gau: {
	Rhaglen system: ['mkdir /tmp/testje'].	
}.

(Ffeil newydd: ['/tmp/testje/file1']) yn-bodoli gau: {
	Rhaglen system: ['touch /tmp/testje/file1'].	
}.

(Ffeil newydd: ['/tmp/testje/folder1']) yn-bodoli gau: {
	Rhaglen system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Ffeil rhestr: ['/tmp/testje'].

>> q := Rhestr newydd.

l pob: { :k :v v pob: { :x :y q atodi: y. }. }.

>> s := q llinyn.

(s yn-cynnwys: ['file1']) gwir:   { Allbwn ysgrifennu: ['OK'], llinell-newydd. }.
(s yn-cynnwys: ['file2']) gwir:   { Allbwn ysgrifennu: ['XX'], llinell-newydd. }.
(s yn-cynnwys: ['folder1']) gwir: { Allbwn ysgrifennu: ['OK'], llinell-newydd. }.
