# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patrwm newydd: pattern.
	p cydweddu: subject gwneud: { :m :g
		Allbwn ysgrifennu: g cyfrif, ysgrifennu: [' '], ysgrifennu: (g cyfuno: ['|']), llinell-newydd. <- m.
	}.
}.
show cymhwyso: ['(a)|(b)'] a: ['b'].
show cymhwyso: ['(a)|(b)'] a: ['a'].
show cymhwyso: ['(x)?y'] a: ['y'].
show cymhwyso: ['(x)?(y)(z)?'] a: ['xy'].
