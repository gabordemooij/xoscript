
>> XX := Gwrthrych newydd.
>> X := Gwrthrych newydd.

XX ar: ['QQ'] gwneud: { <- 1. }.
XX ar: ['Q'] gwneud: { <- 1. }.
XX ar: ['QQ:'] gwneud: { <- 1. }.
XX ar: ['QQ:QQ:'] gwneud: { <- 1. }.

X ar: ['QQ'] gwneud: { <- 1. }.
X ar: ['Q'] gwneud: { <- 1. }.
X ar: ['QQ:'] gwneud: { <- 1. }.
X ar: ['QQ:QQ:'] gwneud: { <- 1. }.

Allbwn ysgrifennu: (Rhaglen XX), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen canfod: ['XX']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen canfod: ['X']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen XX: ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen XX: ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen XX: ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen XX: ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen X: ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X: ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X: ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X: ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen X ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen YY), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen canfod: ['YY']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen canfod: ['Y']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen YY: ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen YY: ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen YY: ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen YY: ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen Y: ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y: ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y: ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y: ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen Y ['QQ']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y ['Q']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y ['QQ:']), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen Y ['QQ:QQ:']), llinell-newydd.

Allbwn ysgrifennu: (Rhaglen X: -1), llinell-newydd.
Allbwn ysgrifennu: (Rhaglen X Dim), llinell-newydd.

