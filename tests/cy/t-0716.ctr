Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['state:'] gwneud: { :list
	eiddo list := list. 
}.

a ar: ['state'] gwneud: {
	Allbwn ysgrifennu: eiddo list, llinell-newydd.
}.

a state: ( Rhestr newydd ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
b state.