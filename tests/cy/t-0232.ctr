>> Slurp := Gwrthrych newydd.

Slurp ar: ['newydd'] gwneud: {
	eiddo str := [''].
}.

Slurp ar: ['ymateb:'] gwneud: { :blah
		(eiddo str = ['']) gwir: {
			eiddo str atodi: blah.
		}, arall: {
			eiddo str atodi: [' '].
			eiddo str atodi: blah.
		}.
}.

Slurp ar: ['ymateb:a:'] gwneud: { :blah :blahah
		(blah hyd > 1) gwir: {
			eiddo str atodi: (blah o: 0 hyd: (blah hyd - 1)).
		}, arall: {
			eiddo str atodi: blah.
		}.
		eiddo str atodi: [' '].
		eiddo str atodi: blahah.
}.

Slurp ar: ['obtain'] gwneud: {
	>> buffer := eiddo str.
	eiddo str := ['']. <- buffer.
}.


>> x := Slurp newydd.
x + 3.
Allbwn ysgrifennu: (x obtain), llinell-newydd.
x echo: ['Hello world'].
Allbwn ysgrifennu: (x obtain), llinell-newydd.
x tellme: 123 and: 987.
Allbwn ysgrifennu: (x obtain), llinell-newydd.
