	>> mwyafswm := ( a > b ) naill-ai: a neu: b.
	>> x := Dim.
	{
		x := Rhif rhwng: a a: b.
		((x < lleiafswm) neu: (x > mwyafswm)) gwir: { 
			Allbwn ysgrifennu: (['Invalid value!']).
			Rhaglen diwedd.
		}.
	} 
	× 100. <- x.
}.
