(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) gwir: {
	Allbwn ysgrifennu: ['Memory usage remains stable.'], llinell-newydd.
}, arall: {
	Allbwn ysgrifennu: ['Used memory not stable.'], llinell-newydd.
