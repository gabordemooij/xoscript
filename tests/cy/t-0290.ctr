# test list operations


>> cakes := Rhestr ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes disodli: 1 hyd: 2 gyda: ( Rhestr ← ['cinnamon'] ; ['pineapple'] ).
Allbwn ysgrifennu: (buy cyfuno: [',']), llinell-newydd.


>> buy := cakes disodli: 1 hyd: 12 gyda: ( Rhestr ← ['cinnamon'] ; ['pineapple'] ).
Allbwn ysgrifennu: (buy cyfuno: [',']), llinell-newydd.


>> buy := cakes disodli: 2 hyd: 10 gyda: ( Rhestr newydd ).
Allbwn ysgrifennu: (buy cyfuno: [',']), llinell-newydd.


>> buy := cakes disodli: 0 hyd: 1 gyda: ( Rhestr newydd ).
Allbwn ysgrifennu: (buy cyfuno: [',']), llinell-newydd.


>> buy := cakes disodli: ['0'] hyd: ['1'] gyda: ['x'].
Allbwn ysgrifennu: (buy cyfuno: [',']), llinell-newydd.
