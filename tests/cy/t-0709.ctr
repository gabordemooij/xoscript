# Can we use UTF8 in regex?
Server init.
>> p := Patrwm newydd: ['\\w'].
Allbwn ysgrifennu: ( p cydweddu: ['x'] ), llinell-newydd.
Allbwn ysgrifennu: ( p cydweddu: ['é'] ), llinell-newydd.
>> p := Patrwm newydd: ['(*UTF)(*UCP)\\w'].
Allbwn ysgrifennu: ( p cydweddu: ['é'] ), llinell-newydd.
# should give 101