# test catch-all methods
>> x13 := Gwrthrych newydd.
x13 ar: ['a'] gwneud: { :a Allbwn ysgrifennu: 0, llinell-newydd. }.
x13 ar: ['a:'] gwneud: { :a Allbwn ysgrifennu: a, llinell-newydd. <- 5. }.
x13 ar: ['a:b:'] gwneud: { :a :b Allbwn ysgrifennu: (a + b), llinell-newydd. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
