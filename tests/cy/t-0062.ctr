Boole ar: ['xor:'] gwneud: { :a :b <- ((a a: b nid) neu: (a nid a: b)).
}.

>> o := Gwrthrych newydd.
o ar: ['hello'] gwneud: { ['Empty']. }.
{ o ar: 2 gwneud: 3.} dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn.
{ o ar: ['prawf'] gwneud: 3.} dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn.
{ o ar: ['hello'] gwneud: { ['Empty']. }.} dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ >> z := 4 ÷ 0. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ (Gwir a: Dim) gwir: { Allbwn ysgrifennu: ['X'].}. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ ([''] xor: 0) gwir: { Allbwn ysgrifennu: ['X'].}. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ (1 < ['2']) gwir: { Allbwn ysgrifennu: ['OK']. }. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ (1 < ['2.0']) gwir: { Allbwn ysgrifennu: ['OK']. }. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ (1 < ['x2.0']) gwir: { Allbwn ysgrifennu: ['NO!']. }. } dal: { :e Allbwn ysgrifennu: e, llinell-newydd. }, cychwyn. 
{ Allbwn ysgrifennu: (['hello OK there'] o: ['6'] hyd: ['2']). } cychwyn. 
