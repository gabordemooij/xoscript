>> Grandfather := Gwrthrych newydd.
Grandfather ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: ['Ave!'], llinell-newydd.
}.
>> Father := Grandfather newydd.
Father ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: ['Hello'], llinell-newydd.
	hun greet.
}.
>> Son := Father newydd.
Son ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: ['Hi'], llinell-newydd.
	hun greet.
}.

Son greet.

>> Roundabout := Gwrthrych newydd.
Roundabout ar: ['circle:'] gwneud: { :x
	Allbwn ysgrifennu: x, llinell-newydd.
	(x < 3) gwir: { hun ailadroddus circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) gwir: { Allbwn ysgrifennu: x, llinell-newydd. x ychwanegu: 1.  increment cychwyn. }. }.
increment cychwyn.