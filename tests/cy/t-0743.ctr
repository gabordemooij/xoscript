>> V := Gwrthrych.
V ar: ['llinyn'] gwneud: {
	Allbwn ysgrifennu: ['cast'], llinell-newydd. <- ['abc'].
}.

Allbwn ysgrifennu: ( Rhaglen gosodiad: ['abc'] ), llinell-newydd.

# params should not get gc'ed
Rhaglen gosodiad: ([''] + V newydd) gwerth: ([''] + V newydd).

Allbwn ysgrifennu: ( Rhaglen gosodiad: ['abc'] ), llinell-newydd.
