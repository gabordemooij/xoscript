Server init.

# write a test file
>> f := Ffeil newydd: ['/tmp/test.gif'].
f ysgrifennu: ['GIF87a01234567810'].

# serve the file
Server trosglwyddo: ['test.gif'] rhagddodiad: ['/tmp/'].

Allbwn llinell-newydd.

Allbwn ysgrifennu: ['Outside container (security):'], llinell-newydd.
{ Server trosglwyddo: ['../passwd'] rhagddodiad: ['/tmp/']. }
dal: { :e Allbwn ysgrifennu: e, llinell-newydd. },
cychwyn.

Allbwn ysgrifennu: ['Invalid prefix:'], llinell-newydd.
{ Server trosglwyddo: ['test.gif'] rhagddodiad: ['z:\\']. }
dal: { :e Allbwn ysgrifennu: e, llinell-newydd. },
cychwyn.

Allbwn ysgrifennu: ['Non-existant file:'], llinell-newydd.
{ Server trosglwyddo: ['xxx.xxx'] rhagddodiad: ['/tmp/']. }
dal: { :e Allbwn ysgrifennu: e, llinell-newydd. },
cychwyn.
