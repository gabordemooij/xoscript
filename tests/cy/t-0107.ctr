
Allbwn ysgrifennu: ['Break for-loop, 0-4.'], llinell-newydd.
{ :i
	Allbwn ysgrifennu: ['iteration #'] + i, llinell-newydd.
	(i = 4) torri.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Allbwn ysgrifennu: ['Break while-true loop, 0-4.'], llinell-newydd.
{
	Allbwn ysgrifennu: ['iteration #'] + x, llinell-newydd.
	x ychwanegu: 1.
	((x < 5) nid) torri.
} tra: xIsLessThan10.

Allbwn ysgrifennu: ['Break while-false loop, 5,4.'], llinell-newydd.
{
	Allbwn ysgrifennu: ['iteration #'] + x, llinell-newydd.
	x tynnu-ymaith: 1.
	(x = 3) torri.
} tra: { <- (x > 0). }.

Allbwn ysgrifennu: ['Break times loop, 1-4.'], llinell-newydd.
{ :i
	Allbwn ysgrifennu: ['iteration #'] + i, llinell-newydd.
	(i = 4) torri.
} × 5.

Allbwn ysgrifennu: ['Break block, dont print line.'], llinell-newydd.
{ Gwir torri. Allbwn ysgrifennu: ['dont write this!'], llinell-newydd. } cychwyn.

Allbwn ysgrifennu: ['Break block, dont fire catch...'], llinell-newydd.
{ Gwir torri. Allbwn ysgrifennu: ['dont write this!'], llinell-newydd. } dal: { Allbwn ysgrifennu: ['Dont catch this!']. }, cychwyn.

Allbwn ysgrifennu: ['Test Array each-loop: 0,1'], llinell-newydd.
(Rhestr ← 1 ; 2 ; 3) mapio: { :i
	Allbwn ysgrifennu: ['iteration #'] + i, llinell-newydd.
	(i = 1) torri.
}.

Allbwn ysgrifennu: ['Test Map each-loop: c only'], llinell-newydd.
>> m := Geiriadur newydd.
m rhoi: ['first'] yn: ['a'], rhoi: ['second'] yn: ['b'], rhoi: ['third'] yn: ['c'].
m pob: { :k :v
	Allbwn ysgrifennu: ['iteration'] + v + k, llinell-newydd.
	Gwir torri.
}.

