
>> a := Rhestr ← (Rhestr ← 100 ; 200 ; 300) ; (Rhestr ← 9 ; 8 ; 7).
Allbwn ysgrifennu: ['at 0,1 :'].
Allbwn ysgrifennu: a ? 0 ? 1, llinell-newydd. 
Allbwn ysgrifennu: ['at 1,2 :'].
Allbwn ysgrifennu: a ? 1 ? 2, llinell-newydd. 
>> menu := Geiriadur newydd.
menu rhoi: (Rhestr ← ['pizza'] ; ['spaghetti']) yn: ['Italian Cuisine'].
menu rhoi: (Rhestr ← ['bifteki'] ; ['suflaki']) yn: ['Greek Cuisine'].
Allbwn ysgrifennu: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), llinell-newydd. 
Allbwn ysgrifennu: ['but not on the same plate.'], llinell-newydd.
