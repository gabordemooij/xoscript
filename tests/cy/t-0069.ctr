

Llinyn ar: ['html'] gwneud: { <- (
		hun
		disodli: ['&'] gyda: ['&amp;'],
		disodli: ['<'] gyda: ['&lt;'],
		disodli: ['>'] gyda: ['&gt;'],
		disodli: ['"'] gyda: ['&quot;']
	).
}.


Allbwn ysgrifennu: ([' left trimmed '] tocio) + [' '] + ( ['and right trimmed'] tocio) + ['!'], llinell-newydd.
Allbwn ysgrifennu: ['<html>"html & entities"</html>'] html.
