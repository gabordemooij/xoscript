>> Greeter := Gwrthrych newydd.
Greeter ar: ['make'] gwneud: {
	>> greeter := Gwrthrych newydd.
	greeter ar: ['name:'] gwneud: { :enw
		Allbwn ysgrifennu: ['setting a name'].
		eiddo myName := enw.
	}.
	greeter ar: ['greet'] gwneud: {
		Allbwn ysgrifennu: ['Hello'].
		Allbwn ysgrifennu: eiddo myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
