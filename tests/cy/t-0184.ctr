

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

Rhif ar: ['addNum:'] gwneud: { :x
	hun ychwanegu: x.
}.

Rhif ar: ['subtractNum:'] gwneud: { :x
	hun tynnu-ymaith: x.
}.

Rhif ar: ['multiplyBy:'] gwneud: { :x
	hun lluosi-gyda: x.
}.

Rhif ar: ['divideBy:'] gwneud: { :x
	hun rhannu-gyda: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pŵer: 8).  
a := a + (2 pŵer: -1). 
a := a + (49 ail-isradd).   
a addNum: ((Rhestr ← 0 ; 1) mwyafswm).          
a addNum: ((Rhestr ← 2 ; 3) lleiafswm).
Allbwn ysgrifennu: a.

Rhaglen tacluso.

usedMemory1 := (Rhaglen cof ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
