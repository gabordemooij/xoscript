a := a + (2 pŵer: 8).  
a := a + (2 pŵer: -1). 
a := a + (49 ail-isradd).   
a addNum: ((Rhestr ← 0 ; 1) mwyafswm).          
a addNum: ((Rhestr ← 2 ; 3) lleiafswm).
Allbwn ysgrifennu: a.

Rhaglen tacluso.
usedMemory2 := (Rhaglen cof ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pŵer: 8).  
a := a + (2 pŵer: -1). 
a := a + (49 ail-isradd).   
a addNum: ((Rhestr ← 0 ; 1) mwyafswm).          
a addNum: ((Rhestr ← 2 ; 3) lleiafswm).
Allbwn ysgrifennu: a.

Rhaglen tacluso.
usedMemory3 := (Rhaglen cof ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) gwir: {
	Allbwn ysgrifennu: ['No memory leaks here'].
}, gau: {
	Allbwn ysgrifennu: ['Leaking memory...'].
}.
