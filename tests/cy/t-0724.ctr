Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :file
	eiddo file := file. 
}.

a ar: ['item'] gwneud: { <- eiddo file.
}.

>> f := Ffeil newydd: ['/tmp/aaa.txt'].
a item: f.
Allbwn ysgrifennu: a item, llinell-newydd.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.
>> b := Gwrthrych load-from: ['/tmp/a.bin'].
Allbwn ysgrifennu: b item, llinell-newydd.
