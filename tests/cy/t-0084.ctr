>> makeAdder := { :x
	>> f := { :y <- (eiddo x + y). } gosod: ['x'] gwerth: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eiddo q rhoi: (eiddo f cymhwyso: (eiddo q ? i)) yn: i. } 
	gosod: ['q'] gwerth: array,
	gosod: ['f'] gwerth: func.
	{ :i mapping cymhwyso: i. } × (array cyfrif).
}.

>> a := Rhestr ← 1; 2; 3.
mapper cymhwyso: a a: (makeAdder cymhwyso: 100).
Allbwn ysgrifennu: (a safle: 0), llinell-newydd.
Allbwn ysgrifennu: (a ? 1), llinell-newydd.
Allbwn ysgrifennu: (a ? 2), llinell-newydd.
