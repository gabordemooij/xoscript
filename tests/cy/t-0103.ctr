>> a := Rhestr ← Gwrthrych ; Gwir ; Gau ; Boole ; 1 ; Rhif ; ['Str'] ; Llinyn ; { ['Empty']. }.
Allbwn ysgrifennu: (a cyfrif), llinell-newydd.
{ :i
	Allbwn ysgrifennu: 
	['a '] + 
	((a ? i) math) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Dim?) naill-ai: [''] neu: ['NOT']) + 
	[' Nil.'],
	llinell-newydd.
} × (a cyfrif).
Allbwn ysgrifennu: ['but.. Nil is.. '] + ((Dim Dim?) naill-ai: ['certainly NIL!'] neu: ['not NIL??']), llinell-newydd.