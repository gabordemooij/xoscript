

Rhaglen tacluso.


>> Veggy := Gwrthrych newydd.
Veggy ar: ['newydd'] gwneud: {
	>> v := hun newydd.
	v init. <- v.
}.

Veggy ar: ['init'] gwneud: { eiddo veggies := 0. }.

Veggy ar: ['carrots:'] gwneud: { :a eiddo veggies := a. <- Dim. }.
Veggy ar: ['carrots'] gwneud: { <- eiddo veggies. }.
Veggy ar: ['+'] gwneud: { :f
	>> n := Veggy newydd.
	n carrots: (f carrots + eiddo veggies). <- n.
}.

Veggy ar: ['llinyn'] gwneud: { <- eiddo veggies llinyn.
}.

Rhif ar: ['carrots'] gwneud: {
	>> x := Veggy newydd.
	x carrots: hun. <- x.
}.

Rhif ar: ['add:and:'] gwneud: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Allbwn ysgrifennu: q, llinell-newydd.
