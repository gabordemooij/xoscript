Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :hexhelper
	eiddo hexhelper := hexhelper. 
}.

a ar: ['item'] gwneud: { <- eiddo hexhelper.
}.

a item: Hx newydd.

>> old-hexhelper-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-hexhelper-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
