

Llinyn ar: ['evaluate'] gwneud: {
	>> cod := Ffeil newydd: ['/tmp/eval.ctr'].
	cod ysgrifennu: (hun llinyn + ['.']).
	Rhaglen defnyddio: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Rhestr ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q llinyn.
Allbwn ysgrifennu: x, llinell-newydd.
>> y := Dim.
(['y := '] + x ) evaluate.
Allbwn ysgrifennu: y ? 0, llinell-newydd.

q := Geiriadur rhoi: ['\[''] yn: ['\['quote\']'].
x := q llinyn.
Allbwn ysgrifennu: x, llinell-newydd.
y := Dim.
(['y := '] + x ) evaluate.

>> q := (Geiriadur newydd) rhoi:['\[''] yn:['\['quote\[''].
Allbwn ysgrifennu: y ? ['\['quote\']'], llinell-newydd.
