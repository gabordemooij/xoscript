Allbwn ysgrifennu: ['1,2,3,4,5,6,7,8,9,A,'], llinell-newydd.
>> Scope := Gwrthrych newydd.
Scope ar: ['initialize:'] gwneud: { :x eiddo property := x. }.
Scope ar: ['confirm'] gwneud: { Allbwn ysgrifennu: [',']. }.
Scope ar: ['prawf'] gwneud: {
	Allbwn ysgrifennu: eiddo property.
	hun confirm.
	( 1 = 1 ) gwir: { Allbwn ysgrifennu: eiddo property. hun confirm. }.
	( 1 = 0 ) gau: { Allbwn ysgrifennu: eiddo property. hun confirm. }.
	>> y := 2. { Allbwn ysgrifennu: eiddo property. hun confirm. } tra: { y tynnu-ymaith: 1. <- (y > 0). }.
	{ Allbwn ysgrifennu: eiddo property. hun confirm. } × 1.
	(Rhestr ← 1) pob: {  Allbwn ysgrifennu: eiddo property. hun confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Geiriadur newydd one: ['item']) pob: { Allbwn ysgrifennu: eiddo property. hun confirm. }.
	{ 1 ÷ 0. } dal: { Allbwn ysgrifennu: eiddo property. hun confirm. }, cychwyn.
	Allbwn llinell-newydd.
}.
>> scope1 := Scope newydd.
scope1 initialize: ['X'].
scope1 prawf.
