>> a := Rhestr newydd.
a rhagddodi: ['Hello'].
a rhagddodi: ['World'].
Allbwn ysgrifennu: (a safle: 1), ysgrifennu: (a safle: 0), llinell-newydd.
Allbwn ysgrifennu: (a cyfrif) + [' left in array.'], llinell-newydd.
Allbwn ysgrifennu: (a tynnu-cyntaf), ysgrifennu: (a tynnu-cyntaf), ysgrifennu: a tynnu-cyntaf, llinell-newydd.
Allbwn ysgrifennu: (a cyfrif) + [' left in array.'], llinell-newydd.
Allbwn ysgrifennu: (a tynnu-olaf), llinell-newydd.
a rhagddodi: ['Hi'], rhagddodi: ['There'].
Allbwn ysgrifennu: (a cyfrif) + [' left in array.'], llinell-newydd.
Allbwn ysgrifennu: (a safle: 1), ysgrifennu: (a safle: 0), llinell-newydd.
{ a tynnu-cyntaf. } × 4.
Allbwn ysgrifennu: (a cyfrif) + [' left in array.'], llinell-newydd.
Allbwn ysgrifennu: a tynnu-cyntaf.
