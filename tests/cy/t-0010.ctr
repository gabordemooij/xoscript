>> Animal := Gwrthrych newydd.
Animal ar: ['make'] gwneud: {
	>> animal := Gwrthrych newydd.
	animal ar: ['makeSound'] gwneud: {
		Allbwn ysgrifennu: eiddo sound.
	}. <- animal.
}.
>> Cat := Gwrthrych newydd.
Cat ar: ['make'] gwneud: {
	>> cat := Animal make.
	cat ar: ['init'] gwneud: {
		eiddo sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
