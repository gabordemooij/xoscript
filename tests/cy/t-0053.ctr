60 × {
	>> x := (Rhif random % 6) + 1.
	(x ≤ 6) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	(x ≥0) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	x := (Rhif random % 3) + 1.
	(x < 3) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	(x>-1) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	x := ((Boole flip) rhif).
	(x = 0 neu: x = 1) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	x := ((Gwir flip) rhif).
	(x = 0 neu: x = 1) gau: { Allbwn ysgrifennu: ['FAIL']. }.
	x := (Boole flip naill-ai: ['HEAD'] neu: ['TAIL']).
	((x = ['HEAD']) neu: (x = ['TAIL'])) gau: { Allbwn ysgrifennu: ['FAIL']. }.
}.
Allbwn ysgrifennu: ['DONE'].

