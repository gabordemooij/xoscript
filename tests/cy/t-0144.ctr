



>> CoffeeGrounds := Gwrthrych newydd.
CoffeeGrounds ar: ['extract'] gwneud: { <- ['coffee']. }.

>> CoffeeMachine := Gwrthrych newydd.
CoffeeMachine ar: ['init'] gwneud: {
	eiddo coffeegrounds := CoffeeGrounds newydd.
}.
CoffeeMachine ar: ['newydd'] gwneud: { <- CoffeeMachine `new init.
}.

CoffeeMachine ar: ['makeTea'] gwneud: { <- (eiddo tealeaves extract). }.
CoffeeMachine ar: ['makeCoffee'] gwneud: { <- (eiddo coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine newydd.

Allbwn ysgrifennu:
	coffeeDream 
	makeCoffee.

Allbwn ysgrifennu:
	coffeeDream 
	makeTea.
