Allbwn ysgrifennu: ((Rhestr newydd
	ar: ['plaque:'] gwneud: { :x eiddo o := x. },
	ar: ['plaque']  gwneud: { <- eiddo o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Rhestr ← 1)
	~ (Rhestr ← 1 ; 2)
	~ (Rhestr ← 1 ; 2 ; 3)
	~ (Rhestr ← 1 ; 2 ; 3 ; 4)
	~ (Rhestr ← 1 ; 2 ; 3 ; 4 ; 5)
) pob: { :i :el
	{ Allbwn ysgrifennu: y-dasg-hon. } × el cyfrif.
	Allbwn llinell-newydd.
}) plaque, llinell-newydd.


