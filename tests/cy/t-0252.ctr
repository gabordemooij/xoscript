#Linux
>> clock := Ennyd newydd.
clock parth: ['UTC-1'].
clock blwyddyn: 1981, mis: 1, dydd: 5,
      awr: 13, munud: 15, eiliad: 13.

Allbwn ysgrifennu: clock, llinell-newydd.
clock parth: ['UTC+0'].

Allbwn ysgrifennu: (
	(clock blwyddyn plaen) + ['-'] + (clock mis) + ['-'] + (clock dydd) + [' '] +
	(clock awr) + [':'] + (clock munud) + [':'] + (clock eiliad) + [' '] +
	['W'] + (clock wythnos) + (clock parth)
), llinell-newydd.


clock parth: ['UTC-1'].
Allbwn ysgrifennu: (
	(clock blwyddyn plaen) + ['-'] + (clock mis) + ['-'] + (clock dydd) + [' '] +
	(clock awr) + [':'] + (clock munud) + [':'] + (clock eiliad) + [' '] +
	['W'] + (clock wythnos) + (clock parth)
), llinell-newydd.
