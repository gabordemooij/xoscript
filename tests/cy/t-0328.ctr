Rhaglen rheoli-cof: 4.

>> Doubler := Gwrthrych newydd.
>> Multiplier := Gwrthrych newydd.
Doubler ar: ['double:and:'] gwneud: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ar: ['multiply:and:'] gwneud: { :x :y <- (x × y).
}.

Allbwn ysgrifennu: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), llinell-newydd.
