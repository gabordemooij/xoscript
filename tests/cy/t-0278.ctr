>> To-Do := Gwrthrych newydd.

To-Do ar: ['newydd'] gwneud: {
	eiddo list := Rhestr newydd.
}.

To-Do ar: ['nieuw'] gwneud: {
	eiddo list := Rhestr newydd.
}.

To-Do ar: ['+'] gwneud: { :task
	eiddo list atodi: task.
}.

To-Do ar: ['number of tasks?'] gwneud: { <-  eiddo list cyfrif.
}.

>> todos := 
	To-Do newydd 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Allbwn ysgrifennu: ['You have $ tasks to do'] $ todos number of tasks?.
