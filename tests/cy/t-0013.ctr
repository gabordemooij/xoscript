
>> Animal := Gwrthrych newydd.
Animal ar: ['newydd'] gwneud: { <- hun newydd init.
}.

Animal ar: ['init'] gwneud: {
	eiddo sound := ['?'].
	eiddo legs := 4.
}.

>> Dog := Animal newydd.
Dog ar: ['init'] gwneud: {
	hun init.
	eiddo sound := ['barks'].
}.

Animal ar: ['llinyn'] gwneud: { <- eiddo legs llinyn + eiddo sound.
}.

>> poodle := Dog newydd.
Allbwn ysgrifennu: poodle, llinell-newydd.

