>> Point := Gwrthrych newydd.
Point ar: ['x-coordinate:'] gwneud: { :x eiddo x := x. }.
Point ar: ['y-coordinate:'] gwneud: { :y eiddo y := y. }.
Point ar: ['x-coordinate']  gwneud: { <- eiddo x copïo. }.
Point ar: ['y-coordinate']  gwneud: { <- eiddo y copïo. }.

Point ar: ['='] gwneud: { :other <- ( eiddo x = other x-coordinate
		 a: eiddo y = other y-coordinate ).
}.

>> pier := Point newydd x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point newydd x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point newydd x-coordinate: 5, y-coordinate: 6.

Allbwn ysgrifennu: pier = town-hall, llinell-newydd.
Allbwn ysgrifennu: pier = restaurant, llinell-newydd.
