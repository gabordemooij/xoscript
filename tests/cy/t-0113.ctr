Allbwn ysgrifennu: ['Continue for-loop, No - before 6 and up.'], llinell-newydd.
{ :i
	Allbwn ysgrifennu: (i + 1), llinell-newydd.
	((i + 1) > 4) parhau.
	Allbwn ysgrifennu: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Allbwn llinell-newydd.
Allbwn ysgrifennu: ['Continue while-true, No --> before 5 and up.'], llinell-newydd.
{
	Allbwn ysgrifennu: ['iteration #'] + x, llinell-newydd.
	x ychwanegu: 1.
	((x < 5) nid) parhau.
	Allbwn ysgrifennu: ['-->'].
} tra: xIsLessThan10.
Allbwn llinell-newydd.
Allbwn ysgrifennu: ['Continue while-false, No - before 3 only.'], llinell-newydd.
{
	Allbwn ysgrifennu: ['iteration #'] + x, llinell-newydd.
	x tynnu-ymaith: 1.
	(x = 3) parhau.
	Allbwn ysgrifennu: ['-'].
} tra: { <- ( x > 0). }.

Allbwn llinell-newydd.
Allbwn ysgrifennu: ['Continue times-loop, No ||| before 3.'], llinell-newydd.
{ :i
	Allbwn ysgrifennu: ['iteration #'] + i, llinell-newydd.
	(i = 2) parhau.
	Allbwn ysgrifennu: ['|||'].
} × 5.

Allbwn llinell-newydd.

{ Gwir parhau. Allbwn ysgrifennu: ['dont write this!'], llinell-newydd. } cychwyn.

{ Gwir parhau. Allbwn ysgrifennu: ['dont write this!'], llinell-newydd. } dal: { Allbwn ysgrifennu: ['Dont catch this!']. }, cychwyn.

Allbwn ysgrifennu: ['Test Array each-loop: 0, ... ,2'], llinell-newydd.
(Rhestr ← 1 ; 2 ; 3) mapio: { :i
	(i = 1) parhau.
	Allbwn ysgrifennu: ['iteration #'] + (i - 0), llinell-newydd.
}.

Allbwn ysgrifennu: ['Test Map each-loop: c only'], llinell-newydd.
>> m := Geiriadur newydd.
m rhoi: ['first'] yn: ['a'], rhoi: ['second'] yn: ['b'], rhoi: ['third'] yn: ['c'].
m pob: { :k :v
	(k ≠ ['c']) parhau.
	Allbwn ysgrifennu: ['iteration'] + k + v, llinell-newydd.
}.

