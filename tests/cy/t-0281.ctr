>> q := Rhestr ← 1 ; 2 ; 3.
{ q ? ['1']. } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? Gwir. } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? Gau. } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? Dim. } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? (Rhestr newydd). } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? (Gwrthrych newydd). } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
{ q ? ({ ['Empty']. }). } dal: { Allbwn ysgrifennu: ['caught!'], llinell-newydd. }, cychwyn.
Allbwn ysgrifennu: ['caught them all'], llinell-newydd.
