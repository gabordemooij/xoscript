Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :moment
	eiddo moment := moment. 
}.

a ar: ['item'] gwneud: { <- eiddo moment.
}.

>> today := Ennyd newydd parth: ['CEST'], blwyddyn: 2026, mis: 7.
a item: today.
Allbwn ysgrifennu: a item, llinell-newydd.
a save-as: ['/tmp/a.bin'].

