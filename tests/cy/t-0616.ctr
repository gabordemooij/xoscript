Rhestr ar: ['copïo'] gwneud: {
	>> copïo := Rhestr newydd.
	hun pob: { :rhif :section
		copïo atodi: section ailadroddus copïo.
	}. <- copïo.
}.

>> sheep := Rhestr newydd ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copïo.
clones pob: { :rhif :sheep
	sheep atodi: ['2'].
}.

Allbwn ysgrifennu: sheep, llinell-newydd.
Allbwn ysgrifennu: clones, llinell-newydd.
