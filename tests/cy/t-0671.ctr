# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Cromgell cynhyrchu-allweddi.

# private (secret) key
>> sk := keys cyntaf.

# public key
>> pk := keys olaf.

# sign a message
>> sig := Cromgell llofnodi: ['abc'] gyda: sk.

# check message (ok)
Allbwn ysgrifennu: ( 
	Cromgell
		gwirio: ['abc'] 
		llofnod: sig 
		gyda: pk 
), llinell-newydd.

# check message (fail)
