# compliance test

# use international numbers

Allbwn ysgrifennu: ['1000 -> '].
Allbwn ysgrifennu: 1000, llinell-newydd. #1000

Allbwn ysgrifennu: ['1.5 -> '].
Allbwn ysgrifennu: 1.5, llinell-newydd.  #1.5

Allbwn ysgrifennu: ['1001.5 -> '].
Allbwn ysgrifennu: 1.5 + 1000, llinell-newydd. #1001.5

# use 0-indexed arrays
>> x := Rhestr newydd ; 1 ; 2 ; 3.
>> y := Rhestr newydd ; ['a'] ; ['b'] ; ['c'].

Allbwn ysgrifennu: ['1 -> '].
Allbwn ysgrifennu: x ? 0, llinell-newydd. #1

Allbwn ysgrifennu: ['1 -> '].
Allbwn ysgrifennu: (x yn: 0), llinell-newydd. #1

Allbwn ysgrifennu: ['1 -> '].
Allbwn ysgrifennu: x cyntaf, llinell-newydd. #1

Allbwn ysgrifennu: ['3 -> '].
Allbwn ysgrifennu: x olaf, llinell-newydd. #3

Allbwn ysgrifennu: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Allbwn ysgrifennu: (x gan: y), llinell-newydd.

Allbwn ysgrifennu: ['1 -> '].
Allbwn ysgrifennu: (x o: 0 hyd: 1) cyntaf, llinell-newydd. #1

Allbwn ysgrifennu: ['0 -> '].
Allbwn ysgrifennu: (x canfod: 1), llinell-newydd. #0

x rhoi: 9 yn: 0.

Allbwn ysgrifennu: ['9 -> '].
Allbwn ysgrifennu: (x yn: 0), llinell-newydd. #9

x rhagddodi: 8.
Allbwn ysgrifennu: ['8 -> '].
Allbwn ysgrifennu: (x yn: 0), llinell-newydd. #9


x atodi: 10.
Allbwn ysgrifennu: ['10 -> '].
Allbwn ysgrifennu: (x yn: 4), llinell-newydd. #10








