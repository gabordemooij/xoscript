# test qualifiers

Rhaglen tacluso.

>> Fruit := Gwrthrych newydd.
Fruit ar: ['newydd'] gwneud: {
	>> f := hun newydd.
	f apples: 0. <- f.
}.
Fruit ar: ['apples:'] gwneud: { :a eiddo apples := a. }.
Fruit ar: ['apples'] gwneud: { <- eiddo apples. }.
Fruit ar: ['+'] gwneud: { :f
	>> n := Fruit newydd.
	n apples: (f apples + eiddo apples). <- n.
}.
Rhif ar: ['apples'] gwneud: { <- ((Fruit newydd) apples: hun).
}.

Fruit ar: ['llinyn'] gwneud: { <- eiddo apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Allbwn ysgrifennu: q, llinell-newydd.




q := 3 apples + 4 apples.
