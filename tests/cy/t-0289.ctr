#Linux
>> OS := Rhaglen system: (Gorchymyn uname -s), tocio.

>> Slurp := Gwrthrych newydd.
Slurp ar: ['newydd'] gwneud: {
	eiddo str := [''].
}.
Slurp ar: ['ymateb:'] gwneud: { :blah
		(eiddo str ≠ ['']) gwir: {
			eiddo str atodi: [' '].
		}.
		eiddo str atodi: blah.
}.
Slurp ar: ['ymateb:a:'] gwneud: { :blah :blahah
		(eiddo str ≠ ['']) gwir: {
			eiddo str atodi: [' '].
		}.
		(blah hyd > 1) gwir: {
			eiddo str atodi: (blah o: 0 hyd: (blah hyd - 1)).
		}, arall: {
			eiddo str atodi: blah.
		}.
		eiddo str atodi: [' '].
		eiddo str atodi: blahah.
}.
Slurp ar: ['obtain'] gwneud: {
	>> buffer := eiddo str.
	eiddo str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text atodi: ['hello'].
} × 1000.


Allbwn ysgrifennu: (
	Rhaglen system: (
		Slurp newydd
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

