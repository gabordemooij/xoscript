Server init.

>> x := Blob newydd: 65 math: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Rhaglen gosodiad: ['FFITESTLIB'].
Server cysylltu: (
 Rhestr newydd ;
 libname ;
 ['putchar'] ;
 ( Rhestr newydd ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x o: 0 hyd: 1), llinell-newydd.
x rhyddhau.

