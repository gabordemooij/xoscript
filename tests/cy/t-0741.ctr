Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :octhelper
	eiddo octhelper := octhelper. 
}.

a ar: ['item'] gwneud: { <- eiddo octhelper.
}.

a item: Oct newydd.

>> old-octhelper-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-octhelper-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.
