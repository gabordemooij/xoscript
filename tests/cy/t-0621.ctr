>> phrases := Rhestr newydd
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases pob: { :_ :phrase 
	>> e := Server base64-amgodio: phrase.
	>> d := Server base64-datgodio: e.
	Allbwn ysgrifennu: (
		message copïo ~encoded: e, ~decoded: d
	), llinell-newydd.
}.
