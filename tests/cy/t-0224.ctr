
>> countries := Rhestr newydd
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Rhestr newydd
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods gan: countries, pob: { :key :value
	counter ychwanegu: 1.
}.

Allbwn ysgrifennu: (['we serve counter dishes'] counter: counter), llinell-newydd.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] nodau trefnu: { :v
	counter ychwanegu: 0.
}.

Allbwn ysgrifennu: (['we sort counter dishes'] counter: counter), llinell-newydd.


>> counter := 0.
{
	{
		counter ychwanegu: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Allbwn ysgrifennu: (['we calculate counter numbers.'] counter: counter), llinell-newydd.

