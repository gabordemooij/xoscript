
>> Rectangle := Gwrthrych newydd.

Rectangle ar: ['area'] gwneud: { <- eiddo hyd * eiddo width.
}.

Rectangle ar: ['length:'] gwneud: { :hyd
	eiddo hyd := hyd.
}.

Rectangle ar: ['width:'] gwneud: { :width
	eiddo width := width.
}.

Rectangle ar: ['newydd'] gwneud: {
	# this will not result into an infinite loop
	>> rectangle := hun newydd.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle newydd.
Allbwn ysgrifennu: a area, llinell-newydd. #0

>> b := Rectangle newydd length: 2, width: 3.
Allbwn ysgrifennu: b area, llinell-newydd. #6

