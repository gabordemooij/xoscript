Llinyn ar: ['html'] gwneud: { <- (
		hun
		disodli: ['&'] gyda: ['&amp;'],
		disodli: ['<'] gyda: ['&lt;'],
		disodli: ['>'] gyda: ['&gt;'],
		disodli: ['''] gyda: ['&apos;'],
		disodli: ['"'] gyda: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Allbwn ysgrifennu: txt copïo html, llinell-newydd.
Allbwn ysgrifennu: txt copïo llythrennau-bach, llinell-newydd.
Allbwn ysgrifennu: txt copïo priflythrennau, llinell-newydd.
} cychwyn.

Rhaglen tacluso.

usedMemory1 := (Rhaglen cof ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Allbwn ysgrifennu: txt copïo html, llinell-newydd.
Allbwn ysgrifennu: txt copïo llythrennau-bach, llinell-newydd.
Allbwn ysgrifennu: txt copïo priflythrennau, llinell-newydd.
} cychwyn.

Rhaglen tacluso.
usedMemory2 := (Rhaglen cof ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Allbwn ysgrifennu: txt copïo html, llinell-newydd.
Allbwn ysgrifennu: txt copïo llythrennau-bach, llinell-newydd.
Allbwn ysgrifennu: txt copïo priflythrennau, llinell-newydd.
} cychwyn.

Rhaglen tacluso.
usedMemory3 := (Rhaglen cof ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) gwir: {
	Allbwn ysgrifennu: ['No memory leaks here'].
}, gau: {
	Allbwn ysgrifennu: ['Leaking memory...'].
}.
