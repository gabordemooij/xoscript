

Rhestr ar: ['column:'] gwneud: { :column
	>> result := Rhestr newydd.
	hun pob: { :index :row
		row pob: { :index :cell
			(index = column) gwir: { result atodi: cell. }.
		}.
	}. <- result.
}.


>> a := Rhestr ←
	(Rhestr ← 1 ; 2 ; 3) ;
	(Rhestr ← 4 ; 5 ; 6) ;
	(Rhestr ← 7 ; 8 ; 9).

>> b := a column: 1.
Allbwn ysgrifennu: b, llinell-newydd.

b := a column: 20.
Allbwn ysgrifennu: b, llinell-newydd.

b := a column: -100.
Allbwn ysgrifennu: b, llinell-newydd.
