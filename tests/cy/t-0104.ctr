
{ :i
	Allbwn ysgrifennu: ['This is step #'] + ( ( i ) + 1 ), llinell-newydd.
} × 6.

{ :i
	Allbwn ysgrifennu: ['This is step #'] + ( 3 - ( i ) ), llinell-newydd.
} × 6.

{ :i
	Allbwn ysgrifennu: ['NEVER!'], llinell-newydd.
} × 0.



{ :i
	Allbwn ysgrifennu: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), llinell-newydd.
} × 11.
