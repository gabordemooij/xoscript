Rhaglen rheoli-cof: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } dal: {
		oops ychwanegu: 1.
	}, cychwyn.
} × 1000.

{
	Allbwn ysgrifennu: ['hi there!'].
	y-dasg-hon gwall: ['oops'].
	Allbwn ysgrifennu: ['hi there!'].
	{ Allbwn ysgrifennu: ['dont print this']. } cychwyn.
} dal: { :e 
	Allbwn ysgrifennu: ['got ya!']. 
	Allbwn ysgrifennu: e.
}, cychwyn.
