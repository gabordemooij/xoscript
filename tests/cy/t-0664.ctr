# recursive interpolation not allowed

Allbwn ysgrifennu: 
['recursive string interolation enabled: '] + (
	Rhaglen nodwedd: 
	['RECURSIVE_STRINTPOL']
), llinell-newydd.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Allbwn ysgrifennu: a, llinell-newydd.


