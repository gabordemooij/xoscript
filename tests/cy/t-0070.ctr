>> numbers := ['1,2,3'] hollti: [','].
Allbwn ysgrifennu: ['I got: '] + numbers cyfrif + [' numbers.'],llinell-newydd.
{ :i Allbwn ysgrifennu: ['number #'] + i + [':'] + (numbers safle: i), llinell-newydd.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages hollti: [' Or '].
Allbwn ysgrifennu: ['We serve'], llinell-newydd.
{ :i Allbwn ysgrifennu: ['->'] + (beverages safle: i), llinell-newydd. } × (beverages cyfrif).
Allbwn ysgrifennu: (beverages cyfuno: [',']), llinell-newydd.
Allbwn ysgrifennu: (numbers cyfuno: ['||']).
