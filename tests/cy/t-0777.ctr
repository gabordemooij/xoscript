#OBSD
>> dirname := [''].
{ dirname atodi: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Rhaglen system: command.
Rhaglen chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename atodi: ['YYYYYYYY']. } * 20.
Ffeil newydd: filename, ysgrifennu: ['sometext'].
{ Ffeil rhestr: ['/tmp/'] + dirname. } * 1000.
Allbwn ysgrifennu: ['no crash'], llinell-newydd.

