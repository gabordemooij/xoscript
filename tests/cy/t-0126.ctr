#Linux
>> Slurp := Gwrthrych newydd.

Slurp ar: ['newydd'] gwneud: {
	eiddo str := [''].
}.

Slurp ar: ['nieuw'] gwneud: {
	eiddo str := [''].
}.

Slurp ar: ['ymateb:'] gwneud: { :blah
		eiddo str atodi: blah.
}.

Slurp ar: ['ymateb:a:'] gwneud: { :blah :blahah
		eiddo str atodi: (blah o: 0 hyd: (blah hyd - 1)).
		eiddo str atodi: [' '].
		eiddo str atodi: blahah.
}.

Slurp ar: ['obtain'] gwneud: {
	>> buffer := eiddo str.
	eiddo str := ['']. <- buffer.
}.


Allbwn ysgrifennu: (Rhaglen system: (Slurp newydd echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Ffeil newydd: ['/tmp/from.txt'], dileu. } dal: { ['Empty']. }, cychwyn.
{ Ffeil newydd: ['/tmp/to.txt'], dileu. } dal: { ['Empty']. }, cychwyn.


Ffeil newydd: ['/tmp/to.txt'], yn-bodoli gau: {
	Allbwn ysgrifennu: ['Confirmed. Target file does not exist.\
'].
}.
Ffeil newydd: ['/tmp/from.txt'], yn-bodoli gau: {
	Allbwn ysgrifennu: ['Confirmed. Source file does not exist.\
'].
}.



Rhaglen system: (Slurp newydd touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Rhaglen system: (Slurp newydd cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Ffeil newydd: ['/tmp/to.txt'], yn-bodoli gwir: {
	Allbwn ysgrifennu: ['Confirmed. Target file has been created by shell.\
'].
}.


Allbwn ysgrifennu: ['Contents of file is:'] + (Ffeil newydd: ['/tmp/to.txt'], darllen), llinell-newydd.
