>> x := Gwrthrych newydd.
>> y := Gwrthrych newydd.
>> z := x.
Allbwn ysgrifennu: (x = z), llinell-newydd.
Allbwn ysgrifennu: (x = y), llinell-newydd.
Allbwn ysgrifennu: (x ≠ y), llinell-newydd.
Allbwn ysgrifennu: (x ≠ z), llinell-newydd.
>> m := Ennyd newydd blwyddyn: 2070, mis: 11.
>> n := m copïo.
Allbwn ysgrifennu: (m = n), llinell-newydd.
Allbwn ysgrifennu: (m ≠ n), llinell-newydd.
Allbwn ysgrifennu: (m hafal: m), llinell-newydd.
Allbwn ysgrifennu: (m hafal: n), llinell-newydd.
n mis: 12.
Allbwn ysgrifennu: (m ≠ n), llinell-newydd.
Allbwn ysgrifennu: (m = n), llinell-newydd.


