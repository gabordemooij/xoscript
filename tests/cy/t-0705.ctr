

>> obj := Gwrthrych newydd.

obj ar: ['greet'] gwneud: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ar: ['task'] gwneud: {
	eiddo property := 123.
	{
		# try binds self/own to object instead of block
		Allbwn ysgrifennu: hun greet.
		Allbwn ysgrifennu: eiddo property.
		1 / 0.
	} dal: {
		Allbwn ysgrifennu: hun greet.
		Allbwn ysgrifennu: eiddo property.
		Allbwn ysgrifennu: ['ok'].
