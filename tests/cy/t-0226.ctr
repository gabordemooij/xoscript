# Test ASCII variants

# Numbers

Allbwn ysgrifennu: (2 !=: 3), llinell-newydd.
Allbwn ysgrifennu: (2 <=: 2), llinell-newydd.
Allbwn ysgrifennu: (2 >=: 2), llinell-newydd.

# Strings

Allbwn ysgrifennu: (['b'] >=: ['a']), llinell-newydd.
Allbwn ysgrifennu: (['b'] !=: ['a']), llinell-newydd.
Allbwn ysgrifennu: (['b'] <=: ['c']), llinell-newydd.

# Bools

Allbwn ysgrifennu: (Gwir !=: Gau), llinell-newydd.

# Objects

Allbwn ysgrifennu: (Gwrthrych newydd !=: Gwrthrych newydd), llinell-newydd.

# ASCII list symbol <-:

Allbwn ysgrifennu: (Rhestr <<: 1, ; 2 ; 3) cyfrif = 3, llinell-newydd.

