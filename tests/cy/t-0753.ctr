Allbwn ysgrifennu: ['Test object'], llinell-newydd.
>> a := Gwrthrych newydd. 

a ar: ['item:'] gwneud: { :fmt
	eiddo fmt := fmt. 
}.

a ar: ['item'] gwneud: { <- eiddo fmt.
}.

a item: ( Fformat newydd: ['|%s|'] ).

Allbwn ysgrifennu: a item, llinell-newydd.

>> old-fmt-address := a item prototeip cyfeiriad-cof.
a save-as: ['/tmp/a.bin'].
Allbwn ysgrifennu: ['========== RELOADING SNAP:'], llinell-newydd.

>> b := Gwrthrych load-from: ['/tmp/a.bin'].

(b item prototeip cyfeiriad-cof = old-fmt-address) gwir: {
	Allbwn ysgrifennu: ['Object link re-attached.'], llinell-newydd.
}.

Allbwn ysgrifennu: ( b item cymhwyso: ['hello'] ), llinell-newydd.
