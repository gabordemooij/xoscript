#Linux
>> OS := Rhaglen gosodiad: ['OS'].

>> clock := Ennyd newydd.
	
(OS = ['Haiku']) gwir: {
	clock parth: ['CET'],
	blwyddyn: 2017, mis: 7, dydd: 13,
	awr: 18, munud: 0, eiliad: 0.
}, arall: {
	clock parth: ['Europe/Amsterdam'],
	blwyddyn: 2017, mis: 7, dydd: 13,
	awr: 18, munud: 0, eiliad: 0.
}.

clock ar: ['tell'] gwneud: {
	Allbwn ysgrifennu: hun, llinell-newydd.
}.


clock ychwanegu: 2    awr, tell.
clock ychwanegu: 1    awr, tell.
clock ychwanegu: 19 munud, tell.
clock ychwanegu: 1  munud, tell.
clock ychwanegu: 1  munud, tell.
clock ychwanegu: 19 eiliad, tell.
clock ychwanegu: 1  eiliad, tell.
clock ychwanegu: 1  eiliad, tell.
clock ychwanegu: 2    blwyddyn, tell.
clock ychwanegu: 1    blwyddyn, tell.

(OS = ['Haiku']) gwir: {
clock ychwanegu: 5   mis.
clock parth: ['CEST'], tell.
}, arall: {
	clock ychwanegu: 5   mis, tell.
}.

clock ychwanegu: 1   mis, tell.
clock ychwanegu: 19    dydd, tell.
clock ychwanegu: 1    awr, tell.
clock ychwanegu: 120  yard, tell.
