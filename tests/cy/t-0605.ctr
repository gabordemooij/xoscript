>> invoice := Gwrthrych newydd.
invoice ar: ['cychwyn'] gwneud: {
        eiddo rhif := 0.
}.

invoice ar: ['rhif'] gwneud: {
        eiddo rhif ychwanegu: 1. <- eiddo rhif copïo.
}.

>> year-invoice := invoice newydd.
year-invoice ar: ['start:'] gwneud: { :blwyddyn
	eiddo rhif := blwyddyn.
}.

year-invoice start: 202000.
Allbwn ysgrifennu: year-invoice rhif, llinell-newydd.
Allbwn ysgrifennu: year-invoice rhif, llinell-newydd.
