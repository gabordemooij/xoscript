Llinyn ar: ['evaluate'] gwneud: {
	>> cod := Ffeil newydd: ['/tmp/eval.ctr'].
	cod ysgrifennu: (hun llinyn + ['.']).
	Rhaglen defnyddio: ['/tmp/eval.ctr'].
}.

>> a := Rhestr ← 1 ; 2 ; 3.
>> b := (a llinyn).

Allbwn ysgrifennu: b, llinell-newydd. 
(['b := '] + b) evaluate.

Allbwn ysgrifennu: b ? 2, llinell-newydd. 

Allbwn ysgrifennu: (( Rhestr ← 1 ; 2 ; 3 )), llinell-newydd. 

Allbwn ysgrifennu: ((Geiriadur newydd) rhoi: 1 yn: 2), llinell-newydd. 

>> x := ( (Rhestr ← 1 ; ( Rhestr ← 9 ) ; Gwir ) ) llinyn.
Allbwn ysgrifennu: x, llinell-newydd. 
(['x := '] + x) evaluate.

Allbwn ysgrifennu: x ? 1 ? 0, llinell-newydd. 

>> y := (Geiriadur newydd) rhoi: (Rhestr ← 1) yn: (Rhestr ← 2).
Allbwn ysgrifennu: y, llinell-newydd. 

(['y := '] + y) llinyn evaluate.

Allbwn ysgrifennu: (y yn: (Rhestr ← 2) llinyn ), llinell-newydd.

Allbwn ysgrifennu: (Rhestr newydd), llinell-newydd. 
Allbwn ysgrifennu: (Geiriadur newydd), llinell-newydd. 
