
>> animal := Gwrthrych newydd. 
 
 animal ar: ['name:'] gwneud: { :n
eiddo enw := n.
}. 


animal name: ['Diva']. 
 
animal ar: ['enw'] gwneud: { <- enw.
}.

>> cat := animal newydd.
 
 cat name: ['Diva']. 
 
 cat ar: ['enw'] gwneud: { <- ['your royal highness ']
+ (hun enw).
}.

Allbwn ysgrifennu: cat enw.
