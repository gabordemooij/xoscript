
Rhif dysgu: ['plus:'] golygu: ['+'].
Rhif ar: ['+'] gwneud: { :x
	>> rate := 1.
	>> currency := x goleddfydd.
	(currency = ['euros']) gwir: {
		rate := 2.
	}. <- (hun plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars cymhwyso-uned: ['dollars'].
euros cymhwyso-uned: ['euros'].
>> money := dollars + euros.
Allbwn ysgrifennu: money, llinell-newydd.
