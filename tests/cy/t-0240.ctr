# test qualifiers

>> $ := Gwrthrych newydd.

$ ar: ['ymateb:'] gwneud: { :x
	
	>> operation := x nod: 0.
	>> valuta := x nod: 1.
	>> money := x atred: 2.
	
	>> amount := 0.

	( operation = ['+'] ) gwir: {
		( valuta = ['£'] ) gwir: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Allbwn ysgrifennu: x, llinell-newydd.


>> Fruit := Gwrthrych newydd.

Fruit ar: ['newydd'] gwneud: {
	>> f := hun newydd.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ar: ['apples:'] gwneud: { :a eiddo apples := a. }.
Fruit ar: ['oranges:'] gwneud: { :p eiddo oranges := p. }.
Fruit ar: ['apples'] gwneud: { <- eiddo apples. }.
Fruit ar: ['oranges'] gwneud: { <- eiddo oranges. }.

Fruit ar: ['+'] gwneud: { :f
	
	>> n := Fruit newydd.
	f ychwanegu: 1.
	
	n apples: (f apples + eiddo apples).
	n oranges:  (f oranges  + eiddo oranges). <- n.
}.

Fruit ar: ['llinyn'] gwneud: { <- ( eiddo apples llinyn + [' apples and '] + eiddo oranges + [' oranges'] ).
}.

Rhif ar: ['apples'] gwneud: { <- ((Fruit newydd) apples: hun).
}.

Rhif ar: ['apple'] gwneud: { <- ((Fruit newydd) apples: hun).
}.

Rhif ar: ['oranges'] gwneud: { <- ((Fruit newydd) oranges: hun).
}.




Allbwn ysgrifennu: (1 apple + 3 oranges + 4 apples), llinell-newydd.


Llinyn ar: ['twice'] gwneud: { <- ((hun llinyn) + (hun llinyn)).
}.



Allbwn ysgrifennu: ['❤❤❤'] twice.



