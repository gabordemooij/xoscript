

>> Matryoshka := Gwrthrych newydd.
Matryoshka ar: ['double:'] gwneud: { :secret
	eiddo secret := secret × 2.
}.
Matryoshka ar: ['newydd:'] gwneud: { :secret
	>> answer := Dim.
	>> t := (secret > 255).
	Allbwn ysgrifennu: (secret + [' | '] + t), llinell-newydd.
	t gwir: {
		answer := secret.
	}, arall: {
		answer := Matryoshka ailadroddus newydd: (hun double: secret).
	}. <- answer.
}.

>> x := Matryoshka newydd: 2.
