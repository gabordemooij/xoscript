# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Rhaglen shell-escape: ['abc'].
Allbwn ysgrifennu: c, llinell-newydd.
Allbwn ysgrifennu: ( Rhaglen system: ['echo '] + c ), llinell-newydd.

c := Rhaglen shell-escape: ['a'b'c'].
Allbwn ysgrifennu: c, llinell-newydd.
Allbwn ysgrifennu: ( Rhaglen system: ['echo '] + c ), llinell-newydd.

c := Rhaglen shell-escape: ['a\'c'].
Allbwn ysgrifennu: c, llinell-newydd.
Allbwn ysgrifennu: ( Rhaglen system: ['echo '] + c ), llinell-newydd.