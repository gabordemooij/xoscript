# catch-all test (practical)
>> HTML := Llinyn newydd.
HTML ar: ['encode:'] gwneud: { :tekst
	hun atodi: (tekst
	disodli: ['&'] gyda: ['&amp;'], 
	disodli: ['<'] gyda: ['&lt;'],
	disodli: ['>'] gyda: ['&gt;'],
	disodli: ['"'] gyda: ['&quot;']).
}.
>> blog := HTML newydd.
blog atodi: ['<h1>'],
     encode: ['Koffie & Thee'],
     atodi: ['</h1>'].
Allbwn ysgrifennu: blog, llinell-newydd.


>> Roman := Rhif newydd.
Roman ar: ['stringy'] gwneud: {
	>> a := [''].
	{ a atodi: ['I']. } × hun. <- a.
}.

>> x := Roman newydd.
x ychwanegu: 3.
Allbwn ysgrifennu: x stringy, llinell-newydd.

>> Quantum := Boole newydd.
Quantum ar: ['true?'] gwneud: { <- ['maybe True']. }.
Allbwn ysgrifennu: (Quantum newydd true?), llinell-newydd.

>> Nihil := Dim newydd.
Nihil ar: ['llinyn'] gwneud: { <- ['Nihil']. }.
Allbwn ysgrifennu: (Nihil newydd), llinell-newydd.
