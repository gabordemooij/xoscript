
>> Greeter := Gwrthrych newydd.
Greeter ar: ['newydd'] gwneud: {
	eiddo enw := ['?'].
}.
Greeter ar: ['name:'] gwneud: { :enw
	eiddo enw := enw.
}.
Greeter ar: ['greet'] gwneud: {
	Allbwn ysgrifennu: (['hello[you]'] [you]: eiddo enw).
}.
>> friend := Greeter newydd.
friend name: ['1'].
friend greet.
