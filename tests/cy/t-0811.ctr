# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Allbwn ysgrifennu: (s copïo o: 0 hyd: 20), llinell-newydd.
Allbwn ysgrifennu: (s copïo o: 10 hyd: 20), llinell-newydd.
Allbwn ysgrifennu: (s copïo o: 14 hyd: 1), llinell-newydd.
Allbwn ysgrifennu: (s copïo atred: 20), llinell-newydd.
Allbwn ysgrifennu: ['-'], llinell-newydd.
Allbwn ysgrifennu: (['abcdef'] o: 2 hyd: 2), llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: 1 hyd: ['9e300'] rhif), llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: 1 hyd: ['-9e300'] rhif), llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: ['9e300'] rhif hyd: 1), llinell-newydd.
Allbwn ysgrifennu: ['-'], llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: ['-9e300'] rhif hyd: 2), llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: ['nan'] rhif hyd: 2), llinell-newydd.
Allbwn ysgrifennu: (['abc'] o: 0 hyd: ['nan'] rhif), llinell-newydd.
Allbwn ysgrifennu: ['-'], llinell-newydd.
