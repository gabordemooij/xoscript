

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Rhaglen rheoli-cof: 0.

>> a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
>> b := a o: 2 hyd: 2.
Allbwn ysgrifennu: ( b cyfuno: ['|'] ), ysgrifennu: b cyfrif.

Rhaglen tacluso.
usedMemory1 := (Rhaglen cof ? 0).


a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
b := a o: 2 hyd: 2.
Allbwn ysgrifennu: ( b cyfuno: ['|'] ), ysgrifennu: b cyfrif.


Rhaglen tacluso.
usedMemory2 := (Rhaglen cof ? 0).


a := Rhestr ← ['hello'] ; ['world'] ; Gwir ; Dim ; 666.
b := a o: 2 hyd: 2.
Allbwn ysgrifennu: ( b cyfuno: ['|'] ), ysgrifennu: b cyfrif.


Rhaglen tacluso.
usedMemory3 := (Rhaglen cof ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) gwir: {
	Allbwn ysgrifennu: ['No memory leaks here'].
}, gau: {
	Allbwn ysgrifennu: ['Leaking memory...'].
}.
