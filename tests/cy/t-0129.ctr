
Rhestr ar: ['product'] gwneud: {
	>> total := 1.
	hun pob: { :index :element
		total lluosi-gyda: element.
	}. <- total.
}.

>> a := Rhestr ← 1 ; 2 ; 3.
Allbwn ysgrifennu: a product, llinell-newydd.
Allbwn ysgrifennu: (Rhestr ← 2 ; 4 ; 8) product, llinell-newydd. 
Allbwn ysgrifennu: (Rhestr ← -2 ; 10) product, llinell-newydd. 
Allbwn ysgrifennu: (Rhestr ← 0.5 ; -2) product, llinell-newydd. 
