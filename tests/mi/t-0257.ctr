
>> Greeter := Ahanoa hou.
Greeter ina-tae: ['hou'] mahia: {
	ake ingoa := ['?'].
}.
Greeter ina-tae: ['name:'] mahia: { :ingoa
	ake ingoa := ingoa.
}.
Greeter ina-tae: ['greet'] mahia: {
	Huaputa tuhi: (['hello[you]'] [you]: ake ingoa).
}.
>> friend := Greeter hou.
friend name: ['1'].
friend greet.
