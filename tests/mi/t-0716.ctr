Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['state:'] mahia: { :list
	ake list := list. 
}.

a ina-tae: ['state'] mahia: {
	Huaputa tuhi: ake list, rārangi-hou.
}.

a state: ( Rārangi hou ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
