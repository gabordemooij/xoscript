>> winery := { <- (	Papakupu hou
		tuku: 2 kei: ['merlot'],
		tuku: 3 kei: ['malbec'],
		tuku: 4 kei: ['syrah']
	).
}.

Huaputa tuhi: (((winery tīmata) - ['nothing']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['merlot']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['malbec']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['syrah']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['merlot'] - ['malbec']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['merlot'] - ['syrah']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['malbec'] -['syrah']) tatau), rārangi-hou.
Huaputa tuhi: (((winery tīmata) - ['malbec'] - ['syrah'] - ['merlot']) tatau), rārangi-hou.

