# catch-all test (practical)
>> HTML := Aho hou.
HTML ina-tae: ['encode:'] mahia: { :tekst
	whaiaro tāpiri-muri: (tekst
	whakakapihia: ['&'] me: ['&amp;'], 
	whakakapihia: ['<'] me: ['&lt;'],
	whakakapihia: ['>'] me: ['&gt;'],
	whakakapihia: ['"'] me: ['&quot;']).
}.
>> blog := HTML hou.
blog tāpiri-muri: ['<h1>'],
     encode: ['Koffie & Thee'],
     tāpiri-muri: ['</h1>'].
Huaputa tuhi: blog, rārangi-hou.


>> Roman := Tau hou.
Roman ina-tae: ['stringy'] mahia: {
	>> a := [''].
	{ a tāpiri-muri: ['I']. } × whaiaro. <- a.
}.

>> x := Roman hou.
x tāpiri: 3.
Huaputa tuhi: x stringy, rārangi-hou.

>> Quantum := Pūtaha hou.
Quantum ina-tae: ['true?'] mahia: { <- ['maybe True']. }.
Huaputa tuhi: (Quantum hou true?), rārangi-hou.

>> Nihil := Kore hou.
Nihil ina-tae: ['aho'] mahia: { <- ['Nihil']. }.
Huaputa tuhi: (Nihil hou), rārangi-hou.
