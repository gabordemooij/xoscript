
Tau ako: ['plus:'] te-tikanga: ['+'].
Tau ina-tae: ['+'] mahia: { :x
	>> rate := 1.
	>> currency := x waeine-tau.
	(currency = ['euros']) pono: {
		rate := 2.
	}. <- (whaiaro plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars waeine: ['dollars'].
euros waeine: ['euros'].
>> money := dollars + euros.
Huaputa tuhi: money, rārangi-hou.
