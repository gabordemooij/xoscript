{
	tēnei-mahi hapa: ['Dont fail.'].
	unknown doSomething.
} hopu: {
	Huaputa tuhi: ['Caught!'].
}, tīmata.

{
	tēnei-mahi hapa: ['Dont fail.'].
	ake unknown doSomething.
} hopu: {
	Huaputa tuhi: ['Caught!'].
}, tīmata.

{
	tēnei-mahi hapa: ['Dont fail.'].
	unknown := 122.
} hopu: {
	Huaputa tuhi: ['Caught!'].
}, tīmata.


{
	tēnei-mahi hapa: ['Dont fail.'].
	Pono whati.
	Huaputa tuhi: ['FAIL'].
} hopu: {
	Huaputa tuhi: ['Caught!'].
}, tīmata.

{
	{
		tēnei-mahi hapa: ['Dont fail.'].
		Pono whati.
		Huaputa tuhi: ['FAIL'].
	} hopu: { :x
		(x = ['Dont fail.']) pono: { tēnei-mahi hapa: ['Nested Caught!']. }.
	}, tīmata.
} hopu: { :e
	Huaputa tuhi: e.
}, tīmata.
