
Server init.
Huaputa tuhi: ['Database test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], 
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu :=
db uiui: ['SELECT UNHEX('CAFE') AS blobby'],
tikina: { :row
	Huaputa tuhi: ( row blobby mai: 0 roa: 2 ), rārangi-hou.
	row blobby wewete.
}.
