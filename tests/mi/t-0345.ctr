# test catch-all methods
>> x13 := Ahanoa hou.
x13 ina-tae: ['a'] mahia: { :a Huaputa tuhi: 0, rārangi-hou. }.
x13 ina-tae: ['a:'] mahia: { :a Huaputa tuhi: a, rārangi-hou. <- 5. }.
x13 ina-tae: ['a:b:'] mahia: { :a :b Huaputa tuhi: (a + b), rārangi-hou. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
