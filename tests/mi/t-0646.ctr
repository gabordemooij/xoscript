Server init.
Huaputa tuhi: ['Database datetime test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], 
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu :=
db uiui: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
tikina: { :row
	Huaputa tuhi: row datetimetest, rārangi-hou.
}.
