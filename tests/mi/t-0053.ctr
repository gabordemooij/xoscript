60 × {
	>> x := (Tau random % 6) + 1.
	(x ≤ 6) teka: { Huaputa tuhi: ['FAIL']. }.
	(x ≥0) teka: { Huaputa tuhi: ['FAIL']. }.
	x := (Tau random % 3) + 1.
	(x < 3) teka: { Huaputa tuhi: ['FAIL']. }.
	(x>-1) teka: { Huaputa tuhi: ['FAIL']. }.
	x := ((Pūtaha flip) tau).
	(x = 0 ranei: x = 1) teka: { Huaputa tuhi: ['FAIL']. }.
	x := ((Pono flip) tau).
	(x = 0 ranei: x = 1) teka: { Huaputa tuhi: ['FAIL']. }.
	x := (Pūtaha flip tēnei: ['HEAD'] tērā-rānei: ['TAIL']).
	((x = ['HEAD']) ranei: (x = ['TAIL'])) teka: { Huaputa tuhi: ['FAIL']. }.
}.
Huaputa tuhi: ['DONE'].

