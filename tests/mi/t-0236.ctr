>> Slurp := Ahanoa hou.
Slurp ina-tae: ['hou'] mahia: {
	ake str := [''].
}.


Slurp ina-tae: ['whakautu:'] mahia: { :blah
		(ake str ≠ ['']) pono: {
			ake str tāpiri-muri: [' '].
		}.
		ake str tāpiri-muri: blah.
}.
Slurp ina-tae: ['whakautu:a:'] mahia: { :blah :blahah
		(ake str ≠ ['']) pono: {
			ake str tāpiri-muri: [' '].
		}.
		(blah roa > 1) pono: {
			ake str tāpiri-muri: (blah mai: 0 roa: (blah roa - 1)).
		}, ki-te-kore: {
			ake str tāpiri-muri: blah.
		}.
		ake str tāpiri-muri: [' '].
		ake str tāpiri-muri: blahah.
}.
Slurp ina-tae: ['obtain'] mahia: {
	>> buffer := ake str.
	ake str := ['']. <- buffer.
}.

>> tawhā-rapu := Slurp hou.
tawhā-rapu select: ['*'], from users where: ['id = 2'].
Huaputa tuhi: (tawhā-rapu obtain), rārangi-hou.
