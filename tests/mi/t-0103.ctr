>> a := Rārangi ← Ahanoa ; Pono ; Teka ; Pūtaha ; 1 ; Tau ; ['Str'] ; Aho ; { ['Empty']. }.
Huaputa tuhi: (a tatau), rārangi-hou.
{ :i
	Huaputa tuhi: 
	['a '] + 
	((a ? i) momo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Kore?) tēnei: [''] tērā-rānei: ['NOT']) + 
	[' Nil.'],
	rārangi-hou.
} × (a tatau).
Huaputa tuhi: ['but.. Nil is.. '] + ((Kore Kore?) tēnei: ['certainly NIL!'] tērā-rānei: ['not NIL??']), rārangi-hou.