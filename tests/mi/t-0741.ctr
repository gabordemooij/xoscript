Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :octhelper
	ake octhelper := octhelper. 
}.

a ina-tae: ['item'] mahia: { <- ake octhelper.
}.

a item: Oct hou.

>> old-octhelper-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-octhelper-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
