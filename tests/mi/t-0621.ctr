>> phrases := Rārangi hou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ia: { :_ :phrase 
	>> e := Server base64-whakawaehere: phrase.
	>> d := Server base64-wetewaehere: e.
	Huaputa tuhi: (
		message tārua ~encoded: e, ~decoded: d
	), rārangi-hou.
}.
