
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> waehere := {
	>> o := (
		Papakupu hou
		aa: (Rārangi ← 1 ; 2),
		bb: (Rārangi ← 3 ; 4)
	).
	>> s := o aho.
	>> o2 := s ahanoa.
	(s  momo = Aho momo) pono: { Huaputa tuhi: ['OK1'], rārangi-hou. }.
	(o2 momo = Papakupu momo) pono: { Huaputa tuhi: ['OK2'], rārangi-hou. }.
}.

Papatono whakahaere-pūmahara: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 1).
waehere tīmata.
Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 1).
waehere tīmata.
Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 1).
waehere tīmata.
Papatono whakapai.
usedMemory4 := (Papatono pūmahara ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) pono: { Huaputa tuhi: ['OK3'], rārangi-hou. }.
 
