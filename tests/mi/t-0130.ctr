# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Papatono tautuhinga: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server hono: ( Rārangi hou ;
 libname ; ['fopen'] ;
 ( Rārangi hou ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
hono: ( Rārangi hou ;
 Kore ; # means same lib
 ['fread'] ;
 ( Rārangi hou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Kore ; # means same object (i.e. Stream)
 ['fread']
),
hono: (
 Rārangi hou ;
 Kore ; # means same lib
 ['fwrite'] ;
 ( Rārangi hou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Kore ; # means same lib
 ['fwrite']
),
hono: (
 Rārangi hou ;
 Kore ; # means same lib
 ['rewind'] ;
 ( Rārangi hou ; ['pointer'] ) ;
 ['int'] ;
 Kore ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ara-kōnae := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ara-kōnae mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream karere: ['fwrite'] tāuru-maha: (Rārangi hou ; str ; 1 ; 6 ; fd ).
Huaputa tuhi: bytes-written, rārangi-hou.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob hou: 20.

# read from file
>> bytes-read := Stream karere: ['fread'] tāuru-maha: (Rārangi hou ; buf ; 1 ; 6 ; fd ).
Huaputa tuhi: bytes-read, rārangi-hou.
Huaputa tuhi: buf, rārangi-hou.

# free memory
str  wewete.
ara-kōnae wewete.
mode wewete.
buf  wewete.


