# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Tauira-rapu hou: pattern.
	p ōritenga: subject mahia: { :m :g
		Huaputa tuhi: g tatau, tuhi: [' '], tuhi: (g honoa: ['|']), rārangi-hou. <- m.
	}.
}.
show whakahaere: ['(a)|(b)'] a: ['b'].
show whakahaere: ['(a)|(b)'] a: ['a'].
show whakahaere: ['(x)?y'] a: ['y'].
show whakahaere: ['(x)?(y)(z)?'] a: ['xy'].
