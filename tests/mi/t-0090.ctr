Huaputa tuhi: ['1,2,3,4,5,6,7,8,9,A,'], rārangi-hou.
>> Scope := Ahanoa hou.
Scope ina-tae: ['initialize:'] mahia: { :x ake property := x. }.
Scope ina-tae: ['confirm'] mahia: { Huaputa tuhi: [',']. }.
Scope ina-tae: ['whakamātautau'] mahia: {
	Huaputa tuhi: ake property.
	whaiaro confirm.
	( 1 = 1 ) pono: { Huaputa tuhi: ake property. whaiaro confirm. }.
	( 1 = 0 ) teka: { Huaputa tuhi: ake property. whaiaro confirm. }.
	>> y := 2. { Huaputa tuhi: ake property. whaiaro confirm. } i-te-wa: { y tango: 1. <- (y > 0). }.
	{ Huaputa tuhi: ake property. whaiaro confirm. } × 1.
	(Rārangi ← 1) ia: {  Huaputa tuhi: ake property. whaiaro confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Papakupu hou one: ['item']) ia: { Huaputa tuhi: ake property. whaiaro confirm. }.
	{ 1 ÷ 0. } hopu: { Huaputa tuhi: ake property. whaiaro confirm. }, tīmata.
	Huaputa rārangi-hou.
}.
>> scope1 := Scope hou.
scope1 initialize: ['X'].
scope1 whakamātautau.
>> function := { 
	ake property := ['Y'].
	Huaputa tuhi: ake property.
	whaiaro confirm.
	( 1 = 1 ) pono: { Huaputa tuhi: ake property. whaiaro confirm. }.
	( 1 = 0 ) teka: { Huaputa tuhi: ake property. whaiaro confirm. }.
	>> y := 2. { Huaputa tuhi: ake property. whaiaro confirm. } i-te-wa: { y tango: 1. <- (y > 0). }.
	{ Huaputa tuhi: ake property. whaiaro confirm. } × 1.
	(Rārangi ← 1) ia: {  Huaputa tuhi: ake property. whaiaro confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Papakupu hou one: ['item']) ia: { Huaputa tuhi: ake property. whaiaro confirm. }.
	{ 1 ÷ 0. } hopu: { Huaputa tuhi: ake property. whaiaro confirm. }, tīmata.
	Huaputa rārangi-hou.
}.
function ina-tae: ['confirm'] mahia: { Huaputa tuhi: [',']. }.
function whakahaere: 1 a: 2.
