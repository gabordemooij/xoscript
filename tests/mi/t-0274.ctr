

Rārangi ina-tae: ['column:'] mahia: { :column
	>> result := Rārangi hou.
	whaiaro ia: { :index :row
		row ia: { :index :cell
			(index = column) pono: { result tāpiri-muri: cell. }.
		}.
	}. <- result.
}.


>> a := Rārangi ←
	(Rārangi ← 1 ; 2 ; 3) ;
	(Rārangi ← 4 ; 5 ; 6) ;
	(Rārangi ← 7 ; 8 ; 9).

>> b := a column: 1.
Huaputa tuhi: b, rārangi-hou.

b := a column: 20.
Huaputa tuhi: b, rārangi-hou.

b := a column: -100.
Huaputa tuhi: b, rārangi-hou.
