>> makeAdder := { :x
	>> f := { :y <- (ake x + y). } tautuhi: ['x'] uara: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ake q tuku: (ake f whakahaere: (ake q ? i)) kei: i. } 
	tautuhi: ['q'] uara: array,
	tautuhi: ['f'] uara: func.
	{ :i mapping whakahaere: i. } × (array tatau).
}.

>> a := Rārangi ← 1; 2; 3.
mapper whakahaere: a a: (makeAdder whakahaere: 100).
Huaputa tuhi: (a tūnga: 0), rārangi-hou.
Huaputa tuhi: (a ? 1), rārangi-hou.
Huaputa tuhi: (a ? 2), rārangi-hou.
