#Linux

 >> t := Wā hou.
 
t rohe: ['Europe/Amsterdam'].
t tau-maramataka: 2020, marama: 8, rā: 2, haora: 21, meneti: 2, hēkona: 1.

>> a := t haora.
>> ams := t rohe.

t rohe: ['US/Hawaii'].
>> b := t haora.
>> hw := t rohe.

Huaputa
tuhi: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		tēnei: ['later'] tērā-rānei: ['earlier']
	)
),
rārangi-hou.
 