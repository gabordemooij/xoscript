

Aho ina-tae: ['evaluate'] mahia: {
	>> waehere := Kōnae hou: ['/tmp/eval.ctr'].
	waehere tuhi: whaiaro aho + ['.'].
	Papatono whakamahi: ['/tmp/eval.ctr'].
}.

>> a := (Rārangi ← (
	(Papakupu hou)
		tuku: ['domain'] kei: ['mywebsite.com'],
		tuku: (Rārangi ←
			((Papakupu hou)
				tuku: ['home'] kei: ['title'],
				tuku: ['<html></html>'] kei: ['body'],
				tuku: ['2017-01-01'] kei: ['created']
			) ;
			((Papakupu hou)
				tuku: ['aboutus(c)'] kei: ['title'],
				tuku: ['<credits>Author Inc.</credits>'] kei: ['body']
			)
		) kei: ['pages']
	)
) aho.

Huaputa tuhi: a momo, rārangi-hou.
Huaputa tuhi: a, rārangi-hou.

>> b := Kore.
(['b := '] + a) evaluate.
Huaputa tuhi: b ? 0 ? ['pages'] ? 1 ? ['body'], rārangi-hou.

>> c := b ? 0.
>> d := c aho.
Huaputa tuhi: d momo, rārangi-hou.

>> e := Kore.
(['e := '] + d) evaluate.
Huaputa tuhi: e ? ['pages'] ? 0, rārangi-hou.
