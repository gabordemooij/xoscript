Huaputa tuhi: ((Rārangi hou
	ina-tae: ['plaque:'] mahia: { :x ake o := x. },
	ina-tae: ['plaque']  mahia: { <- ake o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Rārangi ← 1)
	~ (Rārangi ← 1 ; 2)
	~ (Rārangi ← 1 ; 2 ; 3)
	~ (Rārangi ← 1 ; 2 ; 3 ; 4)
	~ (Rārangi ← 1 ; 2 ; 3 ; 4 ; 5)
) ia: { :i :el
	{ Huaputa tuhi: tēnei-mahi. } × el tatau.
	Huaputa rārangi-hou.
}) plaque, rārangi-hou.


