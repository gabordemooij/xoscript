#Linux
>> OS := Papatono tautuhinga: ['OS'].

>> clock := Wā hou.
	
(OS = ['Haiku']) pono: {
	clock rohe: ['CET'],
	tau-maramataka: 2017, marama: 7, rā: 13,
	haora: 18, meneti: 0, hēkona: 0.
}, ki-te-kore: {
	clock rohe: ['Europe/Amsterdam'],
	tau-maramataka: 2017, marama: 7, rā: 13,
	haora: 18, meneti: 0, hēkona: 0.
}.

clock ina-tae: ['tell'] mahia: {
	Huaputa tuhi: whaiaro, rārangi-hou.
}.


clock tāpiri: 2    haora, tell.
clock tāpiri: 1    haora, tell.
clock tāpiri: 19 meneti, tell.
clock tāpiri: 1  meneti, tell.
clock tāpiri: 1  meneti, tell.
clock tāpiri: 19 hēkona, tell.
clock tāpiri: 1  hēkona, tell.
clock tāpiri: 1  hēkona, tell.
clock tāpiri: 2    tau-maramataka, tell.
clock tāpiri: 1    tau-maramataka, tell.

(OS = ['Haiku']) pono: {
clock tāpiri: 5   marama.
clock rohe: ['CEST'], tell.
}, ki-te-kore: {
	clock tāpiri: 5   marama, tell.
}.

clock tāpiri: 1   marama, tell.
clock tāpiri: 19    rā, tell.
clock tāpiri: 1    haora, tell.
clock tāpiri: 120  yard, tell.
