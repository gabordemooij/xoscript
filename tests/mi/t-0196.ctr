
>> animal := Ahanoa hou. 
 
 animal ina-tae: ['name:'] mahia: { :n
ake ingoa := n.
}. 


animal name: ['Diva']. 
 
animal ina-tae: ['ingoa'] mahia: { <- ingoa.
}.

>> cat := animal hou.
 
 cat name: ['Diva']. 
 
 cat ina-tae: ['ingoa'] mahia: { <- ['your royal highness ']
+ (whaiaro ingoa).
}.

Huaputa tuhi: cat ingoa.
