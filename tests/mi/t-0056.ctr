>> z := Ahanoa hou.
z ina-tae: ['value:'] mahia: { :v
	ake value := v. <- whaiaro.
}.
z ina-tae: ['value'] mahia: { <- ake value. }.
(z setValue: 1) value: 2.
Huaputa tuhi: z value.
>> x := z.
Huaputa tuhi: x value.
z := Kore.
Huaputa tuhi: z value.
Huaputa tuhi: x value.
Huaputa tuhi: ['hello'].
Huaputa tuhi: 3 + 2.
Huaputa tuhi: (3 > 2).
