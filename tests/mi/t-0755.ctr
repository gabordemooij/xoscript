Huaputa tuhi: ['Test object'], rārangi-hou.
>> greeter := Ahanoa hou.
greeter ina-tae: ['name:'] mahia: { :ingoa
	ake xname := ingoa. 
}.
greeter ina-tae: ['greet'] mahia: {
	Huaputa tuhi: ['Hello '] + ake xname, rārangi-hou.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
