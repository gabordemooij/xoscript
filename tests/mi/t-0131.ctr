
>> a := Rārangi ← (Rārangi ← 100 ; 200 ; 300) ; (Rārangi ← 9 ; 8 ; 7).
Huaputa tuhi: ['at 0,1 :'].
Huaputa tuhi: a ? 0 ? 1, rārangi-hou. 
Huaputa tuhi: ['at 1,2 :'].
Huaputa tuhi: a ? 1 ? 2, rārangi-hou. 
>> menu := Papakupu hou.
menu tuku: (Rārangi ← ['pizza'] ; ['spaghetti']) kei: ['Italian Cuisine'].
menu tuku: (Rārangi ← ['bifteki'] ; ['suflaki']) kei: ['Greek Cuisine'].
Huaputa tuhi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), rārangi-hou. 
Huaputa tuhi: ['but not on the same plate.'], rārangi-hou.
