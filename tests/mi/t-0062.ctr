Pūtaha ina-tae: ['xor:'] mahia: { :a :b <- ((a a: b kāore) ranei: (a kāore a: b)).
}.

>> o := Ahanoa hou.
o ina-tae: ['hello'] mahia: { ['Empty']. }.
{ o ina-tae: 2 mahia: 3.} hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
{ o ina-tae: ['whakamātautau'] mahia: 3.} hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
{ o ina-tae: ['hello'] mahia: { ['Empty']. }.} hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ >> z := 4 ÷ 0. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ (Pono a: Kore) pono: { Huaputa tuhi: ['X'].}. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ ([''] xor: 0) pono: { Huaputa tuhi: ['X'].}. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ (1 < ['2']) pono: { Huaputa tuhi: ['OK']. }. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ (1 < ['2.0']) pono: { Huaputa tuhi: ['OK']. }. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ (1 < ['x2.0']) pono: { Huaputa tuhi: ['NO!']. }. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata. 
{ Huaputa tuhi: (['hello OK there'] mai: ['6'] roa: ['2']). } tīmata. 
