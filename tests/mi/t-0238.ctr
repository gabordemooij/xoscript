Aho ina-tae: ['evaluate'] mahia: {
	>> waehere := Kōnae hou: ['/tmp/eval.ctr'].
	waehere tuhi: (whaiaro aho + ['.']).
	Papatono whakamahi: ['/tmp/eval.ctr'].
}.

>> a := Rārangi ← 1 ; 2 ; 3.
>> b := (a aho).

Huaputa tuhi: b, rārangi-hou. 
(['b := '] + b) evaluate.

Huaputa tuhi: b ? 2, rārangi-hou. 

Huaputa tuhi: (( Rārangi ← 1 ; 2 ; 3 )), rārangi-hou. 

Huaputa tuhi: ((Papakupu hou) tuku: 1 kei: 2), rārangi-hou. 

>> x := ( (Rārangi ← 1 ; ( Rārangi ← 9 ) ; Pono ) ) aho.
Huaputa tuhi: x, rārangi-hou. 
(['x := '] + x) evaluate.

Huaputa tuhi: x ? 1 ? 0, rārangi-hou. 

>> y := (Papakupu hou) tuku: (Rārangi ← 1) kei: (Rārangi ← 2).
Huaputa tuhi: y, rārangi-hou. 

(['y := '] + y) aho evaluate.

Huaputa tuhi: (y kei: (Rārangi ← 2) aho ), rārangi-hou.

Huaputa tuhi: (Rārangi hou), rārangi-hou. 
Huaputa tuhi: (Papakupu hou), rārangi-hou. 
