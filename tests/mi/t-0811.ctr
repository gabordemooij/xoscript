# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Huaputa tuhi: (s tārua mai: 0 roa: 20), rārangi-hou.
Huaputa tuhi: (s tārua mai: 10 roa: 20), rārangi-hou.
Huaputa tuhi: (s tārua mai: 14 roa: 1), rārangi-hou.
Huaputa tuhi: (s tārua pekepeke: 20), rārangi-hou.
Huaputa tuhi: ['-'], rārangi-hou.
Huaputa tuhi: (['abcdef'] mai: 2 roa: 2), rārangi-hou.
Huaputa tuhi: (['abc'] mai: 1 roa: ['9e300'] tau), rārangi-hou.
Huaputa tuhi: (['abc'] mai: 1 roa: ['-9e300'] tau), rārangi-hou.
Huaputa tuhi: (['abc'] mai: ['9e300'] tau roa: 1), rārangi-hou.
Huaputa tuhi: ['-'], rārangi-hou.
Huaputa tuhi: (['abc'] mai: ['-9e300'] tau roa: 2), rārangi-hou.
Huaputa tuhi: (['abc'] mai: ['nan'] tau roa: 2), rārangi-hou.
Huaputa tuhi: (['abc'] mai: 0 roa: ['nan'] tau), rārangi-hou.
Huaputa tuhi: ['-'], rārangi-hou.
