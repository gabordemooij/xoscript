


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.
>> palette := Kore.
>> colors := Kore.

{
palette := Papakupu hou.
palette 
	tuku: ['#F00'] kei: ['red'],
	tuku: ['#0F0'] kei: ['green'],
	tuku: ['#00F'] kei: ['blue'].
Huaputa tuhi: ['number of RGB codes in palette: '] + ( palette tatau ), rārangi-hou.
Huaputa tuhi: ['RGB code of green is: '] + ( palette ? ['green'] ), rārangi-hou.
colors := [''].
( palette ia: { :ingoa :waehere
		colors := colors + ( ingoa + [':'] + waehere ).
} ).
Huaputa tuhi: ['All colors in palette: '] + colors, rārangi-hou.
} tīmata.
Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 0).

{
palette := Papakupu hou.
palette 
	tuku: ['#F00'] kei: ['red'],
	tuku: ['#0F0'] kei: ['green'],
	tuku: ['#00F'] kei: ['blue'].
Huaputa tuhi: ['number of RGB codes in palette: '] + ( palette tatau ), rārangi-hou.
Huaputa tuhi: ['RGB code of green is: '] + ( palette ? ['green'] ), rārangi-hou.
colors := [''].
( palette ia: { :ingoa :waehere
		colors := colors + ( ingoa + [':'] + waehere ).
} ).
Huaputa tuhi: ['All colors in palette: '] + colors, rārangi-hou.
} tīmata.
Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).

{
palette := Papakupu hou.
palette 
	tuku: ['#F00'] kei: ['red'],
	tuku: ['#0F0'] kei: ['green'],
	tuku: ['#00F'] kei: ['blue'].
Huaputa tuhi: ['number of RGB codes in palette: '] + ( palette tatau ), rārangi-hou.
Huaputa tuhi: ['RGB code of green is: '] + ( palette ? ['green'] ), rārangi-hou.
colors := [''].
( palette ia: { :ingoa :waehere
		colors := colors + ( ingoa + [':'] + waehere ).
} ).
Huaputa tuhi: ['All colors in palette: '] + colors, rārangi-hou.
} tīmata.
Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
