Tau ina-tae: ['factorial'] mahia: {
	>> total := 1.
	{ :index total whakarau-ki: (whaiaro - (index)). } × whaiaro. <- total.
}.
>> Printer := Ahanoa hou.
Printer ina-tae: ['print:and:'] mahia: { :x :y
	Huaputa tuhi: ['a='] + x + [', b='] + y, rārangi-hou.
}.
>> a := 4.5. >> b := a whakaawhiwhi-iho.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a whakaawhiwhi-ake.
Printer print: a and: b.
a := 4.5. b := a whakaawhiwhi-iho.
Printer print: a and: b.
a := 4.5. b := a whakaawhiwhi.
Printer print: a and: b.
a := 4.2. b := a whakaawhiwhi.
Printer print: a and: b.

Huaputa tuhi: (9 toenga: 5), rārangi-hou.
Huaputa tuhi: -666 uara-pū, rārangi-hou.
Huaputa tuhi: 49 pakiaka-tapawha, rārangi-hou.
Huaputa tuhi: (2 pū: 3), rārangi-hou.
>> l := (Rārangi ← 9 ; 6).
Huaputa tuhi: l iti-rawa.

