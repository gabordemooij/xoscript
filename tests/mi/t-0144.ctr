



>> CoffeeGrounds := Ahanoa hou.
CoffeeGrounds ina-tae: ['extract'] mahia: { <- ['coffee']. }.

>> CoffeeMachine := Ahanoa hou.
CoffeeMachine ina-tae: ['init'] mahia: {
	ake coffeegrounds := CoffeeGrounds hou.
}.
CoffeeMachine ina-tae: ['hou'] mahia: { <- CoffeeMachine `new init.
}.

CoffeeMachine ina-tae: ['makeTea'] mahia: { <- (ake tealeaves extract). }.
CoffeeMachine ina-tae: ['makeCoffee'] mahia: { <- (ake coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine hou.

Huaputa tuhi:
	coffeeDream 
	makeCoffee.

Huaputa tuhi:
	coffeeDream 
	makeTea.
