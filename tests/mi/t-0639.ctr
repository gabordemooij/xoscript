
Server init.
Huaputa tuhi: ['Database test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], 
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu :=
db uiui: ['SELECT REPEAT('Blah',1000) AS blah'], 
tikina: { :row 
	Huaputa tuhi: row blah roa, rārangi-hou.
}.
