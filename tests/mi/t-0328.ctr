Papatono whakahaere-pūmahara: 4.

>> Doubler := Ahanoa hou.
>> Multiplier := Ahanoa hou.
Doubler ina-tae: ['double:and:'] mahia: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ina-tae: ['multiply:and:'] mahia: { :x :y <- (x × y).
}.

Huaputa tuhi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), rārangi-hou.
