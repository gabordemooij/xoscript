>> map1 := Papakupu hou.
>> key1 := Rārangi hou.
>> key2 := Rārangi hou.

map1
	tuku: ['hello'] kei: key1,
	tuku: ['world'] kei: key2.


Huaputa
	tuhi: ['Map #1 contains: '] + (map1 kei: key1),
	tuhi: [' and '] + (map1 kei: key2), rārangi-hou.

>> KeyeableArray := Rārangi hou.
KeyeableArray ina-tae: ['toString'] mahia: { <- (whaiaro tatau) toString.
}.

>> map2 := Papakupu hou.
key1 := KeyeableArray hou.
key2 := KeyeableArray hou.

key1 tāpiri-muri: 1.

map2
	tuku: ['hello'] kei: key1,
	tuku: ['world'] kei: key2.

Huaputa
	tuhi: ['Map #2 contains: '] + (map2 kei: key1),
	tuhi: [' and '] + (map2 kei: key2), rārangi-hou.
