# test qualifiers

Papatono whakapai.

>> Fruit := Ahanoa hou.
Fruit ina-tae: ['hou'] mahia: {
	>> f := whaiaro hou.
	f apples: 0. <- f.
}.
Fruit ina-tae: ['apples:'] mahia: { :a ake apples := a. }.
Fruit ina-tae: ['apples'] mahia: { <- ake apples. }.
Fruit ina-tae: ['+'] mahia: { :f
	>> n := Fruit hou.
	n apples: (f apples + ake apples). <- n.
}.
Tau ina-tae: ['apples'] mahia: { <- ((Fruit hou) apples: whaiaro).
}.

Fruit ina-tae: ['aho'] mahia: { <- ake apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Huaputa tuhi: q, rārangi-hou.




q := 3 apples + 4 apples.
Huaputa tuhi: q, rārangi-hou.



q := 3 apples + 4 apples.
Huaputa tuhi: q, rārangi-hou.


