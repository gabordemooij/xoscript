Huaputa tuhi: ['Test object'], rārangi-hou.
>> cmd := Tono hou.
Huaputa tuhi: cmd ls /tmp, rārangi-hou.
>> old-cmd-address := cmd tauira-taketake wāhitau-pūmahara.
cmd save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
(b tauira-taketake wāhitau-pūmahara = old-cmd-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
Huaputa tuhi: b ls, rārangi-hou.


