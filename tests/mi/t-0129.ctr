
Rārangi ina-tae: ['product'] mahia: {
	>> total := 1.
	whaiaro ia: { :index :element
		total whakarau-ki: element.
	}. <- total.
}.

>> a := Rārangi ← 1 ; 2 ; 3.
Huaputa tuhi: a product, rārangi-hou.
Huaputa tuhi: (Rārangi ← 2 ; 4 ; 8) product, rārangi-hou. 
Huaputa tuhi: (Rārangi ← -2 ; 10) product, rārangi-hou. 
Huaputa tuhi: (Rārangi ← 0.5 ; -2) product, rārangi-hou. 
