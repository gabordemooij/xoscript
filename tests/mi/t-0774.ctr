Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 
a ina-tae: ['item:'] mahia: { :lst
	ake lst := lst. 
}.
a ina-tae: ['item'] mahia: { <- ake lst.
}.
a item: (
	Rārangi hou ; 1 ; (
		Rārangi hou ; ['a'] ; (
			Rārangi hou ; ( Wā hou: 1 )
		) ; ( Int64 mai-i-te-aho: ['321'] )
	)
).
Huaputa tuhi: a item, rārangi-hou.
>> old-lst-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
(b item tauira-taketake wāhitau-pūmahara = old-lst-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
Huaputa tuhi: ( b item ), rārangi-hou.
