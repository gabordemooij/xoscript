Rārangi ina-tae: ['sum'] mahia: {
	>> total := 0.
	whaiaro ia: { :index :element
		total tāpiri: element.
	}. <- total.
}.

>> a := Pono.



a ina-tae: ['aho'] mahia: {
	>> answer := Kore.
	( whaiaro = Pono ) pono: {
		answer := ['Yep'].
	}, ki-te-kore: {
		answer := ['Nope'].
	}. <- answer.
}.

a ina-tae: ['tau'] mahia: {
	>> answer := Kore.
	( whaiaro = Pono ) pono: {
		answer := 10.
	}, ki-te-kore: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ina-tae: ['aho'] mahia: { <- ['Devil'].
}.

b ina-tae: ['pūtaha'] mahia: { <- Teka.
}.


Huaputa tuhi: a, rārangi-hou.  
Huaputa tuhi: (90 + a), rārangi-hou. 
Huaputa tuhi: b, rārangi-hou. 
Huaputa tuhi: (Pono a: b), rārangi-hou.

a := Rārangi ← ['hello'] ; ['world'] ; Pono ; Kore ; 666. 
a := a + ( Rārangi ← 1 ).
Huaputa tuhi: a, rārangi-hou.
Huaputa tuhi: ((Papakupu hou) tuku: Kore kei: Kore), rārangi-hou.
Huaputa tuhi: a sum, rārangi-hou. 


{
	a ina-tae: ['aho'] mahia: { <- Kore. }.
	a := [''] + a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.



{
	a ina-tae: ['tau'] mahia: { <- Kore. }.
	a := 3 × a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.


{
	a ina-tae: ['pūtaha'] mahia: { <- Kore. }.
	a := Pono a: a. 
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.





{
	a ina-tae: ['aho'] mahia: { <- Teka. }.
	a := [''] + a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.



{
	a ina-tae: ['tau'] mahia: { <- Pono. }.
	a := 3 × a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.


{
	a ina-tae: ['boolean'] mahia: { <- 1. }.
	a := Pono a: a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.





{
	a ina-tae: ['aho'] mahia: { <- 1. }.
	a := [''] + a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.



{
	a ina-tae: ['tau'] mahia: { <- ['']. }.
	a := 3 × a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.


{
	a ina-tae: ['boolean'] mahia: { <- ['']. }.
	a := Pono a: a.
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.






{
	a ina-tae: ['aho'] mahia: { <- (Papakupu hou). }.
	a := [''] + a. 
} hopu: { :error
	Huaputa tuhi: ['Error noted: '] + error, rārangi-hou.
}, tīmata.



