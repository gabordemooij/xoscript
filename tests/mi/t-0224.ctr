
>> countries := Rārangi hou
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Rārangi hou
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods e-ai-ki: countries, ia: { :key :value
	counter tāpiri: 1.
}.

Huaputa tuhi: (['we serve counter dishes'] counter: counter), rārangi-hou.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] pūāhua kōmaka: { :v
	counter tāpiri: 0.
}.

Huaputa tuhi: (['we sort counter dishes'] counter: counter), rārangi-hou.


>> counter := 0.
{
	{
		counter tāpiri: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Huaputa tuhi: (['we calculate counter numbers.'] counter: counter), rārangi-hou.

