

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

>> o := Ahanoa hou.
>> o2 := Ahanoa hou.
Huaputa tuhi: o Kore?, rārangi-hou.
Huaputa tuhi: o momo, rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o ), rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o2 ), rārangi-hou.
Huaputa tuhi: o ahau-iho, rārangi-hou.
Huaputa tuhi: ( o mahia kua-mahia ), rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


o := Ahanoa hou.
o2 := Ahanoa hou.
Huaputa tuhi: o Kore?, rārangi-hou.
Huaputa tuhi: o momo, rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o ), rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o2 ), rārangi-hou.
Huaputa tuhi: o ahau-iho, rārangi-hou.
Huaputa tuhi: ( o mahia kua-mahia ), rārangi-hou.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


o := Ahanoa hou.
o2 := Ahanoa hou.
Huaputa tuhi: o Kore?, rārangi-hou.
Huaputa tuhi: o momo, rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o ), rārangi-hou.
Huaputa tuhi: ( o ōrite-pū: o2 ), rārangi-hou.
Huaputa tuhi: o ahau-iho, rārangi-hou.
Huaputa tuhi: ( o mahia kua-mahia ), rārangi-hou.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
