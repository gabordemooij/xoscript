


>> Deck := Rārangi hou.
Deck ina-tae: ['print'] mahia: {
        >> len := whaiaro tatau - 1.
        { :i
                >> len2 := whaiaro tatau - 1.
                Huaputa tuhi: ['len: '].
                Huaputa tuhi: len, rārangi-hou.
                Huaputa tuhi: ['len2: '].
                Huaputa tuhi: len2, rārangi-hou.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
