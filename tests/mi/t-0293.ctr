
>> city := Rārangi ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Rārangi ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature e-ai-ki: city.
>> cities := weather kī-katoa kōmaka: { :a :b <- (a whakataurite: b). }.
>> temperatures := weather uara-katoa kōmaka: { :a :b <- (a whakataurite: b) tōraro?. }.

Huaputa tuhi: (cities honoa: [',']), rārangi-hou.
Huaputa tuhi: (temperatures honoa: [',']), rārangi-hou.
