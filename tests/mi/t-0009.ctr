>> Greeter := Ahanoa hou.
Greeter ina-tae: ['make'] mahia: {
	>> greeter := Ahanoa hou.
	greeter ina-tae: ['name:'] mahia: { :ingoa
		Huaputa tuhi: ['setting a name'].
		ake myName := ingoa.
	}.
	greeter ina-tae: ['performGreeting'] mahia: {
		Huaputa tuhi: ['Hello'].
		Huaputa tuhi: ake myName.
	}.
	greeter ina-tae: ['greet'] mahia: {
		whaiaro performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
