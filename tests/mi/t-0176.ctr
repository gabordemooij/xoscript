

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

>> txt := ['Word Salad'].
Huaputa tuhi: ['Text Length: '] + txt roa, rārangi-hou.
Huaputa tuhi: ['Character at 2:'] + ( txt pūāhua: 2 ), rārangi-hou.
Huaputa tuhi: (( txt rapua: ['S'] ) - 0), rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


txt := ['Word Salad'].
Huaputa tuhi: ['Text Length: '] + txt roa, rārangi-hou.
Huaputa tuhi: ['Character at 2:'] + ( txt pūāhua: 2 ), rārangi-hou.
Huaputa tuhi: (( txt rapua: ['S'] ) - 0), rārangi-hou.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


txt := ['Word Salad'].
Huaputa tuhi: ['Text Length: '] + txt roa, rārangi-hou.
Huaputa tuhi: ['Character at 2:'] + ( txt pūāhua: 2 ), rārangi-hou.
Huaputa tuhi: (( txt rapua: ['S'] ) - 0), rārangi-hou.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
