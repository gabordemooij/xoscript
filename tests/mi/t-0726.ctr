# test buffers PKI/Sign 
Server init.

>> long := ( Rārangi hou whakakī: 1000 me: ['a'] ) honoa: [''].

# sign a message
Huaputa tuhi: ( 
	Pākoro haina: ['abc'] me: long
), rārangi-hou.

Huaputa tuhi: ( 
	Pākoro
		tirohia: ['abc'] 
		waitohu: long 
		me: long
), rārangi-hou.

Huaputa tuhi: (
	Pākoro tāmi-kupuhipa: long whakaū: long
), rārangi-hou.
