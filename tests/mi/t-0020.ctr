(Kore = Kore) pono: { Huaputa tuhi: ['Nil is Nil!'].}.
(2 > 1) pono: { Huaputa tuhi: ['YES']. }.
(2 > 3) pono: { Huaputa tuhi: ['NO']. }.
(2 > 3) teka: { Huaputa tuhi: ['Nonono..'].}.
Pono pono: { Huaputa tuhi: ['TRUE is TRUE!']. }.
(Pono) pono: { Huaputa tuhi: ['TRUE is TRUE!']. }.
Teka teka: { Huaputa tuhi: ['FALSE is FALSE!']. }.
(Teka) teka: { Huaputa tuhi: ['FALSE is FALSE!']. }.
