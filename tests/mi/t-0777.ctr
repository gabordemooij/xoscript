#OBSD
>> dirname := [''].
{ dirname tāpiri-muri: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Papatono pūnaha: command.
Papatono chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tāpiri-muri: ['YYYYYYYY']. } * 20.
Kōnae hou: filename, tuhi: ['sometext'].
{ Kōnae rārangi: ['/tmp/'] + dirname. } * 1000.
Huaputa tuhi: ['no crash'], rārangi-hou.

