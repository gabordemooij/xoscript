>> HTML := Ahanoa hou.
HTML ina-tae: ['whakautu:'] mahia: { :tag 
	Huaputa tuhi: (['<tag>'] tag: tag), rārangi-hou.
}.
HTML ina-tae: ['whakautu:a:'] mahia: { :tag :html 
	Huaputa tuhi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), rārangi-hou.
}.
>> html := HTML hou.
html body h1: ['header'].

