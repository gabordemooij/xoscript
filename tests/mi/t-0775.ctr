Huaputa tuhi: ['Test object'], rārangi-hou.
>> l := Rārangi hou ; 1 ; ( Rārangi hou ; (Wā hou: 1) ; (Int64 mai-i-te-aho: ['321']) ; (Rārangi hou ; 3)).
Huaputa tuhi: l, rārangi-hou.
>> old-lst-address := l tauira-taketake wāhitau-pūmahara.
l save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
(b tauira-taketake wāhitau-pūmahara = old-lst-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
Huaputa tuhi: b, rārangi-hou.
