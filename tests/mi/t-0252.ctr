#Linux
>> clock := Wā hou.
clock rohe: ['UTC-1'].
clock tau-maramataka: 1981, marama: 1, rā: 5,
      haora: 13, meneti: 15, hēkona: 13.

Huaputa tuhi: clock, rārangi-hou.
clock rohe: ['UTC+0'].

Huaputa tuhi: (
	(clock tau-maramataka māmā) + ['-'] + (clock marama) + ['-'] + (clock rā) + [' '] +
	(clock haora) + [':'] + (clock meneti) + [':'] + (clock hēkona) + [' '] +
	['W'] + (clock wiki) + (clock rohe)
), rārangi-hou.


clock rohe: ['UTC-1'].
Huaputa tuhi: (
	(clock tau-maramataka māmā) + ['-'] + (clock marama) + ['-'] + (clock rā) + [' '] +
	(clock haora) + [':'] + (clock meneti) + [':'] + (clock hēkona) + [' '] +
	['W'] + (clock wiki) + (clock rohe)
), rārangi-hou.
