Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :dict
	ake dict := dict. 
}.

a ina-tae: ['item'] mahia: { <- ake dict.
}.

a item: (
Papakupu hou
	hello: ['world'],
	world: (Papakupu hou tuku: ['a'] kei: ['b'])).

Huaputa tuhi: a item, rārangi-hou.

>> old-dict-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-dict-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

Huaputa tuhi: b item, rārangi-hou.
