Papatono whakapai.
>> usedMemory5 := (Papatono pūmahara ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) pono: {
	Huaputa tuhi: ['Memory usage remains stable.'], rārangi-hou.
}, ki-te-kore: {
	Huaputa tuhi: ['Used memory not stable.'], rārangi-hou.
	Huaputa tuhi: usedMemory1, rārangi-hou.
	Huaputa tuhi: usedMemory2, rārangi-hou.
	Huaputa tuhi: usedMemory3, rārangi-hou.
	Huaputa tuhi: usedMemory4, rārangi-hou.
	Huaputa tuhi: usedMemory5, rārangi-hou.
}.
