


Papatono whakahaere-pūmahara: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Pono.
>> a := Rārangi ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 5.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 4.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).




x := 3.
y := ['Hello'].
q := { ['Empty']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 5.


Papatono whakapai.
usedMemory4 := (Papatono pūmahara ? 0).





x := 4.
y := ['Hello'].
q := { ['Empty']. }.
p := Pono.
