>> items := Papakupu hou.
items tuku: ['green'] kei: ['color-1'].
items tuku: ['orange'] kei: ['color-2'].
items tuku: ['red'] kei: ['color-3'].
>> i := 0.
>> s := [''].
items ia: { :key :color
	Huaputa tuhi: ['color #'] + i + [' is: '] + color + [' '].
	i tāpiri: 1.
}.
Huaputa tuhi: i + [' colors!'].
