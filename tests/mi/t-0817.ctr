# a value ending in the first part of an opening quote must survive serialization
>> uara-katoa := Rārangi hou
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

uara-katoa ia: { :i :value
	>> d := Papakupu hou.
	d tuku: value kei: ['k'].
	d tuku: ['second'] kei: ['j'].
	>> r := d waehere ahanoa.
	Huaputa tuhi: r tatau, rārangi-hou.
	Huaputa tuhi: ( (r kei: ['k']) = value ), rārangi-hou.
}.
