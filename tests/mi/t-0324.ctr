>> Animal := Ahanoa hou.
>> Factory := Ahanoa hou.

Animal ina-tae: ['hou'] mahia: {
	>> animal := whaiaro hou.
	animal sound: ['?']. <- animal.
}.

Animal ina-tae: ['sound:'] mahia: { :s
	ake sound := s.
}.

Animal ina-tae: ['sound'] mahia: { <- ake sound.
}.

>> Dog := Ahanoa hou.
>> Cat := Ahanoa hou.

Dog ina-tae: ['hou'] mahia: { <- Animal hou sound: ['woof!'].
}.

Cat ina-tae: ['hou'] mahia: { <- Animal hou sound: ['meow!'].
}.

Huaputa tuhi: Dog hou sound, rārangi-hou.
Huaputa tuhi: Cat hou sound, rārangi-hou.

Factory ina-tae: ['mix:and:'] mahia: { :beast1 :beast2 <- Animal hou sound: (
		( beast1 sound mai: 0 roa: 2 ) +
		( beast2 sound mai: 2 roa: 5 )
	).
}.

Huaputa tuhi: (Factory mix: Dog hou and: Cat hou) sound, rārangi-hou.
