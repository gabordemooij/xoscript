# database test
# see example server.xo for required config

Server init.
Huaputa tuhi: ['Database test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], kupuhipa: ['pass123'], ingoa-pātengi-raraunga: ['xobase'], tūhono.

Huaputa tuhi: ['Can we connect? '] + db kua-tūhono?, rārangi-hou.

>> tawhā-rapu := db uiui: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], tawhā: ( Rārangi hou ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  tawhā-rapu whakatutuki. db whakaū. } hopu: { :e db hoki-whakamuri.  }, tīmata.

Huaputa tuhi: ['Can we insert? '] + ( tawhā-rapu insert-id > 0 ), rārangi-hou.

>> Obj := Ahanoa hou.
Obj ina-tae: ['retrieve-rows'] mahia: {
	ake tatau := 0.
	>> tawhā-rapu :=
	db uiui: ['SELECT * FROM book order by id desc limit 2'], 
	tikina: { :row 
		ake tatau tāpiri: 1.
		Pono whati.
	}. <- ake tatau tārua.
}.

Huaputa tuhi: ['Can we query? '] + ( Obj retrieve-rows > 0 ), rārangi-hou.
