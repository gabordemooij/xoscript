

Rārangi ina-tae: ['fixture:'] mahia: { :f
	ake fixture := f.
}.

Rārangi ina-tae: ['tatau'] mahia: { <- ake fixture.
}.

Rārangi ina-tae: ['aantal'] mahia: { <- ake fixture.
}.


>> x := Kore.
{

	x := ['hello'] 
	whakakapihia:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] pūāhua: 2)
			)
		)
	me: (
		(['...hal'] + ['lo']) 
			pūmatua 
			lowecase 
			pūmatua 
			pekepeke: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Rārangi ← 0 ; 1 ; 4; 9 ; (Rārangi ← 0 ; 3; 1) ; 4
							) mua-i-te-whakamutunga
						) ? 1
					) + 
					((Rārangi ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					tatau
				)
			)
	).

} × 10.
Huaputa tuhi: x, rārangi-hou.

