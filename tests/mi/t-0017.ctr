Tau ina-tae: ['factorial'] mahia: {
	>> total := 1.
	{ :index total whakarau-ki: (whaiaro - (index)). } × whaiaro. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Huaputa tuhi: a.
>> b := 2 + 3 factorial.
Huaputa tuhi: b.
>> c := 3 factorial + 2.
Huaputa tuhi: c.
>> d := 2 + (3 factorial).
Huaputa tuhi: d.
Huaputa tuhi: 2 + 3 factorial + 1.
