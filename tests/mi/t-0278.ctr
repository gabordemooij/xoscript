>> To-Do := Ahanoa hou.

To-Do ina-tae: ['hou'] mahia: {
	ake list := Rārangi hou.
}.

To-Do ina-tae: ['nieuw'] mahia: {
	ake list := Rārangi hou.
}.

To-Do ina-tae: ['+'] mahia: { :task
	ake list tāpiri-muri: task.
}.

To-Do ina-tae: ['number of tasks?'] mahia: { <-  ake list tatau.
}.

>> todos := 
	To-Do hou 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Huaputa tuhi: ['You have $ tasks to do'] $ todos number of tasks?.
