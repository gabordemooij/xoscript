Server init.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> del := db uiui: ['DELETE FROM book WHERE id > 0'].
{  del whakatutuki. db whakaū. } hopu: { :e db hoki-whakamuri.  }, tīmata.

>> tatau := db uiui: ['SELECT COUNT(*) AS num FROM book'].
tatau tikina: { :row Huaputa tuhi: row num, rārangi-hou. }.
