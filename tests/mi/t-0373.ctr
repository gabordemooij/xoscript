# compliance test

# use international numbers

Huaputa tuhi: ['1000 -> '].
Huaputa tuhi: 1000, rārangi-hou. #1000

Huaputa tuhi: ['1.5 -> '].
Huaputa tuhi: 1.5, rārangi-hou.  #1.5

Huaputa tuhi: ['1001.5 -> '].
Huaputa tuhi: 1.5 + 1000, rārangi-hou. #1001.5

# use 0-indexed arrays
>> x := Rārangi hou ; 1 ; 2 ; 3.
>> y := Rārangi hou ; ['a'] ; ['b'] ; ['c'].

Huaputa tuhi: ['1 -> '].
Huaputa tuhi: x ? 0, rārangi-hou. #1

Huaputa tuhi: ['1 -> '].
Huaputa tuhi: (x kei: 0), rārangi-hou. #1

Huaputa tuhi: ['1 -> '].
Huaputa tuhi: x tuatahi, rārangi-hou. #1

Huaputa tuhi: ['3 -> '].
Huaputa tuhi: x whakamutunga, rārangi-hou. #3

Huaputa tuhi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Huaputa tuhi: (x e-ai-ki: y), rārangi-hou.

Huaputa tuhi: ['1 -> '].
Huaputa tuhi: (x mai: 0 roa: 1) tuatahi, rārangi-hou. #1

Huaputa tuhi: ['0 -> '].
Huaputa tuhi: (x rapua: 1), rārangi-hou. #0

x tuku: 9 kei: 0.

Huaputa tuhi: ['9 -> '].
Huaputa tuhi: (x kei: 0), rārangi-hou. #9

x tāpiri-mua: 8.
Huaputa tuhi: ['8 -> '].
Huaputa tuhi: (x kei: 0), rārangi-hou. #9


x tāpiri-muri: 10.
Huaputa tuhi: ['10 -> '].
Huaputa tuhi: (x kei: 4), rārangi-hou. #10








