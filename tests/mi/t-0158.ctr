>> x := [' hallo '].

>> y := x pūmatua.
Huaputa tuhi: x, rārangi-hou.
Huaputa tuhi: (x ōrite-pū: y), rārangi-hou.

>> y := x pūriki.
Huaputa tuhi: x, rārangi-hou.
Huaputa tuhi: (x ōrite-pū: y), rārangi-hou.

>> y := x tapahi-mokowā.
Huaputa tuhi: x, rārangi-hou.
Huaputa tuhi: (x ōrite-pū: y), rārangi-hou.

>> y := x pekepeke: 1.
Huaputa tuhi: x, rārangi-hou.
Huaputa tuhi: (x ōrite-pū: y), rārangi-hou.

>> y := x mai: 1 roa: 2.
Huaputa tuhi: x, rārangi-hou.
Huaputa tuhi: (x ōrite-pū: y), rārangi-hou.