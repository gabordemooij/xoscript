# test number -> string -> number
{

	>> x := Tau waenga: 0 me: 1000000.
	>> d := Tau waenga: 1 me: 7.
	>> e := 10 pū: d.

	x wehe-ki: e.
	>> y := x aho tau.

	(x = y) teka: {
		Huaputa tuhi: x, rārangi-hou.
		Huaputa tuhi: y, rārangi-hou.
		Papatono mutu.
	}.

} * 1000.
Huaputa tuhi: ['OK'], rārangi-hou.