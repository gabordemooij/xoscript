
Server init.
>> rq := Tono-HTTP hou.
Huaputa tuhi: ['HTTP-GET d[]=']  + ( rq get-rārangi: ['d[]'] ), rārangi-hou. # GET
Huaputa tuhi: ['HTTP-GET f[]=']  + ( rq get-rārangi: ['f[]'] ), rārangi-hou. # GET
Huaputa tuhi: ['HTTP-POST e[]='] + ( rq post-rārangi: ['e[]'] ), rārangi-hou. # GET
Huaputa tuhi: ['HTTP-POST c=']   + ( rq post: ['c'] ), rārangi-hou. # GET
Huaputa tuhi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), rārangi-hou. # GET
