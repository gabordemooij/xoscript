Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :pūtaha
	ake pūtaha := pūtaha. 
}.

a ina-tae: ['item'] mahia: { <- ake pūtaha.
}.

a item: Pono.

Huaputa tuhi: a item, rārangi-hou.

>> old-bool-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-bool-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

Huaputa tuhi: b item, rārangi-hou.
