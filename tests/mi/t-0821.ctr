# a quote that never closes must give an error, not an endless loop
>> ara-kōnae := ['/tmp/test0821.csv'].
>> file := Kōnae hou: ara-kōnae.

file tuhi: ['a,b\n"1,2\n'].
{
	file kaiwehe: [','] tohukī: ['"'] rārangi-kupu: { :line
		Huaputa tuhi: line, rārangi-hou.
	}.
} hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.

# a closed quote still works
file tuhi: ['a,b\n"1,2",3'].
file kaiwehe: [','] tohukī: ['"'] rārangi-kupu: { :line
	Huaputa tuhi: line, rārangi-hou.
}.
file muku.
