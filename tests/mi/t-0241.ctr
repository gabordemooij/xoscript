

Aho ina-tae: ['evaluate'] mahia: {
	>> waehere := Kōnae hou: ['/tmp/eval.ctr'].
	waehere tuhi: (whaiaro aho + ['.']).
	Papatono whakamahi: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Rārangi ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q aho.
Huaputa tuhi: x, rārangi-hou.
>> y := Kore.
(['y := '] + x ) evaluate.
Huaputa tuhi: y ? 0, rārangi-hou.

q := Papakupu tuku: ['\[''] kei: ['\['quote\']'].
x := q aho.
Huaputa tuhi: x, rārangi-hou.
y := Kore.
(['y := '] + x ) evaluate.

>> q := (Papakupu hou) tuku:['\[''] kei:['\['quote\[''].
Huaputa tuhi: y ? ['\['quote\']'], rārangi-hou.
