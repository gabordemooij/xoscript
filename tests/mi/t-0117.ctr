>> t := Pono.
(t = Pono) pono: { Huaputa tuhi: ['T']. }.
(t = Teka) pono: { Huaputa tuhi: ['F']. }.
Huaputa tuhi: ['|'].
>> t := Teka.
(t = Pono) pono: { Huaputa tuhi: ['T']. }.
(t = Teka) pono: { Huaputa tuhi: ['F']. }.
Huaputa tuhi: ['|'].
>> f := Pono.
(t = Pono a: f = Teka) pono: { Huaputa tuhi: ['T']. }.
(t = Teka a: f = Pono) pono: { Huaputa tuhi: ['F']. }.
Huaputa tuhi: ['|'].
>> n := Kore.
(n Kore?) pono: { Huaputa tuhi: ['T']. }.
(n Kore?) teka: { Huaputa tuhi: ['F']. }.
Huaputa tuhi: ['|'].
(f Boolean?) pono: { Huaputa tuhi: ['T']. }.
(f Boolean?) teka: { Huaputa tuhi: ['F']. }.



