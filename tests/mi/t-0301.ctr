


>> wine := Ahanoa hou.


wine ina-tae: ['toString'] mahia: { <- ['merlot'].
}.

wine ina-tae: ['naarTekst'] mahia: { <- ['merlot'].
}.


wine ina-tae: ['='] mahia: { :other wine <- ( whaiaro toString = other wine ).
}.

wine ina-tae: ['=='] mahia: { :other wine <- ( whaiaro toString = other wine ).
}.



wine
	mēnā: ['cabernet'] mahia: { Huaputa tuhi: ['it's a Cabernet!']. },
	mēnā: ['syrah']    mahia: { Huaputa tuhi: ['it's a Syrah!'].    },
	mēnā: ['merlot']   mahia: { Huaputa tuhi: ['it's a Merlot!'].   },
	mēnā: ['malbec']   mahia: { Huaputa tuhi: ['it's a Malbec!'].   }.

Huaputa rārangi-hou.
