Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 
a ina-tae: ['item:'] mahia: { :int64
	ake int64 := int64. 
}.
a ina-tae: ['item'] mahia: { <- ake int64.
}.
a item: ( Int64 mai-i-te-aho: ['9999'] ).
Huaputa tuhi: a item, rārangi-hou.
>> old-int64-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.
>> b := Ahanoa load-from: ['/tmp/a.bin'].
(b item tauira-taketake wāhitau-pūmahara = old-int64-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
Huaputa tuhi: ( b item ), rārangi-hou.
