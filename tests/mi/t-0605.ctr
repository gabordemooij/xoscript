>> invoice := Ahanoa hou.
invoice ina-tae: ['tīmata'] mahia: {
        ake tau := 0.
}.

invoice ina-tae: ['tau'] mahia: {
        ake tau tāpiri: 1. <- ake tau tārua.
}.

>> year-invoice := invoice hou.
year-invoice ina-tae: ['start:'] mahia: { :tau-maramataka
	ake tau := tau-maramataka.
}.

year-invoice start: 202000.
Huaputa tuhi: year-invoice tau, rārangi-hou.
Huaputa tuhi: year-invoice tau, rārangi-hou.
