Huaputa tuhi: ['Continue for-loop, No - before 6 and up.'], rārangi-hou.
{ :i
	Huaputa tuhi: (i + 1), rārangi-hou.
	((i + 1) > 4) haere-tonu.
	Huaputa tuhi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Huaputa rārangi-hou.
Huaputa tuhi: ['Continue while-true, No --> before 5 and up.'], rārangi-hou.
{
	Huaputa tuhi: ['iteration #'] + x, rārangi-hou.
	x tāpiri: 1.
	((x < 5) kāore) haere-tonu.
	Huaputa tuhi: ['-->'].
} i-te-wa: xIsLessThan10.
Huaputa rārangi-hou.
Huaputa tuhi: ['Continue while-false, No - before 3 only.'], rārangi-hou.
{
	Huaputa tuhi: ['iteration #'] + x, rārangi-hou.
	x tango: 1.
	(x = 3) haere-tonu.
	Huaputa tuhi: ['-'].
} i-te-wa: { <- ( x > 0). }.

Huaputa rārangi-hou.
Huaputa tuhi: ['Continue times-loop, No ||| before 3.'], rārangi-hou.
{ :i
	Huaputa tuhi: ['iteration #'] + i, rārangi-hou.
	(i = 2) haere-tonu.
	Huaputa tuhi: ['|||'].
} × 5.

Huaputa rārangi-hou.

{ Pono haere-tonu. Huaputa tuhi: ['dont write this!'], rārangi-hou. } tīmata.

{ Pono haere-tonu. Huaputa tuhi: ['dont write this!'], rārangi-hou. } hopu: { Huaputa tuhi: ['Dont catch this!']. }, tīmata.

Huaputa tuhi: ['Test Array each-loop: 0, ... ,2'], rārangi-hou.
(Rārangi ← 1 ; 2 ; 3) huri-ia: { :i
	(i = 1) haere-tonu.
	Huaputa tuhi: ['iteration #'] + (i - 0), rārangi-hou.
}.

Huaputa tuhi: ['Test Map each-loop: c only'], rārangi-hou.
>> m := Papakupu hou.
m tuku: ['first'] kei: ['a'], tuku: ['second'] kei: ['b'], tuku: ['third'] kei: ['c'].
m ia: { :k :v
	(k ≠ ['c']) haere-tonu.
	Huaputa tuhi: ['iteration'] + k + v, rārangi-hou.
}.

