


>> CoffeeMachine := Ahanoa hou.
CoffeeMachine ina-tae: ['order:'] mahia: { :id
	>> coffee := ['Americano'].
	( id = 1 ) pono: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) pono: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) pono: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ahanoa hou.
SimpleCoffeeMachine ina-tae: ['order'] mahia: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Huaputa tuhi: redCup, rārangi-hou.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Huaputa tuhi: greenCup, rārangi-hou.
>> yellowCup := CoffeeMachine order: 1.
Huaputa tuhi: yellowCup, rārangi-hou.
>> blueCup := CoffeeMachine order: 0.
Huaputa tuhi: blueCup, rārangi-hou.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Huaputa tuhi: blackCup, rārangi-hou.
blackCup tāpiri-muri: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Huaputa tuhi: orangeCup, rārangi-hou.
