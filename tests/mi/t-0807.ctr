# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu := db uiui: ['SELECT %% FROM'].
{ tawhā-rapu whakatutuki. } hopu: { :e
	Huaputa tuhi: ( e kei-roto: ['%%'] ), rārangi-hou.
}, tīmata.
