# test qualifiers

>> $ := Ahanoa hou.

$ ina-tae: ['whakautu:'] mahia: { :x
	
	>> operation := x pūāhua: 0.
	>> valuta := x pūāhua: 1.
	>> money := x pekepeke: 2.
	
	>> amount := 0.

	( operation = ['+'] ) pono: {
		( valuta = ['£'] ) pono: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Huaputa tuhi: x, rārangi-hou.


>> Fruit := Ahanoa hou.

Fruit ina-tae: ['hou'] mahia: {
	>> f := whaiaro hou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ina-tae: ['apples:'] mahia: { :a ake apples := a. }.
Fruit ina-tae: ['oranges:'] mahia: { :p ake oranges := p. }.
Fruit ina-tae: ['apples'] mahia: { <- ake apples. }.
Fruit ina-tae: ['oranges'] mahia: { <- ake oranges. }.

Fruit ina-tae: ['+'] mahia: { :f
	
	>> n := Fruit hou.
	f tāpiri: 1.
	
	n apples: (f apples + ake apples).
	n oranges:  (f oranges  + ake oranges). <- n.
}.

Fruit ina-tae: ['aho'] mahia: { <- ( ake apples aho + [' apples and '] + ake oranges + [' oranges'] ).
}.

Tau ina-tae: ['apples'] mahia: { <- ((Fruit hou) apples: whaiaro).
}.

Tau ina-tae: ['apple'] mahia: { <- ((Fruit hou) apples: whaiaro).
}.

Tau ina-tae: ['oranges'] mahia: { <- ((Fruit hou) oranges: whaiaro).
}.




Huaputa tuhi: (1 apple + 3 oranges + 4 apples), rārangi-hou.


Aho ina-tae: ['twice'] mahia: { <- ((whaiaro aho) + (whaiaro aho)).
}.



Huaputa tuhi: ['❤❤❤'] twice.



