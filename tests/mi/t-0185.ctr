usedMemory1 := (Papatono pūmahara ? 0).


a := -2 uara-pū.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


