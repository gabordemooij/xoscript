

>> Cat := Ahanoa hou.

Cat ina-tae: ['hou'] mahia: {
	ake sound := ['meow!'].
}.

Cat ina-tae: ['nieuw'] mahia: {
	ake sound := ['meow!'].
}.

Cat ina-tae: ['makeSound'] mahia: { <- ake sound.
}.

Cat ina-tae: ['greet'] mahia: { <- whaiaro makeSound.
}.

>> cat := Cat hou.
Huaputa tuhi: cat greet.
