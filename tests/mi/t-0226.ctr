# Test ASCII variants

# Numbers

Huaputa tuhi: (2 !=: 3), rārangi-hou.
Huaputa tuhi: (2 <=: 2), rārangi-hou.
Huaputa tuhi: (2 >=: 2), rārangi-hou.

# Strings

Huaputa tuhi: (['b'] >=: ['a']), rārangi-hou.
Huaputa tuhi: (['b'] !=: ['a']), rārangi-hou.
Huaputa tuhi: (['b'] <=: ['c']), rārangi-hou.

# Bools

Huaputa tuhi: (Pono !=: Teka), rārangi-hou.

# Objects

Huaputa tuhi: (Ahanoa hou !=: Ahanoa hou), rārangi-hou.

# ASCII list symbol <-:

Huaputa tuhi: (Rārangi <<: 1, ; 2 ; 3) tatau = 3, rārangi-hou.

