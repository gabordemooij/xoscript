
>> Rectangle := Ahanoa hou.

Rectangle ina-tae: ['area'] mahia: { <- ake roa * ake width.
}.

Rectangle ina-tae: ['length:'] mahia: { :roa
	ake roa := roa.
}.

Rectangle ina-tae: ['width:'] mahia: { :width
	ake width := width.
}.

Rectangle ina-tae: ['hou'] mahia: {
	# this will not result into an infinite loop
	>> rectangle := whaiaro hou.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle hou.
Huaputa tuhi: a area, rārangi-hou. #0

>> b := Rectangle hou length: 2, width: 3.
Huaputa tuhi: b area, rārangi-hou. #6

