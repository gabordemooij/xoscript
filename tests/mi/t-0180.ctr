Aho ina-tae: ['html'] mahia: { <- (
		whaiaro
		whakakapihia: ['&'] me: ['&amp;'],
		whakakapihia: ['<'] me: ['&lt;'],
		whakakapihia: ['>'] me: ['&gt;'],
		whakakapihia: ['''] me: ['&apos;'],
		whakakapihia: ['"'] me: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huaputa tuhi: txt tārua html, rārangi-hou.
Huaputa tuhi: txt tārua pūriki, rārangi-hou.
Huaputa tuhi: txt tārua pūmatua, rārangi-hou.
} tīmata.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huaputa tuhi: txt tārua html, rārangi-hou.
Huaputa tuhi: txt tārua pūriki, rārangi-hou.
Huaputa tuhi: txt tārua pūmatua, rārangi-hou.
} tīmata.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huaputa tuhi: txt tārua html, rārangi-hou.
Huaputa tuhi: txt tārua pūriki, rārangi-hou.
Huaputa tuhi: txt tārua pūmatua, rārangi-hou.
} tīmata.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
