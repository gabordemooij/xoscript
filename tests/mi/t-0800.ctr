Server init.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu := db uiui: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], tawhā: ( Rārangi hou ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  tawhā-rapu whakatutuki. db whakaū. } hopu: { :e db hoki-whakamuri.  }, tīmata.

Huaputa tuhi: ['Can we insert? '] + ( tawhā-rapu insert-id > 0 ), rārangi-hou.
