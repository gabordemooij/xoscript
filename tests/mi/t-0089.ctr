>> randomizer := { :a :b
	>> iti-rawa := ( a < b ) tēnei: a tērā-rānei: b.
	>> mōrahi := ( a > b ) tēnei: a tērā-rānei: b.
	>> x := Kore.
	{
		x := Tau waenga: a me: b.
		((x < iti-rawa) ranei: (x > mōrahi)) pono: { 
			Huaputa tuhi: (['Invalid value!']).
			Papatono mutu.
		}.
	} 
	× 100. <- x.
}.
randomizer whakahaere: 0 a: 0.
randomizer whakahaere: 1 a: 0.
randomizer whakahaere: 1 a: 1.
randomizer whakahaere: 0 a: 1.
randomizer whakahaere: -1 a: 0.
randomizer whakahaere: -1 a: -1.
randomizer whakahaere: 0 a: -1.
randomizer whakahaere: 100 a: 200.
randomizer whakahaere: 999999999999998 a: 999999999999999.
randomizer whakahaere: 999999999999999 a: 999999999999998.
randomizer whakahaere: 999999999999999 a: 999999999999999.
randomizer whakahaere: -999999999999998 a: -999999999999999.
randomizer whakahaere: -999999999999999 a: -999999999999998.
randomizer whakahaere: -999999999999999 a: -999999999999999.
randomizer whakahaere: 999999999999998 a: -999999999999999.
randomizer whakahaere: 999999999999999 a: -999999999999998.
randomizer whakahaere: 999999999999999 a: -999999999999999.
randomizer whakahaere: -999999999999998 a: 999999999999999.
randomizer whakahaere: -999999999999999 a: 999999999999998.
randomizer whakahaere: -999999999999999 a: 999999999999999.
Huaputa tuhi: ['OK'].


