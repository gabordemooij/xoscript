
Aho ina-tae: ['evaluate'] mahia: {
	>> waehere := Kōnae hou: ['/tmp/eval.ctr'].
	waehere tuhi: (whaiaro aho + ['.']).
	Papatono whakamahi: ['/tmp/eval.ctr'].
}.

>> map :=
	(Papakupu hou)
	tuku: ['Hi There'] kei: ['two'],
	tuku: (Rārangi ← ['hello'] ; ['world'] ; (Rārangi ← 1 ; 2; 9) ; Teka) kei: ['one'],
	tuku: ( (Papakupu hou) tuku: ['wrrld'] kei: ['misspelled'] ) kei: ['three'],
	tuku: (Rārangi ← ((Papakupu hou) tuku: ['treasure'] kei: ['hidden']) ; 2) kei: ['four']. 
>> str := map aho.
>> map2 := Kore.
(['map2 := '] + str ) evaluate.
Huaputa tuhi: map2 ? ['one'] ? 0.
Huaputa tuhi: map2 ? ['one'] ? 1.
Huaputa tuhi: map2 ? ['four'] ? 0 ? ['hidden'].
Huaputa tuhi: map2 ? ['one'] ? 2 ? 2.
