
>> Size := Ahanoa hou.
Size ina-tae: ['is:'] mahia: { :tau
	tau ina-tae: ['+'] mahia: { :tau
		>> unit := tau waeine-tau.
		>> factor := 1.
		
		unit
		mēnā: ['inch'] mahia: { factor := 0.0833. }. <- whaiaro + (tau * factor).
	}. <- tau.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Huaputa tuhi: plank + edge, rārangi-hou.
