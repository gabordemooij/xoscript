Server init.
>> fmt := Hōputu hou: ['%#3x'].

>> blob := Blob hou: 4.
blob bytes: ( 
	Rārangi hou ; 0 ; 1 ; 2 ; 3
).

>> file := Kōnae hou: ['/tmp/blob'].
file blob: blob.
blob wewete.

>> pānui := file blob.
pānui 
mai: 0 
roa: 4, 
mahia ia: { :i :b 
	Huaputa
	tuhi: (fmt whakahaere-tau-tōpū: b),
	rārangi-hou.
}.
pānui wewete.
