# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Ahanoa hou.

Log ina-tae: ['say:'] mahia: { :str
	Huaputa tuhi: str, rārangi-hou.
}.

>> Item := Ahanoa hou.

Item ina-tae: ['hou:'] mahia: { :id <- whaiaro hou id: id.
}.

Item ina-tae: ['id:'] mahia: { :id
	ake id := id.
}.

Item ina-tae: ['id'] mahia: { <- ake id. }.


Item ina-tae: ['aho'] mahia: {
	>> str := ['Item#~no'].
	str ~no: ake id. <- str.
}.


>> Print := Ahanoa hou.

Print ina-tae: ['items'] mahia: { 
	
	ake item := Item hou: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: ake item
	).
	
	
}.

Print items.