
>> XX := Ahanoa hou.
>> X := Ahanoa hou.

XX ina-tae: ['QQ'] mahia: { <- 1. }.
XX ina-tae: ['Q'] mahia: { <- 1. }.
XX ina-tae: ['QQ:'] mahia: { <- 1. }.
XX ina-tae: ['QQ:QQ:'] mahia: { <- 1. }.

