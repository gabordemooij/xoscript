# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Pākoro hanga-kī.

# private (secret) key
>> sk := keys tuatahi.

# public key
>> pk := keys whakamutunga.

# sign a message
>> sig := Pākoro haina: ['abc'] me: sk.

# check message (ok)
Huaputa tuhi: ( 
	Pākoro
		tirohia: ['abc'] 
		waitohu: sig 
		me: pk 
), rārangi-hou.

# check message (fail)
Huaputa tuhi: ( 
	Pākoro 
		tirohia: ['abd'] 
		waitohu: sig 
		me: pk 
), rārangi-hou.