>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ahanoa hou.
⚄ ina-tae: ['drawFrom:length:'] mahia: { :pool :tatau
	
	>> result := [''].
	
	{
		>> index := Tau random % (pool roa).
		result tāpiri-muri: ( pool pūāhua: (index + 1) ).
		
	} × tatau. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? roa.
Huaputa tuhi: (['x↵'] x random roa).
Huaputa tuhi: (['y↵'] y ?? roa).

