
>> Animal := Ahanoa hou.
Animal ina-tae: ['hou'] mahia: { <- whaiaro hou init.
}.

Animal ina-tae: ['init'] mahia: {
	ake sound := ['?'].
	ake legs := 4.
}.

>> Dog := Animal hou.
Dog ina-tae: ['init'] mahia: {
	whaiaro init.
	ake sound := ['barks'].
}.

Animal ina-tae: ['aho'] mahia: { <- ake legs aho + ake sound.
}.

>> poodle := Dog hou.
Huaputa tuhi: poodle, rārangi-hou.

