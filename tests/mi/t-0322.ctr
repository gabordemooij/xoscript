

>> Matryoshka := Ahanoa hou.
Matryoshka ina-tae: ['double:'] mahia: { :secret
	ake secret := secret × 2.
}.
Matryoshka ina-tae: ['hou:'] mahia: { :secret
	>> answer := Kore.
	>> t := (secret > 255).
	Huaputa tuhi: (secret + [' | '] + t), rārangi-hou.
	t pono: {
		answer := secret.
	}, ki-te-kore: {
		answer := Matryoshka karanga-whaiaro hou: (whaiaro double: secret).
	}. <- answer.
}.

>> x := Matryoshka hou: 2.
