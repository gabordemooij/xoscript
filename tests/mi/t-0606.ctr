>> Point := Ahanoa hou.
Point ina-tae: ['x-coordinate:'] mahia: { :x ake x := x. }.
Point ina-tae: ['y-coordinate:'] mahia: { :y ake y := y. }.
Point ina-tae: ['x-coordinate']  mahia: { <- ake x tārua. }.
Point ina-tae: ['y-coordinate']  mahia: { <- ake y tārua. }.

Point ina-tae: ['='] mahia: { :other <- ( ake x = other x-coordinate
		 a: ake y = other y-coordinate ).
}.

>> pier := Point hou x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point hou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point hou x-coordinate: 5, y-coordinate: 6.

Huaputa tuhi: pier = town-hall, rārangi-hou.
Huaputa tuhi: pier = restaurant, rārangi-hou.
