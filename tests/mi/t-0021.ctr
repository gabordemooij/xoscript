(2 < 9) pono: { Huaputa tuhi: ['Yes, nine is less than ten.']. }.
(9 < 2) pono: { Huaputa tuhi: ['My logic fails']. }.
Huaputa tuhi: (-2 + 6).
Huaputa tuhi: (-3 - -3).
>> TrueIsNice := 3.
Huaputa tuhi: TrueIsNice.
>> FalseIsBad := ['Not true!'].
Huaputa tuhi: FalseIsBad.
>> NilIsEmpty := ['Yep'].
Huaputa tuhi: NilIsEmpty.
