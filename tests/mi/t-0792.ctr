Server init.

>> DB := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB uiui: SQL.

# now you don't have to set DB
query2 tikina: { :row
	Huaputa tuhi: row world, rārangi-hou.
}.
