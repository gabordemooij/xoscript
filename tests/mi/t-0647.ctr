Server init.
Huaputa tuhi: ['Database time test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], 
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu :=
db uiui: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
tikina: { :row
	Huaputa tuhi: row timetest, rārangi-hou.
}.
