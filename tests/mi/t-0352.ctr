Tau ina-tae: ['roman'] mahia: {
	>> tau := whaiaro tārua.
	>> roman := [''].
	{
		{
			(tau ≥ 1000) pono: {
				roman tāpiri-muri: ['Ⅿ'].
				tau tango: 1000.
			}, whati.
		
			(tau ≥ 500) pono: {
				roman tāpiri-muri: ['Ⅾ'].
				tau tango: 500.
			}, whati.
		
			(tau ≥ 100) pono: {
				roman tāpiri-muri: ['Ⅽ'].
				tau tango: 100.
			}, whati.
		
			(tau ≥ 50) pono: {
				roman tāpiri-muri: ['Ⅼ'].
				tau tango: 50.
			}, whati.
		
			(tau ≥ 50) pono: {
				roman tāpiri-muri: ['Ⅼ'].
				tau tango: 50.
			}, whati.
		
			(tau ≥ 10) pono: {
				roman tāpiri-muri: ['Ⅹ'].
				tau tango: 10.
			}, whati.
			
			(tau ≥ 9) pono: {
				roman tāpiri-muri: ['Ⅸ'].
				tau tango: 9.
			}, whati.
			
			(tau ≥ 5) pono: {
				roman tāpiri-muri: ['Ⅴ'].
				tau tango: 5.
			}, whati.
			
			(tau ≥ 4) pono: {
				roman tāpiri-muri: ['Ⅳ'].
				tau tango: 4.
			}, whati.
			
			(tau ≥ 1) pono: {
				roman tāpiri-muri: ['Ⅰ'].
				tau tango: 1.
			}, whati.
		} tikanga.
	} i-te-wa: { <- tau > 0. }. <- roman.
}.

Huaputa tuhi: 1 roman, rārangi-hou.
Huaputa tuhi: 2 roman, rārangi-hou.
Huaputa tuhi: 4 roman, rārangi-hou.
Huaputa tuhi: 8 roman, rārangi-hou.
Huaputa tuhi: 16 roman, rārangi-hou.
Huaputa tuhi: 32 roman, rārangi-hou.
Huaputa tuhi: 64 roman, rārangi-hou.
Huaputa tuhi: 128 roman, rārangi-hou.
Huaputa tuhi: 256 roman, rārangi-hou.
Huaputa tuhi: 1024 roman, rārangi-hou.
