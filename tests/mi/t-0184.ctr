

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

Tau ina-tae: ['addNum:'] mahia: { :x
	whaiaro tāpiri: x.
}.

Tau ina-tae: ['subtractNum:'] mahia: { :x
	whaiaro tango: x.
}.

Tau ina-tae: ['multiplyBy:'] mahia: { :x
	whaiaro whakarau-ki: x.
}.

Tau ina-tae: ['divideBy:'] mahia: { :x
	whaiaro wehe-ki: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pū: 8).  
a := a + (2 pū: -1). 
a := a + (49 pakiaka-tapawha).   
a addNum: ((Rārangi ← 0 ; 1) mōrahi).          
a addNum: ((Rārangi ← 2 ; 3) iti-rawa).
Huaputa tuhi: a.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pū: 8).  
a := a + (2 pū: -1). 
a := a + (49 pakiaka-tapawha).   
a addNum: ((Rārangi ← 0 ; 1) mōrahi).          
a addNum: ((Rārangi ← 2 ; 3) iti-rawa).
Huaputa tuhi: a.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pū: 8).  
a := a + (2 pū: -1). 
a := a + (49 pakiaka-tapawha).   
a addNum: ((Rārangi ← 0 ; 1) mōrahi).          
a addNum: ((Rārangi ← 2 ; 3) iti-rawa).
Huaputa tuhi: a.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
