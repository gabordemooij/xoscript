Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :num
	ake num := num. 
}.

a ina-tae: ['item'] mahia: { <- ake num.
}.

a item: 123.

Huaputa tuhi: a item, rārangi-hou.

>> old-num-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-num-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

Huaputa tuhi: b item, rārangi-hou.
