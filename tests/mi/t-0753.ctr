Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :fmt
	ake fmt := fmt. 
}.

a ina-tae: ['item'] mahia: { <- ake fmt.
}.

a item: ( Hōputu hou: ['|%s|'] ).

Huaputa tuhi: a item, rārangi-hou.

>> old-fmt-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-fmt-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

Huaputa tuhi: ( b item whakahaere: ['hello'] ), rārangi-hou.
