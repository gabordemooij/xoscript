>> Combination := Rārangi hou.

Combination ina-tae: ['tāpiri-muri:'] mahia: { :el
	whaiaro 
	rapua: el, Kore? pono: { whaiaro tāpiri-muri: el. }.
}.

>> colours := Combination hou.
colours
