
>> dictionary := (
	Papakupu hou
		tuku: ['b'] kei: ['a'],
		tuku: ['a'] kei: ['b'],
		tuku: ['z'] kei: ['x'],
		tuku: ['hello'] kei: ['hallo'],
		tuku: ['human'] kei: ['human']
).

>> comparisons := Rārangi hou.
dictionary ia: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a whakataurite: b)
	).
}.

comparisons kōmaka: { :a :b <- ( a whakataurite: b ). }.
Huaputa tuhi: ( comparisons honoa: ['↵'] ), rārangi-hou.
comparisons honoa: ['↵'].
