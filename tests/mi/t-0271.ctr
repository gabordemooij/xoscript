
Papatono whakahaere-pūmahara: 1.
Papatono pūmahara: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> waehere := [''].
	>> x := Tau waenga: 1 me: 10.
	{
		>> y := Tau waenga: 1 me: (tokens roa).
		waehere tāpiri-muri: (tokens pūāhua: y).
	} × x.
	{ Taumahi hou: waehere. } hopu: { ['Empty']. }, tīmata.

} × 10000.
Huaputa tuhi: ['OK'], rārangi-hou.
