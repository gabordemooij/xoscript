#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

{
Wā wā.
Wā tatari: 1.
Huaputa tuhi: Papatono tautohetohe, rārangi-hou.
Papatono tautohetohe: 0.
Tau random.
Huaputa tuhi: (Papatono pūnaha: ['echo 'Hello'']).
} tīmata.

Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 0).

{
Wā wā.
Wā tatari: 1.
Huaputa tuhi: Papatono tautohetohe, rārangi-hou.
Papatono tautohetohe: 0.
Tau random.
Huaputa tuhi: (Papatono pūnaha: ['echo 'Hello'']).
} tīmata.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).

{
Wā wā.
Wā tatari: 1.
Huaputa tuhi: Papatono tautohetohe, rārangi-hou.
Papatono tautohetohe: 0.
Tau random.
Huaputa tuhi: (Papatono pūnaha: ['echo 'Hello'']).
} tīmata.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
