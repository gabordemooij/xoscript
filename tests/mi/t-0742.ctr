Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :hexhelper
	ake hexhelper := hexhelper. 
}.

a ina-tae: ['item'] mahia: { <- ake hexhelper.
}.

a item: Hx hou.

>> old-hexhelper-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-hexhelper-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.
