>> t := Kore.

# you can control the time zone for
# parsing like this:
Wā rohe: ['CET'].
t := Wā pūtake: ['1981-02-03 04:05:06'].
Huaputa tuhi: t, rārangi-hou.

# now using CEST time zone:
Wā rohe: ['CEST'].
t := Wā pūtake: ['1981-02-03 04:05:06'].
Huaputa tuhi: t, rārangi-hou.

# error if string cannot be parsed
{ Wā pūtake: ['1900']. } hopu: { Kore. }, tīmata.
