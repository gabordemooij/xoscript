>> str := ['write:'].
Huaputa karere: ['tuhi:'] tāuru-maha: (Rārangi ← ['Hello World']), rārangi-hou. 

Tau ina-tae: ['isbetween:and:'] mahia: { :a :b <- ((whaiaro ≥ a) a: (whaiaro ≤ b)).
}.

str := ['isbetween:and:'].
Huaputa tuhi: (3 karere: str tāuru-maha: (Rārangi ← 2 ; 8)), rārangi-hou.
Huaputa tuhi: (3 karere: str tāuru-maha: (Rārangi ← 1 ; 2)), rārangi-hou.


>> CoffeeMachine := Ahanoa hou.
CoffeeMachine ina-tae: ['makeCoffeeWithSugar:milk:'] mahia: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Rārangi ← 4 ; 2.
Huaputa tuhi: ( CoffeeMachine karere: order tāuru-maha: coffeeConfiguration ), rārangi-hou.
