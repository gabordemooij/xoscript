>> a := 3.
>> b := a tārua.
a tango: 1.
Huaputa tuhi: [' a = '] + a.
Huaputa tuhi: [' b = '] + b.
a := 3.
b := a + 4.
Huaputa tuhi: [' a = '] + a.
Huaputa tuhi: [' b = '] + b.
>> x := 3.
>> y := x tārua.
x tāpiri: 10.
y tango: 1.
Huaputa tuhi: [' x = '] + x.
Huaputa tuhi: [' y = '] + y.
>> q := Ahanoa hou.
q ina-tae: ['setProperty:'] mahia: { :x
	ake prop := x.
}.
q ina-tae: ['getProperty'] mahia: { <- ake prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Huaputa tuhi: [' p = '] + (p getProperty).
