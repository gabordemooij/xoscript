Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :moment
	ake moment := moment. 
}.

a ina-tae: ['item'] mahia: { <- ake moment.
}.

>> today := Rārangi hou ; ( Wā hou rohe: ['CEST'], tau-maramataka: 2026, marama: 7 ).
a item: today.
Huaputa tuhi: a item ? 0, rārangi-hou.
a save-as: ['/tmp/a.bin'].
