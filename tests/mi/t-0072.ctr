>> echo := Ahanoa hou.
echo ina-tae: ['whakautu:'] mahia: { :sound
	{ Huaputa tuhi: sound. } × 2.
}.
echo ho!. 


echo := Ahanoa hou.
echo ina-tae: ['whakautu:a:'] mahia: { :sound :x
	{ Huaputa tuhi: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Ahanoa hou.
echo ina-tae: ['whakautu:a:a:'] mahia: { :operation :sound :x
	{ Huaputa tuhi: sound. } × x.
}.
echo shout: ['la'] times: 4. 


