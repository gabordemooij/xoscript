# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Papatono shell-escape: ['abc'].
Huaputa tuhi: c, rārangi-hou.
Huaputa tuhi: ( Papatono pūnaha: ['echo '] + c ), rārangi-hou.

c := Papatono shell-escape: ['a'b'c'].
Huaputa tuhi: c, rārangi-hou.
Huaputa tuhi: ( Papatono pūnaha: ['echo '] + c ), rārangi-hou.

c := Papatono shell-escape: ['a\'c'].
Huaputa tuhi: c, rārangi-hou.
Huaputa tuhi: ( Papatono pūnaha: ['echo '] + c ), rārangi-hou.