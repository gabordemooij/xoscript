Server init.

>> DB := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> tawhā-rapu := Uiui-Maria hou: SQL.

# set database
tawhā-rapu pātengi-raraunga: DB.

tawhā-rapu tikina: { :row
	Huaputa tuhi: row world, rārangi-hou.
}.
