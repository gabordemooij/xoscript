

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

>> txt := ['Word Salad'].
Huaputa tuhi: ['last index of ord = '] + (( txt tūnga-whakamutunga: ['ord'] ) - 0), rārangi-hou.
Huaputa tuhi: ['index of ord = '] + (( txt rapua: ['ord'] ) - 0), rārangi-hou.
Huaputa tuhi: ['index of ad = '] + (( txt rapua: ['ad'] ) - 0), rārangi-hou.
Huaputa tuhi: ['last index of W = '] + (( txt tūnga-whakamutunga: ['W'] ) - 0), rārangi-hou.
Huaputa tuhi: ['last index of d = '] + (( txt tūnga-whakamutunga: ['d'] ) - 0), rārangi-hou.
Huaputa tuhi: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), rārangi-hou.
Huaputa tuhi: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), rārangi-hou.
Huaputa tuhi: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), rārangi-hou.
Huaputa tuhi: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


