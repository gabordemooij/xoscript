# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob hou: 8, bytes: (
	Rārangi hou ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Huaputa tuhi: ( utf16 wetewaehere: ['utf16le'] ), rārangi-hou.

utf16 wewete.
>> utf32 := Blob hou: 13, bytes: (
	Rārangi hou ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Huaputa tuhi: ( utf32 wetewaehere: ['utf32be'] ), rārangi-hou.
utf32 wewete.