Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :out
	ake out := out. 
}.

a ina-tae: ['item'] mahia: { <- ake out.
}.

a ina-tae: ['greet'] mahia: {
	Huaputa tuhi: ['hi from original out!'], rārangi-hou.
}.

a item: Huaputa.

Huaputa tuhi: a item, rārangi-hou.

>> old-out-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-out-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

b item tuhi: ['hello from loaded out!'], rārangi-hou.
b greet.
