

Rārangi ina-tae: ['sum'] mahia: {
	>> total := 0.
	whaiaro ia: { :index :element
		total tāpiri: element.
	}. <- total.
}.

Rārangi ina-tae: ['product'] mahia: {
	>> total := 1.
	whaiaro ia: { :index :element
		total whakarau-ki: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

{

>> a := Rārangi ← ['hello'] ; ['world'] ; Pono ; Kore ; 666.
a := a + ( Rārangi ← 1 ).
Huaputa tuhi: ( ['sum: '] + ( a sum ) ), rārangi-hou.
Huaputa tuhi: ( ['min: '] + ( a iti-rawa ) ), rārangi-hou.
Huaputa tuhi: ( ['max: '] + ( a mōrahi ) ), rārangi-hou.
Huaputa tuhi: ( ['3rd: '] + ( a ? 2 ) ), rārangi-hou.
Huaputa tuhi: ( ['prd: '] + ( a product ) ), rārangi-hou.
a kōmaka: { :a :b <- (b - a). }.
a ia: { :i :e Huaputa tuhi: ( i - 0 ), rārangi-hou. }.

} tīmata.

Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 0).


{

>> a := Rārangi ← ['hello'] ; ['world'] ; Pono ; Kore ; 666.
a := a + ( Rārangi ← 1 ).
Huaputa tuhi: ( ['sum: '] + ( a sum ) ), rārangi-hou.
Huaputa tuhi: ( ['min: '] + ( a iti-rawa ) ), rārangi-hou.
Huaputa tuhi: ( ['max: '] + ( a mōrahi ) ), rārangi-hou.
Huaputa tuhi: ( ['3rd: '] + ( a ? 2 ) ), rārangi-hou.
Huaputa tuhi: ( ['prd: '] + ( a product ) ), rārangi-hou.
a kōmaka: { :a :b <- (b - a). }.
a ia: { :i :e Huaputa tuhi: ( i - 0 ), rārangi-hou. }.

} tīmata.



Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


{

>> a := Rārangi ← ['hello'] ; ['world'] ; Pono ; Kore ; 666.
a := a + ( Rārangi ← 1 ).
Huaputa tuhi: ( ['sum: '] + ( a sum ) ), rārangi-hou.
Huaputa tuhi: ( ['min: '] + ( a iti-rawa ) ), rārangi-hou.
Huaputa tuhi: ( ['max: '] + ( a mōrahi ) ), rārangi-hou.
Huaputa tuhi: ( ['3rd: '] + ( a ? 2 ) ), rārangi-hou.
Huaputa tuhi: ( ['prd: '] + ( a product ) ), rārangi-hou.
a kōmaka: { :a :b <- (b - a). }.
a ia: { :i :e Huaputa tuhi: ( i - 0 ), rārangi-hou. }.

} tīmata.



Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).

( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
