Server init.
Huaputa tuhi: ['Database date test'], rārangi-hou.

>> db := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'], 
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

>> tawhā-rapu :=
db uiui: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
tikina: { :row
	Huaputa tuhi: row datetest, rārangi-hou.
}.
