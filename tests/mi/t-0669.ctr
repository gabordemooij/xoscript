# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Pākoro 
	tāmi-kupuhipa: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Pākoro 
	tāmi-kupuhipa: hash whakaū: a1.
	# fail 
>> b := Pākoro
	tāmi-kupuhipa: hash whakaū: a2.
	# ok!

Huaputa tuhi: a, rārangi-hou.
Huaputa tuhi: b, rārangi-hou.

