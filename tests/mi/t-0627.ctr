

# create a 64-bit integer for exact calculations
>> a := Int64 mai-i-te-aho: ['123'].

# to string
Huaputa tuhi: a, rārangi-hou.

# divide
Huaputa tuhi: a / (Int64 mai-i-te-aho: ['3']), rārangi-hou.

# multiply
Huaputa tuhi: a * (Int64 mai-i-te-aho: ['2']), rārangi-hou.

# add
Huaputa tuhi: a + (Int64 mai-i-te-aho: ['1']), rārangi-hou.

# subtract
Huaputa tuhi: a - (Int64 mai-i-te-aho: ['2']), rārangi-hou.

# compare
Huaputa tuhi: ( a =   (Int64 mai-i-te-aho: ['123'])), rārangi-hou.
Huaputa tuhi: ( a !=: (Int64 mai-i-te-aho: ['124'])), rārangi-hou.
Huaputa tuhi: ( a <   (Int64 mai-i-te-aho: ['124'])), rārangi-hou.
Huaputa tuhi: ( a >   (Int64 mai-i-te-aho: ['122'])), rārangi-hou.
Huaputa tuhi: ( a >=: (Int64 mai-i-te-aho: ['123'])), rārangi-hou.
Huaputa tuhi: ( a <=: (Int64 mai-i-te-aho: ['123'])), rārangi-hou.





	