Tau ina-tae: ['factorial'] mahia: {
	>> total := 1.
	{ :index total whakarau-ki: (whaiaro - index). } × whaiaro. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

{
2 exponent factorial.
Huaputa tuhi: (11 toenga: 3), rārangi-hou.
Huaputa tuhi: (3.4 whakaawhiwhi), rārangi-hou.
Huaputa tuhi: (7.1 whakaawhiwhi-ake), rārangi-hou.
Huaputa tuhi: (7.9 whakaawhiwhi-iho), rārangi-hou.
}
tīmata.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).

{
2 exponent factorial.
Huaputa tuhi: (11 toenga: 3), rārangi-hou.
Huaputa tuhi: (3.4 whakaawhiwhi), rārangi-hou.
Huaputa tuhi: (7.1 whakaawhiwhi-ake), rārangi-hou.
Huaputa tuhi: (7.9 whakaawhiwhi-iho), rārangi-hou.
}
tīmata.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


{
2 exponent factorial.
Huaputa tuhi: (11 toenga: 3), rārangi-hou.
Huaputa tuhi: (3.4 whakaawhiwhi), rārangi-hou.
Huaputa tuhi: (7.1 whakaawhiwhi-ake), rārangi-hou.
Huaputa tuhi: (7.9 whakaawhiwhi-iho), rārangi-hou.
} tīmata.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
