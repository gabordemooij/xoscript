

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

>> txt := ['World Salad'].
Huaputa tuhi: ['this text contains: '] + ( ( txt wehewehe: [' '] ) tatau ) + [' words.'], rārangi-hou.
txt := txt mai: 6 roa: 4.
Huaputa tuhi: txt, rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


txt := ['World Salad'].
Huaputa tuhi: ['this text contains: '] + ( ( txt wehewehe: [' '] ) tatau ) + [' words.'], rārangi-hou.
txt := txt mai: 6 roa: 4.
Huaputa tuhi: txt, rārangi-hou.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


txt := ['World Salad'].
Huaputa tuhi: ['this text contains: '] + ( ( txt wehewehe: [' '] ) tatau ) + [' words.'], rārangi-hou.
