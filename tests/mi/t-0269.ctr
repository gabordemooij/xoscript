#Linux

(Kōnae hou: ['/tmp/testje']) kei-te-noho teka: {
	Papatono pūnaha: ['mkdir /tmp/testje'].	
}.

(Kōnae hou: ['/tmp/testje/file1']) kei-te-noho teka: {
	Papatono pūnaha: ['touch /tmp/testje/file1'].	
}.

(Kōnae hou: ['/tmp/testje/folder1']) kei-te-noho teka: {
	Papatono pūnaha: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Kōnae rārangi: ['/tmp/testje'].

>> q := Rārangi hou.

l ia: { :k :v v ia: { :x :y q tāpiri-muri: y. }. }.

>> s := q aho.

(s kei-roto: ['file1']) pono:   { Huaputa tuhi: ['OK'], rārangi-hou. }.
(s kei-roto: ['file2']) pono:   { Huaputa tuhi: ['XX'], rārangi-hou. }.
(s kei-roto: ['folder1']) pono: { Huaputa tuhi: ['OK'], rārangi-hou. }.
