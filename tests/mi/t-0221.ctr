>> x := Ahanoa hou.
>> y := Ahanoa hou.
>> z := x.
Huaputa tuhi: (x = z), rārangi-hou.
Huaputa tuhi: (x = y), rārangi-hou.
Huaputa tuhi: (x ≠ y), rārangi-hou.
Huaputa tuhi: (x ≠ z), rārangi-hou.
>> m := Wā hou tau-maramataka: 2070, marama: 11.
>> n := m tārua.
Huaputa tuhi: (m = n), rārangi-hou.
Huaputa tuhi: (m ≠ n), rārangi-hou.
Huaputa tuhi: (m ōrite-pū: m), rārangi-hou.
Huaputa tuhi: (m ōrite-pū: n), rārangi-hou.
n marama: 12.
Huaputa tuhi: (m ≠ n), rārangi-hou.
Huaputa tuhi: (m = n), rārangi-hou.


