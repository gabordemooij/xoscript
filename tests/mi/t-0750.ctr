Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :nil
	ake nil := nil. 
}.

a ina-tae: ['item'] mahia: { <- ake nil.
}.

a item: Kore.

Huaputa tuhi: a item, rārangi-hou.

>> old-nil-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-nil-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.

Huaputa tuhi: b item, rārangi-hou.
