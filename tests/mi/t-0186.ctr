

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

Huaputa tuhi: (6 < 5), rārangi-hou.
Huaputa tuhi: (2 > 1), rārangi-hou.
Huaputa tuhi: (2 ≤ 1), rārangi-hou.
Huaputa tuhi: (9 ≥ 1), rārangi-hou.
Huaputa tuhi: (2 taukehe?), rārangi-hou.
Huaputa tuhi: (4 taurua?), rārangi-hou.
Huaputa tuhi: (-1 tōrunga?), rārangi-hou.
Huaputa tuhi: (-2 tōraro?), rārangi-hou.
Huaputa tuhi: ((3 ≥ 4) & (3 ≤ 5)), rārangi-hou.
Huaputa tuhi: (3 = 3), rārangi-hou.
Huaputa tuhi: (3 ≠ 3), rārangi-hou.
Huaputa tuhi: 1 pūtaha, rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


