# test Program version

# this feature is disabled by default
Huaputa tuhi: (
	Papatono āhuatanga: 
	['RECURSIVE_STRINTPOL']
), rārangi-hou.


# but if we set the time back
>> today := Wā 
rohe: ['CEST'],
pūtake: ['2026-02-15 10:00:00'].
Papatono putanga: today.

# it will be enabled like it used to be (from now on)
Huaputa tuhi: (
	Papatono āhuatanga: 
	['RECURSIVE_STRINTPOL']
), rārangi-hou.