Papatono whakahaere-pūmahara: 0.
Rārangi ina-tae: ['sum'] mahia: {
	>> total := 0.
	whaiaro ia: { :index :element
		total tāpiri: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Kōnae hou: ['/tmp/test.txt'].
f tuhi: ['Lorem Ipsum'].
f kati-hononga.
  

f := Kōnae hou: ['/tmp/test.txt'].
>> text := f pānui.
f kati-hononga.



Papatono whakapai.
usedMemory1 := (Papatono pūmahara ? 1).



f := Kōnae hou: ['/tmp/test.txt'].
text := f pānui.
f kati-hononga.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 1).


f := Kōnae hou: ['/tmp/test.txt'].
text := f pānui.
f kati-hononga.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 1).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
