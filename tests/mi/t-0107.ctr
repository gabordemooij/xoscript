
Huaputa tuhi: ['Break for-loop, 0-4.'], rārangi-hou.
{ :i
	Huaputa tuhi: ['iteration #'] + i, rārangi-hou.
	(i = 4) whati.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Huaputa tuhi: ['Break while-true loop, 0-4.'], rārangi-hou.
{
	Huaputa tuhi: ['iteration #'] + x, rārangi-hou.
	x tāpiri: 1.
	((x < 5) kāore) whati.
} i-te-wa: xIsLessThan10.

Huaputa tuhi: ['Break while-false loop, 5,4.'], rārangi-hou.
{
	Huaputa tuhi: ['iteration #'] + x, rārangi-hou.
	x tango: 1.
	(x = 3) whati.
} i-te-wa: { <- (x > 0). }.

Huaputa tuhi: ['Break times loop, 1-4.'], rārangi-hou.
{ :i
	Huaputa tuhi: ['iteration #'] + i, rārangi-hou.
	(i = 4) whati.
} × 5.

Huaputa tuhi: ['Break block, dont print line.'], rārangi-hou.
{ Pono whati. Huaputa tuhi: ['dont write this!'], rārangi-hou. } tīmata.

Huaputa tuhi: ['Break block, dont fire catch...'], rārangi-hou.
{ Pono whati. Huaputa tuhi: ['dont write this!'], rārangi-hou. } hopu: { Huaputa tuhi: ['Dont catch this!']. }, tīmata.

Huaputa tuhi: ['Test Array each-loop: 0,1'], rārangi-hou.
(Rārangi ← 1 ; 2 ; 3) huri-ia: { :i
	Huaputa tuhi: ['iteration #'] + i, rārangi-hou.
	(i = 1) whati.
}.

Huaputa tuhi: ['Test Map each-loop: c only'], rārangi-hou.
>> m := Papakupu hou.
m tuku: ['first'] kei: ['a'], tuku: ['second'] kei: ['b'], tuku: ['third'] kei: ['c'].
m ia: { :k :v
	Huaputa tuhi: ['iteration'] + v + k, rārangi-hou.
	Pono whati.
}.

