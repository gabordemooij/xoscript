>> V := Ahanoa.
V ina-tae: ['aho'] mahia: {
	Huaputa tuhi: ['cast'], rārangi-hou. <- ['abc'].
}.

Huaputa tuhi: ( Papatono tautuhinga: ['abc'] ), rārangi-hou.

# params should not get gc'ed
Papatono tautuhinga: ([''] + V hou) uara: ([''] + V hou).

Huaputa tuhi: ( Papatono tautuhinga: ['abc'] ), rārangi-hou.
