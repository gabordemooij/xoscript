>> Greeter := Ahanoa hou.
Greeter ina-tae: ['make'] mahia: {
	>> gr := Ahanoa hou.
	gr ina-tae: ['setName:'] mahia: { :aname
		ake ingoa := aname.
	}.
	gr ina-tae: ['greet'] mahia: {
		Huaputa tuhi: ake ingoa.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a hou.
c setName: ['THREE'].
c greet.
>> d := a hou.
d setName: ['FOUR'].
d greet.
c greet.
