>> numbers := ['1,2,3'] wehewehe: [','].
Huaputa tuhi: ['I got: '] + numbers tatau + [' numbers.'],rārangi-hou.
{ :i Huaputa tuhi: ['number #'] + i + [':'] + (numbers tūnga: i), rārangi-hou.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages wehewehe: [' Or '].
Huaputa tuhi: ['We serve'], rārangi-hou.
{ :i Huaputa tuhi: ['->'] + (beverages tūnga: i), rārangi-hou. } × (beverages tatau).
Huaputa tuhi: (beverages honoa: [',']), rārangi-hou.
Huaputa tuhi: (numbers honoa: ['||']).
