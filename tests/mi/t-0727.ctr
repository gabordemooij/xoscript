Server init.
>> f := Hōputu hou: ['%d'].
>> a := Blob hou: 4.
a bytes: ( Rārangi hou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob hou: 4.
b bytes: ( Rārangi hou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a mai: 0 roa: 3, ia: { :i :byte
	Huaputa tuhi: ( f whakahaere-tau-tōpū: byte ), rārangi-hou.
}.
a ^ b.
a mai: 0 roa: 3, ia: { :i :byte
	Huaputa tuhi: ( f whakahaere-tau-tōpū: byte ), rārangi-hou.
}.
a ^ b.
a mai: 0 roa: 3, ia: { :i :byte
	Huaputa tuhi: ( f whakahaere-tau-tōpū: byte ), rārangi-hou.
}.
a wewete.
b wewete.

{ a ^ Ahanoa. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
