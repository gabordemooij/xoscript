Huaputa tuhi: ['Test object'], rārangi-hou.
>> a := Ahanoa hou. 

a ina-tae: ['item:'] mahia: { :binhelper
	ake binhelper := binhelper. 
}.

a ina-tae: ['item'] mahia: { <- ake binhelper.
}.

a item: Bin hou.

>> old-binhelper-address := a item tauira-taketake wāhitau-pūmahara.
a save-as: ['/tmp/a.bin'].
Huaputa tuhi: ['========== RELOADING SNAP:'], rārangi-hou.

>> b := Ahanoa load-from: ['/tmp/a.bin'].

(b item tauira-taketake wāhitau-pūmahara = old-binhelper-address) pono: {
	Huaputa tuhi: ['Object link re-attached.'], rārangi-hou.
}.


