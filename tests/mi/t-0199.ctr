
Papatono whakahaere-pūmahara: 4.

>> Animal := Ahanoa hou.
Animal ina-tae: ['make'] mahia: {
	>> animal := Ahanoa hou.
	animal ina-tae: ['makeSound'] mahia: {
		Huaputa tuhi: ake sound.
	}. <- animal.
}.
>> Cat := Ahanoa hou.
Cat ina-tae: ['make'] mahia: {
	>> cat := Animal make.
	cat ina-tae: ['init'] mahia: {
		ake sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
