# edge cases from a request must give an error or a result, not a crash
Server init.

Huaputa tuhi: ['<'] + (['abc'] mai: 0 roa: 0, pūmatua) + ['>'], rārangi-hou.
Huaputa tuhi: ['<'] + (['abc'] mai: 0 roa: 0, pūriki) + ['>'], rārangi-hou.
Huaputa tuhi: ['<'] + (['abc'] pekepeke: 3, pūmatua) + ['>'], rārangi-hou.
Huaputa tuhi: [''] pūmatua bytes, rārangi-hou.
Huaputa tuhi: ['aB'] pūmatua, rārangi-hou.
Huaputa tuhi: ['aB'] pūriki, rārangi-hou.

Huaputa tuhi: (Wā hou: 0) tau-maramataka, rārangi-hou.
{ Wā hou: ['9e300'] tau. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
{ Wā hou: ['-9e300'] tau. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
{ Wā hou: ['nan'] tau. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
{ Wā hou: 9000000000000000000. } hopu: { :e Huaputa tuhi: e, rārangi-hou. }, tīmata.
