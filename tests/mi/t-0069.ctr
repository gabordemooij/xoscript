

Aho ina-tae: ['html'] mahia: { <- (
		whaiaro
		whakakapihia: ['&'] me: ['&amp;'],
		whakakapihia: ['<'] me: ['&lt;'],
		whakakapihia: ['>'] me: ['&gt;'],
		whakakapihia: ['"'] me: ['&quot;']
	).
}.


Huaputa tuhi: ([' left trimmed '] tapahi-mokowā) + [' '] + ( ['and right trimmed'] tapahi-mokowā) + ['!'], rārangi-hou.
Huaputa tuhi: ['<html>"html & entities"</html>'] html.
