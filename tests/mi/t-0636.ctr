# test url parsing

Server init.
>> url := URL pūtake: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Huaputa tuhi: ['scheme = '] + url kaupapa-wāhitau, rārangi-hou.
Huaputa tuhi: ['host = '] + url manaaki, rārangi-hou.
Huaputa tuhi: ['port = '] + url tauranga, rārangi-hou.
Huaputa tuhi: ['path = '] + url ara-kōnae, rārangi-hou.
Huaputa tuhi: ['query = '] + url tawhā-rapu, rārangi-hou.
Huaputa tuhi: ['fragment = '] + url wāhanga, rārangi-hou.
