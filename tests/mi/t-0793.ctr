Server init.

>> DB := Maria-DB hou manaaki: ['localhost'],
	ingoa-kaiwhakamahi: ['xo'],
	kupuhipa: ['pass123'],
	ingoa-pātengi-raraunga: ['xobase'],
	tūhono.

{
	DB uiui:
	['DROP TABLE movies'],
	whakatutuki.
} hopu: { Kore. }, tīmata.

DB uiui:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
whakatutuki.

DB uiui: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
tawhā: ( Rārangi hou ; ['Halloween'] ),
whakatutuki.

DB uiui: ['SELECT * FROM movies'],
tikina: { :movie
	Huaputa tuhi: movie title, rārangi-hou.
}.

