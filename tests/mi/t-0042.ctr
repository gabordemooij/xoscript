>> items := Papakupu hou.
items tuku: ['black'] kei: ['coffee'], tuku: ['earl grey'] kei: ['tea'].
Huaputa tuhi: (items kei: ['coffee']), tuhi: (items kei: ['tea']).
Huaputa tuhi: ['there are'] + items tatau + [' items in the array.'].
items tuku: ['capuccino'] kei: ['coffee'].
Huaputa tuhi: ['Now my coffee is.. '] + (items kei: ['coffee']).
items tuku: ['aaa'] kei: ['1'].
items tuku: ['bbb'] kei: ['2'].
Huaputa tuhi: (items kei: ['a']).
