

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

>> txt := ['Word Salad'].
Huaputa tuhi: ( txt tārua mai: 5 roa: 5 ).
Huaputa tuhi: ( txt tārua pekepeke: 5, tapahi-mokowā ), rārangi-hou.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


txt := ['Word Salad'].
