>> Grandfather := Ahanoa hou.
Grandfather ina-tae: ['greet'] mahia: {
	Huaputa tuhi: ['Ave!'], rārangi-hou.
}.
>> Father := Grandfather hou.
Father ina-tae: ['greet'] mahia: {
	Huaputa tuhi: ['Hello'], rārangi-hou.
	whaiaro greet.
}.
>> Son := Father hou.
Son ina-tae: ['greet'] mahia: {
	Huaputa tuhi: ['Hi'], rārangi-hou.
	whaiaro greet.
}.

Son greet.

>> Roundabout := Ahanoa hou.
Roundabout ina-tae: ['circle:'] mahia: { :x
	Huaputa tuhi: x, rārangi-hou.
	(x < 3) pono: { whaiaro karanga-whaiaro circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) pono: { Huaputa tuhi: x, rārangi-hou. x tāpiri: 1.  increment tīmata. }. }.
increment tīmata.