#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Tauira-rapu hou: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ōritenga: subject mahia: { :m :x
	Huaputa tuhi: m, rārangi-hou.
	Huaputa tuhi: x, rārangi-hou. <- ['XXX'].
}.
Huaputa tuhi: result, rārangi-hou.