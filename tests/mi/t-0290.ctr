# test list operations


>> cakes := Rārangi ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes whakakapihia: 1 roa: 2 me: ( Rārangi ← ['cinnamon'] ; ['pineapple'] ).
Huaputa tuhi: (buy honoa: [',']), rārangi-hou.


>> buy := cakes whakakapihia: 1 roa: 12 me: ( Rārangi ← ['cinnamon'] ; ['pineapple'] ).
Huaputa tuhi: (buy honoa: [',']), rārangi-hou.


>> buy := cakes whakakapihia: 2 roa: 10 me: ( Rārangi hou ).
Huaputa tuhi: (buy honoa: [',']), rārangi-hou.


>> buy := cakes whakakapihia: 0 roa: 1 me: ( Rārangi hou ).
Huaputa tuhi: (buy honoa: [',']), rārangi-hou.


>> buy := cakes whakakapihia: ['0'] roa: ['1'] me: ['x'].
Huaputa tuhi: (buy honoa: [',']), rārangi-hou.
