

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Papatono whakahaere-pūmahara: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tāpiri-muri: ['!!'].
Huaputa tuhi: txt.
} tīmata.

Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tāpiri-muri: ['!!'].
Huaputa tuhi: txt.
} tīmata.

Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tāpiri-muri: ['!!'].
Huaputa tuhi: txt.
} tīmata.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
