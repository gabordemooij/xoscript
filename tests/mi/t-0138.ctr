

Papatono whakahaere-pūmahara: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Pono.
>> a := Rārangi ← 1 ; 2 ; 3 ; 4.
>> c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Papatono whakapai.
>> usedMemory1 := (Papatono pūmahara ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 5.
c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['greet!']. }.


Papatono whakapai.
>> usedMemory2 := (Papatono pūmahara ? 0).




x := 2.
y := ['Hello'].
q := { ['']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 4.
c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['greet!']. }.

Papatono whakapai.
>> usedMemory3 := (Papatono pūmahara ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 5.
c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['greet!']. }.
c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['a different greet!'], rārangi-hou. }.


Papatono whakapai.
>> usedMemory4 := (Papatono pūmahara ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Pono.
a := Rārangi ← 1 ; 2 ; 3 ; 4.
c := Ahanoa hou.
c ina-tae: ['greet:'] mahia: { Huaputa tuhi: ['greet!']. }.


Papatono whakapai.
>> usedMemory5 := (Papatono pūmahara ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) pono: { 
	Huaputa tuhi: ['Memory usage remains stable.'], rārangi-hou.
}, ki-te-kore: {
	Huaputa tuhi: ['Used memory not stable.'], rārangi-hou.
}.
