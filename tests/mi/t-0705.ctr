

>> obj := Ahanoa hou.

obj ina-tae: ['greet'] mahia: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ina-tae: ['task'] mahia: {
	ake property := 123.
	{
		# try binds self/own to object instead of block
		Huaputa tuhi: whaiaro greet.
		Huaputa tuhi: ake property.
		1 / 0.
	} hopu: {
		Huaputa tuhi: whaiaro greet.
		Huaputa tuhi: ake property.
		Huaputa tuhi: ['ok'].
	}, whakamātau.
}.

obj task.