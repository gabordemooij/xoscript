Server init.

Huaputa tuhi: (
	Tauira-rapu hou: ['^\\w+$'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 0 match, fails on @ and .

Huaputa tuhi: (
	Tauira-rapu hou: ['^[^@]+@[^\.]+\.\\w+$'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match

Huaputa tuhi: (
	Tauira-rapu hou: ['[^@]+@[^\.]+\.\\w+'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match

Huaputa tuhi: (
	Tauira-rapu hou: ['([^@]+)@([^\.]+)\.\\w+'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match, groups dont matter

Huaputa tuhi: (
	Tauira-rapu hou: ['[a-z]'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 14 matches

Huaputa tuhi: (
	Tauira-rapu hou: ['.*'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match (all)

Huaputa tuhi: (
	Tauira-rapu hou: ['(.*)'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match (all)

Huaputa tuhi: (
	Tauira-rapu hou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ōritenga: ['test@example.com'] 
), rārangi-hou. # 1 match, prefix space optional, gets ignored