

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Papatono whakahaere-pūmahara: 0.

{ :i Huaputa tuhi: i. } × 4.
Huaputa rārangi-hou.
{ :i Huaputa tuhi: (4 - i). } × 4.
Huaputa rārangi-hou.
( 1 > 2 ) teka: { Huaputa tuhi: ['BLOCK 1'], rārangi-hou. }.
( 2 > 1 ) pono:  { Huaputa tuhi: ['BLOCK 2'], rārangi-hou. }.

>> i := 0.
{ Huaputa tuhi: i. i tāpiri: 1. } i-te-wa: { <- ( i < 3). }.
Huaputa rārangi-hou.

i := 3.
{ Huaputa tuhi: i. i := i - 1. } i-te-wa: { <- ( i > 0). }.
Huaputa rārangi-hou.


Papatono whakapai.

usedMemory1 := (Papatono pūmahara ? 0).


{ :i  Huaputa tuhi: i. } × 4.
Huaputa rārangi-hou.
{ :i  Huaputa tuhi: (4 - i). } × 4.
Huaputa rārangi-hou.
( 1 > 2 ) teka: { Huaputa tuhi: ['BLOCK 1'], rārangi-hou. }.
( 2 > 1 ) pono:  { Huaputa tuhi: ['BLOCK 2'], rārangi-hou. }.

>> i := 0.
{ Huaputa tuhi: i. i tāpiri: 1. } i-te-wa: { <- ( i < 3). }.
Huaputa rārangi-hou.

i := 3.
{ Huaputa tuhi: i. i := i - 1. } i-te-wa: { <- ( i > 0). }.
Huaputa rārangi-hou.



Papatono whakapai.
usedMemory2 := (Papatono pūmahara ? 0).


{ :i Huaputa tuhi: i. } × 4.
Huaputa rārangi-hou.
{ :i Huaputa tuhi: (4 - i). } × 4.
Huaputa rārangi-hou.
( 1 > 2 ) teka: { Huaputa tuhi: ['BLOCK 1'], rārangi-hou. }.
( 2 > 1 ) pono:  { Huaputa tuhi: ['BLOCK 2'], rārangi-hou. }.

>> i := 0.
{ Huaputa tuhi: i. i tāpiri: 1. } i-te-wa: { <- ( i < 3). }.
Huaputa rārangi-hou.

i := 3.
{ Huaputa tuhi: i. i := i - 1. } i-te-wa: { <- ( i > 0). }.
Huaputa rārangi-hou.

Papatono whakapai.
usedMemory3 := (Papatono pūmahara ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pono: {
	Huaputa tuhi: ['No memory leaks here'].
}, teka: {
	Huaputa tuhi: ['Leaking memory...'].
}.
