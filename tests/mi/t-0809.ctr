# backslashes must survive code serialization, strings must not end early
>> uara-katoa := Rārangi hou
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

uara-katoa ia: { :i :value
	>> d := Papakupu hou.
	d tuku: value kei: ['k'].
	>> r := d waehere ahanoa.
	Huaputa tuhi: r tatau, rārangi-hou.
	Huaputa tuhi: ( (r kei: ['k']) = value ), rārangi-hou.
}.
