Server init.

# write a test file
>> f := Kōnae hou: ['/tmp/test.gif'].
f tuhi: ['GIF87a01234567810'].

# serve the file
Server whakawhiti: ['test.gif'] kuhimua: ['/tmp/'].

Huaputa rārangi-hou.

Huaputa tuhi: ['Outside container (security):'], rārangi-hou.
{ Server whakawhiti: ['../passwd'] kuhimua: ['/tmp/']. }
hopu: { :e Huaputa tuhi: e, rārangi-hou. },
tīmata.

Huaputa tuhi: ['Invalid prefix:'], rārangi-hou.
{ Server whakawhiti: ['test.gif'] kuhimua: ['z:\\']. }
hopu: { :e Huaputa tuhi: e, rārangi-hou. },
tīmata.

Huaputa tuhi: ['Non-existant file:'], rārangi-hou.
{ Server whakawhiti: ['xxx.xxx'] kuhimua: ['/tmp/']. }
hopu: { :e Huaputa tuhi: e, rārangi-hou. },
tīmata.
