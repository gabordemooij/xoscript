['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Huaputa tuhi: (x + y), rārangi-hou.

>> x := 10040.07.
>> y := 10305.60.

Huaputa tuhi: (x + y), rārangi-hou.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Huaputa tuhi: (x + y + z), rārangi-hou.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Huaputa tuhi: (x + y + z), rārangi-hou.

>> q := 0.1.2.

Huaputa tuhi: (q), rārangi-hou.

>> q := 012.

Huaputa tuhi: (q), rārangi-hou.
