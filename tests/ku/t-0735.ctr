Server init.
>> a := Blob nû: 4.
a bytes: ( Lîste nû ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nû: 4.
b bytes: ( Lîste nû ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a nû.
{ 
>> n := a ^ c.
Derketin binivîse: ['xorred:'], rêza-nû. 
Derketin binivîse: n, rêza-nû. 
} bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
a azad-bike.
b azad-bike.
