(Tune = Tune) rast: { Derketin binivîse: ['Nil is Nil!'].}.
(2 > 1) rast: { Derketin binivîse: ['YES']. }.
(2 > 3) rast: { Derketin binivîse: ['NO']. }.
(2 > 3) şaş: { Derketin binivîse: ['Nonono..'].}.
Rast rast: { Derketin binivîse: ['TRUE is TRUE!']. }.
(Rast) rast: { Derketin binivîse: ['TRUE is TRUE!']. }.
Şaş şaş: { Derketin binivîse: ['FALSE is FALSE!']. }.
