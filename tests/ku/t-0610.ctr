
>> Rectangle := Tişt nû.

Rectangle gava: ['area'] bike: { <- xweyî dirêjî * xweyî width.
}.

Rectangle gava: ['length:'] bike: { :dirêjî
	xweyî dirêjî := dirêjî.
}.

Rectangle gava: ['width:'] bike: { :width
	xweyî width := width.
}.

Rectangle gava: ['nû'] bike: {
	# this will not result into an infinite loop
	>> rectangle := xwe nû.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nû.
Derketin binivîse: a area, rêza-nû. #0

>> b := Rectangle nû length: 2, width: 3.
Derketin binivîse: b area, rêza-nû. #6

