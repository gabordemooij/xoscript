Server init.
>> f := Format nû: ['%d'].
>> a := Blob nû: 4.
a bytes: ( Lîste nû ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nû: 4.
b bytes: ( Lîste nû ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ji: 0 dirêjî: 3, her-yek: { :i :byte
	Derketin binivîse: ( f bisepîne-hejmara-tam: byte ), rêza-nû.
}.
a ^ b.
a ji: 0 dirêjî: 3, her-yek: { :i :byte
	Derketin binivîse: ( f bisepîne-hejmara-tam: byte ), rêza-nû.
}.
a ^ b.
a ji: 0 dirêjî: 3, her-yek: { :i :byte
	Derketin binivîse: ( f bisepîne-hejmara-tam: byte ), rêza-nû.
}.
a azad-bike.
b azad-bike.

{ a ^ Tişt. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
