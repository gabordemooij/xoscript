(2 < 9) rast: { Derketin binivîse: ['Yes, nine is less than ten.']. }.
(9 < 2) rast: { Derketin binivîse: ['My logic fails']. }.
Derketin binivîse: (-2 + 6).
Derketin binivîse: (-3 - -3).
>> TrueIsNice := 3.
Derketin binivîse: TrueIsNice.
>> FalseIsBad := ['Not true!'].
Derketin binivîse: FalseIsBad.
>> NilIsEmpty := ['Yep'].
Derketin binivîse: NilIsEmpty.
