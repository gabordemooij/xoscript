>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Tişt nû.
⚄ gava: ['drawFrom:length:'] bike: { :pool :hejmara-tiştan
	
	>> result := [''].
	
	{
		>> index := Hejmar random % (pool dirêjî).
		result li-dawiyê-zêde-bike: ( pool tîp: (index + 1) ).
		
	} × hejmara-tiştan. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dirêjî.
Derketin binivîse: (['x↵'] x random dirêjî).
Derketin binivîse: (['y↵'] y ?? dirêjî).

