Server init.
Derketin binivîse: ['Database datetime test'], rêza-nû.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'], 
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê :=
db lêpirsîn: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
bîne: { :row
	Derketin binivîse: row datetimetest, rêza-nû.
}.
