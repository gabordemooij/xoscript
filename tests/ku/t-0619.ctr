>> HTML := Tişt nû.
HTML gava: ['bersiv-bide:'] bike: { :tag 
	Derketin binivîse: (['<tag>'] tag: tag), rêza-nû.
}.
HTML gava: ['bersiv-bide:û:'] bike: { :tag :html 
	Derketin binivîse: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), rêza-nû.
}.
>> html := HTML nû.
html body h1: ['header'].

