# line breaks in values must not create extra headers
Server amade-bike.
Bername bi-kar-bîne: ['../../../src/xo/ku/webtools.xo'].
Bername bi-kar-bîne: ['../../../src/xo/ku/mailtools.xo'].

>> sernivîs := Sernivîsa-HTTP nû mifte: ['Location'] buha: ['/ok\r\nX-Injected: yes'].
Derketin binivîse: sernivîs.

>> web := Belgeya-Webê nû.
web here: ['/ok\r\nX-Injected: yes'].
Derketin binivîse: ['\n'], rêza-nû.

>> mail := E-name nû.
mail ji-re: (Lîste nû ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Lîste nû ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Lîste nû ; ['c@example.invalid\r\nX-Bcc: yes']).
mail şandyar: ['d@example.invalid\r\nX-From: yes'] nav: ['site\r\nX-Name: yes'].
mail mijar: ['hello\r\nX-Subject: yes'].
mail laş: ['line1\r\nline2'].
Derketin binivîse: mail çêbike.

>> html := E-name-HTML nû.
html ji-re: (Lîste nû ; ['a@example.invalid\r\nX-To: yes']).
html şandyar: ['d@example.invalid'] nav: ['site'].
html mijar: ['hello\r\nX-Subject: yes'].
html laş: ['body'].
Derketin binivîse: ( html çêbike dihewîne: ['\nX-'] ), rêza-nû.
Derketin binivîse: ( html çêbike dihewîne: ['X-To: yes'] ), rêza-nû.
