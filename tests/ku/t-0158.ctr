>> x := [' hallo '].

>> y := x tîpên-mezin.
Derketin binivîse: x, rêza-nû.
Derketin binivîse: (x heman: y), rêza-nû.

>> y := x tîpên-biçûk.
Derketin binivîse: x, rêza-nû.
Derketin binivîse: (x heman: y), rêza-nû.

>> y := x valahiyan-jêke.
Derketin binivîse: x, rêza-nû.
Derketin binivîse: (x heman: y), rêza-nû.

>> y := x derbas-bike: 1.
Derketin binivîse: x, rêza-nû.
Derketin binivîse: (x heman: y), rêza-nû.

>> y := x ji: 1 dirêjî: 2.
Derketin binivîse: x, rêza-nû.
Derketin binivîse: (x heman: y), rêza-nû.