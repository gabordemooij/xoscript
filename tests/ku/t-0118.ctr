


Derketin binivîse: ['Number:'].
>> a := Hejmar + Hejmar + 1.
a := Hejmar - 2.
a := Hejmar × 2.
a := Hejmar ÷ 2.
Derketin binivîse: a.
Derketin rêza-nû.

Derketin binivîse: ['String:'].
Derketin binivîse: Nivîs dirêjî.
Derketin rêza-nû.

Derketin binivîse: ['File:'].
Derketin binivîse: Pel bixwîne.
Derketin binivîse: (Pel binivîse: ['test']).
Derketin binivîse: (Pel li-dawiyê-zêde-bike: ['test']).
Derketin binivîse: Pel jê-bibe.
Derketin binivîse: Pel heye.
Derketin binivîse: Pel include.
Derketin binivîse: Pel bide-destpêkirin.
Derketin rêza-nû.


Derketin binivîse: ['Array:'].
Derketin binivîse: Lîste ya-dawî-derxe.
Derketin binivîse: Lîste hejmara-tiştan.
Derketin binivîse: (((Lîste li-dawiyê-zêde-bike: 999) nivîs) biguherîne: ['Lĳst'] bi: ['List']).
Derketin binivîse: Lîste hejmara-tiştan.
Derketin binivîse: Lîste ya-yekem-derxe.
Derketin binivîse: (Lîste bigihîne-hev: [',']).
>> f := Lîste nû.
Derketin binivîse: f hejmara-tiştan. 
Derketin rêza-nû.

Derketin binivîse: ['Map:'].
Derketin binivîse: Ferheng hejmara-tiştan.
Derketin binivîse: (Ferheng deyne: ['a'] li: ['b'])  hejmara-tiştan. 
Derketin rêza-nû.




