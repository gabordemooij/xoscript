Derketin binivîse: ['1,2,3,4,5,6,7,8,9,A,'], rêza-nû.
>> Scope := Tişt nû.
Scope gava: ['initialize:'] bike: { :x xweyî property := x. }.
Scope gava: ['confirm'] bike: { Derketin binivîse: [',']. }.
Scope gava: ['ceribandin'] bike: {
	Derketin binivîse: xweyî property.
	xwe confirm.
	( 1 = 1 ) rast: { Derketin binivîse: xweyî property. xwe confirm. }.
	( 1 = 0 ) şaş: { Derketin binivîse: xweyî property. xwe confirm. }.
	>> y := 2. { Derketin binivîse: xweyî property. xwe confirm. } heta-ku: { y kêm-bike: 1. <- (y > 0). }.
	{ Derketin binivîse: xweyî property. xwe confirm. } × 1.
	(Lîste ← 1) her-yek: {  Derketin binivîse: xweyî property. xwe confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Ferheng nû one: ['item']) her-yek: { Derketin binivîse: xweyî property. xwe confirm. }.
	{ 1 ÷ 0. } bigire: { Derketin binivîse: xweyî property. xwe confirm. }, bide-destpêkirin.
	Derketin rêza-nû.
}.
>> scope1 := Scope nû.
scope1 initialize: ['X'].
scope1 ceribandin.
>> function := { 
	xweyî property := ['Y'].
	Derketin binivîse: xweyî property.
	xwe confirm.
	( 1 = 1 ) rast: { Derketin binivîse: xweyî property. xwe confirm. }.
	( 1 = 0 ) şaş: { Derketin binivîse: xweyî property. xwe confirm. }.
	>> y := 2. { Derketin binivîse: xweyî property. xwe confirm. } heta-ku: { y kêm-bike: 1. <- (y > 0). }.
	{ Derketin binivîse: xweyî property. xwe confirm. } × 1.
	(Lîste ← 1) her-yek: {  Derketin binivîse: xweyî property. xwe confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Ferheng nû one: ['item']) her-yek: { Derketin binivîse: xweyî property. xwe confirm. }.
	{ 1 ÷ 0. } bigire: { Derketin binivîse: xweyî property. xwe confirm. }, bide-destpêkirin.
	Derketin rêza-nû.
}.
function gava: ['confirm'] bike: { Derketin binivîse: [',']. }.
function bisepîne: 1 û: 2.
