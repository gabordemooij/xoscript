Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :moment
	xweyî moment := moment. 
}.

a gava: ['item'] bike: { <- xweyî moment.
}.

>> today := Lîste nû ; ( Kêlî nû herêma-demê: ['CEST'], sal: 2026, meh: 7 ).
a item: today.
Derketin binivîse: a item ? 0, rêza-nû.
a save-as: ['/tmp/a.bin'].
