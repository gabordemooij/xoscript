# a value ending in the first part of an opening quote must survive serialization
>> nirx := Lîste nû
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

nirx her-yek: { :i :value
	>> d := Ferheng nû.
	d deyne: value li: ['k'].
	d deyne: ['second'] li: ['j'].
	>> r := d kod tişt.
	Derketin binivîse: r hejmara-tiştan, rêza-nû.
	Derketin binivîse: ( (r li: ['k']) = value ), rêza-nû.
}.
