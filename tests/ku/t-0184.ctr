

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

Hejmar gava: ['addNum:'] bike: { :x
	xwe zêde-bike: x.
}.

Hejmar gava: ['subtractNum:'] bike: { :x
	xwe kêm-bike: x.
}.

Hejmar gava: ['multiplyBy:'] bike: { :x
	xwe carî: x.
}.

Hejmar gava: ['divideBy:'] bike: { :x
	xwe parve-bike-li: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hêz: 8).  
a := a + (2 hêz: -1). 
a := a + (49 koka-çargoşe).   
a addNum: ((Lîste ← 0 ; 1) herî-mezin).          
a addNum: ((Lîste ← 2 ; 3) herî-biçûk).
Derketin binivîse: a.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hêz: 8).  
a := a + (2 hêz: -1). 
a := a + (49 koka-çargoşe).   
a addNum: ((Lîste ← 0 ; 1) herî-mezin).          
a addNum: ((Lîste ← 2 ; 3) herî-biçûk).
Derketin binivîse: a.

Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hêz: 8).  
a := a + (2 hêz: -1). 
a := a + (49 koka-çargoşe).   
a addNum: ((Lîste ← 0 ; 1) herî-mezin).          
a addNum: ((Lîste ← 2 ; 3) herî-biçûk).
Derketin binivîse: a.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
