>> items := Ferheng nû.
items deyne: ['black'] li: ['coffee'], deyne: ['earl grey'] li: ['tea'].
Derketin binivîse: (items li: ['coffee']), binivîse: (items li: ['tea']).
Derketin binivîse: ['there are'] + items hejmara-tiştan + [' items in the array.'].
items deyne: ['capuccino'] li: ['coffee'].
Derketin binivîse: ['Now my coffee is.. '] + (items li: ['coffee']).
items deyne: ['aaa'] li: ['1'].
items deyne: ['bbb'] li: ['2'].
Derketin binivîse: (items li: ['a']).
