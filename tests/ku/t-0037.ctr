>> a := 3.
>> b := a kopî-bike.
a kêm-bike: 1.
Derketin binivîse: [' a = '] + a.
Derketin binivîse: [' b = '] + b.
a := 3.
b := a + 4.
Derketin binivîse: [' a = '] + a.
Derketin binivîse: [' b = '] + b.
>> x := 3.
>> y := x kopî-bike.
x zêde-bike: 10.
y kêm-bike: 1.
Derketin binivîse: [' x = '] + x.
Derketin binivîse: [' y = '] + y.
>> q := Tişt nû.
q gava: ['setProperty:'] bike: { :x
	xweyî prop := x.
}.
q gava: ['getProperty'] bike: { <- xweyî prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Derketin binivîse: [' p = '] + (p getProperty).
