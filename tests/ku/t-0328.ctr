Bername rêveberiya-bîrê: 4.

>> Doubler := Tişt nû.
>> Multiplier := Tişt nû.
Doubler gava: ['double:and:'] bike: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier gava: ['multiply:and:'] bike: { :x :y <- (x × y).
}.

Derketin binivîse: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), rêza-nû.
