
>> a := Lîste ← (Lîste ← 100 ; 200 ; 300) ; (Lîste ← 9 ; 8 ; 7).
Derketin binivîse: ['at 0,1 :'].
Derketin binivîse: a ? 0 ? 1, rêza-nû. 
Derketin binivîse: ['at 1,2 :'].
Derketin binivîse: a ? 1 ? 2, rêza-nû. 
>> menu := Ferheng nû.
menu deyne: (Lîste ← ['pizza'] ; ['spaghetti']) li: ['Italian Cuisine'].
menu deyne: (Lîste ← ['bifteki'] ; ['suflaki']) li: ['Greek Cuisine'].
Derketin binivîse: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), rêza-nû. 
Derketin binivîse: ['but not on the same plate.'], rêza-nû.
