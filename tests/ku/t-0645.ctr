Server init.
Derketin binivîse: ['Database date test'], rêza-nû.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'], 
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê :=
db lêpirsîn: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
bîne: { :row
	Derketin binivîse: row datetest, rêza-nû.
}.
