Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :out
	xweyî out := out. 
}.

a gava: ['item'] bike: { <- xweyî out.
}.

a gava: ['greet'] bike: {
	Derketin binivîse: ['hi from original out!'], rêza-nû.
}.

a item: Derketin.

Derketin binivîse: a item, rêza-nû.

>> old-out-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-out-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.

b item binivîse: ['hello from loaded out!'], rêza-nû.
b greet.
