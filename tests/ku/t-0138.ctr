

Bername rêveberiya-bîrê: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Rast.
>> a := Lîste ← 1 ; 2 ; 3 ; 4.
>> c := Tişt nû.
c gava: ['greet:'] bike: { Derketin binivîse: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Bername paqij-bike.
>> usedMemory1 := (Bername bîr ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 5.
c := Tişt nû.
c gava: ['greet:'] bike: { Derketin binivîse: ['greet!']. }.


Bername paqij-bike.
>> usedMemory2 := (Bername bîr ? 0).




x := 2.
y := ['Hello'].
q := { ['']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 4.
c := Tişt nû.
c gava: ['greet:'] bike: { Derketin binivîse: ['greet!']. }.

Bername paqij-bike.
>> usedMemory3 := (Bername bîr ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 5.
c := Tişt nû.
c gava: ['greet:'] bike: { Derketin binivîse: ['greet!']. }.
c := Tişt nû.
c gava: ['greet:'] bike: { Derketin binivîse: ['a different greet!'], rêza-nû. }.


Bername paqij-bike.
>> usedMemory4 := (Bername bîr ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Rast.
