>> kod := {
	>> o := (
		Ferheng nû
		aa: (Lîste ← 1 ; 2),
		bb: (Lîste ← 3 ; 4)
	).
	>> s := o nivîs.
	>> o2 := s tişt.
	(s  cure = Nivîs cure) rast: { Derketin binivîse: ['OK1'], rêza-nû. }.
	(o2 cure = Ferheng cure) rast: { Derketin binivîse: ['OK2'], rêza-nû. }.
}.

Bername rêveberiya-bîrê: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Bername paqij-bike.
usedMemory1 := (Bername bîr ? 1).
kod bide-destpêkirin.
