

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

{ :i Derketin binivîse: i. } × 4.
Derketin rêza-nû.
{ :i Derketin binivîse: (4 - i). } × 4.
Derketin rêza-nû.
( 1 > 2 ) şaş: { Derketin binivîse: ['BLOCK 1'], rêza-nû. }.
( 2 > 1 ) rast:  { Derketin binivîse: ['BLOCK 2'], rêza-nû. }.

>> i := 0.
{ Derketin binivîse: i. i zêde-bike: 1. } heta-ku: { <- ( i < 3). }.
Derketin rêza-nû.

i := 3.
{ Derketin binivîse: i. i := i - 1. } heta-ku: { <- ( i > 0). }.
Derketin rêza-nû.


Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


{ :i  Derketin binivîse: i. } × 4.
Derketin rêza-nû.
{ :i  Derketin binivîse: (4 - i). } × 4.
Derketin rêza-nû.
( 1 > 2 ) şaş: { Derketin binivîse: ['BLOCK 1'], rêza-nû. }.
( 2 > 1 ) rast:  { Derketin binivîse: ['BLOCK 2'], rêza-nû. }.

>> i := 0.
{ Derketin binivîse: i. i zêde-bike: 1. } heta-ku: { <- ( i < 3). }.
Derketin rêza-nû.

i := 3.
{ Derketin binivîse: i. i := i - 1. } heta-ku: { <- ( i > 0). }.
Derketin rêza-nû.



Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).


{ :i Derketin binivîse: i. } × 4.
Derketin rêza-nû.
{ :i Derketin binivîse: (4 - i). } × 4.
Derketin rêza-nû.
( 1 > 2 ) şaş: { Derketin binivîse: ['BLOCK 1'], rêza-nû. }.
( 2 > 1 ) rast:  { Derketin binivîse: ['BLOCK 2'], rêza-nû. }.

>> i := 0.
{ Derketin binivîse: i. i zêde-bike: 1. } heta-ku: { <- ( i < 3). }.
Derketin rêza-nû.

i := 3.
{ Derketin binivîse: i. i := i - 1. } heta-ku: { <- ( i > 0). }.
Derketin rêza-nû.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
