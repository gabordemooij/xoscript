# test number -> string -> number
{

	>> x := Hejmar di-navbera: 0 û: 1000000.
	>> d := Hejmar di-navbera: 1 û: 7.
	>> e := 10 hêz: d.

	x parve-bike-li: e.
	>> y := x nivîs hejmar.

	(x = y) şaş: {
		Derketin binivîse: x, rêza-nû.
		Derketin binivîse: y, rêza-nû.
		Bername biqedîne.
	}.

} * 1000.
Derketin binivîse: ['OK'], rêza-nû.