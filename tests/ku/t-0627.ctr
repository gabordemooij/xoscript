

# create a 64-bit integer for exact calculations
>> a := Int64 ji-nivîsê: ['123'].

# to string
Derketin binivîse: a, rêza-nû.

# divide
Derketin binivîse: a / (Int64 ji-nivîsê: ['3']), rêza-nû.

# multiply
Derketin binivîse: a * (Int64 ji-nivîsê: ['2']), rêza-nû.

# add
Derketin binivîse: a + (Int64 ji-nivîsê: ['1']), rêza-nû.

# subtract
Derketin binivîse: a - (Int64 ji-nivîsê: ['2']), rêza-nû.

# compare
Derketin binivîse: ( a =   (Int64 ji-nivîsê: ['123'])), rêza-nû.
Derketin binivîse: ( a !=: (Int64 ji-nivîsê: ['124'])), rêza-nû.
Derketin binivîse: ( a <   (Int64 ji-nivîsê: ['124'])), rêza-nû.
Derketin binivîse: ( a >   (Int64 ji-nivîsê: ['122'])), rêza-nû.
Derketin binivîse: ( a >=: (Int64 ji-nivîsê: ['123'])), rêza-nû.
Derketin binivîse: ( a <=: (Int64 ji-nivîsê: ['123'])), rêza-nû.





	