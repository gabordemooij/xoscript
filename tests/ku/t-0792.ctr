Server init.

>> DB := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB lêpirsîn: SQL.

# now you don't have to set DB
query2 bîne: { :row
	Derketin binivîse: row world, rêza-nû.
}.
