# compliance test

# use international numbers

Derketin binivîse: ['1000 -> '].
Derketin binivîse: 1000, rêza-nû. #1000

Derketin binivîse: ['1.5 -> '].
Derketin binivîse: 1.5, rêza-nû.  #1.5

Derketin binivîse: ['1001.5 -> '].
Derketin binivîse: 1.5 + 1000, rêza-nû. #1001.5

# use 0-indexed arrays
>> x := Lîste nû ; 1 ; 2 ; 3.
>> y := Lîste nû ; ['a'] ; ['b'] ; ['c'].

Derketin binivîse: ['1 -> '].
Derketin binivîse: x ? 0, rêza-nû. #1

Derketin binivîse: ['1 -> '].
Derketin binivîse: (x li: 0), rêza-nû. #1

Derketin binivîse: ['1 -> '].
Derketin binivîse: x yekem, rêza-nû. #1

Derketin binivîse: ['3 -> '].
Derketin binivîse: x ya-dawî, rêza-nû. #3

Derketin binivîse: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Derketin binivîse: (x li-gorî: y), rêza-nû.

Derketin binivîse: ['1 -> '].
Derketin binivîse: (x ji: 0 dirêjî: 1) yekem, rêza-nû. #1

Derketin binivîse: ['0 -> '].
Derketin binivîse: (x bibîne: 1), rêza-nû. #0

x deyne: 9 li: 0.

Derketin binivîse: ['9 -> '].
Derketin binivîse: (x li: 0), rêza-nû. #9

x li-destpêkê-zêde-bike: 8.
Derketin binivîse: ['8 -> '].
Derketin binivîse: (x li: 0), rêza-nû. #9


x li-dawiyê-zêde-bike: 10.
Derketin binivîse: ['10 -> '].
Derketin binivîse: (x li: 4), rêza-nû. #10








