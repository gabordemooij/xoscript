Server init.

Derketin binivîse: (
	Qalib nû: ['^\\w+$'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 0 match, fails on @ and .

Derketin binivîse: (
	Qalib nû: ['^[^@]+@[^\.]+\.\\w+$'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match

Derketin binivîse: (
	Qalib nû: ['[^@]+@[^\.]+\.\\w+'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match

Derketin binivîse: (
	Qalib nû: ['([^@]+)@([^\.]+)\.\\w+'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match, groups dont matter

Derketin binivîse: (
	Qalib nû: ['[a-z]'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 14 matches

Derketin binivîse: (
	Qalib nû: ['.*'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match (all)

Derketin binivîse: (
	Qalib nû: ['(.*)'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match (all)

Derketin binivîse: (
	Qalib nû: ['\\s*[^@]+@[^\.]+\.\\w+'],
	lihevhatin: ['test@example.com'] 
), rêza-nû. # 1 match, prefix space optional, gets ignored