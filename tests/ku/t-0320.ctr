


>> CoffeeMachine := Tişt nû.
CoffeeMachine gava: ['order:'] bike: { :id
	>> coffee := ['Americano'].
	( id = 1 ) rast: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) rast: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) rast: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Tişt nû.
SimpleCoffeeMachine gava: ['order'] bike: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Derketin binivîse: redCup, rêza-nû.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Derketin binivîse: greenCup, rêza-nû.
>> yellowCup := CoffeeMachine order: 1.
Derketin binivîse: yellowCup, rêza-nû.
>> blueCup := CoffeeMachine order: 0.
Derketin binivîse: blueCup, rêza-nû.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Derketin binivîse: blackCup, rêza-nû.
blackCup li-dawiyê-zêde-bike: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Derketin binivîse: orangeCup, rêza-nû.
