

>> obj := Tişt nû.

obj gava: ['greet'] bike: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj gava: ['task'] bike: {
	xweyî property := 123.
	{
		# try binds self/own to object instead of block
		Derketin binivîse: xwe greet.
		Derketin binivîse: xweyî property.
		1 / 0.
	} bigire: {
		Derketin binivîse: xwe greet.
		Derketin binivîse: xweyî property.
		Derketin binivîse: ['ok'].
	}, biceribîne.
}.

obj task.