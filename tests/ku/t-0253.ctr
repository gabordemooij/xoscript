#Linux
>> OS := Bername mîheng: ['OS'].

>> clock := Kêlî nû.
	
(OS = ['Haiku']) rast: {
	clock herêma-demê: ['CET'],
	sal: 2017, meh: 7, roj: 13,
	saet: 18, deqe: 0, çirke: 0.
}, wekî-din: {
	clock herêma-demê: ['Europe/Amsterdam'],
	sal: 2017, meh: 7, roj: 13,
	saet: 18, deqe: 0, çirke: 0.
}.

clock gava: ['tell'] bike: {
	Derketin binivîse: xwe, rêza-nû.
}.


clock zêde-bike: 2    saet, tell.
clock zêde-bike: 1    saet, tell.
clock zêde-bike: 19 deqe, tell.
clock zêde-bike: 1  deqe, tell.
clock zêde-bike: 1  deqe, tell.
clock zêde-bike: 19 çirke, tell.
clock zêde-bike: 1  çirke, tell.
clock zêde-bike: 1  çirke, tell.
clock zêde-bike: 2    sal, tell.
clock zêde-bike: 1    sal, tell.

(OS = ['Haiku']) rast: {
clock zêde-bike: 5   meh.
clock herêma-demê: ['CEST'], tell.
}, wekî-din: {
	clock zêde-bike: 5   meh, tell.
}.

clock zêde-bike: 1   meh, tell.
clock zêde-bike: 19    roj, tell.
clock zêde-bike: 1    saet, tell.
clock zêde-bike: 120  yard, tell.
