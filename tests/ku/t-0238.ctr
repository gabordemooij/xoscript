Nivîs gava: ['evaluate'] bike: {
	>> kod := Pel nû: ['/tmp/eval.ctr'].
	kod binivîse: (xwe nivîs + ['.']).
	Bername bi-kar-bîne: ['/tmp/eval.ctr'].
}.

>> a := Lîste ← 1 ; 2 ; 3.
>> b := (a nivîs).

Derketin binivîse: b, rêza-nû. 
(['b := '] + b) evaluate.

Derketin binivîse: b ? 2, rêza-nû. 

Derketin binivîse: (( Lîste ← 1 ; 2 ; 3 )), rêza-nû. 

Derketin binivîse: ((Ferheng nû) deyne: 1 li: 2), rêza-nû. 

>> x := ( (Lîste ← 1 ; ( Lîste ← 9 ) ; Rast ) ) nivîs.
Derketin binivîse: x, rêza-nû. 
(['x := '] + x) evaluate.

Derketin binivîse: x ? 1 ? 0, rêza-nû. 

>> y := (Ferheng nû) deyne: (Lîste ← 1) li: (Lîste ← 2).
Derketin binivîse: y, rêza-nû. 

(['y := '] + y) nivîs evaluate.

Derketin binivîse: (y li: (Lîste ← 2) nivîs ), rêza-nû.

Derketin binivîse: (Lîste nû), rêza-nû. 
Derketin binivîse: (Ferheng nû), rêza-nû. 
