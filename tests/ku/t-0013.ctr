
>> Animal := Tişt nû.
Animal gava: ['nû'] bike: { <- xwe nû init.
}.

Animal gava: ['init'] bike: {
	xweyî sound := ['?'].
	xweyî legs := 4.
}.

>> Dog := Animal nû.
Dog gava: ['init'] bike: {
	xwe init.
	xweyî sound := ['barks'].
}.

Animal gava: ['nivîs'] bike: { <- xweyî legs nivîs + xweyî sound.
}.

>> poodle := Dog nû.
Derketin binivîse: poodle, rêza-nû.

