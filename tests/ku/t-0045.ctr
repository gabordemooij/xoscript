Bername rêveberiya-bîrê: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } bigire: {
		oops zêde-bike: 1.
	}, bide-destpêkirin.
} × 1000.

{
	Derketin binivîse: ['hi there!'].
	ev-kar şaşî: ['oops'].
	Derketin binivîse: ['hi there!'].
	{ Derketin binivîse: ['dont print this']. } bide-destpêkirin.
} bigire: { :e 
