Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['state:'] bike: { :list
	xweyî list := list. 
}.

a gava: ['state'] bike: {
	Derketin binivîse: xweyî list, rêza-nû.
}.

a state: ( Lîste nû ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
b state.