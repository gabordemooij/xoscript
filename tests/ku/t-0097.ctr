
Nivîs gava: ['html'] bike: { <- (
		xwe
		biguherîne: ['&'] bi: ['&amp;'],
		biguherîne: ['<'] bi: ['&lt;'],
		biguherîne: ['>'] bi: ['&gt;'],
		biguherîne: ['"'] bi: ['&quot;']
	).
}.

>> HtmlBrush := Tişt nû.

HtmlBrush gava: ['bersiv-bide:'] bike: { :tag
	Derketin binivîse: (['<tag>↵'] tag: tag ).
}.

HtmlBrush gava: ['bersiv-bide:û:'] bike: { :tag :content
	tag := ( tag ji: 0 dirêjî: (tag dirêjî - 1) ).
	Derketin binivîse: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush gava: ['content:'] bike: { :text
	Derketin binivîse: text html, rêza-nû.
}.

HtmlBrush gava: ['attr:value:'] bike: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush nû.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
