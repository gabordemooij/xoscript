Server init.

>> DB := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametreyên-lêgerînê := Lêpirsîna-Maria nû: SQL.

# set database
parametreyên-lêgerînê danegeh: DB.

parametreyên-lêgerînê bîne: { :row
	Derketin binivîse: row world, rêza-nû.
}.
