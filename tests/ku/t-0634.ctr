# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Bername shell-escape: ['abc'].
Derketin binivîse: c, rêza-nû.
Derketin binivîse: ( Bername pergal: ['echo '] + c ), rêza-nû.

c := Bername shell-escape: ['a'b'c'].
Derketin binivîse: c, rêza-nû.
Derketin binivîse: ( Bername pergal: ['echo '] + c ), rêza-nû.

c := Bername shell-escape: ['a\'c'].
Derketin binivîse: c, rêza-nû.
Derketin binivîse: ( Bername pergal: ['echo '] + c ), rêza-nû.