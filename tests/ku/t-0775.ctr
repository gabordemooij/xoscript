Derketin binivîse: ['Test object'], rêza-nû.
>> l := Lîste nû ; 1 ; ( Lîste nû ; (Kêlî nû: 1) ; (Int64 ji-nivîsê: ['321']) ; (Lîste nû ; 3)).
Derketin binivîse: l, rêza-nû.
>> old-lst-address := l prototîp navnîşana-bîrê.
l save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
(b prototîp navnîşana-bîrê = old-lst-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
Derketin binivîse: b, rêza-nû.
