Derketin binivîse: ['Test object'], rêza-nû.
>> cmd := Ferman nû.
Derketin binivîse: cmd ls /tmp, rêza-nû.
>> old-cmd-address := cmd prototîp navnîşana-bîrê.
cmd save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
(b prototîp navnîşana-bîrê = old-cmd-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
Derketin binivîse: b ls, rêza-nû.


