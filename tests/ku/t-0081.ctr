>> map1 := Ferheng nû.
>> key1 := Lîste nû.
>> key2 := Lîste nû.

map1
	deyne: ['hello'] li: key1,
	deyne: ['world'] li: key2.


Derketin
	binivîse: ['Map #1 contains: '] + (map1 li: key1),
	binivîse: [' and '] + (map1 li: key2), rêza-nû.

>> KeyeableArray := Lîste nû.
KeyeableArray gava: ['toString'] bike: { <- (xwe hejmara-tiştan) toString.
}.

>> map2 := Ferheng nû.
key1 := KeyeableArray nû.
key2 := KeyeableArray nû.

key1 li-dawiyê-zêde-bike: 1.

map2
	deyne: ['hello'] li: key1,
	deyne: ['world'] li: key2.

Derketin
	binivîse: ['Map #2 contains: '] + (map2 li: key1),
	binivîse: [' and '] + (map2 li: key2), rêza-nû.
