>> Greeter := Tişt nû.
Greeter gava: ['make'] bike: {
	>> gr := Tişt nû.
	gr gava: ['setName:'] bike: { :aname
		xweyî nav := aname.
	}.
	gr gava: ['greet'] bike: {
		Derketin binivîse: xweyî nav.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nû.
c setName: ['THREE'].
c greet.
>> d := a nû.
d setName: ['FOUR'].
d greet.
c greet.
