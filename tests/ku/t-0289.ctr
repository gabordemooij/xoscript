#Linux
>> OS := Bername pergal: (Ferman uname -s), valahiyan-jêke.

>> Slurp := Tişt nû.
Slurp gava: ['nû'] bike: {
	xweyî str := [''].
}.
Slurp gava: ['bersiv-bide:'] bike: { :blah
		(xweyî str ≠ ['']) rast: {
			xweyî str li-dawiyê-zêde-bike: [' '].
		}.
		xweyî str li-dawiyê-zêde-bike: blah.
}.
Slurp gava: ['bersiv-bide:û:'] bike: { :blah :blahah
		(xweyî str ≠ ['']) rast: {
			xweyî str li-dawiyê-zêde-bike: [' '].
		}.
		(blah dirêjî > 1) rast: {
			xweyî str li-dawiyê-zêde-bike: (blah ji: 0 dirêjî: (blah dirêjî - 1)).
		}, wekî-din: {
			xweyî str li-dawiyê-zêde-bike: blah.
		}.
		xweyî str li-dawiyê-zêde-bike: [' '].
		xweyî str li-dawiyê-zêde-bike: blahah.
}.
Slurp gava: ['obtain'] bike: {
	>> buffer := xweyî str.
	xweyî str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text li-dawiyê-zêde-bike: ['hello'].
} × 1000.


Derketin binivîse: (
	Bername pergal: (
		Slurp nû
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

