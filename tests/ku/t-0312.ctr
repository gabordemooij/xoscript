>> Slurp := Tişt nû.
Slurp gava: ['nû'] bike: {
	xweyî str := [''].
}.
Slurp fêr-bibe: ['nieuw'] wate: ['nû'].
Slurp gava: ['bersiv-bide:'] bike: { :blah
		(xweyî str ≠ ['']) rast: {
			xweyî str li-dawiyê-zêde-bike: [' '].
		}.
		xweyî str li-dawiyê-zêde-bike: blah.
}.
Slurp gava: ['bersiv-bide:û:'] bike: { :blah :blahah
		(xweyî str ≠ ['']) rast: {
			xweyî str li-dawiyê-zêde-bike: [' '].
		}.
		(blah dirêjî > 1) rast: {
			xweyî str li-dawiyê-zêde-bike: (blah ji: 0 dirêjî: (blah dirêjî - 1)).
		}, wekî-din: {
			xweyî str li-dawiyê-zêde-bike: blah.
		}.
		xweyî str li-dawiyê-zêde-bike: [' '].
		xweyî str li-dawiyê-zêde-bike: blahah.
}.
Slurp gava: ['obtain'] bike: {
	>> buffer := xweyî str.
	xweyî str := ['']. <- buffer.
}.


>> parametreyên-lêgerînê := Slurp nû
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Derketin binivîse: parametreyên-lêgerînê obtain, rêza-nû.
