>> invoice := Tişt nû.
invoice gava: ['bide-destpêkirin'] bike: {
        xweyî hejmar := 0.
}.

invoice gava: ['hejmar'] bike: {
        xweyî hejmar zêde-bike: 1. <- xweyî hejmar kopî-bike.
}.

>> year-invoice := invoice nû.
year-invoice gava: ['start:'] bike: { :sal
	xweyî hejmar := sal.
}.

year-invoice start: 202000.
Derketin binivîse: year-invoice hejmar, rêza-nû.
Derketin binivîse: year-invoice hejmar, rêza-nû.
