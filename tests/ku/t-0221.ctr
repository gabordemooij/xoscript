>> x := Tişt nû.
>> y := Tişt nû.
>> z := x.
Derketin binivîse: (x = z), rêza-nû.
Derketin binivîse: (x = y), rêza-nû.
Derketin binivîse: (x ≠ y), rêza-nû.
Derketin binivîse: (x ≠ z), rêza-nû.
>> m := Kêlî nû sal: 2070, meh: 11.
>> n := m kopî-bike.
Derketin binivîse: (m = n), rêza-nû.
Derketin binivîse: (m ≠ n), rêza-nû.
Derketin binivîse: (m heman: m), rêza-nû.
Derketin binivîse: (m heman: n), rêza-nû.
n meh: 12.
Derketin binivîse: (m ≠ n), rêza-nû.
Derketin binivîse: (m = n), rêza-nû.


