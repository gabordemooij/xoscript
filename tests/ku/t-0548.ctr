Server init.

>> x := Blob nû: 65 cure: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Bername mîheng: ['FFITESTLIB'].
Server girêbide: (
 Lîste nû ;
 libname ;
 ['putchar'] ;
 ( Lîste nû ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x ji: 0 dirêjî: 1), rêza-nû.
x azad-bike.

