
Server init.
Derketin binivîse: ['Database test'], rêza-nû.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'], 
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê :=
db lêpirsîn: ['SELECT REPEAT('Blah',1000) AS blah'], 
bîne: { :row 
	Derketin binivîse: row blah dirêjî, rêza-nû.
}.
