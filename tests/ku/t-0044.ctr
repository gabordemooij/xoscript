>> list := Lîste nû.
list ~ ['hello'].
Derketin binivîse: list hejmara-tiştan.
list li-dawiyê-zêde-bike: ['world'].
Derketin binivîse: list hejmara-tiştan.
Derketin binivîse: list ya-dawî-derxe, binivîse: list hejmara-tiştan.
list li-dawiyê-zêde-bike: ['there'].
Derketin binivîse: list hejmara-tiştan.
Derketin binivîse: (list cih: 0), binivîse: (list cih: 1).
list deyne: ['xmas'] li: 1.
list deyne: ['merry'] li: 0.
Derketin binivîse: list hejmara-tiştan.
Derketin binivîse: (list cih: 0), binivîse: (list cih: 1).
