>> winery := { <- (	Ferheng nû
		deyne: 2 li: ['merlot'],
		deyne: 3 li: ['malbec'],
		deyne: 4 li: ['syrah']
	).
}.

Derketin binivîse: (((winery bide-destpêkirin) - ['nothing']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['merlot']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['malbec']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['syrah']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['merlot'] - ['malbec']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['merlot'] - ['syrah']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['malbec'] -['syrah']) hejmara-tiştan), rêza-nû.
Derketin binivîse: (((winery bide-destpêkirin) - ['malbec'] - ['syrah'] - ['merlot']) hejmara-tiştan), rêza-nû.

