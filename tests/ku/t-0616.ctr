Lîste gava: ['kopî-bike'] bike: {
	>> kopî-bike := Lîste nû.
	xwe her-yek: { :hejmar :section
		kopî-bike li-dawiyê-zêde-bike: section xwe-bangker kopî-bike.
	}. <- kopî-bike.
}.

>> sheep := Lîste nû ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopî-bike.
clones her-yek: { :hejmar :sheep
	sheep li-dawiyê-zêde-bike: ['2'].
}.

Derketin binivîse: sheep, rêza-nû.
Derketin binivîse: clones, rêza-nû.
