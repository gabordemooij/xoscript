>> To-Do := Tişt nû.

To-Do gava: ['nû'] bike: {
	xweyî list := Lîste nû.
}.

To-Do gava: ['nieuw'] bike: {
	xweyî list := Lîste nû.
}.

To-Do gava: ['+'] bike: { :task
	xweyî list li-dawiyê-zêde-bike: task.
}.

To-Do gava: ['number of tasks?'] bike: { <-  xweyî list hejmara-tiştan.
}.

>> todos := 
	To-Do nû 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Derketin binivîse: ['You have $ tasks to do'] $ todos number of tasks?.
