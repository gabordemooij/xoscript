Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :octhelper
	xweyî octhelper := octhelper. 
}.

a gava: ['item'] bike: { <- xweyî octhelper.
}.

a item: Oct nû.

>> old-octhelper-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-octhelper-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
