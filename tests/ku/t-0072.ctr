>> echo := Tişt nû.
echo gava: ['bersiv-bide:'] bike: { :sound
	{ Derketin binivîse: sound. } × 2.
}.
echo ho!. 


echo := Tişt nû.
echo gava: ['bersiv-bide:û:'] bike: { :sound :x
	{ Derketin binivîse: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Tişt nû.
echo gava: ['bersiv-bide:û:û:'] bike: { :operation :sound :x
	{ Derketin binivîse: sound. } × x.
}.
echo shout: ['la'] times: 4. 


