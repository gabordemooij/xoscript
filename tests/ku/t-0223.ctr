>> x := Kêlî nû.
x herêma-demê: ['CEST'],
sal:2017,
meh:01,
roj:10,
saet: 10,
deqe: 0,
çirke: 0.

Derketin binivîse: x, rêza-nû.

Derketin binivîse: x dem, rêza-nû.

x zêde-bike: 1 çirke.
x zêde-bike: 2 deqe.
x zêde-bike: 3 saet.
x zêde-bike: 4 roj.
x zêde-bike: 1 meh.
x zêde-bike: 6 sal.

Derketin binivîse: x, rêza-nû.

x kêm-bike: 1 çirke.
x kêm-bike: 2 deqe.
x kêm-bike: 3 saet.
x kêm-bike: 4 roj.
x kêm-bike: 1 meh.
x kêm-bike: 6 sal.

Derketin binivîse: x, rêza-nû.

>> y := x kopî-bike.
>> z := x.

Derketin binivîse: y, rêza-nû.
Derketin binivîse: z, rêza-nû.
Derketin binivîse: (x herêma-demê = y herêma-demê), rêza-nû.
Derketin binivîse: (x dem = y dem), rêza-nû.
Derketin binivîse: (x = z), rêza-nû.
Derketin binivîse: x roja-salê, rêza-nû.
Derketin binivîse: x roja-hefteyê, rêza-nû.
Derketin binivîse: x hefte, rêza-nû.
