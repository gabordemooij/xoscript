# edge cases from a request must give an error or a result, not a crash
Server init.

Derketin binivîse: ['<'] + (['abc'] ji: 0 dirêjî: 0, tîpên-mezin) + ['>'], rêza-nû.
Derketin binivîse: ['<'] + (['abc'] ji: 0 dirêjî: 0, tîpên-biçûk) + ['>'], rêza-nû.
Derketin binivîse: ['<'] + (['abc'] derbas-bike: 3, tîpên-mezin) + ['>'], rêza-nû.
Derketin binivîse: [''] tîpên-mezin bytes, rêza-nû.
Derketin binivîse: ['aB'] tîpên-mezin, rêza-nû.
Derketin binivîse: ['aB'] tîpên-biçûk, rêza-nû.

Derketin binivîse: (Kêlî nû: 0) sal, rêza-nû.
{ Kêlî nû: ['9e300'] hejmar. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
{ Kêlî nû: ['-9e300'] hejmar. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
{ Kêlî nû: ['nan'] hejmar. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
{ Kêlî nû: 9000000000000000000. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
