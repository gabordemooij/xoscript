


Bername rêveberiya-bîrê: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Rast.
>> a := Lîste ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername paqij-bike.
usedMemory1 := (Bername bîr ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 5.

Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 4.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).




x := 3.
y := ['Hello'].
q := { ['Empty']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 5.


Bername paqij-bike.
usedMemory4 := (Bername bîr ? 0).





x := 4.
y := ['Hello'].
q := { ['Empty']. }.
p := Rast.
a := Lîste ← 1 ; 2 ; 3 ; 4.

Bername paqij-bike.
>> usedMemory5 := (Bername bîr ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) rast: {
	Derketin binivîse: ['Memory usage remains stable.'], rêza-nû.
}, wekî-din: {
	Derketin binivîse: ['Used memory not stable.'], rêza-nû.
	Derketin binivîse: usedMemory1, rêza-nû.
	Derketin binivîse: usedMemory2, rêza-nû.
	Derketin binivîse: usedMemory3, rêza-nû.
	Derketin binivîse: usedMemory4, rêza-nû.
	Derketin binivîse: usedMemory5, rêza-nû.
}.
