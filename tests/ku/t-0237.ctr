
Nivîs gava: ['evaluate'] bike: {
	>> kod := Pel nû: ['/tmp/eval.ctr'].
	kod binivîse: (xwe nivîs + ['.']).
	Bername bi-kar-bîne: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ferheng nû)
	deyne: ['Hi There'] li: ['two'],
	deyne: (Lîste ← ['hello'] ; ['world'] ; (Lîste ← 1 ; 2; 9) ; Şaş) li: ['one'],
	deyne: ( (Ferheng nû) deyne: ['wrrld'] li: ['misspelled'] ) li: ['three'],
	deyne: (Lîste ← ((Ferheng nû) deyne: ['treasure'] li: ['hidden']) ; 2) li: ['four']. 
>> str := map nivîs.
>> map2 := Tune.
(['map2 := '] + str ) evaluate.
Derketin binivîse: map2 ? ['one'] ? 0.
Derketin binivîse: map2 ? ['one'] ? 1.
Derketin binivîse: map2 ? ['four'] ? 0 ? ['hidden'].
Derketin binivîse: map2 ? ['one'] ? 2 ? 2.
