Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :num
	xweyî num := num. 
}.

a gava: ['item'] bike: { <- xweyî num.
}.

a item: 123.

Derketin binivîse: a item, rêza-nû.

>> old-num-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-num-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.

Derketin binivîse: b item, rêza-nû.
