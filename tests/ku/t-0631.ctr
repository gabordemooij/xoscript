#ffi test


Server init.

Bername rêveberiya-bîrê: 4.

# for this test you need set a path to libc (puts)
>> libname := Bername mîheng: ['FFITESTLIB'].



Server girêbide: (
 Lîste nû ;
 libname ;
 ['puts'] ;
 ( Lîste nû ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s azad-bike.

# test with struct

>> a := Blob nû: 8.
a bytes: (
	Lîste <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lîste <<: ['int'], ; ['int']).

Server girêbide: (
	Lîste <<: ['@structtest'], ;
	['@structtest'] ;
	(Lîste <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Derketin binivîse: ['Sum test:'] + (ffitest ffisum: a), rêza-nû.

struct azad-bike-struct.
struct azad-bike.
a azad-bike.
