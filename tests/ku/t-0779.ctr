Derketin binivîse: ['Test object'], rêza-nû.
>> p := Rê /tmp.
Derketin binivîse: p, rêza-nû.
>> old-p-address := p prototîp navnîşana-bîrê.
p save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
(b prototîp navnîşana-bîrê = old-p-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
Derketin binivîse: b, rêza-nû.
