Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :fmt
	xweyî fmt := fmt. 
}.

a gava: ['item'] bike: { <- xweyî fmt.
}.

a item: ( Format nû: ['|%s|'] ).

Derketin binivîse: a item, rêza-nû.

>> old-fmt-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-fmt-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.

Derketin binivîse: ( b item bisepîne: ['hello'] ), rêza-nû.
