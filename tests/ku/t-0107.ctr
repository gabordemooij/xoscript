
Derketin binivîse: ['Break for-loop, 0-4.'], rêza-nû.
{ :i
	Derketin binivîse: ['iteration #'] + i, rêza-nû.
	(i = 4) bibire.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Derketin binivîse: ['Break while-true loop, 0-4.'], rêza-nû.
{
	Derketin binivîse: ['iteration #'] + x, rêza-nû.
	x zêde-bike: 1.
	((x < 5) ne) bibire.
} heta-ku: xIsLessThan10.

Derketin binivîse: ['Break while-false loop, 5,4.'], rêza-nû.
{
	Derketin binivîse: ['iteration #'] + x, rêza-nû.
	x kêm-bike: 1.
	(x = 3) bibire.
} heta-ku: { <- (x > 0). }.

Derketin binivîse: ['Break times loop, 1-4.'], rêza-nû.
{ :i
	Derketin binivîse: ['iteration #'] + i, rêza-nû.
	(i = 4) bibire.
} × 5.

Derketin binivîse: ['Break block, dont print line.'], rêza-nû.
{ Rast bibire. Derketin binivîse: ['dont write this!'], rêza-nû. } bide-destpêkirin.

Derketin binivîse: ['Break block, dont fire catch...'], rêza-nû.
{ Rast bibire. Derketin binivîse: ['dont write this!'], rêza-nû. } bigire: { Derketin binivîse: ['Dont catch this!']. }, bide-destpêkirin.

Derketin binivîse: ['Test Array each-loop: 0,1'], rêza-nû.
(Lîste ← 1 ; 2 ; 3) her-yekî-biguherîne: { :i
	Derketin binivîse: ['iteration #'] + i, rêza-nû.
	(i = 1) bibire.
}.

Derketin binivîse: ['Test Map each-loop: c only'], rêza-nû.
>> m := Ferheng nû.
m deyne: ['first'] li: ['a'], deyne: ['second'] li: ['b'], deyne: ['third'] li: ['c'].
m her-yek: { :k :v
	Derketin binivîse: ['iteration'] + v + k, rêza-nû.
	Rast bibire.
}.

