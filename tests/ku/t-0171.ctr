

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

>> a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666.
a bike ya-dawî-derxe ya-yekem-derxe li-destpêkê-zêde-bike: ['hi'], li-dawiyê-zêde-bike: 999, qediya.
Derketin binivîse: ( a bigihîne-hev: [','] ), rêza-nû.

Bername paqij-bike.
usedMemory1 := (Bername bîr ? 0).


a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666.
a ya-dawî-derxe. a ya-yekem-derxe. a li-destpêkê-zêde-bike: ['hi'], li-dawiyê-zêde-bike: 999.
