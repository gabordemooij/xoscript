>> t := Tune.

# you can control the time zone for
# parsing like this:
Kêlî herêma-demê: ['CET'].
t := Kêlî çavkanî: ['1981-02-03 04:05:06'].
Derketin binivîse: t, rêza-nû.

# now using CEST time zone:
Kêlî herêma-demê: ['CEST'].
t := Kêlî çavkanî: ['1981-02-03 04:05:06'].
Derketin binivîse: t, rêza-nû.

# error if string cannot be parsed
{ Kêlî çavkanî: ['1900']. } bigire: { Tune. }, bide-destpêkirin.
