
>> Size := Tişt nû.
Size gava: ['is:'] bike: { :hejmar
	hejmar gava: ['+'] bike: { :hejmar
		>> unit := hejmar yekîneya-hejmarê.
		>> factor := 1.
		
		unit
		rewş: ['inch'] bike: { factor := 0.0833. }. <- xwe + (hejmar * factor).
	}. <- hejmar.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Derketin binivîse: plank + edge, rêza-nû.
