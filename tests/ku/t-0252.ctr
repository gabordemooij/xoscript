#Linux
>> clock := Kêlî nû.
clock herêma-demê: ['UTC-1'].
clock sal: 1981, meh: 1, roj: 5,
      saet: 13, deqe: 15, çirke: 13.

Derketin binivîse: clock, rêza-nû.
clock herêma-demê: ['UTC+0'].

Derketin binivîse: (
	(clock sal sade) + ['-'] + (clock meh) + ['-'] + (clock roj) + [' '] +
	(clock saet) + [':'] + (clock deqe) + [':'] + (clock çirke) + [' '] +
	['W'] + (clock hefte) + (clock herêma-demê)
), rêza-nû.


clock herêma-demê: ['UTC-1'].
Derketin binivîse: (
	(clock sal sade) + ['-'] + (clock meh) + ['-'] + (clock roj) + [' '] +
	(clock saet) + [':'] + (clock deqe) + [':'] + (clock çirke) + [' '] +
	['W'] + (clock hefte) + (clock herêma-demê)
), rêza-nû.
