Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :dict
	xweyî dict := dict. 
}.

a gava: ['item'] bike: { <- xweyî dict.
}.

a item: (
Ferheng nû
	hello: ['world'],
	world: (Ferheng nû deyne: ['a'] li: ['b'])).

Derketin binivîse: a item, rêza-nû.

>> old-dict-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-dict-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.

Derketin binivîse: b item, rêza-nû.
