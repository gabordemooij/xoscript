Server init.

>> DB := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

{
	DB lêpirsîn:
	['DROP TABLE movies'],
	bixebitîne.
} bigire: { Tune. }, bide-destpêkirin.

DB lêpirsîn:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
bixebitîne.

DB lêpirsîn: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametre: ( Lîste nû ; ['Halloween'] ),
bixebitîne.

DB lêpirsîn: ['SELECT * FROM movies'],
bîne: { :movie
	Derketin binivîse: movie title, rêza-nû.
}.

