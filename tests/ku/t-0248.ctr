

Nivîs gava: ['evaluate'] bike: {
	>> kod := Pel nû: ['/tmp/eval.ctr'].
	kod binivîse: xwe nivîs + ['.'].
	Bername bi-kar-bîne: ['/tmp/eval.ctr'].
}.

>> a := (Lîste ← (
	(Ferheng nû)
		deyne: ['domain'] li: ['mywebsite.com'],
		deyne: (Lîste ←
			((Ferheng nû)
				deyne: ['home'] li: ['title'],
				deyne: ['<html></html>'] li: ['body'],
				deyne: ['2017-01-01'] li: ['created']
			) ;
			((Ferheng nû)
				deyne: ['aboutus(c)'] li: ['title'],
				deyne: ['<credits>Author Inc.</credits>'] li: ['body']
			)
		) li: ['pages']
	)
) nivîs.

Derketin binivîse: a cure, rêza-nû.
Derketin binivîse: a, rêza-nû.

>> b := Tune.
(['b := '] + a) evaluate.
Derketin binivîse: b ? 0 ? ['pages'] ? 1 ? ['body'], rêza-nû.

>> c := b ? 0.
>> d := c nivîs.
Derketin binivîse: d cure, rêza-nû.

>> e := Tune.
(['e := '] + d) evaluate.
Derketin binivîse: e ? ['pages'] ? 0, rêza-nû.
