>> Point := Tişt nû.
Point gava: ['x-coordinate:'] bike: { :x xweyî x := x. }.
Point gava: ['y-coordinate:'] bike: { :y xweyî y := y. }.
Point gava: ['x-coordinate']  bike: { <- xweyî x kopî-bike. }.
Point gava: ['y-coordinate']  bike: { <- xweyî y kopî-bike. }.

Point gava: ['='] bike: { :other <- ( xweyî x = other x-coordinate
		 û: xweyî y = other y-coordinate ).
}.

>> pier := Point nû x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nû x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nû x-coordinate: 5, y-coordinate: 6.

Derketin binivîse: pier = town-hall, rêza-nû.
Derketin binivîse: pier = restaurant, rêza-nû.
