>> Grandfather := Tişt nû.
Grandfather gava: ['greet'] bike: {
	Derketin binivîse: ['Ave!'], rêza-nû.
}.
>> Father := Grandfather nû.
Father gava: ['greet'] bike: {
	Derketin binivîse: ['Hello'], rêza-nû.
	xwe greet.
}.
>> Son := Father nû.
Son gava: ['greet'] bike: {
	Derketin binivîse: ['Hi'], rêza-nû.
	xwe greet.
}.

Son greet.

>> Roundabout := Tişt nû.
Roundabout gava: ['circle:'] bike: { :x
	Derketin binivîse: x, rêza-nû.
	(x < 3) rast: { xwe xwe-bangker circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) rast: { Derketin binivîse: x, rêza-nû. x zêde-bike: 1.  increment bide-destpêkirin. }. }.
increment bide-destpêkirin.