# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nû: 8, bytes: (
	Lîste nû ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Derketin binivîse: ( utf16 kodê-veke: ['utf16le'] ), rêza-nû.

utf16 azad-bike.
>> utf32 := Blob nû: 13, bytes: (
	Lîste nû ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Derketin binivîse: ( utf32 kodê-veke: ['utf32be'] ), rêza-nû.
utf32 azad-bike.