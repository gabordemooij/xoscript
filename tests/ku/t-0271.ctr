
Bername rêveberiya-bîrê: 1.
Bername bîr: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> kod := [''].
	>> x := Hejmar di-navbera: 1 û: 10.
	{
		>> y := Hejmar di-navbera: 1 û: (tokens dirêjî).
		kod li-dawiyê-zêde-bike: (tokens tîp: y).
	} × x.
	{ Fonksiyon nû: kod. } bigire: { ['Empty']. }, bide-destpêkirin.

} × 10000.
Derketin binivîse: ['OK'], rêza-nû.
