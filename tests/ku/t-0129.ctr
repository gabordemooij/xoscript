
Lîste gava: ['product'] bike: {
	>> total := 1.
	xwe her-yek: { :index :element
		total carî: element.
	}. <- total.
}.

>> a := Lîste ← 1 ; 2 ; 3.
Derketin binivîse: a product, rêza-nû.
Derketin binivîse: (Lîste ← 2 ; 4 ; 8) product, rêza-nû. 
Derketin binivîse: (Lîste ← -2 ; 10) product, rêza-nû. 
Derketin binivîse: (Lîste ← 0.5 ; -2) product, rêza-nû. 
