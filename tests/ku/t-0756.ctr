Derketin binivîse: ['Test object'], rêza-nû.
>> greeter := Tişt nû.
greeter gava: ['name:'] bike: { :nav
	xweyî xname := nav. 
}.
greeter gava: ['greet'] bike: {
	Derketin binivîse: ['Hello '] + xweyî xname, rêza-nû.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
>> c := Tişt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
