# test list operations


>> cakes := Lîste ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes biguherîne: 1 dirêjî: 2 bi: ( Lîste ← ['cinnamon'] ; ['pineapple'] ).
Derketin binivîse: (buy bigihîne-hev: [',']), rêza-nû.


>> buy := cakes biguherîne: 1 dirêjî: 12 bi: ( Lîste ← ['cinnamon'] ; ['pineapple'] ).
Derketin binivîse: (buy bigihîne-hev: [',']), rêza-nû.


>> buy := cakes biguherîne: 2 dirêjî: 10 bi: ( Lîste nû ).
Derketin binivîse: (buy bigihîne-hev: [',']), rêza-nû.


>> buy := cakes biguherîne: 0 dirêjî: 1 bi: ( Lîste nû ).
Derketin binivîse: (buy bigihîne-hev: [',']), rêza-nû.


>> buy := cakes biguherîne: ['0'] dirêjî: ['1'] bi: ['x'].
Derketin binivîse: (buy bigihîne-hev: [',']), rêza-nû.
