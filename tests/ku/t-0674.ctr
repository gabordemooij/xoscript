# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> riya-pelê := ['/tmp/dat.csv'].
>> csv := Pel nû: riya-pelê.
csv binivîse: s.

# accepts CRLF LF CR, varying row length
csv veqetîner: [';'] dunik: ['"'] rêzan: { :line
	Bername paqij-bike.
	Derketin binivîse: line, rêza-nû.
	Bername paqij-bike.
}.

# unequal lines
s li-dawiyê-zêde-bike: ['\njustone'].
csv binivîse: s.
{
	csv veqetîner: [';'] dunik: ['"'] rêzan: { :line
		Derketin binivîse: line, rêza-nû.
	}.
} bigire: { :e 
	Derketin binivîse: e, rêza-nû.
}, bide-destpêkirin.

# invalid format
s := ['"he"llo";world'].
csv binivîse: s.
{
	csv veqetîner: [';'] dunik: ['"'] rêzan: { :line
		Derketin binivîse: line, rêza-nû.
	}.
} bigire: { :e 
	Derketin binivîse: e, rêza-nû.
}, bide-destpêkirin.
