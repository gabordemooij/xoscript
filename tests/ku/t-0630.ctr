#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Qalib nû: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern lihevhatin: subject bike: { :m :x
	Derketin binivîse: m, rêza-nû.
	Derketin binivîse: x, rêza-nû. <- ['XXX'].
}.
Derketin binivîse: result, rêza-nû.