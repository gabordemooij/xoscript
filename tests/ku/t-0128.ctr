
Lîste gava: ['sum'] bike: {
	>> total := 0.
	xwe her-yek: { :index :element
		total zêde-bike: element.
	}. <- total.
}.

>> a := Lîste ← 9 ; 8 ; 7.
Derketin binivîse: (a sum), rêza-nû. 
>> a := Lîste ← 1 ; 9.
Derketin binivîse: (a sum), rêza-nû. 
>> a := Lîste ← ['o'] ; 2.
Derketin binivîse: (a sum), rêza-nû. 
Derketin binivîse: (Lîste nû sum), rêza-nû. 
