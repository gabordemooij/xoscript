



>> CoffeeGrounds := Tişt nû.
CoffeeGrounds gava: ['extract'] bike: { <- ['coffee']. }.

>> CoffeeMachine := Tişt nû.
CoffeeMachine gava: ['init'] bike: {
	xweyî coffeegrounds := CoffeeGrounds nû.
}.
CoffeeMachine gava: ['nû'] bike: { <- CoffeeMachine `new init.
}.

CoffeeMachine gava: ['makeTea'] bike: { <- (xweyî tealeaves extract). }.
CoffeeMachine gava: ['makeCoffee'] bike: { <- (xweyî coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nû.

Derketin binivîse:
	coffeeDream 
	makeCoffee.

Derketin binivîse:
	coffeeDream 
	makeTea.
