
>> city := Lîste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lîste ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature li-gorî: city.
>> cities := weather kilîtan rêz-bike: { :a :b <- (a bide-ber-hev: b). }.
>> temperatures := weather nirx rêz-bike: { :a :b <- (a bide-ber-hev: b) neyînî?. }.

Derketin binivîse: (cities bigihîne-hev: [',']), rêza-nû.
Derketin binivîse: (temperatures bigihîne-hev: [',']), rêza-nû.
