>> Greeter := Tişt nû.
Greeter gava: ['make'] bike: {
	>> greeter := Tişt nû.
	greeter gava: ['name:'] bike: { :nav
		Derketin binivîse: ['setting a name'].
		xweyî myName := nav.
	}.
	greeter gava: ['performGreeting'] bike: {
		Derketin binivîse: ['Hello'].
		Derketin binivîse: xweyî myName.
	}.
	greeter gava: ['greet'] bike: {
		xwe performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
