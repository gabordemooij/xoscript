# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Qalib nû: pattern.
	p lihevhatin: subject bike: { :m :g
		Derketin binivîse: g hejmara-tiştan, binivîse: [' '], binivîse: (g bigihîne-hev: ['|']), rêza-nû. <- m.
	}.
}.
show bisepîne: ['(a)|(b)'] û: ['b'].
show bisepîne: ['(a)|(b)'] û: ['a'].
show bisepîne: ['(x)?y'] û: ['y'].
show bisepîne: ['(x)?(y)(z)?'] û: ['xy'].
