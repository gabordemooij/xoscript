>> a := Lîste ← Tişt ; Rast ; Şaş ; Mantiqî ; 1 ; Hejmar ; ['Str'] ; Nivîs ; { ['Empty']. }.
Derketin binivîse: (a hejmara-tiştan), rêza-nû.
{ :i
	Derketin binivîse: 
	['a '] + 
	((a ? i) cure) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tune?) ev: [''] an-ew: ['NOT']) + 
	[' Nil.'],
	rêza-nû.
} × (a hejmara-tiştan).
Derketin binivîse: ['but.. Nil is.. '] + ((Tune Tune?) ev: ['certainly NIL!'] an-ew: ['not NIL??']), rêza-nû.