>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Tune.
>> q := Tişt nû.
>> p := q.
(a heman: a) rast: { Derketin binivîse: ['Y1']. }.
(a heman: b) rast: { Derketin binivîse: ['Y2']. }.
(a heman: c) rast: { Derketin binivîse: ['Y3']. }.
(a heman: z) rast: { Derketin binivîse: ['Y4']. }.
(z heman: a) rast: { Derketin binivîse: ['Y5']. }.
(q heman: q) rast: { Derketin binivîse: ['Y6']. }.
(p heman: q) rast: { Derketin binivîse: ['Y7']. }.
(p heman: a) rast: { Derketin binivîse: ['Y8']. }.
(p heman: Tune) rast: { Derketin binivîse: ['Y9']. }.
