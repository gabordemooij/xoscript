
Server init.
>> rq := Daxwaza-HTTP nû.
Derketin binivîse: ['HTTP-GET d[]=']  + ( rq get-lîste: ['d[]'] ), rêza-nû. # GET
Derketin binivîse: ['HTTP-GET f[]=']  + ( rq get-lîste: ['f[]'] ), rêza-nû. # GET
Derketin binivîse: ['HTTP-POST e[]='] + ( rq post-lîste: ['e[]'] ), rêza-nû. # GET
Derketin binivîse: ['HTTP-POST c=']   + ( rq post: ['c'] ), rêza-nû. # GET
Derketin binivîse: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), rêza-nû. # GET
