Server init.

# write a test file
>> f := Pel nû: ['/tmp/test.gif'].
f binivîse: ['GIF87a01234567810'].

# serve the file
Server derbasî-bike: ['test.gif'] pêşgir: ['/tmp/'].

Derketin rêza-nû.

Derketin binivîse: ['Outside container (security):'], rêza-nû.
{ Server derbasî-bike: ['../passwd'] pêşgir: ['/tmp/']. }
bigire: { :e Derketin binivîse: e, rêza-nû. },
bide-destpêkirin.

Derketin binivîse: ['Invalid prefix:'], rêza-nû.
{ Server derbasî-bike: ['test.gif'] pêşgir: ['z:\\']. }
bigire: { :e Derketin binivîse: e, rêza-nû. },
bide-destpêkirin.

Derketin binivîse: ['Non-existant file:'], rêza-nû.
{ Server derbasî-bike: ['xxx.xxx'] pêşgir: ['/tmp/']. }
bigire: { :e Derketin binivîse: e, rêza-nû. },
bide-destpêkirin.
