# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Qasa 
	haşa-şîfreyê: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Qasa 
	haşa-şîfreyê: hash piştrast-bike: a1.
	# fail 
>> b := Qasa
	haşa-şîfreyê: hash piştrast-bike: a2.
	# ok!

Derketin binivîse: a, rêza-nû.
Derketin binivîse: b, rêza-nû.

