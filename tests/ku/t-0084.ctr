>> makeAdder := { :x
	>> f := { :y <- (xweyî x + y). } saz-bike: ['x'] nirx: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i xweyî q deyne: (xweyî f bisepîne: (xweyî q ? i)) li: i. } 
	saz-bike: ['q'] nirx: array,
	saz-bike: ['f'] nirx: func.
	{ :i mapping bisepîne: i. } × (array hejmara-tiştan).
}.

>> a := Lîste ← 1; 2; 3.
mapper bisepîne: a û: (makeAdder bisepîne: 100).
Derketin binivîse: (a cih: 0), rêza-nû.
Derketin binivîse: (a ? 1), rêza-nû.
Derketin binivîse: (a ? 2), rêza-nû.
