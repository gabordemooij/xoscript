Bername rêveberiya-bîrê: 0.
Lîste gava: ['sum'] bike: {
	>> total := 0.
	xwe her-yek: { :index :element
		total zêde-bike: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Pel nû: ['/tmp/test.txt'].
f binivîse: ['Lorem Ipsum'].
f bigire-girêdanê.
  

f := Pel nû: ['/tmp/test.txt'].
>> text := f bixwîne.
f bigire-girêdanê.



