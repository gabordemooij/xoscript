


>> Deck := Lîste nû.
Deck gava: ['print'] bike: {
        >> len := xwe hejmara-tiştan - 1.
        { :i
                >> len2 := xwe hejmara-tiştan - 1.
                Derketin binivîse: ['len: '].
                Derketin binivîse: len, rêza-nû.
                Derketin binivîse: ['len2: '].
                Derketin binivîse: len2, rêza-nû.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
