

Bername paqij-bike.


>> Veggy := Tişt nû.
Veggy gava: ['nû'] bike: {
	>> v := xwe nû.
	v init. <- v.
}.

Veggy gava: ['init'] bike: { xweyî veggies := 0. }.

Veggy gava: ['carrots:'] bike: { :a xweyî veggies := a. <- Tune. }.
Veggy gava: ['carrots'] bike: { <- xweyî veggies. }.
Veggy gava: ['+'] bike: { :f
	>> n := Veggy nû.
	n carrots: (f carrots + xweyî veggies). <- n.
}.

Veggy gava: ['nivîs'] bike: { <- xweyî veggies nivîs.
}.

Hejmar gava: ['carrots'] bike: {
	>> x := Veggy nû.
	x carrots: xwe. <- x.
}.

Hejmar gava: ['add:and:'] bike: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Derketin binivîse: q, rêza-nû.
