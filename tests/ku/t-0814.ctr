# session cookie format, json content type, web protocols only, svg shown inline
Server amade-bike.
Bername bi-kar-bîne: ['../../../src/xo/ku/webtools.xo'].

>> Fake-Request := Tişt nû.
Fake-Request gava: ['value:'] bike: { :buha
	xweyî buha := buha.
}.
Fake-Request gava: ['cookie:'] bike: { :nav <- xweyî buha.
}.

>> Test-Session := Danişîna-pela-demkî nû.
Test-Session gava: ['bar-bike'] bike: { <- Ferheng nû.
}.
Test-Session gava: ['session-id'] bike: { <- xweyî id.
}.

>> cookies := Lîste nû
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies her-yek: { :i :cookie
	>> daxwaz-http := Fake-Request nû.
	daxwaz-http value: cookie.
	>> rêvebir := Test-Session nû.
	>> web := Belgeya-Webê nû.
	web daxwaz-http: daxwaz-http.
	web rêveberê-danişînan: rêvebir.
	web danişînê-dest-pê-bike.
	Derketin binivîse: ( rêvebir session-id = cookie ), rêza-nû.
}.

>> web := Belgeya-Webê nû.
web json: (Ferheng nû deyne: ['b'] li: ['a']).
Derketin binivîse: ['\n'], rêza-nû.

{ Tor get: ['file:///etc/hostname']. } bigire: { :e
	Derketin binivîse: e, rêza-nû.
}, bide-destpêkirin.

>> svg := Pel nû: ['/tmp/test0814.svg'].
svg binivîse: ['<svg xmlns="x"></svg>'].
Derketin rêza-nû.
Server derbasî-bike: ['test0814.svg'] pêşgir: ['/tmp/'].
svg jê-bibe.
