>> message := ['Bye'].
>> Secret := Tişt nû.
Secret gava: ['ceribandin'] bike: {
	>> message := ['Hello'].
	xweyî message := ['World'].
	Derketin binivîse: message + [' '] + xweyî message, rêza-nû.
