
Server init.
Derketin binivîse: ['Database test'], rêza-nû.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'], 
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê :=
db lêpirsîn: ['SELECT UNHEX('CAFE') AS blobby'],
bîne: { :row
	Derketin binivîse: ( row blobby ji: 0 dirêjî: 2 ), rêza-nû.
	row blobby azad-bike.
}.
