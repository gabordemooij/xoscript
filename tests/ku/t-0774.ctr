Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 
a gava: ['item:'] bike: { :lst
	xweyî lst := lst. 
}.
a gava: ['item'] bike: { <- xweyî lst.
}.
a item: (
	Lîste nû ; 1 ; (
		Lîste nû ; ['a'] ; (
			Lîste nû ; ( Kêlî nû: 1 )
		) ; ( Int64 ji-nivîsê: ['321'] )
	)
).
Derketin binivîse: a item, rêza-nû.
>> old-lst-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
(b item prototîp navnîşana-bîrê = old-lst-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
Derketin binivîse: ( b item ), rêza-nû.
