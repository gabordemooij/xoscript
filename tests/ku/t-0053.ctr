60 × {
	>> x := (Hejmar random % 6) + 1.
	(x ≤ 6) şaş: { Derketin binivîse: ['FAIL']. }.
	(x ≥0) şaş: { Derketin binivîse: ['FAIL']. }.
	x := (Hejmar random % 3) + 1.
	(x < 3) şaş: { Derketin binivîse: ['FAIL']. }.
	(x>-1) şaş: { Derketin binivîse: ['FAIL']. }.
	x := ((Mantiqî flip) hejmar).
	(x = 0 an: x = 1) şaş: { Derketin binivîse: ['FAIL']. }.
	x := ((Rast flip) hejmar).
	(x = 0 an: x = 1) şaş: { Derketin binivîse: ['FAIL']. }.
	x := (Mantiqî flip ev: ['HEAD'] an-ew: ['TAIL']).
	((x = ['HEAD']) an: (x = ['TAIL'])) şaş: { Derketin binivîse: ['FAIL']. }.
}.
Derketin binivîse: ['DONE'].

