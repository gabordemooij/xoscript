# catch-all test (practical)
>> HTML := Nivîs nû.
HTML gava: ['encode:'] bike: { :tekst
	xwe li-dawiyê-zêde-bike: (tekst
	biguherîne: ['&'] bi: ['&amp;'], 
	biguherîne: ['<'] bi: ['&lt;'],
	biguherîne: ['>'] bi: ['&gt;'],
	biguherîne: ['"'] bi: ['&quot;']).
}.
>> blog := HTML nû.
blog li-dawiyê-zêde-bike: ['<h1>'],
     encode: ['Koffie & Thee'],
     li-dawiyê-zêde-bike: ['</h1>'].
Derketin binivîse: blog, rêza-nû.


>> Roman := Hejmar nû.
Roman gava: ['stringy'] bike: {
	>> a := [''].
	{ a li-dawiyê-zêde-bike: ['I']. } × xwe. <- a.
}.

>> x := Roman nû.
x zêde-bike: 3.
Derketin binivîse: x stringy, rêza-nû.

>> Quantum := Mantiqî nû.
Quantum gava: ['true?'] bike: { <- ['maybe True']. }.
Derketin binivîse: (Quantum nû true?), rêza-nû.

>> Nihil := Tune nû.
Nihil gava: ['nivîs'] bike: { <- ['Nihil']. }.
Derketin binivîse: (Nihil nû), rêza-nû.
