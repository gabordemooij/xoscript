# test qualifiers

Bername paqij-bike.

>> Fruit := Tişt nû.
Fruit gava: ['nû'] bike: {
	>> f := xwe nû.
	f apples: 0. <- f.
}.
Fruit gava: ['apples:'] bike: { :a xweyî apples := a. }.
Fruit gava: ['apples'] bike: { <- xweyî apples. }.
Fruit gava: ['+'] bike: { :f
	>> n := Fruit nû.
	n apples: (f apples + xweyî apples). <- n.
}.
Hejmar gava: ['apples'] bike: { <- ((Fruit nû) apples: xwe).
}.

Fruit gava: ['nivîs'] bike: { <- xweyî apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Derketin binivîse: q, rêza-nû.




q := 3 apples + 4 apples.
Derketin binivîse: q, rêza-nû.



q := 3 apples + 4 apples.
Derketin binivîse: q, rêza-nû.


