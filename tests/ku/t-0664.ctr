# recursive interpolation not allowed

Derketin binivîse: 
['recursive string interolation enabled: '] + (
	Bername taybetmendî: 
	['RECURSIVE_STRINTPOL']
), rêza-nû.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Derketin binivîse: a, rêza-nû.


Bername taybetmendî: ['RECURSIVE_STRINTPOL'] çalak: Rast.

Derketin binivîse: 
['recursive string interpolation enabled: '] + (
	Bername taybetmendî: 
	['RECURSIVE_STRINTPOL']
), rêza-nû.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Derketin binivîse: a, rêza-nû.

Bername taybetmendî: ['RECURSIVE_STRINTPOL'] çalak: Şaş.

Derketin binivîse: 
['recursive string interpolation enabled: '] + (
	Bername taybetmendî: 
	['RECURSIVE_STRINTPOL']
), rêza-nû.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Derketin binivîse: a, rêza-nû.
