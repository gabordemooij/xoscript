['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Derketin binivîse: (x + y), rêza-nû.

>> x := 10040.07.
>> y := 10305.60.

Derketin binivîse: (x + y), rêza-nû.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Derketin binivîse: (x + y + z), rêza-nû.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Derketin binivîse: (x + y + z), rêza-nû.

>> q := 0.1.2.

Derketin binivîse: (q), rêza-nû.

>> q := 012.

Derketin binivîse: (q), rêza-nû.
