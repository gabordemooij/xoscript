>> t := Rast.
(t = Rast) rast: { Derketin binivîse: ['T']. }.
(t = Şaş) rast: { Derketin binivîse: ['F']. }.
Derketin binivîse: ['|'].
>> t := Şaş.
(t = Rast) rast: { Derketin binivîse: ['T']. }.
(t = Şaş) rast: { Derketin binivîse: ['F']. }.
Derketin binivîse: ['|'].
>> f := Rast.
(t = Rast û: f = Şaş) rast: { Derketin binivîse: ['T']. }.
(t = Şaş û: f = Rast) rast: { Derketin binivîse: ['F']. }.
Derketin binivîse: ['|'].
>> n := Tune.
(n Tune?) rast: { Derketin binivîse: ['T']. }.
(n Tune?) şaş: { Derketin binivîse: ['F']. }.
Derketin binivîse: ['|'].
(f Boolean?) rast: { Derketin binivîse: ['T']. }.
(f Boolean?) şaş: { Derketin binivîse: ['F']. }.



