>> items := Ferheng nû.
items deyne: ['green'] li: ['color-1'].
items deyne: ['orange'] li: ['color-2'].
items deyne: ['red'] li: ['color-3'].
>> i := 0.
>> s := [''].
items her-yek: { :key :color
	Derketin binivîse: ['color #'] + i + [' is: '] + color + [' '].
	i zêde-bike: 1.
}.
Derketin binivîse: i + [' colors!'].
