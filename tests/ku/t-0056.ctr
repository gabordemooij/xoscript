>> z := Tişt nû.
z gava: ['value:'] bike: { :v
	xweyî value := v. <- xwe.
}.
z gava: ['value'] bike: { <- xweyî value. }.
(z setValue: 1) value: 2.
Derketin binivîse: z value.
>> x := z.
Derketin binivîse: x value.
z := Tune.
Derketin binivîse: z value.
Derketin binivîse: x value.
Derketin binivîse: ['hello'].
Derketin binivîse: 3 + 2.
Derketin binivîse: (3 > 2).
