>> phrases := Lîste nû
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases her-yek: { :_ :phrase 
	>> e := Server base64-kod-bike: phrase.
	>> d := Server base64-kodê-veke: e.
	Derketin binivîse: (
		message kopî-bike ~encoded: e, ~decoded: d
	), rêza-nû.
}.
