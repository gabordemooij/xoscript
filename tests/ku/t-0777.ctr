#OBSD
>> dirname := [''].
{ dirname li-dawiyê-zêde-bike: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Bername pergal: command.
Bername chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename li-dawiyê-zêde-bike: ['YYYYYYYY']. } * 20.
Pel nû: filename, binivîse: ['sometext'].
{ Pel lîste: ['/tmp/'] + dirname. } * 1000.
Derketin binivîse: ['no crash'], rêza-nû.

