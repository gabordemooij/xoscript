

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

>> txt := ['Word Salad'].
Derketin binivîse: ['last index of ord = '] + (( txt cihê-dawî: ['ord'] ) - 0), rêza-nû.
Derketin binivîse: ['index of ord = '] + (( txt bibîne: ['ord'] ) - 0), rêza-nû.
Derketin binivîse: ['index of ad = '] + (( txt bibîne: ['ad'] ) - 0), rêza-nû.
Derketin binivîse: ['last index of W = '] + (( txt cihê-dawî: ['W'] ) - 0), rêza-nû.
Derketin binivîse: ['last index of d = '] + (( txt cihê-dawî: ['d'] ) - 0), rêza-nû.
Derketin binivîse: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), rêza-nû.
Derketin binivîse: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), rêza-nû.
Derketin binivîse: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), rêza-nû.
Derketin binivîse: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), rêza-nû.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


