Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :binhelper
	xweyî binhelper := binhelper. 
}.

a gava: ['item'] bike: { <- xweyî binhelper.
}.

a item: Bin nû.

>> old-binhelper-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-binhelper-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.


