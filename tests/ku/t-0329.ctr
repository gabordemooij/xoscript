Derketin binivîse: ((Lîste nû
	gava: ['plaque:'] bike: { :x xweyî o := x. },
	gava: ['plaque']  bike: { <- xweyî o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lîste ← 1)
	~ (Lîste ← 1 ; 2)
	~ (Lîste ← 1 ; 2 ; 3)
	~ (Lîste ← 1 ; 2 ; 3 ; 4)
	~ (Lîste ← 1 ; 2 ; 3 ; 4 ; 5)
) her-yek: { :i :el
	{ Derketin binivîse: ev-kar. } × el hejmara-tiştan.
	Derketin rêza-nû.
}) plaque, rêza-nû.


