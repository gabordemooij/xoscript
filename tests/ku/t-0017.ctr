Hejmar gava: ['factorial'] bike: {
	>> total := 1.
	{ :index total carî: (xwe - (index)). } × xwe. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Derketin binivîse: a.
>> b := 2 + 3 factorial.
Derketin binivîse: b.
>> c := 3 factorial + 2.
Derketin binivîse: c.
>> d := 2 + (3 factorial).
Derketin binivîse: d.
Derketin binivîse: 2 + 3 factorial + 1.
