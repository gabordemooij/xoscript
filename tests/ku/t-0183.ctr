

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

>> o := Tişt nû.
>> o2 := Tişt nû.
Derketin binivîse: o Tune?, rêza-nû.
Derketin binivîse: o cure, rêza-nû.
Derketin binivîse: ( o heman: o ), rêza-nû.
Derketin binivîse: ( o heman: o2 ), rêza-nû.
Derketin binivîse: o ez-bixwe, rêza-nû.
Derketin binivîse: ( o bike qediya ), rêza-nû.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


o := Tişt nû.
o2 := Tişt nû.
