

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

>> txt := ['1.6'].
>> n := txt hejmar.
>> t := txt mantiqî.
Derketin binivîse: n, rêza-nû.
Derketin binivîse: t, rêza-nû.
Derketin binivîse: n cure, rêza-nû.
Derketin binivîse: t cure, rêza-nû.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


txt := ['1.6'].
n := txt hejmar.
t := txt mantiqî.
Derketin binivîse: n, rêza-nû.
Derketin binivîse: t, rêza-nû.
Derketin binivîse: n cure, rêza-nû.
Derketin binivîse: t cure, rêza-nû.

Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).


txt := ['1.6'].
n := txt hejmar.
t := txt mantiqî.
Derketin binivîse: n, rêza-nû.
Derketin binivîse: t, rêza-nû.
Derketin binivîse: n cure, rêza-nû.
Derketin binivîse: t cure, rêza-nû.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
