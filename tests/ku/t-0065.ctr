Hejmar gava: ['factorial'] bike: {
	>> total := 1.
	{ :index total carî: (xwe - (index)). } × xwe. <- total.
}.
>> Printer := Tişt nû.
Printer gava: ['print:and:'] bike: { :x :y
	Derketin binivîse: ['a='] + x + [', b='] + y, rêza-nû.
}.
>> a := 4.5. >> b := a ber-bi-jêr-gilover.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ber-bi-jor-gilover.
Printer print: a and: b.
a := 4.5. b := a ber-bi-jêr-gilover.
Printer print: a and: b.
a := 4.5. b := a gilover-bike.
Printer print: a and: b.
a := 4.2. b := a gilover-bike.
Printer print: a and: b.

Derketin binivîse: (9 mayî: 5), rêza-nû.
Derketin binivîse: -666 nirxa-mutleq, rêza-nû.
Derketin binivîse: 49 koka-çargoşe, rêza-nû.
Derketin binivîse: (2 hêz: 3), rêza-nû.
>> l := (Lîste ← 9 ; 6).
Derketin binivîse: l herî-biçûk.

