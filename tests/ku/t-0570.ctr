#Linux

 >> t := Kêlî nû.
 
t herêma-demê: ['Europe/Amsterdam'].
t sal: 2020, meh: 8, roj: 2, saet: 21, deqe: 2, çirke: 1.

>> a := t saet.
>> ams := t herêma-demê.

t herêma-demê: ['US/Hawaii'].
>> b := t saet.
>> hw := t herêma-demê.

Derketin
binivîse: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ev: ['later'] an-ew: ['earlier']
	)
),
rêza-nû.
 