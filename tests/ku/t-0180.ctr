Nivîs gava: ['html'] bike: { <- (
		xwe
		biguherîne: ['&'] bi: ['&amp;'],
		biguherîne: ['<'] bi: ['&lt;'],
		biguherîne: ['>'] bi: ['&gt;'],
		biguherîne: ['''] bi: ['&apos;'],
		biguherîne: ['"'] bi: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Derketin binivîse: txt kopî-bike html, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-biçûk, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-mezin, rêza-nû.
} bide-destpêkirin.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Derketin binivîse: txt kopî-bike html, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-biçûk, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-mezin, rêza-nû.
} bide-destpêkirin.

Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Derketin binivîse: txt kopî-bike html, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-biçûk, rêza-nû.
Derketin binivîse: txt kopî-bike tîpên-mezin, rêza-nû.
} bide-destpêkirin.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
