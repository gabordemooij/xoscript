# test Program version

# this feature is disabled by default
Derketin binivîse: (
	Bername taybetmendî: 
	['RECURSIVE_STRINTPOL']
), rêza-nû.


# but if we set the time back
>> today := Kêlî 
herêma-demê: ['CEST'],
çavkanî: ['2026-02-15 10:00:00'].
Bername guherto: today.

# it will be enabled like it used to be (from now on)
Derketin binivîse: (
	Bername taybetmendî: 
	['RECURSIVE_STRINTPOL']
), rêza-nû.