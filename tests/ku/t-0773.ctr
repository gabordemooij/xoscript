Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 
a gava: ['item:'] bike: { :int64
	xweyî int64 := int64. 
}.
a gava: ['item'] bike: { <- xweyî int64.
}.
a item: ( Int64 ji-nivîsê: ['9999'] ).
Derketin binivîse: a item, rêza-nû.
>> old-int64-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.
>> b := Tişt load-from: ['/tmp/a.bin'].
(b item prototîp navnîşana-bîrê = old-int64-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
Derketin binivîse: ( b item ), rêza-nû.
