>> q := Lîste ← 1 ; 2 ; 3.
{ q ? ['1']. } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? Rast. } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? Şaş. } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? Tune. } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? (Lîste nû). } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? (Tişt nû). } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
{ q ? ({ ['Empty']. }). } bigire: { Derketin binivîse: ['caught!'], rêza-nû. }, bide-destpêkirin.
Derketin binivîse: ['caught them all'], rêza-nû.
