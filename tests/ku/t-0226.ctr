# Test ASCII variants

# Numbers

Derketin binivîse: (2 !=: 3), rêza-nû.
Derketin binivîse: (2 <=: 2), rêza-nû.
Derketin binivîse: (2 >=: 2), rêza-nû.

# Strings

Derketin binivîse: (['b'] >=: ['a']), rêza-nû.
Derketin binivîse: (['b'] !=: ['a']), rêza-nû.
Derketin binivîse: (['b'] <=: ['c']), rêza-nû.

# Bools

Derketin binivîse: (Rast !=: Şaş), rêza-nû.

# Objects

Derketin binivîse: (Tişt nû !=: Tişt nû), rêza-nû.

# ASCII list symbol <-:

Derketin binivîse: (Lîste <<: 1, ; 2 ; 3) hejmara-tiştan = 3, rêza-nû.

