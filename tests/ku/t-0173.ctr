

Lîste gava: ['sum'] bike: {
	>> total := 0.
	xwe her-yek: { :index :element
		total zêde-bike: element.
	}. <- total.
}.

Lîste gava: ['product'] bike: {
	>> total := 1.
	xwe her-yek: { :index :element
		total carî: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

{

>> a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666.
a := a + ( Lîste ← 1 ).
Derketin binivîse: ( ['sum: '] + ( a sum ) ), rêza-nû.
Derketin binivîse: ( ['min: '] + ( a herî-biçûk ) ), rêza-nû.
Derketin binivîse: ( ['max: '] + ( a herî-mezin ) ), rêza-nû.
Derketin binivîse: ( ['3rd: '] + ( a ? 2 ) ), rêza-nû.
Derketin binivîse: ( ['prd: '] + ( a product ) ), rêza-nû.
a rêz-bike: { :a :b <- (b - a). }.
a her-yek: { :i :e Derketin binivîse: ( i - 0 ), rêza-nû. }.

} bide-destpêkirin.

Bername paqij-bike.
usedMemory1 := (Bername bîr ? 0).


{

>> a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666.
a := a + ( Lîste ← 1 ).
Derketin binivîse: ( ['sum: '] + ( a sum ) ), rêza-nû.
Derketin binivîse: ( ['min: '] + ( a herî-biçûk ) ), rêza-nû.
Derketin binivîse: ( ['max: '] + ( a herî-mezin ) ), rêza-nû.
Derketin binivîse: ( ['3rd: '] + ( a ? 2 ) ), rêza-nû.
Derketin binivîse: ( ['prd: '] + ( a product ) ), rêza-nû.
a rêz-bike: { :a :b <- (b - a). }.
a her-yek: { :i :e Derketin binivîse: ( i - 0 ), rêza-nû. }.

} bide-destpêkirin.



Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).


{

>> a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666.
a := a + ( Lîste ← 1 ).
Derketin binivîse: ( ['sum: '] + ( a sum ) ), rêza-nû.
Derketin binivîse: ( ['min: '] + ( a herî-biçûk ) ), rêza-nû.
Derketin binivîse: ( ['max: '] + ( a herî-mezin ) ), rêza-nû.
Derketin binivîse: ( ['3rd: '] + ( a ? 2 ) ), rêza-nû.
Derketin binivîse: ( ['prd: '] + ( a product ) ), rêza-nû.
a rêz-bike: { :a :b <- (b - a). }.
a her-yek: { :i :e Derketin binivîse: ( i - 0 ), rêza-nû. }.

} bide-destpêkirin.



Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).

( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
