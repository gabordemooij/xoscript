

Nivîs gava: ['html'] bike: { <- (
		xwe
		biguherîne: ['&'] bi: ['&amp;'],
		biguherîne: ['<'] bi: ['&lt;'],
		biguherîne: ['>'] bi: ['&gt;'],
		biguherîne: ['"'] bi: ['&quot;']
	).
}.


Derketin binivîse: ([' left trimmed '] valahiyan-jêke) + [' '] + ( ['and right trimmed'] valahiyan-jêke) + ['!'], rêza-nû.
Derketin binivîse: ['<html>"html & entities"</html>'] html.
