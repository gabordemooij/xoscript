

Lîste gava: ['column:'] bike: { :column
	>> result := Lîste nû.
	xwe her-yek: { :index :row
		row her-yek: { :index :cell
			(index = column) rast: { result li-dawiyê-zêde-bike: cell. }.
		}.
	}. <- result.
}.


>> a := Lîste ←
	(Lîste ← 1 ; 2 ; 3) ;
	(Lîste ← 4 ; 5 ; 6) ;
	(Lîste ← 7 ; 8 ; 9).

>> b := a column: 1.
Derketin binivîse: b, rêza-nû.

b := a column: 20.
Derketin binivîse: b, rêza-nû.

b := a column: -100.
Derketin binivîse: b, rêza-nû.
