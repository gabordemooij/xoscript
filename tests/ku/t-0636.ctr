# test url parsing

Server init.
>> url := URL çavkanî: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Derketin binivîse: ['scheme = '] + url şema, rêza-nû.
Derketin binivîse: ['host = '] + url mêvandar, rêza-nû.
Derketin binivîse: ['port = '] + url dergeh, rêza-nû.
Derketin binivîse: ['path = '] + url riya-pelê, rêza-nû.
Derketin binivîse: ['query = '] + url parametreyên-lêgerînê, rêza-nû.
Derketin binivîse: ['fragment = '] + url perçe, rêza-nû.
