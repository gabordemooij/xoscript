Server init.

>> conn1 := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> conn2 := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.
#...
>> del := conn1 lêpirsîn: ['DELETE FROM book WHERE id > 0'].
{  del bixebitîne. conn1 piştrast-bike. } bigire: { :e conn1 vegerîne.  }, bide-destpêkirin.

>> insert := conn1 lêpirsîn: ['INSERT INTO book (id) VALUES(null)'].
insert bixebitîne.

>> hejmara-tiştan := conn1 lêpirsîn: ['SELECT COUNT(*) AS num FROM book'].
hejmara-tiştan bîne: { :row Derketin binivîse: row num, rêza-nû. }.

# does not show up
# insert not committed on connection 1
>> hejmara-tiştan := conn2 lêpirsîn: ['SELECT COUNT(*) AS num FROM book'].
hejmara-tiştan bîne: { :row Derketin binivîse: row num, rêza-nû. }.
