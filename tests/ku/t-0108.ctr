
(7 kit?) rast: { Derketin binivîse: ['7 is an ODD NUMBER'], rêza-nû. }, wekî-din: { Derketin binivîse: ['WRONG!']. }.
(4 cot?) rast: { Derketin binivîse: ['4 is an EVEN NUMBER'], rêza-nû. }, wekî-din: { Derketin binivîse: ['WRONG!']. }.
(5 cot?) rast: { Derketin binivîse: ['WRONG!']. }, wekî-din: { Derketin binivîse: ['5 is NOT AN EVEN NUMBER'], rêza-nû. }.
(6 kit?) rast: { Derketin binivîse: ['WRONG!']. }, wekî-din: { Derketin binivîse: ['6 is NOT AN ODD NUMBER'], rêza-nû. }.
