Server init.
Derketin binivîse: ['Database time test'], rêza-nû.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'], 
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê :=
db lêpirsîn: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
bîne: { :row
	Derketin binivîse: row timetest, rêza-nû.
}.
