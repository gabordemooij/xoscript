Hejmar gava: ['factorial'] bike: {
	>> total := 1.
	{ :index total carî: (xwe - index). } × xwe. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

{
2 exponent factorial.
Derketin binivîse: (11 mayî: 3), rêza-nû.
Derketin binivîse: (3.4 gilover-bike), rêza-nû.
Derketin binivîse: (7.1 ber-bi-jor-gilover), rêza-nû.
Derketin binivîse: (7.9 ber-bi-jêr-gilover), rêza-nû.
}
bide-destpêkirin.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).

