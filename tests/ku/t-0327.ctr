

Lîste gava: ['fixture:'] bike: { :f
	xweyî fixture := f.
}.

Lîste gava: ['hejmara-tiştan'] bike: { <- xweyî fixture.
}.

Lîste gava: ['aantal'] bike: { <- xweyî fixture.
}.


>> x := Tune.
{

	x := ['hello'] 
	biguherîne:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tîp: 2)
			)
		)
	bi: (
		(['...hal'] + ['lo']) 
			tîpên-mezin 
			lowecase 
			tîpên-mezin 
			derbas-bike: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lîste ← 0 ; 1 ; 4; 9 ; (Lîste ← 0 ; 3; 1) ; 4
							) berî-ya-dawî
						) ? 1
					) + 
					((Lîste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					hejmara-tiştan
				)
			)
	).

} × 10.
Derketin binivîse: x, rêza-nû.

