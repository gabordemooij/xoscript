# a quote that never closes must give an error, not an endless loop
>> riya-pelê := ['/tmp/test0821.csv'].
>> file := Pel nû: riya-pelê.

file binivîse: ['a,b\n"1,2\n'].
{
	file veqetîner: [','] dunik: ['"'] rêzan: { :line
		Derketin binivîse: line, rêza-nû.
	}.
} bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.

# a closed quote still works
file binivîse: ['a,b\n"1,2",3'].
file veqetîner: [','] dunik: ['"'] rêzan: { :line
	Derketin binivîse: line, rêza-nû.
}.
file jê-bibe.
