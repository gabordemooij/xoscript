# test catch-all methods
>> x13 := Tişt nû.
x13 gava: ['a'] bike: { :a Derketin binivîse: 0, rêza-nû. }.
x13 gava: ['a:'] bike: { :a Derketin binivîse: a, rêza-nû. <- 5. }.
x13 gava: ['a:b:'] bike: { :a :b Derketin binivîse: (a + b), rêza-nû. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
