


>> wine := Tişt nû.


wine gava: ['toString'] bike: { <- ['merlot'].
}.

wine gava: ['naarTekst'] bike: { <- ['merlot'].
}.


wine gava: ['='] bike: { :other wine <- ( xwe toString = other wine ).
}.

wine gava: ['=='] bike: { :other wine <- ( xwe toString = other wine ).
}.



wine
	rewş: ['cabernet'] bike: { Derketin binivîse: ['it's a Cabernet!']. },
	rewş: ['syrah']    bike: { Derketin binivîse: ['it's a Syrah!'].    },
	rewş: ['merlot']   bike: { Derketin binivîse: ['it's a Merlot!'].   },
	rewş: ['malbec']   bike: { Derketin binivîse: ['it's a Malbec!'].   }.

Derketin rêza-nû.
