

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Bername rêveberiya-bîrê: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt li-dawiyê-zêde-bike: ['!!'].
Derketin binivîse: txt.
} bide-destpêkirin.

Bername paqij-bike.

usedMemory1 := (Bername bîr ? 0).


{
>> txt := ['hello '] + ['world'].
