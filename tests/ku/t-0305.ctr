
Hejmar fêr-bibe: ['plus:'] wate: ['+'].
Hejmar gava: ['+'] bike: { :x
	>> rate := 1.
	>> currency := x yekîneya-hejmarê.
	(currency = ['euros']) rast: {
		rate := 2.
	}. <- (xwe plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars yekîne: ['dollars'].
euros yekîne: ['euros'].
>> money := dollars + euros.
Derketin binivîse: money, rêza-nû.
