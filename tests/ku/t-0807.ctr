# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> parametreyên-lêgerînê := db lêpirsîn: ['SELECT %% FROM'].
{ parametreyên-lêgerînê bixebitîne. } bigire: { :e
	Derketin binivîse: ( e dihewîne: ['%%'] ), rêza-nû.
}, bide-destpêkirin.
