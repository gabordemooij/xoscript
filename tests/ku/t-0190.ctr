#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.

{
Kêlî dem.
Kêlî bisekine: 1.
Derketin binivîse: Bername hejmara-argûmanan, rêza-nû.
Bername argûman: 0.
Hejmar random.
Derketin binivîse: (Bername pergal: ['echo 'Hello'']).
} bide-destpêkirin.

Bername paqij-bike.
usedMemory1 := (Bername bîr ? 0).

{
Kêlî dem.
Kêlî bisekine: 1.
Derketin binivîse: Bername hejmara-argûmanan, rêza-nû.
Bername argûman: 0.
Hejmar random.
Derketin binivîse: (Bername pergal: ['echo 'Hello'']).
} bide-destpêkirin.

Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).

{
Kêlî dem.
Kêlî bisekine: 1.
Derketin binivîse: Bername hejmara-argûmanan, rêza-nû.
Bername argûman: 0.
Hejmar random.
Derketin binivîse: (Bername pergal: ['echo 'Hello'']).
} bide-destpêkirin.

Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
