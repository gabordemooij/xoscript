{
	ev-kar şaşî: ['Dont fail.'].
	unknown doSomething.
} bigire: {
	Derketin binivîse: ['Caught!'].
}, bide-destpêkirin.

{
	ev-kar şaşî: ['Dont fail.'].
	xweyî unknown doSomething.
} bigire: {
	Derketin binivîse: ['Caught!'].
}, bide-destpêkirin.

{
	ev-kar şaşî: ['Dont fail.'].
	unknown := 122.
} bigire: {
	Derketin binivîse: ['Caught!'].
}, bide-destpêkirin.


{
	ev-kar şaşî: ['Dont fail.'].
	Rast bibire.
	Derketin binivîse: ['FAIL'].
} bigire: {
	Derketin binivîse: ['Caught!'].
}, bide-destpêkirin.

{
	{
		ev-kar şaşî: ['Dont fail.'].
		Rast bibire.
		Derketin binivîse: ['FAIL'].
	} bigire: { :x
		(x = ['Dont fail.']) rast: { ev-kar şaşî: ['Nested Caught!']. }.
	}, bide-destpêkirin.
} bigire: { :e
	Derketin binivîse: e.
}, bide-destpêkirin.
