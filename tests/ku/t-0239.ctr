Lîste gava: ['sum'] bike: {
	>> total := 0.
	xwe her-yek: { :index :element
		total zêde-bike: element.
	}. <- total.
}.

>> a := Rast.



a gava: ['nivîs'] bike: {
	>> answer := Tune.
	( xwe = Rast ) rast: {
		answer := ['Yep'].
	}, wekî-din: {
		answer := ['Nope'].
	}. <- answer.
}.

a gava: ['hejmar'] bike: {
	>> answer := Tune.
	( xwe = Rast ) rast: {
		answer := 10.
	}, wekî-din: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b gava: ['nivîs'] bike: { <- ['Devil'].
}.

b gava: ['mantiqî'] bike: { <- Şaş.
}.


Derketin binivîse: a, rêza-nû.  
Derketin binivîse: (90 + a), rêza-nû. 
Derketin binivîse: b, rêza-nû. 
Derketin binivîse: (Rast û: b), rêza-nû.

a := Lîste ← ['hello'] ; ['world'] ; Rast ; Tune ; 666. 
a := a + ( Lîste ← 1 ).
Derketin binivîse: a, rêza-nû.
Derketin binivîse: ((Ferheng nû) deyne: Tune li: Tune), rêza-nû.
Derketin binivîse: a sum, rêza-nû. 


{
	a gava: ['nivîs'] bike: { <- Tune. }.
	a := [''] + a.
} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.



{
	a gava: ['hejmar'] bike: { <- Tune. }.
	a := 3 × a.
} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.


{
	a gava: ['mantiqî'] bike: { <- Tune. }.
	a := Rast û: a. 
} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.





{
	a gava: ['nivîs'] bike: { <- Şaş. }.
