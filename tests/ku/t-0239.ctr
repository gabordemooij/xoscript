} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.



{
	a gava: ['hejmar'] bike: { <- Rast. }.
	a := 3 × a.
} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.


{
	a gava: ['boolean'] bike: { <- 1. }.
	a := Rast û: a.
} bigire: { :error
	Derketin binivîse: ['Error noted: '] + error, rêza-nû.
}, bide-destpêkirin.





