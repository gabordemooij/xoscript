
{ :i
	Derketin binivîse: ['This is step #'] + ( ( i ) + 1 ), rêza-nû.
} × 6.

{ :i
	Derketin binivîse: ['This is step #'] + ( 3 - ( i ) ), rêza-nû.
} × 6.

{ :i
	Derketin binivîse: ['NEVER!'], rêza-nû.
} × 0.



{ :i
	Derketin binivîse: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), rêza-nû.
} × 11.
