
>> countries := Lîste nû
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lîste nû
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods li-gorî: countries, her-yek: { :key :value
	counter zêde-bike: 1.
}.

Derketin binivîse: (['we serve counter dishes'] counter: counter), rêza-nû.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tîpan rêz-bike: { :v
	counter zêde-bike: 0.
}.

Derketin binivîse: (['we sort counter dishes'] counter: counter), rêza-nû.


>> counter := 0.
{
	{
		counter zêde-bike: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Derketin binivîse: (['we calculate counter numbers.'] counter: counter), rêza-nû.

