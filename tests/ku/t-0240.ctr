# test qualifiers

>> $ := Tişt nû.

$ gava: ['bersiv-bide:'] bike: { :x
	
	>> operation := x tîp: 0.
	>> valuta := x tîp: 1.
	>> money := x derbas-bike: 2.
	
	>> amount := 0.

	( operation = ['+'] ) rast: {
		( valuta = ['£'] ) rast: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Derketin binivîse: x, rêza-nû.


>> Fruit := Tişt nû.

Fruit gava: ['nû'] bike: {
	>> f := xwe nû.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit gava: ['apples:'] bike: { :a xweyî apples := a. }.
Fruit gava: ['oranges:'] bike: { :p xweyî oranges := p. }.
Fruit gava: ['apples'] bike: { <- xweyî apples. }.
Fruit gava: ['oranges'] bike: { <- xweyî oranges. }.

Fruit gava: ['+'] bike: { :f
	
	>> n := Fruit nû.
	f zêde-bike: 1.
	
	n apples: (f apples + xweyî apples).
	n oranges:  (f oranges  + xweyî oranges). <- n.
}.

Fruit gava: ['nivîs'] bike: { <- ( xweyî apples nivîs + [' apples and '] + xweyî oranges + [' oranges'] ).
}.

Hejmar gava: ['apples'] bike: { <- ((Fruit nû) apples: xwe).
}.

Hejmar gava: ['apple'] bike: { <- ((Fruit nû) apples: xwe).
}.

Hejmar gava: ['oranges'] bike: { <- ((Fruit nû) oranges: xwe).
}.




Derketin binivîse: (1 apple + 3 oranges + 4 apples), rêza-nû.


Nivîs gava: ['twice'] bike: { <- ((xwe nivîs) + (xwe nivîs)).
}.



Derketin binivîse: ['❤❤❤'] twice.



