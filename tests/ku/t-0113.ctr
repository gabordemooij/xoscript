Derketin binivîse: ['Continue for-loop, No - before 6 and up.'], rêza-nû.
{ :i
	Derketin binivîse: (i + 1), rêza-nû.
	((i + 1) > 4) bidomîne.
	Derketin binivîse: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Derketin rêza-nû.
Derketin binivîse: ['Continue while-true, No --> before 5 and up.'], rêza-nû.
{
	Derketin binivîse: ['iteration #'] + x, rêza-nû.
	x zêde-bike: 1.
	((x < 5) ne) bidomîne.
	Derketin binivîse: ['-->'].
} heta-ku: xIsLessThan10.
Derketin rêza-nû.
Derketin binivîse: ['Continue while-false, No - before 3 only.'], rêza-nû.
{
	Derketin binivîse: ['iteration #'] + x, rêza-nû.
	x kêm-bike: 1.
	(x = 3) bidomîne.
	Derketin binivîse: ['-'].
} heta-ku: { <- ( x > 0). }.

Derketin rêza-nû.
Derketin binivîse: ['Continue times-loop, No ||| before 3.'], rêza-nû.
{ :i
	Derketin binivîse: ['iteration #'] + i, rêza-nû.
	(i = 2) bidomîne.
	Derketin binivîse: ['|||'].
} × 5.

Derketin rêza-nû.

{ Rast bidomîne. Derketin binivîse: ['dont write this!'], rêza-nû. } bide-destpêkirin.

{ Rast bidomîne. Derketin binivîse: ['dont write this!'], rêza-nû. } bigire: { Derketin binivîse: ['Dont catch this!']. }, bide-destpêkirin.

Derketin binivîse: ['Test Array each-loop: 0, ... ,2'], rêza-nû.
(Lîste ← 1 ; 2 ; 3) her-yekî-biguherîne: { :i
	(i = 1) bidomîne.
	Derketin binivîse: ['iteration #'] + (i - 0), rêza-nû.
}.

Derketin binivîse: ['Test Map each-loop: c only'], rêza-nû.
>> m := Ferheng nû.
m deyne: ['first'] li: ['a'], deyne: ['second'] li: ['b'], deyne: ['third'] li: ['c'].
m her-yek: { :k :v
	(k ≠ ['c']) bidomîne.
	Derketin binivîse: ['iteration'] + k + v, rêza-nû.
}.

