>> Animal := Tişt nû.
Animal gava: ['make'] bike: {
	>> animal := Tişt nû.
	animal gava: ['makeSound'] bike: {
		Derketin binivîse: xweyî sound.
	}. <- animal.
}.
>> Cat := Tişt nû.
Cat gava: ['make'] bike: {
	>> cat := Animal make.
	cat gava: ['init'] bike: {
		xweyî sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
