>> randomizer := { :a :b
	>> herî-biçûk := ( a < b ) ev: a an-ew: b.
	>> herî-mezin := ( a > b ) ev: a an-ew: b.
	>> x := Tune.
	{
		x := Hejmar di-navbera: a û: b.
		((x < herî-biçûk) an: (x > herî-mezin)) rast: { 
			Derketin binivîse: (['Invalid value!']).
			Bername biqedîne.
		}.
	} 
	× 100. <- x.
}.
randomizer bisepîne: 0 û: 0.
randomizer bisepîne: 1 û: 0.
randomizer bisepîne: 1 û: 1.
randomizer bisepîne: 0 û: 1.
randomizer bisepîne: -1 û: 0.
randomizer bisepîne: -1 û: -1.
randomizer bisepîne: 0 û: -1.
randomizer bisepîne: 100 û: 200.
randomizer bisepîne: 999999999999998 û: 999999999999999.
randomizer bisepîne: 999999999999999 û: 999999999999998.
randomizer bisepîne: 999999999999999 û: 999999999999999.
randomizer bisepîne: -999999999999998 û: -999999999999999.
randomizer bisepîne: -999999999999999 û: -999999999999998.
randomizer bisepîne: -999999999999999 û: -999999999999999.
randomizer bisepîne: 999999999999998 û: -999999999999999.
randomizer bisepîne: 999999999999999 û: -999999999999998.
randomizer bisepîne: 999999999999999 û: -999999999999999.
randomizer bisepîne: -999999999999998 û: 999999999999999.
randomizer bisepîne: -999999999999999 û: 999999999999998.
randomizer bisepîne: -999999999999999 û: 999999999999999.
Derketin binivîse: ['OK'].


