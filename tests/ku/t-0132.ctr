
>> kept1 := Bername bîr ? 3.
>> sticky1 := (Bername bîr ? 2).
>> dust1 := (Bername bîr ? 4).

>> kept2 := Bername bîr ? 3.
>> sticky2 := (Bername bîr ? 2).
>> dust2 := (Bername bîr ? 4).

Bername paqij-bike.



kept1 := (Bername bîr) ? 3.
sticky1 := (Bername bîr) ? 2.
dust1 := (Bername bîr ? 4).

kept2 := Bername bîr ? 3.
sticky2 := (Bername bîr ? 2).
dust2 := (Bername bîr ? 4).

Bername paqij-bike.



kept2 := Bername bîr ? 3.
sticky2 := (Bername bîr ? 2).
dust2 := (Bername bîr ? 4).

Derketin binivîse: (kept2   - kept1), rêza-nû. 
Derketin binivîse: (sticky2 - sticky1), rêza-nû. 
