Derketin binivîse: ['Test object'], rêza-nû.
>> a := Tişt nû. 

a gava: ['item:'] bike: { :hexhelper
	xweyî hexhelper := hexhelper. 
}.

a gava: ['item'] bike: { <- xweyî hexhelper.
}.

a item: Hx nû.

>> old-hexhelper-address := a item prototîp navnîşana-bîrê.
a save-as: ['/tmp/a.bin'].
Derketin binivîse: ['========== RELOADING SNAP:'], rêza-nû.

>> b := Tişt load-from: ['/tmp/a.bin'].

(b item prototîp navnîşana-bîrê = old-hexhelper-address) rast: {
	Derketin binivîse: ['Object link re-attached.'], rêza-nû.
}.
