Server init.
>> fmt := Format nû: ['%#3x'].

>> blob := Blob nû: 4.
blob bytes: ( 
	Lîste nû ; 0 ; 1 ; 2 ; 3
).

>> file := Pel nû: ['/tmp/blob'].
file blob: blob.
blob azad-bike.

>> bixwîne := file blob.
bixwîne 
ji: 0 
dirêjî: 4, 
bike her-yek: { :i :b 
	Derketin
	binivîse: (fmt bisepîne-hejmara-tam: b),
	rêza-nû.
}.
bixwîne azad-bike.
