#Linux
>> Slurp := Tişt nû.

Slurp gava: ['nû'] bike: {
	xweyî str := [''].
}.

Slurp gava: ['nieuw'] bike: {
	xweyî str := [''].
}.

Slurp gava: ['bersiv-bide:'] bike: { :blah
		xweyî str li-dawiyê-zêde-bike: blah.
}.

Slurp gava: ['bersiv-bide:û:'] bike: { :blah :blahah
		xweyî str li-dawiyê-zêde-bike: (blah ji: 0 dirêjî: (blah dirêjî - 1)).
		xweyî str li-dawiyê-zêde-bike: [' '].
		xweyî str li-dawiyê-zêde-bike: blahah.
}.

Slurp gava: ['obtain'] bike: {
	>> buffer := xweyî str.
	xweyî str := ['']. <- buffer.
}.


Derketin binivîse: (Bername pergal: (Slurp nû echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Pel nû: ['/tmp/from.txt'], jê-bibe. } bigire: { ['Empty']. }, bide-destpêkirin.
{ Pel nû: ['/tmp/to.txt'], jê-bibe. } bigire: { ['Empty']. }, bide-destpêkirin.


Pel nû: ['/tmp/to.txt'], heye şaş: {
	Derketin binivîse: ['Confirmed. Target file does not exist.\
'].
}.
Pel nû: ['/tmp/from.txt'], heye şaş: {
	Derketin binivîse: ['Confirmed. Source file does not exist.\
'].
}.



Bername pergal: (Slurp nû touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Bername pergal: (Slurp nû cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Pel nû: ['/tmp/to.txt'], heye rast: {
	Derketin binivîse: ['Confirmed. Target file has been created by shell.\
'].
}.


Derketin binivîse: ['Contents of file is:'] + (Pel nû: ['/tmp/to.txt'], bixwîne), rêza-nû.
