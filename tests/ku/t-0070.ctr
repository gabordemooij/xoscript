>> numbers := ['1,2,3'] parçe-bike: [','].
Derketin binivîse: ['I got: '] + numbers hejmara-tiştan + [' numbers.'],rêza-nû.
{ :i Derketin binivîse: ['number #'] + i + [':'] + (numbers cih: i), rêza-nû.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages parçe-bike: [' Or '].
Derketin binivîse: ['We serve'], rêza-nû.
{ :i Derketin binivîse: ['->'] + (beverages cih: i), rêza-nû. } × (beverages hejmara-tiştan).
Derketin binivîse: (beverages bigihîne-hev: [',']), rêza-nû.
Derketin binivîse: (numbers bigihîne-hev: ['||']).
