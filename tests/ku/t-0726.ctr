# test buffers PKI/Sign 
Server init.

>> long := ( Lîste nû dagirtin: 1000 bi: ['a'] ) bigihîne-hev: [''].

# sign a message
Derketin binivîse: ( 
	Qasa îmze-bike: ['abc'] bi: long
), rêza-nû.

Derketin binivîse: ( 
	Qasa
		kontrol-bike: ['abc'] 
		îmze: long 
		bi: long
), rêza-nû.

Derketin binivîse: (
	Qasa haşa-şîfreyê: long piştrast-bike: long
), rêza-nû.
