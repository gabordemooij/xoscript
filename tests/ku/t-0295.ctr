
>> dictionary := (
	Ferheng nû
		deyne: ['b'] li: ['a'],
		deyne: ['a'] li: ['b'],
		deyne: ['z'] li: ['x'],
		deyne: ['hello'] li: ['hallo'],
		deyne: ['human'] li: ['human']
).

>> comparisons := Lîste nû.
dictionary her-yek: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bide-ber-hev: b)
	).
}.

comparisons rêz-bike: { :a :b <- ( a bide-ber-hev: b ). }.
Derketin binivîse: ( comparisons bigihîne-hev: ['↵'] ), rêza-nû.
comparisons bigihîne-hev: ['↵'].
