# backslashes must survive code serialization, strings must not end early
>> nirx := Lîste nû
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

nirx her-yek: { :i :value
	>> d := Ferheng nû.
	d deyne: value li: ['k'].
	>> r := d kod tişt.
	Derketin binivîse: r hejmara-tiştan, rêza-nû.
	Derketin binivîse: ( (r li: ['k']) = value ), rêza-nû.
}.
