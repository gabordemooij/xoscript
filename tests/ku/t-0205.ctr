>> str := ['write:'].
Derketin peyam: ['binivîse:'] argûman: (Lîste ← ['Hello World']), rêza-nû. 

Hejmar gava: ['isbetween:and:'] bike: { :a :b <- ((xwe ≥ a) û: (xwe ≤ b)).
}.

str := ['isbetween:and:'].
Derketin binivîse: (3 peyam: str argûman: (Lîste ← 2 ; 8)), rêza-nû.
Derketin binivîse: (3 peyam: str argûman: (Lîste ← 1 ; 2)), rêza-nû.


>> CoffeeMachine := Tişt nû.
CoffeeMachine gava: ['makeCoffeeWithSugar:milk:'] bike: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lîste ← 4 ; 2.
Derketin binivîse: ( CoffeeMachine peyam: order argûman: coffeeConfiguration ), rêza-nû.
