Hejmar gava: ['roman'] bike: {
	>> hejmar := xwe kopî-bike.
	>> roman := [''].
	{
		{
			(hejmar ≥ 1000) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅿ'].
				hejmar kêm-bike: 1000.
			}, bibire.
		
			(hejmar ≥ 500) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅾ'].
				hejmar kêm-bike: 500.
			}, bibire.
		
			(hejmar ≥ 100) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅽ'].
				hejmar kêm-bike: 100.
			}, bibire.
		
			(hejmar ≥ 50) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅼ'].
				hejmar kêm-bike: 50.
			}, bibire.
		
			(hejmar ≥ 50) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅼ'].
				hejmar kêm-bike: 50.
			}, bibire.
		
			(hejmar ≥ 10) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅹ'].
				hejmar kêm-bike: 10.
			}, bibire.
			
			(hejmar ≥ 9) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅸ'].
				hejmar kêm-bike: 9.
			}, bibire.
			
			(hejmar ≥ 5) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅴ'].
				hejmar kêm-bike: 5.
			}, bibire.
			
			(hejmar ≥ 4) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅳ'].
				hejmar kêm-bike: 4.
			}, bibire.
			
			(hejmar ≥ 1) rast: {
				roman li-dawiyê-zêde-bike: ['Ⅰ'].
				hejmar kêm-bike: 1.
			}, bibire.
		} prosedur.
	} heta-ku: { <- hejmar > 0. }. <- roman.
}.

Derketin binivîse: 1 roman, rêza-nû.
Derketin binivîse: 2 roman, rêza-nû.
Derketin binivîse: 4 roman, rêza-nû.
Derketin binivîse: 8 roman, rêza-nû.
Derketin binivîse: 16 roman, rêza-nû.
Derketin binivîse: 32 roman, rêza-nû.
Derketin binivîse: 64 roman, rêza-nû.
Derketin binivîse: 128 roman, rêza-nû.
Derketin binivîse: 256 roman, rêza-nû.
Derketin binivîse: 1024 roman, rêza-nû.
