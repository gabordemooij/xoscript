#Linux

(Pel nû: ['/tmp/testje']) heye şaş: {
	Bername pergal: ['mkdir /tmp/testje'].	
}.

(Pel nû: ['/tmp/testje/file1']) heye şaş: {
	Bername pergal: ['touch /tmp/testje/file1'].	
}.

(Pel nû: ['/tmp/testje/folder1']) heye şaş: {
	Bername pergal: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Pel lîste: ['/tmp/testje'].

>> q := Lîste nû.

l her-yek: { :k :v v her-yek: { :x :y q li-dawiyê-zêde-bike: y. }. }.

>> s := q nivîs.

(s dihewîne: ['file1']) rast:   { Derketin binivîse: ['OK'], rêza-nû. }.
(s dihewîne: ['file2']) rast:   { Derketin binivîse: ['XX'], rêza-nû. }.
(s dihewîne: ['folder1']) rast: { Derketin binivîse: ['OK'], rêza-nû. }.
