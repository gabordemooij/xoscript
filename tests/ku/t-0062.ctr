Mantiqî gava: ['xor:'] bike: { :a :b <- ((a û: b ne) an: (a ne û: b)).
}.

>> o := Tişt nû.
o gava: ['hello'] bike: { ['Empty']. }.
{ o gava: 2 bike: 3.} bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
{ o gava: ['ceribandin'] bike: 3.} bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin.
{ o gava: ['hello'] bike: { ['Empty']. }.} bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ >> z := 4 ÷ 0. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ (Rast û: Tune) rast: { Derketin binivîse: ['X'].}. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ ([''] xor: 0) rast: { Derketin binivîse: ['X'].}. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ (1 < ['2']) rast: { Derketin binivîse: ['OK']. }. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ (1 < ['2.0']) rast: { Derketin binivîse: ['OK']. }. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ (1 < ['x2.0']) rast: { Derketin binivîse: ['NO!']. }. } bigire: { :e Derketin binivîse: e, rêza-nû. }, bide-destpêkirin. 
{ Derketin binivîse: (['hello OK there'] ji: ['6'] dirêjî: ['2']). } bide-destpêkirin. 
