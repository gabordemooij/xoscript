


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Bername rêveberiya-bîrê: 0.
>> palette := Tune.
>> colors := Tune.

{
palette := Ferheng nû.
palette 
	deyne: ['#F00'] li: ['red'],
	deyne: ['#0F0'] li: ['green'],
	deyne: ['#00F'] li: ['blue'].
Derketin binivîse: ['number of RGB codes in palette: '] + ( palette hejmara-tiştan ), rêza-nû.
Derketin binivîse: ['RGB code of green is: '] + ( palette ? ['green'] ), rêza-nû.
colors := [''].
( palette her-yek: { :nav :kod
		colors := colors + ( nav + [':'] + kod ).
} ).
Derketin binivîse: ['All colors in palette: '] + colors, rêza-nû.
} bide-destpêkirin.
Bername paqij-bike.
usedMemory1 := (Bername bîr ? 0).

{
palette := Ferheng nû.
palette 
	deyne: ['#F00'] li: ['red'],
	deyne: ['#0F0'] li: ['green'],
	deyne: ['#00F'] li: ['blue'].
Derketin binivîse: ['number of RGB codes in palette: '] + ( palette hejmara-tiştan ), rêza-nû.
Derketin binivîse: ['RGB code of green is: '] + ( palette ? ['green'] ), rêza-nû.
colors := [''].
( palette her-yek: { :nav :kod
		colors := colors + ( nav + [':'] + kod ).
} ).
Derketin binivîse: ['All colors in palette: '] + colors, rêza-nû.
} bide-destpêkirin.
Bername paqij-bike.
usedMemory2 := (Bername bîr ? 0).

{
palette := Ferheng nû.
palette 
	deyne: ['#F00'] li: ['red'],
	deyne: ['#0F0'] li: ['green'],
	deyne: ['#00F'] li: ['blue'].
Derketin binivîse: ['number of RGB codes in palette: '] + ( palette hejmara-tiştan ), rêza-nû.
Derketin binivîse: ['RGB code of green is: '] + ( palette ? ['green'] ), rêza-nû.
colors := [''].
( palette her-yek: { :nav :kod
		colors := colors + ( nav + [':'] + kod ).
} ).
Derketin binivîse: ['All colors in palette: '] + colors, rêza-nû.
} bide-destpêkirin.
Bername paqij-bike.
usedMemory3 := (Bername bîr ? 0).



( usedMemory1 = usedMemory2 û: usedMemory1 = usedMemory3, û: usedMemory2 = usedMemory3 ) rast: {
	Derketin binivîse: ['No memory leaks here'].
}, şaş: {
	Derketin binivîse: ['Leaking memory...'].
}.
