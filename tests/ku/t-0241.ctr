

Nivîs gava: ['evaluate'] bike: {
	>> kod := Pel nû: ['/tmp/eval.ctr'].
	kod binivîse: (xwe nivîs + ['.']).
	Bername bi-kar-bîne: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lîste ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q nivîs.
Derketin binivîse: x, rêza-nû.
>> y := Tune.
(['y := '] + x ) evaluate.
Derketin binivîse: y ? 0, rêza-nû.

q := Ferheng deyne: ['\[''] li: ['\['quote\']'].
x := q nivîs.
Derketin binivîse: x, rêza-nû.
y := Tune.
(['y := '] + x ) evaluate.

>> q := (Ferheng nû) deyne:['\[''] li:['\['quote\[''].
Derketin binivîse: y ? ['\['quote\']'], rêza-nû.
