

>> Matryoshka := Tişt nû.
Matryoshka gava: ['double:'] bike: { :secret
	xweyî secret := secret × 2.
}.
Matryoshka gava: ['nû:'] bike: { :secret
	>> answer := Tune.
	>> t := (secret > 255).
	Derketin binivîse: (secret + [' | '] + t), rêza-nû.
	t rast: {
		answer := secret.
	}, wekî-din: {
		answer := Matryoshka xwe-bangker nû: (xwe double: secret).
	}. <- answer.
}.

>> x := Matryoshka nû: 2.
