# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Qasa mifteyan-çêke.

# private (secret) key
>> sk := keys yekem.

# public key
>> pk := keys ya-dawî.

# sign a message
>> sig := Qasa îmze-bike: ['abc'] bi: sk.

# check message (ok)
Derketin binivîse: ( 
	Qasa
		kontrol-bike: ['abc'] 
		îmze: sig 
		bi: pk 
), rêza-nû.

# check message (fail)
Derketin binivîse: ( 
	Qasa 
		kontrol-bike: ['abd'] 
		îmze: sig 
		bi: pk 
), rêza-nû.