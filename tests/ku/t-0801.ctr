Server init.

>> db := Maria-DB nû mêvandar: ['localhost'],
	navê-bikarhêner: ['xo'],
	şîfre: ['pass123'],
	navê-danegehê: ['xobase'],
	girêbide-pê.

>> del := db lêpirsîn: ['DELETE FROM book WHERE id > 0'].
{  del bixebitîne. db piştrast-bike. } bigire: { :e db vegerîne.  }, bide-destpêkirin.

>> hejmara-tiştan := db lêpirsîn: ['SELECT COUNT(*) AS num FROM book'].
hejmara-tiştan bîne: { :row Derketin binivîse: row num, rêza-nû. }.
