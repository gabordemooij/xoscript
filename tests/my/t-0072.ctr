>> echo := အရာဝတ္ထု အသစ်.
echo ရလျှင်: ['ဖြေ:'] လုပ်: { :sound
	{ အထွက် ရေး: sound. } × 2.
}.
echo ho!. 


echo := အရာဝတ္ထု အသစ်.
echo ရလျှင်: ['ဖြေ:နှင့်:'] လုပ်: { :sound :x
	{ အထွက် ရေး: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := အရာဝတ္ထု အသစ်.
echo ရလျှင်: ['ဖြေ:နှင့်:နှင့်:'] လုပ်: { :operation :sound :x
	{ အထွက် ရေး: sound. } × x.
}.
echo shout: ['la'] times: 4. 


