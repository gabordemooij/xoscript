Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := အစီအစဉ် အသစ် ;
	# {"key":"normal"} normal ASCII
	( အဘိဓာန် အသစ် ထည့်: ['normal'] သော့: ['key'] ) ;
	# {"key":"hello world"} space character
	( အဘိဓာန် အသစ် ထည့်: ['hello world'] သော့: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( အဘိဓာန် အသစ် ထည့်: ['"'] သော့: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( အဘိဓာန် အသစ် ထည့်: ['backslash: \\'] သော့: ['key'] ) ;
	# {"key":"slash: /"} slash
	( အဘိဓာန် အသစ် ထည့်: ['slash: /'] သော့: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( အဘိဓာန် အသစ် ထည့်: ['backspace: \b'] သော့: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( အဘိဓာန် အသစ် ထည့်: ['formfeed: \f'] သော့: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( အဘိဓာန် အသစ် ထည့်: ['newline: \n'] သော့: ['key'] ) ;
	( အဘိဓာန် အသစ် ထည့်: ['newline: ↵'] သော့: ['key'] ) ;
	( အဘိဓာန် အသစ် ထည့်: ['newline: 
	'] သော့: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( အဘိဓာန် အသစ် ထည့်: ['carriage return: \r'] သော့: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( အဘိဓာန် အသစ် ထည့်: ['tab \t'] သော့: ['key'] ) ;
	( အဘိဓာန် အသစ် ထည့်: ['tab ⇿'] သော့: ['key'] ) ;
	( အဘိဓာန် အသစ် ထည့်: ['tab  '] သော့: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( အဘိဓာန် အသစ် ထည့်: ['NUL \u0000'] သော့: ['key'] ) ;
	( အဘိဓာန် အသစ် ထည့်: ['NUL \0'] သော့: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( အဘိဓာန် အသစ် ထည့်: ['control: \u0001'] သော့: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( အဘိဓာန် အသစ် ထည့်: ['control: \u001F'] သော့: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( အဘိဓာန် အသစ် ထည့်: ['unicode: é'] သော့: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( အဘိဓာန် အသစ် ထည့်: ['unicode: €'] သော့: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( အဘိဓာန် အသစ် ထည့်: ['unicode: 日本語'] သော့: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( အဘိဓာန် အသစ် ထည့်: ['unicode: 😀'] သော့: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( အဘိဓာန် အသစ် ထည့်: ['unicode: 🧑‍💻'] သော့: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( အဘိဓာန် အသစ် ထည့်: ['combining: e\u0301'] သော့: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( အဘိဓာန် အသစ် ထည့်: ['escaped unicode: \u00e9'] သော့: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( အဘိဓာန် အသစ် ထည့်: ['escaped unicode: \u20ac'] သော့: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( အဘိဓာန် အသစ် ထည့်: ['escaped unicode: \ud83d\ude00'] သော့: ['key'] ) ;
	# {"key":""} empty value
	( အဘိဓာန် အသစ် ထည့်: [''] သော့: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( အဘိဓာန် အသစ် ထည့်: ['@ < > & = % + ? #'] သော့: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( အဘိဓာန် အသစ် ထည့်: ['''] သော့: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( အဘိဓာန် အသစ် ထည့်: ['multiple: \" \\ \n \r \t'] သော့: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( အဘိဓာန် အသစ် ထည့်: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] သော့: ['key'] ) ;
	# {"key":" value"} leading space
	( အဘိဓာန် အသစ် ထည့်: [' value'] သော့: ['key'] ) ;
	# {"key":"value "} trailing space
	( အဘိဓာန် အသစ် ထည့်: ['value '] သော့: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( အဘိဓာန် အသစ် ထည့်: [' \t\n\r '] သော့: ['key'] ).

dicts တစ်ခုစီ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (အဘိဓာန် အသစ် ထည့်: d key သော့: ['key']).
	>> b := JSON jsonify: (အဘိဓာန် အသစ် ထည့်: ['value'] သော့: d key).
	>> e := JSON အရာဝတ္ထု: a.
	>> f := JSON အရာဝတ္ထု: b.
	((e key = d key နှင့်: (f ? d key = ['value'])) သို့မဟုတ်: (e key = ['NUL ?'])) မှန်လျှင်: {
		အထွက် ရေး: ['OK'], စာကြောင်းသစ်.
	}, မဟုတ်လျှင်: {
		အထွက် ရေး: ['Unable to properly encode/decode: '] + d + j, စာကြောင်းသစ်.
		ပရိုဂရမ် အဆုံးသတ်.
	}.
}.
