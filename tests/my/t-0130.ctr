# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := ပရိုဂရမ် ဆက်တင်: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server ချိတ်ဆက်: ( အစီအစဉ် အသစ် ;
 libname ; ['fopen'] ;
 ( အစီအစဉ် အသစ် ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
ချိတ်ဆက်: ( အစီအစဉ် အသစ် ;
 ဗလာ ; # means same lib
 ['fread'] ;
 ( အစီအစဉ် အသစ် ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 ဗလာ ; # means same object (i.e. Stream)
 ['fread']
),
ချိတ်ဆက်: (
 အစီအစဉ် အသစ် ;
 ဗလာ ; # means same lib
 ['fwrite'] ;
 ( အစီအစဉ် အသစ် ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 ဗလာ ; # means same lib
 ['fwrite']
),
ချိတ်ဆက်: (
 အစီအစဉ် အသစ် ;
 ဗလာ ; # means same lib
 ['rewind'] ;
 ( အစီအစဉ် အသစ် ; ['pointer'] ) ;
 ['int'] ;
 ဗလာ ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ဖိုင်လမ်းကြောင်း := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ဖိုင်လမ်းကြောင်း mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream သတင်းစကား: ['fwrite'] အာဂူမင့်များ: (အစီအစဉ် အသစ် ; str ; 1 ; 6 ; fd ).
အထွက် ရေး: bytes-written, စာကြောင်းသစ်.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob အသစ်: 20.

# read from file
>> bytes-read := Stream သတင်းစကား: ['fread'] အာဂူမင့်များ: (အစီအစဉ် အသစ် ; buf ; 1 ; 6 ; fd ).
အထွက် ရေး: bytes-read, စာကြောင်းသစ်.
အထွက် ရေး: buf, စာကြောင်းသစ်.

# free memory
str  လွှတ်ပေး.
ဖိုင်လမ်းကြောင်း လွှတ်ပေး.
mode လွှတ်ပေး.
buf  လွှတ်ပေး.


