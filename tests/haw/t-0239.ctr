Papa i: ['sum'] hana: {
	>> total := 0.
	iho pākahi: { :index :element
		total hoʻohui-helu: element.
	}. <- total.
}.

>> a := ʻOiaʻiʻo.



a i: ['kaula'] hana: {
	>> answer := ʻOle.
	( iho = ʻOiaʻiʻo ) ʻoiaʻiʻo: {
		answer := ['Yep'].
	}, ʻi-ole-ia: {
		answer := ['Nope'].
	}. <- answer.
}.

a i: ['helu'] hana: {
	>> answer := ʻOle.
	( iho = ʻOiaʻiʻo ) ʻoiaʻiʻo: {
		answer := 10.
	}, ʻi-ole-ia: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b i: ['kaula'] hana: { <- ['Devil'].
}.

b i: ['boolean'] hana: { <- Wahaheʻe.
}.


Huapuka kākau: a, laina-hou.  
Huapuka kākau: (90 + a), laina-hou. 
Huapuka kākau: b, laina-hou. 
Huapuka kākau: (ʻOiaʻiʻo a: b), laina-hou.

a := Papa ← ['hello'] ; ['world'] ; ʻOiaʻiʻo ; ʻOle ; 666. 
a := a + ( Papa ← 1 ).
Huapuka kākau: a, laina-hou.
Huapuka kākau: ((Puke-wehewehe hou) waiho: ʻOle ma: ʻOle), laina-hou.
Huapuka kākau: a sum, laina-hou. 


{
	a i: ['kaula'] hana: { <- ʻOle. }.
	a := [''] + a.
} hopu: { :error
	Huapuka kākau: ['Error noted: '] + error, laina-hou.
}, hoʻomaka.



{
	a i: ['helu'] hana: { <- ʻOle. }.
	a := 3 × a.
} hopu: { :error
	Huapuka kākau: ['Error noted: '] + error, laina-hou.
}, hoʻomaka.


{
	a i: ['boolean'] hana: { <- ʻOle. }.
	a := ʻOiaʻiʻo a: a. 
} hopu: { :error
	Huapuka kākau: ['Error noted: '] + error, laina-hou.
}, hoʻomaka.





