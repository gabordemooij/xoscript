#Linux
>> Slurp := Mea hou.

Slurp i: ['hou'] hana: {
	ponoʻī str := [''].
}.

Slurp i: ['nieuw'] hana: {
	ponoʻī str := [''].
}.

Slurp i: ['pane:'] hana: { :blah
		ponoʻī str pākuʻi-hope: blah.
}.

Slurp i: ['pane:a:'] hana: { :blah :blahah
		ponoʻī str pākuʻi-hope: (blah mai: 0 lōʻihi: (blah lōʻihi - 1)).
		ponoʻī str pākuʻi-hope: [' '].
		ponoʻī str pākuʻi-hope: blahah.
}.

Slurp i: ['obtain'] hana: {
	>> buffer := ponoʻī str.
	ponoʻī str := ['']. <- buffer.
}.


Huapuka kākau: (Polokalamu ʻōnaehana: (Slurp hou echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Waihona hou: ['/tmp/from.txt'], hoʻopau. } hopu: { ['Empty']. }, hoʻomaka.
{ Waihona hou: ['/tmp/to.txt'], hoʻopau. } hopu: { ['Empty']. }, hoʻomaka.


Waihona hou: ['/tmp/to.txt'], aia wahaheʻe: {
	Huapuka kākau: ['Confirmed. Target file does not exist.\
'].
}.
Waihona hou: ['/tmp/from.txt'], aia wahaheʻe: {
	Huapuka kākau: ['Confirmed. Source file does not exist.\
'].
}.



Polokalamu ʻōnaehana: (Slurp hou touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Polokalamu ʻōnaehana: (Slurp hou cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Waihona hou: ['/tmp/to.txt'], aia ʻoiaʻiʻo: {
	Huapuka kākau: ['Confirmed. Target file has been created by shell.\
'].
}.


Huapuka kākau: ['Contents of file is:'] + (Waihona hou: ['/tmp/to.txt'], heluhelu), laina-hou.
