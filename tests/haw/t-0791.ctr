Server init.

>> DB := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'],
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> nā-koina-huli := Nīnau-Maria hou: SQL.

# set database
nā-koina-huli waihona-ʻikepili: DB.

nā-koina-huli kiʻi: { :row
	Huapuka kākau: row world, laina-hou.
}.
