>> q := Papa ← 1 ; 2 ; 3.
{ q ? ['1']. } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? ʻOiaʻiʻo. } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? Wahaheʻe. } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? ʻOle. } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? (Papa hou). } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? (Mea hou). } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
{ q ? ({ ['Empty']. }). } hopu: { Huapuka kākau: ['caught!'], laina-hou. }, hoʻomaka.
Huapuka kākau: ['caught them all'], laina-hou.
