

Papa i: ['column:'] hana: { :column
	>> result := Papa hou.
	iho pākahi: { :index :row
		row pākahi: { :index :cell
			(index = column) ʻoiaʻiʻo: { result pākuʻi-hope: cell. }.
		}.
	}. <- result.
}.


>> a := Papa ←
	(Papa ← 1 ; 2 ; 3) ;
	(Papa ← 4 ; 5 ; 6) ;
	(Papa ← 7 ; 8 ; 9).

>> b := a column: 1.
Huapuka kākau: b, laina-hou.

b := a column: 20.
Huapuka kākau: b, laina-hou.

b := a column: -100.
Huapuka kākau: b, laina-hou.
