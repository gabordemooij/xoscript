

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

>> txt := ['World Salad'].
Huapuka kākau: ['this text contains: '] + ( ( txt hoʻokaʻawale: [' '] ) heluna ) + [' words.'], laina-hou.
txt := txt mai: 6 lōʻihi: 4.
Huapuka kākau: txt, laina-hou.

Polokalamu hoʻomaʻemaʻe.

usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).


txt := ['World Salad'].
Huapuka kākau: ['this text contains: '] + ( ( txt hoʻokaʻawale: [' '] ) heluna ) + [' words.'], laina-hou.
