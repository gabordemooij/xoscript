Helu i: ['factorial'] hana: {
	>> total := 1.
	{ :index total hoʻonui-me: (iho - (index)). } × iho. <- total.
}.
>> Printer := Mea hou.
Printer i: ['print:and:'] hana: { :x :y
	Huapuka kākau: ['a='] + x + [', b='] + y, laina-hou.
}.
>> a := 4.5. >> b := a hoʻoemi-helu.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a hoʻopiʻi-helu.
Printer print: a and: b.
a := 4.5. b := a hoʻoemi-helu.
Printer print: a and: b.
a := 4.5. b := a hoʻokokoke-helu.
Printer print: a and: b.
a := 4.2. b := a hoʻokokoke-helu.
Printer print: a and: b.

Huapuka kākau: (9 koena: 5), laina-hou.
Huapuka kākau: -666 waiwai-kūʻokoʻa, laina-hou.
Huapuka kākau: 49 kumu-pāhoʻonui-lua, laina-hou.
Huapuka kākau: (2 mana: 3), laina-hou.
>> l := (Papa ← 9 ; 6).
Huapuka kākau: l liʻiliʻi-loa.

