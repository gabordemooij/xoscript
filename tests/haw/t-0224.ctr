
>> countries := Papa hou
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Papa hou
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ma-o: countries, pākahi: { :key :value
	counter hoʻohui-helu: 1.
}.

Huapuka kākau: (['we serve counter dishes'] counter: counter), laina-hou.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] nā-hua hoʻonohonoho-papa: { :v
	counter hoʻohui-helu: 0.
}.

Huapuka kākau: (['we sort counter dishes'] counter: counter), laina-hou.


>> counter := 0.
{
	{
		counter hoʻohui-helu: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Huapuka kākau: (['we calculate counter numbers.'] counter: counter), laina-hou.

