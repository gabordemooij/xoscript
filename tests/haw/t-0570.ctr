#Linux

 >> t := Manawa hou.
 
t zona: ['Europe/Amsterdam'].
t makahiki: 2020, mahina: 8, lā: 2, hola: 21, minuke: 2, kekona: 1.

>> a := t hola.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t hola.
>> hw := t zona.

Huapuka
kākau: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		a-i-ʻole: ['later'] a-i: ['earlier']
	)
),
laina-hou.
 