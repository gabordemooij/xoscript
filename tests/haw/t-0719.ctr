Server init.
>> fmt := Hōʻano hou: ['%#3x'].

>> blob := Blob hou: 4.
blob bytes: ( 
	Papa hou ; 0 ; 1 ; 2 ; 3
).

>> file := Waihona hou: ['/tmp/blob'].
file blob: blob.
blob hoʻokuʻu.

>> heluhelu := file blob.
heluhelu 
mai: 0 
lōʻihi: 4, 
hana pākahi: { :i :b 
	Huapuka
	kākau: (fmt hoʻopili-helu-piha: b),
	laina-hou.
}.
heluhelu hoʻokuʻu.
