Helu i: ['factorial'] hana: {
	>> total := 1.
	{ :index total hoʻonui-me: (iho - (index)). } × iho. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Huapuka kākau: a.
>> b := 2 + 3 factorial.
Huapuka kākau: b.
>> c := 3 factorial + 2.
Huapuka kākau: c.
>> d := 2 + (3 factorial).
Huapuka kākau: d.
Huapuka kākau: 2 + 3 factorial + 1.
