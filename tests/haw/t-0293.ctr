
>> city := Papa ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Papa ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ma-o: city.
>> cities := weather nā-kī hoʻonohonoho-papa: { :a :b <- (a hoʻohālikelike: b). }.
>> temperatures := weather nā-waiwai hoʻonohonoho-papa: { :a :b <- (a hoʻohālikelike: b) ma-lalo-o-ka-ʻole?. }.

Huapuka kākau: (cities hoʻohui: [',']), laina-hou.
Huapuka kākau: (temperatures hoʻohui: [',']), laina-hou.
