Server init.

Huapuka kākau: (
	Lauana hou: ['^\\w+$'],
	kūlike: ['test@example.com'] 
), laina-hou. # 0 match, fails on @ and .

Huapuka kākau: (
	Lauana hou: ['^[^@]+@[^\.]+\.\\w+$'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match

Huapuka kākau: (
	Lauana hou: ['[^@]+@[^\.]+\.\\w+'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match

Huapuka kākau: (
	Lauana hou: ['([^@]+)@([^\.]+)\.\\w+'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match, groups dont matter

Huapuka kākau: (
	Lauana hou: ['[a-z]'],
	kūlike: ['test@example.com'] 
), laina-hou. # 14 matches

Huapuka kākau: (
	Lauana hou: ['.*'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match (all)

Huapuka kākau: (
	Lauana hou: ['(.*)'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match (all)

Huapuka kākau: (
	Lauana hou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	kūlike: ['test@example.com'] 
), laina-hou. # 1 match, prefix space optional, gets ignored