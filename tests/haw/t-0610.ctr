
>> Rectangle := Mea hou.

Rectangle i: ['area'] hana: { <- ponoʻī lōʻihi * ponoʻī width.
}.

Rectangle i: ['length:'] hana: { :lōʻihi
	ponoʻī lōʻihi := lōʻihi.
}.

Rectangle i: ['width:'] hana: { :width
	ponoʻī width := width.
}.

Rectangle i: ['hou'] hana: {
	# this will not result into an infinite loop
	>> rectangle := iho hou.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle hou.
Huapuka kākau: a area, laina-hou. #0

>> b := Rectangle hou length: 2, width: 3.
Huapuka kākau: b area, laina-hou. #6

