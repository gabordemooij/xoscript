
Server init.
Huapuka kākau: ['Database test'], laina-hou.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'], 
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli :=
db nīnau: ['SELECT REPEAT('Blah',1000) AS blah'], 
kiʻi: { :row 
	Huapuka kākau: row blah lōʻihi, laina-hou.
}.
