60 × {
	>> x := (Helu random % 6) + 1.
	(x ≤ 6) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	(x ≥0) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	x := (Helu random % 3) + 1.
	(x < 3) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	(x>-1) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	x := ((Boolean flip) helu).
	(x = 0 a-i-ʻole: x = 1) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	x := ((ʻOiaʻiʻo flip) helu).
	(x = 0 a-i-ʻole: x = 1) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
	x := (Boolean flip a-i-ʻole: ['HEAD'] a-i: ['TAIL']).
	((x = ['HEAD']) a-i-ʻole: (x = ['TAIL'])) wahaheʻe: { Huapuka kākau: ['FAIL']. }.
}.
Huapuka kākau: ['DONE'].

