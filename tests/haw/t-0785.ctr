Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :moment
	ponoʻī moment := moment. 
}.

a i: ['item'] hana: { <- ponoʻī moment.
}.

>> today := Papa hou ; ( Manawa hou zona: ['CEST'], makahiki: 2026, mahina: 7 ).
a item: today.
Huapuka kākau: a item ? 0, laina-hou.
a save-as: ['/tmp/a.bin'].
