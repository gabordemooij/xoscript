Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 4.

>> Doubler := Mea hou.
>> Multiplier := Mea hou.
Doubler i: ['double:and:'] hana: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier i: ['multiply:and:'] hana: { :x :y <- (x × y).
}.

Huapuka kākau: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), laina-hou.
