Huapuka kākau: ['Continue for-loop, No - before 6 and up.'], laina-hou.
{ :i
	Huapuka kākau: (i + 1), laina-hou.
	((i + 1) > 4) hoʻomau.
	Huapuka kākau: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Huapuka laina-hou.
Huapuka kākau: ['Continue while-true, No --> before 5 and up.'], laina-hou.
{
	Huapuka kākau: ['iteration #'] + x, laina-hou.
	x hoʻohui-helu: 1.
	((x < 5) ʻaʻole-naʻe) hoʻomau.
	Huapuka kākau: ['-->'].
} ʻoiai: xIsLessThan10.
Huapuka laina-hou.
Huapuka kākau: ['Continue while-false, No - before 3 only.'], laina-hou.
{
	Huapuka kākau: ['iteration #'] + x, laina-hou.
	x hoʻemi: 1.
	(x = 3) hoʻomau.
	Huapuka kākau: ['-'].
} ʻoiai: { <- ( x > 0). }.

Huapuka laina-hou.
Huapuka kākau: ['Continue times-loop, No ||| before 3.'], laina-hou.
{ :i
	Huapuka kākau: ['iteration #'] + i, laina-hou.
	(i = 2) hoʻomau.
	Huapuka kākau: ['|||'].
} × 5.

Huapuka laina-hou.

{ ʻOiaʻiʻo hoʻomau. Huapuka kākau: ['dont write this!'], laina-hou. } hoʻomaka.

{ ʻOiaʻiʻo hoʻomau. Huapuka kākau: ['dont write this!'], laina-hou. } hopu: { Huapuka kākau: ['Dont catch this!']. }, hoʻomaka.

Huapuka kākau: ['Test Array each-loop: 0, ... ,2'], laina-hou.
(Papa ← 1 ; 2 ; 3) hoʻololi-pākahi: { :i
	(i = 1) hoʻomau.
	Huapuka kākau: ['iteration #'] + (i - 0), laina-hou.
}.

Huapuka kākau: ['Test Map each-loop: c only'], laina-hou.
>> m := Puke-wehewehe hou.
m waiho: ['first'] ma: ['a'], waiho: ['second'] ma: ['b'], waiho: ['third'] ma: ['c'].
m pākahi: { :k :v
	(k ≠ ['c']) hoʻomau.
	Huapuka kākau: ['iteration'] + k + v, laina-hou.
}.

