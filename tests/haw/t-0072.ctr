>> echo := Mea hou.
echo i: ['pane:'] hana: { :sound
	{ Huapuka kākau: sound. } × 2.
}.
echo ho!. 


echo := Mea hou.
echo i: ['pane:a:'] hana: { :sound :x
	{ Huapuka kākau: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Mea hou.
echo i: ['pane:a:a:'] hana: { :operation :sound :x
	{ Huapuka kākau: sound. } × x.
}.
echo shout: ['la'] times: 4. 


