Server init.
>> a := Blob hou: 4.
a bytes: ( Papa hou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob hou: 4.
b bytes: ( Papa hou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a hou.
{ 
>> n := a ^ c.
Huapuka kākau: ['xorred:'], laina-hou. 
Huapuka kākau: n, laina-hou. 
} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
a hoʻokuʻu.
b hoʻokuʻu.
