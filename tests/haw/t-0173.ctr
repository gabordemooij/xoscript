

Papa i: ['sum'] hana: {
	>> total := 0.
	iho pākahi: { :index :element
		total hoʻohui-helu: element.
	}. <- total.
}.

Papa i: ['product'] hana: {
	>> total := 1.
	iho pākahi: { :index :element
		total hoʻonui-me: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

{

>> a := Papa ← ['hello'] ; ['world'] ; ʻOiaʻiʻo ; ʻOle ; 666.
a := a + ( Papa ← 1 ).
Huapuka kākau: ( ['sum: '] + ( a sum ) ), laina-hou.
Huapuka kākau: ( ['min: '] + ( a liʻiliʻi-loa ) ), laina-hou.
Huapuka kākau: ( ['max: '] + ( a nui-loa ) ), laina-hou.
Huapuka kākau: ( ['3rd: '] + ( a ? 2 ) ), laina-hou.
Huapuka kākau: ( ['prd: '] + ( a product ) ), laina-hou.
a hoʻonohonoho-papa: { :a :b <- (b - a). }.
a pākahi: { :i :e Huapuka kākau: ( i - 0 ), laina-hou. }.

} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).


{

>> a := Papa ← ['hello'] ; ['world'] ; ʻOiaʻiʻo ; ʻOle ; 666.
a := a + ( Papa ← 1 ).
Huapuka kākau: ( ['sum: '] + ( a sum ) ), laina-hou.
Huapuka kākau: ( ['min: '] + ( a liʻiliʻi-loa ) ), laina-hou.
Huapuka kākau: ( ['max: '] + ( a nui-loa ) ), laina-hou.
Huapuka kākau: ( ['3rd: '] + ( a ? 2 ) ), laina-hou.
Huapuka kākau: ( ['prd: '] + ( a product ) ), laina-hou.
a hoʻonohonoho-papa: { :a :b <- (b - a). }.
a pākahi: { :i :e Huapuka kākau: ( i - 0 ), laina-hou. }.

} hoʻomaka.



Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).


{

>> a := Papa ← ['hello'] ; ['world'] ; ʻOiaʻiʻo ; ʻOle ; 666.
a := a + ( Papa ← 1 ).
Huapuka kākau: ( ['sum: '] + ( a sum ) ), laina-hou.
Huapuka kākau: ( ['min: '] + ( a liʻiliʻi-loa ) ), laina-hou.
Huapuka kākau: ( ['max: '] + ( a nui-loa ) ), laina-hou.
Huapuka kākau: ( ['3rd: '] + ( a ? 2 ) ), laina-hou.
Huapuka kākau: ( ['prd: '] + ( a product ) ), laina-hou.
a hoʻonohonoho-papa: { :a :b <- (b - a). }.
a pākahi: { :i :e Huapuka kākau: ( i - 0 ), laina-hou. }.

} hoʻomaka.



Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).

( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
