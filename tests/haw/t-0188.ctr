

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

{ :i Huapuka kākau: i. } × 4.
Huapuka laina-hou.
{ :i Huapuka kākau: (4 - i). } × 4.
Huapuka laina-hou.
( 1 > 2 ) wahaheʻe: { Huapuka kākau: ['BLOCK 1'], laina-hou. }.
( 2 > 1 ) ʻoiaʻiʻo:  { Huapuka kākau: ['BLOCK 2'], laina-hou. }.

>> i := 0.
{ Huapuka kākau: i. i hoʻohui-helu: 1. } ʻoiai: { <- ( i < 3). }.
Huapuka laina-hou.

i := 3.
{ Huapuka kākau: i. i := i - 1. } ʻoiai: { <- ( i > 0). }.
Huapuka laina-hou.


Polokalamu hoʻomaʻemaʻe.

usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).


{ :i  Huapuka kākau: i. } × 4.
Huapuka laina-hou.
{ :i  Huapuka kākau: (4 - i). } × 4.
Huapuka laina-hou.
( 1 > 2 ) wahaheʻe: { Huapuka kākau: ['BLOCK 1'], laina-hou. }.
( 2 > 1 ) ʻoiaʻiʻo:  { Huapuka kākau: ['BLOCK 2'], laina-hou. }.

>> i := 0.
{ Huapuka kākau: i. i hoʻohui-helu: 1. } ʻoiai: { <- ( i < 3). }.
Huapuka laina-hou.

i := 3.
{ Huapuka kākau: i. i := i - 1. } ʻoiai: { <- ( i > 0). }.
Huapuka laina-hou.



Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).


{ :i Huapuka kākau: i. } × 4.
Huapuka laina-hou.
{ :i Huapuka kākau: (4 - i). } × 4.
Huapuka laina-hou.
( 1 > 2 ) wahaheʻe: { Huapuka kākau: ['BLOCK 1'], laina-hou. }.
( 2 > 1 ) ʻoiaʻiʻo:  { Huapuka kākau: ['BLOCK 2'], laina-hou. }.

>> i := 0.
{ Huapuka kākau: i. i hoʻohui-helu: 1. } ʻoiai: { <- ( i < 3). }.
Huapuka laina-hou.

i := 3.
{ Huapuka kākau: i. i := i - 1. } ʻoiai: { <- ( i > 0). }.
Huapuka laina-hou.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
