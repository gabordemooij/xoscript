>> Animal := Mea hou.
>> Factory := Mea hou.

Animal i: ['hou'] hana: {
	>> animal := iho hou.
	animal sound: ['?']. <- animal.
}.

Animal i: ['sound:'] hana: { :s
	ponoʻī sound := s.
}.

Animal i: ['sound'] hana: { <- ponoʻī sound.
}.

>> Dog := Mea hou.
>> Cat := Mea hou.

Dog i: ['hou'] hana: { <- Animal hou sound: ['woof!'].
}.

Cat i: ['hou'] hana: { <- Animal hou sound: ['meow!'].
}.

Huapuka kākau: Dog hou sound, laina-hou.
Huapuka kākau: Cat hou sound, laina-hou.

Factory i: ['mix:and:'] hana: { :beast1 :beast2 <- Animal hou sound: (
		( beast1 sound mai: 0 lōʻihi: 2 ) +
		( beast2 sound mai: 2 lōʻihi: 5 )
	).
}.

Huapuka kākau: (Factory mix: Dog hou and: Cat hou) sound, laina-hou.
