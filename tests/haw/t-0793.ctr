Server init.

>> DB := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'],
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

{
	DB nīnau:
	['DROP TABLE movies'],
	hoʻokō.
} hopu: { ʻOle. }, hoʻomaka.

DB nīnau:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
hoʻokō.

DB nīnau: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
nā-koina: ( Papa hou ; ['Halloween'] ),
hoʻokō.

DB nīnau: ['SELECT * FROM movies'],
kiʻi: { :movie
	Huapuka kākau: movie title, laina-hou.
}.

