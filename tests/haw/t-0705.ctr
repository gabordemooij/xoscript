

>> obj := Mea hou.

obj i: ['greet'] hana: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj i: ['task'] hana: {
	ponoʻī property := 123.
	{
		# try binds self/own to object instead of block
		Huapuka kākau: iho greet.
		Huapuka kākau: ponoʻī property.
		1 / 0.
	} hopu: {
		Huapuka kākau: iho greet.
		Huapuka kākau: ponoʻī property.
		Huapuka kākau: ['ok'].
	}, hoʻāʻo-hana.
}.

obj task.