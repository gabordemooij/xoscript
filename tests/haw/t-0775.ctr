Huapuka kākau: ['Test object'], laina-hou.
>> l := Papa hou ; 1 ; ( Papa hou ; (Manawa hou: 1) ; (Int64 mai-ke-kaula: ['321']) ; (Papa hou ; 3)).
Huapuka kākau: l, laina-hou.
>> old-lst-address := l kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
l save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-lst-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.
Huapuka kākau: b, laina-hou.
