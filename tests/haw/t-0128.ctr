
Papa i: ['sum'] hana: {
	>> total := 0.
	iho pākahi: { :index :element
		total hoʻohui-helu: element.
	}. <- total.
}.

>> a := Papa ← 9 ; 8 ; 7.
Huapuka kākau: (a sum), laina-hou. 
>> a := Papa ← 1 ; 9.
Huapuka kākau: (a sum), laina-hou. 
>> a := Papa ← ['o'] ; 2.
Huapuka kākau: (a sum), laina-hou. 
Huapuka kākau: (Papa hou sum), laina-hou. 
