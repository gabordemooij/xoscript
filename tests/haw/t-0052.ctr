>> items := Puke-wehewehe hou.
items waiho: ['green'] ma: ['color-1'].
items waiho: ['orange'] ma: ['color-2'].
items waiho: ['red'] ma: ['color-3'].
>> i := 0.
>> s := [''].
items pākahi: { :key :color
	Huapuka kākau: ['color #'] + i + [' is: '] + color + [' '].
	i hoʻohui-helu: 1.
}.
Huapuka kākau: i + [' colors!'].
