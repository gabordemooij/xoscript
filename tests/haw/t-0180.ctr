Kaula i: ['html'] hana: { <- (
		iho
		pani: ['&'] me: ['&amp;'],
		pani: ['<'] me: ['&lt;'],
		pani: ['>'] me: ['&gt;'],
		pani: ['''] me: ['&apos;'],
		pani: ['"'] me: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huapuka kākau: txt kope html, laina-hou.
Huapuka kākau: txt kope naʻinaʻi, laina-hou.
Huapuka kākau: txt kope maʻaka, laina-hou.
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.

usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huapuka kākau: txt kope html, laina-hou.
Huapuka kākau: txt kope naʻinaʻi, laina-hou.
Huapuka kākau: txt kope maʻaka, laina-hou.
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Huapuka kākau: txt kope html, laina-hou.
Huapuka kākau: txt kope naʻinaʻi, laina-hou.
Huapuka kākau: txt kope maʻaka, laina-hou.
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
