# compliance test

# use international numbers

Huapuka kākau: ['1000 -> '].
Huapuka kākau: 1000, laina-hou. #1000

Huapuka kākau: ['1.5 -> '].
Huapuka kākau: 1.5, laina-hou.  #1.5

Huapuka kākau: ['1001.5 -> '].
Huapuka kākau: 1.5 + 1000, laina-hou. #1001.5

# use 0-indexed arrays
>> x := Papa hou ; 1 ; 2 ; 3.
>> y := Papa hou ; ['a'] ; ['b'] ; ['c'].

Huapuka kākau: ['1 -> '].
Huapuka kākau: x ? 0, laina-hou. #1

Huapuka kākau: ['1 -> '].
Huapuka kākau: (x i: 0), laina-hou. #1

Huapuka kākau: ['1 -> '].
Huapuka kākau: x mua, laina-hou. #1

Huapuka kākau: ['3 -> '].
Huapuka kākau: x hope, laina-hou. #3

Huapuka kākau: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Huapuka kākau: (x ma-o: y), laina-hou.

Huapuka kākau: ['1 -> '].
Huapuka kākau: (x mai: 0 lōʻihi: 1) mua, laina-hou. #1

Huapuka kākau: ['0 -> '].
Huapuka kākau: (x huli: 1), laina-hou. #0

x waiho: 9 ma: 0.

Huapuka kākau: ['9 -> '].
Huapuka kākau: (x i: 0), laina-hou. #9

x pākuʻi-mua: 8.
Huapuka kākau: ['8 -> '].
Huapuka kākau: (x i: 0), laina-hou. #9


x pākuʻi-hope: 10.
Huapuka kākau: ['10 -> '].
Huapuka kākau: (x i: 4), laina-hou. #10








