# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Pahu-kūʻono hana-kī.

# private (secret) key
>> sk := keys mua.

# public key
>> pk := keys hope.

# sign a message
>> sig := Pahu-kūʻono kākau-inoa: ['abc'] me: sk.

# check message (ok)
Huapuka kākau: ( 
	Pahu-kūʻono
		nānā: ['abc'] 
		pūlima: sig 
		me: pk 
), laina-hou.

# check message (fail)
Huapuka kākau: ( 
	Pahu-kūʻono 
		nānā: ['abd'] 
		pūlima: sig 
		me: pk 
), laina-hou.