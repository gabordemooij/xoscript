Server init.
Huapuka kākau: ['Database time test'], laina-hou.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'], 
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli :=
db nīnau: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
kiʻi: { :row
	Huapuka kākau: row timetest, laina-hou.
}.
