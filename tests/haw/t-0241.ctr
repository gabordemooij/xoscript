

Kaula i: ['evaluate'] hana: {
	>> pāʻālua := Waihona hou: ['/tmp/eval.ctr'].
	pāʻālua kākau: (iho kaula + ['.']).
	Polokalamu hoʻohana: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Papa ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q kaula.
Huapuka kākau: x, laina-hou.
>> y := ʻOle.
(['y := '] + x ) evaluate.
Huapuka kākau: y ? 0, laina-hou.

q := Puke-wehewehe waiho: ['\[''] ma: ['\['quote\']'].
x := q kaula.
Huapuka kākau: x, laina-hou.
y := ʻOle.
(['y := '] + x ) evaluate.

>> q := (Puke-wehewehe hou) waiho:['\[''] ma:['\['quote\[''].
Huapuka kākau: y ? ['\['quote\']'], laina-hou.
