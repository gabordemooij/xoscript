Helu i: ['roman'] hana: {
	>> helu := iho kope.
	>> roman := [''].
	{
		{
			(helu ≥ 1000) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅿ'].
				helu hoʻemi: 1000.
			}, hoʻōki.
		
			(helu ≥ 500) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅾ'].
				helu hoʻemi: 500.
			}, hoʻōki.
		
			(helu ≥ 100) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅽ'].
				helu hoʻemi: 100.
			}, hoʻōki.
		
			(helu ≥ 50) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅼ'].
				helu hoʻemi: 50.
			}, hoʻōki.
		
			(helu ≥ 50) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅼ'].
				helu hoʻemi: 50.
			}, hoʻōki.
		
			(helu ≥ 10) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅹ'].
				helu hoʻemi: 10.
			}, hoʻōki.
			
			(helu ≥ 9) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅸ'].
				helu hoʻemi: 9.
			}, hoʻōki.
			
			(helu ≥ 5) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅴ'].
				helu hoʻemi: 5.
			}, hoʻōki.
			
			(helu ≥ 4) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅳ'].
				helu hoʻemi: 4.
			}, hoʻōki.
			
			(helu ≥ 1) ʻoiaʻiʻo: {
				roman pākuʻi-hope: ['Ⅰ'].
				helu hoʻemi: 1.
			}, hoʻōki.
		} kaʻina-hana.
	} ʻoiai: { <- helu > 0. }. <- roman.
}.

Huapuka kākau: 1 roman, laina-hou.
Huapuka kākau: 2 roman, laina-hou.
Huapuka kākau: 4 roman, laina-hou.
Huapuka kākau: 8 roman, laina-hou.
