Server init.
>> f := Hōʻano hou: ['%d'].
>> a := Blob hou: 4.
a bytes: ( Papa hou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob hou: 4.
b bytes: ( Papa hou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a mai: 0 lōʻihi: 3, pākahi: { :i :byte
	Huapuka kākau: ( f hoʻopili-helu-piha: byte ), laina-hou.
}.
a ^ b.
a mai: 0 lōʻihi: 3, pākahi: { :i :byte
	Huapuka kākau: ( f hoʻopili-helu-piha: byte ), laina-hou.
}.
a ^ b.
a mai: 0 lōʻihi: 3, pākahi: { :i :byte
	Huapuka kākau: ( f hoʻopili-helu-piha: byte ), laina-hou.
}.
a hoʻokuʻu.
b hoʻokuʻu.

{ a ^ Mea. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
