# test catch-all methods
>> x13 := Mea hou.
x13 i: ['a'] hana: { :a Huapuka kākau: 0, laina-hou. }.
x13 i: ['a:'] hana: { :a Huapuka kākau: a, laina-hou. <- 5. }.
x13 i: ['a:b:'] hana: { :a :b Huapuka kākau: (a + b), laina-hou. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
