>> V := Mea.
V i: ['kaula'] hana: {
	Huapuka kākau: ['cast'], laina-hou. <- ['abc'].
}.

Huapuka kākau: ( Polokalamu hoʻonohonoho: ['abc'] ), laina-hou.

# params should not get gc'ed
Polokalamu hoʻonohonoho: ([''] + V hou) waiwai: ([''] + V hou).

Huapuka kākau: ( Polokalamu hoʻonohonoho: ['abc'] ), laina-hou.
