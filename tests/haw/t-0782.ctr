Huapuka kākau: ['Test object'], laina-hou.
>> cmd := Kauoha hou.
Huapuka kākau: cmd ls /tmp, laina-hou.
>> old-cmd-address := cmd kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
cmd save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-cmd-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.
Huapuka kākau: b ls, laina-hou.


