# backslashes must survive code serialization, strings must not end early
>> nā-waiwai := Papa hou
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

nā-waiwai pākahi: { :i :value
	>> d := Puke-wehewehe hou.
	d waiho: value ma: ['k'].
	>> r := d pāʻālua mea.
	Huapuka kākau: r heluna, laina-hou.
	Huapuka kākau: ( (r i: ['k']) = value ), laina-hou.
}.
