#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Lauana hou: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern kūlike: subject hana: { :m :x
	Huapuka kākau: m, laina-hou.
	Huapuka kākau: x, laina-hou. <- ['XXX'].
}.
Huapuka kākau: result, laina-hou.