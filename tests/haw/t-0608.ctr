
>> Size := Mea hou.
Size i: ['is:'] hana: { :helu
	helu i: ['+'] hana: { :helu
		>> unit := helu anakahi-helu.
		>> factor := 1.
		
		unit
		hihia: ['inch'] hana: { factor := 0.0833. }. <- iho + (helu * factor).
	}. <- helu.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Huapuka kākau: plank + edge, laina-hou.
