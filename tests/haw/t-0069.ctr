

Kaula i: ['html'] hana: { <- (
		iho
		pani: ['&'] me: ['&amp;'],
		pani: ['<'] me: ['&lt;'],
		pani: ['>'] me: ['&gt;'],
		pani: ['"'] me: ['&quot;']
	).
}.


Huapuka kākau: ([' left trimmed '] ʻoki-hakahaka) + [' '] + ( ['and right trimmed'] ʻoki-hakahaka) + ['!'], laina-hou.
Huapuka kākau: ['<html>"html & entities"</html>'] html.
