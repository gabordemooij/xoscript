>> randomizer := { :a :b
	>> liʻiliʻi-loa := ( a < b ) a-i-ʻole: a a-i: b.
	>> nui-loa := ( a > b ) a-i-ʻole: a a-i: b.
	>> x := ʻOle.
	{
		x := Helu mawaena: a a: b.
		((x < liʻiliʻi-loa) a-i-ʻole: (x > nui-loa)) ʻoiaʻiʻo: { 
			Huapuka kākau: (['Invalid value!']).
			Polokalamu pau.
		}.
	} 
	× 100. <- x.
}.
randomizer hoʻopili: 0 a: 0.
randomizer hoʻopili: 1 a: 0.
randomizer hoʻopili: 1 a: 1.
randomizer hoʻopili: 0 a: 1.
randomizer hoʻopili: -1 a: 0.
randomizer hoʻopili: -1 a: -1.
randomizer hoʻopili: 0 a: -1.
randomizer hoʻopili: 100 a: 200.
randomizer hoʻopili: 999999999999998 a: 999999999999999.
randomizer hoʻopili: 999999999999999 a: 999999999999998.
randomizer hoʻopili: 999999999999999 a: 999999999999999.
randomizer hoʻopili: -999999999999998 a: -999999999999999.
randomizer hoʻopili: -999999999999999 a: -999999999999998.
randomizer hoʻopili: -999999999999999 a: -999999999999999.
randomizer hoʻopili: 999999999999998 a: -999999999999999.
randomizer hoʻopili: 999999999999999 a: -999999999999998.
randomizer hoʻopili: 999999999999999 a: -999999999999999.
randomizer hoʻopili: -999999999999998 a: 999999999999999.
randomizer hoʻopili: -999999999999999 a: 999999999999998.
randomizer hoʻopili: -999999999999999 a: 999999999999999.
Huapuka kākau: ['OK'].


