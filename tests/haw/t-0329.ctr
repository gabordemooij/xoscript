Huapuka kākau: ((Papa hou
	i: ['plaque:'] hana: { :x ponoʻī o := x. },
	i: ['plaque']  hana: { <- ponoʻī o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Papa ← 1)
	~ (Papa ← 1 ; 2)
	~ (Papa ← 1 ; 2 ; 3)
	~ (Papa ← 1 ; 2 ; 3 ; 4)
	~ (Papa ← 1 ; 2 ; 3 ; 4 ; 5)
) pākahi: { :i :el
	{ Huapuka kākau: kēia-hana. } × el heluna.
	Huapuka laina-hou.
}) plaque, laina-hou.


