Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 
a i: ['item:'] hana: { :int64
	ponoʻī int64 := int64. 
}.
a i: ['item'] hana: { <- ponoʻī int64.
}.
a item: ( Int64 mai-ke-kaula: ['9999'] ).
Huapuka kākau: a item, laina-hou.
>> old-int64-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-int64-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.
Huapuka kākau: ( b item ), laina-hou.
