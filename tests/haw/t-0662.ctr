>> t := ʻOle.

# you can control the time zone for
# parsing like this:
Manawa zona: ['CET'].
t := Manawa kumu: ['1981-02-03 04:05:06'].
Huapuka kākau: t, laina-hou.

# now using CEST time zone:
Manawa zona: ['CEST'].
t := Manawa kumu: ['1981-02-03 04:05:06'].
Huapuka kākau: t, laina-hou.

# error if string cannot be parsed
{ Manawa kumu: ['1900']. } hopu: { ʻOle. }, hoʻomaka.
