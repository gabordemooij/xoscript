# test url parsing

Server init.
>> url := URL kumu: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Huapuka kākau: ['scheme = '] + url papa-hana-helu-wahi, laina-hou.
Huapuka kākau: ['host = '] + url hoʻokipa, laina-hou.
Huapuka kākau: ['port = '] + url awa, laina-hou.
Huapuka kākau: ['path = '] + url ala-waihona, laina-hou.
Huapuka kākau: ['query = '] + url nā-koina-huli, laina-hou.
Huapuka kākau: ['fragment = '] + url ʻāpana, laina-hou.
