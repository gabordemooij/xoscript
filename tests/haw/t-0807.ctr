# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'],
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli := db nīnau: ['SELECT %% FROM'].
{ nā-koina-huli hoʻokō. } hopu: { :e
	Huapuka kākau: ( e aia-i-loko: ['%%'] ), laina-hou.
}, hoʻomaka.
