Server init.
Huapuka kākau: ['Database date test'], laina-hou.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'], 
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli :=
db nīnau: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
kiʻi: { :row
	Huapuka kākau: row datetest, laina-hou.
}.
