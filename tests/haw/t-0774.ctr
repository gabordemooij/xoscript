Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 
a i: ['item:'] hana: { :lst
	ponoʻī lst := lst. 
}.
a i: ['item'] hana: { <- ponoʻī lst.
}.
a item: (
	Papa hou ; 1 ; (
		Papa hou ; ['a'] ; (
			Papa hou ; ( Manawa hou: 1 )
		) ; ( Int64 mai-ke-kaula: ['321'] )
	)
).
Huapuka kākau: a item, laina-hou.
>> old-lst-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-lst-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.
Huapuka kākau: ( b item ), laina-hou.
