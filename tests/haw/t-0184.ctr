

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

Helu i: ['addNum:'] hana: { :x
	iho hoʻohui-helu: x.
}.

Helu i: ['subtractNum:'] hana: { :x
	iho hoʻemi: x.
}.

Helu i: ['multiplyBy:'] hana: { :x
	iho hoʻonui-me: x.
}.

Helu i: ['divideBy:'] hana: { :x
	iho puʻunaue-me: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana: 8).  
a := a + (2 mana: -1). 
a := a + (49 kumu-pāhoʻonui-lua).   
a addNum: ((Papa ← 0 ; 1) nui-loa).          
a addNum: ((Papa ← 2 ; 3) liʻiliʻi-loa).
Huapuka kākau: a.

Polokalamu hoʻomaʻemaʻe.

usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana: 8).  
a := a + (2 mana: -1). 
a := a + (49 kumu-pāhoʻonui-lua).   
a addNum: ((Papa ← 0 ; 1) nui-loa).          
a addNum: ((Papa ← 2 ; 3) liʻiliʻi-loa).
Huapuka kākau: a.

Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana: 8).  
a := a + (2 mana: -1). 
a := a + (49 kumu-pāhoʻonui-lua).   
a addNum: ((Papa ← 0 ; 1) nui-loa).          
a addNum: ((Papa ← 2 ; 3) liʻiliʻi-loa).
Huapuka kākau: a.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
