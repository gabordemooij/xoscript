>> To-Do := Mea hou.

To-Do i: ['hou'] hana: {
	ponoʻī list := Papa hou.
}.

To-Do i: ['nieuw'] hana: {
	ponoʻī list := Papa hou.
}.

To-Do i: ['+'] hana: { :task
	ponoʻī list pākuʻi-hope: task.
}.

To-Do i: ['number of tasks?'] hana: { <-  ponoʻī list heluna.
}.

>> todos := 
	To-Do hou 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Huapuka kākau: ['You have $ tasks to do'] $ todos number of tasks?.
