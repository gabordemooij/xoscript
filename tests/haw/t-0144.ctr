



>> CoffeeGrounds := Mea hou.
CoffeeGrounds i: ['extract'] hana: { <- ['coffee']. }.

>> CoffeeMachine := Mea hou.
CoffeeMachine i: ['init'] hana: {
	ponoʻī coffeegrounds := CoffeeGrounds hou.
}.
CoffeeMachine i: ['hou'] hana: { <- CoffeeMachine `new init.
}.

CoffeeMachine i: ['makeTea'] hana: { <- (ponoʻī tealeaves extract). }.
CoffeeMachine i: ['makeCoffee'] hana: { <- (ponoʻī coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine hou.

Huapuka kākau:
	coffeeDream 
	makeCoffee.

Huapuka kākau:
	coffeeDream 
	makeTea.
