Boolean i: ['xor:'] hana: { :b <- ((iho a: b ʻaʻole-naʻe) a-i-ʻole: (iho ʻaʻole-naʻe a: b)).
}.

Huapuka kākau: ['Length is:'] + ['ABCD'] lōʻihi.
>> x := ['ABCDE'].

Huapuka kākau: ['Length is:'] + x lōʻihi.
((['ABC'] lōʻihi + 1 = 4) a: (2 ≠ 3)) ʻaʻole-naʻe ʻaʻole-naʻe ʻoiaʻiʻo: { Huapuka kākau: ['Yes']. }.
(((3 > 4) a-i-ʻole: (4 > 2)) a: (ʻOiaʻiʻo a-i-ʻole: Wahaheʻe), a: (ʻOiaʻiʻo xor: ʻOiaʻiʻo) ʻaʻole-naʻe ) ʻoiaʻiʻo: { Huapuka kākau: ['Yes']. }.
{ Huapuka kākau: ['Running']. } hoʻomaka.
