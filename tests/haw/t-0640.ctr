
Server init.
Huapuka kākau: ['Database test'], laina-hou.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'], 
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli :=
db nīnau: ['SELECT UNHEX('CAFE') AS blobby'],
kiʻi: { :row
	Huapuka kākau: ( row blobby mai: 0 lōʻihi: 2 ), laina-hou.
	row blobby hoʻokuʻu.
}.
