>> a := Papa ← 1 ; 2 ; 3 ; 4.
>> c := Mea hou.
c i: ['greet:'] hana: { Huapuka kākau: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

