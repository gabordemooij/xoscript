#OBSD
>> dirname := [''].
{ dirname pākuʻi-hope: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Polokalamu ʻōnaehana: command.
Polokalamu chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename pākuʻi-hope: ['YYYYYYYY']. } * 20.
Waihona hou: filename, kākau: ['sometext'].
{ Waihona papa: ['/tmp/'] + dirname. } * 1000.
Huapuka kākau: ['no crash'], laina-hou.

