>> Grandfather := Mea hou.
Grandfather i: ['greet'] hana: {
	Huapuka kākau: ['Ave!'], laina-hou.
}.
>> Father := Grandfather hou.
Father i: ['greet'] hana: {
	Huapuka kākau: ['Hello'], laina-hou.
	iho greet.
}.
>> Son := Father hou.
Son i: ['greet'] hana: {
	Huapuka kākau: ['Hi'], laina-hou.
	iho greet.
}.

Son greet.

>> Roundabout := Mea hou.
Roundabout i: ['circle:'] hana: { :x
	Huapuka kākau: x, laina-hou.
	(x < 3) ʻoiaʻiʻo: { iho kāhea-iā-ia-iho circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ʻoiaʻiʻo: { Huapuka kākau: x, laina-hou. x hoʻohui-helu: 1.  increment hoʻomaka. }. }.
increment hoʻomaka.