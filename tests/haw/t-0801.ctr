Server init.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'],
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> del := db nīnau: ['DELETE FROM book WHERE id > 0'].
{  del hoʻokō. db hoʻopaʻa. } hopu: { :e db hoʻihoʻi-hope.  }, hoʻomaka.

>> heluna := db nīnau: ['SELECT COUNT(*) AS num FROM book'].
heluna kiʻi: { :row Huapuka kākau: row num, laina-hou. }.
