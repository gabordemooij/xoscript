# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Polokalamu shell-escape: ['abc'].
Huapuka kākau: c, laina-hou.
Huapuka kākau: ( Polokalamu ʻōnaehana: ['echo '] + c ), laina-hou.

c := Polokalamu shell-escape: ['a'b'c'].
Huapuka kākau: c, laina-hou.
Huapuka kākau: ( Polokalamu ʻōnaehana: ['echo '] + c ), laina-hou.

c := Polokalamu shell-escape: ['a\'c'].
Huapuka kākau: c, laina-hou.
Huapuka kākau: ( Polokalamu ʻōnaehana: ['echo '] + c ), laina-hou.