# test qualifiers

Polokalamu hoʻomaʻemaʻe.

>> Fruit := Mea hou.
Fruit i: ['hou'] hana: {
	>> f := iho hou.
	f apples: 0. <- f.
}.
Fruit i: ['apples:'] hana: { :a ponoʻī apples := a. }.
Fruit i: ['apples'] hana: { <- ponoʻī apples. }.
Fruit i: ['+'] hana: { :f
	>> n := Fruit hou.
	n apples: (f apples + ponoʻī apples). <- n.
}.
Helu i: ['apples'] hana: { <- ((Fruit hou) apples: iho).
}.

Fruit i: ['kaula'] hana: { <- ponoʻī apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Huapuka kākau: q, laina-hou.




q := 3 apples + 4 apples.
Huapuka kākau: q, laina-hou.



q := 3 apples + 4 apples.
Huapuka kākau: q, laina-hou.


