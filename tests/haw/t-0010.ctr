>> Animal := Mea hou.
Animal i: ['make'] hana: {
	>> animal := Mea hou.
	animal i: ['makeSound'] hana: {
		Huapuka kākau: ponoʻī sound.
	}. <- animal.
}.
>> Cat := Mea hou.
Cat i: ['make'] hana: {
	>> cat := Animal make.
	cat i: ['init'] hana: {
		ponoʻī sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
