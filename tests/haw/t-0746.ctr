Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :dict
	ponoʻī dict := dict. 
}.

a i: ['item'] hana: { <- ponoʻī dict.
}.

a item: (
Puke-wehewehe hou
	hello: ['world'],
	world: (Puke-wehewehe hou waiho: ['a'] ma: ['b'])).

Huapuka kākau: a item, laina-hou.

>> old-dict-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-dict-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

Huapuka kākau: b item, laina-hou.
