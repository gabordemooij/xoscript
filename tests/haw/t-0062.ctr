Boolean i: ['xor:'] hana: { :a :b <- ((a a: b ʻaʻole-naʻe) a-i-ʻole: (a ʻaʻole-naʻe a: b)).
}.

>> o := Mea hou.
o i: ['hello'] hana: { ['Empty']. }.
{ o i: 2 hana: 3.} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
{ o i: ['hoʻāʻo'] hana: 3.} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
{ o i: ['hello'] hana: { ['Empty']. }.} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ >> z := 4 ÷ 0. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ (ʻOiaʻiʻo a: ʻOle) ʻoiaʻiʻo: { Huapuka kākau: ['X'].}. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ ([''] xor: 0) ʻoiaʻiʻo: { Huapuka kākau: ['X'].}. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ (1 < ['2']) ʻoiaʻiʻo: { Huapuka kākau: ['OK']. }. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ (1 < ['2.0']) ʻoiaʻiʻo: { Huapuka kākau: ['OK']. }. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ (1 < ['x2.0']) ʻoiaʻiʻo: { Huapuka kākau: ['NO!']. }. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka. 
{ Huapuka kākau: (['hello OK there'] mai: ['6'] lōʻihi: ['2']). } hoʻomaka. 
