# edge cases from a request must give an error or a result, not a crash
Server init.

Huapuka kākau: ['<'] + (['abc'] mai: 0 lōʻihi: 0, maʻaka) + ['>'], laina-hou.
Huapuka kākau: ['<'] + (['abc'] mai: 0 lōʻihi: 0, naʻinaʻi) + ['>'], laina-hou.
Huapuka kākau: ['<'] + (['abc'] lele: 3, maʻaka) + ['>'], laina-hou.
Huapuka kākau: [''] maʻaka bytes, laina-hou.
Huapuka kākau: ['aB'] maʻaka, laina-hou.
Huapuka kākau: ['aB'] naʻinaʻi, laina-hou.

Huapuka kākau: (Manawa hou: 0) makahiki, laina-hou.
{ Manawa hou: ['9e300'] helu. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
{ Manawa hou: ['-9e300'] helu. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
{ Manawa hou: ['nan'] helu. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
{ Manawa hou: 9000000000000000000. } hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
