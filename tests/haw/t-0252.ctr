#Linux
>> clock := Manawa hou.
clock zona: ['UTC-1'].
clock makahiki: 1981, mahina: 1, lā: 5,
      hola: 13, minuke: 15, kekona: 13.

Huapuka kākau: clock, laina-hou.
clock zona: ['UTC+0'].

Huapuka kākau: (
	(clock makahiki maʻalahi) + ['-'] + (clock mahina) + ['-'] + (clock lā) + [' '] +
	(clock hola) + [':'] + (clock minuke) + [':'] + (clock kekona) + [' '] +
	['W'] + (clock pule) + (clock zona)
), laina-hou.


clock zona: ['UTC-1'].
Huapuka kākau: (
	(clock makahiki maʻalahi) + ['-'] + (clock mahina) + ['-'] + (clock lā) + [' '] +
	(clock hola) + [':'] + (clock minuke) + [':'] + (clock kekona) + [' '] +
	['W'] + (clock pule) + (clock zona)
), laina-hou.
