>> Slurp := Mea hou.
Slurp i: ['hou'] hana: {
	ponoʻī str := [''].
}.


Slurp i: ['pane:'] hana: { :blah
		(ponoʻī str ≠ ['']) ʻoiaʻiʻo: {
			ponoʻī str pākuʻi-hope: [' '].
		}.
		ponoʻī str pākuʻi-hope: blah.
}.
Slurp i: ['pane:a:'] hana: { :blah :blahah
		(ponoʻī str ≠ ['']) ʻoiaʻiʻo: {
			ponoʻī str pākuʻi-hope: [' '].
		}.
		(blah lōʻihi > 1) ʻoiaʻiʻo: {
			ponoʻī str pākuʻi-hope: (blah mai: 0 lōʻihi: (blah lōʻihi - 1)).
		}, ʻi-ole-ia: {
			ponoʻī str pākuʻi-hope: blah.
		}.
		ponoʻī str pākuʻi-hope: [' '].
		ponoʻī str pākuʻi-hope: blahah.
}.
Slurp i: ['obtain'] hana: {
	>> buffer := ponoʻī str.
	ponoʻī str := ['']. <- buffer.
}.

>> nā-koina-huli := Slurp hou.
nā-koina-huli select: ['*'], from users where: ['id = 2'].
Huapuka kākau: (nā-koina-huli obtain), laina-hou.
