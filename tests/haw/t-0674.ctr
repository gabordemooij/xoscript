# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ala-waihona := ['/tmp/dat.csv'].
>> csv := Waihona hou: ala-waihona.
csv kākau: s.

# accepts CRLF LF CR, varying row length
csv hoʻokaʻawale: [';'] kaha-puanaʻī: ['"'] nā-laina: { :line
	Polokalamu hoʻomaʻemaʻe.
	Huapuka kākau: line, laina-hou.
	Polokalamu hoʻomaʻemaʻe.
}.

# unequal lines
s pākuʻi-hope: ['\njustone'].
csv kākau: s.
{
	csv hoʻokaʻawale: [';'] kaha-puanaʻī: ['"'] nā-laina: { :line
		Huapuka kākau: line, laina-hou.
	}.
} hopu: { :e 
	Huapuka kākau: e, laina-hou.
}, hoʻomaka.

# invalid format
s := ['"he"llo";world'].
csv kākau: s.
{
	csv hoʻokaʻawale: [';'] kaha-puanaʻī: ['"'] nā-laina: { :line
		Huapuka kākau: line, laina-hou.
	}.
} hopu: { :e 
	Huapuka kākau: e, laina-hou.
}, hoʻomaka.
