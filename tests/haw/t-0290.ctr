# test list operations


>> cakes := Papa ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes pani: 1 lōʻihi: 2 me: ( Papa ← ['cinnamon'] ; ['pineapple'] ).
Huapuka kākau: (buy hoʻohui: [',']), laina-hou.


>> buy := cakes pani: 1 lōʻihi: 12 me: ( Papa ← ['cinnamon'] ; ['pineapple'] ).
Huapuka kākau: (buy hoʻohui: [',']), laina-hou.


>> buy := cakes pani: 2 lōʻihi: 10 me: ( Papa hou ).
Huapuka kākau: (buy hoʻohui: [',']), laina-hou.


>> buy := cakes pani: 0 lōʻihi: 1 me: ( Papa hou ).
Huapuka kākau: (buy hoʻohui: [',']), laina-hou.


>> buy := cakes pani: ['0'] lōʻihi: ['1'] me: ['x'].
Huapuka kākau: (buy hoʻohui: [',']), laina-hou.
