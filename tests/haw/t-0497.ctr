Server init.

# write a test file
>> f := Waihona hou: ['/tmp/test.gif'].
f kākau: ['GIF87a01234567810'].

# serve the file
Server hoʻoili: ['test.gif'] pākuʻina-mua: ['/tmp/'].

Huapuka laina-hou.

Huapuka kākau: ['Outside container (security):'], laina-hou.
{ Server hoʻoili: ['../passwd'] pākuʻina-mua: ['/tmp/']. }
hopu: { :e Huapuka kākau: e, laina-hou. },
hoʻomaka.

Huapuka kākau: ['Invalid prefix:'], laina-hou.
{ Server hoʻoili: ['test.gif'] pākuʻina-mua: ['z:\\']. }
hopu: { :e Huapuka kākau: e, laina-hou. },
hoʻomaka.

Huapuka kākau: ['Non-existant file:'], laina-hou.
{ Server hoʻoili: ['xxx.xxx'] pākuʻina-mua: ['/tmp/']. }
hopu: { :e Huapuka kākau: e, laina-hou. },
hoʻomaka.
