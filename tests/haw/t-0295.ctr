
>> dictionary := (
	Puke-wehewehe hou
		waiho: ['b'] ma: ['a'],
		waiho: ['a'] ma: ['b'],
		waiho: ['z'] ma: ['x'],
		waiho: ['hello'] ma: ['hallo'],
		waiho: ['human'] ma: ['human']
).

>> comparisons := Papa hou.
dictionary pākahi: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a hoʻohālikelike: b)
	).
}.

comparisons hoʻonohonoho-papa: { :a :b <- ( a hoʻohālikelike: b ). }.
Huapuka kākau: ( comparisons hoʻohui: ['↵'] ), laina-hou.
comparisons hoʻohui: ['↵'].
