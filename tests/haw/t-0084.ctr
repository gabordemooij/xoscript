>> makeAdder := { :x
	>> f := { :y <- (ponoʻī x + y). } kau: ['x'] waiwai: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ponoʻī q waiho: (ponoʻī f hoʻopili: (ponoʻī q ? i)) ma: i. } 
	kau: ['q'] waiwai: array,
	kau: ['f'] waiwai: func.
	{ :i mapping hoʻopili: i. } × (array heluna).
}.

>> a := Papa ← 1; 2; 3.
mapper hoʻopili: a a: (makeAdder hoʻopili: 100).
Huapuka kākau: (a kūlana: 0), laina-hou.
Huapuka kākau: (a ? 1), laina-hou.
Huapuka kākau: (a ? 2), laina-hou.
