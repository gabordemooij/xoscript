# test number -> string -> number
{

	>> x := Helu mawaena: 0 a: 1000000.
	>> d := Helu mawaena: 1 a: 7.
	>> e := 10 mana: d.

	x puʻunaue-me: e.
	>> y := x kaula helu.

	(x = y) wahaheʻe: {
		Huapuka kākau: x, laina-hou.
		Huapuka kākau: y, laina-hou.
		Polokalamu pau.
	}.

} * 1000.
Huapuka kākau: ['OK'], laina-hou.