

Papa i: ['fixture:'] hana: { :f
	ponoʻī fixture := f.
}.

Papa i: ['heluna'] hana: { <- ponoʻī fixture.
}.

Papa i: ['aantal'] hana: { <- ponoʻī fixture.
}.


>> x := ʻOle.
{

	x := ['hello'] 
	pani:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] hua: 2)
			)
		)
	me: (
		(['...hal'] + ['lo']) 
			maʻaka 
			lowecase 
			maʻaka 
			lele: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Papa ← 0 ; 1 ; 4; 9 ; (Papa ← 0 ; 3; 1) ; 4
							) ma-mua-o-ka-hope
						) ? 1
					) + 
					((Papa ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					heluna
				)
			)
	).

} × 10.
Huapuka kākau: x, laina-hou.

