# Test ASCII variants

# Numbers

Huapuka kākau: (2 !=: 3), laina-hou.
Huapuka kākau: (2 <=: 2), laina-hou.
Huapuka kākau: (2 >=: 2), laina-hou.

# Strings

Huapuka kākau: (['b'] >=: ['a']), laina-hou.
Huapuka kākau: (['b'] !=: ['a']), laina-hou.
Huapuka kākau: (['b'] <=: ['c']), laina-hou.

# Bools

Huapuka kākau: (ʻOiaʻiʻo !=: Wahaheʻe), laina-hou.

# Objects

Huapuka kākau: (Mea hou !=: Mea hou), laina-hou.

# ASCII list symbol <-:

Huapuka kākau: (Papa <<: 1, ; 2 ; 3) heluna = 3, laina-hou.

