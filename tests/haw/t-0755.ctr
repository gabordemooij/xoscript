Huapuka kākau: ['Test object'], laina-hou.
>> greeter := Mea hou.
greeter i: ['name:'] hana: { :inoa
	ponoʻī xname := inoa. 
}.
greeter i: ['greet'] hana: {
	Huapuka kākau: ['Hello '] + ponoʻī xname, laina-hou.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
