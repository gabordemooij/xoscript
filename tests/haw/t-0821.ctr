# a quote that never closes must give an error, not an endless loop
>> ala-waihona := ['/tmp/test0821.csv'].
>> file := Waihona hou: ala-waihona.

file kākau: ['a,b\n"1,2\n'].
{
	file hoʻokaʻawale: [','] kaha-puanaʻī: ['"'] nā-laina: { :line
		Huapuka kākau: line, laina-hou.
	}.
} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.

# a closed quote still works
file kākau: ['a,b\n"1,2",3'].
file hoʻokaʻawale: [','] kaha-puanaʻī: ['"'] nā-laina: { :line
	Huapuka kākau: line, laina-hou.
}.
file hoʻopau.
