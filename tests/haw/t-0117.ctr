>> t := ʻOiaʻiʻo.
(t = ʻOiaʻiʻo) ʻoiaʻiʻo: { Huapuka kākau: ['T']. }.
(t = Wahaheʻe) ʻoiaʻiʻo: { Huapuka kākau: ['F']. }.
Huapuka kākau: ['|'].
>> t := Wahaheʻe.
(t = ʻOiaʻiʻo) ʻoiaʻiʻo: { Huapuka kākau: ['T']. }.
(t = Wahaheʻe) ʻoiaʻiʻo: { Huapuka kākau: ['F']. }.
Huapuka kākau: ['|'].
>> f := ʻOiaʻiʻo.
(t = ʻOiaʻiʻo a: f = Wahaheʻe) ʻoiaʻiʻo: { Huapuka kākau: ['T']. }.
(t = Wahaheʻe a: f = ʻOiaʻiʻo) ʻoiaʻiʻo: { Huapuka kākau: ['F']. }.
Huapuka kākau: ['|'].
>> n := ʻOle.
(n ʻOle?) ʻoiaʻiʻo: { Huapuka kākau: ['T']. }.
(n ʻOle?) wahaheʻe: { Huapuka kākau: ['F']. }.
Huapuka kākau: ['|'].
(f Boolean?) ʻoiaʻiʻo: { Huapuka kākau: ['T']. }.
(f Boolean?) wahaheʻe: { Huapuka kākau: ['F']. }.



