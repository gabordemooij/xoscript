Helu i: ['factorial'] hana: {
	>> total := 1.
	{ :index total hoʻonui-me: (iho - index). } × iho. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

{
2 exponent factorial.
Huapuka kākau: (11 koena: 3), laina-hou.
Huapuka kākau: (3.4 hoʻokokoke-helu), laina-hou.
Huapuka kākau: (7.1 hoʻopiʻi-helu), laina-hou.
Huapuka kākau: (7.9 hoʻoemi-helu), laina-hou.
}
hoʻomaka.

Polokalamu hoʻomaʻemaʻe.

usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).

{
2 exponent factorial.
Huapuka kākau: (11 koena: 3), laina-hou.
Huapuka kākau: (3.4 hoʻokokoke-helu), laina-hou.
Huapuka kākau: (7.1 hoʻopiʻi-helu), laina-hou.
Huapuka kākau: (7.9 hoʻoemi-helu), laina-hou.
}
hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).


{
2 exponent factorial.
Huapuka kākau: (11 koena: 3), laina-hou.
Huapuka kākau: (3.4 hoʻokokoke-helu), laina-hou.
Huapuka kākau: (7.1 hoʻopiʻi-helu), laina-hou.
Huapuka kākau: (7.9 hoʻoemi-helu), laina-hou.
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
