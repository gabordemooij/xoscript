>> str := ['write:'].
Huapuka leka: ['kākau:'] nā-hoʻokomo: (Papa ← ['Hello World']), laina-hou. 

Helu i: ['isbetween:and:'] hana: { :a :b <- ((iho ≥ a) a: (iho ≤ b)).
}.

str := ['isbetween:and:'].
Huapuka kākau: (3 leka: str nā-hoʻokomo: (Papa ← 2 ; 8)), laina-hou.
Huapuka kākau: (3 leka: str nā-hoʻokomo: (Papa ← 1 ; 2)), laina-hou.


>> CoffeeMachine := Mea hou.
CoffeeMachine i: ['makeCoffeeWithSugar:milk:'] hana: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Papa ← 4 ; 2.
Huapuka kākau: ( CoffeeMachine leka: order nā-hoʻokomo: coffeeConfiguration ), laina-hou.
