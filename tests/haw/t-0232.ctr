>> Slurp := Mea hou.

Slurp i: ['hou'] hana: {
	ponoʻī str := [''].
}.

Slurp i: ['pane:'] hana: { :blah
		(ponoʻī str = ['']) ʻoiaʻiʻo: {
			ponoʻī str pākuʻi-hope: blah.
		}, ʻi-ole-ia: {
			ponoʻī str pākuʻi-hope: [' '].
			ponoʻī str pākuʻi-hope: blah.
		}.
}.

Slurp i: ['pane:a:'] hana: { :blah :blahah
		(blah lōʻihi > 1) ʻoiaʻiʻo: {
			ponoʻī str pākuʻi-hope: (blah mai: 0 lōʻihi: (blah lōʻihi - 1)).
		}, ʻi-ole-ia: {
			ponoʻī str pākuʻi-hope: blah.
		}.
		ponoʻī str pākuʻi-hope: [' '].
		ponoʻī str pākuʻi-hope: blahah.
}.

Slurp i: ['obtain'] hana: {
	>> buffer := ponoʻī str.
	ponoʻī str := ['']. <- buffer.
}.


>> x := Slurp hou.
x + 3.
Huapuka kākau: (x obtain), laina-hou.
x echo: ['Hello world'].
Huapuka kākau: (x obtain), laina-hou.
x tellme: 123 and: 987.
Huapuka kākau: (x obtain), laina-hou.
