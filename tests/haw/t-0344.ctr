# catch-all test (practical)
>> HTML := Kaula hou.
HTML i: ['encode:'] hana: { :tekst
	iho pākuʻi-hope: (tekst
	pani: ['&'] me: ['&amp;'], 
	pani: ['<'] me: ['&lt;'],
	pani: ['>'] me: ['&gt;'],
	pani: ['"'] me: ['&quot;']).
}.
>> blog := HTML hou.
blog pākuʻi-hope: ['<h1>'],
     encode: ['Koffie & Thee'],
     pākuʻi-hope: ['</h1>'].
Huapuka kākau: blog, laina-hou.


>> Roman := Helu hou.
Roman i: ['stringy'] hana: {
	>> a := [''].
	{ a pākuʻi-hope: ['I']. } × iho. <- a.
}.

>> x := Roman hou.
x hoʻohui-helu: 3.
Huapuka kākau: x stringy, laina-hou.

>> Quantum := Boolean hou.
Quantum i: ['true?'] hana: { <- ['maybe True']. }.
Huapuka kākau: (Quantum hou true?), laina-hou.

>> Nihil := ʻOle hou.
Nihil i: ['kaula'] hana: { <- ['Nihil']. }.
Huapuka kākau: (Nihil hou), laina-hou.
