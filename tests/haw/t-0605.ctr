>> invoice := Mea hou.
invoice i: ['hoʻomaka'] hana: {
        ponoʻī helu := 0.
}.

invoice i: ['helu'] hana: {
        ponoʻī helu hoʻohui-helu: 1. <- ponoʻī helu kope.
}.

>> year-invoice := invoice hou.
year-invoice i: ['start:'] hana: { :makahiki
	ponoʻī helu := makahiki.
}.

year-invoice start: 202000.
Huapuka kākau: year-invoice helu, laina-hou.
Huapuka kākau: year-invoice helu, laina-hou.
