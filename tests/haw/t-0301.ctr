


>> wine := Mea hou.


wine i: ['toString'] hana: { <- ['merlot'].
}.

wine i: ['naarTekst'] hana: { <- ['merlot'].
}.


wine i: ['='] hana: { :other wine <- ( iho toString = other wine ).
}.

wine i: ['=='] hana: { :other wine <- ( iho toString = other wine ).
}.



wine
	hihia: ['cabernet'] hana: { Huapuka kākau: ['it's a Cabernet!']. },
	hihia: ['syrah']    hana: { Huapuka kākau: ['it's a Syrah!'].    },
	hihia: ['merlot']   hana: { Huapuka kākau: ['it's a Merlot!'].   },
	hihia: ['malbec']   hana: { Huapuka kākau: ['it's a Malbec!'].   }.

Huapuka laina-hou.
