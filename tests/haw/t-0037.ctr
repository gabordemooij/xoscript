>> a := 3.
>> b := a kope.
a hoʻemi: 1.
Huapuka kākau: [' a = '] + a.
Huapuka kākau: [' b = '] + b.
a := 3.
b := a + 4.
Huapuka kākau: [' a = '] + a.
Huapuka kākau: [' b = '] + b.
>> x := 3.
>> y := x kope.
x hoʻohui-helu: 10.
y hoʻemi: 1.
Huapuka kākau: [' x = '] + x.
Huapuka kākau: [' y = '] + y.
>> q := Mea hou.
q i: ['setProperty:'] hana: { :x
	ponoʻī prop := x.
}.
q i: ['getProperty'] hana: { <- ponoʻī prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Huapuka kākau: [' p = '] + (p getProperty).
