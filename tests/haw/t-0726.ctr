# test buffers PKI/Sign 
Server init.

>> long := ( Papa hou hoʻopiha: 1000 me: ['a'] ) hoʻohui: [''].

# sign a message
Huapuka kākau: ( 
	Pahu-kūʻono kākau-inoa: ['abc'] me: long
), laina-hou.

Huapuka kākau: ( 
	Pahu-kūʻono
		nānā: ['abc'] 
		pūlima: long 
		me: long
), laina-hou.

Huapuka kākau: (
	Pahu-kūʻono hash-ʻōlelo-huna: long hōʻoia: long
), laina-hou.
