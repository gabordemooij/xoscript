
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> pāʻālua := {
	>> o := (
		Puke-wehewehe hou
		aa: (Papa ← 1 ; 2),
		bb: (Papa ← 3 ; 4)
	).
	>> s := o kaula.
	>> o2 := s mea.
	(s  ʻano = Kaula ʻano) ʻoiaʻiʻo: { Huapuka kākau: ['OK1'], laina-hou. }.
	(o2 ʻano = Puke-wehewehe ʻano) ʻoiaʻiʻo: { Huapuka kākau: ['OK2'], laina-hou. }.
}.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Polokalamu hoʻomaʻemaʻe.
usedMemory1 := (Polokalamu hoʻomanaʻo ? 1).
pāʻālua hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 1).
pāʻālua hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 1).
pāʻālua hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory4 := (Polokalamu hoʻomanaʻo ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) ʻoiaʻiʻo: { Huapuka kākau: ['OK3'], laina-hou. }.
 
