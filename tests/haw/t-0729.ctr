Server init.
>> a := Blob hou: 4.
a bytes: ( Papa hou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob hou: 4.
b bytes: ( Papa hou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Waihona hou: ['noblob???'] ).
} hopu: { :e Huapuka kākau: e, laina-hou. }, hoʻomaka.
a hoʻokuʻu.
b hoʻokuʻu.
