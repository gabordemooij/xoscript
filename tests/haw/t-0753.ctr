Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :fmt
	ponoʻī fmt := fmt. 
}.

a i: ['item'] hana: { <- ponoʻī fmt.
}.

a item: ( Hōʻano hou: ['|%s|'] ).

Huapuka kākau: a item, laina-hou.

>> old-fmt-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-fmt-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

Huapuka kākau: ( b item hoʻopili: ['hello'] ), laina-hou.
