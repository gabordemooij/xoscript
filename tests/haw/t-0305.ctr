
Helu aʻo: ['plus:'] ʻo-ia: ['+'].
Helu i: ['+'] hana: { :x
	>> rate := 1.
	>> currency := x anakahi-helu.
	(currency = ['euros']) ʻoiaʻiʻo: {
		rate := 2.
	}. <- (iho plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars anakahi: ['dollars'].
euros anakahi: ['euros'].
>> money := dollars + euros.
Huapuka kākau: money, laina-hou.
