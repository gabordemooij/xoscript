>> x := Mea hou.
>> y := Mea hou.
>> z := x.
Huapuka kākau: (x = z), laina-hou.
Huapuka kākau: (x = y), laina-hou.
Huapuka kākau: (x ≠ y), laina-hou.
Huapuka kākau: (x ≠ z), laina-hou.
>> m := Manawa hou makahiki: 2070, mahina: 11.
>> n := m kope.
Huapuka kākau: (m = n), laina-hou.
Huapuka kākau: (m ≠ n), laina-hou.
Huapuka kākau: (m like-loa: m), laina-hou.
Huapuka kākau: (m like-loa: n), laina-hou.
n mahina: 12.
Huapuka kākau: (m ≠ n), laina-hou.
Huapuka kākau: (m = n), laina-hou.


