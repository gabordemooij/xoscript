>> Greeter := Mea hou.
Greeter i: ['make'] hana: {
	>> gr := Mea hou.
	gr i: ['setName:'] hana: { :aname
		ponoʻī inoa := aname.
	}.
	gr i: ['greet'] hana: {
		Huapuka kākau: ponoʻī inoa.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a hou.
c setName: ['THREE'].
c greet.
>> d := a hou.
d setName: ['FOUR'].
d greet.
c greet.
