

>> Matryoshka := Mea hou.
Matryoshka i: ['double:'] hana: { :secret
	ponoʻī secret := secret × 2.
}.
Matryoshka i: ['hou:'] hana: { :secret
	>> answer := ʻOle.
	>> t := (secret > 255).
	Huapuka kākau: (secret + [' | '] + t), laina-hou.
	t ʻoiaʻiʻo: {
		answer := secret.
	}, ʻi-ole-ia: {
		answer := Matryoshka kāhea-iā-ia-iho hou: (iho double: secret).
	}. <- answer.
}.

>> x := Matryoshka hou: 2.
