

Kaula i: ['evaluate'] hana: {
	>> pāʻālua := Waihona hou: ['/tmp/eval.ctr'].
	pāʻālua kākau: iho kaula + ['.'].
	Polokalamu hoʻohana: ['/tmp/eval.ctr'].
}.

>> a := (Papa ← (
	(Puke-wehewehe hou)
		waiho: ['domain'] ma: ['mywebsite.com'],
		waiho: (Papa ←
			((Puke-wehewehe hou)
				waiho: ['home'] ma: ['title'],
				waiho: ['<html></html>'] ma: ['body'],
				waiho: ['2017-01-01'] ma: ['created']
			) ;
			((Puke-wehewehe hou)
				waiho: ['aboutus(c)'] ma: ['title'],
				waiho: ['<credits>Author Inc.</credits>'] ma: ['body']
			)
		) ma: ['pages']
	)
) kaula.

Huapuka kākau: a ʻano, laina-hou.
Huapuka kākau: a, laina-hou.

>> b := ʻOle.
(['b := '] + a) evaluate.
Huapuka kākau: b ? 0 ? ['pages'] ? 1 ? ['body'], laina-hou.

>> c := b ? 0.
>> d := c kaula.
Huapuka kākau: d ʻano, laina-hou.

>> e := ʻOle.
(['e := '] + d) evaluate.
Huapuka kākau: e ? ['pages'] ? 0, laina-hou.
