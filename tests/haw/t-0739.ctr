Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :binhelper
	ponoʻī binhelper := binhelper. 
}.

a i: ['item'] hana: { <- ponoʻī binhelper.
}.

a item: Bin hou.

>> old-binhelper-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-binhelper-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.


