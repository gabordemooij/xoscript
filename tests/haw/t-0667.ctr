# test Program version

# this feature is disabled by default
Huapuka kākau: (
	Polokalamu hiʻona: 
	['RECURSIVE_STRINTPOL']
), laina-hou.


# but if we set the time back
>> today := Manawa 
zona: ['CEST'],
kumu: ['2026-02-15 10:00:00'].
Polokalamu mana-hoʻopuka: today.

# it will be enabled like it used to be (from now on)
Huapuka kākau: (
	Polokalamu hiʻona: 
	['RECURSIVE_STRINTPOL']
), laina-hou.