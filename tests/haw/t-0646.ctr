Server init.
Huapuka kākau: ['Database datetime test'], laina-hou.

>> db := Maria-DB hou hoʻokipa: ['localhost'],
	inoa-mea-hoʻohana: ['xo'], 
	ʻōlelo-huna: ['pass123'],
	inoa-waihona-ʻikepili: ['xobase'],
	hoʻohui-pū.

>> nā-koina-huli :=
db nīnau: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
kiʻi: { :row
	Huapuka kākau: row datetimetest, laina-hou.
}.
