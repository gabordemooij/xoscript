>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Mea hou.
⚄ i: ['drawFrom:length:'] hana: { :pool :heluna
	
	>> result := [''].
	
	{
		>> index := Helu random % (pool lōʻihi).
		result pākuʻi-hope: ( pool hua: (index + 1) ).
		
	} × heluna. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lōʻihi.
Huapuka kākau: (['x↵'] x random lōʻihi).
Huapuka kākau: (['y↵'] y ?? lōʻihi).

