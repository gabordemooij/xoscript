#Linux
>> OS := Polokalamu hoʻonohonoho: ['OS'].

>> clock := Manawa hou.
	
(OS = ['Haiku']) ʻoiaʻiʻo: {
	clock zona: ['CET'],
	makahiki: 2017, mahina: 7, lā: 13,
	hola: 18, minuke: 0, kekona: 0.
}, ʻi-ole-ia: {
	clock zona: ['Europe/Amsterdam'],
	makahiki: 2017, mahina: 7, lā: 13,
	hola: 18, minuke: 0, kekona: 0.
}.

clock i: ['tell'] hana: {
	Huapuka kākau: iho, laina-hou.
}.


clock hoʻohui-helu: 2    hola, tell.
clock hoʻohui-helu: 1    hola, tell.
clock hoʻohui-helu: 19 minuke, tell.
clock hoʻohui-helu: 1  minuke, tell.
clock hoʻohui-helu: 1  minuke, tell.
clock hoʻohui-helu: 19 kekona, tell.
clock hoʻohui-helu: 1  kekona, tell.
clock hoʻohui-helu: 1  kekona, tell.
clock hoʻohui-helu: 2    makahiki, tell.
clock hoʻohui-helu: 1    makahiki, tell.

(OS = ['Haiku']) ʻoiaʻiʻo: {
clock hoʻohui-helu: 5   mahina.
clock zona: ['CEST'], tell.
}, ʻi-ole-ia: {
	clock hoʻohui-helu: 5   mahina, tell.
}.

clock hoʻohui-helu: 1   mahina, tell.
clock hoʻohui-helu: 19    lā, tell.
clock hoʻohui-helu: 1    hola, tell.
clock hoʻohui-helu: 120  yard, tell.
