


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.
>> palette := ʻOle.
>> colors := ʻOle.

{
palette := Puke-wehewehe hou.
palette 
	waiho: ['#F00'] ma: ['red'],
	waiho: ['#0F0'] ma: ['green'],
	waiho: ['#00F'] ma: ['blue'].
Huapuka kākau: ['number of RGB codes in palette: '] + ( palette heluna ), laina-hou.
Huapuka kākau: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-hou.
colors := [''].
( palette pākahi: { :inoa :pāʻālua
		colors := colors + ( inoa + [':'] + pāʻālua ).
} ).
Huapuka kākau: ['All colors in palette: '] + colors, laina-hou.
} hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).

{
palette := Puke-wehewehe hou.
palette 
	waiho: ['#F00'] ma: ['red'],
	waiho: ['#0F0'] ma: ['green'],
	waiho: ['#00F'] ma: ['blue'].
Huapuka kākau: ['number of RGB codes in palette: '] + ( palette heluna ), laina-hou.
Huapuka kākau: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-hou.
colors := [''].
( palette pākahi: { :inoa :pāʻālua
		colors := colors + ( inoa + [':'] + pāʻālua ).
} ).
Huapuka kākau: ['All colors in palette: '] + colors, laina-hou.
} hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).

{
palette := Puke-wehewehe hou.
palette 
	waiho: ['#F00'] ma: ['red'],
	waiho: ['#0F0'] ma: ['green'],
	waiho: ['#00F'] ma: ['blue'].
Huapuka kākau: ['number of RGB codes in palette: '] + ( palette heluna ), laina-hou.
Huapuka kākau: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-hou.
colors := [''].
( palette pākahi: { :inoa :pāʻālua
		colors := colors + ( inoa + [':'] + pāʻālua ).
} ).
Huapuka kākau: ['All colors in palette: '] + colors, laina-hou.
} hoʻomaka.
Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
