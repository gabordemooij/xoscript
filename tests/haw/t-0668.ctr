# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob hou: 8, bytes: (
	Papa hou ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Huapuka kākau: ( utf16 wehe-pāʻālua: ['utf16le'] ), laina-hou.

utf16 hoʻokuʻu.
>> utf32 := Blob hou: 13, bytes: (
	Papa hou ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Huapuka kākau: ( utf32 wehe-pāʻālua: ['utf32be'] ), laina-hou.
utf32 hoʻokuʻu.