# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Pahu-kūʻono 
	hash-ʻōlelo-huna: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Pahu-kūʻono 
	hash-ʻōlelo-huna: hash hōʻoia: a1.
	# fail 
>> b := Pahu-kūʻono
	hash-ʻōlelo-huna: hash hōʻoia: a2.
	# ok!

Huapuka kākau: a, laina-hou.
Huapuka kākau: b, laina-hou.

