# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Lauana hou: pattern.
	p kūlike: subject hana: { :m :g
		Huapuka kākau: g heluna, kākau: [' '], kākau: (g hoʻohui: ['|']), laina-hou. <- m.
	}.
}.
show hoʻopili: ['(a)|(b)'] a: ['b'].
show hoʻopili: ['(a)|(b)'] a: ['a'].
show hoʻopili: ['(x)?y'] a: ['y'].
show hoʻopili: ['(x)?(y)(z)?'] a: ['xy'].
