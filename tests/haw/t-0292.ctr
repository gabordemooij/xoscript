>> winery := { <- (	Puke-wehewehe hou
		waiho: 2 ma: ['merlot'],
		waiho: 3 ma: ['malbec'],
		waiho: 4 ma: ['syrah']
	).
}.

Huapuka kākau: (((winery hoʻomaka) - ['nothing']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['merlot']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['malbec']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['syrah']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['merlot'] - ['malbec']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['merlot'] - ['syrah']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['malbec'] -['syrah']) heluna), laina-hou.
Huapuka kākau: (((winery hoʻomaka) - ['malbec'] - ['syrah'] - ['merlot']) heluna), laina-hou.

