# a value ending in the first part of an opening quote must survive serialization
>> nā-waiwai := Papa hou
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

nā-waiwai pākahi: { :i :value
	>> d := Puke-wehewehe hou.
	d waiho: value ma: ['k'].
	d waiho: ['second'] ma: ['j'].
	>> r := d pāʻālua mea.
	Huapuka kākau: r heluna, laina-hou.
	Huapuka kākau: ( (r i: ['k']) = value ), laina-hou.
}.
