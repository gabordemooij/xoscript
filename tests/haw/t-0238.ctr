Kaula i: ['evaluate'] hana: {
	>> pāʻālua := Waihona hou: ['/tmp/eval.ctr'].
	pāʻālua kākau: (iho kaula + ['.']).
	Polokalamu hoʻohana: ['/tmp/eval.ctr'].
}.

>> a := Papa ← 1 ; 2 ; 3.
>> b := (a kaula).

Huapuka kākau: b, laina-hou. 
(['b := '] + b) evaluate.

Huapuka kākau: b ? 2, laina-hou. 

Huapuka kākau: (( Papa ← 1 ; 2 ; 3 )), laina-hou. 

Huapuka kākau: ((Puke-wehewehe hou) waiho: 1 ma: 2), laina-hou. 

>> x := ( (Papa ← 1 ; ( Papa ← 9 ) ; ʻOiaʻiʻo ) ) kaula.
Huapuka kākau: x, laina-hou. 
(['x := '] + x) evaluate.

Huapuka kākau: x ? 1 ? 0, laina-hou. 

>> y := (Puke-wehewehe hou) waiho: (Papa ← 1) ma: (Papa ← 2).
Huapuka kākau: y, laina-hou. 

(['y := '] + y) kaula evaluate.

Huapuka kākau: (y i: (Papa ← 2) kaula ), laina-hou.

Huapuka kākau: (Papa hou), laina-hou. 
Huapuka kākau: (Puke-wehewehe hou), laina-hou. 
