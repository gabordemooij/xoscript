#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

{
Manawa manawa-kūʻē.
Manawa kali: 1.
Huapuka kākau: Polokalamu heluna-hoʻokomo, laina-hou.
Polokalamu hoʻokomo: 0.
Helu random.
Huapuka kākau: (Polokalamu ʻōnaehana: ['echo 'Hello'']).
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory1 := (Polokalamu hoʻomanaʻo ? 0).

{
Manawa manawa-kūʻē.
Manawa kali: 1.
Huapuka kākau: Polokalamu heluna-hoʻokomo, laina-hou.
Polokalamu hoʻokomo: 0.
Helu random.
Huapuka kākau: (Polokalamu ʻōnaehana: ['echo 'Hello'']).
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 0).

{
Manawa manawa-kūʻē.
Manawa kali: 1.
Huapuka kākau: Polokalamu heluna-hoʻokomo, laina-hou.
Polokalamu hoʻokomo: 0.
Helu random.
Huapuka kākau: (Polokalamu ʻōnaehana: ['echo 'Hello'']).
} hoʻomaka.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
