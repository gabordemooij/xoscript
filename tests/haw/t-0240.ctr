# test qualifiers

>> $ := Mea hou.

$ i: ['pane:'] hana: { :x
	
	>> operation := x hua: 0.
	>> valuta := x hua: 1.
	>> money := x lele: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ʻoiaʻiʻo: {
		( valuta = ['£'] ) ʻoiaʻiʻo: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Huapuka kākau: x, laina-hou.


>> Fruit := Mea hou.

Fruit i: ['hou'] hana: {
	>> f := iho hou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit i: ['apples:'] hana: { :a ponoʻī apples := a. }.
Fruit i: ['oranges:'] hana: { :p ponoʻī oranges := p. }.
Fruit i: ['apples'] hana: { <- ponoʻī apples. }.
Fruit i: ['oranges'] hana: { <- ponoʻī oranges. }.

Fruit i: ['+'] hana: { :f
	
	>> n := Fruit hou.
	f hoʻohui-helu: 1.
	
	n apples: (f apples + ponoʻī apples).
	n oranges:  (f oranges  + ponoʻī oranges). <- n.
}.

Fruit i: ['kaula'] hana: { <- ( ponoʻī apples kaula + [' apples and '] + ponoʻī oranges + [' oranges'] ).
}.

Helu i: ['apples'] hana: { <- ((Fruit hou) apples: iho).
}.

Helu i: ['apple'] hana: { <- ((Fruit hou) apples: iho).
}.

Helu i: ['oranges'] hana: { <- ((Fruit hou) oranges: iho).
}.




Huapuka kākau: (1 apple + 3 oranges + 4 apples), laina-hou.


Kaula i: ['twice'] hana: { <- ((iho kaula) + (iho kaula)).
}.



Huapuka kākau: ['❤❤❤'] twice.



