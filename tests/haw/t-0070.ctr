>> numbers := ['1,2,3'] hoʻokaʻawale: [','].
Huapuka kākau: ['I got: '] + numbers heluna + [' numbers.'],laina-hou.
{ :i Huapuka kākau: ['number #'] + i + [':'] + (numbers kūlana: i), laina-hou.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages hoʻokaʻawale: [' Or '].
Huapuka kākau: ['We serve'], laina-hou.
{ :i Huapuka kākau: ['->'] + (beverages kūlana: i), laina-hou. } × (beverages heluna).
Huapuka kākau: (beverages hoʻohui: [',']), laina-hou.
Huapuka kākau: (numbers hoʻohui: ['||']).
