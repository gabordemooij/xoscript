>> items := Puke-wehewehe hou.
items waiho: ['black'] ma: ['coffee'], waiho: ['earl grey'] ma: ['tea'].
Huapuka kākau: (items i: ['coffee']), kākau: (items i: ['tea']).
Huapuka kākau: ['there are'] + items heluna + [' items in the array.'].
items waiho: ['capuccino'] ma: ['coffee'].
Huapuka kākau: ['Now my coffee is.. '] + (items i: ['coffee']).
items waiho: ['aaa'] ma: ['1'].
items waiho: ['bbb'] ma: ['2'].
Huapuka kākau: (items i: ['a']).
