


>> CoffeeMachine := Mea hou.
CoffeeMachine i: ['order:'] hana: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ʻoiaʻiʻo: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ʻoiaʻiʻo: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ʻoiaʻiʻo: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Mea hou.
SimpleCoffeeMachine i: ['order'] hana: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Huapuka kākau: redCup, laina-hou.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Huapuka kākau: greenCup, laina-hou.
>> yellowCup := CoffeeMachine order: 1.
Huapuka kākau: yellowCup, laina-hou.
>> blueCup := CoffeeMachine order: 0.
Huapuka kākau: blueCup, laina-hou.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Huapuka kākau: blackCup, laina-hou.
blackCup pākuʻi-hope: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Huapuka kākau: orangeCup, laina-hou.
