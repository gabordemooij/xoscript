Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :nil
	ponoʻī nil := nil. 
}.

a i: ['item'] hana: { <- ponoʻī nil.
}.

a item: ʻOle.

Huapuka kākau: a item, laina-hou.

>> old-nil-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-nil-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

Huapuka kākau: b item, laina-hou.
