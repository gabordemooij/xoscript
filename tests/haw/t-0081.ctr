>> map1 := Puke-wehewehe hou.
>> key1 := Papa hou.
>> key2 := Papa hou.

map1
	waiho: ['hello'] ma: key1,
	waiho: ['world'] ma: key2.


Huapuka
	kākau: ['Map #1 contains: '] + (map1 i: key1),
	kākau: [' and '] + (map1 i: key2), laina-hou.

>> KeyeableArray := Papa hou.
KeyeableArray i: ['toString'] hana: { <- (iho heluna) toString.
}.

>> map2 := Puke-wehewehe hou.
key1 := KeyeableArray hou.
key2 := KeyeableArray hou.

key1 pākuʻi-hope: 1.

map2
	waiho: ['hello'] ma: key1,
	waiho: ['world'] ma: key2.

Huapuka
	kākau: ['Map #2 contains: '] + (map2 i: key1),
	kākau: [' and '] + (map2 i: key2), laina-hou.
