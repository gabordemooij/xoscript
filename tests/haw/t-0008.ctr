>> Greeter := Mea hou.
Greeter i: ['make'] hana: {
	>> greeter := Mea hou.
	greeter i: ['name:'] hana: { :inoa
		Huapuka kākau: ['setting a name'].
		ponoʻī myName := inoa.
	}.
	greeter i: ['greet'] hana: {
		Huapuka kākau: ['Hello'].
		Huapuka kākau: ponoʻī myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
