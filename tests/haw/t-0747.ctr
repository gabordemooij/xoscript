Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :num
	ponoʻī num := num. 
}.

a i: ['item'] hana: { <- ponoʻī num.
}.

a item: 123.

Huapuka kākau: a item, laina-hou.

>> old-num-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-num-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

Huapuka kākau: b item, laina-hou.
