>> x := [' hallo '].

>> y := x maʻaka.
Huapuka kākau: x, laina-hou.
Huapuka kākau: (x like-loa: y), laina-hou.

>> y := x naʻinaʻi.
Huapuka kākau: x, laina-hou.
Huapuka kākau: (x like-loa: y), laina-hou.

>> y := x ʻoki-hakahaka.
Huapuka kākau: x, laina-hou.
Huapuka kākau: (x like-loa: y), laina-hou.

>> y := x lele: 1.
Huapuka kākau: x, laina-hou.
Huapuka kākau: (x like-loa: y), laina-hou.

>> y := x mai: 1 lōʻihi: 2.
Huapuka kākau: x, laina-hou.
Huapuka kākau: (x like-loa: y), laina-hou.