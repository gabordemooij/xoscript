
Kaula i: ['evaluate'] hana: {
	>> pāʻālua := Waihona hou: ['/tmp/eval.ctr'].
	pāʻālua kākau: (iho kaula + ['.']).
	Polokalamu hoʻohana: ['/tmp/eval.ctr'].
}.

>> map :=
	(Puke-wehewehe hou)
	waiho: ['Hi There'] ma: ['two'],
	waiho: (Papa ← ['hello'] ; ['world'] ; (Papa ← 1 ; 2; 9) ; Wahaheʻe) ma: ['one'],
	waiho: ( (Puke-wehewehe hou) waiho: ['wrrld'] ma: ['misspelled'] ) ma: ['three'],
	waiho: (Papa ← ((Puke-wehewehe hou) waiho: ['treasure'] ma: ['hidden']) ; 2) ma: ['four']. 
>> str := map kaula.
>> map2 := ʻOle.
(['map2 := '] + str ) evaluate.
Huapuka kākau: map2 ? ['one'] ? 0.
Huapuka kākau: map2 ? ['one'] ? 1.
Huapuka kākau: map2 ? ['four'] ? 0 ? ['hidden'].
Huapuka kākau: map2 ? ['one'] ? 2 ? 2.
