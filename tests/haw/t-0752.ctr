Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :boolean
	ponoʻī boolean := boolean. 
}.

a i: ['item'] hana: { <- ponoʻī boolean.
}.

a item: Boolean.

Huapuka kākau: a item, laina-hou.

>> old-bool-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-bool-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

Huapuka kākau: b item, laina-hou.
