>> Point := Mea hou.
Point i: ['x-coordinate:'] hana: { :x ponoʻī x := x. }.
Point i: ['y-coordinate:'] hana: { :y ponoʻī y := y. }.
Point i: ['x-coordinate']  hana: { <- ponoʻī x kope. }.
Point i: ['y-coordinate']  hana: { <- ponoʻī y kope. }.

Point i: ['='] hana: { :other <- ( ponoʻī x = other x-coordinate
		 a: ponoʻī y = other y-coordinate ).
}.

>> pier := Point hou x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point hou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point hou x-coordinate: 5, y-coordinate: 6.

Huapuka kākau: pier = town-hall, laina-hou.
Huapuka kākau: pier = restaurant, laina-hou.
