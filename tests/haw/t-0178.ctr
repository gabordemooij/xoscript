

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.

>> txt := ['Word Salad'].
Huapuka kākau: ['last index of ord = '] + (( txt kūlana-hope: ['ord'] ) - 0), laina-hou.
Huapuka kākau: ['index of ord = '] + (( txt huli: ['ord'] ) - 0), laina-hou.
Huapuka kākau: ['index of ad = '] + (( txt huli: ['ad'] ) - 0), laina-hou.
Huapuka kākau: ['last index of W = '] + (( txt kūlana-hope: ['W'] ) - 0), laina-hou.
Huapuka kākau: ['last index of d = '] + (( txt kūlana-hope: ['d'] ) - 0), laina-hou.
Huapuka kākau: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), laina-hou.
Huapuka kākau: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), laina-hou.
Huapuka kākau: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), laina-hou.
Huapuka kākau: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), laina-hou.

Polokalamu hoʻomaʻemaʻe.

