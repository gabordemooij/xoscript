#Linux

(Waihona hou: ['/tmp/testje']) aia wahaheʻe: {
	Polokalamu ʻōnaehana: ['mkdir /tmp/testje'].	
}.

(Waihona hou: ['/tmp/testje/file1']) aia wahaheʻe: {
	Polokalamu ʻōnaehana: ['touch /tmp/testje/file1'].	
}.

(Waihona hou: ['/tmp/testje/folder1']) aia wahaheʻe: {
	Polokalamu ʻōnaehana: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Waihona papa: ['/tmp/testje'].

>> q := Papa hou.

l pākahi: { :k :v v pākahi: { :x :y q pākuʻi-hope: y. }. }.

>> s := q kaula.

(s aia-i-loko: ['file1']) ʻoiaʻiʻo:   { Huapuka kākau: ['OK'], laina-hou. }.
(s aia-i-loko: ['file2']) ʻoiaʻiʻo:   { Huapuka kākau: ['XX'], laina-hou. }.
(s aia-i-loko: ['folder1']) ʻoiaʻiʻo: { Huapuka kākau: ['OK'], laina-hou. }.
