Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :file
	ponoʻī file := file. 
}.

a i: ['item'] hana: { <- ponoʻī file.
}.

>> f := Waihona hou: ['/tmp/aaa.txt'].
a item: f.
Huapuka kākau: a item, laina-hou.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.
>> b := Mea load-from: ['/tmp/a.bin'].
Huapuka kākau: b item, laina-hou.
