
>> a := Papa ← (Papa ← 100 ; 200 ; 300) ; (Papa ← 9 ; 8 ; 7).
Huapuka kākau: ['at 0,1 :'].
Huapuka kākau: a ? 0 ? 1, laina-hou. 
Huapuka kākau: ['at 1,2 :'].
Huapuka kākau: a ? 1 ? 2, laina-hou. 
>> menu := Puke-wehewehe hou.
menu waiho: (Papa ← ['pizza'] ; ['spaghetti']) ma: ['Italian Cuisine'].
menu waiho: (Papa ← ['bifteki'] ; ['suflaki']) ma: ['Greek Cuisine'].
Huapuka kākau: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), laina-hou. 
Huapuka kākau: ['but not on the same plate.'], laina-hou.
