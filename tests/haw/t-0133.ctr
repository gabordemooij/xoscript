


>> Deck := Papa hou.
Deck i: ['print'] hana: {
        >> len := iho heluna - 1.
        { :i
                >> len2 := iho heluna - 1.
                Huapuka kākau: ['len: '].
                Huapuka kākau: len, laina-hou.
                Huapuka kākau: ['len2: '].
                Huapuka kākau: len2, laina-hou.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
