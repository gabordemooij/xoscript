Polokalamu hoʻoponopono-waihona-hoʻomanaʻo: 0.
Papa i: ['sum'] hana: {
	>> total := 0.
	iho pākahi: { :index :element
		total hoʻohui-helu: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Waihona hou: ['/tmp/test.txt'].
f kākau: ['Lorem Ipsum'].
f pani-puka.
  

f := Waihona hou: ['/tmp/test.txt'].
>> text := f heluhelu.
f pani-puka.



Polokalamu hoʻomaʻemaʻe.
usedMemory1 := (Polokalamu hoʻomanaʻo ? 1).



f := Waihona hou: ['/tmp/test.txt'].
text := f heluhelu.
f pani-puka.

Polokalamu hoʻomaʻemaʻe.
usedMemory2 := (Polokalamu hoʻomanaʻo ? 1).


f := Waihona hou: ['/tmp/test.txt'].
text := f heluhelu.
f pani-puka.

Polokalamu hoʻomaʻemaʻe.
usedMemory3 := (Polokalamu hoʻomanaʻo ? 1).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) ʻoiaʻiʻo: {
	Huapuka kākau: ['No memory leaks here'].
}, wahaheʻe: {
	Huapuka kākau: ['Leaking memory...'].
}.
