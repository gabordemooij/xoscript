

# create a 64-bit integer for exact calculations
>> a := Int64 mai-ke-kaula: ['123'].

# to string
Huapuka kākau: a, laina-hou.

# divide
Huapuka kākau: a / (Int64 mai-ke-kaula: ['3']), laina-hou.

# multiply
Huapuka kākau: a * (Int64 mai-ke-kaula: ['2']), laina-hou.

# add
Huapuka kākau: a + (Int64 mai-ke-kaula: ['1']), laina-hou.

# subtract
Huapuka kākau: a - (Int64 mai-ke-kaula: ['2']), laina-hou.

# compare
Huapuka kākau: ( a =   (Int64 mai-ke-kaula: ['123'])), laina-hou.
Huapuka kākau: ( a !=: (Int64 mai-ke-kaula: ['124'])), laina-hou.
Huapuka kākau: ( a <   (Int64 mai-ke-kaula: ['124'])), laina-hou.
Huapuka kākau: ( a >   (Int64 mai-ke-kaula: ['122'])), laina-hou.
Huapuka kākau: ( a >=: (Int64 mai-ke-kaula: ['123'])), laina-hou.
Huapuka kākau: ( a <=: (Int64 mai-ke-kaula: ['123'])), laina-hou.





	