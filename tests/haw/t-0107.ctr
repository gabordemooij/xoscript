
Huapuka kākau: ['Break for-loop, 0-4.'], laina-hou.
{ :i
	Huapuka kākau: ['iteration #'] + i, laina-hou.
	(i = 4) hoʻōki.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Huapuka kākau: ['Break while-true loop, 0-4.'], laina-hou.
{
	Huapuka kākau: ['iteration #'] + x, laina-hou.
	x hoʻohui-helu: 1.
	((x < 5) ʻaʻole-naʻe) hoʻōki.
} ʻoiai: xIsLessThan10.

Huapuka kākau: ['Break while-false loop, 5,4.'], laina-hou.
{
	Huapuka kākau: ['iteration #'] + x, laina-hou.
	x hoʻemi: 1.
	(x = 3) hoʻōki.
} ʻoiai: { <- (x > 0). }.

Huapuka kākau: ['Break times loop, 1-4.'], laina-hou.
{ :i
	Huapuka kākau: ['iteration #'] + i, laina-hou.
	(i = 4) hoʻōki.
} × 5.

Huapuka kākau: ['Break block, dont print line.'], laina-hou.
{ ʻOiaʻiʻo hoʻōki. Huapuka kākau: ['dont write this!'], laina-hou. } hoʻomaka.

Huapuka kākau: ['Break block, dont fire catch...'], laina-hou.
{ ʻOiaʻiʻo hoʻōki. Huapuka kākau: ['dont write this!'], laina-hou. } hopu: { Huapuka kākau: ['Dont catch this!']. }, hoʻomaka.

Huapuka kākau: ['Test Array each-loop: 0,1'], laina-hou.
(Papa ← 1 ; 2 ; 3) hoʻololi-pākahi: { :i
	Huapuka kākau: ['iteration #'] + i, laina-hou.
	(i = 1) hoʻōki.
}.

Huapuka kākau: ['Test Map each-loop: c only'], laina-hou.
>> m := Puke-wehewehe hou.
m waiho: ['first'] ma: ['a'], waiho: ['second'] ma: ['b'], waiho: ['third'] ma: ['c'].
m pākahi: { :k :v
	Huapuka kākau: ['iteration'] + v + k, laina-hou.
	ʻOiaʻiʻo hoʻōki.
}.

