
Server init.
>> rq := Noi-HTTP hou.
Huapuka kākau: ['HTTP-GET d[]=']  + ( rq get-papa: ['d[]'] ), laina-hou. # GET
Huapuka kākau: ['HTTP-GET f[]=']  + ( rq get-papa: ['f[]'] ), laina-hou. # GET
Huapuka kākau: ['HTTP-POST e[]='] + ( rq post-papa: ['e[]'] ), laina-hou. # GET
Huapuka kākau: ['HTTP-POST c=']   + ( rq post: ['c'] ), laina-hou. # GET
Huapuka kākau: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), laina-hou. # GET
