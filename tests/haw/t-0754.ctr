Huapuka kākau: ['Test object'], laina-hou.
>> a := Mea hou. 

a i: ['item:'] hana: { :out
	ponoʻī out := out. 
}.

a i: ['item'] hana: { <- ponoʻī out.
}.

a i: ['greet'] hana: {
	Huapuka kākau: ['hi from original out!'], laina-hou.
}.

a item: Huapuka.

Huapuka kākau: a item, laina-hou.

>> old-out-address := a item kumu-hoʻohālike wahi-noho-hoʻomanaʻo.
a save-as: ['/tmp/a.bin'].
Huapuka kākau: ['========== RELOADING SNAP:'], laina-hou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item kumu-hoʻohālike wahi-noho-hoʻomanaʻo = old-out-address) ʻoiaʻiʻo: {
	Huapuka kākau: ['Object link re-attached.'], laina-hou.
}.

b item kākau: ['hello from loaded out!'], laina-hou.
b greet.
