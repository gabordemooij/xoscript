# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := നിലവറ 
	രഹസ്യവാക്ക്-ഹാഷ്: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := നിലവറ 
	രഹസ്യവാക്ക്-ഹാഷ്: hash ഉറപ്പാക്കുക: a1.
	# fail 
>> b := നിലവറ
	രഹസ്യവാക്ക്-ഹാഷ്: hash ഉറപ്പാക്കുക: a2.
	# ok!

ഔട്ട്പുട്ട് എഴുതുക: a, പുതിയ-വരി.
ഔട്ട്പുട്ട് എഴുതുക: b, പുതിയ-വരി.

