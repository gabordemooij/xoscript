>> items := നിഘണ്ടു പുതിയ.
items വെക്കുക: ['green'] താക്കോൽ: ['color-1'].
items വെക്കുക: ['orange'] താക്കോൽ: ['color-2'].
items വെക്കുക: ['red'] താക്കോൽ: ['color-3'].
>> i := 0.
>> s := [''].
items ഓരോന്നും: { :key :color
	ഔട്ട്പുട്ട് എഴുതുക: ['color #'] + i + [' is: '] + color + [' '].
	i കൂട്ടുക: 1.
}.
ഔട്ട്പുട്ട് എഴുതുക: i + [' colors!'].
