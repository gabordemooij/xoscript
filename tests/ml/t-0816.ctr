# a format must fit the type of the value, the type can come from a client
>> ശ്രമിക്കുക := { :format :value
	{ ഔട്ട്പുട്ട് എഴുതുക: ( (രൂപം പുതിയ: format) പ്രയോഗിക്കുക: value ), പുതിയ-വരി. } പിടിക്കുക: { :e ഔട്ട്പുട്ട് എഴുതുക: e, പുതിയ-വരി. }, പ്രവർത്തിപ്പിക്കുക.
}.
>> try-int := { :format :value
	{ ഔട്ട്പുട്ട് എഴുതുക: ( (രൂപം പുതിയ: format) പ്രയോഗിക്കുക-പൂർണ്ണസംഖ്യ: value ), പുതിയ-വരി. } പിടിക്കുക: { :e ഔട്ട്പുട്ട് എഴുതുക: e, പുതിയ-വരി. }, പ്രവർത്തിപ്പിക്കുക.
}.

# fits
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['|%s|'] കൂടാതെ: ['text'].
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%06.2f'] കൂടാതെ: 5.5.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['100%% %s'] കൂടാതെ: ['sure'].
try-int പ്രയോഗിക്കുക: ['%03d'] കൂടാതെ: 7.
try-int പ്രയോഗിക്കുക: ['%x'] കൂടാതെ: 255.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%d'] കൂടാതെ: (Int64 പുതിയ വാചകത്തിൽനിന്ന്: ['12']).
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%lld'] കൂടാതെ: (Int64 പുതിയ വാചകത്തിൽനിന്ന്: ['12']).
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%.1lf'] കൂടാതെ: 5.5.
try-int പ്രയോഗിക്കുക: ['%hd'] കൂടാതെ: 7.

# does not fit
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%s'] കൂടാതെ: 12345.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%d'] കൂടാതെ: 12345.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%f'] കൂടാതെ: ['text'].
try-int പ്രയോഗിക്കുക: ['%d'] കൂടാതെ: ['text'].
try-int പ്രയോഗിക്കുക: ['%s'] കൂടാതെ: 5.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%s %s'] കൂടാതെ: ['text'].
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%n'] കൂടാതെ: ['text'].
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%*s'] കൂടാതെ: ['text'].
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%'] കൂടാതെ: ['text'].

# length modifier does not fit
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%ls'] കൂടാതെ: ['text'].
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%Lf'] കൂടാതെ: 5.5.
try-int പ്രയോഗിക്കുക: ['%ld'] കൂടാതെ: 7.
try-int പ്രയോഗിക്കുക: ['%lld'] കൂടാതെ: 7.
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%Ld'] കൂടാതെ: (Int64 പുതിയ വാചകത്തിൽനിന്ന്: ['12']).

# a width that does not fit printf must give an error, not a crash
ശ്രമിക്കുക പ്രയോഗിക്കുക: ['%99999999999s'] കൂടാതെ: ['text'].
