
>> dictionary := (
	നിഘണ്ടു പുതിയ
		വെക്കുക: ['b'] താക്കോൽ: ['a'],
		വെക്കുക: ['a'] താക്കോൽ: ['b'],
		വെക്കുക: ['z'] താക്കോൽ: ['x'],
		വെക്കുക: ['hello'] താക്കോൽ: ['hallo'],
		വെക്കുക: ['human'] താക്കോൽ: ['human']
).

>> comparisons := ശ്രേണി പുതിയ.
dictionary ഓരോന്നും: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a താരതമ്യം: b)
	).
}.

comparisons ക്രമീകരിക്കുക: { :a :b <- ( a താരതമ്യം: b ). }.
ഔട്ട്പുട്ട് എഴുതുക: ( comparisons ചേർക്കുക: ['↵'] ), പുതിയ-വരി.
comparisons ചേർക്കുക: ['↵'].
