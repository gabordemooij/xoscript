# test number -> string -> number
{

	>> x := സംഖ്യ ഇടയിൽ: 0 മുതൽ: 1000000.
	>> d := സംഖ്യ ഇടയിൽ: 1 മുതൽ: 7.
	>> e := 10 ഘാതം: d.

	x ഹരിക്കുക: e.
	>> y := x വാചകമായി സംഖ്യയായി.

	(x = y) തെറ്റെങ്കിൽ: {
		ഔട്ട്പുട്ട് എഴുതുക: x, പുതിയ-വരി.
		ഔട്ട്പുട്ട് എഴുതുക: y, പുതിയ-വരി.
		പ്രോഗ്രാം അവസാനിപ്പിക്കുക.
	}.

} * 1000.
ഔട്ട്പുട്ട് എഴുതുക: ['OK'], പുതിയ-വരി.