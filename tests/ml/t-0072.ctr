>> echo := വസ്തു പുതിയ.
echo കിട്ടുമ്പോൾ: ['മറുപടി:'] ചെയ്യുക: { :sound
	{ ഔട്ട്പുട്ട് എഴുതുക: sound. } × 2.
}.
echo ho!. 


echo := വസ്തു പുതിയ.
echo കിട്ടുമ്പോൾ: ['മറുപടി:കൂടാതെ:'] ചെയ്യുക: { :sound :x
	{ ഔട്ട്പുട്ട് എഴുതുക: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := വസ്തു പുതിയ.
echo കിട്ടുമ്പോൾ: ['മറുപടി:കൂടാതെ:കൂടാതെ:'] ചെയ്യുക: { :operation :sound :x
	{ ഔട്ട്പുട്ട് എഴുതുക: sound. } × x.
}.
echo shout: ['la'] times: 4. 


