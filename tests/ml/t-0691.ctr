Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := മാതൃക പുതിയ: ['([ac])'].
>> result := pattern പൊരുത്തം: subject ചെയ്യുക: { :m :x
	ഔട്ട്പുട്ട് എഴുതുക: m, പുതിയ-വരി.
	ഔട്ട്പുട്ട് എഴുതുക: x, പുതിയ-വരി. <- ശൂന്യം.
}.
ഔട്ട്പുട്ട് എഴുതുക: result, പുതിയ-വരി.