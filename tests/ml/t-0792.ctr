Server init.

>> DB := Maria-DB പുതിയ ഹോസ്റ്റ്: ['localhost'],
	ഉപയോക്തൃനാമം: ['xo'],
	രഹസ്യവാക്ക്: ['pass123'],
	ഡാറ്റാബേസ്-പേര്: ['xobase'],
	ബന്ധിപ്പിക്കുക.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ചോദ്യം: SQL.

# now you don't have to set DB
query2 കൊണ്ടുവരിക: { :row
	ഔട്ട്പുട്ട് എഴുതുക: row world, പുതിയ-വരി.
}.
