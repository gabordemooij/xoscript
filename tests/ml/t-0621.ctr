>> phrases := ശ്രേണി പുതിയ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ഓരോന്നും: { :_ :phrase 
	>> e := Server base64-എൻകോഡ്: phrase.
	>> d := Server base64-ഡീകോഡ്: e.
	ഔട്ട്പുട്ട് എഴുതുക: (
		message പകർപ്പ് ~encoded: e, ~decoded: d
	), പുതിയ-വരി.
}.
