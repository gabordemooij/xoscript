Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ശ്രേണി പുതിയ ;
	# {"key":"normal"} normal ASCII
	( നിഘണ്ടു പുതിയ വെക്കുക: ['normal'] താക്കോൽ: ['key'] ) ;
	# {"key":"hello world"} space character
	( നിഘണ്ടു പുതിയ വെക്കുക: ['hello world'] താക്കോൽ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( നിഘണ്ടു പുതിയ വെക്കുക: ['"'] താക്കോൽ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( നിഘണ്ടു പുതിയ വെക്കുക: ['backslash: \\'] താക്കോൽ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( നിഘണ്ടു പുതിയ വെക്കുക: ['slash: /'] താക്കോൽ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( നിഘണ്ടു പുതിയ വെക്കുക: ['backspace: \b'] താക്കോൽ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( നിഘണ്ടു പുതിയ വെക്കുക: ['formfeed: \f'] താക്കോൽ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( നിഘണ്ടു പുതിയ വെക്കുക: ['newline: \n'] താക്കോൽ: ['key'] ) ;
	( നിഘണ്ടു പുതിയ വെക്കുക: ['newline: ↵'] താക്കോൽ: ['key'] ) ;
	( നിഘണ്ടു പുതിയ വെക്കുക: ['newline: 
	'] താക്കോൽ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( നിഘണ്ടു പുതിയ വെക്കുക: ['carriage return: \r'] താക്കോൽ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( നിഘണ്ടു പുതിയ വെക്കുക: ['tab \t'] താക്കോൽ: ['key'] ) ;
	( നിഘണ്ടു പുതിയ വെക്കുക: ['tab ⇿'] താക്കോൽ: ['key'] ) ;
	( നിഘണ്ടു പുതിയ വെക്കുക: ['tab  '] താക്കോൽ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( നിഘണ്ടു പുതിയ വെക്കുക: ['NUL \u0000'] താക്കോൽ: ['key'] ) ;
	( നിഘണ്ടു പുതിയ വെക്കുക: ['NUL \0'] താക്കോൽ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( നിഘണ്ടു പുതിയ വെക്കുക: ['control: \u0001'] താക്കോൽ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( നിഘണ്ടു പുതിയ വെക്കുക: ['control: \u001F'] താക്കോൽ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( നിഘണ്ടു പുതിയ വെക്കുക: ['unicode: é'] താക്കോൽ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( നിഘണ്ടു പുതിയ വെക്കുക: ['unicode: €'] താക്കോൽ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( നിഘണ്ടു പുതിയ വെക്കുക: ['unicode: 日本語'] താക്കോൽ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( നിഘണ്ടു പുതിയ വെക്കുക: ['unicode: 😀'] താക്കോൽ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( നിഘണ്ടു പുതിയ വെക്കുക: ['unicode: 🧑‍💻'] താക്കോൽ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( നിഘണ്ടു പുതിയ വെക്കുക: ['combining: e\u0301'] താക്കോൽ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( നിഘണ്ടു പുതിയ വെക്കുക: ['escaped unicode: \u00e9'] താക്കോൽ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( നിഘണ്ടു പുതിയ വെക്കുക: ['escaped unicode: \u20ac'] താക്കോൽ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( നിഘണ്ടു പുതിയ വെക്കുക: ['escaped unicode: \ud83d\ude00'] താക്കോൽ: ['key'] ) ;
	# {"key":""} empty value
	( നിഘണ്ടു പുതിയ വെക്കുക: [''] താക്കോൽ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( നിഘണ്ടു പുതിയ വെക്കുക: ['@ < > & = % + ? #'] താക്കോൽ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( നിഘണ്ടു പുതിയ വെക്കുക: ['''] താക്കോൽ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( നിഘണ്ടു പുതിയ വെക്കുക: ['multiple: \" \\ \n \r \t'] താക്കോൽ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( നിഘണ്ടു പുതിയ വെക്കുക: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] താക്കോൽ: ['key'] ) ;
	# {"key":" value"} leading space
	( നിഘണ്ടു പുതിയ വെക്കുക: [' value'] താക്കോൽ: ['key'] ) ;
	# {"key":"value "} trailing space
	( നിഘണ്ടു പുതിയ വെക്കുക: ['value '] താക്കോൽ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( നിഘണ്ടു പുതിയ വെക്കുക: [' \t\n\r '] താക്കോൽ: ['key'] ).

dicts ഓരോന്നും: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (നിഘണ്ടു പുതിയ വെക്കുക: d key താക്കോൽ: ['key']).
	>> b := JSON jsonify: (നിഘണ്ടു പുതിയ വെക്കുക: ['value'] താക്കോൽ: d key).
	>> e := JSON വസ്തു: a.
	>> f := JSON വസ്തു: b.
	((e key = d key കൂടാതെ: (f ? d key = ['value'])) അല്ലെങ്കിൽ: (e key = ['NUL ?'])) ശരിയെങ്കിൽ: {
		ഔട്ട്പുട്ട് എഴുതുക: ['OK'], പുതിയ-വരി.
	}, ഇല്ലെങ്കിൽ: {
		ഔട്ട്പുട്ട് എഴുതുക: ['Unable to properly encode/decode: '] + d + j, പുതിയ-വരി.
		പ്രോഗ്രാം അവസാനിപ്പിക്കുക.
	}.
}.
