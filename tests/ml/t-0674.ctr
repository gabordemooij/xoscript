# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ഫയൽ-പാത := ['/tmp/dat.csv'].
>> csv := ഫയൽ പുതിയ: ഫയൽ-പാത.
csv എഴുതുക: s.

# accepts CRLF LF CR, varying row length
csv വിഭാജകം: [';'] ഉദ്ധരണി: ['"'] വരികൾ: { :line
	പ്രോഗ്രാം വൃത്തിയാക്കുക.
	ഔട്ട്പുട്ട് എഴുതുക: line, പുതിയ-വരി.
	പ്രോഗ്രാം വൃത്തിയാക്കുക.
}.

# unequal lines
s അവസാനം-ചേർക്കുക: ['\njustone'].
csv എഴുതുക: s.
{
	csv വിഭാജകം: [';'] ഉദ്ധരണി: ['"'] വരികൾ: { :line
		ഔട്ട്പുട്ട് എഴുതുക: line, പുതിയ-വരി.
	}.
} പിടിക്കുക: { :e 
	ഔട്ട്പുട്ട് എഴുതുക: e, പുതിയ-വരി.
}, പ്രവർത്തിപ്പിക്കുക.

# invalid format
s := ['"he"llo";world'].
csv എഴുതുക: s.
{
	csv വിഭാജകം: [';'] ഉദ്ധരണി: ['"'] വരികൾ: { :line
		ഔട്ട്പുട്ട് എഴുതുക: line, പുതിയ-വരി.
	}.
} പിടിക്കുക: { :e 
	ഔട്ട്പുട്ട് എഴുതുക: e, പുതിയ-വരി.
}, പ്രവർത്തിപ്പിക്കുക.
