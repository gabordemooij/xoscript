# a quote that never closes must give an error, not an endless loop
>> ഫയൽ-പാത := ['/tmp/test0821.csv'].
>> file := ഫയൽ പുതിയ: ഫയൽ-പാത.

file എഴുതുക: ['a,b\n"1,2\n'].
{
	file വിഭാജകം: [','] ഉദ്ധരണി: ['"'] വരികൾ: { :line
		ഔട്ട്പുട്ട് എഴുതുക: line, പുതിയ-വരി.
	}.
} പിടിക്കുക: { :e ഔട്ട്പുട്ട് എഴുതുക: e, പുതിയ-വരി. }, പ്രവർത്തിപ്പിക്കുക.

# a closed quote still works
file എഴുതുക: ['a,b\n"1,2",3'].
file വിഭാജകം: [','] ഉദ്ധരണി: ['"'] വരികൾ: { :line
	ഔട്ട്പുട്ട് എഴുതുക: line, പുതിയ-വരി.
}.
file മായ്ക്കുക.
