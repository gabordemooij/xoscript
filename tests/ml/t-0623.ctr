

>> g := Server പുതിയ.
>> v := നിലവറ പുതിയ.
>> ok := 0.

>> secrets := ശ്രേണി പുതിയ ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets പകർപ്പ്.
passwords ഓരോന്നും: { :i :p
	secrets ഓരോന്നും: { :n :s
		{
			>> encrypted := v എൻക്രിപ്റ്റ്: s താക്കോൽ: p.
			>> decrypted := v ഡീക്രിപ്റ്റ്: encrypted താക്കോൽ: p.
			(decrypted = s) ശരിയെങ്കിൽ: {
				ok കൂട്ടുക: 1.
			}, ഇല്ലെങ്കിൽ: {
				ഔട്ട്പുട്ട് എഴുതുക: ['failed encrypting/decrypting: '], പുതിയ-വരി.
				ഔട്ട്പുട്ട് എഴുതുക: s, പുതിയ-വരി.
				ഔട്ട്പുട്ട് എഴുതുക: ['encrypted: '] + encrypted, പുതിയ-വരി.
				ഔട്ട്പുട്ട് എഴുതുക: ['decrypted: '] + encrypted, പുതിയ-വരി.
				പ്രോഗ്രാം അവസാനിപ്പിക്കുക.
			}.
		} പിടിക്കുക: { :err
			(s = [''] അല്ലെങ്കിൽ: p = ['']) ശരിയെങ്കിൽ: {
				ok കൂട്ടുക: 1.
			}, ഇല്ലെങ്കിൽ: {
				ഔട്ട്പുട്ട് എഴുതുക: err, പുതിയ-വരി.
				പ്രോഗ്രാം അവസാനിപ്പിക്കുക.
			}.
		}, പ്രവർത്തിപ്പിക്കുക.
	}.
}.

ഔട്ട്പുട്ട് എഴുതുക: ( ok + [' vault encryptions tested.'] ), പുതിയ-വരി.