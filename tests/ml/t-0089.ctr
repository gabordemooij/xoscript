>> randomizer := { :a :b
	>> കുറഞ്ഞത് := ( a < b ) ഇത്: a അതല്ലെങ്കിൽ: b.
	>> കൂടിയത് := ( a > b ) ഇത്: a അതല്ലെങ്കിൽ: b.
	>> x := ശൂന്യം.
	{
		x := സംഖ്യ ഇടയിൽ: a മുതൽ: b.
		((x < കുറഞ്ഞത്) അല്ലെങ്കിൽ: (x > കൂടിയത്)) ശരിയെങ്കിൽ: { 
			ഔട്ട്പുട്ട് എഴുതുക: (['Invalid value!']).
			പ്രോഗ്രാം അവസാനിപ്പിക്കുക.
		}.
	} 
	× 100. <- x.
}.
