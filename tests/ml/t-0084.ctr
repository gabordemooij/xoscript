>> makeAdder := { :x
	>> f := { :y <- (തന്റെ x + y). } നിശ്ചയിക്കുക: ['x'] മൂല്യം: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i തന്റെ q വെക്കുക: (തന്റെ f പ്രയോഗിക്കുക: (തന്റെ q ? i)) താക്കോൽ: i. } 
	നിശ്ചയിക്കുക: ['q'] മൂല്യം: array,
	നിശ്ചയിക്കുക: ['f'] മൂല്യം: func.
	{ :i mapping പ്രയോഗിക്കുക: i. } × (array എണ്ണം).
}.

>> a := ശ്രേണി ← 1; 2; 3.
mapper പ്രയോഗിക്കുക: a കൂടാതെ: (makeAdder പ്രയോഗിക്കുക: 100).
ഔട്ട്പുട്ട് എഴുതുക: (a സ്ഥാനം: 0), പുതിയ-വരി.
ഔട്ട്പുട്ട് എഴുതുക: (a ? 1), പുതിയ-വരി.
ഔട്ട്പുട്ട് എഴുതുക: (a ? 2), പുതിയ-വരി.
