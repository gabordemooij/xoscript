# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := മാതൃക പുതിയ: pattern.
	p പൊരുത്തം: subject ചെയ്യുക: { :m :g
		ഔട്ട്പുട്ട് എഴുതുക: g എണ്ണം, എഴുതുക: [' '], എഴുതുക: (g ചേർക്കുക: ['|']), പുതിയ-വരി. <- m.
	}.
}.
show പ്രയോഗിക്കുക: ['(a)|(b)'] കൂടാതെ: ['b'].
show പ്രയോഗിക്കുക: ['(a)|(b)'] കൂടാതെ: ['a'].
show പ്രയോഗിക്കുക: ['(x)?y'] കൂടാതെ: ['y'].
show പ്രയോഗിക്കുക: ['(x)?(y)(z)?'] കൂടാതെ: ['xy'].
