60 × {
	>> x := (സംഖ്യ random % 6) + 1.
	(x ≤ 6) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	(x ≥0) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	x := (സംഖ്യ random % 3) + 1.
	(x < 3) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	(x>-1) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	x := ((ബൂളിയൻ flip) സംഖ്യയായി).
	(x = 0 അല്ലെങ്കിൽ: x = 1) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	x := ((ശരി flip) സംഖ്യയായി).
	(x = 0 അല്ലെങ്കിൽ: x = 1) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
	x := (ബൂളിയൻ flip ഇത്: ['HEAD'] അതല്ലെങ്കിൽ: ['TAIL']).
	((x = ['HEAD']) അല്ലെങ്കിൽ: (x = ['TAIL'])) തെറ്റെങ്കിൽ: { ഔട്ട്പുട്ട് എഴുതുക: ['FAIL']. }.
}.
ഔട്ട്പുട്ട് എഴുതുക: ['DONE'].

