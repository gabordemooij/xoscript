

Dhaptar nalika: ['sum'] tindakna: {
	>> total := 0.
	dhiri saben: { :index :element
		total tambah: element.
	}. <- total.
}.

Dhaptar nalika: ['product'] tindakna: {
	>> total := 1.
	dhiri saben: { :index :element
		total pingna: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

{

>> a := Dhaptar ← ['hello'] ; ['world'] ; Bener ; Kosong ; 666.
a := a + ( Dhaptar ← 1 ).
Wetonan tulis: ( ['sum: '] + ( a sum ) ), baris-anyar.
Wetonan tulis: ( ['min: '] + ( a minimum ) ), baris-anyar.
Wetonan tulis: ( ['max: '] + ( a maksimum ) ), baris-anyar.
Wetonan tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-anyar.
Wetonan tulis: ( ['prd: '] + ( a product ) ), baris-anyar.
a urutna: { :a :b <- (b - a). }.
a saben: { :i :e Wetonan tulis: ( i - 0 ), baris-anyar. }.

} wiwiti.

Program resiki.
usedMemory1 := (Program memori ? 0).


