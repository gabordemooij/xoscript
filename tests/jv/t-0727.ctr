Server init.
>> f := Format anyar: ['%d'].
>> a := Blob anyar: 4.
a bytes: ( Dhaptar anyar ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob anyar: 4.
b bytes: ( Dhaptar anyar ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a saka: 0 dawa: 3, saben: { :i :byte
	Wetonan tulis: ( f trapna-wilangan-wutuh: byte ), baris-anyar.
}.
a ^ b.
a saka: 0 dawa: 3, saben: { :i :byte
	Wetonan tulis: ( f trapna-wilangan-wutuh: byte ), baris-anyar.
}.
a ^ b.
a saka: 0 dawa: 3, saben: { :i :byte
	Wetonan tulis: ( f trapna-wilangan-wutuh: byte ), baris-anyar.
}.
a bebasna.
b bebasna.

{ a ^ Obyek. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti.
