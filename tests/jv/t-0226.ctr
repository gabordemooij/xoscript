# Test ASCII variants

# Numbers

Wetonan tulis: (2 !=: 3), baris-anyar.
Wetonan tulis: (2 <=: 2), baris-anyar.
Wetonan tulis: (2 >=: 2), baris-anyar.

# Strings

Wetonan tulis: (['b'] >=: ['a']), baris-anyar.
Wetonan tulis: (['b'] !=: ['a']), baris-anyar.
Wetonan tulis: (['b'] <=: ['c']), baris-anyar.

# Bools

Wetonan tulis: (Bener !=: Salah), baris-anyar.

# Objects

Wetonan tulis: (Obyek anyar !=: Obyek anyar), baris-anyar.

# ASCII list symbol <-:

Wetonan tulis: (Dhaptar <<: 1, ; 2 ; 3) cacah = 3, baris-anyar.

