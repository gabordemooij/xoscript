# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> parameter-panggolekan := db kueri: ['SELECT %% FROM'].
{ parameter-panggolekan lakokna. } cekel: { :e
	Wetonan tulis: ( e ngemot: ['%%'] ), baris-anyar.
}, wiwiti.
