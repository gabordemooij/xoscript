>> invoice := Obyek anyar.
invoice nalika: ['wiwiti'] tindakna: {
        duweke angka := 0.
}.

invoice nalika: ['angka'] tindakna: {
        duweke angka tambah: 1. <- duweke angka salin.
}.

>> year-invoice := invoice anyar.
year-invoice nalika: ['start:'] tindakna: { :taun
	duweke angka := taun.
}.

year-invoice start: 202000.
Wetonan tulis: year-invoice angka, baris-anyar.
Wetonan tulis: year-invoice angka, baris-anyar.
