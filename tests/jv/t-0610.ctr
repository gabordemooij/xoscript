
>> Rectangle := Obyek anyar.

Rectangle nalika: ['area'] tindakna: { <- duweke dawa * duweke width.
}.

Rectangle nalika: ['length:'] tindakna: { :dawa
	duweke dawa := dawa.
}.

Rectangle nalika: ['width:'] tindakna: { :width
	duweke width := width.
}.

Rectangle nalika: ['anyar'] tindakna: {
	# this will not result into an infinite loop
	>> rectangle := dhiri anyar.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle anyar.
Wetonan tulis: a area, baris-anyar. #0

>> b := Rectangle anyar length: 2, width: 3.
Wetonan tulis: b area, baris-anyar. #6

