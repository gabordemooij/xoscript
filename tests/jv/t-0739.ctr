Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :binhelper
	duweke binhelper := binhelper. 
}.

a nalika: ['item'] tindakna: { <- duweke binhelper.
}.

a item: Bin anyar.

>> old-binhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-binhelper-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.


