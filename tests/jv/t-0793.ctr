Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

{
	DB kueri:
	['DROP TABLE movies'],
	lakokna.
} cekel: { Kosong. }, wiwiti.

DB kueri:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
lakokna.

DB kueri: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Dhaptar anyar ; ['Halloween'] ),
lakokna.

DB kueri: ['SELECT * FROM movies'],
jupuk: { :movie
	Wetonan tulis: movie title, baris-anyar.
}.

