>> q := Dhaptar ← 1 ; 2 ; 3.
{ q ? ['1']. } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? Bener. } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? Salah. } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? Kosong. } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? (Dhaptar anyar). } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? (Obyek anyar). } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
{ q ? ({ ['Empty']. }). } cekel: { Wetonan tulis: ['caught!'], baris-anyar. }, wiwiti.
Wetonan tulis: ['caught them all'], baris-anyar.
