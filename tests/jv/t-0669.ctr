# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Brankas 
	hash-sandhi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Brankas 
	hash-sandhi: hash priksa: a1.
	# fail 
>> b := Brankas
	hash-sandhi: hash priksa: a2.
	# ok!

Wetonan tulis: a, baris-anyar.
Wetonan tulis: b, baris-anyar.

