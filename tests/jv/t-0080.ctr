{
	>> a := Dhaptar anyar.
	a tambah-ing-mburi: 1.
	a tambah-ing-mburi: 2.
	Wetonan tulis: (a gabung: [',']), baris-anyar.
	a seleh: 3 ing: 2.
	Wetonan tulis: (a gabung: [',']), baris-anyar.
	a seleh: 4 ing: 10.
	Wetonan tulis: (a gabung: [',']), baris-anyar.
	a jupuk-pisanan.
	a jupuk-pisanan.
	a jupuk-pisanan.
	Wetonan tulis: (a gabung: [',']), baris-anyar.
	a seleh: 9 ing: 0.
	Wetonan tulis: (a gabung: [',']), baris-anyar.
	a seleh: 6 ing: -1.
} cekel: { :e
	Wetonan tulis: ['Uncatched error has occurred.↵'] + e, baris-anyar.
}, wiwiti.


