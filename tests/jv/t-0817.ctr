# a value ending in the first part of an opening quote must survive serialization
>> nilai-nilai := Dhaptar anyar
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

nilai-nilai saben: { :i :value
	>> d := Kamus anyar.
	d seleh: value ing: ['k'].
	d seleh: ['second'] ing: ['j'].
	>> r := d kode obyek.
	Wetonan tulis: r cacah, baris-anyar.
	Wetonan tulis: ( (r ing: ['k']) = value ), baris-anyar.
}.
