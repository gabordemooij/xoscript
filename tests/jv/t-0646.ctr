Server init.
Wetonan tulis: ['Database datetime test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'], 
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> parameter-panggolekan :=
db kueri: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
jupuk: { :row
	Wetonan tulis: row datetimetest, baris-anyar.
}.
