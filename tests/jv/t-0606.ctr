>> Point := Obyek anyar.
Point nalika: ['x-coordinate:'] tindakna: { :x duweke x := x. }.
Point nalika: ['y-coordinate:'] tindakna: { :y duweke y := y. }.
Point nalika: ['x-coordinate']  tindakna: { <- duweke x salin. }.
Point nalika: ['y-coordinate']  tindakna: { <- duweke y salin. }.

Point nalika: ['='] tindakna: { :other <- ( duweke x = other x-coordinate
		 lan: duweke y = other y-coordinate ).
}.

>> pier := Point anyar x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point anyar x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point anyar x-coordinate: 5, y-coordinate: 6.

Wetonan tulis: pier = town-hall, baris-anyar.
Wetonan tulis: pier = restaurant, baris-anyar.
