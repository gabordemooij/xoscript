{
	tugas-iki kesalahan: ['Dont fail.'].
	unknown doSomething.
} cekel: {
	Wetonan tulis: ['Caught!'].
}, wiwiti.

{
	tugas-iki kesalahan: ['Dont fail.'].
	duweke unknown doSomething.
} cekel: {
	Wetonan tulis: ['Caught!'].
}, wiwiti.

{
	tugas-iki kesalahan: ['Dont fail.'].
	unknown := 122.
} cekel: {
	Wetonan tulis: ['Caught!'].
}, wiwiti.


{
	tugas-iki kesalahan: ['Dont fail.'].
	Bener pedhot.
	Wetonan tulis: ['FAIL'].
} cekel: {
	Wetonan tulis: ['Caught!'].
}, wiwiti.

{
	{
		tugas-iki kesalahan: ['Dont fail.'].
		Bener pedhot.
		Wetonan tulis: ['FAIL'].
	} cekel: { :x
		(x = ['Dont fail.']) bener: { tugas-iki kesalahan: ['Nested Caught!']. }.
	}, wiwiti.
} cekel: { :e
	Wetonan tulis: e.
}, wiwiti.
