>> randomizer := { :a :b
	>> minimum := ( a < b ) pilih: a utawa: b.
	>> maksimum := ( a > b ) pilih: a utawa: b.
	>> x := Kosong.
	{
		x := Angka antarane: a lan: b.
		((x < minimum) utawa: (x > maksimum)) bener: { 
			Wetonan tulis: (['Invalid value!']).
			Program rampungna.
		}.
	} 
	× 100. <- x.
}.
randomizer trapna: 0 lan: 0.
randomizer trapna: 1 lan: 0.
randomizer trapna: 1 lan: 1.
randomizer trapna: 0 lan: 1.
randomizer trapna: -1 lan: 0.
randomizer trapna: -1 lan: -1.
randomizer trapna: 0 lan: -1.
randomizer trapna: 100 lan: 200.
randomizer trapna: 999999999999998 lan: 999999999999999.
randomizer trapna: 999999999999999 lan: 999999999999998.
randomizer trapna: 999999999999999 lan: 999999999999999.
randomizer trapna: -999999999999998 lan: -999999999999999.
randomizer trapna: -999999999999999 lan: -999999999999998.
randomizer trapna: -999999999999999 lan: -999999999999999.
randomizer trapna: 999999999999998 lan: -999999999999999.
randomizer trapna: 999999999999999 lan: -999999999999998.
randomizer trapna: 999999999999999 lan: -999999999999999.
randomizer trapna: -999999999999998 lan: 999999999999999.
randomizer trapna: -999999999999999 lan: 999999999999998.
randomizer trapna: -999999999999999 lan: 999999999999999.
