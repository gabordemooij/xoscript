
>> shop := (Kamus anyar
	seleh: ['magazine'] ing: ['books'],
	seleh: ['computer'] ing: ['electronics'],
	seleh: ['lipstick'] ing: ['cosmetics']
).
Wetonan tulis: (shop nduweni: ['computer']), baris-anyar. 
Wetonan tulis: (shop nduweni: ['sausage']), baris-anyar. 
Wetonan tulis: (shop nduweni: ['computers']), baris-anyar. 
Wetonan tulis: (shop nduweni: ['compute']), baris-anyar. 
Wetonan tulis: (shop nduweni: ['2computer']), baris-anyar. 
