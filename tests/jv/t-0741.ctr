Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :octhelper
	duweke octhelper := octhelper. 
}.

a nalika: ['item'] tindakna: { <- duweke octhelper.
}.

a item: Oct anyar.

>> old-octhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-octhelper-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
