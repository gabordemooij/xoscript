Wetonan tulis: ['Test object'], baris-anyar.
>> greeter := Obyek anyar.
greeter nalika: ['name:'] tindakna: { :jeneng
	duweke xname := jeneng. 
}.
greeter nalika: ['greet'] tindakna: {
	Wetonan tulis: ['Hello '] + duweke xname, baris-anyar.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
