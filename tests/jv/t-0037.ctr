>> a := 3.
>> b := a salin.
a suda: 1.
Wetonan tulis: [' a = '] + a.
Wetonan tulis: [' b = '] + b.
a := 3.
b := a + 4.
Wetonan tulis: [' a = '] + a.
Wetonan tulis: [' b = '] + b.
>> x := 3.
>> y := x salin.
x tambah: 10.
y suda: 1.
Wetonan tulis: [' x = '] + x.
Wetonan tulis: [' y = '] + y.
>> q := Obyek anyar.
q nalika: ['setProperty:'] tindakna: { :x
	duweke prop := x.
}.
q nalika: ['getProperty'] tindakna: { <- duweke prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Wetonan tulis: [' p = '] + (p getProperty).
