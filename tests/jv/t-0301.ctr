


>> wine := Obyek anyar.


wine nalika: ['toString'] tindakna: { <- ['merlot'].
}.

wine nalika: ['naarTekst'] tindakna: { <- ['merlot'].
}.


wine nalika: ['='] tindakna: { :other wine <- ( dhiri toString = other wine ).
}.

wine nalika: ['=='] tindakna: { :other wine <- ( dhiri toString = other wine ).
}.



wine
	kasus: ['cabernet'] tindakna: { Wetonan tulis: ['it's a Cabernet!']. },
	kasus: ['syrah']    tindakna: { Wetonan tulis: ['it's a Syrah!'].    },
	kasus: ['merlot']   tindakna: { Wetonan tulis: ['it's a Merlot!'].   },
	kasus: ['malbec']   tindakna: { Wetonan tulis: ['it's a Malbec!'].   }.

Wetonan baris-anyar.
