
Angka sinau: ['plus:'] tegese: ['+'].
Angka nalika: ['+'] tindakna: { :x
	>> rate := 1.
	>> currency := x satuan-angka.
	(currency = ['euros']) bener: {
		rate := 2.
	}. <- (dhiri plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars satuan: ['dollars'].
euros satuan: ['euros'].
>> money := dollars + euros.
Wetonan tulis: money, baris-anyar.
