>> x := Obyek anyar.
>> y := Obyek anyar.
>> z := x.
Wetonan tulis: (x = z), baris-anyar.
Wetonan tulis: (x = y), baris-anyar.
Wetonan tulis: (x ≠ y), baris-anyar.
Wetonan tulis: (x ≠ z), baris-anyar.
>> m := Wektu anyar taun: 2070, wulan: 11.
>> n := m salin.
Wetonan tulis: (m = n), baris-anyar.
Wetonan tulis: (m ≠ n), baris-anyar.
Wetonan tulis: (m padha-karo: m), baris-anyar.
Wetonan tulis: (m padha-karo: n), baris-anyar.
n wulan: 12.
Wetonan tulis: (m ≠ n), baris-anyar.
Wetonan tulis: (m = n), baris-anyar.


