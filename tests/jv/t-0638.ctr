
Server init.
>> rq := Panjaluk-HTTP anyar.
Wetonan tulis: ['HTTP-GET d[]=']  + ( rq get-dhaptar: ['d[]'] ), baris-anyar. # GET
Wetonan tulis: ['HTTP-GET f[]=']  + ( rq get-dhaptar: ['f[]'] ), baris-anyar. # GET
Wetonan tulis: ['HTTP-POST e[]='] + ( rq post-dhaptar: ['e[]'] ), baris-anyar. # GET
Wetonan tulis: ['HTTP-POST c=']   + ( rq post: ['c'] ), baris-anyar. # GET
Wetonan tulis: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), baris-anyar. # GET
