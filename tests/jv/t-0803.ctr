Server init.

>> conn1 := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> conn2 := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.
#...
>> del := conn1 kueri: ['DELETE FROM book WHERE id > 0'].
{  del lakokna. conn1 tetepna. } cekel: { :e conn1 batalna.  }, wiwiti.

>> insert := conn1 kueri: ['INSERT INTO book (id) VALUES(null)'].
insert lakokna.

>> cacah := conn1 kueri: ['SELECT COUNT(*) AS num FROM book'].
cacah jupuk: { :row Wetonan tulis: row num, baris-anyar. }.

# does not show up
# insert not committed on connection 1
>> cacah := conn2 kueri: ['SELECT COUNT(*) AS num FROM book'].
cacah jupuk: { :row Wetonan tulis: row num, baris-anyar. }.
