#Linux

(Berkas anyar: ['/tmp/testje']) ana salah: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Berkas anyar: ['/tmp/testje/file1']) ana salah: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Berkas anyar: ['/tmp/testje/folder1']) ana salah: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Berkas dhaptar: ['/tmp/testje'].

>> q := Dhaptar anyar.

l saben: { :k :v v saben: { :x :y q tambah-ing-mburi: y. }. }.

>> s := q tèks.

(s ngemot: ['file1']) bener:   { Wetonan tulis: ['OK'], baris-anyar. }.
(s ngemot: ['file2']) bener:   { Wetonan tulis: ['XX'], baris-anyar. }.
(s ngemot: ['folder1']) bener: { Wetonan tulis: ['OK'], baris-anyar. }.
