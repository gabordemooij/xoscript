Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :fmt
	duweke fmt := fmt. 
}.

a nalika: ['item'] tindakna: { <- duweke fmt.
}.

a item: ( Format anyar: ['|%s|'] ).

Wetonan tulis: a item, baris-anyar.

>> old-fmt-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-fmt-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.

Wetonan tulis: ( b item trapna: ['hello'] ), baris-anyar.
