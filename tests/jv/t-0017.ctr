Angka nalika: ['factorial'] tindakna: {
	>> total := 1.
	{ :index total pingna: (dhiri - (index)). } × dhiri. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Wetonan tulis: a.
>> b := 2 + 3 factorial.
Wetonan tulis: b.
>> c := 3 factorial + 2.
Wetonan tulis: c.
>> d := 2 + (3 factorial).
Wetonan tulis: d.
Wetonan tulis: 2 + 3 factorial + 1.
