Wetonan tulis: ((Dhaptar anyar
	nalika: ['plaque:'] tindakna: { :x duweke o := x. },
	nalika: ['plaque']  tindakna: { <- duweke o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Dhaptar ← 1)
	~ (Dhaptar ← 1 ; 2)
	~ (Dhaptar ← 1 ; 2 ; 3)
	~ (Dhaptar ← 1 ; 2 ; 3 ; 4)
	~ (Dhaptar ← 1 ; 2 ; 3 ; 4 ; 5)
) saben: { :i :el
	{ Wetonan tulis: tugas-iki. } × el cacah.
	Wetonan baris-anyar.
}) plaque, baris-anyar.


