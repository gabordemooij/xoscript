60 × {
	>> x := (Angka random % 6) + 1.
	(x ≤ 6) salah: { Wetonan tulis: ['FAIL']. }.
	(x ≥0) salah: { Wetonan tulis: ['FAIL']. }.
	x := (Angka random % 3) + 1.
	(x < 3) salah: { Wetonan tulis: ['FAIL']. }.
	(x>-1) salah: { Wetonan tulis: ['FAIL']. }.
	x := ((Boolean flip) angka).
	(x = 0 utawa: x = 1) salah: { Wetonan tulis: ['FAIL']. }.
	x := ((Bener flip) angka).
	(x = 0 utawa: x = 1) salah: { Wetonan tulis: ['FAIL']. }.
	x := (Boolean flip pilih: ['HEAD'] utawa: ['TAIL']).
	((x = ['HEAD']) utawa: (x = ['TAIL'])) salah: { Wetonan tulis: ['FAIL']. }.
}.
Wetonan tulis: ['DONE'].

