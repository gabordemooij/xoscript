>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Kosong.
>> q := Obyek anyar.
>> p := q.
(a padha-karo: a) bener: { Wetonan tulis: ['Y1']. }.
(a padha-karo: b) bener: { Wetonan tulis: ['Y2']. }.
(a padha-karo: c) bener: { Wetonan tulis: ['Y3']. }.
(a padha-karo: z) bener: { Wetonan tulis: ['Y4']. }.
(z padha-karo: a) bener: { Wetonan tulis: ['Y5']. }.
(q padha-karo: q) bener: { Wetonan tulis: ['Y6']. }.
(p padha-karo: q) bener: { Wetonan tulis: ['Y7']. }.
(p padha-karo: a) bener: { Wetonan tulis: ['Y8']. }.
(p padha-karo: Kosong) bener: { Wetonan tulis: ['Y9']. }.
