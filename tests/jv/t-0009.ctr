>> Greeter := Obyek anyar.
Greeter nalika: ['make'] tindakna: {
	>> greeter := Obyek anyar.
	greeter nalika: ['name:'] tindakna: { :jeneng
		Wetonan tulis: ['setting a name'].
		duweke myName := jeneng.
	}.
	greeter nalika: ['performGreeting'] tindakna: {
		Wetonan tulis: ['Hello'].
		Wetonan tulis: duweke myName.
	}.
	greeter nalika: ['greet'] tindakna: {
		dhiri performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
