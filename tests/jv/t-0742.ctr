Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :hexhelper
	duweke hexhelper := hexhelper. 
}.

a nalika: ['item'] tindakna: { <- duweke hexhelper.
}.

a item: Hx anyar.

>> old-hexhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-hexhelper-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
