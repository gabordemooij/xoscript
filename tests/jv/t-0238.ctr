Tèks nalika: ['evaluate'] tindakna: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (dhiri tèks + ['.']).
	Program gunakna: ['/tmp/eval.ctr'].
}.

>> a := Dhaptar ← 1 ; 2 ; 3.
>> b := (a tèks).

Wetonan tulis: b, baris-anyar. 
(['b := '] + b) evaluate.

Wetonan tulis: b ? 2, baris-anyar. 

Wetonan tulis: (( Dhaptar ← 1 ; 2 ; 3 )), baris-anyar. 

Wetonan tulis: ((Kamus anyar) seleh: 1 ing: 2), baris-anyar. 

>> x := ( (Dhaptar ← 1 ; ( Dhaptar ← 9 ) ; Bener ) ) tèks.
Wetonan tulis: x, baris-anyar. 
(['x := '] + x) evaluate.

Wetonan tulis: x ? 1 ? 0, baris-anyar. 

>> y := (Kamus anyar) seleh: (Dhaptar ← 1) ing: (Dhaptar ← 2).
Wetonan tulis: y, baris-anyar. 

(['y := '] + y) tèks evaluate.

Wetonan tulis: (y ing: (Dhaptar ← 2) tèks ), baris-anyar.

Wetonan tulis: (Dhaptar anyar), baris-anyar. 
Wetonan tulis: (Kamus anyar), baris-anyar. 
