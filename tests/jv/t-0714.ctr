>> a := Obyek anyar. 
a nalika: ['greet'] tindakna: { Wetonan tulis: ['welcome!'], baris-anyar. }.
a nalika: ['greet2'] tindakna: { Wetonan tulis: ['welcome2!'], baris-anyar. }.
a save-as: ['/tmp/a.bin'].

Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
b greet2.