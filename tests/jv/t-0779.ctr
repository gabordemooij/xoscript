Wetonan tulis: ['Test object'], baris-anyar.
>> p := Dalan /tmp.
Wetonan tulis: p, baris-anyar.
>> old-p-address := p prototipe alamat-memori.
p save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-p-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
Wetonan tulis: b, baris-anyar.
