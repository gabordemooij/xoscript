Boolean nalika: ['xor:'] tindakna: { :a :b <- ((a lan: b dudu) utawa: (a dudu lan: b)).
}.

>> o := Obyek anyar.
o nalika: ['hello'] tindakna: { ['Empty']. }.
{ o nalika: 2 tindakna: 3.} cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti.
{ o nalika: ['uji'] tindakna: 3.} cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti.
{ o nalika: ['hello'] tindakna: { ['Empty']. }.} cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ >> z := 4 ÷ 0. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ (Bener lan: Kosong) bener: { Wetonan tulis: ['X'].}. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ ([''] xor: 0) bener: { Wetonan tulis: ['X'].}. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ (1 < ['2']) bener: { Wetonan tulis: ['OK']. }. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ (1 < ['2.0']) bener: { Wetonan tulis: ['OK']. }. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ (1 < ['x2.0']) bener: { Wetonan tulis: ['NO!']. }. } cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti. 
{ Wetonan tulis: (['hello OK there'] saka: ['6'] dawa: ['2']). } wiwiti. 
