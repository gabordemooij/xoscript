# backslashes must survive code serialization, strings must not end early
>> nilai-nilai := Dhaptar anyar
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

nilai-nilai saben: { :i :value
	>> d := Kamus anyar.
	d seleh: value ing: ['k'].
	>> r := d kode obyek.
	Wetonan tulis: r cacah, baris-anyar.
	Wetonan tulis: ( (r ing: ['k']) = value ), baris-anyar.
}.
