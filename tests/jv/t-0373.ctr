# compliance test

# use international numbers

Wetonan tulis: ['1000 -> '].
Wetonan tulis: 1000, baris-anyar. #1000

Wetonan tulis: ['1.5 -> '].
Wetonan tulis: 1.5, baris-anyar.  #1.5

Wetonan tulis: ['1001.5 -> '].
Wetonan tulis: 1.5 + 1000, baris-anyar. #1001.5

# use 0-indexed arrays
>> x := Dhaptar anyar ; 1 ; 2 ; 3.
>> y := Dhaptar anyar ; ['a'] ; ['b'] ; ['c'].

Wetonan tulis: ['1 -> '].
Wetonan tulis: x ? 0, baris-anyar. #1

Wetonan tulis: ['1 -> '].
Wetonan tulis: (x ing: 0), baris-anyar. #1

Wetonan tulis: ['1 -> '].
Wetonan tulis: x pisanan, baris-anyar. #1

Wetonan tulis: ['3 -> '].
Wetonan tulis: x pungkasan, baris-anyar. #3

Wetonan tulis: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Wetonan tulis: (x miturut: y), baris-anyar.

Wetonan tulis: ['1 -> '].
Wetonan tulis: (x saka: 0 dawa: 1) pisanan, baris-anyar. #1

Wetonan tulis: ['0 -> '].
Wetonan tulis: (x golek: 1), baris-anyar. #0

x seleh: 9 ing: 0.

Wetonan tulis: ['9 -> '].
Wetonan tulis: (x ing: 0), baris-anyar. #9

x tambah-ing-ngarep: 8.
Wetonan tulis: ['8 -> '].
Wetonan tulis: (x ing: 0), baris-anyar. #9


x tambah-ing-mburi: 10.
Wetonan tulis: ['10 -> '].
Wetonan tulis: (x ing: 4), baris-anyar. #10








