['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Wetonan tulis: (x + y), baris-anyar.

>> x := 10040.07.
>> y := 10305.60.

Wetonan tulis: (x + y), baris-anyar.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Wetonan tulis: (x + y + z), baris-anyar.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Wetonan tulis: (x + y + z), baris-anyar.

>> q := 0.1.2.

Wetonan tulis: (q), baris-anyar.

>> q := 012.

Wetonan tulis: (q), baris-anyar.
