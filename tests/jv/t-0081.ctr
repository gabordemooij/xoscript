>> map1 := Kamus anyar.
>> key1 := Dhaptar anyar.
>> key2 := Dhaptar anyar.

map1
	seleh: ['hello'] ing: key1,
	seleh: ['world'] ing: key2.


Wetonan
	tulis: ['Map #1 contains: '] + (map1 ing: key1),
	tulis: [' and '] + (map1 ing: key2), baris-anyar.

>> KeyeableArray := Dhaptar anyar.
KeyeableArray nalika: ['toString'] tindakna: { <- (dhiri cacah) toString.
}.

>> map2 := Kamus anyar.
key1 := KeyeableArray anyar.
key2 := KeyeableArray anyar.

key1 tambah-ing-mburi: 1.

map2
	seleh: ['hello'] ing: key1,
	seleh: ['world'] ing: key2.

Wetonan
	tulis: ['Map #2 contains: '] + (map2 ing: key1),
	tulis: [' and '] + (map2 ing: key2), baris-anyar.
