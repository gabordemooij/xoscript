>> To-Do := Obyek anyar.

To-Do nalika: ['anyar'] tindakna: {
	duweke list := Dhaptar anyar.
}.

To-Do nalika: ['nieuw'] tindakna: {
	duweke list := Dhaptar anyar.
}.

To-Do nalika: ['+'] tindakna: { :task
	duweke list tambah-ing-mburi: task.
}.

To-Do nalika: ['number of tasks?'] tindakna: { <-  duweke list cacah.
}.

>> todos := 
	To-Do anyar 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Wetonan tulis: ['You have $ tasks to do'] $ todos number of tasks?.
