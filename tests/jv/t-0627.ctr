

# create a 64-bit integer for exact calculations
>> a := Int64 saka-teks: ['123'].

# to string
Wetonan tulis: a, baris-anyar.

# divide
Wetonan tulis: a / (Int64 saka-teks: ['3']), baris-anyar.

# multiply
Wetonan tulis: a * (Int64 saka-teks: ['2']), baris-anyar.

# add
Wetonan tulis: a + (Int64 saka-teks: ['1']), baris-anyar.

# subtract
Wetonan tulis: a - (Int64 saka-teks: ['2']), baris-anyar.

# compare
Wetonan tulis: ( a =   (Int64 saka-teks: ['123'])), baris-anyar.
Wetonan tulis: ( a !=: (Int64 saka-teks: ['124'])), baris-anyar.
Wetonan tulis: ( a <   (Int64 saka-teks: ['124'])), baris-anyar.
Wetonan tulis: ( a >   (Int64 saka-teks: ['122'])), baris-anyar.
Wetonan tulis: ( a >=: (Int64 saka-teks: ['123'])), baris-anyar.
Wetonan tulis: ( a <=: (Int64 saka-teks: ['123'])), baris-anyar.





	