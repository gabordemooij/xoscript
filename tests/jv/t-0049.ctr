>> f2 := Berkas anyar: ['/tmp/test.txt'].
(f2 ana) bener: { f2 busak.}.
Wetonan tulis: f2 dalan.
f2 tulis: ['Hello!'].
f2 tambah-ing-mburi: ['World!'].
