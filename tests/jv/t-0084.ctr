>> makeAdder := { :x
	>> f := { :y <- (duweke x + y). } atur: ['x'] nilai: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i duweke q seleh: (duweke f trapna: (duweke q ? i)) ing: i. } 
	atur: ['q'] nilai: array,
	atur: ['f'] nilai: func.
	{ :i mapping trapna: i. } × (array cacah).
}.

>> a := Dhaptar ← 1; 2; 3.
mapper trapna: a lan: (makeAdder trapna: 100).
Wetonan tulis: (a posisi: 0), baris-anyar.
Wetonan tulis: (a ? 1), baris-anyar.
Wetonan tulis: (a ? 2), baris-anyar.
