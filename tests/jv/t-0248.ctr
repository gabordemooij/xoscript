

Tèks nalika: ['evaluate'] tindakna: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: dhiri tèks + ['.'].
	Program gunakna: ['/tmp/eval.ctr'].
}.

>> a := (Dhaptar ← (
	(Kamus anyar)
		seleh: ['domain'] ing: ['mywebsite.com'],
		seleh: (Dhaptar ←
			((Kamus anyar)
				seleh: ['home'] ing: ['title'],
				seleh: ['<html></html>'] ing: ['body'],
				seleh: ['2017-01-01'] ing: ['created']
			) ;
			((Kamus anyar)
				seleh: ['aboutus(c)'] ing: ['title'],
				seleh: ['<credits>Author Inc.</credits>'] ing: ['body']
			)
		) ing: ['pages']
	)
) tèks.

Wetonan tulis: a jinis, baris-anyar.
Wetonan tulis: a, baris-anyar.

>> b := Kosong.
(['b := '] + a) evaluate.
Wetonan tulis: b ? 0 ? ['pages'] ? 1 ? ['body'], baris-anyar.

>> c := b ? 0.
>> d := c tèks.
Wetonan tulis: d jinis, baris-anyar.

>> e := Kosong.
(['e := '] + d) evaluate.
Wetonan tulis: e ? ['pages'] ? 0, baris-anyar.
