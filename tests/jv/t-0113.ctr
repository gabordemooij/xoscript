Wetonan tulis: ['Continue for-loop, No - before 6 and up.'], baris-anyar.
{ :i
	Wetonan tulis: (i + 1), baris-anyar.
	((i + 1) > 4) terusna.
	Wetonan tulis: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Wetonan baris-anyar.
Wetonan tulis: ['Continue while-true, No --> before 5 and up.'], baris-anyar.
{
	Wetonan tulis: ['iteration #'] + x, baris-anyar.
	x tambah: 1.
	((x < 5) dudu) terusna.
	Wetonan tulis: ['-->'].
} sasuwene: xIsLessThan10.
Wetonan baris-anyar.
Wetonan tulis: ['Continue while-false, No - before 3 only.'], baris-anyar.
{
	Wetonan tulis: ['iteration #'] + x, baris-anyar.
	x suda: 1.
	(x = 3) terusna.
	Wetonan tulis: ['-'].
} sasuwene: { <- ( x > 0). }.

Wetonan baris-anyar.
Wetonan tulis: ['Continue times-loop, No ||| before 3.'], baris-anyar.
{ :i
	Wetonan tulis: ['iteration #'] + i, baris-anyar.
	(i = 2) terusna.
	Wetonan tulis: ['|||'].
} × 5.

Wetonan baris-anyar.

{ Bener terusna. Wetonan tulis: ['dont write this!'], baris-anyar. } wiwiti.

{ Bener terusna. Wetonan tulis: ['dont write this!'], baris-anyar. } cekel: { Wetonan tulis: ['Dont catch this!']. }, wiwiti.

Wetonan tulis: ['Test Array each-loop: 0, ... ,2'], baris-anyar.
(Dhaptar ← 1 ; 2 ; 3) owahi: { :i
	(i = 1) terusna.
	Wetonan tulis: ['iteration #'] + (i - 0), baris-anyar.
}.

Wetonan tulis: ['Test Map each-loop: c only'], baris-anyar.
>> m := Kamus anyar.
m seleh: ['first'] ing: ['a'], seleh: ['second'] ing: ['b'], seleh: ['third'] ing: ['c'].
m saben: { :k :v
	(k ≠ ['c']) terusna.
	Wetonan tulis: ['iteration'] + k + v, baris-anyar.
}.

