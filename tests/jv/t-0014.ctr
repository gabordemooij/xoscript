>> Greeter := Obyek anyar.
Greeter nalika: ['make'] tindakna: {
	>> gr := Obyek anyar.
	gr nalika: ['setName:'] tindakna: { :aname
		duweke jeneng := aname.
	}.
	gr nalika: ['greet'] tindakna: {
		Wetonan tulis: duweke jeneng.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a anyar.
c setName: ['THREE'].
c greet.
>> d := a anyar.
d setName: ['FOUR'].
d greet.
c greet.
