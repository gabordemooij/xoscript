Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :dict
	duweke dict := dict. 
}.

a nalika: ['item'] tindakna: { <- duweke dict.
}.

a item: (
Kamus anyar
	hello: ['world'],
	world: (Kamus anyar seleh: ['a'] ing: ['b'])).

Wetonan tulis: a item, baris-anyar.

>> old-dict-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-dict-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.

Wetonan tulis: b item, baris-anyar.
