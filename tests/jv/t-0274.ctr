

Dhaptar nalika: ['column:'] tindakna: { :column
	>> result := Dhaptar anyar.
	dhiri saben: { :index :row
		row saben: { :index :cell
			(index = column) bener: { result tambah-ing-mburi: cell. }.
		}.
	}. <- result.
}.


>> a := Dhaptar ←
	(Dhaptar ← 1 ; 2 ; 3) ;
	(Dhaptar ← 4 ; 5 ; 6) ;
	(Dhaptar ← 7 ; 8 ; 9).

>> b := a column: 1.
Wetonan tulis: b, baris-anyar.

b := a column: 20.
Wetonan tulis: b, baris-anyar.

b := a column: -100.
Wetonan tulis: b, baris-anyar.
