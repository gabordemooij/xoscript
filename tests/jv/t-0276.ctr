>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obyek anyar.
⚄ nalika: ['drawFrom:length:'] tindakna: { :pool :cacah
	
	>> result := [''].
	
	{
		>> index := Angka random % (pool dawa).
		result tambah-ing-mburi: ( pool karakter: (index + 1) ).
		
	} × cacah. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dawa.
Wetonan tulis: (['x↵'] x random dawa).
Wetonan tulis: (['y↵'] y ?? dawa).

