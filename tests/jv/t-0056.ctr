>> z := Obyek anyar.
z nalika: ['value:'] tindakna: { :v
	duweke value := v. <- dhiri.
}.
z nalika: ['value'] tindakna: { <- duweke value. }.
(z setValue: 1) value: 2.
Wetonan tulis: z value.
>> x := z.
Wetonan tulis: x value.
z := Kosong.
Wetonan tulis: z value.
Wetonan tulis: x value.
Wetonan tulis: ['hello'].
Wetonan tulis: 3 + 2.
Wetonan tulis: (3 > 2).
