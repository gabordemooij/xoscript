Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parameter-panggolekan := Maria-Kueri anyar: SQL.

# set database
parameter-panggolekan basis-data: DB.

parameter-panggolekan jupuk: { :row
	Wetonan tulis: row world, baris-anyar.
}.
