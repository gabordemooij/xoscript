#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Pola anyar: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern cocog: subject tindakna: { :m :x
	Wetonan tulis: m, baris-anyar.
	Wetonan tulis: x, baris-anyar. <- ['XXX'].
}.
Wetonan tulis: result, baris-anyar.