
Server init.
Wetonan tulis: ['Database test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'], 
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> parameter-panggolekan :=
db kueri: ['SELECT UNHEX('CAFE') AS blobby'],
jupuk: { :row
	Wetonan tulis: ( row blobby saka: 0 dawa: 2 ), baris-anyar.
	row blobby bebasna.
}.
