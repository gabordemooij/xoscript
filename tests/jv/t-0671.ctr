# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Brankas gawe-kunci.

# private (secret) key
>> sk := keys pisanan.

# public key
>> pk := keys pungkasan.

# sign a message
>> sig := Brankas tandha-tangani: ['abc'] nganggo: sk.

# check message (ok)
Wetonan tulis: ( 
	Brankas
		priksa: ['abc'] 
		tandha-tangan: sig 
		nganggo: pk 
), baris-anyar.

# check message (fail)
Wetonan tulis: ( 
	Brankas 
		priksa: ['abd'] 
		tandha-tangan: sig 
		nganggo: pk 
), baris-anyar.