Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB kueri: SQL.

# now you don't have to set DB
query2 jupuk: { :row
	Wetonan tulis: row world, baris-anyar.
}.
