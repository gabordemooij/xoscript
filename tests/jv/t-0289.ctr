#Linux
>> OS := Program sistem: (Prentah uname -s), pangkas.

>> Slurp := Obyek anyar.
Slurp nalika: ['anyar'] tindakna: {
	duweke str := [''].
}.
Slurp nalika: ['wangsuli:'] tindakna: { :blah
		(duweke str ≠ ['']) bener: {
			duweke str tambah-ing-mburi: [' '].
		}.
		duweke str tambah-ing-mburi: blah.
}.
Slurp nalika: ['wangsuli:lan:'] tindakna: { :blah :blahah
		(duweke str ≠ ['']) bener: {
			duweke str tambah-ing-mburi: [' '].
		}.
		(blah dawa > 1) bener: {
			duweke str tambah-ing-mburi: (blah saka: 0 dawa: (blah dawa - 1)).
		}, yen-ora: {
			duweke str tambah-ing-mburi: blah.
		}.
		duweke str tambah-ing-mburi: [' '].
		duweke str tambah-ing-mburi: blahah.
}.
Slurp nalika: ['obtain'] tindakna: {
	>> buffer := duweke str.
	duweke str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text tambah-ing-mburi: ['hello'].
} × 1000.


Wetonan tulis: (
	Program sistem: (
		Slurp anyar
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

