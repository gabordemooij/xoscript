Wetonan tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-anyar.
>> Scope := Obyek anyar.
Scope nalika: ['initialize:'] tindakna: { :x duweke property := x. }.
Scope nalika: ['confirm'] tindakna: { Wetonan tulis: [',']. }.
Scope nalika: ['uji'] tindakna: {
	Wetonan tulis: duweke property.
	dhiri confirm.
	( 1 = 1 ) bener: { Wetonan tulis: duweke property. dhiri confirm. }.
	( 1 = 0 ) salah: { Wetonan tulis: duweke property. dhiri confirm. }.
	>> y := 2. { Wetonan tulis: duweke property. dhiri confirm. } sasuwene: { y suda: 1. <- (y > 0). }.
	{ Wetonan tulis: duweke property. dhiri confirm. } × 1.
	(Dhaptar ← 1) saben: {  Wetonan tulis: duweke property. dhiri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Kamus anyar one: ['item']) saben: { Wetonan tulis: duweke property. dhiri confirm. }.
	{ 1 ÷ 0. } cekel: { Wetonan tulis: duweke property. dhiri confirm. }, wiwiti.
	Wetonan baris-anyar.
}.
>> scope1 := Scope anyar.
scope1 initialize: ['X'].
scope1 uji.
>> function := { 
	duweke property := ['Y'].
	Wetonan tulis: duweke property.
	dhiri confirm.
	( 1 = 1 ) bener: { Wetonan tulis: duweke property. dhiri confirm. }.
	( 1 = 0 ) salah: { Wetonan tulis: duweke property. dhiri confirm. }.
	>> y := 2. { Wetonan tulis: duweke property. dhiri confirm. } sasuwene: { y suda: 1. <- (y > 0). }.
	{ Wetonan tulis: duweke property. dhiri confirm. } × 1.
	(Dhaptar ← 1) saben: {  Wetonan tulis: duweke property. dhiri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus anyar one: ['item']) saben: { Wetonan tulis: duweke property. dhiri confirm. }.
	{ 1 ÷ 0. } cekel: { Wetonan tulis: duweke property. dhiri confirm. }, wiwiti.
	Wetonan baris-anyar.
}.
function nalika: ['confirm'] tindakna: { Wetonan tulis: [',']. }.
function trapna: 1 lan: 2.
