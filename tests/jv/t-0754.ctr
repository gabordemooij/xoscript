Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :out
	duweke out := out. 
}.

a nalika: ['item'] tindakna: { <- duweke out.
}.

a nalika: ['greet'] tindakna: {
	Wetonan tulis: ['hi from original out!'], baris-anyar.
}.

a item: Wetonan.

Wetonan tulis: a item, baris-anyar.

>> old-out-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-out-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.

b item tulis: ['hello from loaded out!'], baris-anyar.
b greet.
