Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :boolean
	duweke boolean := boolean. 
}.

a nalika: ['item'] tindakna: { <- duweke boolean.
}.

a item: Salah.

Wetonan tulis: a item, baris-anyar.

>> old-bool-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-bool-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.

Wetonan tulis: b item, baris-anyar.
