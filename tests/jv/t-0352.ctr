Angka nalika: ['roman'] tindakna: {
	>> angka := dhiri salin.
	>> roman := [''].
	{
		{
			(angka ≥ 1000) bener: {
				roman tambah-ing-mburi: ['Ⅿ'].
				angka suda: 1000.
			}, pedhot.
		
			(angka ≥ 500) bener: {
				roman tambah-ing-mburi: ['Ⅾ'].
				angka suda: 500.
			}, pedhot.
		
			(angka ≥ 100) bener: {
				roman tambah-ing-mburi: ['Ⅽ'].
				angka suda: 100.
			}, pedhot.
		
			(angka ≥ 50) bener: {
				roman tambah-ing-mburi: ['Ⅼ'].
				angka suda: 50.
			}, pedhot.
		
			(angka ≥ 50) bener: {
				roman tambah-ing-mburi: ['Ⅼ'].
				angka suda: 50.
			}, pedhot.
		
			(angka ≥ 10) bener: {
				roman tambah-ing-mburi: ['Ⅹ'].
				angka suda: 10.
			}, pedhot.
			
			(angka ≥ 9) bener: {
				roman tambah-ing-mburi: ['Ⅸ'].
				angka suda: 9.
			}, pedhot.
			
			(angka ≥ 5) bener: {
				roman tambah-ing-mburi: ['Ⅴ'].
				angka suda: 5.
			}, pedhot.
			
			(angka ≥ 4) bener: {
				roman tambah-ing-mburi: ['Ⅳ'].
				angka suda: 4.
			}, pedhot.
			
			(angka ≥ 1) bener: {
				roman tambah-ing-mburi: ['Ⅰ'].
				angka suda: 1.
			}, pedhot.
		} prosedur.
	} sasuwene: { <- angka > 0. }. <- roman.
}.

Wetonan tulis: 1 roman, baris-anyar.
Wetonan tulis: 2 roman, baris-anyar.
Wetonan tulis: 4 roman, baris-anyar.
Wetonan tulis: 8 roman, baris-anyar.
Wetonan tulis: 16 roman, baris-anyar.
Wetonan tulis: 32 roman, baris-anyar.
Wetonan tulis: 64 roman, baris-anyar.
Wetonan tulis: 128 roman, baris-anyar.
Wetonan tulis: 256 roman, baris-anyar.
Wetonan tulis: 1024 roman, baris-anyar.
