Angka nalika: ['factorial'] tindakna: {
	>> total := 1.
	{ :index total pingna: (dhiri - (index)). } × dhiri. <- total.
}.
>> Printer := Obyek anyar.
Printer nalika: ['print:and:'] tindakna: { :x :y
	Wetonan tulis: ['a='] + x + [', b='] + y, baris-anyar.
}.
>> a := 4.5. >> b := a bunderake-mudhun.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a bunderake-munggah.
Printer print: a and: b.
a := 4.5. b := a bunderake-mudhun.
Printer print: a and: b.
a := 4.5. b := a bunderake.
Printer print: a and: b.
a := 4.2. b := a bunderake.
Printer print: a and: b.

