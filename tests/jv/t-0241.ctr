

Tèks nalika: ['evaluate'] tindakna: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (dhiri tèks + ['.']).
	Program gunakna: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Dhaptar ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tèks.
Wetonan tulis: x, baris-anyar.
>> y := Kosong.
(['y := '] + x ) evaluate.
Wetonan tulis: y ? 0, baris-anyar.

q := Kamus seleh: ['\[''] ing: ['\['quote\']'].
x := q tèks.
Wetonan tulis: x, baris-anyar.
y := Kosong.
(['y := '] + x ) evaluate.

>> q := (Kamus anyar) seleh:['\[''] ing:['\['quote\[''].
Wetonan tulis: y ? ['\['quote\']'], baris-anyar.
