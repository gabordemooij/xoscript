>> items := Kamus anyar.
items seleh: ['green'] ing: ['color-1'].
items seleh: ['orange'] ing: ['color-2'].
items seleh: ['red'] ing: ['color-3'].
>> i := 0.
>> s := [''].
items saben: { :key :color
	Wetonan tulis: ['color #'] + i + [' is: '] + color + [' '].
	i tambah: 1.
}.
Wetonan tulis: i + [' colors!'].
