#OBSD
>> dirname := [''].
{ dirname tambah-ing-mburi: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program sistem: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tambah-ing-mburi: ['YYYYYYYY']. } * 20.
Berkas anyar: filename, tulis: ['sometext'].
{ Berkas dhaptar: ['/tmp/'] + dirname. } * 1000.
Wetonan tulis: ['no crash'], baris-anyar.

