# test qualifiers

>> $ := Obyek anyar.

$ nalika: ['wangsuli:'] tindakna: { :x
	
	>> operation := x karakter: 0.
	>> valuta := x karakter: 1.
	>> money := x liwati: 2.
	
	>> amount := 0.

	( operation = ['+'] ) bener: {
		( valuta = ['£'] ) bener: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Wetonan tulis: x, baris-anyar.


>> Fruit := Obyek anyar.

Fruit nalika: ['anyar'] tindakna: {
	>> f := dhiri anyar.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit nalika: ['apples:'] tindakna: { :a duweke apples := a. }.
Fruit nalika: ['oranges:'] tindakna: { :p duweke oranges := p. }.
Fruit nalika: ['apples'] tindakna: { <- duweke apples. }.
Fruit nalika: ['oranges'] tindakna: { <- duweke oranges. }.

Fruit nalika: ['+'] tindakna: { :f
	
	>> n := Fruit anyar.
	f tambah: 1.
	
	n apples: (f apples + duweke apples).
	n oranges:  (f oranges  + duweke oranges). <- n.
}.

Fruit nalika: ['tèks'] tindakna: { <- ( duweke apples tèks + [' apples and '] + duweke oranges + [' oranges'] ).
}.

Angka nalika: ['apples'] tindakna: { <- ((Fruit anyar) apples: dhiri).
}.

Angka nalika: ['apple'] tindakna: { <- ((Fruit anyar) apples: dhiri).
}.

Angka nalika: ['oranges'] tindakna: { <- ((Fruit anyar) oranges: dhiri).
}.




Wetonan tulis: (1 apple + 3 oranges + 4 apples), baris-anyar.


Tèks nalika: ['twice'] tindakna: { <- ((dhiri tèks) + (dhiri tèks)).
}.



Wetonan tulis: ['❤❤❤'] twice.



