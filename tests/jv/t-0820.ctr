# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pola anyar: pattern.
	p cocog: subject tindakna: { :m :g
		Wetonan tulis: g cacah, tulis: [' '], tulis: (g gabung: ['|']), baris-anyar. <- m.
	}.
}.
show trapna: ['(a)|(b)'] lan: ['b'].
show trapna: ['(a)|(b)'] lan: ['a'].
show trapna: ['(x)?y'] lan: ['y'].
show trapna: ['(x)?(y)(z)?'] lan: ['xy'].
