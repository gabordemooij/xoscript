Tèks nalika: ['html'] tindakna: { <- (
		dhiri
		ganti: ['&'] nganggo: ['&amp;'],
		ganti: ['<'] nganggo: ['&lt;'],
		ganti: ['>'] nganggo: ['&gt;'],
		ganti: ['"'] nganggo: ['&quot;']
	).
}.

>> list := Dhaptar anyar.

['Verbatim Syntax'] aksara saben: { :angka :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (angka), Letter: letter).
}.

Wetonan list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list gabung: ['↵']).

Wetonan tulis: template.

