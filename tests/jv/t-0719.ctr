Server init.
>> fmt := Format anyar: ['%#3x'].

>> blob := Blob anyar: 4.
blob bytes: ( 
	Dhaptar anyar ; 0 ; 1 ; 2 ; 3
).

>> file := Berkas anyar: ['/tmp/blob'].
file blob: blob.
blob bebasna.

>> waca := file blob.
waca 
saka: 0 
dawa: 4, 
tindakna saben: { :i :b 
	Wetonan
	tulis: (fmt trapna-wilangan-wutuh: b),
	baris-anyar.
}.
waca bebasna.
