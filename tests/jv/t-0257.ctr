
>> Greeter := Obyek anyar.
Greeter nalika: ['anyar'] tindakna: {
	duweke jeneng := ['?'].
}.
Greeter nalika: ['name:'] tindakna: { :jeneng
	duweke jeneng := jeneng.
}.
Greeter nalika: ['greet'] tindakna: {
	Wetonan tulis: (['hello[you]'] [you]: duweke jeneng).
}.
>> friend := Greeter anyar.
friend name: ['1'].
friend greet.
