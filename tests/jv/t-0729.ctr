Server init.
>> a := Blob anyar: 4.
a bytes: ( Dhaptar anyar ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob anyar: 4.
b bytes: ( Dhaptar anyar ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Berkas anyar: ['noblob???'] ).
} cekel: { :e Wetonan tulis: e, baris-anyar. }, wiwiti.
a bebasna.
b bebasna.
