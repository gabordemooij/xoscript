# test catch-all methods
>> x13 := Obyek anyar.
x13 nalika: ['a'] tindakna: { :a Wetonan tulis: 0, baris-anyar. }.
x13 nalika: ['a:'] tindakna: { :a Wetonan tulis: a, baris-anyar. <- 5. }.
x13 nalika: ['a:b:'] tindakna: { :a :b Wetonan tulis: (a + b), baris-anyar. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
