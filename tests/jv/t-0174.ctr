


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.
>> palette := Kosong.
>> colors := Kosong.

{
palette := Kamus anyar.
palette 
	seleh: ['#F00'] ing: ['red'],
	seleh: ['#0F0'] ing: ['green'],
	seleh: ['#00F'] ing: ['blue'].
Wetonan tulis: ['number of RGB codes in palette: '] + ( palette cacah ), baris-anyar.
Wetonan tulis: ['RGB code of green is: '] + ( palette ? ['green'] ), baris-anyar.
colors := [''].
( palette saben: { :jeneng :kode
		colors := colors + ( jeneng + [':'] + kode ).
} ).
Wetonan tulis: ['All colors in palette: '] + colors, baris-anyar.
} wiwiti.
Program resiki.
usedMemory1 := (Program memori ? 0).

{
palette := Kamus anyar.
palette 
	seleh: ['#F00'] ing: ['red'],
	seleh: ['#0F0'] ing: ['green'],
	seleh: ['#00F'] ing: ['blue'].
