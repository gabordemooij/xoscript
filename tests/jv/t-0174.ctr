usedMemory3 := (Program memori ? 0).



( usedMemory1 = usedMemory2 lan: usedMemory1 = usedMemory3, lan: usedMemory2 = usedMemory3 ) bener: {
	Wetonan tulis: ['No memory leaks here'].
}, salah: {
	Wetonan tulis: ['Leaking memory...'].
}.
