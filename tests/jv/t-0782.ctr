Wetonan tulis: ['Test object'], baris-anyar.
>> cmd := Prentah anyar.
Wetonan tulis: cmd ls /tmp, baris-anyar.
>> old-cmd-address := cmd prototipe alamat-memori.
cmd save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-cmd-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
Wetonan tulis: b ls, baris-anyar.


