Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :nil
	duweke nil := nil. 
}.

a nalika: ['item'] tindakna: { <- duweke nil.
}.

a item: Kosong.

Wetonan tulis: a item, baris-anyar.

>> old-nil-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-nil-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.

Wetonan tulis: b item, baris-anyar.
