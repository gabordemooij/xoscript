>> str := ['write:'].
Wetonan pesen: ['tulis:'] argumen: (Dhaptar ← ['Hello World']), baris-anyar. 

Angka nalika: ['isbetween:and:'] tindakna: { :a :b <- ((dhiri ≥ a) lan: (dhiri ≤ b)).
}.

str := ['isbetween:and:'].
Wetonan tulis: (3 pesen: str argumen: (Dhaptar ← 2 ; 8)), baris-anyar.
Wetonan tulis: (3 pesen: str argumen: (Dhaptar ← 1 ; 2)), baris-anyar.


>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['makeCoffeeWithSugar:milk:'] tindakna: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Dhaptar ← 4 ; 2.
Wetonan tulis: ( CoffeeMachine pesen: order argumen: coffeeConfiguration ), baris-anyar.
