
>> Size := Obyek anyar.
Size nalika: ['is:'] tindakna: { :angka
	angka nalika: ['+'] tindakna: { :angka
		>> unit := angka satuan-angka.
		>> factor := 1.
		
		unit
		kasus: ['inch'] tindakna: { factor := 0.0833. }. <- dhiri + (angka * factor).
	}. <- angka.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Wetonan tulis: plank + edge, baris-anyar.
