Server init.

# write a test file
>> f := Berkas anyar: ['/tmp/test.gif'].
f tulis: ['GIF87a01234567810'].

# serve the file
Server terusake: ['test.gif'] ater-ater: ['/tmp/'].

Wetonan baris-anyar.

Wetonan tulis: ['Outside container (security):'], baris-anyar.
{ Server terusake: ['../passwd'] ater-ater: ['/tmp/']. }
cekel: { :e Wetonan tulis: e, baris-anyar. },
wiwiti.

Wetonan tulis: ['Invalid prefix:'], baris-anyar.
{ Server terusake: ['test.gif'] ater-ater: ['z:\\']. }
cekel: { :e Wetonan tulis: e, baris-anyar. },
wiwiti.

Wetonan tulis: ['Non-existant file:'], baris-anyar.
{ Server terusake: ['xxx.xxx'] ater-ater: ['/tmp/']. }
cekel: { :e Wetonan tulis: e, baris-anyar. },
wiwiti.
