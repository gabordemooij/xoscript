# test buffers PKI/Sign 
Server init.

>> long := ( Dhaptar anyar isi: 1000 karo: ['a'] ) gabung: [''].

# sign a message
Wetonan tulis: ( 
	Brankas tandha-tangani: ['abc'] nganggo: long
), baris-anyar.

Wetonan tulis: ( 
	Brankas
		priksa: ['abc'] 
		tandha-tangan: long 
		nganggo: long
), baris-anyar.

Wetonan tulis: (
	Brankas hash-sandhi: long priksa: long
), baris-anyar.
