Server init.

>> x := Blob anyar: 65 jinis: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program setelan: ['FFITESTLIB'].
Server gandheng: (
 Dhaptar anyar ;
 libname ;
 ['putchar'] ;
 ( Dhaptar anyar ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x saka: 0 dawa: 1), baris-anyar.
x bebasna.

