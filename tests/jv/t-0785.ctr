Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] tindakna: { :moment
	duweke moment := moment. 
}.

a nalika: ['item'] tindakna: { <- duweke moment.
}.

>> today := Dhaptar anyar ; ( Wektu anyar zona: ['CEST'], taun: 2026, wulan: 7 ).
a item: today.
Wetonan tulis: a item ? 0, baris-anyar.
a save-as: ['/tmp/a.bin'].
