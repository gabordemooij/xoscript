#Linux
>> OS := Program setelan: ['OS'].

>> clock := Wektu anyar.
	
(OS = ['Haiku']) bener: {
	clock zona: ['CET'],
	taun: 2017, wulan: 7, dina: 13,
	jam: 18, menit: 0, detik: 0.
}, yen-ora: {
	clock zona: ['Europe/Amsterdam'],
	taun: 2017, wulan: 7, dina: 13,
	jam: 18, menit: 0, detik: 0.
}.

clock nalika: ['tell'] tindakna: {
	Wetonan tulis: dhiri, baris-anyar.
}.


clock tambah: 2    jam, tell.
clock tambah: 1    jam, tell.
clock tambah: 19 menit, tell.
clock tambah: 1  menit, tell.
clock tambah: 1  menit, tell.
clock tambah: 19 detik, tell.
clock tambah: 1  detik, tell.
clock tambah: 1  detik, tell.
clock tambah: 2    taun, tell.
clock tambah: 1    taun, tell.

(OS = ['Haiku']) bener: {
clock tambah: 5   wulan.
clock zona: ['CEST'], tell.
}, yen-ora: {
	clock tambah: 5   wulan, tell.
}.

clock tambah: 1   wulan, tell.
clock tambah: 19    dina, tell.
clock tambah: 1    jam, tell.
clock tambah: 120  yard, tell.
