Server init.
Wetonan tulis: ['Database date test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'], 
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> parameter-panggolekan :=
db kueri: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
jupuk: { :row
	Wetonan tulis: row datetest, baris-anyar.
}.
