Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 
a nalika: ['item:'] tindakna: { :lst
	duweke lst := lst. 
}.
a nalika: ['item'] tindakna: { <- duweke lst.
}.
a item: (
	Dhaptar anyar ; 1 ; (
		Dhaptar anyar ; ['a'] ; (
			Dhaptar anyar ; ( Wektu anyar: 1 )
		) ; ( Int64 saka-teks: ['321'] )
	)
).
Wetonan tulis: a item, baris-anyar.
>> old-lst-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-memori = old-lst-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
Wetonan tulis: ( b item ), baris-anyar.
