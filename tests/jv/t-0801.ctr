Server init.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'],
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> del := db kueri: ['DELETE FROM book WHERE id > 0'].
{  del lakokna. db tetepna. } cekel: { :e db batalna.  }, wiwiti.

>> cacah := db kueri: ['SELECT COUNT(*) AS num FROM book'].
cacah jupuk: { :row Wetonan tulis: row num, baris-anyar. }.
