>> a := Dhaptar ← Obyek ; Bener ; Salah ; Boolean ; 1 ; Angka ; ['Str'] ; Tèks ; { ['Empty']. }.
Wetonan tulis: (a cacah), baris-anyar.
{ :i
	Wetonan tulis: 
	['a '] + 
	((a ? i) jinis) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Kosong?) pilih: [''] utawa: ['NOT']) + 
	[' Nil.'],
	baris-anyar.
} × (a cacah).
Wetonan tulis: ['but.. Nil is.. '] + ((Kosong Kosong?) pilih: ['certainly NIL!'] utawa: ['not NIL??']), baris-anyar.