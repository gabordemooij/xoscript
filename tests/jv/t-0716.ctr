Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['state:'] tindakna: { :list
	duweke list := list. 
}.

a nalika: ['state'] tindakna: {
	Wetonan tulis: duweke list, baris-anyar.
}.

a state: ( Dhaptar anyar ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
b state.