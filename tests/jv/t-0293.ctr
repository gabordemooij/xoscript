
>> city := Dhaptar ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Dhaptar ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature miturut: city.
>> cities := weather kunci-kunci urutna: { :a :b <- (a bandhingna: b). }.
>> temperatures := weather nilai-nilai urutna: { :a :b <- (a bandhingna: b) negatif?. }.

Wetonan tulis: (cities gabung: [',']), baris-anyar.
Wetonan tulis: (temperatures gabung: [',']), baris-anyar.
