
>> XX := Obyek anyar.
>> X := Obyek anyar.

XX nalika: ['QQ'] tindakna: { <- 1. }.
XX nalika: ['Q'] tindakna: { <- 1. }.
XX nalika: ['QQ:'] tindakna: { <- 1. }.
XX nalika: ['QQ:QQ:'] tindakna: { <- 1. }.

X nalika: ['QQ'] tindakna: { <- 1. }.
X nalika: ['Q'] tindakna: { <- 1. }.
X nalika: ['QQ:'] tindakna: { <- 1. }.
X nalika: ['QQ:QQ:'] tindakna: { <- 1. }.

Wetonan tulis: (Program XX), baris-anyar.
Wetonan tulis: (Program golek: ['XX']), baris-anyar.
Wetonan tulis: (Program golek: ['X']), baris-anyar.

Wetonan tulis: (Program XX: ['QQ']), baris-anyar.
Wetonan tulis: (Program XX: ['Q']), baris-anyar.
Wetonan tulis: (Program XX: ['QQ:']), baris-anyar.
Wetonan tulis: (Program XX: ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program X: ['QQ']), baris-anyar.
Wetonan tulis: (Program X: ['Q']), baris-anyar.
Wetonan tulis: (Program X: ['QQ:']), baris-anyar.
Wetonan tulis: (Program X: ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program X ['QQ']), baris-anyar.
Wetonan tulis: (Program X ['Q']), baris-anyar.
Wetonan tulis: (Program X ['QQ:']), baris-anyar.
Wetonan tulis: (Program X ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program YY), baris-anyar.
Wetonan tulis: (Program golek: ['YY']), baris-anyar.
Wetonan tulis: (Program golek: ['Y']), baris-anyar.

Wetonan tulis: (Program YY: ['QQ']), baris-anyar.
Wetonan tulis: (Program YY: ['Q']), baris-anyar.
Wetonan tulis: (Program YY: ['QQ:']), baris-anyar.
Wetonan tulis: (Program YY: ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program Y: ['QQ']), baris-anyar.
Wetonan tulis: (Program Y: ['Q']), baris-anyar.
Wetonan tulis: (Program Y: ['QQ:']), baris-anyar.
Wetonan tulis: (Program Y: ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program Y ['QQ']), baris-anyar.
Wetonan tulis: (Program Y ['Q']), baris-anyar.
Wetonan tulis: (Program Y ['QQ:']), baris-anyar.
Wetonan tulis: (Program Y ['QQ:QQ:']), baris-anyar.

Wetonan tulis: (Program X: -1), baris-anyar.
Wetonan tulis: (Program X Kosong), baris-anyar.

