# line breaks in values must not create extra headers
Server siapake.
Program gunakna: ['../../../src/xo/jv/webtools.xo'].
Program gunakna: ['../../../src/xo/jv/mailtools.xo'].

>> sesirah := Sesirah-HTTP anyar kunci-sesirah: ['Location'] nilai: ['/ok\r\nX-Injected: yes'].
Wetonan tulis: sesirah.

>> web := Dokumen-Web anyar.
web menyang: ['/ok\r\nX-Injected: yes'].
Wetonan tulis: ['\n'], baris-anyar.

>> mail := Layang-e anyar.
mail marang: (Dhaptar anyar ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Dhaptar anyar ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Dhaptar anyar ; ['c@example.invalid\r\nX-Bcc: yes']).
mail pangirim: ['d@example.invalid\r\nX-From: yes'] jeneng: ['site\r\nX-Name: yes'].
mail subyek: ['hello\r\nX-Subject: yes'].
mail awak: ['line1\r\nline2'].
Wetonan tulis: mail gawe.

>> html := Layang-e-HTML anyar.
html marang: (Dhaptar anyar ; ['a@example.invalid\r\nX-To: yes']).
html pangirim: ['d@example.invalid'] jeneng: ['site'].
html subyek: ['hello\r\nX-Subject: yes'].
html awak: ['body'].
Wetonan tulis: ( html gawe ngemot: ['\nX-'] ), baris-anyar.
Wetonan tulis: ( html gawe ngemot: ['X-To: yes'] ), baris-anyar.
