#Linux
>> clock := Wektu anyar.
clock zona: ['UTC-1'].
clock taun: 1981, wulan: 1, dina: 5,
      jam: 13, menit: 15, detik: 13.

Wetonan tulis: clock, baris-anyar.
clock zona: ['UTC+0'].

Wetonan tulis: (
	(clock taun polos) + ['-'] + (clock wulan) + ['-'] + (clock dina) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-anyar.


clock zona: ['UTC-1'].
Wetonan tulis: (
	(clock taun polos) + ['-'] + (clock wulan) + ['-'] + (clock dina) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-anyar.
