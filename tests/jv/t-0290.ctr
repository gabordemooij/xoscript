# test list operations


>> cakes := Dhaptar ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ganti: 1 dawa: 2 nganggo: ( Dhaptar ← ['cinnamon'] ; ['pineapple'] ).
Wetonan tulis: (buy gabung: [',']), baris-anyar.


>> buy := cakes ganti: 1 dawa: 12 nganggo: ( Dhaptar ← ['cinnamon'] ; ['pineapple'] ).
Wetonan tulis: (buy gabung: [',']), baris-anyar.


>> buy := cakes ganti: 2 dawa: 10 nganggo: ( Dhaptar anyar ).
Wetonan tulis: (buy gabung: [',']), baris-anyar.


>> buy := cakes ganti: 0 dawa: 1 nganggo: ( Dhaptar anyar ).
Wetonan tulis: (buy gabung: [',']), baris-anyar.


>> buy := cakes ganti: ['0'] dawa: ['1'] nganggo: ['x'].
Wetonan tulis: (buy gabung: [',']), baris-anyar.
