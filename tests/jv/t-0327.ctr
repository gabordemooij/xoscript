

Dhaptar nalika: ['fixture:'] tindakna: { :f
	duweke fixture := f.
}.

Dhaptar nalika: ['cacah'] tindakna: { <- duweke fixture.
}.

Dhaptar nalika: ['aantal'] tindakna: { <- duweke fixture.
}.


>> x := Kosong.
{

	x := ['hello'] 
	ganti:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karakter: 2)
			)
		)
	nganggo: (
		(['...hal'] + ['lo']) 
			aksara-gedhe 
			lowecase 
			aksara-gedhe 
			liwati: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Dhaptar ← 0 ; 1 ; 4; 9 ; (Dhaptar ← 0 ; 3; 1) ; 4
							) sadurunge-pungkasan
						) ? 1
					) + 
					((Dhaptar ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					cacah
				)
			)
	).

} × 10.
Wetonan tulis: x, baris-anyar.

