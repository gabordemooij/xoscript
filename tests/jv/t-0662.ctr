>> t := Kosong.

# you can control the time zone for
# parsing like this:
Wektu zona: ['CET'].
t := Wektu saka: ['1981-02-03 04:05:06'].
Wetonan tulis: t, baris-anyar.

# now using CEST time zone:
Wektu zona: ['CEST'].
t := Wektu saka: ['1981-02-03 04:05:06'].
Wetonan tulis: t, baris-anyar.

# error if string cannot be parsed
{ Wektu saka: ['1900']. } cekel: { Kosong. }, wiwiti.
