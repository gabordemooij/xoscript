>> Slurp := Obyek anyar.
Slurp nalika: ['anyar'] tindakna: {
	duweke str := [''].
}.

Slurp nalika: ['wangsuli:'] tindakna: { :blah
		(duweke str ≠ ['']) bener: {
			duweke str tambah-ing-mburi: [' '].
		}.
		duweke str tambah-ing-mburi: blah.
}.
Slurp nalika: ['wangsuli:lan:'] tindakna: { :blah :blahah
		(duweke str ≠ ['']) bener: {
			duweke str tambah-ing-mburi: [' '].
		}.
		(blah dawa > 1) bener: {
			duweke str tambah-ing-mburi: (blah saka: 0 dawa: (blah dawa - 1)).
		}, yen-ora: {
			duweke str tambah-ing-mburi: blah.
		}.
		duweke str tambah-ing-mburi: [' '].
		duweke str tambah-ing-mburi: blahah.
}.
Slurp nalika: ['obtain'] tindakna: {
	>> buffer := duweke str.
	duweke str := ['']. <- buffer.
}.

>> s := Slurp anyar.
s hello: ['world'].
Wetonan tulis: ( s obtain ), baris-anyar.
