Boolean nalika: ['xor:'] tindakna: { :b <- ((dhiri lan: b dudu) utawa: (dhiri dudu lan: b)).
}.

Wetonan tulis: ['Length is:'] + ['ABCD'] dawa.
>> x := ['ABCDE'].

Wetonan tulis: ['Length is:'] + x dawa.
((['ABC'] dawa + 1 = 4) lan: (2 ≠ 3)) dudu dudu bener: { Wetonan tulis: ['Yes']. }.
(((3 > 4) utawa: (4 > 2)) lan: (Bener utawa: Salah), lan: (Bener xor: Bener) dudu ) bener: { Wetonan tulis: ['Yes']. }.
{ Wetonan tulis: ['Running']. } wiwiti.
