# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> dalan := ['/tmp/dat.csv'].
>> csv := Berkas anyar: dalan.
csv tulis: s.

# accepts CRLF LF CR, varying row length
csv pamisah: [';'] tandha-petik: ['"'] larik: { :line
	Program resiki.
	Wetonan tulis: line, baris-anyar.
	Program resiki.
}.

# unequal lines
s tambah-ing-mburi: ['\njustone'].
csv tulis: s.
{
	csv pamisah: [';'] tandha-petik: ['"'] larik: { :line
		Wetonan tulis: line, baris-anyar.
	}.
} cekel: { :e 
	Wetonan tulis: e, baris-anyar.
}, wiwiti.

# invalid format
s := ['"he"llo";world'].
csv tulis: s.
{
	csv pamisah: [';'] tandha-petik: ['"'] larik: { :line
		Wetonan tulis: line, baris-anyar.
	}.
} cekel: { :e 
	Wetonan tulis: e, baris-anyar.
}, wiwiti.
