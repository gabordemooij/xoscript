>> x := Wektu anyar.
x zona: ['CEST'],
taun:2017,
wulan:01,
dina:10,
jam: 10,
menit: 0,
detik: 0.

Wetonan tulis: x, baris-anyar.

Wetonan tulis: x wektu, baris-anyar.

x tambah: 1 detik.
x tambah: 2 menit.
x tambah: 3 jam.
x tambah: 4 dina.
x tambah: 1 wulan.
x tambah: 6 taun.

Wetonan tulis: x, baris-anyar.

x suda: 1 detik.
x suda: 2 menit.
x suda: 3 jam.
x suda: 4 dina.
x suda: 1 wulan.
x suda: 6 taun.

Wetonan tulis: x, baris-anyar.

>> y := x salin.
>> z := x.

Wetonan tulis: y, baris-anyar.
Wetonan tulis: z, baris-anyar.
Wetonan tulis: (x zona = y zona), baris-anyar.
Wetonan tulis: (x wektu = y wektu), baris-anyar.
Wetonan tulis: (x = z), baris-anyar.
Wetonan tulis: x dina-ing-taun, baris-anyar.
Wetonan tulis: x dina-ing-minggu, baris-anyar.
Wetonan tulis: x minggu, baris-anyar.
