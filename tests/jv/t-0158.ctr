>> x := [' hallo '].

>> y := x aksara-gedhe.
Wetonan tulis: x, baris-anyar.
Wetonan tulis: (x padha-karo: y), baris-anyar.

>> y := x aksara-cilik.
Wetonan tulis: x, baris-anyar.
Wetonan tulis: (x padha-karo: y), baris-anyar.

>> y := x pangkas.
Wetonan tulis: x, baris-anyar.
Wetonan tulis: (x padha-karo: y), baris-anyar.

>> y := x liwati: 1.
Wetonan tulis: x, baris-anyar.
Wetonan tulis: (x padha-karo: y), baris-anyar.

>> y := x saka: 1 dawa: 2.
Wetonan tulis: x, baris-anyar.
Wetonan tulis: (x padha-karo: y), baris-anyar.