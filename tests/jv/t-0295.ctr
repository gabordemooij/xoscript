
>> dictionary := (
	Kamus anyar
		seleh: ['b'] ing: ['a'],
		seleh: ['a'] ing: ['b'],
		seleh: ['z'] ing: ['x'],
		seleh: ['hello'] ing: ['hallo'],
		seleh: ['human'] ing: ['human']
).

>> comparisons := Dhaptar anyar.
dictionary saben: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandhingna: b)
	).
}.

comparisons urutna: { :a :b <- ( a bandhingna: b ). }.
Wetonan tulis: ( comparisons gabung: ['↵'] ), baris-anyar.
comparisons gabung: ['↵'].
