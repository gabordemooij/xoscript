>> winery := { <- (	Kamus anyar
		seleh: 2 ing: ['merlot'],
		seleh: 3 ing: ['malbec'],
		seleh: 4 ing: ['syrah']
	).
}.

Wetonan tulis: (((winery wiwiti) - ['nothing']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['merlot']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['malbec']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['syrah']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['merlot'] - ['malbec']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['merlot'] - ['syrah']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['malbec'] -['syrah']) cacah), baris-anyar.
Wetonan tulis: (((winery wiwiti) - ['malbec'] - ['syrah'] - ['merlot']) cacah), baris-anyar.

