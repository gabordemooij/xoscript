
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kode := {
	>> o := (
		Kamus anyar
		aa: (Dhaptar ← 1 ; 2),
		bb: (Dhaptar ← 3 ; 4)
	).
	>> s := o tèks.
	>> o2 := s obyek.
	(s  jinis = Tèks jinis) bener: { Wetonan tulis: ['OK1'], baris-anyar. }.
	(o2 jinis = Kamus jinis) bener: { Wetonan tulis: ['OK2'], baris-anyar. }.
}.

Program manajemen-memori: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Program resiki.
usedMemory1 := (Program memori ? 1).
kode wiwiti.
Program resiki.
usedMemory2 := (Program memori ? 1).
kode wiwiti.
Program resiki.
usedMemory3 := (Program memori ? 1).
kode wiwiti.
Program resiki.
usedMemory4 := (Program memori ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) bener: { Wetonan tulis: ['OK3'], baris-anyar. }.
 
