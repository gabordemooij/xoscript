>> HTML := Obyek anyar.
HTML nalika: ['wangsuli:'] tindakna: { :tag 
	Wetonan tulis: (['<tag>'] tag: tag), baris-anyar.
}.
HTML nalika: ['wangsuli:lan:'] tindakna: { :tag :html 
	Wetonan tulis: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), baris-anyar.
}.
>> html := HTML anyar.
html body h1: ['header'].

