Server init.
Wetonan tulis: ['Database time test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	jeneng-panganggo: ['xo'], 
	sandhi: ['pass123'],
	jeneng-basis-data: ['xobase'],
	sambung.

>> parameter-panggolekan :=
db kueri: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
jupuk: { :row
	Wetonan tulis: row timetest, baris-anyar.
}.
