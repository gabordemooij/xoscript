
>> a := Dhaptar ← (Dhaptar ← 100 ; 200 ; 300) ; (Dhaptar ← 9 ; 8 ; 7).
Wetonan tulis: ['at 0,1 :'].
Wetonan tulis: a ? 0 ? 1, baris-anyar. 
Wetonan tulis: ['at 1,2 :'].
Wetonan tulis: a ? 1 ? 2, baris-anyar. 
>> menu := Kamus anyar.
menu seleh: (Dhaptar ← ['pizza'] ; ['spaghetti']) ing: ['Italian Cuisine'].
menu seleh: (Dhaptar ← ['bifteki'] ; ['suflaki']) ing: ['Greek Cuisine'].
Wetonan tulis: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), baris-anyar. 
Wetonan tulis: ['but not on the same plate.'], baris-anyar.
