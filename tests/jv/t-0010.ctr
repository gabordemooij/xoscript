>> Animal := Obyek anyar.
Animal nalika: ['make'] tindakna: {
	>> animal := Obyek anyar.
	animal nalika: ['makeSound'] tindakna: {
		Wetonan tulis: duweke sound.
	}. <- animal.
}.
>> Cat := Obyek anyar.
Cat nalika: ['make'] tindakna: {
	>> cat := Animal make.
	cat nalika: ['init'] tindakna: {
		duweke sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
