


>> Deck := Dhaptar anyar.
Deck nalika: ['print'] tindakna: {
        >> len := dhiri cacah - 1.
        { :i
                >> len2 := dhiri cacah - 1.
                Wetonan tulis: ['len: '].
                Wetonan tulis: len, baris-anyar.
                Wetonan tulis: ['len2: '].
                Wetonan tulis: len2, baris-anyar.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
