Server init.

Wetonan tulis: (
	Pola anyar: ['^\\w+$'],
	cocog: ['test@example.com'] 
), baris-anyar. # 0 match, fails on @ and .

Wetonan tulis: (
	Pola anyar: ['^[^@]+@[^\.]+\.\\w+$'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match

Wetonan tulis: (
	Pola anyar: ['[^@]+@[^\.]+\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match

Wetonan tulis: (
	Pola anyar: ['([^@]+)@([^\.]+)\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match, groups dont matter

Wetonan tulis: (
	Pola anyar: ['[a-z]'],
	cocog: ['test@example.com'] 
), baris-anyar. # 14 matches

Wetonan tulis: (
	Pola anyar: ['.*'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match (all)

Wetonan tulis: (
	Pola anyar: ['(.*)'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match (all)

Wetonan tulis: (
	Pola anyar: ['\\s*[^@]+@[^\.]+\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match, prefix space optional, gets ignored