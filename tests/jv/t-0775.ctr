Wetonan tulis: ['Test object'], baris-anyar.
>> l := Dhaptar anyar ; 1 ; ( Dhaptar anyar ; (Wektu anyar: 1) ; (Int64 saka-teks: ['321']) ; (Dhaptar anyar ; 3)).
Wetonan tulis: l, baris-anyar.
>> old-lst-address := l prototipe alamat-memori.
l save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-lst-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
Wetonan tulis: b, baris-anyar.
