>> phrases := Dhaptar anyar
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases saben: { :_ :phrase 
	>> e := Server base64-enkode: phrase.
	>> d := Server base64-dekode: e.
	Wetonan tulis: (
		message salin ~encoded: e, ~decoded: d
	), baris-anyar.
}.
