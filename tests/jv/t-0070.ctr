>> numbers := ['1,2,3'] pisah: [','].
Wetonan tulis: ['I got: '] + numbers cacah + [' numbers.'],baris-anyar.
{ :i Wetonan tulis: ['number #'] + i + [':'] + (numbers posisi: i), baris-anyar.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages pisah: [' Or '].
Wetonan tulis: ['We serve'], baris-anyar.
{ :i Wetonan tulis: ['->'] + (beverages posisi: i), baris-anyar. } × (beverages cacah).
Wetonan tulis: (beverages gabung: [',']), baris-anyar.
Wetonan tulis: (numbers gabung: ['||']).
