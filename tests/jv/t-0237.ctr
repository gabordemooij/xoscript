
Tèks nalika: ['evaluate'] tindakna: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (dhiri tèks + ['.']).
	Program gunakna: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus anyar)
	seleh: ['Hi There'] ing: ['two'],
	seleh: (Dhaptar ← ['hello'] ; ['world'] ; (Dhaptar ← 1 ; 2; 9) ; Salah) ing: ['one'],
	seleh: ( (Kamus anyar) seleh: ['wrrld'] ing: ['misspelled'] ) ing: ['three'],
	seleh: (Dhaptar ← ((Kamus anyar) seleh: ['treasure'] ing: ['hidden']) ; 2) ing: ['four']. 
>> str := map tèks.
>> map2 := Kosong.
(['map2 := '] + str ) evaluate.
Wetonan tulis: map2 ? ['one'] ? 0.
Wetonan tulis: map2 ? ['one'] ? 1.
Wetonan tulis: map2 ? ['four'] ? 0 ? ['hidden'].
Wetonan tulis: map2 ? ['one'] ? 2 ? 2.
