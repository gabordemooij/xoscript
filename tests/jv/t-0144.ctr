



>> CoffeeGrounds := Obyek anyar.
CoffeeGrounds nalika: ['extract'] tindakna: { <- ['coffee']. }.

>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['init'] tindakna: {
	duweke coffeegrounds := CoffeeGrounds anyar.
}.
CoffeeMachine nalika: ['anyar'] tindakna: { <- CoffeeMachine `new init.
}.

CoffeeMachine nalika: ['makeTea'] tindakna: { <- (duweke tealeaves extract). }.
CoffeeMachine nalika: ['makeCoffee'] tindakna: { <- (duweke coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine anyar.

Wetonan tulis:
	coffeeDream 
	makeCoffee.

Wetonan tulis:
	coffeeDream 
	makeTea.
