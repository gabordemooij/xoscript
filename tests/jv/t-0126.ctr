#Linux
>> Slurp := Obyek anyar.

Slurp nalika: ['anyar'] tindakna: {
	duweke str := [''].
}.

Slurp nalika: ['nieuw'] tindakna: {
	duweke str := [''].
}.

Slurp nalika: ['wangsuli:'] tindakna: { :blah
		duweke str tambah-ing-mburi: blah.
}.

Slurp nalika: ['wangsuli:lan:'] tindakna: { :blah :blahah
		duweke str tambah-ing-mburi: (blah saka: 0 dawa: (blah dawa - 1)).
		duweke str tambah-ing-mburi: [' '].
		duweke str tambah-ing-mburi: blahah.
}.

Slurp nalika: ['obtain'] tindakna: {
	>> buffer := duweke str.
	duweke str := ['']. <- buffer.
}.


Wetonan tulis: (Program sistem: (Slurp anyar echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Berkas anyar: ['/tmp/from.txt'], busak. } cekel: { ['Empty']. }, wiwiti.
{ Berkas anyar: ['/tmp/to.txt'], busak. } cekel: { ['Empty']. }, wiwiti.


Berkas anyar: ['/tmp/to.txt'], ana salah: {
	Wetonan tulis: ['Confirmed. Target file does not exist.\
'].
}.
Berkas anyar: ['/tmp/from.txt'], ana salah: {
	Wetonan tulis: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Slurp anyar touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Program sistem: (Slurp anyar cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Berkas anyar: ['/tmp/to.txt'], ana bener: {
	Wetonan tulis: ['Confirmed. Target file has been created by shell.\
'].
}.


Wetonan tulis: ['Contents of file is:'] + (Berkas anyar: ['/tmp/to.txt'], waca), baris-anyar.
