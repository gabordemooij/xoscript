
Wetonan tulis: ['Break for-loop, 0-4.'], baris-anyar.
{ :i
	Wetonan tulis: ['iteration #'] + i, baris-anyar.
	(i = 4) pedhot.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Wetonan tulis: ['Break while-true loop, 0-4.'], baris-anyar.
{
	Wetonan tulis: ['iteration #'] + x, baris-anyar.
	x tambah: 1.
	((x < 5) dudu) pedhot.
} sasuwene: xIsLessThan10.

Wetonan tulis: ['Break while-false loop, 5,4.'], baris-anyar.
{
	Wetonan tulis: ['iteration #'] + x, baris-anyar.
	x suda: 1.
	(x = 3) pedhot.
} sasuwene: { <- (x > 0). }.

Wetonan tulis: ['Break times loop, 1-4.'], baris-anyar.
{ :i
	Wetonan tulis: ['iteration #'] + i, baris-anyar.
	(i = 4) pedhot.
} × 5.

Wetonan tulis: ['Break block, dont print line.'], baris-anyar.
{ Bener pedhot. Wetonan tulis: ['dont write this!'], baris-anyar. } wiwiti.

Wetonan tulis: ['Break block, dont fire catch...'], baris-anyar.
{ Bener pedhot. Wetonan tulis: ['dont write this!'], baris-anyar. } cekel: { Wetonan tulis: ['Dont catch this!']. }, wiwiti.

Wetonan tulis: ['Test Array each-loop: 0,1'], baris-anyar.
(Dhaptar ← 1 ; 2 ; 3) owahi: { :i
	Wetonan tulis: ['iteration #'] + i, baris-anyar.
	(i = 1) pedhot.
}.

Wetonan tulis: ['Test Map each-loop: c only'], baris-anyar.
>> m := Kamus anyar.
m seleh: ['first'] ing: ['a'], seleh: ['second'] ing: ['b'], seleh: ['third'] ing: ['c'].
m saben: { :k :v
	Wetonan tulis: ['iteration'] + v + k, baris-anyar.
	Bener pedhot.
}.

