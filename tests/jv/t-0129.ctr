
Dhaptar nalika: ['product'] tindakna: {
	>> total := 1.
	dhiri saben: { :index :element
		total pingna: element.
	}. <- total.
}.

>> a := Dhaptar ← 1 ; 2 ; 3.
Wetonan tulis: a product, baris-anyar.
Wetonan tulis: (Dhaptar ← 2 ; 4 ; 8) product, baris-anyar. 
Wetonan tulis: (Dhaptar ← -2 ; 10) product, baris-anyar. 
Wetonan tulis: (Dhaptar ← 0.5 ; -2) product, baris-anyar. 
