# test url parsing

Server init.
>> url := URL saka: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Wetonan tulis: ['scheme = '] + url skema, baris-anyar.
Wetonan tulis: ['host = '] + url hos, baris-anyar.
Wetonan tulis: ['port = '] + url porta, baris-anyar.
Wetonan tulis: ['path = '] + url dalan, baris-anyar.
Wetonan tulis: ['query = '] + url parameter-panggolekan, baris-anyar.
Wetonan tulis: ['fragment = '] + url pecahan, baris-anyar.
