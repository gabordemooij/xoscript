# test Program version

# this feature is disabled by default
Wetonan tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-anyar.


# but if we set the time back
>> today := Wektu 
zona: ['CEST'],
saka: ['2026-02-15 10:00:00'].
Program versi: today.

# it will be enabled like it used to be (from now on)
Wetonan tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-anyar.