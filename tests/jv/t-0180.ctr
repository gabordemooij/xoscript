Tèks nalika: ['html'] tindakna: { <- (
		dhiri
		ganti: ['&'] nganggo: ['&amp;'],
		ganti: ['<'] nganggo: ['&lt;'],
		ganti: ['>'] nganggo: ['&gt;'],
		ganti: ['''] nganggo: ['&apos;'],
		ganti: ['"'] nganggo: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wetonan tulis: txt salin html, baris-anyar.
Wetonan tulis: txt salin aksara-cilik, baris-anyar.
Wetonan tulis: txt salin aksara-gedhe, baris-anyar.
} wiwiti.

Program resiki.

usedMemory1 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wetonan tulis: txt salin html, baris-anyar.
Wetonan tulis: txt salin aksara-cilik, baris-anyar.
Wetonan tulis: txt salin aksara-gedhe, baris-anyar.
} wiwiti.

Program resiki.
usedMemory2 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wetonan tulis: txt salin html, baris-anyar.
Wetonan tulis: txt salin aksara-cilik, baris-anyar.
Wetonan tulis: txt salin aksara-gedhe, baris-anyar.
} wiwiti.

Program resiki.
usedMemory3 := (Program memori ? 0).



( usedMemory1 = usedMemory2 lan: usedMemory1 = usedMemory3, lan: usedMemory2 = usedMemory3 ) bener: {
	Wetonan tulis: ['No memory leaks here'].
}, salah: {
	Wetonan tulis: ['Leaking memory...'].
}.
