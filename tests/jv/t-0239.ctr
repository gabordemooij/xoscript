Dhaptar nalika: ['sum'] tindakna: {
	>> total := 0.
	dhiri saben: { :index :element
		total tambah: element.
	}. <- total.
}.

>> a := Bener.



a nalika: ['tèks'] tindakna: {
	>> answer := Kosong.
	( dhiri = Bener ) bener: {
		answer := ['Yep'].
	}, yen-ora: {
		answer := ['Nope'].
	}. <- answer.
}.

a nalika: ['angka'] tindakna: {
	>> answer := Kosong.
	( dhiri = Bener ) bener: {
		answer := 10.
	}, yen-ora: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b nalika: ['tèks'] tindakna: { <- ['Devil'].
}.

b nalika: ['boolean'] tindakna: { <- Salah.
}.


Wetonan tulis: a, baris-anyar.  
Wetonan tulis: (90 + a), baris-anyar. 
Wetonan tulis: b, baris-anyar. 
Wetonan tulis: (Bener lan: b), baris-anyar.

a := Dhaptar ← ['hello'] ; ['world'] ; Bener ; Kosong ; 666. 
a := a + ( Dhaptar ← 1 ).
Wetonan tulis: a, baris-anyar.
Wetonan tulis: ((Kamus anyar) seleh: Kosong ing: Kosong), baris-anyar.
Wetonan tulis: a sum, baris-anyar. 


{
	a nalika: ['tèks'] tindakna: { <- Kosong. }.
	a := [''] + a.
} cekel: { :error
	Wetonan tulis: ['Error noted: '] + error, baris-anyar.
}, wiwiti.



{
	a nalika: ['angka'] tindakna: { <- Kosong. }.
	a := 3 × a.
} cekel: { :error
	Wetonan tulis: ['Error noted: '] + error, baris-anyar.
}, wiwiti.


{
	a nalika: ['boolean'] tindakna: { <- Kosong. }.
	a := Bener lan: a. 
} cekel: { :error
	Wetonan tulis: ['Error noted: '] + error, baris-anyar.
}, wiwiti.





