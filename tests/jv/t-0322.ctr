

>> Matryoshka := Obyek anyar.
Matryoshka nalika: ['double:'] tindakna: { :secret
	duweke secret := secret × 2.
}.
Matryoshka nalika: ['anyar:'] tindakna: { :secret
	>> answer := Kosong.
	>> t := (secret > 255).
	Wetonan tulis: (secret + [' | '] + t), baris-anyar.
	t bener: {
		answer := secret.
	}, yen-ora: {
		answer := Matryoshka rekursif anyar: (dhiri double: secret).
	}. <- answer.
}.

>> x := Matryoshka anyar: 2.
