# catch-all test (practical)
>> HTML := Tèks anyar.
HTML nalika: ['encode:'] tindakna: { :tekst
	dhiri tambah-ing-mburi: (tekst
	ganti: ['&'] nganggo: ['&amp;'], 
	ganti: ['<'] nganggo: ['&lt;'],
	ganti: ['>'] nganggo: ['&gt;'],
	ganti: ['"'] nganggo: ['&quot;']).
}.
>> blog := HTML anyar.
blog tambah-ing-mburi: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-ing-mburi: ['</h1>'].
Wetonan tulis: blog, baris-anyar.


>> Roman := Angka anyar.
Roman nalika: ['stringy'] tindakna: {
	>> a := [''].
	{ a tambah-ing-mburi: ['I']. } × dhiri. <- a.
}.

>> x := Roman anyar.
x tambah: 3.
Wetonan tulis: x stringy, baris-anyar.

>> Quantum := Boolean anyar.
Quantum nalika: ['true?'] tindakna: { <- ['maybe True']. }.
Wetonan tulis: (Quantum anyar true?), baris-anyar.

>> Nihil := Kosong anyar.
Nihil nalika: ['tèks'] tindakna: { <- ['Nihil']. }.
Wetonan tulis: (Nihil anyar), baris-anyar.
