>> items := Kamus anyar.
items seleh: ['black'] ing: ['coffee'], seleh: ['earl grey'] ing: ['tea'].
Wetonan tulis: (items ing: ['coffee']), tulis: (items ing: ['tea']).
Wetonan tulis: ['there are'] + items cacah + [' items in the array.'].
items seleh: ['capuccino'] ing: ['coffee'].
Wetonan tulis: ['Now my coffee is.. '] + (items ing: ['coffee']).
items seleh: ['aaa'] ing: ['1'].
items seleh: ['bbb'] ing: ['2'].
Wetonan tulis: (items ing: ['a']).
