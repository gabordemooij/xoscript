# test qualifiers

Program resiki.

>> Fruit := Obyek anyar.
Fruit nalika: ['anyar'] tindakna: {
	>> f := dhiri anyar.
	f apples: 0. <- f.
}.
Fruit nalika: ['apples:'] tindakna: { :a duweke apples := a. }.
Fruit nalika: ['apples'] tindakna: { <- duweke apples. }.
Fruit nalika: ['+'] tindakna: { :f
	>> n := Fruit anyar.
	n apples: (f apples + duweke apples). <- n.
}.
Angka nalika: ['apples'] tindakna: { <- ((Fruit anyar) apples: dhiri).
}.

Fruit nalika: ['tèks'] tindakna: { <- duweke apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Wetonan tulis: q, baris-anyar.




