


>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['order:'] tindakna: { :id
	>> coffee := ['Americano'].
	( id = 1 ) bener: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) bener: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) bener: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obyek anyar.
SimpleCoffeeMachine nalika: ['order'] tindakna: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Wetonan tulis: redCup, baris-anyar.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Wetonan tulis: greenCup, baris-anyar.
>> yellowCup := CoffeeMachine order: 1.
Wetonan tulis: yellowCup, baris-anyar.
>> blueCup := CoffeeMachine order: 0.
Wetonan tulis: blueCup, baris-anyar.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Wetonan tulis: blackCup, baris-anyar.
blackCup tambah-ing-mburi: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Wetonan tulis: orangeCup, baris-anyar.
