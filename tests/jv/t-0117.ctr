>> t := Bener.
(t = Bener) bener: { Wetonan tulis: ['T']. }.
(t = Salah) bener: { Wetonan tulis: ['F']. }.
Wetonan tulis: ['|'].
>> t := Salah.
(t = Bener) bener: { Wetonan tulis: ['T']. }.
(t = Salah) bener: { Wetonan tulis: ['F']. }.
Wetonan tulis: ['|'].
>> f := Bener.
(t = Bener lan: f = Salah) bener: { Wetonan tulis: ['T']. }.
(t = Salah lan: f = Bener) bener: { Wetonan tulis: ['F']. }.
Wetonan tulis: ['|'].
>> n := Kosong.
(n Kosong?) bener: { Wetonan tulis: ['T']. }.
(n Kosong?) salah: { Wetonan tulis: ['F']. }.
Wetonan tulis: ['|'].
(f Boolean?) bener: { Wetonan tulis: ['T']. }.
(f Boolean?) salah: { Wetonan tulis: ['F']. }.



