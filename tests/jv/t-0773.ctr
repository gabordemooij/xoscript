Wetonan tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 
a nalika: ['item:'] tindakna: { :int64
	duweke int64 := int64. 
}.
a nalika: ['item'] tindakna: { <- duweke int64.
}.
a item: ( Int64 saka-teks: ['9999'] ).
Wetonan tulis: a item, baris-anyar.
>> old-int64-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Wetonan tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-memori = old-int64-address) bener: {
	Wetonan tulis: ['Object link re-attached.'], baris-anyar.
}.
Wetonan tulis: ( b item ), baris-anyar.
