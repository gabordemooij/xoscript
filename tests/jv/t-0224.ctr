
>> countries := Dhaptar anyar
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Dhaptar anyar
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods miturut: countries, saben: { :key :value
	counter tambah: 1.
}.

Wetonan tulis: (['we serve counter dishes'] counter: counter), baris-anyar.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] aksara urutna: { :v
	counter tambah: 0.
}.

Wetonan tulis: (['we sort counter dishes'] counter: counter), baris-anyar.


>> counter := 0.
{
	{
		counter tambah: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Wetonan tulis: (['we calculate counter numbers.'] counter: counter), baris-anyar.

