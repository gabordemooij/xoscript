>> Grandfather := Obyek anyar.
Grandfather nalika: ['greet'] tindakna: {
	Wetonan tulis: ['Ave!'], baris-anyar.
}.
>> Father := Grandfather anyar.
Father nalika: ['greet'] tindakna: {
	Wetonan tulis: ['Hello'], baris-anyar.
	dhiri greet.
}.
>> Son := Father anyar.
Son nalika: ['greet'] tindakna: {
	Wetonan tulis: ['Hi'], baris-anyar.
	dhiri greet.
}.

Son greet.

>> Roundabout := Obyek anyar.
Roundabout nalika: ['circle:'] tindakna: { :x
	Wetonan tulis: x, baris-anyar.
	(x < 3) bener: { dhiri rekursif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) bener: { Wetonan tulis: x, baris-anyar. x tambah: 1.  increment wiwiti. }. }.
increment wiwiti.