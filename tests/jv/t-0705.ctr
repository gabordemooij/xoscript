

>> obj := Obyek anyar.

obj nalika: ['greet'] tindakna: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj nalika: ['task'] tindakna: {
	duweke property := 123.
	{
		# try binds self/own to object instead of block
		Wetonan tulis: dhiri greet.
		Wetonan tulis: duweke property.
		1 / 0.
	} cekel: {
		Wetonan tulis: dhiri greet.
		Wetonan tulis: duweke property.
		Wetonan tulis: ['ok'].
	}, cobanen.
}.

obj task.