['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Ijade kọ: (x + y), ila-tuntun.

>> x := 10040.07.
>> y := 10305.60.

Ijade kọ: (x + y), ila-tuntun.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ijade kọ: (x + y + z), ila-tuntun.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ijade kọ: (x + y + z), ila-tuntun.

>> q := 0.1.2.

Ijade kọ: (q), ila-tuntun.

>> q := 012.

Ijade kọ: (q), ila-tuntun.
