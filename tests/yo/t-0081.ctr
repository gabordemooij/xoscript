>> map1 := Atumọ-ede tuntun.
>> key1 := Akojọ tuntun.
>> key2 := Akojọ tuntun.

map1
	fi: ['hello'] si: key1,
	fi: ['world'] si: key2.


Ijade
	kọ: ['Map #1 contains: '] + (map1 ni: key1),
	kọ: [' and '] + (map1 ni: key2), ila-tuntun.

>> KeyeableArray := Akojọ tuntun.
KeyeableArray nigbati: ['toString'] ṣe: { <- (ara-rẹ iye-nọmba) toString.
}.

>> map2 := Atumọ-ede tuntun.
key1 := KeyeableArray tuntun.
key2 := KeyeableArray tuntun.

key1 fi-kun-opin: 1.

map2
	fi: ['hello'] si: key1,
	fi: ['world'] si: key2.

Ijade
	kọ: ['Map #2 contains: '] + (map2 ni: key1),
	kọ: [' and '] + (map2 ni: key2), ila-tuntun.
