{
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Dont fail.'].
	unknown doSomething.
} mu: {
	Ijade kọ: ['Caught!'].
}, bẹrẹ.

{
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Dont fail.'].
	tirẹ unknown doSomething.
} mu: {
	Ijade kọ: ['Caught!'].
}, bẹrẹ.

{
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Dont fail.'].
	unknown := 122.
} mu: {
	Ijade kọ: ['Caught!'].
}, bẹrẹ.


{
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Dont fail.'].
	Otitọ dawọ-duro.
	Ijade kọ: ['FAIL'].
} mu: {
	Ijade kọ: ['Caught!'].
}, bẹrẹ.

{
	{
		iṣẹ-ṣiṣe-yii aṣiṣe: ['Dont fail.'].
		Otitọ dawọ-duro.
		Ijade kọ: ['FAIL'].
	} mu: { :x
		(x = ['Dont fail.']) otitọ: { iṣẹ-ṣiṣe-yii aṣiṣe: ['Nested Caught!']. }.
	}, bẹrẹ.
} mu: { :e
	Ijade kọ: e.
}, bẹrẹ.
