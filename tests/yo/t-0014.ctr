>> Greeter := Nkan tuntun.
Greeter nigbati: ['make'] ṣe: {
	>> gr := Nkan tuntun.
	gr nigbati: ['setName:'] ṣe: { :aname
		tirẹ orukọ := aname.
	}.
	gr nigbati: ['greet'] ṣe: {
		Ijade kọ: tirẹ orukọ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a tuntun.
c setName: ['THREE'].
c greet.
>> d := a tuntun.
d setName: ['FOUR'].
d greet.
c greet.
