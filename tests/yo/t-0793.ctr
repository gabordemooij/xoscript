Server init.

>> DB := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'],
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

{
	DB ibeere:
	['DROP TABLE movies'],
	ṣiṣẹ.
} mu: { Ofo. }, bẹrẹ.

DB ibeere:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ṣiṣẹ.

DB ibeere: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
awọn-apa-ibeere: ( Akojọ tuntun ; ['Halloween'] ),
ṣiṣẹ.

DB ibeere: ['SELECT * FROM movies'],
mu-wa: { :movie
	Ijade kọ: movie title, ila-tuntun.
}.

