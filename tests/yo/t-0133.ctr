


>> Deck := Akojọ tuntun.
Deck nigbati: ['print'] ṣe: {
        >> len := ara-rẹ iye-nọmba - 1.
        { :i
                >> len2 := ara-rẹ iye-nọmba - 1.
                Ijade kọ: ['len: '].
                Ijade kọ: len, ila-tuntun.
                Ijade kọ: ['len2: '].
                Ijade kọ: len2, ila-tuntun.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
