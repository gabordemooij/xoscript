

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

>> txt := ['World Salad'].
Ijade kọ: ['this text contains: '] + ( ( txt pin: [' '] ) iye-nọmba ) + [' words.'], ila-tuntun.
txt := txt lati: 6 gigun: 4.
Ijade kọ: txt, ila-tuntun.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


