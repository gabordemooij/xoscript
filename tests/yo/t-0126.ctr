#Linux
>> Slurp := Nkan tuntun.

Slurp nigbati: ['tuntun'] ṣe: {
	tirẹ str := [''].
}.

Slurp nigbati: ['nieuw'] ṣe: {
	tirẹ str := [''].
}.

Slurp nigbati: ['fesi:'] ṣe: { :blah
		tirẹ str fi-kun-opin: blah.
}.

Slurp nigbati: ['fesi:ati:'] ṣe: { :blah :blahah
		tirẹ str fi-kun-opin: (blah lati: 0 gigun: (blah gigun - 1)).
		tirẹ str fi-kun-opin: [' '].
		tirẹ str fi-kun-opin: blahah.
}.

Slurp nigbati: ['obtain'] ṣe: {
	>> buffer := tirẹ str.
	tirẹ str := ['']. <- buffer.
}.


Ijade kọ: (Eto eto-iṣẹ: (Slurp tuntun echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faili tuntun: ['/tmp/from.txt'], paarẹ. } mu: { ['Empty']. }, bẹrẹ.
{ Faili tuntun: ['/tmp/to.txt'], paarẹ. } mu: { ['Empty']. }, bẹrẹ.


Faili tuntun: ['/tmp/to.txt'], wa irọ: {
	Ijade kọ: ['Confirmed. Target file does not exist.\
'].
}.
Faili tuntun: ['/tmp/from.txt'], wa irọ: {
	Ijade kọ: ['Confirmed. Source file does not exist.\
'].
}.



Eto eto-iṣẹ: (Slurp tuntun touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Eto eto-iṣẹ: (Slurp tuntun cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faili tuntun: ['/tmp/to.txt'], wa otitọ: {
	Ijade kọ: ['Confirmed. Target file has been created by shell.\
'].
}.


Ijade kọ: ['Contents of file is:'] + (Faili tuntun: ['/tmp/to.txt'], ka), ila-tuntun.
