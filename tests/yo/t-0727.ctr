Server init.
>> f := Ọna-kika tuntun: ['%d'].
>> a := Blob tuntun: 4.
a bytes: ( Akojọ tuntun ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob tuntun: 4.
b bytes: ( Akojọ tuntun ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a lati: 0 gigun: 3, kọọkan: { :i :byte
	Ijade kọ: ( f mulo-odidi: byte ), ila-tuntun.
}.
a ^ b.
a lati: 0 gigun: 3, kọọkan: { :i :byte
	Ijade kọ: ( f mulo-odidi: byte ), ila-tuntun.
}.
a ^ b.
a lati: 0 gigun: 3, kọọkan: { :i :byte
	Ijade kọ: ( f mulo-odidi: byte ), ila-tuntun.
}.
a tu-silẹ.
b tu-silẹ.

{ a ^ Nkan. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
