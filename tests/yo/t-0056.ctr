>> z := Nkan tuntun.
z nigbati: ['value:'] ṣe: { :v
	tirẹ value := v. <- ara-rẹ.
}.
z nigbati: ['value'] ṣe: { <- tirẹ value. }.
(z setValue: 1) value: 2.
Ijade kọ: z value.
>> x := z.
Ijade kọ: x value.
z := Ofo.
Ijade kọ: z value.
Ijade kọ: x value.
Ijade kọ: ['hello'].
Ijade kọ: 3 + 2.
Ijade kọ: (3 > 2).
