#Linux
>> OS := Eto eto-iṣẹ: (Aṣẹ uname -s), ge-alafo.

>> Slurp := Nkan tuntun.
Slurp nigbati: ['tuntun'] ṣe: {
	tirẹ str := [''].
}.
Slurp nigbati: ['fesi:'] ṣe: { :blah
		(tirẹ str ≠ ['']) otitọ: {
			tirẹ str fi-kun-opin: [' '].
		}.
		tirẹ str fi-kun-opin: blah.
}.
Slurp nigbati: ['fesi:ati:'] ṣe: { :blah :blahah
		(tirẹ str ≠ ['']) otitọ: {
			tirẹ str fi-kun-opin: [' '].
		}.
		(blah gigun > 1) otitọ: {
			tirẹ str fi-kun-opin: (blah lati: 0 gigun: (blah gigun - 1)).
		}, bibẹkọ: {
			tirẹ str fi-kun-opin: blah.
		}.
		tirẹ str fi-kun-opin: [' '].
		tirẹ str fi-kun-opin: blahah.
}.
Slurp nigbati: ['obtain'] ṣe: {
	>> buffer := tirẹ str.
	tirẹ str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text fi-kun-opin: ['hello'].
} × 1000.


Ijade kọ: (
	Eto eto-iṣẹ: (
		Slurp tuntun
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

