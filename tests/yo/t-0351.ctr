
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> koodu := {
	>> o := (
		Atumọ-ede tuntun
		aa: (Akojọ ← 1 ; 2),
		bb: (Akojọ ← 3 ; 4)
	).
	>> s := o ọrọ.
	>> o2 := s nkan.
	(s  oriṣi = Ọrọ oriṣi) otitọ: { Ijade kọ: ['OK1'], ila-tuntun. }.
	(o2 oriṣi = Atumọ-ede oriṣi) otitọ: { Ijade kọ: ['OK2'], ila-tuntun. }.
}.

Eto iṣakoso-iranti: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 1).
koodu bẹrẹ.
Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 1).
koodu bẹrẹ.
Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 1).
koodu bẹrẹ.
Eto sọ-di-mimọ.
usedMemory4 := (Eto iranti ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) otitọ: { Ijade kọ: ['OK3'], ila-tuntun. }.
 
