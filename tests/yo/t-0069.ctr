

Ọrọ nigbati: ['html'] ṣe: { <- (
		ara-rẹ
		rọpo: ['&'] pẹlu: ['&amp;'],
		rọpo: ['<'] pẹlu: ['&lt;'],
		rọpo: ['>'] pẹlu: ['&gt;'],
		rọpo: ['"'] pẹlu: ['&quot;']
	).
}.


Ijade kọ: ([' left trimmed '] ge-alafo) + [' '] + ( ['and right trimmed'] ge-alafo) + ['!'], ila-tuntun.
Ijade kọ: ['<html>"html & entities"</html>'] html.
