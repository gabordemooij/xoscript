>> q := Akojọ ← 1 ; 2 ; 3.
{ q ? ['1']. } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? Otitọ. } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? Irọ. } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? Ofo. } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? (Akojọ tuntun). } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? (Nkan tuntun). } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
{ q ? ({ ['Empty']. }). } mu: { Ijade kọ: ['caught!'], ila-tuntun. }, bẹrẹ.
Ijade kọ: ['caught them all'], ila-tuntun.
