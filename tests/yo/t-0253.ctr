#Linux
>> OS := Eto eto: ['OS'].

>> clock := Akoko tuntun.
	
(OS = ['Haiku']) otitọ: {
	clock agbegbe: ['CET'],
	ọdun: 2017, osù: 7, ọjọ: 13,
	wakati: 18, iseju: 0, iṣẹju-aaya: 0.
}, bibẹkọ: {
	clock agbegbe: ['Europe/Amsterdam'],
	ọdun: 2017, osù: 7, ọjọ: 13,
	wakati: 18, iseju: 0, iṣẹju-aaya: 0.
}.

clock nigbati: ['tell'] ṣe: {
	Ijade kọ: ara-rẹ, ila-tuntun.
}.


clock fi-kun: 2    wakati, tell.
clock fi-kun: 1    wakati, tell.
clock fi-kun: 19 iseju, tell.
clock fi-kun: 1  iseju, tell.
clock fi-kun: 1  iseju, tell.
clock fi-kun: 19 iṣẹju-aaya, tell.
clock fi-kun: 1  iṣẹju-aaya, tell.
clock fi-kun: 1  iṣẹju-aaya, tell.
clock fi-kun: 2    ọdun, tell.
clock fi-kun: 1    ọdun, tell.

(OS = ['Haiku']) otitọ: {
clock fi-kun: 5   osù.
clock agbegbe: ['CEST'], tell.
}, bibẹkọ: {
	clock fi-kun: 5   osù, tell.
}.

clock fi-kun: 1   osù, tell.
clock fi-kun: 19    ọjọ, tell.
clock fi-kun: 1    wakati, tell.
clock fi-kun: 120  yard, tell.
