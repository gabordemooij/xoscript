>> Grandfather := Nkan tuntun.
Grandfather nigbati: ['greet'] ṣe: {
	Ijade kọ: ['Ave!'], ila-tuntun.
}.
>> Father := Grandfather tuntun.
Father nigbati: ['greet'] ṣe: {
	Ijade kọ: ['Hello'], ila-tuntun.
	ara-rẹ greet.
}.
>> Son := Father tuntun.
Son nigbati: ['greet'] ṣe: {
	Ijade kọ: ['Hi'], ila-tuntun.
	ara-rẹ greet.
}.

Son greet.

>> Roundabout := Nkan tuntun.
Roundabout nigbati: ['circle:'] ṣe: { :x
	Ijade kọ: x, ila-tuntun.
	(x < 3) otitọ: { ara-rẹ atunwi-ara circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) otitọ: { Ijade kọ: x, ila-tuntun. x fi-kun: 1.  increment bẹrẹ. }. }.
increment bẹrẹ.