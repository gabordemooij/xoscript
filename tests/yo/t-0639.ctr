
Server init.
Ijade kọ: ['Database test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], 
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii :=
db ibeere: ['SELECT REPEAT('Blah',1000) AS blah'], 
mu-wa: { :row 
	Ijade kọ: row blah gigun, ila-tuntun.
}.
