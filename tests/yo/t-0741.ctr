Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :octhelper
	tirẹ octhelper := octhelper. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ octhelper.
}.

a item: Oct tuntun.

>> old-octhelper-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-octhelper-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
