
Ijade kọ: ['Break for-loop, 0-4.'], ila-tuntun.
{ :i
	Ijade kọ: ['iteration #'] + i, ila-tuntun.
	(i = 4) dawọ-duro.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ijade kọ: ['Break while-true loop, 0-4.'], ila-tuntun.
{
	Ijade kọ: ['iteration #'] + x, ila-tuntun.
	x fi-kun: 1.
	((x < 5) kii-ṣe) dawọ-duro.
} nigba-ti: xIsLessThan10.

Ijade kọ: ['Break while-false loop, 5,4.'], ila-tuntun.
{
	Ijade kọ: ['iteration #'] + x, ila-tuntun.
	x yọ: 1.
	(x = 3) dawọ-duro.
} nigba-ti: { <- (x > 0). }.

Ijade kọ: ['Break times loop, 1-4.'], ila-tuntun.
{ :i
	Ijade kọ: ['iteration #'] + i, ila-tuntun.
	(i = 4) dawọ-duro.
} × 5.

Ijade kọ: ['Break block, dont print line.'], ila-tuntun.
{ Otitọ dawọ-duro. Ijade kọ: ['dont write this!'], ila-tuntun. } bẹrẹ.

Ijade kọ: ['Break block, dont fire catch...'], ila-tuntun.
{ Otitọ dawọ-duro. Ijade kọ: ['dont write this!'], ila-tuntun. } mu: { Ijade kọ: ['Dont catch this!']. }, bẹrẹ.

Ijade kọ: ['Test Array each-loop: 0,1'], ila-tuntun.
(Akojọ ← 1 ; 2 ; 3) yipada-kọọkan: { :i
	Ijade kọ: ['iteration #'] + i, ila-tuntun.
	(i = 1) dawọ-duro.
}.

Ijade kọ: ['Test Map each-loop: c only'], ila-tuntun.
>> m := Atumọ-ede tuntun.
m fi: ['first'] si: ['a'], fi: ['second'] si: ['b'], fi: ['third'] si: ['c'].
m kọọkan: { :k :v
	Ijade kọ: ['iteration'] + v + k, ila-tuntun.
	Otitọ dawọ-duro.
}.

