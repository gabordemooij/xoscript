# test list operations


>> cakes := Akojọ ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes rọpo: 1 gigun: 2 pẹlu: ( Akojọ ← ['cinnamon'] ; ['pineapple'] ).
Ijade kọ: (buy so-pọ: [',']), ila-tuntun.


>> buy := cakes rọpo: 1 gigun: 12 pẹlu: ( Akojọ ← ['cinnamon'] ; ['pineapple'] ).
Ijade kọ: (buy so-pọ: [',']), ila-tuntun.


>> buy := cakes rọpo: 2 gigun: 10 pẹlu: ( Akojọ tuntun ).
Ijade kọ: (buy so-pọ: [',']), ila-tuntun.


>> buy := cakes rọpo: 0 gigun: 1 pẹlu: ( Akojọ tuntun ).
Ijade kọ: (buy so-pọ: [',']), ila-tuntun.


>> buy := cakes rọpo: ['0'] gigun: ['1'] pẹlu: ['x'].
Ijade kọ: (buy so-pọ: [',']), ila-tuntun.
