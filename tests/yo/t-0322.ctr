

>> Matryoshka := Nkan tuntun.
Matryoshka nigbati: ['double:'] ṣe: { :secret
	tirẹ secret := secret × 2.
}.
Matryoshka nigbati: ['tuntun:'] ṣe: { :secret
	>> answer := Ofo.
	>> t := (secret > 255).
	Ijade kọ: (secret + [' | '] + t), ila-tuntun.
	t otitọ: {
		answer := secret.
	}, bibẹkọ: {
		answer := Matryoshka atunwi-ara tuntun: (ara-rẹ double: secret).
	}. <- answer.
}.

>> x := Matryoshka tuntun: 2.
