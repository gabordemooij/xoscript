#Linux

(Faili tuntun: ['/tmp/testje']) wa irọ: {
	Eto eto-iṣẹ: ['mkdir /tmp/testje'].	
}.

(Faili tuntun: ['/tmp/testje/file1']) wa irọ: {
	Eto eto-iṣẹ: ['touch /tmp/testje/file1'].	
}.

(Faili tuntun: ['/tmp/testje/folder1']) wa irọ: {
	Eto eto-iṣẹ: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faili akojọ: ['/tmp/testje'].

>> q := Akojọ tuntun.

l kọọkan: { :k :v v kọọkan: { :x :y q fi-kun-opin: y. }. }.

>> s := q ọrọ.

(s ni-akoonu: ['file1']) otitọ:   { Ijade kọ: ['OK'], ila-tuntun. }.
(s ni-akoonu: ['file2']) otitọ:   { Ijade kọ: ['XX'], ila-tuntun. }.
(s ni-akoonu: ['folder1']) otitọ: { Ijade kọ: ['OK'], ila-tuntun. }.
