Server init.
>> fmt := Ọna-kika tuntun: ['%#3x'].

>> blob := Blob tuntun: 4.
blob bytes: ( 
	Akojọ tuntun ; 0 ; 1 ; 2 ; 3
).

>> file := Faili tuntun: ['/tmp/blob'].
file blob: blob.
blob tu-silẹ.

>> ka := file blob.
ka 
lati: 0 
gigun: 4, 
ṣe kọọkan: { :i :b 
	Ijade
	kọ: (fmt mulo-odidi: b),
	ila-tuntun.
}.
ka tu-silẹ.
