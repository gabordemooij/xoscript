>> HTML := Nkan tuntun.
HTML nigbati: ['fesi:'] ṣe: { :tag 
	Ijade kọ: (['<tag>'] tag: tag), ila-tuntun.
}.
HTML nigbati: ['fesi:ati:'] ṣe: { :tag :html 
	Ijade kọ: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), ila-tuntun.
}.
>> html := HTML tuntun.
html body h1: ['header'].

