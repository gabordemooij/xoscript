Nọmba nigbati: ['factorial'] ṣe: {
	>> total := 1.
	{ :index total sọ-di-pupọ: (ara-rẹ - (index)). } × ara-rẹ. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ijade kọ: a.
>> b := 2 + 3 factorial.
Ijade kọ: b.
>> c := 3 factorial + 2.
Ijade kọ: c.
>> d := 2 + (3 factorial).
Ijade kọ: d.
Ijade kọ: 2 + 3 factorial + 1.
