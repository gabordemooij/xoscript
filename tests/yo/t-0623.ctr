

>> g := Server tuntun.
>> v := Apoti-aabo tuntun.
>> ok := 0.

>> secrets := Akojọ tuntun ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets ṣe-ẹda.
passwords kọọkan: { :i :p
	secrets kọọkan: { :n :s
		{
			>> encrypted := v paroko: s kọkọrọ: p.
			>> decrypted := v tu-paroko: encrypted kọkọrọ: p.
			(decrypted = s) otitọ: {
				ok fi-kun: 1.
			}, bibẹkọ: {
				Ijade kọ: ['failed encrypting/decrypting: '], ila-tuntun.
				Ijade kọ: s, ila-tuntun.
				Ijade kọ: ['encrypted: '] + encrypted, ila-tuntun.
				Ijade kọ: ['decrypted: '] + encrypted, ila-tuntun.
				Eto ipari.
			}.
		} mu: { :err
			(s = [''] tabi: p = ['']) otitọ: {
				ok fi-kun: 1.
			}, bibẹkọ: {
				Ijade kọ: err, ila-tuntun.
				Eto ipari.
			}.
		}, bẹrẹ.
	}.
}.

Ijade kọ: ( ok + [' vault encryptions tested.'] ), ila-tuntun.