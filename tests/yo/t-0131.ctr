
>> a := Akojọ ← (Akojọ ← 100 ; 200 ; 300) ; (Akojọ ← 9 ; 8 ; 7).
Ijade kọ: ['at 0,1 :'].
Ijade kọ: a ? 0 ? 1, ila-tuntun. 
Ijade kọ: ['at 1,2 :'].
Ijade kọ: a ? 1 ? 2, ila-tuntun. 
>> menu := Atumọ-ede tuntun.
menu fi: (Akojọ ← ['pizza'] ; ['spaghetti']) si: ['Italian Cuisine'].
menu fi: (Akojọ ← ['bifteki'] ; ['suflaki']) si: ['Greek Cuisine'].
Ijade kọ: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), ila-tuntun. 
Ijade kọ: ['but not on the same plate.'], ila-tuntun.
