
Ọrọ nigbati: ['evaluate'] ṣe: {
	>> koodu := Faili tuntun: ['/tmp/eval.ctr'].
	koodu kọ: (ara-rẹ ọrọ + ['.']).
	Eto lo: ['/tmp/eval.ctr'].
}.

>> map :=
	(Atumọ-ede tuntun)
	fi: ['Hi There'] si: ['two'],
	fi: (Akojọ ← ['hello'] ; ['world'] ; (Akojọ ← 1 ; 2; 9) ; Irọ) si: ['one'],
	fi: ( (Atumọ-ede tuntun) fi: ['wrrld'] si: ['misspelled'] ) si: ['three'],
	fi: (Akojọ ← ((Atumọ-ede tuntun) fi: ['treasure'] si: ['hidden']) ; 2) si: ['four']. 
>> str := map ọrọ.
>> map2 := Ofo.
(['map2 := '] + str ) evaluate.
Ijade kọ: map2 ? ['one'] ? 0.
Ijade kọ: map2 ? ['one'] ? 1.
Ijade kọ: map2 ? ['four'] ? 0 ? ['hidden'].
Ijade kọ: map2 ? ['one'] ? 2 ? 2.
