Ọrọ nigbati: ['html'] ṣe: { <- (
		ara-rẹ
		rọpo: ['&'] pẹlu: ['&amp;'],
		rọpo: ['<'] pẹlu: ['&lt;'],
		rọpo: ['>'] pẹlu: ['&gt;'],
		rọpo: ['''] pẹlu: ['&apos;'],
		rọpo: ['"'] pẹlu: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ijade kọ: txt ṣe-ẹda html, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-kekere, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-nla, ila-tuntun.
} bẹrẹ.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ijade kọ: txt ṣe-ẹda html, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-kekere, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-nla, ila-tuntun.
} bẹrẹ.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ijade kọ: txt ṣe-ẹda html, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-kekere, ila-tuntun.
Ijade kọ: txt ṣe-ẹda lẹta-nla, ila-tuntun.
} bẹrẹ.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
