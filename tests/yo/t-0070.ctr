>> numbers := ['1,2,3'] pin: [','].
Ijade kọ: ['I got: '] + numbers iye-nọmba + [' numbers.'],ila-tuntun.
{ :i Ijade kọ: ['number #'] + i + [':'] + (numbers ipo: i), ila-tuntun.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages pin: [' Or '].
Ijade kọ: ['We serve'], ila-tuntun.
{ :i Ijade kọ: ['->'] + (beverages ipo: i), ila-tuntun. } × (beverages iye-nọmba).
Ijade kọ: (beverages so-pọ: [',']), ila-tuntun.
Ijade kọ: (numbers so-pọ: ['||']).
