# session cookie format, json content type, web protocols only, svg shown inline
Server múra.
Eto lo: ['../../../src/xo/yo/webtools.xo'].

>> Fake-Request := Nkan tuntun.
Fake-Request nigbati: ['value:'] ṣe: { :iye
	tirẹ iye := iye.
}.
Fake-Request nigbati: ['cookie:'] ṣe: { :orukọ <- tirẹ iye.
}.

>> Test-Session := Ìpàdé-fáìlì-ìgbà-díẹ̀ tuntun.
Test-Session nigbati: ['gbé-wọlé'] ṣe: { <- Atumọ-ede tuntun.
}.
Test-Session nigbati: ['session-id'] ṣe: { <- tirẹ id.
}.

>> cookies := Akojọ tuntun
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies kọọkan: { :i :cookie
	>> ìbéèrè-http := Fake-Request tuntun.
	ìbéèrè-http value: cookie.
	>> alákòóso := Test-Session tuntun.
	>> web := Ìwé-Wẹẹbu tuntun.
	web ìbéèrè-http: ìbéèrè-http.
	web alákòóso-ìpàdé: alákòóso.
	web bẹ̀rẹ̀-ìpàdé.
	Ijade kọ: ( alákòóso session-id = cookie ), ila-tuntun.
}.

>> web := Ìwé-Wẹẹbu tuntun.
web json: (Atumọ-ede tuntun fi: ['b'] si: ['a']).
Ijade kọ: ['\n'], ila-tuntun.

{ Nẹtiwọọki get: ['file:///etc/hostname']. } mu: { :e
	Ijade kọ: e, ila-tuntun.
}, bẹrẹ.

>> svg := Faili tuntun: ['/tmp/test0814.svg'].
svg kọ: ['<svg xmlns="x"></svg>'].
Ijade ila-tuntun.
Server kọja: ['test0814.svg'] asomọ-iwaju: ['/tmp/'].
svg paarẹ.
