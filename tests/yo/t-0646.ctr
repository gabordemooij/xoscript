Server init.
Ijade kọ: ['Database datetime test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], 
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii :=
db ibeere: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
mu-wa: { :row
	Ijade kọ: row datetimetest, ila-tuntun.
}.
