>> makeAdder := { :x
	>> f := { :y <- (tirẹ x + y). } ṣeto: ['x'] iye: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i tirẹ q fi: (tirẹ f mulo: (tirẹ q ? i)) si: i. } 
	ṣeto: ['q'] iye: array,
	ṣeto: ['f'] iye: func.
	{ :i mapping mulo: i. } × (array iye-nọmba).
}.

>> a := Akojọ ← 1; 2; 3.
mapper mulo: a ati: (makeAdder mulo: 100).
Ijade kọ: (a ipo: 0), ila-tuntun.
Ijade kọ: (a ? 1), ila-tuntun.
Ijade kọ: (a ? 2), ila-tuntun.
