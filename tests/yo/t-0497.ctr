Server init.

# write a test file
>> f := Faili tuntun: ['/tmp/test.gif'].
f kọ: ['GIF87a01234567810'].

# serve the file
Server kọja: ['test.gif'] asomọ-iwaju: ['/tmp/'].

Ijade ila-tuntun.

Ijade kọ: ['Outside container (security):'], ila-tuntun.
{ Server kọja: ['../passwd'] asomọ-iwaju: ['/tmp/']. }
mu: { :e Ijade kọ: e, ila-tuntun. },
bẹrẹ.

Ijade kọ: ['Invalid prefix:'], ila-tuntun.
{ Server kọja: ['test.gif'] asomọ-iwaju: ['z:\\']. }
mu: { :e Ijade kọ: e, ila-tuntun. },
bẹrẹ.

Ijade kọ: ['Non-existant file:'], ila-tuntun.
{ Server kọja: ['xxx.xxx'] asomọ-iwaju: ['/tmp/']. }
mu: { :e Ijade kọ: e, ila-tuntun. },
bẹrẹ.
