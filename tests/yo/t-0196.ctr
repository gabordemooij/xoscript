
>> animal := Nkan tuntun. 
 
 animal nigbati: ['name:'] ṣe: { :n
tirẹ orukọ := n.
}. 


animal name: ['Diva']. 
 
animal nigbati: ['orukọ'] ṣe: { <- orukọ.
}.

>> cat := animal tuntun.
 
 cat name: ['Diva']. 
 
 cat nigbati: ['orukọ'] ṣe: { <- ['your royal highness ']
+ (ara-rẹ orukọ).
}.

Ijade kọ: cat orukọ.
