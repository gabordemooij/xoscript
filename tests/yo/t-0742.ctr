Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :hexhelper
	tirẹ hexhelper := hexhelper. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ hexhelper.
}.

a item: Hx tuntun.

>> old-hexhelper-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-hexhelper-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
