

# create a 64-bit integer for exact calculations
>> a := Int64 lati-ọrọ: ['123'].

# to string
Ijade kọ: a, ila-tuntun.

# divide
Ijade kọ: a / (Int64 lati-ọrọ: ['3']), ila-tuntun.

# multiply
Ijade kọ: a * (Int64 lati-ọrọ: ['2']), ila-tuntun.

# add
Ijade kọ: a + (Int64 lati-ọrọ: ['1']), ila-tuntun.

# subtract
Ijade kọ: a - (Int64 lati-ọrọ: ['2']), ila-tuntun.

# compare
Ijade kọ: ( a =   (Int64 lati-ọrọ: ['123'])), ila-tuntun.
Ijade kọ: ( a !=: (Int64 lati-ọrọ: ['124'])), ila-tuntun.
Ijade kọ: ( a <   (Int64 lati-ọrọ: ['124'])), ila-tuntun.
Ijade kọ: ( a >   (Int64 lati-ọrọ: ['122'])), ila-tuntun.
Ijade kọ: ( a >=: (Int64 lati-ọrọ: ['123'])), ila-tuntun.
Ijade kọ: ( a <=: (Int64 lati-ọrọ: ['123'])), ila-tuntun.





	