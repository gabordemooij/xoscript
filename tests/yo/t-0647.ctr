Server init.
Ijade kọ: ['Database time test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], 
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii :=
db ibeere: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
mu-wa: { :row
	Ijade kọ: row timetest, ila-tuntun.
}.
