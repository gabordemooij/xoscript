>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Nkan tuntun.
⚄ nigbati: ['drawFrom:length:'] ṣe: { :pool :iye-nọmba
	
	>> result := [''].
	
	{
		>> index := Nọmba random % (pool gigun).
		result fi-kun-opin: ( pool lẹta: (index + 1) ).
		
	} × iye-nọmba. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? gigun.
Ijade kọ: (['x↵'] x random gigun).
Ijade kọ: (['y↵'] y ?? gigun).

