Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :num
	tirẹ num := num. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ num.
}.

a item: 123.

Ijade kọ: a item, ila-tuntun.

>> old-num-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-num-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

Ijade kọ: b item, ila-tuntun.
