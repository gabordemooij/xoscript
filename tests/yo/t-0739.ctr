Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :binhelper
	tirẹ binhelper := binhelper. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ binhelper.
}.

a item: Bin tuntun.

>> old-binhelper-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-binhelper-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.


