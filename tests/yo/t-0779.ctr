Ijade kọ: ['Test object'], ila-tuntun.
>> p := Ọna /tmp.
Ijade kọ: p, ila-tuntun.
>> old-p-address := p awoṣe-ipilẹ adirẹsi-iranti.
p save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
(b awoṣe-ipilẹ adirẹsi-iranti = old-p-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
Ijade kọ: b, ila-tuntun.
