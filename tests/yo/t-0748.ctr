Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :buliani
	tirẹ buliani := buliani. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ buliani.
}.

a item: Otitọ.

Ijade kọ: a item, ila-tuntun.

>> old-bool-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-bool-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

Ijade kọ: b item, ila-tuntun.
