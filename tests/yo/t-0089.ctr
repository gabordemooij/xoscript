>> randomizer := { :a :b
	>> o-kere-ju := ( a < b ) boya: a tabi: b.
	>> o-pọju := ( a > b ) boya: a tabi: b.
	>> x := Ofo.
	{
		x := Nọmba laarin: a ati: b.
		((x < o-kere-ju) tabi: (x > o-pọju)) otitọ: { 
			Ijade kọ: (['Invalid value!']).
			Eto ipari.
		}.
	} 
	× 100. <- x.
}.
randomizer mulo: 0 ati: 0.
randomizer mulo: 1 ati: 0.
randomizer mulo: 1 ati: 1.
randomizer mulo: 0 ati: 1.
randomizer mulo: -1 ati: 0.
