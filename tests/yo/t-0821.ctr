# a quote that never closes must give an error, not an endless loop
>> ọna-faili := ['/tmp/test0821.csv'].
>> file := Faili tuntun: ọna-faili.

file kọ: ['a,b\n"1,2\n'].
{
	file olupin: [','] ami-ọrọ: ['"'] awọn-ila: { :line
		Ijade kọ: line, ila-tuntun.
	}.
} mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.

# a closed quote still works
file kọ: ['a,b\n"1,2",3'].
file olupin: [','] ami-ọrọ: ['"'] awọn-ila: { :line
	Ijade kọ: line, ila-tuntun.
}.
file paarẹ.
