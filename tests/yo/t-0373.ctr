# compliance test

# use international numbers

Ijade kọ: ['1000 -> '].
Ijade kọ: 1000, ila-tuntun. #1000

Ijade kọ: ['1.5 -> '].
Ijade kọ: 1.5, ila-tuntun.  #1.5

Ijade kọ: ['1001.5 -> '].
Ijade kọ: 1.5 + 1000, ila-tuntun. #1001.5

# use 0-indexed arrays
>> x := Akojọ tuntun ; 1 ; 2 ; 3.
>> y := Akojọ tuntun ; ['a'] ; ['b'] ; ['c'].

Ijade kọ: ['1 -> '].
Ijade kọ: x ? 0, ila-tuntun. #1

Ijade kọ: ['1 -> '].
Ijade kọ: (x ni: 0), ila-tuntun. #1

Ijade kọ: ['1 -> '].
Ijade kọ: x akọkọ, ila-tuntun. #1

Ijade kọ: ['3 -> '].
Ijade kọ: x ikẹhin, ila-tuntun. #3

Ijade kọ: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ijade kọ: (x gẹgẹ-bi: y), ila-tuntun.

Ijade kọ: ['1 -> '].
Ijade kọ: (x lati: 0 gigun: 1) akọkọ, ila-tuntun. #1

Ijade kọ: ['0 -> '].
Ijade kọ: (x ri: 1), ila-tuntun. #0

x fi: 9 si: 0.

Ijade kọ: ['9 -> '].
Ijade kọ: (x ni: 0), ila-tuntun. #9

x fi-kun-ibẹrẹ: 8.
Ijade kọ: ['8 -> '].
Ijade kọ: (x ni: 0), ila-tuntun. #9


x fi-kun-opin: 10.
Ijade kọ: ['10 -> '].
Ijade kọ: (x ni: 4), ila-tuntun. #10








