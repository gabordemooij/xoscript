# line breaks in values must not create extra headers
Server múra.
Eto lo: ['../../../src/xo/yo/webtools.xo'].
Eto lo: ['../../../src/xo/yo/mailtools.xo'].

>> akọle := Akọle-HTTP tuntun kọ́kọ́rọ́: ['Location'] iye: ['/ok\r\nX-Injected: yes'].
Ijade kọ: akọle.

>> web := Ìwé-Wẹẹbu tuntun.
web lọ-sí: ['/ok\r\nX-Injected: yes'].
Ijade kọ: ['\n'], ila-tuntun.

>> mail := Imeeli tuntun.
mail sí: (Akojọ tuntun ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Akojọ tuntun ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Akojọ tuntun ; ['c@example.invalid\r\nX-Bcc: yes']).
mail olùfiránṣẹ́: ['d@example.invalid\r\nX-From: yes'] orukọ: ['site\r\nX-Name: yes'].
mail kókó-ọ̀rọ̀: ['hello\r\nX-Subject: yes'].
mail ara: ['line1\r\nline2'].
Ijade kọ: mail ṣẹ̀dá.

>> html := Imeeli-HTML tuntun.
html sí: (Akojọ tuntun ; ['a@example.invalid\r\nX-To: yes']).
html olùfiránṣẹ́: ['d@example.invalid'] orukọ: ['site'].
html kókó-ọ̀rọ̀: ['hello\r\nX-Subject: yes'].
html ara: ['body'].
Ijade kọ: ( html ṣẹ̀dá ni-akoonu: ['\nX-'] ), ila-tuntun.
Ijade kọ: ( html ṣẹ̀dá ni-akoonu: ['X-To: yes'] ), ila-tuntun.
