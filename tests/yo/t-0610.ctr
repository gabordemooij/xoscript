
>> Rectangle := Nkan tuntun.

Rectangle nigbati: ['area'] ṣe: { <- tirẹ gigun * tirẹ width.
}.

Rectangle nigbati: ['length:'] ṣe: { :gigun
	tirẹ gigun := gigun.
}.

Rectangle nigbati: ['width:'] ṣe: { :width
	tirẹ width := width.
}.

Rectangle nigbati: ['tuntun'] ṣe: {
	# this will not result into an infinite loop
	>> rectangle := ara-rẹ tuntun.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle tuntun.
Ijade kọ: a area, ila-tuntun. #0

>> b := Rectangle tuntun length: 2, width: 3.
Ijade kọ: b area, ila-tuntun. #6

