# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Eto eto: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server sopọ: ( Akojọ tuntun ;
 libname ; ['fopen'] ;
 ( Akojọ tuntun ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
sopọ: ( Akojọ tuntun ;
 Ofo ; # means same lib
 ['fread'] ;
 ( Akojọ tuntun ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ofo ; # means same object (i.e. Stream)
 ['fread']
),
sopọ: (
 Akojọ tuntun ;
 Ofo ; # means same lib
 ['fwrite'] ;
 ( Akojọ tuntun ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ofo ; # means same lib
 ['fwrite']
),
sopọ: (
 Akojọ tuntun ;
 Ofo ; # means same lib
 ['rewind'] ;
 ( Akojọ tuntun ; ['pointer'] ) ;
 ['int'] ;
 Ofo ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ọna-faili := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ọna-faili mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream ifiranṣẹ: ['fwrite'] awọn-apa: (Akojọ tuntun ; str ; 1 ; 6 ; fd ).
Ijade kọ: bytes-written, ila-tuntun.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob tuntun: 20.

# read from file
>> bytes-read := Stream ifiranṣẹ: ['fread'] awọn-apa: (Akojọ tuntun ; buf ; 1 ; 6 ; fd ).
Ijade kọ: bytes-read, ila-tuntun.
Ijade kọ: buf, ila-tuntun.

# free memory
str  tu-silẹ.
ọna-faili tu-silẹ.
mode tu-silẹ.
buf  tu-silẹ.


