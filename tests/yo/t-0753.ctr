Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :fmt
	tirẹ fmt := fmt. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ fmt.
}.

a item: ( Ọna-kika tuntun: ['|%s|'] ).

Ijade kọ: a item, ila-tuntun.

>> old-fmt-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-fmt-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

Ijade kọ: ( b item mulo: ['hello'] ), ila-tuntun.
