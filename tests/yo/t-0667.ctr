# test Program version

# this feature is disabled by default
Ijade kọ: (
	Eto ẹya-ara: 
	['RECURSIVE_STRINTPOL']
), ila-tuntun.


# but if we set the time back
>> today := Akoko 
agbegbe: ['CEST'],
orisun: ['2026-02-15 10:00:00'].
Eto ẹya: today.

# it will be enabled like it used to be (from now on)
Ijade kọ: (
	Eto ẹya-ara: 
	['RECURSIVE_STRINTPOL']
), ila-tuntun.