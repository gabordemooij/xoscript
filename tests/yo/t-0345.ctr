# test catch-all methods
>> x13 := Nkan tuntun.
x13 nigbati: ['a'] ṣe: { :a Ijade kọ: 0, ila-tuntun. }.
x13 nigbati: ['a:'] ṣe: { :a Ijade kọ: a, ila-tuntun. <- 5. }.
x13 nigbati: ['a:b:'] ṣe: { :a :b Ijade kọ: (a + b), ila-tuntun. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
