


>> wine := Nkan tuntun.


wine nigbati: ['toString'] ṣe: { <- ['merlot'].
}.

wine nigbati: ['naarTekst'] ṣe: { <- ['merlot'].
}.


wine nigbati: ['='] ṣe: { :other wine <- ( ara-rẹ toString = other wine ).
}.

wine nigbati: ['=='] ṣe: { :other wine <- ( ara-rẹ toString = other wine ).
}.



wine
	ti-o-ba: ['cabernet'] ṣe: { Ijade kọ: ['it's a Cabernet!']. },
	ti-o-ba: ['syrah']    ṣe: { Ijade kọ: ['it's a Syrah!'].    },
	ti-o-ba: ['merlot']   ṣe: { Ijade kọ: ['it's a Merlot!'].   },
	ti-o-ba: ['malbec']   ṣe: { Ijade kọ: ['it's a Malbec!'].   }.

Ijade ila-tuntun.
