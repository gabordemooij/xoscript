# a value ending in the first part of an opening quote must survive serialization
>> awọn-iye := Akojọ tuntun
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

awọn-iye kọọkan: { :i :value
	>> d := Atumọ-ede tuntun.
	d fi: value si: ['k'].
	d fi: ['second'] si: ['j'].
	>> r := d koodu nkan.
	Ijade kọ: r iye-nọmba, ila-tuntun.
	Ijade kọ: ( (r ni: ['k']) = value ), ila-tuntun.
}.
