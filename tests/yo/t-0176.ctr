

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

>> txt := ['Word Salad'].
Ijade kọ: ['Text Length: '] + txt gigun, ila-tuntun.
Ijade kọ: ['Character at 2:'] + ( txt lẹta: 2 ), ila-tuntun.
Ijade kọ: (( txt ri: ['S'] ) - 0), ila-tuntun.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


txt := ['Word Salad'].
Ijade kọ: ['Text Length: '] + txt gigun, ila-tuntun.
Ijade kọ: ['Character at 2:'] + ( txt lẹta: 2 ), ila-tuntun.
Ijade kọ: (( txt ri: ['S'] ) - 0), ila-tuntun.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


txt := ['Word Salad'].
Ijade kọ: ['Text Length: '] + txt gigun, ila-tuntun.
Ijade kọ: ['Character at 2:'] + ( txt lẹta: 2 ), ila-tuntun.
Ijade kọ: (( txt ri: ['S'] ) - 0), ila-tuntun.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
