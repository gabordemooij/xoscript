Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :out
	tirẹ out := out. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ out.
}.

a nigbati: ['greet'] ṣe: {
	Ijade kọ: ['hi from original out!'], ila-tuntun.
}.

a item: Ijade.

Ijade kọ: a item, ila-tuntun.

>> old-out-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-out-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

b item kọ: ['hello from loaded out!'], ila-tuntun.
b greet.
