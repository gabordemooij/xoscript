
Nọmba kọ-ẹkọ: ['plus:'] tumọ-si: ['+'].
Nọmba nigbati: ['+'] ṣe: { :x
	>> rate := 1.
	>> currency := x ẹyọ-iwọn.
	(currency = ['euros']) otitọ: {
		rate := 2.
	}. <- (ara-rẹ plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars iwọn-ẹyọ: ['dollars'].
euros iwọn-ẹyọ: ['euros'].
>> money := dollars + euros.
Ijade kọ: money, ila-tuntun.
