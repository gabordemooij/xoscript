


>> CoffeeMachine := Nkan tuntun.
CoffeeMachine nigbati: ['order:'] ṣe: { :id
	>> coffee := ['Americano'].
	( id = 1 ) otitọ: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) otitọ: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) otitọ: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Nkan tuntun.
SimpleCoffeeMachine nigbati: ['order'] ṣe: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ijade kọ: redCup, ila-tuntun.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ijade kọ: greenCup, ila-tuntun.
>> yellowCup := CoffeeMachine order: 1.
Ijade kọ: yellowCup, ila-tuntun.
>> blueCup := CoffeeMachine order: 0.
Ijade kọ: blueCup, ila-tuntun.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ijade kọ: blackCup, ila-tuntun.
blackCup fi-kun-opin: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ijade kọ: orangeCup, ila-tuntun.
