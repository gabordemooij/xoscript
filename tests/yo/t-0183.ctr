

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

>> o := Nkan tuntun.
>> o2 := Nkan tuntun.
Ijade kọ: o Ofo?, ila-tuntun.
Ijade kọ: o oriṣi, ila-tuntun.
Ijade kọ: ( o ọkan-naa: o ), ila-tuntun.
Ijade kọ: ( o ọkan-naa: o2 ), ila-tuntun.
Ijade kọ: o funrarami, ila-tuntun.
Ijade kọ: ( o ṣe pari ), ila-tuntun.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


o := Nkan tuntun.
o2 := Nkan tuntun.
Ijade kọ: o Ofo?, ila-tuntun.
Ijade kọ: o oriṣi, ila-tuntun.
Ijade kọ: ( o ọkan-naa: o ), ila-tuntun.
Ijade kọ: ( o ọkan-naa: o2 ), ila-tuntun.
Ijade kọ: o funrarami, ila-tuntun.
Ijade kọ: ( o ṣe pari ), ila-tuntun.

