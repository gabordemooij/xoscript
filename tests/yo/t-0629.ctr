# database test
# see example server.xo for required config

Server init.
Ijade kọ: ['Database test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], ọrọ-igbaniwọle: ['pass123'], orukọ-ibi-ipamọ: ['xobase'], sopọ-mọ.

Ijade kọ: ['Can we connect? '] + db ti-sopọ?, ila-tuntun.

>> awọn-apa-iwadii := db ibeere: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], awọn-apa-ibeere: ( Akojọ tuntun ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  awọn-apa-iwadii ṣiṣẹ. db fidi-mulẹ. } mu: { :e db yi-pada-sẹhin.  }, bẹrẹ.

Ijade kọ: ['Can we insert? '] + ( awọn-apa-iwadii insert-id > 0 ), ila-tuntun.

>> Obj := Nkan tuntun.
Obj nigbati: ['retrieve-rows'] ṣe: {
	tirẹ iye-nọmba := 0.
	>> awọn-apa-iwadii :=
	db ibeere: ['SELECT * FROM book order by id desc limit 2'], 
	mu-wa: { :row 
		tirẹ iye-nọmba fi-kun: 1.
		Otitọ dawọ-duro.
	}. <- tirẹ iye-nọmba ṣe-ẹda.
}.

Ijade kọ: ['Can we query? '] + ( Obj retrieve-rows > 0 ), ila-tuntun.
