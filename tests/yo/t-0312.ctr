>> Slurp := Nkan tuntun.
Slurp nigbati: ['tuntun'] ṣe: {
	tirẹ str := [''].
}.
Slurp kọ-ẹkọ: ['nieuw'] tumọ-si: ['tuntun'].
Slurp nigbati: ['fesi:'] ṣe: { :blah
		(tirẹ str ≠ ['']) otitọ: {
			tirẹ str fi-kun-opin: [' '].
		}.
		tirẹ str fi-kun-opin: blah.
}.
Slurp nigbati: ['fesi:ati:'] ṣe: { :blah :blahah
		(tirẹ str ≠ ['']) otitọ: {
			tirẹ str fi-kun-opin: [' '].
		}.
		(blah gigun > 1) otitọ: {
			tirẹ str fi-kun-opin: (blah lati: 0 gigun: (blah gigun - 1)).
		}, bibẹkọ: {
			tirẹ str fi-kun-opin: blah.
		}.
		tirẹ str fi-kun-opin: [' '].
		tirẹ str fi-kun-opin: blahah.
}.
Slurp nigbati: ['obtain'] ṣe: {
	>> buffer := tirẹ str.
	tirẹ str := ['']. <- buffer.
}.


>> awọn-apa-iwadii := Slurp tuntun
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Ijade kọ: awọn-apa-iwadii obtain, ila-tuntun.
