

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Eto iṣakoso-iranti: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt fi-kun-opin: ['!!'].
Ijade kọ: txt.
} bẹrẹ.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt fi-kun-opin: ['!!'].
