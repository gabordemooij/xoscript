# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'],
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii := db ibeere: ['SELECT %% FROM'].
{ awọn-apa-iwadii ṣiṣẹ. } mu: { :e
	Ijade kọ: ( e ni-akoonu: ['%%'] ), ila-tuntun.
}, bẹrẹ.
