Eto iṣakoso-iranti: 4.

>> Doubler := Nkan tuntun.
>> Multiplier := Nkan tuntun.
Doubler nigbati: ['double:and:'] ṣe: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier nigbati: ['multiply:and:'] ṣe: { :x :y <- (x × y).
}.

Ijade kọ: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), ila-tuntun.
