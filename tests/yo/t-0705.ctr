

>> obj := Nkan tuntun.

obj nigbati: ['greet'] ṣe: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj nigbati: ['task'] ṣe: {
	tirẹ property := 123.
	{
		# try binds self/own to object instead of block
		Ijade kọ: ara-rẹ greet.
		Ijade kọ: tirẹ property.
		1 / 0.
	} mu: {
		Ijade kọ: ara-rẹ greet.
		Ijade kọ: tirẹ property.
		Ijade kọ: ['ok'].
	}, gbiyanju.
}.

obj task.