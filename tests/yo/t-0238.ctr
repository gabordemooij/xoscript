Ọrọ nigbati: ['evaluate'] ṣe: {
	>> koodu := Faili tuntun: ['/tmp/eval.ctr'].
	koodu kọ: (ara-rẹ ọrọ + ['.']).
	Eto lo: ['/tmp/eval.ctr'].
}.

>> a := Akojọ ← 1 ; 2 ; 3.
>> b := (a ọrọ).

Ijade kọ: b, ila-tuntun. 
(['b := '] + b) evaluate.

Ijade kọ: b ? 2, ila-tuntun. 

Ijade kọ: (( Akojọ ← 1 ; 2 ; 3 )), ila-tuntun. 

Ijade kọ: ((Atumọ-ede tuntun) fi: 1 si: 2), ila-tuntun. 

>> x := ( (Akojọ ← 1 ; ( Akojọ ← 9 ) ; Otitọ ) ) ọrọ.
Ijade kọ: x, ila-tuntun. 
(['x := '] + x) evaluate.

Ijade kọ: x ? 1 ? 0, ila-tuntun. 

>> y := (Atumọ-ede tuntun) fi: (Akojọ ← 1) si: (Akojọ ← 2).
Ijade kọ: y, ila-tuntun. 

(['y := '] + y) ọrọ evaluate.

Ijade kọ: (y ni: (Akojọ ← 2) ọrọ ), ila-tuntun.

Ijade kọ: (Akojọ tuntun), ila-tuntun. 
Ijade kọ: (Atumọ-ede tuntun), ila-tuntun. 
