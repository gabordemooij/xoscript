# backslashes must survive code serialization, strings must not end early
>> awọn-iye := Akojọ tuntun
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

awọn-iye kọọkan: { :i :value
	>> d := Atumọ-ede tuntun.
	d fi: value si: ['k'].
	>> r := d koodu nkan.
	Ijade kọ: r iye-nọmba, ila-tuntun.
	Ijade kọ: ( (r ni: ['k']) = value ), ila-tuntun.
}.
