Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 
a nigbati: ['item:'] ṣe: { :int64
	tirẹ int64 := int64. 
}.
a nigbati: ['item'] ṣe: { <- tirẹ int64.
}.
a item: ( Int64 lati-ọrọ: ['9999'] ).
Ijade kọ: a item, ila-tuntun.
>> old-int64-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
(b item awoṣe-ipilẹ adirẹsi-iranti = old-int64-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
Ijade kọ: ( b item ), ila-tuntun.
