Ijade kọ: ['Continue for-loop, No - before 6 and up.'], ila-tuntun.
{ :i
	Ijade kọ: (i + 1), ila-tuntun.
	((i + 1) > 4) tẹsiwaju.
	Ijade kọ: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ijade ila-tuntun.
Ijade kọ: ['Continue while-true, No --> before 5 and up.'], ila-tuntun.
{
	Ijade kọ: ['iteration #'] + x, ila-tuntun.
	x fi-kun: 1.
	((x < 5) kii-ṣe) tẹsiwaju.
	Ijade kọ: ['-->'].
} nigba-ti: xIsLessThan10.
Ijade ila-tuntun.
Ijade kọ: ['Continue while-false, No - before 3 only.'], ila-tuntun.
{
	Ijade kọ: ['iteration #'] + x, ila-tuntun.
	x yọ: 1.
	(x = 3) tẹsiwaju.
	Ijade kọ: ['-'].
} nigba-ti: { <- ( x > 0). }.

Ijade ila-tuntun.
Ijade kọ: ['Continue times-loop, No ||| before 3.'], ila-tuntun.
{ :i
	Ijade kọ: ['iteration #'] + i, ila-tuntun.
	(i = 2) tẹsiwaju.
	Ijade kọ: ['|||'].
} × 5.

Ijade ila-tuntun.

{ Otitọ tẹsiwaju. Ijade kọ: ['dont write this!'], ila-tuntun. } bẹrẹ.

{ Otitọ tẹsiwaju. Ijade kọ: ['dont write this!'], ila-tuntun. } mu: { Ijade kọ: ['Dont catch this!']. }, bẹrẹ.

Ijade kọ: ['Test Array each-loop: 0, ... ,2'], ila-tuntun.
(Akojọ ← 1 ; 2 ; 3) yipada-kọọkan: { :i
	(i = 1) tẹsiwaju.
	Ijade kọ: ['iteration #'] + (i - 0), ila-tuntun.
}.

Ijade kọ: ['Test Map each-loop: c only'], ila-tuntun.
>> m := Atumọ-ede tuntun.
m fi: ['first'] si: ['a'], fi: ['second'] si: ['b'], fi: ['third'] si: ['c'].
m kọọkan: { :k :v
	(k ≠ ['c']) tẹsiwaju.
	Ijade kọ: ['iteration'] + k + v, ila-tuntun.
}.

