
Eto iṣakoso-iranti: 4.

>> Animal := Nkan tuntun.
Animal nigbati: ['make'] ṣe: {
	>> animal := Nkan tuntun.
	animal nigbati: ['makeSound'] ṣe: {
		Ijade kọ: tirẹ sound.
	}. <- animal.
}.
>> Cat := Nkan tuntun.
Cat nigbati: ['make'] ṣe: {
	>> cat := Animal make.
	cat nigbati: ['init'] ṣe: {
		tirẹ sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
