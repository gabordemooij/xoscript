

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

Nọmba nigbati: ['addNum:'] ṣe: { :x
	ara-rẹ fi-kun: x.
}.

Nọmba nigbati: ['subtractNum:'] ṣe: { :x
	ara-rẹ yọ: x.
}.

Nọmba nigbati: ['multiplyBy:'] ṣe: { :x
	ara-rẹ sọ-di-pupọ: x.
}.

Nọmba nigbati: ['divideBy:'] ṣe: { :x
	ara-rẹ pin-si: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 agbara: 8).  
a := a + (2 agbara: -1). 
a := a + (49 gbongbo-onigun).   
a addNum: ((Akojọ ← 0 ; 1) o-pọju).          
a addNum: ((Akojọ ← 2 ; 3) o-kere-ju).
Ijade kọ: a.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 agbara: 8).  
a := a + (2 agbara: -1). 
a := a + (49 gbongbo-onigun).   
a addNum: ((Akojọ ← 0 ; 1) o-pọju).          
a addNum: ((Akojọ ← 2 ; 3) o-kere-ju).
Ijade kọ: a.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 agbara: 8).  
a := a + (2 agbara: -1). 
a := a + (49 gbongbo-onigun).   
a addNum: ((Akojọ ← 0 ; 1) o-pọju).          
a addNum: ((Akojọ ← 2 ; 3) o-kere-ju).
Ijade kọ: a.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
