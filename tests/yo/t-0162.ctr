

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

>> f := Faili tuntun: ['/tmp/citrine_test_file.txt'].
f exists: { f paarẹ. }.
f kọ: ['hello world'].

Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 0).


f := Faili tuntun: ['/tmp/citrine_test_file.txt'].
f exists: { f paarẹ. }.
f kọ: ['hello world'].

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


f := Faili tuntun: ['/tmp/citrine_test_file.txt'].
f exists: { f paarẹ. }.
f kọ: ['hello world'].

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
