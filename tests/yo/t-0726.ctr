# test buffers PKI/Sign 
Server init.

>> long := ( Akojọ tuntun fọwọsi: 1000 pẹlu: ['a'] ) so-pọ: [''].

# sign a message
Ijade kọ: ( 
	Apoti-aabo buwọlu: ['abc'] pẹlu: long
), ila-tuntun.

Ijade kọ: ( 
	Apoti-aabo
		ṣayẹwo: ['abc'] 
		ibuwọlu: long 
		pẹlu: long
), ila-tuntun.

Ijade kọ: (
	Apoti-aabo haṣi-ọrọ-igbaniwọle: long jẹrisi: long
), ila-tuntun.
