>> t := Ofo.

# you can control the time zone for
# parsing like this:
Akoko agbegbe: ['CET'].
t := Akoko orisun: ['1981-02-03 04:05:06'].
Ijade kọ: t, ila-tuntun.

# now using CEST time zone:
Akoko agbegbe: ['CEST'].
t := Akoko orisun: ['1981-02-03 04:05:06'].
Ijade kọ: t, ila-tuntun.

# error if string cannot be parsed
{ Akoko orisun: ['1900']. } mu: { Ofo. }, bẹrẹ.
