


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.
>> palette := Ofo.
>> colors := Ofo.

{
palette := Atumọ-ede tuntun.
palette 
	fi: ['#F00'] si: ['red'],
	fi: ['#0F0'] si: ['green'],
	fi: ['#00F'] si: ['blue'].
Ijade kọ: ['number of RGB codes in palette: '] + ( palette iye-nọmba ), ila-tuntun.
Ijade kọ: ['RGB code of green is: '] + ( palette ? ['green'] ), ila-tuntun.
colors := [''].
( palette kọọkan: { :orukọ :koodu
		colors := colors + ( orukọ + [':'] + koodu ).
} ).
Ijade kọ: ['All colors in palette: '] + colors, ila-tuntun.
} bẹrẹ.
Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 0).

{
palette := Atumọ-ede tuntun.
palette 
	fi: ['#F00'] si: ['red'],
	fi: ['#0F0'] si: ['green'],
	fi: ['#00F'] si: ['blue'].
Ijade kọ: ['number of RGB codes in palette: '] + ( palette iye-nọmba ), ila-tuntun.
Ijade kọ: ['RGB code of green is: '] + ( palette ? ['green'] ), ila-tuntun.
colors := [''].
( palette kọọkan: { :orukọ :koodu
		colors := colors + ( orukọ + [':'] + koodu ).
} ).
Ijade kọ: ['All colors in palette: '] + colors, ila-tuntun.
} bẹrẹ.
Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).

{
palette := Atumọ-ede tuntun.
palette 
	fi: ['#F00'] si: ['red'],
	fi: ['#0F0'] si: ['green'],
	fi: ['#00F'] si: ['blue'].
Ijade kọ: ['number of RGB codes in palette: '] + ( palette iye-nọmba ), ila-tuntun.
Ijade kọ: ['RGB code of green is: '] + ( palette ? ['green'] ), ila-tuntun.
colors := [''].
( palette kọọkan: { :orukọ :koodu
		colors := colors + ( orukọ + [':'] + koodu ).
} ).
Ijade kọ: ['All colors in palette: '] + colors, ila-tuntun.
} bẹrẹ.
Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
