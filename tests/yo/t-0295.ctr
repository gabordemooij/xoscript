
>> dictionary := (
	Atumọ-ede tuntun
		fi: ['b'] si: ['a'],
		fi: ['a'] si: ['b'],
		fi: ['z'] si: ['x'],
		fi: ['hello'] si: ['hallo'],
		fi: ['human'] si: ['human']
).

>> comparisons := Akojọ tuntun.
dictionary kọọkan: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a afiwe: b)
	).
}.

comparisons to-lẹsẹsẹ: { :a :b <- ( a afiwe: b ). }.
Ijade kọ: ( comparisons so-pọ: ['↵'] ), ila-tuntun.
comparisons so-pọ: ['↵'].
