# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob tuntun: 8, bytes: (
	Akojọ tuntun ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Ijade kọ: ( utf16 tu-koodu: ['utf16le'] ), ila-tuntun.

utf16 tu-silẹ.
>> utf32 := Blob tuntun: 13, bytes: (
	Akojọ tuntun ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Ijade kọ: ( utf32 tu-koodu: ['utf32be'] ), ila-tuntun.
utf32 tu-silẹ.