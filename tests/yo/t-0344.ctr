# catch-all test (practical)
>> HTML := Ọrọ tuntun.
HTML nigbati: ['encode:'] ṣe: { :tekst
	ara-rẹ fi-kun-opin: (tekst
	rọpo: ['&'] pẹlu: ['&amp;'], 
	rọpo: ['<'] pẹlu: ['&lt;'],
	rọpo: ['>'] pẹlu: ['&gt;'],
	rọpo: ['"'] pẹlu: ['&quot;']).
}.
>> blog := HTML tuntun.
blog fi-kun-opin: ['<h1>'],
     encode: ['Koffie & Thee'],
     fi-kun-opin: ['</h1>'].
Ijade kọ: blog, ila-tuntun.


>> Roman := Nọmba tuntun.
Roman nigbati: ['stringy'] ṣe: {
	>> a := [''].
	{ a fi-kun-opin: ['I']. } × ara-rẹ. <- a.
}.

>> x := Roman tuntun.
x fi-kun: 3.
Ijade kọ: x stringy, ila-tuntun.

>> Quantum := Buliani tuntun.
Quantum nigbati: ['true?'] ṣe: { <- ['maybe True']. }.
Ijade kọ: (Quantum tuntun true?), ila-tuntun.

>> Nihil := Ofo tuntun.
Nihil nigbati: ['ọrọ'] ṣe: { <- ['Nihil']. }.
Ijade kọ: (Nihil tuntun), ila-tuntun.
