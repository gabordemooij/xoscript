Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['state:'] ṣe: { :list
	tirẹ list := list. 
}.

a nigbati: ['state'] ṣe: {
	Ijade kọ: tirẹ list, ila-tuntun.
}.

a state: ( Akojọ tuntun ; ['listitem'] ; ['item2'] ).
