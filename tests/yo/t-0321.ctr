# test qualifiers

Eto sọ-di-mimọ.

>> Fruit := Nkan tuntun.
Fruit nigbati: ['tuntun'] ṣe: {
	>> f := ara-rẹ tuntun.
	f apples: 0. <- f.
}.
Fruit nigbati: ['apples:'] ṣe: { :a tirẹ apples := a. }.
Fruit nigbati: ['apples'] ṣe: { <- tirẹ apples. }.
Fruit nigbati: ['+'] ṣe: { :f
	>> n := Fruit tuntun.
	n apples: (f apples + tirẹ apples). <- n.
}.
Nọmba nigbati: ['apples'] ṣe: { <- ((Fruit tuntun) apples: ara-rẹ).
}.

Fruit nigbati: ['ọrọ'] ṣe: { <- tirẹ apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ijade kọ: q, ila-tuntun.




q := 3 apples + 4 apples.
Ijade kọ: q, ila-tuntun.



q := 3 apples + 4 apples.
Ijade kọ: q, ila-tuntun.


