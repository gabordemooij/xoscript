>> str := ['write:'].
Ijade ifiranṣẹ: ['kọ:'] awọn-apa: (Akojọ ← ['Hello World']), ila-tuntun. 

Nọmba nigbati: ['isbetween:and:'] ṣe: { :a :b <- ((ara-rẹ ≥ a) ati: (ara-rẹ ≤ b)).
}.

str := ['isbetween:and:'].
Ijade kọ: (3 ifiranṣẹ: str awọn-apa: (Akojọ ← 2 ; 8)), ila-tuntun.
Ijade kọ: (3 ifiranṣẹ: str awọn-apa: (Akojọ ← 1 ; 2)), ila-tuntun.


>> CoffeeMachine := Nkan tuntun.
CoffeeMachine nigbati: ['makeCoffeeWithSugar:milk:'] ṣe: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Akojọ ← 4 ; 2.
Ijade kọ: ( CoffeeMachine ifiranṣẹ: order awọn-apa: coffeeConfiguration ), ila-tuntun.
