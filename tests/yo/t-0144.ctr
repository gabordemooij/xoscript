



>> CoffeeGrounds := Nkan tuntun.
CoffeeGrounds nigbati: ['extract'] ṣe: { <- ['coffee']. }.

>> CoffeeMachine := Nkan tuntun.
CoffeeMachine nigbati: ['init'] ṣe: {
	tirẹ coffeegrounds := CoffeeGrounds tuntun.
}.
CoffeeMachine nigbati: ['tuntun'] ṣe: { <- CoffeeMachine `new init.
}.

CoffeeMachine nigbati: ['makeTea'] ṣe: { <- (tirẹ tealeaves extract). }.
CoffeeMachine nigbati: ['makeCoffee'] ṣe: { <- (tirẹ coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine tuntun.

Ijade kọ:
	coffeeDream 
	makeCoffee.

Ijade kọ:
	coffeeDream 
	makeTea.
