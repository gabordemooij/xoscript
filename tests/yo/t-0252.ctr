#Linux
>> clock := Akoko tuntun.
clock agbegbe: ['UTC-1'].
clock ọdun: 1981, osù: 1, ọjọ: 5,
      wakati: 13, iseju: 15, iṣẹju-aaya: 13.

Ijade kọ: clock, ila-tuntun.
clock agbegbe: ['UTC+0'].

Ijade kọ: (
	(clock ọdun lasan) + ['-'] + (clock osù) + ['-'] + (clock ọjọ) + [' '] +
	(clock wakati) + [':'] + (clock iseju) + [':'] + (clock iṣẹju-aaya) + [' '] +
	['W'] + (clock ọsẹ) + (clock agbegbe)
), ila-tuntun.


clock agbegbe: ['UTC-1'].
Ijade kọ: (
	(clock ọdun lasan) + ['-'] + (clock osù) + ['-'] + (clock ọjọ) + [' '] +
	(clock wakati) + [':'] + (clock iseju) + [':'] + (clock iṣẹju-aaya) + [' '] +
	['W'] + (clock ọsẹ) + (clock agbegbe)
), ila-tuntun.
