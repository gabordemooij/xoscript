

# reference in world.c

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> koodu := {
	>> a := Atumọ-ede tuntun.
	>> b := Atumọ-ede tuntun.
	a sopọ: b.
	b sopọ: a.
}.
Eto iṣakoso-iranti: 0.
Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 0).
koodu bẹrẹ.
Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).
koodu bẹrẹ.
Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).
( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
