# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Apoti-aabo ṣẹda-kọkọrọ.

# private (secret) key
>> sk := keys akọkọ.

# public key
>> pk := keys ikẹhin.

# sign a message
>> sig := Apoti-aabo buwọlu: ['abc'] pẹlu: sk.

# check message (ok)
Ijade kọ: ( 
	Apoti-aabo
		ṣayẹwo: ['abc'] 
		ibuwọlu: sig 
		pẹlu: pk 
), ila-tuntun.

# check message (fail)
Ijade kọ: ( 
	Apoti-aabo 
		ṣayẹwo: ['abd'] 
		ibuwọlu: sig 
		pẹlu: pk 
), ila-tuntun.