Akojọ nigbati: ['ṣe-ẹda'] ṣe: {
	>> ṣe-ẹda := Akojọ tuntun.
	ara-rẹ kọọkan: { :nọmba :section
		ṣe-ẹda fi-kun-opin: section atunwi-ara ṣe-ẹda.
	}. <- ṣe-ẹda.
}.

>> sheep := Akojọ tuntun ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep ṣe-ẹda.
clones kọọkan: { :nọmba :sheep
	sheep fi-kun-opin: ['2'].
}.

Ijade kọ: sheep, ila-tuntun.
Ijade kọ: clones, ila-tuntun.
