Ijade kọ: ((Akojọ tuntun
	nigbati: ['plaque:'] ṣe: { :x tirẹ o := x. },
	nigbati: ['plaque']  ṣe: { <- tirẹ o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Akojọ ← 1)
	~ (Akojọ ← 1 ; 2)
	~ (Akojọ ← 1 ; 2 ; 3)
	~ (Akojọ ← 1 ; 2 ; 3 ; 4)
	~ (Akojọ ← 1 ; 2 ; 3 ; 4 ; 5)
) kọọkan: { :i :el
	{ Ijade kọ: iṣẹ-ṣiṣe-yii. } × el iye-nọmba.
	Ijade ila-tuntun.
}) plaque, ila-tuntun.


