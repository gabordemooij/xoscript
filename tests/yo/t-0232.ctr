>> Slurp := Nkan tuntun.

Slurp nigbati: ['tuntun'] ṣe: {
	tirẹ str := [''].
}.

Slurp nigbati: ['fesi:'] ṣe: { :blah
		(tirẹ str = ['']) otitọ: {
			tirẹ str fi-kun-opin: blah.
		}, bibẹkọ: {
			tirẹ str fi-kun-opin: [' '].
			tirẹ str fi-kun-opin: blah.
		}.
}.

Slurp nigbati: ['fesi:ati:'] ṣe: { :blah :blahah
		(blah gigun > 1) otitọ: {
			tirẹ str fi-kun-opin: (blah lati: 0 gigun: (blah gigun - 1)).
		}, bibẹkọ: {
			tirẹ str fi-kun-opin: blah.
		}.
		tirẹ str fi-kun-opin: [' '].
		tirẹ str fi-kun-opin: blahah.
}.

Slurp nigbati: ['obtain'] ṣe: {
	>> buffer := tirẹ str.
	tirẹ str := ['']. <- buffer.
}.


>> x := Slurp tuntun.
x + 3.
Ijade kọ: (x obtain), ila-tuntun.
x echo: ['Hello world'].
Ijade kọ: (x obtain), ila-tuntun.
x tellme: 123 and: 987.
Ijade kọ: (x obtain), ila-tuntun.
