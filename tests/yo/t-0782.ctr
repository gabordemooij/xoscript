Ijade kọ: ['Test object'], ila-tuntun.
>> cmd := Aṣẹ tuntun.
Ijade kọ: cmd ls /tmp, ila-tuntun.
>> old-cmd-address := cmd awoṣe-ipilẹ adirẹsi-iranti.
cmd save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
(b awoṣe-ipilẹ adirẹsi-iranti = old-cmd-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
Ijade kọ: b ls, ila-tuntun.


