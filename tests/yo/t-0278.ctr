>> To-Do := Nkan tuntun.

To-Do nigbati: ['tuntun'] ṣe: {
	tirẹ list := Akojọ tuntun.
}.

To-Do nigbati: ['nieuw'] ṣe: {
	tirẹ list := Akojọ tuntun.
}.

To-Do nigbati: ['+'] ṣe: { :task
	tirẹ list fi-kun-opin: task.
}.

To-Do nigbati: ['number of tasks?'] ṣe: { <-  tirẹ list iye-nọmba.
}.

>> todos := 
	To-Do tuntun 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ijade kọ: ['You have $ tasks to do'] $ todos number of tasks?.
