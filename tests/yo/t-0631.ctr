#ffi test


Server init.

Eto iṣakoso-iranti: 4.

# for this test you need set a path to libc (puts)
>> libname := Eto eto: ['FFITESTLIB'].



Server sopọ: (
 Akojọ tuntun ;
 libname ;
 ['puts'] ;
 ( Akojọ tuntun ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s tu-silẹ.

# test with struct

>> a := Blob tuntun: 8.
a bytes: (
	Akojọ <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Akojọ <<: ['int'], ; ['int']).

Server sopọ: (
	Akojọ <<: ['@structtest'], ;
	['@structtest'] ;
	(Akojọ <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Ijade kọ: ['Sum test:'] + (ffitest ffisum: a), ila-tuntun.

struct tu-struct-silẹ.
struct tu-silẹ.
a tu-silẹ.
