Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :nil
	tirẹ nil := nil. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ nil.
}.

a item: Ofo.

Ijade kọ: a item, ila-tuntun.

>> old-nil-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-nil-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

Ijade kọ: b item, ila-tuntun.
