Ijade kọ: ['1,2,3,4,5,6,7,8,9,A,'], ila-tuntun.
>> Scope := Nkan tuntun.
Scope nigbati: ['initialize:'] ṣe: { :x tirẹ property := x. }.
Scope nigbati: ['confirm'] ṣe: { Ijade kọ: [',']. }.
Scope nigbati: ['idanwo'] ṣe: {
	Ijade kọ: tirẹ property.
	ara-rẹ confirm.
	( 1 = 1 ) otitọ: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	( 1 = 0 ) irọ: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	>> y := 2. { Ijade kọ: tirẹ property. ara-rẹ confirm. } nigba-ti: { y yọ: 1. <- (y > 0). }.
	{ Ijade kọ: tirẹ property. ara-rẹ confirm. } × 1.
	(Akojọ ← 1) kọọkan: {  Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Atumọ-ede tuntun one: ['item']) kọọkan: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	{ 1 ÷ 0. } mu: { Ijade kọ: tirẹ property. ara-rẹ confirm. }, bẹrẹ.
	Ijade ila-tuntun.
}.
>> scope1 := Scope tuntun.
scope1 initialize: ['X'].
scope1 idanwo.
>> function := { 
	tirẹ property := ['Y'].
	Ijade kọ: tirẹ property.
	ara-rẹ confirm.
	( 1 = 1 ) otitọ: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	( 1 = 0 ) irọ: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	>> y := 2. { Ijade kọ: tirẹ property. ara-rẹ confirm. } nigba-ti: { y yọ: 1. <- (y > 0). }.
	{ Ijade kọ: tirẹ property. ara-rẹ confirm. } × 1.
	(Akojọ ← 1) kọọkan: {  Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Atumọ-ede tuntun one: ['item']) kọọkan: { Ijade kọ: tirẹ property. ara-rẹ confirm. }.
	{ 1 ÷ 0. } mu: { Ijade kọ: tirẹ property. ara-rẹ confirm. }, bẹrẹ.
	Ijade ila-tuntun.
}.
function nigbati: ['confirm'] ṣe: { Ijade kọ: [',']. }.
function mulo: 1 ati: 2.
