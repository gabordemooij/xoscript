
>> XX := Nkan tuntun.
>> X := Nkan tuntun.

XX nigbati: ['QQ'] ṣe: { <- 1. }.
XX nigbati: ['Q'] ṣe: { <- 1. }.
XX nigbati: ['QQ:'] ṣe: { <- 1. }.
XX nigbati: ['QQ:QQ:'] ṣe: { <- 1. }.

X nigbati: ['QQ'] ṣe: { <- 1. }.
X nigbati: ['Q'] ṣe: { <- 1. }.
X nigbati: ['QQ:'] ṣe: { <- 1. }.
X nigbati: ['QQ:QQ:'] ṣe: { <- 1. }.

Ijade kọ: (Eto XX), ila-tuntun.
Ijade kọ: (Eto ri: ['XX']), ila-tuntun.
Ijade kọ: (Eto ri: ['X']), ila-tuntun.

Ijade kọ: (Eto XX: ['QQ']), ila-tuntun.
Ijade kọ: (Eto XX: ['Q']), ila-tuntun.
Ijade kọ: (Eto XX: ['QQ:']), ila-tuntun.
Ijade kọ: (Eto XX: ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto X: ['QQ']), ila-tuntun.
Ijade kọ: (Eto X: ['Q']), ila-tuntun.
Ijade kọ: (Eto X: ['QQ:']), ila-tuntun.
Ijade kọ: (Eto X: ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto X ['QQ']), ila-tuntun.
Ijade kọ: (Eto X ['Q']), ila-tuntun.
Ijade kọ: (Eto X ['QQ:']), ila-tuntun.
Ijade kọ: (Eto X ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto YY), ila-tuntun.
Ijade kọ: (Eto ri: ['YY']), ila-tuntun.
Ijade kọ: (Eto ri: ['Y']), ila-tuntun.

Ijade kọ: (Eto YY: ['QQ']), ila-tuntun.
Ijade kọ: (Eto YY: ['Q']), ila-tuntun.
Ijade kọ: (Eto YY: ['QQ:']), ila-tuntun.
Ijade kọ: (Eto YY: ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto Y: ['QQ']), ila-tuntun.
Ijade kọ: (Eto Y: ['Q']), ila-tuntun.
Ijade kọ: (Eto Y: ['QQ:']), ila-tuntun.
Ijade kọ: (Eto Y: ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto Y ['QQ']), ila-tuntun.
Ijade kọ: (Eto Y ['Q']), ila-tuntun.
Ijade kọ: (Eto Y ['QQ:']), ila-tuntun.
Ijade kọ: (Eto Y ['QQ:QQ:']), ila-tuntun.

Ijade kọ: (Eto X: -1), ila-tuntun.
Ijade kọ: (Eto X Ofo), ila-tuntun.

