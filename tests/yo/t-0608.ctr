
>> Size := Nkan tuntun.
Size nigbati: ['is:'] ṣe: { :nọmba
	nọmba nigbati: ['+'] ṣe: { :nọmba
		>> unit := nọmba ẹyọ-iwọn.
		>> factor := 1.
		
		unit
		ti-o-ba: ['inch'] ṣe: { factor := 0.0833. }. <- ara-rẹ + (nọmba * factor).
	}. <- nọmba.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ijade kọ: plank + edge, ila-tuntun.
