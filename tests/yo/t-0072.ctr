>> echo := Nkan tuntun.
echo nigbati: ['fesi:'] ṣe: { :sound
	{ Ijade kọ: sound. } × 2.
}.
echo ho!. 


echo := Nkan tuntun.
echo nigbati: ['fesi:ati:'] ṣe: { :sound :x
	{ Ijade kọ: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Nkan tuntun.
echo nigbati: ['fesi:ati:ati:'] ṣe: { :operation :sound :x
	{ Ijade kọ: sound. } × x.
}.
echo shout: ['la'] times: 4. 


