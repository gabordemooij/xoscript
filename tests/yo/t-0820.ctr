# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Apẹrẹ tuntun: pattern.
	p ibamu: subject ṣe: { :m :g
		Ijade kọ: g iye-nọmba, kọ: [' '], kọ: (g so-pọ: ['|']), ila-tuntun. <- m.
	}.
}.
show mulo: ['(a)|(b)'] ati: ['b'].
show mulo: ['(a)|(b)'] ati: ['a'].
show mulo: ['(x)?y'] ati: ['y'].
show mulo: ['(x)?(y)(z)?'] ati: ['xy'].
