# test url parsing

Server init.
>> url := URL orisun: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Ijade kọ: ['scheme = '] + url ilana-adirẹsi, ila-tuntun.
Ijade kọ: ['host = '] + url agbalejo, ila-tuntun.
Ijade kọ: ['port = '] + url ibudo, ila-tuntun.
Ijade kọ: ['path = '] + url ọna-faili, ila-tuntun.
Ijade kọ: ['query = '] + url awọn-apa-iwadii, ila-tuntun.
Ijade kọ: ['fragment = '] + url ajẹkù, ila-tuntun.
