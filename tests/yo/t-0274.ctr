

Akojọ nigbati: ['column:'] ṣe: { :column
	>> result := Akojọ tuntun.
	ara-rẹ kọọkan: { :index :row
		row kọọkan: { :index :cell
			(index = column) otitọ: { result fi-kun-opin: cell. }.
		}.
	}. <- result.
}.


>> a := Akojọ ←
	(Akojọ ← 1 ; 2 ; 3) ;
	(Akojọ ← 4 ; 5 ; 6) ;
	(Akojọ ← 7 ; 8 ; 9).

>> b := a column: 1.
Ijade kọ: b, ila-tuntun.

b := a column: 20.
Ijade kọ: b, ila-tuntun.

b := a column: -100.
Ijade kọ: b, ila-tuntun.
