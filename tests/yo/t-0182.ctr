

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

>> txt := ['1.6'].
>> n := txt nọmba.
>> t := txt buliani.
Ijade kọ: n, ila-tuntun.
Ijade kọ: t, ila-tuntun.
Ijade kọ: n oriṣi, ila-tuntun.
Ijade kọ: t oriṣi, ila-tuntun.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


