# edge cases from a request must give an error or a result, not a crash
Server init.

Ijade kọ: ['<'] + (['abc'] lati: 0 gigun: 0, lẹta-nla) + ['>'], ila-tuntun.
Ijade kọ: ['<'] + (['abc'] lati: 0 gigun: 0, lẹta-kekere) + ['>'], ila-tuntun.
Ijade kọ: ['<'] + (['abc'] fo: 3, lẹta-nla) + ['>'], ila-tuntun.
Ijade kọ: [''] lẹta-nla bytes, ila-tuntun.
Ijade kọ: ['aB'] lẹta-nla, ila-tuntun.
Ijade kọ: ['aB'] lẹta-kekere, ila-tuntun.

Ijade kọ: (Akoko tuntun: 0) ọdun, ila-tuntun.
{ Akoko tuntun: ['9e300'] nọmba. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
{ Akoko tuntun: ['-9e300'] nọmba. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
{ Akoko tuntun: ['nan'] nọmba. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
{ Akoko tuntun: 9000000000000000000. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
