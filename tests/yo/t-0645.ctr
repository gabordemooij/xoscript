Server init.
Ijade kọ: ['Database date test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], 
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii :=
db ibeere: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
mu-wa: { :row
	Ijade kọ: row datetest, ila-tuntun.
}.
