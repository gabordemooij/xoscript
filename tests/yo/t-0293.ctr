
>> city := Akojọ ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Akojọ ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature gẹgẹ-bi: city.
>> cities := weather awọn-kọkọrọ to-lẹsẹsẹ: { :a :b <- (a afiwe: b). }.
>> temperatures := weather awọn-iye to-lẹsẹsẹ: { :a :b <- (a afiwe: b) odi?. }.

Ijade kọ: (cities so-pọ: [',']), ila-tuntun.
Ijade kọ: (temperatures so-pọ: [',']), ila-tuntun.
