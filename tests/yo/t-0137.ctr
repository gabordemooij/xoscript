


Eto iṣakoso-iranti: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Otitọ.
>> a := Akojọ ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Otitọ.
a := Akojọ ← 1 ; 2 ; 3 ; 5.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Otitọ.
a := Akojọ ← 1 ; 2 ; 3 ; 4.

Eto sọ-di-mimọ.
