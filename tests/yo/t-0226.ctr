# Test ASCII variants

# Numbers

Ijade kọ: (2 !=: 3), ila-tuntun.
Ijade kọ: (2 <=: 2), ila-tuntun.
Ijade kọ: (2 >=: 2), ila-tuntun.

# Strings

Ijade kọ: (['b'] >=: ['a']), ila-tuntun.
Ijade kọ: (['b'] !=: ['a']), ila-tuntun.
Ijade kọ: (['b'] <=: ['c']), ila-tuntun.

# Bools

Ijade kọ: (Otitọ !=: Irọ), ila-tuntun.

# Objects

Ijade kọ: (Nkan tuntun !=: Nkan tuntun), ila-tuntun.

# ASCII list symbol <-:

Ijade kọ: (Akojọ <<: 1, ; 2 ; 3) iye-nọmba = 3, ila-tuntun.

