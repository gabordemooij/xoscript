>> items := Atumọ-ede tuntun.
items fi: ['black'] si: ['coffee'], fi: ['earl grey'] si: ['tea'].
Ijade kọ: (items ni: ['coffee']), kọ: (items ni: ['tea']).
Ijade kọ: ['there are'] + items iye-nọmba + [' items in the array.'].
items fi: ['capuccino'] si: ['coffee'].
Ijade kọ: ['Now my coffee is.. '] + (items ni: ['coffee']).
items fi: ['aaa'] si: ['1'].
items fi: ['bbb'] si: ['2'].
Ijade kọ: (items ni: ['a']).
