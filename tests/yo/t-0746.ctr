Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :dict
	tirẹ dict := dict. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ dict.
}.

a item: (
Atumọ-ede tuntun
	hello: ['world'],
	world: (Atumọ-ede tuntun fi: ['a'] si: ['b'])).

Ijade kọ: a item, ila-tuntun.

>> old-dict-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.

>> b := Nkan load-from: ['/tmp/a.bin'].

(b item awoṣe-ipilẹ adirẹsi-iranti = old-dict-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.

Ijade kọ: b item, ila-tuntun.
