Server init.

>> DB := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'],
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> awọn-apa-iwadii := Ibeere-Maria tuntun: SQL.

# set database
awọn-apa-iwadii ibi-ipamọ-data: DB.

awọn-apa-iwadii mu-wa: { :row
	Ijade kọ: row world, ila-tuntun.
}.
