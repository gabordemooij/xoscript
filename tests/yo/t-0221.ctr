>> x := Nkan tuntun.
>> y := Nkan tuntun.
>> z := x.
Ijade kọ: (x = z), ila-tuntun.
Ijade kọ: (x = y), ila-tuntun.
Ijade kọ: (x ≠ y), ila-tuntun.
Ijade kọ: (x ≠ z), ila-tuntun.
>> m := Akoko tuntun ọdun: 2070, osù: 11.
>> n := m ṣe-ẹda.
Ijade kọ: (m = n), ila-tuntun.
Ijade kọ: (m ≠ n), ila-tuntun.
Ijade kọ: (m ọkan-naa: m), ila-tuntun.
Ijade kọ: (m ọkan-naa: n), ila-tuntun.
n osù: 12.
Ijade kọ: (m ≠ n), ila-tuntun.
Ijade kọ: (m = n), ila-tuntun.


