
>> countries := Akojọ tuntun
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Akojọ tuntun
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods gẹgẹ-bi: countries, kọọkan: { :key :value
	counter fi-kun: 1.
}.

Ijade kọ: (['we serve counter dishes'] counter: counter), ila-tuntun.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] awọn-lẹta to-lẹsẹsẹ: { :v
	counter fi-kun: 0.
}.

Ijade kọ: (['we sort counter dishes'] counter: counter), ila-tuntun.


>> counter := 0.
{
	{
		counter fi-kun: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ijade kọ: (['we calculate counter numbers.'] counter: counter), ila-tuntun.

