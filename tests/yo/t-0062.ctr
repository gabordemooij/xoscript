Buliani nigbati: ['xor:'] ṣe: { :a :b <- ((a ati: b kii-ṣe) tabi: (a kii-ṣe ati: b)).
}.

>> o := Nkan tuntun.
o nigbati: ['hello'] ṣe: { ['Empty']. }.
{ o nigbati: 2 ṣe: 3.} mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
{ o nigbati: ['idanwo'] ṣe: 3.} mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ.
{ o nigbati: ['hello'] ṣe: { ['Empty']. }.} mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ >> z := 4 ÷ 0. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ (Otitọ ati: Ofo) otitọ: { Ijade kọ: ['X'].}. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ ([''] xor: 0) otitọ: { Ijade kọ: ['X'].}. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ (1 < ['2']) otitọ: { Ijade kọ: ['OK']. }. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ (1 < ['2.0']) otitọ: { Ijade kọ: ['OK']. }. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ (1 < ['x2.0']) otitọ: { Ijade kọ: ['NO!']. }. } mu: { :e Ijade kọ: e, ila-tuntun. }, bẹrẹ. 
{ Ijade kọ: (['hello OK there'] lati: ['6'] gigun: ['2']). } bẹrẹ. 
