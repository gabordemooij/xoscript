Server init.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'],
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> del := db ibeere: ['DELETE FROM book WHERE id > 0'].
{  del ṣiṣẹ. db fidi-mulẹ. } mu: { :e db yi-pada-sẹhin.  }, bẹrẹ.

>> iye-nọmba := db ibeere: ['SELECT COUNT(*) AS num FROM book'].
iye-nọmba mu-wa: { :row Ijade kọ: row num, ila-tuntun. }.
