Nọmba nigbati: ['roman'] ṣe: {
	>> nọmba := ara-rẹ ṣe-ẹda.
	>> roman := [''].
	{
		{
			(nọmba ≥ 1000) otitọ: {
				roman fi-kun-opin: ['Ⅿ'].
				nọmba yọ: 1000.
			}, dawọ-duro.
		
			(nọmba ≥ 500) otitọ: {
				roman fi-kun-opin: ['Ⅾ'].
				nọmba yọ: 500.
			}, dawọ-duro.
		
			(nọmba ≥ 100) otitọ: {
				roman fi-kun-opin: ['Ⅽ'].
				nọmba yọ: 100.
			}, dawọ-duro.
		
			(nọmba ≥ 50) otitọ: {
				roman fi-kun-opin: ['Ⅼ'].
				nọmba yọ: 50.
			}, dawọ-duro.
		
			(nọmba ≥ 50) otitọ: {
				roman fi-kun-opin: ['Ⅼ'].
				nọmba yọ: 50.
			}, dawọ-duro.
		
			(nọmba ≥ 10) otitọ: {
				roman fi-kun-opin: ['Ⅹ'].
				nọmba yọ: 10.
			}, dawọ-duro.
			
			(nọmba ≥ 9) otitọ: {
				roman fi-kun-opin: ['Ⅸ'].
				nọmba yọ: 9.
			}, dawọ-duro.
			
			(nọmba ≥ 5) otitọ: {
				roman fi-kun-opin: ['Ⅴ'].
				nọmba yọ: 5.
			}, dawọ-duro.
			
			(nọmba ≥ 4) otitọ: {
				roman fi-kun-opin: ['Ⅳ'].
				nọmba yọ: 4.
			}, dawọ-duro.
			
			(nọmba ≥ 1) otitọ: {
				roman fi-kun-opin: ['Ⅰ'].
				nọmba yọ: 1.
			}, dawọ-duro.
		} ilana.
	} nigba-ti: { <- nọmba > 0. }. <- roman.
}.

Ijade kọ: 1 roman, ila-tuntun.
Ijade kọ: 2 roman, ila-tuntun.
Ijade kọ: 4 roman, ila-tuntun.
Ijade kọ: 8 roman, ila-tuntun.
Ijade kọ: 16 roman, ila-tuntun.
Ijade kọ: 32 roman, ila-tuntun.
Ijade kọ: 64 roman, ila-tuntun.
Ijade kọ: 128 roman, ila-tuntun.
Ijade kọ: 256 roman, ila-tuntun.
Ijade kọ: 1024 roman, ila-tuntun.
