

Akojọ nigbati: ['sum'] ṣe: {
	>> total := 0.
	ara-rẹ kọọkan: { :index :element
		total fi-kun: element.
	}. <- total.
}.

Akojọ nigbati: ['product'] ṣe: {
	>> total := 1.
	ara-rẹ kọọkan: { :index :element
		total sọ-di-pupọ: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

{

>> a := Akojọ ← ['hello'] ; ['world'] ; Otitọ ; Ofo ; 666.
a := a + ( Akojọ ← 1 ).
Ijade kọ: ( ['sum: '] + ( a sum ) ), ila-tuntun.
Ijade kọ: ( ['min: '] + ( a o-kere-ju ) ), ila-tuntun.
Ijade kọ: ( ['max: '] + ( a o-pọju ) ), ila-tuntun.
Ijade kọ: ( ['3rd: '] + ( a ? 2 ) ), ila-tuntun.
Ijade kọ: ( ['prd: '] + ( a product ) ), ila-tuntun.
a to-lẹsẹsẹ: { :a :b <- (b - a). }.
a kọọkan: { :i :e Ijade kọ: ( i - 0 ), ila-tuntun. }.

} bẹrẹ.

Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 0).


{

>> a := Akojọ ← ['hello'] ; ['world'] ; Otitọ ; Ofo ; 666.
a := a + ( Akojọ ← 1 ).
Ijade kọ: ( ['sum: '] + ( a sum ) ), ila-tuntun.
Ijade kọ: ( ['min: '] + ( a o-kere-ju ) ), ila-tuntun.
Ijade kọ: ( ['max: '] + ( a o-pọju ) ), ila-tuntun.
Ijade kọ: ( ['3rd: '] + ( a ? 2 ) ), ila-tuntun.
Ijade kọ: ( ['prd: '] + ( a product ) ), ila-tuntun.
a to-lẹsẹsẹ: { :a :b <- (b - a). }.
a kọọkan: { :i :e Ijade kọ: ( i - 0 ), ila-tuntun. }.

} bẹrẹ.



Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


{

>> a := Akojọ ← ['hello'] ; ['world'] ; Otitọ ; Ofo ; 666.
a := a + ( Akojọ ← 1 ).
Ijade kọ: ( ['sum: '] + ( a sum ) ), ila-tuntun.
Ijade kọ: ( ['min: '] + ( a o-kere-ju ) ), ila-tuntun.
Ijade kọ: ( ['max: '] + ( a o-pọju ) ), ila-tuntun.
Ijade kọ: ( ['3rd: '] + ( a ? 2 ) ), ila-tuntun.
Ijade kọ: ( ['prd: '] + ( a product ) ), ila-tuntun.
a to-lẹsẹsẹ: { :a :b <- (b - a). }.
a kọọkan: { :i :e Ijade kọ: ( i - 0 ), ila-tuntun. }.

} bẹrẹ.



Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).

( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
