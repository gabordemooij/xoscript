>> a := 3.
>> b := a ṣe-ẹda.
a yọ: 1.
Ijade kọ: [' a = '] + a.
Ijade kọ: [' b = '] + b.
a := 3.
b := a + 4.
Ijade kọ: [' a = '] + a.
Ijade kọ: [' b = '] + b.
>> x := 3.
>> y := x ṣe-ẹda.
x fi-kun: 10.
y yọ: 1.
Ijade kọ: [' x = '] + x.
Ijade kọ: [' y = '] + y.
>> q := Nkan tuntun.
q nigbati: ['setProperty:'] ṣe: { :x
	tirẹ prop := x.
}.
q nigbati: ['getProperty'] ṣe: { <- tirẹ prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ijade kọ: [' p = '] + (p getProperty).
