Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 

a nigbati: ['item:'] ṣe: { :moment
	tirẹ moment := moment. 
}.

a nigbati: ['item'] ṣe: { <- tirẹ moment.
}.

>> today := Akoko tuntun agbegbe: ['CEST'], ọdun: 2026, osù: 7.
a item: today.
Ijade kọ: a item, ila-tuntun.
a save-as: ['/tmp/a.bin'].

