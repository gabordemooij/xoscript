Server init.

>> DB := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'],
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ibeere: SQL.

# now you don't have to set DB
query2 mu-wa: { :row
	Ijade kọ: row world, ila-tuntun.
}.
