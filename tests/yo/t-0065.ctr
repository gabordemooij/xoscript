Nọmba nigbati: ['factorial'] ṣe: {
	>> total := 1.
	{ :index total sọ-di-pupọ: (ara-rẹ - (index)). } × ara-rẹ. <- total.
}.
>> Printer := Nkan tuntun.
Printer nigbati: ['print:and:'] ṣe: { :x :y
	Ijade kọ: ['a='] + x + [', b='] + y, ila-tuntun.
}.
>> a := 4.5. >> b := a yika-isalẹ.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a yika-soke.
Printer print: a and: b.
a := 4.5. b := a yika-isalẹ.
Printer print: a and: b.
a := 4.5. b := a yika.
Printer print: a and: b.
a := 4.2. b := a yika.
Printer print: a and: b.

Ijade kọ: (9 iyoku: 5), ila-tuntun.
Ijade kọ: -666 iye-pipe, ila-tuntun.
Ijade kọ: 49 gbongbo-onigun, ila-tuntun.
Ijade kọ: (2 agbara: 3), ila-tuntun.
>> l := (Akojọ ← 9 ; 6).
Ijade kọ: l o-kere-ju.

