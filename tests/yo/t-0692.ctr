Server init.

Ijade kọ: (
	Apẹrẹ tuntun: ['^\\w+$'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 0 match, fails on @ and .

Ijade kọ: (
	Apẹrẹ tuntun: ['^[^@]+@[^\.]+\.\\w+$'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match

Ijade kọ: (
	Apẹrẹ tuntun: ['[^@]+@[^\.]+\.\\w+'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match

Ijade kọ: (
	Apẹrẹ tuntun: ['([^@]+)@([^\.]+)\.\\w+'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match, groups dont matter

Ijade kọ: (
	Apẹrẹ tuntun: ['[a-z]'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 14 matches

Ijade kọ: (
	Apẹrẹ tuntun: ['.*'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match (all)

Ijade kọ: (
	Apẹrẹ tuntun: ['(.*)'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match (all)

Ijade kọ: (
	Apẹrẹ tuntun: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ibamu: ['test@example.com'] 
), ila-tuntun. # 1 match, prefix space optional, gets ignored