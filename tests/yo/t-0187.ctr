Nọmba nigbati: ['factorial'] ṣe: {
	>> total := 1.
	{ :index total sọ-di-pupọ: (ara-rẹ - index). } × ara-rẹ. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

{
2 exponent factorial.
Ijade kọ: (11 iyoku: 3), ila-tuntun.
Ijade kọ: (3.4 yika), ila-tuntun.
Ijade kọ: (7.1 yika-soke), ila-tuntun.
Ijade kọ: (7.9 yika-isalẹ), ila-tuntun.
}
bẹrẹ.

Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).

{
2 exponent factorial.
Ijade kọ: (11 iyoku: 3), ila-tuntun.
Ijade kọ: (3.4 yika), ila-tuntun.
Ijade kọ: (7.1 yika-soke), ila-tuntun.
Ijade kọ: (7.9 yika-isalẹ), ila-tuntun.
}
bẹrẹ.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


{
2 exponent factorial.
Ijade kọ: (11 iyoku: 3), ila-tuntun.
Ijade kọ: (3.4 yika), ila-tuntun.
Ijade kọ: (7.1 yika-soke), ila-tuntun.
Ijade kọ: (7.9 yika-isalẹ), ila-tuntun.
} bẹrẹ.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
