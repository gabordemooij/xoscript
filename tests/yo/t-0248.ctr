

Ọrọ nigbati: ['evaluate'] ṣe: {
	>> koodu := Faili tuntun: ['/tmp/eval.ctr'].
	koodu kọ: ara-rẹ ọrọ + ['.'].
	Eto lo: ['/tmp/eval.ctr'].
}.

>> a := (Akojọ ← (
	(Atumọ-ede tuntun)
		fi: ['domain'] si: ['mywebsite.com'],
		fi: (Akojọ ←
			((Atumọ-ede tuntun)
				fi: ['home'] si: ['title'],
				fi: ['<html></html>'] si: ['body'],
				fi: ['2017-01-01'] si: ['created']
			) ;
			((Atumọ-ede tuntun)
				fi: ['aboutus(c)'] si: ['title'],
				fi: ['<credits>Author Inc.</credits>'] si: ['body']
			)
		) si: ['pages']
	)
) ọrọ.

Ijade kọ: a oriṣi, ila-tuntun.
Ijade kọ: a, ila-tuntun.

>> b := Ofo.
(['b := '] + a) evaluate.
Ijade kọ: b ? 0 ? ['pages'] ? 1 ? ['body'], ila-tuntun.

>> c := b ? 0.
>> d := c ọrọ.
Ijade kọ: d oriṣi, ila-tuntun.

>> e := Ofo.
(['e := '] + d) evaluate.
Ijade kọ: e ? ['pages'] ? 0, ila-tuntun.
