# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Eto shell-escape: ['abc'].
Ijade kọ: c, ila-tuntun.
Ijade kọ: ( Eto eto-iṣẹ: ['echo '] + c ), ila-tuntun.

c := Eto shell-escape: ['a'b'c'].
Ijade kọ: c, ila-tuntun.
Ijade kọ: ( Eto eto-iṣẹ: ['echo '] + c ), ila-tuntun.

c := Eto shell-escape: ['a\'c'].
Ijade kọ: c, ila-tuntun.
Ijade kọ: ( Eto eto-iṣẹ: ['echo '] + c ), ila-tuntun.