>> t := Otitọ.
(t = Otitọ) otitọ: { Ijade kọ: ['T']. }.
(t = Irọ) otitọ: { Ijade kọ: ['F']. }.
Ijade kọ: ['|'].
>> t := Irọ.
(t = Otitọ) otitọ: { Ijade kọ: ['T']. }.
(t = Irọ) otitọ: { Ijade kọ: ['F']. }.
Ijade kọ: ['|'].
>> f := Otitọ.
(t = Otitọ ati: f = Irọ) otitọ: { Ijade kọ: ['T']. }.
(t = Irọ ati: f = Otitọ) otitọ: { Ijade kọ: ['F']. }.
Ijade kọ: ['|'].
>> n := Ofo.
(n Ofo?) otitọ: { Ijade kọ: ['T']. }.
(n Ofo?) irọ: { Ijade kọ: ['F']. }.
Ijade kọ: ['|'].
(f Boolean?) otitọ: { Ijade kọ: ['T']. }.
(f Boolean?) irọ: { Ijade kọ: ['F']. }.



