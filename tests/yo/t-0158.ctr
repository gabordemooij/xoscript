>> x := [' hallo '].

>> y := x lẹta-nla.
Ijade kọ: x, ila-tuntun.
Ijade kọ: (x ọkan-naa: y), ila-tuntun.

>> y := x lẹta-kekere.
Ijade kọ: x, ila-tuntun.
Ijade kọ: (x ọkan-naa: y), ila-tuntun.

>> y := x ge-alafo.
Ijade kọ: x, ila-tuntun.
Ijade kọ: (x ọkan-naa: y), ila-tuntun.

>> y := x fo: 1.
Ijade kọ: x, ila-tuntun.
Ijade kọ: (x ọkan-naa: y), ila-tuntun.

>> y := x lati: 1 gigun: 2.
Ijade kọ: x, ila-tuntun.
Ijade kọ: (x ọkan-naa: y), ila-tuntun.