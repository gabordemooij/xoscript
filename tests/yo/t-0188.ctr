

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Eto iṣakoso-iranti: 0.

{ :i Ijade kọ: i. } × 4.
Ijade ila-tuntun.
{ :i Ijade kọ: (4 - i). } × 4.
Ijade ila-tuntun.
( 1 > 2 ) irọ: { Ijade kọ: ['BLOCK 1'], ila-tuntun. }.
( 2 > 1 ) otitọ:  { Ijade kọ: ['BLOCK 2'], ila-tuntun. }.

>> i := 0.
{ Ijade kọ: i. i fi-kun: 1. } nigba-ti: { <- ( i < 3). }.
Ijade ila-tuntun.

i := 3.
{ Ijade kọ: i. i := i - 1. } nigba-ti: { <- ( i > 0). }.
Ijade ila-tuntun.


Eto sọ-di-mimọ.

usedMemory1 := (Eto iranti ? 0).


{ :i  Ijade kọ: i. } × 4.
Ijade ila-tuntun.
{ :i  Ijade kọ: (4 - i). } × 4.
Ijade ila-tuntun.
( 1 > 2 ) irọ: { Ijade kọ: ['BLOCK 1'], ila-tuntun. }.
( 2 > 1 ) otitọ:  { Ijade kọ: ['BLOCK 2'], ila-tuntun. }.

>> i := 0.
{ Ijade kọ: i. i fi-kun: 1. } nigba-ti: { <- ( i < 3). }.
Ijade ila-tuntun.

i := 3.
{ Ijade kọ: i. i := i - 1. } nigba-ti: { <- ( i > 0). }.
Ijade ila-tuntun.



Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 0).


{ :i Ijade kọ: i. } × 4.
Ijade ila-tuntun.
{ :i Ijade kọ: (4 - i). } × 4.
Ijade ila-tuntun.
( 1 > 2 ) irọ: { Ijade kọ: ['BLOCK 1'], ila-tuntun. }.
( 2 > 1 ) otitọ:  { Ijade kọ: ['BLOCK 2'], ila-tuntun. }.

>> i := 0.
{ Ijade kọ: i. i fi-kun: 1. } nigba-ti: { <- ( i < 3). }.
Ijade ila-tuntun.

i := 3.
{ Ijade kọ: i. i := i - 1. } nigba-ti: { <- ( i > 0). }.
Ijade ila-tuntun.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 0).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
