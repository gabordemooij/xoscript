# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Apoti-aabo 
	haṣi-ọrọ-igbaniwọle: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Apoti-aabo 
	haṣi-ọrọ-igbaniwọle: hash jẹrisi: a1.
	# fail 
>> b := Apoti-aabo
	haṣi-ọrọ-igbaniwọle: hash jẹrisi: a2.
	# ok!

Ijade kọ: a, ila-tuntun.
Ijade kọ: b, ila-tuntun.

