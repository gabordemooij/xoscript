>> invoice := Nkan tuntun.
invoice nigbati: ['bẹrẹ'] ṣe: {
        tirẹ nọmba := 0.
}.

invoice nigbati: ['nọmba'] ṣe: {
        tirẹ nọmba fi-kun: 1. <- tirẹ nọmba ṣe-ẹda.
}.

>> year-invoice := invoice tuntun.
year-invoice nigbati: ['start:'] ṣe: { :ọdun
	tirẹ nọmba := ọdun.
}.

year-invoice start: 202000.
Ijade kọ: year-invoice nọmba, ila-tuntun.
Ijade kọ: year-invoice nọmba, ila-tuntun.
