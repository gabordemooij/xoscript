
>> shop := (Atumọ-ede tuntun
	fi: ['magazine'] si: ['books'],
	fi: ['computer'] si: ['electronics'],
	fi: ['lipstick'] si: ['cosmetics']
).
Ijade kọ: (shop ni-ninu: ['computer']), ila-tuntun. 
Ijade kọ: (shop ni-ninu: ['sausage']), ila-tuntun. 
Ijade kọ: (shop ni-ninu: ['computers']), ila-tuntun. 
Ijade kọ: (shop ni-ninu: ['compute']), ila-tuntun. 
Ijade kọ: (shop ni-ninu: ['2computer']), ila-tuntun. 
