#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Apẹrẹ tuntun: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ibamu: subject ṣe: { :m :x
	Ijade kọ: m, ila-tuntun.
	Ijade kọ: x, ila-tuntun. <- ['XXX'].
}.
Ijade kọ: result, ila-tuntun.