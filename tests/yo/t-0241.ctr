

Ọrọ nigbati: ['evaluate'] ṣe: {
	>> koodu := Faili tuntun: ['/tmp/eval.ctr'].
	koodu kọ: (ara-rẹ ọrọ + ['.']).
	Eto lo: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Akojọ ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q ọrọ.
Ijade kọ: x, ila-tuntun.
>> y := Ofo.
(['y := '] + x ) evaluate.
Ijade kọ: y ? 0, ila-tuntun.

q := Atumọ-ede fi: ['\[''] si: ['\['quote\']'].
x := q ọrọ.
Ijade kọ: x, ila-tuntun.
y := Ofo.
(['y := '] + x ) evaluate.

>> q := (Atumọ-ede tuntun) fi:['\[''] si:['\['quote\[''].
Ijade kọ: y ? ['\['quote\']'], ila-tuntun.
