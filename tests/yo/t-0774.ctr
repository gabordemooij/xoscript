Ijade kọ: ['Test object'], ila-tuntun.
>> a := Nkan tuntun. 
a nigbati: ['item:'] ṣe: { :lst
	tirẹ lst := lst. 
}.
a nigbati: ['item'] ṣe: { <- tirẹ lst.
}.
a item: (
	Akojọ tuntun ; 1 ; (
		Akojọ tuntun ; ['a'] ; (
			Akojọ tuntun ; ( Akoko tuntun: 1 )
		) ; ( Int64 lati-ọrọ: ['321'] )
	)
).
Ijade kọ: a item, ila-tuntun.
>> old-lst-address := a item awoṣe-ipilẹ adirẹsi-iranti.
a save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
(b item awoṣe-ipilẹ adirẹsi-iranti = old-lst-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
Ijade kọ: ( b item ), ila-tuntun.
