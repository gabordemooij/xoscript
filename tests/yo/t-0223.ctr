>> x := Akoko tuntun.
x agbegbe: ['CEST'],
ọdun:2017,
osù:01,
ọjọ:10,
wakati: 10,
iseju: 0,
iṣẹju-aaya: 0.

Ijade kọ: x, ila-tuntun.

Ijade kọ: x asiko, ila-tuntun.

x fi-kun: 1 iṣẹju-aaya.
x fi-kun: 2 iseju.
x fi-kun: 3 wakati.
x fi-kun: 4 ọjọ.
x fi-kun: 1 osù.
x fi-kun: 6 ọdun.

Ijade kọ: x, ila-tuntun.

x yọ: 1 iṣẹju-aaya.
x yọ: 2 iseju.
x yọ: 3 wakati.
x yọ: 4 ọjọ.
x yọ: 1 osù.
x yọ: 6 ọdun.

Ijade kọ: x, ila-tuntun.

>> y := x ṣe-ẹda.
>> z := x.

Ijade kọ: y, ila-tuntun.
Ijade kọ: z, ila-tuntun.
Ijade kọ: (x agbegbe = y agbegbe), ila-tuntun.
Ijade kọ: (x asiko = y asiko), ila-tuntun.
Ijade kọ: (x = z), ila-tuntun.
Ijade kọ: x ọjọ-ti-ọdun, ila-tuntun.
Ijade kọ: x ọjọ-ọsẹ, ila-tuntun.
Ijade kọ: x ọsẹ, ila-tuntun.
