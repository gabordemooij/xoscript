Ijade kọ: ['Test object'], ila-tuntun.
>> l := Akojọ tuntun ; 1 ; ( Akojọ tuntun ; (Akoko tuntun: 1) ; (Int64 lati-ọrọ: ['321']) ; (Akojọ tuntun ; 3)).
Ijade kọ: l, ila-tuntun.
>> old-lst-address := l awoṣe-ipilẹ adirẹsi-iranti.
l save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
(b awoṣe-ipilẹ adirẹsi-iranti = old-lst-address) otitọ: {
	Ijade kọ: ['Object link re-attached.'], ila-tuntun.
}.
Ijade kọ: b, ila-tuntun.
