>> Greeter := Nkan tuntun.
Greeter nigbati: ['make'] ṣe: {
	>> greeter := Nkan tuntun.
	greeter nigbati: ['name:'] ṣe: { :orukọ
		Ijade kọ: ['setting a name'].
		tirẹ myName := orukọ.
	}.
	greeter nigbati: ['performGreeting'] ṣe: {
		Ijade kọ: ['Hello'].
		Ijade kọ: tirẹ myName.
	}.
	greeter nigbati: ['greet'] ṣe: {
		ara-rẹ performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
