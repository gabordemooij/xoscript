
Server init.
Ijade kọ: ['Database test'], ila-tuntun.

>> db := Maria-DB tuntun agbalejo: ['localhost'],
	orukọ-olumulo: ['xo'], 
	ọrọ-igbaniwọle: ['pass123'],
	orukọ-ibi-ipamọ: ['xobase'],
	sopọ-mọ.

>> awọn-apa-iwadii :=
db ibeere: ['SELECT UNHEX('CAFE') AS blobby'],
mu-wa: { :row
	Ijade kọ: ( row blobby lati: 0 gigun: 2 ), ila-tuntun.
	row blobby tu-silẹ.
}.
