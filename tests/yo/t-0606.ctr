>> Point := Nkan tuntun.
Point nigbati: ['x-coordinate:'] ṣe: { :x tirẹ x := x. }.
Point nigbati: ['y-coordinate:'] ṣe: { :y tirẹ y := y. }.
Point nigbati: ['x-coordinate']  ṣe: { <- tirẹ x ṣe-ẹda. }.
Point nigbati: ['y-coordinate']  ṣe: { <- tirẹ y ṣe-ẹda. }.

Point nigbati: ['='] ṣe: { :other <- ( tirẹ x = other x-coordinate
		 ati: tirẹ y = other y-coordinate ).
}.

>> pier := Point tuntun x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point tuntun x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point tuntun x-coordinate: 5, y-coordinate: 6.

Ijade kọ: pier = town-hall, ila-tuntun.
Ijade kọ: pier = restaurant, ila-tuntun.
