>> phrases := Akojọ tuntun
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kọọkan: { :_ :phrase 
	>> e := Server base64-ṣe-koodu: phrase.
	>> d := Server base64-tu-koodu: e.
	Ijade kọ: (
		message ṣe-ẹda ~encoded: e, ~decoded: d
	), ila-tuntun.
}.
