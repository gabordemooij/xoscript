
Server init.
>> rq := Ibeere-HTTP tuntun.
Ijade kọ: ['HTTP-GET d[]=']  + ( rq get-akojọ: ['d[]'] ), ila-tuntun. # GET
Ijade kọ: ['HTTP-GET f[]=']  + ( rq get-akojọ: ['f[]'] ), ila-tuntun. # GET
Ijade kọ: ['HTTP-POST e[]='] + ( rq post-akojọ: ['e[]'] ), ila-tuntun. # GET
Ijade kọ: ['HTTP-POST c=']   + ( rq post: ['c'] ), ila-tuntun. # GET
Ijade kọ: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), ila-tuntun. # GET
