>> winery := { <- (	Atumọ-ede tuntun
		fi: 2 si: ['merlot'],
		fi: 3 si: ['malbec'],
		fi: 4 si: ['syrah']
	).
}.

Ijade kọ: (((winery bẹrẹ) - ['nothing']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['merlot']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['malbec']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['syrah']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['merlot'] - ['malbec']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['merlot'] - ['syrah']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['malbec'] -['syrah']) iye-nọmba), ila-tuntun.
Ijade kọ: (((winery bẹrẹ) - ['malbec'] - ['syrah'] - ['merlot']) iye-nọmba), ila-tuntun.

