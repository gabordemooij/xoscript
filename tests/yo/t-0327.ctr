

Akojọ nigbati: ['fixture:'] ṣe: { :f
	tirẹ fixture := f.
}.

Akojọ nigbati: ['iye-nọmba'] ṣe: { <- tirẹ fixture.
}.

Akojọ nigbati: ['aantal'] ṣe: { <- tirẹ fixture.
}.


>> x := Ofo.
{

	x := ['hello'] 
	rọpo:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] lẹta: 2)
			)
		)
	pẹlu: (
		(['...hal'] + ['lo']) 
			lẹta-nla 
			lowecase 
			lẹta-nla 
			fo: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Akojọ ← 0 ; 1 ; 4; 9 ; (Akojọ ← 0 ; 3; 1) ; 4
							) ṣaaju-ikẹhin
						) ? 1
					) + 
					((Akojọ ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					iye-nọmba
				)
			)
	).

} × 10.
Ijade kọ: x, ila-tuntun.

