#Linux

 >> t := Akoko tuntun.
 
t agbegbe: ['Europe/Amsterdam'].
t ọdun: 2020, osù: 8, ọjọ: 2, wakati: 21, iseju: 2, iṣẹju-aaya: 1.

>> a := t wakati.
>> ams := t agbegbe.

t agbegbe: ['US/Hawaii'].
>> b := t wakati.
>> hw := t agbegbe.

Ijade
kọ: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		boya: ['later'] tabi: ['earlier']
	)
),
ila-tuntun.
 