60 × {
	>> x := (Nọmba random % 6) + 1.
	(x ≤ 6) irọ: { Ijade kọ: ['FAIL']. }.
	(x ≥0) irọ: { Ijade kọ: ['FAIL']. }.
	x := (Nọmba random % 3) + 1.
	(x < 3) irọ: { Ijade kọ: ['FAIL']. }.
	(x>-1) irọ: { Ijade kọ: ['FAIL']. }.
	x := ((Buliani flip) nọmba).
	(x = 0 tabi: x = 1) irọ: { Ijade kọ: ['FAIL']. }.
	x := ((Otitọ flip) nọmba).
	(x = 0 tabi: x = 1) irọ: { Ijade kọ: ['FAIL']. }.
	x := (Buliani flip boya: ['HEAD'] tabi: ['TAIL']).
	((x = ['HEAD']) tabi: (x = ['TAIL'])) irọ: { Ijade kọ: ['FAIL']. }.
}.
Ijade kọ: ['DONE'].

