
Akojọ nigbati: ['product'] ṣe: {
	>> total := 1.
	ara-rẹ kọọkan: { :index :element
		total sọ-di-pupọ: element.
	}. <- total.
}.

>> a := Akojọ ← 1 ; 2 ; 3.
Ijade kọ: a product, ila-tuntun.
Ijade kọ: (Akojọ ← 2 ; 4 ; 8) product, ila-tuntun. 
Ijade kọ: (Akojọ ← -2 ; 10) product, ila-tuntun. 
Ijade kọ: (Akojọ ← 0.5 ; -2) product, ila-tuntun. 
