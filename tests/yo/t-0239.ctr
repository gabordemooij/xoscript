	a nigbati: ['ọrọ'] ṣe: { <- (Atumọ-ede tuntun). }.
	a := [''] + a. 
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.



