Akojọ nigbati: ['sum'] ṣe: {
	>> total := 0.
	ara-rẹ kọọkan: { :index :element
		total fi-kun: element.
	}. <- total.
}.

>> a := Otitọ.



a nigbati: ['ọrọ'] ṣe: {
	>> answer := Ofo.
	( ara-rẹ = Otitọ ) otitọ: {
		answer := ['Yep'].
	}, bibẹkọ: {
		answer := ['Nope'].
	}. <- answer.
}.

a nigbati: ['nọmba'] ṣe: {
	>> answer := Ofo.
	( ara-rẹ = Otitọ ) otitọ: {
		answer := 10.
	}, bibẹkọ: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b nigbati: ['ọrọ'] ṣe: { <- ['Devil'].
}.

b nigbati: ['buliani'] ṣe: { <- Irọ.
}.


Ijade kọ: a, ila-tuntun.  
Ijade kọ: (90 + a), ila-tuntun. 
Ijade kọ: b, ila-tuntun. 
Ijade kọ: (Otitọ ati: b), ila-tuntun.

a := Akojọ ← ['hello'] ; ['world'] ; Otitọ ; Ofo ; 666. 
a := a + ( Akojọ ← 1 ).
Ijade kọ: a, ila-tuntun.
Ijade kọ: ((Atumọ-ede tuntun) fi: Ofo si: Ofo), ila-tuntun.
Ijade kọ: a sum, ila-tuntun. 


{
	a nigbati: ['ọrọ'] ṣe: { <- Ofo. }.
	a := [''] + a.
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.



{
	a nigbati: ['nọmba'] ṣe: { <- Ofo. }.
	a := 3 × a.
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.


{
	a nigbati: ['buliani'] ṣe: { <- Ofo. }.
	a := Otitọ ati: a. 
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.





{
	a nigbati: ['ọrọ'] ṣe: { <- Irọ. }.
	a := [''] + a.
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.



{
	a nigbati: ['nọmba'] ṣe: { <- Otitọ. }.
	a := 3 × a.
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.


{
	a nigbati: ['boolean'] ṣe: { <- 1. }.
	a := Otitọ ati: a.
} mu: { :error
	Ijade kọ: ['Error noted: '] + error, ila-tuntun.
}, bẹrẹ.





