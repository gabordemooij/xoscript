Ijade kọ: ['Test object'], ila-tuntun.
>> greeter := Nkan tuntun.
greeter nigbati: ['name:'] ṣe: { :orukọ
	tirẹ xname := orukọ. 
}.
greeter nigbati: ['greet'] ṣe: {
	Ijade kọ: ['Hello '] + tirẹ xname, ila-tuntun.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ijade kọ: ['========== RELOADING SNAP:'], ila-tuntun.
>> b := Nkan load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
