
>> g := ['global'].
{ >> g := ['local']. Ijade kọ: g, ila-tuntun. } bẹrẹ. 
Ijade kọ: g, ila-tuntun. 
>> message := ['Bye'].
>> Secret := Nkan tuntun.
Secret nigbati: ['idanwo'] ṣe: {
	>> message := ['Hello'].
	tirẹ message := ['World'].
	Ijade kọ: message + [' '] + tirẹ message, ila-tuntun.
}.
Secret idanwo.
