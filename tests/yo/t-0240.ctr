# test qualifiers

>> $ := Nkan tuntun.

$ nigbati: ['fesi:'] ṣe: { :x
	
	>> operation := x lẹta: 0.
	>> valuta := x lẹta: 1.
	>> money := x fo: 2.
	
	>> amount := 0.

	( operation = ['+'] ) otitọ: {
		( valuta = ['£'] ) otitọ: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ijade kọ: x, ila-tuntun.


>> Fruit := Nkan tuntun.

Fruit nigbati: ['tuntun'] ṣe: {
	>> f := ara-rẹ tuntun.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit nigbati: ['apples:'] ṣe: { :a tirẹ apples := a. }.
Fruit nigbati: ['oranges:'] ṣe: { :p tirẹ oranges := p. }.
Fruit nigbati: ['apples'] ṣe: { <- tirẹ apples. }.
Fruit nigbati: ['oranges'] ṣe: { <- tirẹ oranges. }.

Fruit nigbati: ['+'] ṣe: { :f
	
	>> n := Fruit tuntun.
	f fi-kun: 1.
	
	n apples: (f apples + tirẹ apples).
	n oranges:  (f oranges  + tirẹ oranges). <- n.
}.

Fruit nigbati: ['ọrọ'] ṣe: { <- ( tirẹ apples ọrọ + [' apples and '] + tirẹ oranges + [' oranges'] ).
}.

Nọmba nigbati: ['apples'] ṣe: { <- ((Fruit tuntun) apples: ara-rẹ).
}.

Nọmba nigbati: ['apple'] ṣe: { <- ((Fruit tuntun) apples: ara-rẹ).
}.

Nọmba nigbati: ['oranges'] ṣe: { <- ((Fruit tuntun) oranges: ara-rẹ).
}.




Ijade kọ: (1 apple + 3 oranges + 4 apples), ila-tuntun.


Ọrọ nigbati: ['twice'] ṣe: { <- ((ara-rẹ ọrọ) + (ara-rẹ ọrọ)).
}.



Ijade kọ: ['❤❤❤'] twice.



