

Eto iṣakoso-iranti: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Otitọ.
>> a := Akojọ ← 1 ; 2 ; 3 ; 4.
>> c := Nkan tuntun.
c nigbati: ['greet:'] ṣe: { Ijade kọ: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Eto sọ-di-mimọ.
>> usedMemory1 := (Eto iranti ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Otitọ.
a := Akojọ ← 1 ; 2 ; 3 ; 5.
c := Nkan tuntun.
c nigbati: ['greet:'] ṣe: { Ijade kọ: ['greet!']. }.


Eto sọ-di-mimọ.
>> usedMemory2 := (Eto iranti ? 0).




x := 2.
y := ['Hello'].
q := { ['']. }.
p := Otitọ.
a := Akojọ ← 1 ; 2 ; 3 ; 4.
c := Nkan tuntun.
c nigbati: ['greet:'] ṣe: { Ijade kọ: ['greet!']. }.

Eto sọ-di-mimọ.
>> usedMemory3 := (Eto iranti ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Otitọ.
a := Akojọ ← 1 ; 2 ; 3 ; 5.
c := Nkan tuntun.
c nigbati: ['greet:'] ṣe: { Ijade kọ: ['greet!']. }.
c := Nkan tuntun.
c nigbati: ['greet:'] ṣe: { Ijade kọ: ['a different greet!'], ila-tuntun. }.


Eto sọ-di-mimọ.
>> usedMemory4 := (Eto iranti ? 0).





x := 4.
y := ['Hello'].
