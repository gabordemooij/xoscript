Eto iṣakoso-iranti: 0.
Akojọ nigbati: ['sum'] ṣe: {
	>> total := 0.
	ara-rẹ kọọkan: { :index :element
		total fi-kun: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faili tuntun: ['/tmp/test.txt'].
f kọ: ['Lorem Ipsum'].
f ti.
  

f := Faili tuntun: ['/tmp/test.txt'].
>> text := f ka.
f ti.



Eto sọ-di-mimọ.
usedMemory1 := (Eto iranti ? 1).



f := Faili tuntun: ['/tmp/test.txt'].
text := f ka.
f ti.

Eto sọ-di-mimọ.
usedMemory2 := (Eto iranti ? 1).


f := Faili tuntun: ['/tmp/test.txt'].
text := f ka.
f ti.

Eto sọ-di-mimọ.
usedMemory3 := (Eto iranti ? 1).



( usedMemory1 = usedMemory2 ati: usedMemory1 = usedMemory3, ati: usedMemory2 = usedMemory3 ) otitọ: {
	Ijade kọ: ['No memory leaks here'].
}, irọ: {
	Ijade kọ: ['Leaking memory...'].
}.
