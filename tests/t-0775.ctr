Out write: ['Test object'], stop.
>> l := List new ; 1 ; ( List new ; (Moment new: 1) ; (Int64 from-string: ['321']) ; (List new ; 3)).
Out write: l, stop.
>> old-lst-address := l prototype memory-address.
l save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b prototype memory-address = old-lst-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.
Out write: b, stop.
