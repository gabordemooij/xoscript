>> Animal := वस्तु नयाँ.
Animal जब: ['make'] गर: {
	>> animal := वस्तु नयाँ.
	animal जब: ['makeSound'] गर: {
		आउटपुट लेख: आफ्नो sound.
	}. <- animal.
}.
>> Cat := वस्तु नयाँ.
Cat जब: ['make'] गर: {
	>> cat := Animal make.
	cat जब: ['init'] गर: {
		आफ्नो sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
