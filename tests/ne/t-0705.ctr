

>> obj := वस्तु नयाँ.

obj जब: ['greet'] गर: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj जब: ['task'] गर: {
	आफ्नो property := 123.
	{
		# try binds self/own to object instead of block
		आउटपुट लेख: आफू greet.
		आउटपुट लेख: आफ्नो property.
		1 / 0.
	} समात: {
		आउटपुट लेख: आफू greet.
		आउटपुट लेख: आफ्नो property.
		आउटपुट लेख: ['ok'].
	}, प्रयास.
}.

obj task.