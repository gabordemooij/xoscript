
पाठ जब: ['html'] गर: { <- (
		आफू
		बदल: ['&'] ले: ['&amp;'],
		बदल: ['<'] ले: ['&lt;'],
		बदल: ['>'] ले: ['&gt;'],
		बदल: ['"'] ले: ['&quot;']
	).
}.

>> HtmlBrush := वस्तु नयाँ.

HtmlBrush जब: ['जवाफ:'] गर: { :tag
	आउटपुट लेख: (['<tag>↵'] tag: tag ).
}.

HtmlBrush जब: ['जवाफ:र:'] गर: { :tag :content
	tag := ( tag सुरु: 0 लम्बाइ: (tag लम्बाइ - 1) ).
	आउटपुट लेख: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush जब: ['content:'] गर: { :text
	आउटपुट लेख: text html, नयाँ-पङ्क्ति.
}.

HtmlBrush जब: ['attr:value:'] गर: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush नयाँ.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
