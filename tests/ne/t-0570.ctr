#Linux

 >> t := क्षण नयाँ.
 
t समय-क्षेत्र: ['Europe/Amsterdam'].
t वर्ष: 2020, महिना: 8, दिन: 2, घण्टा: 21, मिनेट: 2, सेकेन्ड: 1.

>> a := t घण्टा.
>> ams := t समय-क्षेत्र.

t समय-क्षेत्र: ['US/Hawaii'].
>> b := t घण्टा.
>> hw := t समय-क्षेत्र.

आउटपुट
लेख: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		यो: ['later'] नत्र-त्यो: ['earlier']
	)
),
नयाँ-पङ्क्ति.
 