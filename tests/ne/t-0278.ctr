>> To-Do := वस्तु नयाँ.

To-Do जब: ['नयाँ'] गर: {
	आफ्नो list := तालिका नयाँ.
}.

To-Do जब: ['nieuw'] गर: {
	आफ्नो list := तालिका नयाँ.
}.

To-Do जब: ['+'] गर: { :task
	आफ्नो list अन्त्यमा-थप: task.
}.

To-Do जब: ['number of tasks?'] गर: { <-  आफ्नो list गन्ती.
}.

>> todos := 
	To-Do नयाँ 
	+ ['cook dinner'] 
	+ ['clean room'].
	
आउटपुट लेख: ['You have $ tasks to do'] $ todos number of tasks?.
