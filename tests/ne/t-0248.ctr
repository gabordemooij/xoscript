

पाठ जब: ['evaluate'] गर: {
	>> कोड := फाइल नयाँ: ['/tmp/eval.ctr'].
	कोड लेख: आफू पाठमा + ['.'].
	प्रोग्राम प्रयोग: ['/tmp/eval.ctr'].
}.

>> a := (तालिका ← (
	(शब्दकोश नयाँ)
		राख: ['domain'] साँचो: ['mywebsite.com'],
		राख: (तालिका ←
			((शब्दकोश नयाँ)
				राख: ['home'] साँचो: ['title'],
				राख: ['<html></html>'] साँचो: ['body'],
				राख: ['2017-01-01'] साँचो: ['created']
			) ;
			((शब्दकोश नयाँ)
				राख: ['aboutus(c)'] साँचो: ['title'],
				राख: ['<credits>Author Inc.</credits>'] साँचो: ['body']
			)
		) साँचो: ['pages']
	)
) पाठमा.

आउटपुट लेख: a प्रकार, नयाँ-पङ्क्ति.
आउटपुट लेख: a, नयाँ-पङ्क्ति.

>> b := शून्य.
(['b := '] + a) evaluate.
आउटपुट लेख: b ? 0 ? ['pages'] ? 1 ? ['body'], नयाँ-पङ्क्ति.

>> c := b ? 0.
>> d := c पाठमा.
आउटपुट लेख: d प्रकार, नयाँ-पङ्क्ति.

>> e := शून्य.
(['e := '] + d) evaluate.
आउटपुट लेख: e ? ['pages'] ? 0, नयाँ-पङ्क्ति.
