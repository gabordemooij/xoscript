#Linux
>> OS := प्रोग्राम सेटिङ: ['OS'].

>> clock := क्षण नयाँ.
	
(OS = ['Haiku']) सत्य-भए: {
	clock समय-क्षेत्र: ['CET'],
	वर्ष: 2017, महिना: 7, दिन: 13,
	घण्टा: 18, मिनेट: 0, सेकेन्ड: 0.
}, नत्र: {
	clock समय-क्षेत्र: ['Europe/Amsterdam'],
	वर्ष: 2017, महिना: 7, दिन: 13,
	घण्टा: 18, मिनेट: 0, सेकेन्ड: 0.
}.

clock जब: ['tell'] गर: {
	आउटपुट लेख: आफू, नयाँ-पङ्क्ति.
}.


clock थप: 2    घण्टा, tell.
clock थप: 1    घण्टा, tell.
clock थप: 19 मिनेट, tell.
clock थप: 1  मिनेट, tell.
clock थप: 1  मिनेट, tell.
clock थप: 19 सेकेन्ड, tell.
clock थप: 1  सेकेन्ड, tell.
clock थप: 1  सेकेन्ड, tell.
clock थप: 2    वर्ष, tell.
clock थप: 1    वर्ष, tell.

(OS = ['Haiku']) सत्य-भए: {
clock थप: 5   महिना.
clock समय-क्षेत्र: ['CEST'], tell.
}, नत्र: {
	clock थप: 5   महिना, tell.
}.

clock थप: 1   महिना, tell.
clock थप: 19    दिन, tell.
clock थप: 1    घण्टा, tell.
clock थप: 120  yard, tell.
