>> randomizer := { :a :b
	>> न्यूनतम := ( a < b ) यो: a नत्र-त्यो: b.
	>> अधिकतम := ( a > b ) यो: a नत्र-त्यो: b.
	>> x := शून्य.
	{
		x := सङ्ख्या बीच: a र: b.
		((x < न्यूनतम) वा: (x > अधिकतम)) सत्य-भए: { 
			आउटपुट लेख: (['Invalid value!']).
			प्रोग्राम अन्त्य.
		}.
	} 
	× 100. <- x.
}.
randomizer लागू: 0 र: 0.
