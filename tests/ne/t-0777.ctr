#OBSD
>> dirname := [''].
{ dirname अन्त्यमा-थप: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
प्रोग्राम प्रणाली: command.
प्रोग्राम chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename अन्त्यमा-थप: ['YYYYYYYY']. } * 20.
फाइल नयाँ: filename, लेख: ['sometext'].
{ फाइल सूची: ['/tmp/'] + dirname. } * 1000.
आउटपुट लेख: ['no crash'], नयाँ-पङ्क्ति.

