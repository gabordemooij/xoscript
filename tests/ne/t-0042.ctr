>> items := शब्दकोश नयाँ.
items राख: ['black'] साँचो: ['coffee'], राख: ['earl grey'] साँचो: ['tea'].
आउटपुट लेख: (items मा: ['coffee']), लेख: (items मा: ['tea']).
आउटपुट लेख: ['there are'] + items गन्ती + [' items in the array.'].
items राख: ['capuccino'] साँचो: ['coffee'].
आउटपुट लेख: ['Now my coffee is.. '] + (items मा: ['coffee']).
items राख: ['aaa'] साँचो: ['1'].
items राख: ['bbb'] साँचो: ['2'].
आउटपुट लेख: (items मा: ['a']).
