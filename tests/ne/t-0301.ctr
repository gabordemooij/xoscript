


>> wine := वस्तु नयाँ.


wine जब: ['toString'] गर: { <- ['merlot'].
}.

wine जब: ['naarTekst'] गर: { <- ['merlot'].
}.


wine जब: ['='] गर: { :other wine <- ( आफू toString = other wine ).
}.

wine जब: ['=='] गर: { :other wine <- ( आफू toString = other wine ).
}.



wine
	अवस्था: ['cabernet'] गर: { आउटपुट लेख: ['it's a Cabernet!']. },
	अवस्था: ['syrah']    गर: { आउटपुट लेख: ['it's a Syrah!'].    },
	अवस्था: ['merlot']   गर: { आउटपुट लेख: ['it's a Merlot!'].   },
	अवस्था: ['malbec']   गर: { आउटपुट लेख: ['it's a Malbec!'].   }.

आउटपुट नयाँ-पङ्क्ति.
