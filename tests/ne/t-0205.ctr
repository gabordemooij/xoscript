>> str := ['write:'].
आउटपुट सन्देश: ['लेख:'] तर्कहरू: (तालिका ← ['Hello World']), नयाँ-पङ्क्ति. 

सङ्ख्या जब: ['isbetween:and:'] गर: { :a :b <- ((आफू ≥ a) र: (आफू ≤ b)).
}.

str := ['isbetween:and:'].
आउटपुट लेख: (3 सन्देश: str तर्कहरू: (तालिका ← 2 ; 8)), नयाँ-पङ्क्ति.
आउटपुट लेख: (3 सन्देश: str तर्कहरू: (तालिका ← 1 ; 2)), नयाँ-पङ्क्ति.


>> CoffeeMachine := वस्तु नयाँ.
CoffeeMachine जब: ['makeCoffeeWithSugar:milk:'] गर: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := तालिका ← 4 ; 2.
आउटपुट लेख: ( CoffeeMachine सन्देश: order तर्कहरू: coffeeConfiguration ), नयाँ-पङ्क्ति.
