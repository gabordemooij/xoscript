सङ्ख्या जब: ['factorial'] गर: {
	>> total := 1.
	{ :index total गुणन: (आफू - (index)). } × आफू. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
आउटपुट लेख: a.
>> b := 2 + 3 factorial.
आउटपुट लेख: b.
>> c := 3 factorial + 2.
आउटपुट लेख: c.
>> d := 2 + (3 factorial).
आउटपुट लेख: d.
आउटपुट लेख: 2 + 3 factorial + 1.
