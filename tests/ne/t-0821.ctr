# a quote that never closes must give an error, not an endless loop
>> फाइल-बाटो := ['/tmp/test0821.csv'].
>> file := फाइल नयाँ: फाइल-बाटो.

file लेख: ['a,b\n"1,2\n'].
{
	file विभाजक: [','] उद्धरण: ['"'] पङ्क्तिहरू: { :line
		आउटपुट लेख: line, नयाँ-पङ्क्ति.
	}.
} समात: { :e आउटपुट लेख: e, नयाँ-पङ्क्ति. }, चलाऊ.

# a closed quote still works
file लेख: ['a,b\n"1,2",3'].
file विभाजक: [','] उद्धरण: ['"'] पङ्क्तिहरू: { :line
	आउटपुट लेख: line, नयाँ-पङ्क्ति.
}.
file मेट.
