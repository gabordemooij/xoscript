#Linux
>> clock := क्षण नयाँ.
clock समय-क्षेत्र: ['UTC-1'].
clock वर्ष: 1981, महिना: 1, दिन: 5,
      घण्टा: 13, मिनेट: 15, सेकेन्ड: 13.

आउटपुट लेख: clock, नयाँ-पङ्क्ति.
clock समय-क्षेत्र: ['UTC+0'].

आउटपुट लेख: (
	(clock वर्ष सादा) + ['-'] + (clock महिना) + ['-'] + (clock दिन) + [' '] +
	(clock घण्टा) + [':'] + (clock मिनेट) + [':'] + (clock सेकेन्ड) + [' '] +
	['W'] + (clock हप्ता) + (clock समय-क्षेत्र)
), नयाँ-पङ्क्ति.


clock समय-क्षेत्र: ['UTC-1'].
आउटपुट लेख: (
	(clock वर्ष सादा) + ['-'] + (clock महिना) + ['-'] + (clock दिन) + [' '] +
	(clock घण्टा) + [':'] + (clock मिनेट) + [':'] + (clock सेकेन्ड) + [' '] +
	['W'] + (clock हप्ता) + (clock समय-क्षेत्र)
), नयाँ-पङ्क्ति.
