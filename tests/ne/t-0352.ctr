सङ्ख्या जब: ['roman'] गर: {
	>> सङ्ख्यामा := आफू प्रतिलिपि.
	>> roman := [''].
	{
		{
			(सङ्ख्यामा ≥ 1000) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅿ'].
				सङ्ख्यामा घटाऊ: 1000.
			}, रोक.
		
			(सङ्ख्यामा ≥ 500) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅾ'].
				सङ्ख्यामा घटाऊ: 500.
			}, रोक.
		
			(सङ्ख्यामा ≥ 100) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅽ'].
				सङ्ख्यामा घटाऊ: 100.
			}, रोक.
		
			(सङ्ख्यामा ≥ 50) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅼ'].
				सङ्ख्यामा घटाऊ: 50.
			}, रोक.
		
			(सङ्ख्यामा ≥ 50) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅼ'].
				सङ्ख्यामा घटाऊ: 50.
			}, रोक.
		
			(सङ्ख्यामा ≥ 10) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅹ'].
				सङ्ख्यामा घटाऊ: 10.
			}, रोक.
			
			(सङ्ख्यामा ≥ 9) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅸ'].
				सङ्ख्यामा घटाऊ: 9.
			}, रोक.
			
			(सङ्ख्यामा ≥ 5) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅴ'].
				सङ्ख्यामा घटाऊ: 5.
			}, रोक.
			
			(सङ्ख्यामा ≥ 4) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅳ'].
				सङ्ख्यामा घटाऊ: 4.
			}, रोक.
			
			(सङ्ख्यामा ≥ 1) सत्य-भए: {
				roman अन्त्यमा-थप: ['Ⅰ'].
				सङ्ख्यामा घटाऊ: 1.
			}, रोक.
		} कार्यविधि.
	} जबसम्म: { <- सङ्ख्यामा > 0. }. <- roman.
}.

आउटपुट लेख: 1 roman, नयाँ-पङ्क्ति.
आउटपुट लेख: 2 roman, नयाँ-पङ्क्ति.
आउटपुट लेख: 4 roman, नयाँ-पङ्क्ति.
