# a value ending in the first part of an opening quote must survive serialization
>> मानहरू := तालिका नयाँ
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

मानहरू प्रत्येक: { :i :value
	>> d := शब्दकोश नयाँ.
	d राख: value साँचो: ['k'].
	d राख: ['second'] साँचो: ['j'].
	>> r := d कोड वस्तुमा.
	आउटपुट लेख: r गन्ती, नयाँ-पङ्क्ति.
	आउटपुट लेख: ( (r मा: ['k']) = value ), नयाँ-पङ्क्ति.
}.
