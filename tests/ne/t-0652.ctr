# test number -> string -> number
{

	>> x := सङ्ख्या बीच: 0 र: 1000000.
	>> d := सङ्ख्या बीच: 1 र: 7.
	>> e := 10 घात: d.

	x भाग: e.
	>> y := x पाठमा सङ्ख्यामा.

	(x = y) असत्य-भए: {
		आउटपुट लेख: x, नयाँ-पङ्क्ति.
		आउटपुट लेख: y, नयाँ-पङ्क्ति.
		प्रोग्राम अन्त्य.
	}.

} * 1000.
आउटपुट लेख: ['OK'], नयाँ-पङ्क्ति.