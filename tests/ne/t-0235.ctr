>> Slurp := वस्तु नयाँ.
Slurp जब: ['नयाँ'] गर: {
	आफ्नो str := [''].
}.

Slurp जब: ['जवाफ:'] गर: { :blah
		(आफ्नो str ≠ ['']) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: [' '].
		}.
		आफ्नो str अन्त्यमा-थप: blah.
}.
Slurp जब: ['जवाफ:र:'] गर: { :blah :blahah
		(आफ्नो str ≠ ['']) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: [' '].
		}.
		(blah लम्बाइ > 1) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: (blah सुरु: 0 लम्बाइ: (blah लम्बाइ - 1)).
		}, नत्र: {
			आफ्नो str अन्त्यमा-थप: blah.
		}.
		आफ्नो str अन्त्यमा-थप: [' '].
		आफ्नो str अन्त्यमा-थप: blahah.
}.
Slurp जब: ['obtain'] गर: {
	>> buffer := आफ्नो str.
	आफ्नो str := ['']. <- buffer.
}.

>> s := Slurp नयाँ.
s hello: ['world'].
आउटपुट लेख: ( s obtain ), नयाँ-पङ्क्ति.
