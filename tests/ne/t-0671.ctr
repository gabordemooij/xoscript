# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := ढुकुटी साँचा-बनाऊ.

# private (secret) key
>> sk := keys पहिलो.

# public key
>> pk := keys अन्तिम.

# sign a message
>> sig := ढुकुटी हस्ताक्षर: ['abc'] साँचोले: sk.

# check message (ok)
आउटपुट लेख: ( 
	ढुकुटी
		जाँच: ['abc'] 
		हस्ताक्षर: sig 
		साँचोले: pk 
), नयाँ-पङ्क्ति.

# check message (fail)
आउटपुट लेख: ( 
	ढुकुटी 
		जाँच: ['abd'] 
		हस्ताक्षर: sig 
		साँचोले: pk 
), नयाँ-पङ्क्ति.