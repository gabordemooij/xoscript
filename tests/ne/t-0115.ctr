{
	यो-कार्य त्रुटि: ['Dont fail.'].
	unknown doSomething.
} समात: {
	आउटपुट लेख: ['Caught!'].
}, चलाऊ.

{
	यो-कार्य त्रुटि: ['Dont fail.'].
	आफ्नो unknown doSomething.
} समात: {
	आउटपुट लेख: ['Caught!'].
}, चलाऊ.

{
	यो-कार्य त्रुटि: ['Dont fail.'].
	unknown := 122.
} समात: {
	आउटपुट लेख: ['Caught!'].
}, चलाऊ.


{
	यो-कार्य त्रुटि: ['Dont fail.'].
	सत्य रोक.
	आउटपुट लेख: ['FAIL'].
} समात: {
	आउटपुट लेख: ['Caught!'].
}, चलाऊ.

{
	{
		यो-कार्य त्रुटि: ['Dont fail.'].
		सत्य रोक.
		आउटपुट लेख: ['FAIL'].
	} समात: { :x
		(x = ['Dont fail.']) सत्य-भए: { यो-कार्य त्रुटि: ['Nested Caught!']. }.
	}, चलाऊ.
} समात: { :e
	आउटपुट लेख: e.
}, चलाऊ.
