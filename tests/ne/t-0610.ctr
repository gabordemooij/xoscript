
>> Rectangle := वस्तु नयाँ.

Rectangle जब: ['area'] गर: { <- आफ्नो लम्बाइ * आफ्नो width.
}.

Rectangle जब: ['length:'] गर: { :लम्बाइ
	आफ्नो लम्बाइ := लम्बाइ.
}.

Rectangle जब: ['width:'] गर: { :width
	आफ्नो width := width.
}.

Rectangle जब: ['नयाँ'] गर: {
	# this will not result into an infinite loop
	>> rectangle := आफू नयाँ.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle नयाँ.
आउटपुट लेख: a area, नयाँ-पङ्क्ति. #0

>> b := Rectangle नयाँ length: 2, width: 3.
आउटपुट लेख: b area, नयाँ-पङ्क्ति. #6

