# a format must fit the type of the value, the type can come from a client
>> प्रयास := { :format :value
	{ आउटपुट लेख: ( (ढाँचा नयाँ: format) लागू: value ), नयाँ-पङ्क्ति. } समात: { :e आउटपुट लेख: e, नयाँ-पङ्क्ति. }, चलाऊ.
}.
>> try-int := { :format :value
	{ आउटपुट लेख: ( (ढाँचा नयाँ: format) लागू-पूर्णाङ्क: value ), नयाँ-पङ्क्ति. } समात: { :e आउटपुट लेख: e, नयाँ-पङ्क्ति. }, चलाऊ.
}.

# fits
प्रयास लागू: ['|%s|'] र: ['text'].
प्रयास लागू: ['%06.2f'] र: 5.5.
प्रयास लागू: ['100%% %s'] र: ['sure'].
try-int लागू: ['%03d'] र: 7.
try-int लागू: ['%x'] र: 255.
प्रयास लागू: ['%d'] र: (Int64 नयाँ पाठबाट: ['12']).
प्रयास लागू: ['%lld'] र: (Int64 नयाँ पाठबाट: ['12']).
प्रयास लागू: ['%.1lf'] र: 5.5.
try-int लागू: ['%hd'] र: 7.

# does not fit
प्रयास लागू: ['%s'] र: 12345.
प्रयास लागू: ['%d'] र: 12345.
प्रयास लागू: ['%f'] र: ['text'].
try-int लागू: ['%d'] र: ['text'].
try-int लागू: ['%s'] र: 5.
प्रयास लागू: ['%s %s'] र: ['text'].
प्रयास लागू: ['%n'] र: ['text'].
प्रयास लागू: ['%*s'] र: ['text'].
प्रयास लागू: ['%'] र: ['text'].

# length modifier does not fit
प्रयास लागू: ['%ls'] र: ['text'].
प्रयास लागू: ['%Lf'] र: 5.5.
try-int लागू: ['%ld'] र: 7.
try-int लागू: ['%lld'] र: 7.
प्रयास लागू: ['%Ld'] र: (Int64 नयाँ पाठबाट: ['12']).

# a width that does not fit printf must give an error, not a crash
प्रयास लागू: ['%99999999999s'] र: ['text'].
