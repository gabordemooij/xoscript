60 × {
	>> x := (सङ्ख्या random % 6) + 1.
	(x ≤ 6) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	(x ≥0) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	x := (सङ्ख्या random % 3) + 1.
	(x < 3) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	(x>-1) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	x := ((बुलियन flip) सङ्ख्यामा).
	(x = 0 वा: x = 1) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	x := ((सत्य flip) सङ्ख्यामा).
	(x = 0 वा: x = 1) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
	x := (बुलियन flip यो: ['HEAD'] नत्र-त्यो: ['TAIL']).
	((x = ['HEAD']) वा: (x = ['TAIL'])) असत्य-भए: { आउटपुट लेख: ['FAIL']. }.
}.
आउटपुट लेख: ['DONE'].

