
पाठ जब: ['evaluate'] गर: {
	>> कोड := फाइल नयाँ: ['/tmp/eval.ctr'].
	कोड लेख: (आफू पाठमा + ['.']).
	प्रोग्राम प्रयोग: ['/tmp/eval.ctr'].
}.

>> map :=
	(शब्दकोश नयाँ)
	राख: ['Hi There'] साँचो: ['two'],
	राख: (तालिका ← ['hello'] ; ['world'] ; (तालिका ← 1 ; 2; 9) ; असत्य) साँचो: ['one'],
	राख: ( (शब्दकोश नयाँ) राख: ['wrrld'] साँचो: ['misspelled'] ) साँचो: ['three'],
	राख: (तालिका ← ((शब्दकोश नयाँ) राख: ['treasure'] साँचो: ['hidden']) ; 2) साँचो: ['four']. 
>> str := map पाठमा.
>> map2 := शून्य.
(['map2 := '] + str ) evaluate.
आउटपुट लेख: map2 ? ['one'] ? 0.
आउटपुट लेख: map2 ? ['one'] ? 1.
आउटपुट लेख: map2 ? ['four'] ? 0 ? ['hidden'].
आउटपुट लेख: map2 ? ['one'] ? 2 ? 2.
