>> Greeter := वस्तु नयाँ.
Greeter जब: ['make'] गर: {
	>> gr := वस्तु नयाँ.
	gr जब: ['setName:'] गर: { :aname
		आफ्नो नाम := aname.
	}.
	gr जब: ['greet'] गर: {
		आउटपुट लेख: आफ्नो नाम.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a नयाँ.
c setName: ['THREE'].
c greet.
>> d := a नयाँ.
d setName: ['FOUR'].
d greet.
c greet.
