तालिका जब: ['sum'] गर: {
	>> total := 0.
	आफू प्रत्येक: { :index :element
		total थप: element.
	}. <- total.
}.

>> a := सत्य.



a जब: ['पाठमा'] गर: {
	>> answer := शून्य.
	( आफू = सत्य ) सत्य-भए: {
		answer := ['Yep'].
	}, नत्र: {
		answer := ['Nope'].
	}. <- answer.
}.

a जब: ['सङ्ख्यामा'] गर: {
	>> answer := शून्य.
	( आफू = सत्य ) सत्य-भए: {
		answer := 10.
	}, नत्र: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b जब: ['पाठमा'] गर: { <- ['Devil'].
}.

b जब: ['बुलियनमा'] गर: { <- असत्य.
}.


आउटपुट लेख: a, नयाँ-पङ्क्ति.  
आउटपुट लेख: (90 + a), नयाँ-पङ्क्ति. 
आउटपुट लेख: b, नयाँ-पङ्क्ति. 
आउटपुट लेख: (सत्य र: b), नयाँ-पङ्क्ति.

a := तालिका ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666. 
a := a + ( तालिका ← 1 ).
आउटपुट लेख: a, नयाँ-पङ्क्ति.
आउटपुट लेख: ((शब्दकोश नयाँ) राख: शून्य साँचो: शून्य), नयाँ-पङ्क्ति.
आउटपुट लेख: a sum, नयाँ-पङ्क्ति. 


{
	a जब: ['पाठमा'] गर: { <- शून्य. }.
	a := [''] + a.
} समात: { :error
	आउटपुट लेख: ['Error noted: '] + error, नयाँ-पङ्क्ति.
}, चलाऊ.



{
	a जब: ['सङ्ख्यामा'] गर: { <- शून्य. }.
	a := 3 × a.
} समात: { :error
	आउटपुट लेख: ['Error noted: '] + error, नयाँ-पङ्क्ति.
}, चलाऊ.


