

तालिका जब: ['fixture:'] गर: { :f
	आफ्नो fixture := f.
}.

तालिका जब: ['गन्ती'] गर: { <- आफ्नो fixture.
}.

तालिका जब: ['aantal'] गर: { <- आफ्नो fixture.
}.


>> x := शून्य.
{

	x := ['hello'] 
	बदल:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] अक्षर: 2)
			)
		)
	ले: (
		(['...hal'] + ['lo']) 
			ठूला-अक्षर 
			lowecase 
			ठूला-अक्षर 
			छोड: -1 + ( 
				11 - 12 + (
					(
						(
							(
								तालिका ← 0 ; 1 ; 4; 9 ; (तालिका ← 0 ; 3; 1) ; 4
							) अन्तिमभन्दा-अघिल्लो
						) ? 1
					) + 
					((तालिका ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					गन्ती
				)
			)
	).

} × 10.
आउटपुट लेख: x, नयाँ-पङ्क्ति.

