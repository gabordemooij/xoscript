

तालिका जब: ['sum'] गर: {
	>> total := 0.
	आफू प्रत्येक: { :index :element
		total थप: element.
	}. <- total.
}.

तालिका जब: ['product'] गर: {
	>> total := 1.
	आफू प्रत्येक: { :index :element
		total गुणन: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

प्रोग्राम मेमोरी-व्यवस्थापन: 0.

{

>> a := तालिका ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666.
a := a + ( तालिका ← 1 ).
आउटपुट लेख: ( ['sum: '] + ( a sum ) ), नयाँ-पङ्क्ति.
आउटपुट लेख: ( ['min: '] + ( a न्यूनतम ) ), नयाँ-पङ्क्ति.
आउटपुट लेख: ( ['max: '] + ( a अधिकतम ) ), नयाँ-पङ्क्ति.
आउटपुट लेख: ( ['3rd: '] + ( a ? 2 ) ), नयाँ-पङ्क्ति.
आउटपुट लेख: ( ['prd: '] + ( a product ) ), नयाँ-पङ्क्ति.
a क्रमबद्ध: { :a :b <- (b - a). }.
a प्रत्येक: { :i :e आउटपुट लेख: ( i - 0 ), नयाँ-पङ्क्ति. }.

} चलाऊ.

प्रोग्राम सरसफाइ.
usedMemory1 := (प्रोग्राम मेमोरी ? 0).


