>> numbers := ['1,2,3'] टुक्र्याऊ: [','].
आउटपुट लेख: ['I got: '] + numbers गन्ती + [' numbers.'],नयाँ-पङ्क्ति.
{ :i आउटपुट लेख: ['number #'] + i + [':'] + (numbers स्थान: i), नयाँ-पङ्क्ति.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages टुक्र्याऊ: [' Or '].
आउटपुट लेख: ['We serve'], नयाँ-पङ्क्ति.
{ :i आउटपुट लेख: ['->'] + (beverages स्थान: i), नयाँ-पङ्क्ति. } × (beverages गन्ती).
आउटपुट लेख: (beverages जोड: [',']), नयाँ-पङ्क्ति.
आउटपुट लेख: (numbers जोड: ['||']).
