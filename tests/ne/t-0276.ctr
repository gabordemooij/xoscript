>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := वस्तु नयाँ.
⚄ जब: ['drawFrom:length:'] गर: { :pool :गन्ती
	
	>> result := [''].
	
	{
		>> index := सङ्ख्या random % (pool लम्बाइ).
		result अन्त्यमा-थप: ( pool अक्षर: (index + 1) ).
		
	} × गन्ती. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? लम्बाइ.
आउटपुट लेख: (['x↵'] x random लम्बाइ).
आउटपुट लेख: (['y↵'] y ?? लम्बाइ).

