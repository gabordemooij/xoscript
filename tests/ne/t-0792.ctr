Server init.

>> DB := Maria-DB नयाँ होस्ट: ['localhost'],
	प्रयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डाटाबेस-नाम: ['xobase'],
	जोडिऊ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB क्वेरी: SQL.

# now you don't have to set DB
query2 ल्याऊ: { :row
	आउटपुट लेख: row world, नयाँ-पङ्क्ति.
}.
