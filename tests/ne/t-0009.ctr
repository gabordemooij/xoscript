>> Greeter := वस्तु नयाँ.
Greeter जब: ['make'] गर: {
	>> greeter := वस्तु नयाँ.
	greeter जब: ['name:'] गर: { :नाम
		आउटपुट लेख: ['setting a name'].
		आफ्नो myName := नाम.
	}.
	greeter जब: ['performGreeting'] गर: {
		आउटपुट लेख: ['Hello'].
		आउटपुट लेख: आफ्नो myName.
	}.
	greeter जब: ['greet'] गर: {
		आफू performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
