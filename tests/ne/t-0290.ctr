# test list operations


>> cakes := तालिका ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes बदल: 1 लम्बाइ: 2 ले: ( तालिका ← ['cinnamon'] ; ['pineapple'] ).
आउटपुट लेख: (buy जोड: [',']), नयाँ-पङ्क्ति.


>> buy := cakes बदल: 1 लम्बाइ: 12 ले: ( तालिका ← ['cinnamon'] ; ['pineapple'] ).
आउटपुट लेख: (buy जोड: [',']), नयाँ-पङ्क्ति.


>> buy := cakes बदल: 2 लम्बाइ: 10 ले: ( तालिका नयाँ ).
आउटपुट लेख: (buy जोड: [',']), नयाँ-पङ्क्ति.


>> buy := cakes बदल: 0 लम्बाइ: 1 ले: ( तालिका नयाँ ).
आउटपुट लेख: (buy जोड: [',']), नयाँ-पङ्क्ति.


>> buy := cakes बदल: ['0'] लम्बाइ: ['1'] ले: ['x'].
आउटपुट लेख: (buy जोड: [',']), नयाँ-पङ्क्ति.
