# catch-all test (practical)
>> HTML := पाठ नयाँ.
HTML जब: ['encode:'] गर: { :tekst
	आफू अन्त्यमा-थप: (tekst
	बदल: ['&'] ले: ['&amp;'], 
	बदल: ['<'] ले: ['&lt;'],
	बदल: ['>'] ले: ['&gt;'],
	बदल: ['"'] ले: ['&quot;']).
}.
>> blog := HTML नयाँ.
blog अन्त्यमा-थप: ['<h1>'],
     encode: ['Koffie & Thee'],
     अन्त्यमा-थप: ['</h1>'].
आउटपुट लेख: blog, नयाँ-पङ्क्ति.


>> Roman := सङ्ख्या नयाँ.
Roman जब: ['stringy'] गर: {
	>> a := [''].
	{ a अन्त्यमा-थप: ['I']. } × आफू. <- a.
}.

>> x := Roman नयाँ.
x थप: 3.
आउटपुट लेख: x stringy, नयाँ-पङ्क्ति.

>> Quantum := बुलियन नयाँ.
Quantum जब: ['true?'] गर: { <- ['maybe True']. }.
आउटपुट लेख: (Quantum नयाँ true?), नयाँ-पङ्क्ति.

>> Nihil := शून्य नयाँ.
Nihil जब: ['पाठमा'] गर: { <- ['Nihil']. }.
आउटपुट लेख: (Nihil नयाँ), नयाँ-पङ्क्ति.
