

>> Matryoshka := वस्तु नयाँ.
Matryoshka जब: ['double:'] गर: { :secret
	आफ्नो secret := secret × 2.
}.
Matryoshka जब: ['नयाँ:'] गर: { :secret
	>> answer := शून्य.
	>> t := (secret > 255).
	आउटपुट लेख: (secret + [' | '] + t), नयाँ-पङ्क्ति.
	t सत्य-भए: {
		answer := secret.
	}, नत्र: {
		answer := Matryoshka पुनरावर्ती नयाँ: (आफू double: secret).
	}. <- answer.
}.

>> x := Matryoshka नयाँ: 2.
