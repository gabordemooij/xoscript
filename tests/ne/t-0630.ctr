#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := ढाँचा-खोज नयाँ: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern मिलान: subject गर: { :m :x
	आउटपुट लेख: m, नयाँ-पङ्क्ति.
	आउटपुट लेख: x, नयाँ-पङ्क्ति. <- ['XXX'].
}.
आउटपुट लेख: result, नयाँ-पङ्क्ति.