>> makeAdder := { :x
	>> f := { :y <- (आफ्नो x + y). } तोक: ['x'] मान: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i आफ्नो q राख: (आफ्नो f लागू: (आफ्नो q ? i)) साँचो: i. } 
	तोक: ['q'] मान: array,
	तोक: ['f'] मान: func.
	{ :i mapping लागू: i. } × (array गन्ती).
}.

>> a := तालिका ← 1; 2; 3.
mapper लागू: a र: (makeAdder लागू: 100).
आउटपुट लेख: (a स्थान: 0), नयाँ-पङ्क्ति.
आउटपुट लेख: (a ? 1), नयाँ-पङ्क्ति.
आउटपुट लेख: (a ? 2), नयाँ-पङ्क्ति.
