Server init.

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['^\\w+$'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 0 match, fails on @ and .

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['^[^@]+@[^\.]+\.\\w+$'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['([^@]+)@([^\.]+)\.\\w+'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match, groups dont matter

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['[a-z]'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 14 matches

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['.*'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match (all)

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['(.*)'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match (all)

आउटपुट लेख: (
	ढाँचा-खोज नयाँ: ['\\s*[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नयाँ-पङ्क्ति. # 1 match, prefix space optional, gets ignored