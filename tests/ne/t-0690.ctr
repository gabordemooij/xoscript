# database test
# see example server.xo for required config

Server init.
आउटपुट लेख: ['Database test'], नयाँ-पङ्क्ति.

>> db := Maria-DB नयाँ होस्ट: ['localhost'],
	प्रयोगकर्ता-नाम: ['xo'], पासवर्ड: ['pass123'], डाटाबेस-नाम: ['xobase'], जोडिऊ.

आउटपुट लेख: ['Can we connect? '] + db जोडिएको?, नयाँ-पङ्क्ति.

>> खोज-प्यारामिटर := db क्वेरी: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], प्यारामिटर: ( तालिका नयाँ ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  खोज-प्यारामिटर कार्यान्वयन. db पुष्टि. } समात: { :e db फिर्ता-लिऊ.  }, चलाऊ.

आउटपुट लेख: ['Can we insert? '] + ( खोज-प्यारामिटर insert-id > 0 ), नयाँ-पङ्क्ति.

>> x := 0.
>> खोज-प्यारामिटर :=
db क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
ल्याऊ: { :row 
	x थप: 1.
	सत्य रोक. # must clean up, no 'Commands out of sync'
}.

>> खोज-प्यारामिटर :=
db क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
ल्याऊ: { :row
	x थप: 1.
	सत्य रोक.
}.

(x > 0) सत्य-भए: {
	आउटपुट लेख: ['Can we break in the middle of a fetch? '].
}.

आउटपुट लेख: सत्य, नयाँ-पङ्क्ति.