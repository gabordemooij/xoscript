>> items := शब्दकोश नयाँ.
items राख: ['green'] साँचो: ['color-1'].
items राख: ['orange'] साँचो: ['color-2'].
items राख: ['red'] साँचो: ['color-3'].
>> i := 0.
>> s := [''].
items प्रत्येक: { :key :color
	आउटपुट लेख: ['color #'] + i + [' is: '] + color + [' '].
	i थप: 1.
}.
आउटपुट लेख: i + [' colors!'].
