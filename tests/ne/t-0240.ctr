# test qualifiers

>> $ := वस्तु नयाँ.

$ जब: ['जवाफ:'] गर: { :x
	
	>> operation := x अक्षर: 0.
	>> valuta := x अक्षर: 1.
	>> money := x छोड: 2.
	
	>> amount := 0.

	( operation = ['+'] ) सत्य-भए: {
		( valuta = ['£'] ) सत्य-भए: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

आउटपुट लेख: x, नयाँ-पङ्क्ति.


>> Fruit := वस्तु नयाँ.

Fruit जब: ['नयाँ'] गर: {
	>> f := आफू नयाँ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit जब: ['apples:'] गर: { :a आफ्नो apples := a. }.
Fruit जब: ['oranges:'] गर: { :p आफ्नो oranges := p. }.
Fruit जब: ['apples'] गर: { <- आफ्नो apples. }.
Fruit जब: ['oranges'] गर: { <- आफ्नो oranges. }.

Fruit जब: ['+'] गर: { :f
	
	>> n := Fruit नयाँ.
	f थप: 1.
	
	n apples: (f apples + आफ्नो apples).
	n oranges:  (f oranges  + आफ्नो oranges). <- n.
}.

Fruit जब: ['पाठमा'] गर: { <- ( आफ्नो apples पाठमा + [' apples and '] + आफ्नो oranges + [' oranges'] ).
}.

सङ्ख्या जब: ['apples'] गर: { <- ((Fruit नयाँ) apples: आफू).
}.

सङ्ख्या जब: ['apple'] गर: { <- ((Fruit नयाँ) apples: आफू).
}.

सङ्ख्या जब: ['oranges'] गर: { <- ((Fruit नयाँ) oranges: आफू).
}.




आउटपुट लेख: (1 apple + 3 oranges + 4 apples), नयाँ-पङ्क्ति.


पाठ जब: ['twice'] गर: { <- ((आफू पाठमा) + (आफू पाठमा)).
}.



आउटपुट लेख: ['❤❤❤'] twice.



