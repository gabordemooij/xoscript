# test catch-all methods
>> x13 := वस्तु नयाँ.
x13 जब: ['a'] गर: { :a आउटपुट लेख: 0, नयाँ-पङ्क्ति. }.
x13 जब: ['a:'] गर: { :a आउटपुट लेख: a, नयाँ-पङ्क्ति. <- 5. }.
x13 जब: ['a:b:'] गर: { :a :b आउटपुट लेख: (a + b), नयाँ-पङ्क्ति. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
