# compliance test

# use international numbers

आउटपुट लेख: ['1000 -> '].
आउटपुट लेख: 1000, नयाँ-पङ्क्ति. #1000

आउटपुट लेख: ['1.5 -> '].
आउटपुट लेख: 1.5, नयाँ-पङ्क्ति.  #1.5

आउटपुट लेख: ['1001.5 -> '].
आउटपुट लेख: 1.5 + 1000, नयाँ-पङ्क्ति. #1001.5

# use 0-indexed arrays
>> x := तालिका नयाँ ; 1 ; 2 ; 3.
>> y := तालिका नयाँ ; ['a'] ; ['b'] ; ['c'].

आउटपुट लेख: ['1 -> '].
आउटपुट लेख: x ? 0, नयाँ-पङ्क्ति. #1

आउटपुट लेख: ['1 -> '].
आउटपुट लेख: (x मा: 0), नयाँ-पङ्क्ति. #1

आउटपुट लेख: ['1 -> '].
आउटपुट लेख: x पहिलो, नयाँ-पङ्क्ति. #1

आउटपुट लेख: ['3 -> '].
आउटपुट लेख: x अन्तिम, नयाँ-पङ्क्ति. #3

आउटपुट लेख: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
आउटपुट लेख: (x अनुसार: y), नयाँ-पङ्क्ति.

आउटपुट लेख: ['1 -> '].
आउटपुट लेख: (x सुरु: 0 लम्बाइ: 1) पहिलो, नयाँ-पङ्क्ति. #1

आउटपुट लेख: ['0 -> '].
आउटपुट लेख: (x खोज: 1), नयाँ-पङ्क्ति. #0

x राख: 9 साँचो: 0.

आउटपुट लेख: ['9 -> '].
आउटपुट लेख: (x मा: 0), नयाँ-पङ्क्ति. #9

x सुरुमा-थप: 8.
आउटपुट लेख: ['8 -> '].
आउटपुट लेख: (x मा: 0), नयाँ-पङ्क्ति. #9


x अन्त्यमा-थप: 10.
आउटपुट लेख: ['10 -> '].
आउटपुट लेख: (x मा: 4), नयाँ-पङ्क्ति. #10








