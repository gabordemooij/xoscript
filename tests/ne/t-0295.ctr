
>> dictionary := (
	शब्दकोश नयाँ
		राख: ['b'] साँचो: ['a'],
		राख: ['a'] साँचो: ['b'],
		राख: ['z'] साँचो: ['x'],
		राख: ['hello'] साँचो: ['hallo'],
		राख: ['human'] साँचो: ['human']
).

>> comparisons := तालिका नयाँ.
dictionary प्रत्येक: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a तुलना: b)
	).
}.

comparisons क्रमबद्ध: { :a :b <- ( a तुलना: b ). }.
आउटपुट लेख: ( comparisons जोड: ['↵'] ), नयाँ-पङ्क्ति.
comparisons जोड: ['↵'].
