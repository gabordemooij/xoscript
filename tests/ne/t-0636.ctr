# test url parsing

Server init.
>> url := URL बाट: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

आउटपुट लेख: ['scheme = '] + url योजना, नयाँ-पङ्क्ति.
आउटपुट लेख: ['host = '] + url होस्ट, नयाँ-पङ्क्ति.
आउटपुट लेख: ['port = '] + url पोर्ट, नयाँ-पङ्क्ति.
आउटपुट लेख: ['path = '] + url फाइल-बाटो, नयाँ-पङ्क्ति.
आउटपुट लेख: ['query = '] + url खोज-प्यारामिटर, नयाँ-पङ्क्ति.
आउटपुट लेख: ['fragment = '] + url खण्ड, नयाँ-पङ्क्ति.
