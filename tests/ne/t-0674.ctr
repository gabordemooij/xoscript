# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> फाइल-बाटो := ['/tmp/dat.csv'].
>> csv := फाइल नयाँ: फाइल-बाटो.
csv लेख: s.

# accepts CRLF LF CR, varying row length
csv विभाजक: [';'] उद्धरण: ['"'] पङ्क्तिहरू: { :line
	प्रोग्राम सरसफाइ.
	आउटपुट लेख: line, नयाँ-पङ्क्ति.
	प्रोग्राम सरसफाइ.
}.

# unequal lines
s अन्त्यमा-थप: ['\njustone'].
csv लेख: s.
{
	csv विभाजक: [';'] उद्धरण: ['"'] पङ्क्तिहरू: { :line
		आउटपुट लेख: line, नयाँ-पङ्क्ति.
	}.
} समात: { :e 
	आउटपुट लेख: e, नयाँ-पङ्क्ति.
}, चलाऊ.

# invalid format
s := ['"he"llo";world'].
csv लेख: s.
{
	csv विभाजक: [';'] उद्धरण: ['"'] पङ्क्तिहरू: { :line
		आउटपुट लेख: line, नयाँ-पङ्क्ति.
	}.
} समात: { :e 
	आउटपुट लेख: e, नयाँ-पङ्क्ति.
}, चलाऊ.
