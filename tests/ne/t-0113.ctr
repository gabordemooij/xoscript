आउटपुट लेख: ['Continue for-loop, No - before 6 and up.'], नयाँ-पङ्क्ति.
{ :i
	आउटपुट लेख: (i + 1), नयाँ-पङ्क्ति.
	((i + 1) > 4) जारी.
	आउटपुट लेख: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
आउटपुट नयाँ-पङ्क्ति.
आउटपुट लेख: ['Continue while-true, No --> before 5 and up.'], नयाँ-पङ्क्ति.
{
	आउटपुट लेख: ['iteration #'] + x, नयाँ-पङ्क्ति.
	x थप: 1.
	((x < 5) उल्टो) जारी.
	आउटपुट लेख: ['-->'].
} जबसम्म: xIsLessThan10.
आउटपुट नयाँ-पङ्क्ति.
आउटपुट लेख: ['Continue while-false, No - before 3 only.'], नयाँ-पङ्क्ति.
{
	आउटपुट लेख: ['iteration #'] + x, नयाँ-पङ्क्ति.
	x घटाऊ: 1.
	(x = 3) जारी.
	आउटपुट लेख: ['-'].
} जबसम्म: { <- ( x > 0). }.

आउटपुट नयाँ-पङ्क्ति.
आउटपुट लेख: ['Continue times-loop, No ||| before 3.'], नयाँ-पङ्क्ति.
{ :i
	आउटपुट लेख: ['iteration #'] + i, नयाँ-पङ्क्ति.
	(i = 2) जारी.
	आउटपुट लेख: ['|||'].
} × 5.

आउटपुट नयाँ-पङ्क्ति.

{ सत्य जारी. आउटपुट लेख: ['dont write this!'], नयाँ-पङ्क्ति. } चलाऊ.

{ सत्य जारी. आउटपुट लेख: ['dont write this!'], नयाँ-पङ्क्ति. } समात: { आउटपुट लेख: ['Dont catch this!']. }, चलाऊ.

आउटपुट लेख: ['Test Array each-loop: 0, ... ,2'], नयाँ-पङ्क्ति.
(तालिका ← 1 ; 2 ; 3) रूपान्तर: { :i
	(i = 1) जारी.
	आउटपुट लेख: ['iteration #'] + (i - 0), नयाँ-पङ्क्ति.
}.

आउटपुट लेख: ['Test Map each-loop: c only'], नयाँ-पङ्क्ति.
>> m := शब्दकोश नयाँ.
m राख: ['first'] साँचो: ['a'], राख: ['second'] साँचो: ['b'], राख: ['third'] साँचो: ['c'].
m प्रत्येक: { :k :v
	(k ≠ ['c']) जारी.
	आउटपुट लेख: ['iteration'] + k + v, नयाँ-पङ्क्ति.
}.

