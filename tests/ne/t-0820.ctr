# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ढाँचा-खोज नयाँ: pattern.
	p मिलान: subject गर: { :m :g
		आउटपुट लेख: g गन्ती, लेख: [' '], लेख: (g जोड: ['|']), नयाँ-पङ्क्ति. <- m.
	}.
}.
show लागू: ['(a)|(b)'] र: ['b'].
show लागू: ['(a)|(b)'] र: ['a'].
show लागू: ['(x)?y'] र: ['y'].
show लागू: ['(x)?(y)(z)?'] र: ['xy'].
