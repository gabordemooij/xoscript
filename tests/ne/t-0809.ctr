# backslashes must survive code serialization, strings must not end early
>> मानहरू := तालिका नयाँ
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

मानहरू प्रत्येक: { :i :value
	>> d := शब्दकोश नयाँ.
	d राख: value साँचो: ['k'].
	>> r := d कोड वस्तुमा.
	आउटपुट लेख: r गन्ती, नयाँ-पङ्क्ति.
	आउटपुट लेख: ( (r मा: ['k']) = value ), नयाँ-पङ्क्ति.
}.
