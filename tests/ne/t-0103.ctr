>> a := तालिका ← वस्तु ; सत्य ; असत्य ; बुलियन ; 1 ; सङ्ख्या ; ['Str'] ; पाठ ; { ['Empty']. }.
आउटपुट लेख: (a गन्ती), नयाँ-पङ्क्ति.
{ :i
	आउटपुट लेख: 
	['a '] + 
	((a ? i) प्रकार) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) शून्य?) यो: [''] नत्र-त्यो: ['NOT']) + 
	[' Nil.'],
	नयाँ-पङ्क्ति.
} × (a गन्ती).
आउटपुट लेख: ['but.. Nil is.. '] + ((शून्य शून्य?) यो: ['certainly NIL!'] नत्र-त्यो: ['not NIL??']), नयाँ-पङ्क्ति.