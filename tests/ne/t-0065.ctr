सङ्ख्या जब: ['factorial'] गर: {
	>> total := 1.
	{ :index total गुणन: (आफू - (index)). } × आफू. <- total.
}.
>> Printer := वस्तु नयाँ.
Printer जब: ['print:and:'] गर: { :x :y
	आउटपुट लेख: ['a='] + x + [', b='] + y, नयाँ-पङ्क्ति.
}.
>> a := 4.5. >> b := a तल-पूर्णाङ्क.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a माथि-पूर्णाङ्क.
Printer print: a and: b.
a := 4.5. b := a तल-पूर्णाङ्क.
Printer print: a and: b.
a := 4.5. b := a पूर्णाङ्कन.
Printer print: a and: b.
a := 4.2. b := a पूर्णाङ्कन.
Printer print: a and: b.

आउटपुट लेख: (9 शेष: 5), नयाँ-पङ्क्ति.
आउटपुट लेख: -666 निरपेक्ष-मान, नयाँ-पङ्क्ति.
आउटपुट लेख: 49 वर्गमूल, नयाँ-पङ्क्ति.
आउटपुट लेख: (2 घात: 3), नयाँ-पङ्क्ति.
>> l := (तालिका ← 9 ; 6).
आउटपुट लेख: l न्यूनतम.

