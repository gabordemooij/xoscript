
>> countries := तालिका नयाँ
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := तालिका नयाँ
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods अनुसार: countries, प्रत्येक: { :key :value
	counter थप: 1.
}.

आउटपुट लेख: (['we serve counter dishes'] counter: counter), नयाँ-पङ्क्ति.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] अक्षरहरू क्रमबद्ध: { :v
	counter थप: 0.
}.

आउटपुट लेख: (['we sort counter dishes'] counter: counter), नयाँ-पङ्क्ति.


>> counter := 0.
{
	{
		counter थप: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


आउटपुट लेख: (['we calculate counter numbers.'] counter: counter), नयाँ-पङ्क्ति.

