#Linux
>> OS := प्रोग्राम प्रणाली: (आदेश uname -s), छाँट.

>> Slurp := वस्तु नयाँ.
Slurp जब: ['नयाँ'] गर: {
	आफ्नो str := [''].
}.
Slurp जब: ['जवाफ:'] गर: { :blah
		(आफ्नो str ≠ ['']) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: [' '].
		}.
		आफ्नो str अन्त्यमा-थप: blah.
}.
Slurp जब: ['जवाफ:र:'] गर: { :blah :blahah
		(आफ्नो str ≠ ['']) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: [' '].
		}.
		(blah लम्बाइ > 1) सत्य-भए: {
			आफ्नो str अन्त्यमा-थप: (blah सुरु: 0 लम्बाइ: (blah लम्बाइ - 1)).
		}, नत्र: {
			आफ्नो str अन्त्यमा-थप: blah.
		}.
		आफ्नो str अन्त्यमा-थप: [' '].
		आफ्नो str अन्त्यमा-थप: blahah.
}.
Slurp जब: ['obtain'] गर: {
	>> buffer := आफ्नो str.
	आफ्नो str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text अन्त्यमा-थप: ['hello'].
} × 1000.


आउटपुट लेख: (
	प्रोग्राम प्रणाली: (
		Slurp नयाँ
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

