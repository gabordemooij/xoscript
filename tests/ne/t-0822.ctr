# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB नयाँ होस्ट: ['localhost'],
	प्रयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डाटाबेस-नाम: ['xobase'],
	जोडिऊ.

>> खोज-प्यारामिटर := db क्वेरी: ['SELECT ? AS a, ? AS b, ? AS c'].
खोज-प्यारामिटर प्यारामिटर: (तालिका नयाँ ; ['1']).
{ खोज-प्यारामिटर ल्याऊ: { :row आउटपुट लेख: row, नयाँ-पङ्क्ति. }. } समात: { :e आउटपुट लेख: e, नयाँ-पङ्क्ति. }, चलाऊ.

>> खोज-प्यारामिटर := db क्वेरी: ['SELECT ? AS a'].
{ खोज-प्यारामिटर ल्याऊ: { :row आउटपुट लेख: row, नयाँ-पङ्क्ति. }. } समात: { :e आउटपुट लेख: e, नयाँ-पङ्क्ति. }, चलाऊ.

# the right number still works, more parameters are ignored as before
>> खोज-प्यारामिटर := db क्वेरी: ['SELECT ? AS a, ? AS b'].
खोज-प्यारामिटर प्यारामिटर: (तालिका नयाँ ; ['1'] ; ['2']).
खोज-प्यारामिटर ल्याऊ: { :row आउटपुट लेख: (row मा: ['a']), लेख: (row मा: ['b']), नयाँ-पङ्क्ति. }.
खोज-प्यारामिटर प्यारामिटर: (तालिका नयाँ ; ['1'] ; ['2'] ; ['3']).
खोज-प्यारामिटर ल्याऊ: { :row आउटपुट लेख: (row मा: ['a']), लेख: (row मा: ['b']), नयाँ-पङ्क्ति. }.
