# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob नयाँ: 8, bytes: (
	तालिका नयाँ ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

आउटपुट लेख: ( utf16 डिकोड: ['utf16le'] ), नयाँ-पङ्क्ति.

utf16 मुक्त.
>> utf32 := Blob नयाँ: 13, bytes: (
	तालिका नयाँ ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

आउटपुट लेख: ( utf32 डिकोड: ['utf32be'] ), नयाँ-पङ्क्ति.
utf32 मुक्त.