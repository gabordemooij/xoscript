Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := तालिका नयाँ ;
	# {"key":"normal"} normal ASCII
	( शब्दकोश नयाँ राख: ['normal'] साँचो: ['key'] ) ;
	# {"key":"hello world"} space character
	( शब्दकोश नयाँ राख: ['hello world'] साँचो: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( शब्दकोश नयाँ राख: ['"'] साँचो: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( शब्दकोश नयाँ राख: ['backslash: \\'] साँचो: ['key'] ) ;
	# {"key":"slash: /"} slash
	( शब्दकोश नयाँ राख: ['slash: /'] साँचो: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( शब्दकोश नयाँ राख: ['backspace: \b'] साँचो: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( शब्दकोश नयाँ राख: ['formfeed: \f'] साँचो: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( शब्दकोश नयाँ राख: ['newline: \n'] साँचो: ['key'] ) ;
	( शब्दकोश नयाँ राख: ['newline: ↵'] साँचो: ['key'] ) ;
	( शब्दकोश नयाँ राख: ['newline: 
	'] साँचो: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( शब्दकोश नयाँ राख: ['carriage return: \r'] साँचो: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( शब्दकोश नयाँ राख: ['tab \t'] साँचो: ['key'] ) ;
	( शब्दकोश नयाँ राख: ['tab ⇿'] साँचो: ['key'] ) ;
	( शब्दकोश नयाँ राख: ['tab  '] साँचो: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( शब्दकोश नयाँ राख: ['NUL \u0000'] साँचो: ['key'] ) ;
	( शब्दकोश नयाँ राख: ['NUL \0'] साँचो: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( शब्दकोश नयाँ राख: ['control: \u0001'] साँचो: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( शब्दकोश नयाँ राख: ['control: \u001F'] साँचो: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( शब्दकोश नयाँ राख: ['unicode: é'] साँचो: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( शब्दकोश नयाँ राख: ['unicode: €'] साँचो: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( शब्दकोश नयाँ राख: ['unicode: 日本語'] साँचो: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( शब्दकोश नयाँ राख: ['unicode: 😀'] साँचो: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( शब्दकोश नयाँ राख: ['unicode: 🧑‍💻'] साँचो: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( शब्दकोश नयाँ राख: ['combining: e\u0301'] साँचो: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( शब्दकोश नयाँ राख: ['escaped unicode: \u00e9'] साँचो: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( शब्दकोश नयाँ राख: ['escaped unicode: \u20ac'] साँचो: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( शब्दकोश नयाँ राख: ['escaped unicode: \ud83d\ude00'] साँचो: ['key'] ) ;
	# {"key":""} empty value
	( शब्दकोश नयाँ राख: [''] साँचो: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( शब्दकोश नयाँ राख: ['@ < > & = % + ? #'] साँचो: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( शब्दकोश नयाँ राख: ['''] साँचो: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( शब्दकोश नयाँ राख: ['multiple: \" \\ \n \r \t'] साँचो: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( शब्दकोश नयाँ राख: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] साँचो: ['key'] ) ;
	# {"key":" value"} leading space
	( शब्दकोश नयाँ राख: [' value'] साँचो: ['key'] ) ;
	# {"key":"value "} trailing space
	( शब्दकोश नयाँ राख: ['value '] साँचो: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( शब्दकोश नयाँ राख: [' \t\n\r '] साँचो: ['key'] ).

dicts प्रत्येक: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (शब्दकोश नयाँ राख: d key साँचो: ['key']).
	>> b := JSON jsonify: (शब्दकोश नयाँ राख: ['value'] साँचो: d key).
	>> e := JSON वस्तु: a.
	>> f := JSON वस्तु: b.
	((e key = d key र: (f ? d key = ['value'])) वा: (e key = ['NUL ?'])) सत्य-भए: {
		आउटपुट लेख: ['OK'], नयाँ-पङ्क्ति.
	}, नत्र: {
		आउटपुट लेख: ['Unable to properly encode/decode: '] + d + j, नयाँ-पङ्क्ति.
		प्रोग्राम अन्त्य.
	}.
}.
