HTTP-Request bij: ['HTTP-kop:'] doen: { :sleutel <- Programma instelling: sleutel.
}.

>> HTTP-Kop := Object nieuw.

HTTP-Kop bij: ['nieuw'] doen: { <- zelf nieuw initialiseren.
}.

HTTP-Kop bij: ['initialiseren'] doen: {
	eigen sleutel := Niets.
	eigen waarde := Niets.
}.

HTTP-Kop bij: ['sleutel:waarde:'] doen: { :sleutel :waarde
	eigen sleutel := sleutel.
	eigen waarde := waarde.
}.

HTTP-Kop bij: ['sleutel'] doen: { <- eigen sleutel.
}.

HTTP-Kop bij: ['waarde'] doen: { <- eigen waarde.
}.


HTTP-Kop bij: ['tekst'] doen: {
	>> regel := eigen sleutel + [': '] + eigen waarde.
	regel vervang: ['\r'] door: [''], vervang: ['\n'] door: ['']. <- regel + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdocument := Object nieuw.

Webdocument bij: ['nieuw'] doen: { <- zelf nieuw initialiseren.
}.

Webdocument bij: ['initialiseren'] doen: {
	eigen koppen := Reeks nieuw.
	eigen sessie-id := Niets.
	eigen sessiebeheerder := Tijdelijk-bestand-sessie nieuw.
	eigen sessiegegevens := Niets.
	eigen veilig := Ja.
	eigen zelfde-site := ['Strict'].
	eigen koppen-verzonden := Nee.
	eigen verzoek := HTTP-Request nieuw.
}.

Webdocument bij: ['verzoek:'] doen: { :verzoek
	eigen verzoek := verzoek.
}. 

Webdocument bij: ['veilige-sessiecookie:'] doen: { :veilig
	zelf koppen-controleren.
	eigen veilig := veilig.
}.

Webdocument bij: ['zelfde-site-sessiecookie:'] doen: { :waarde
	zelf koppen-controleren.
	>> opties := Reeks nieuw 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opties heeft: waarde, nee: {
		deze-taak fout: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigen zelfde-site := waarde.
}.

Webdocument bij: ['kop:'] doen: { :kop
	zelf koppen-controleren.
	eigen koppen toevoegen: kop.
}.

Webdocument bij: ['koppen-wissen'] doen: {
	zelf koppen-controleren.
	eigen koppen := Reeks nieuw.
}.

Webdocument bij: ['sessiebeheerder:'] doen: { :beheerder
	zelf koppen-controleren.
	eigen sessiebeheerder := beheerder.
}.

Webdocument bij: ['sessiebeheerder'] doen: { <- eigen sessiebeheerder.
}.

Webdocument bij: ['koppen-controleren'] doen: {
	eigen koppen-verzonden ja: {
		deze-taak fout: ['Headers already sent to client.'].
	}.
}.

Webdocument bij: ['sessie-starten'] doen: {
	zelf koppen-controleren.
	>> verzoek := eigen verzoek.
	>> sessie-id := verzoek cookie: ['xsid'].
	sessie-id Niets? nee: {
		(( Patroon nieuw: ['^[A-Za-z0-9]+\\z'], overeenkomst: sessie-id ) = 0) ja: {
			sessie-id := Niets.
		}.
	}.
	sessie-id Niets? ja: {
		sessie-id := Kluis token: 30.
		>> sessiekop := HTTP-Kop nieuw
		sleutel: ['Set-Cookie'] waarde: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigen veilig of: ['Secure'] of: ['']),
		SSITE: (eigen zelfde-site),
		XSID: sessie-id
		).
		eigen koppen toevoegen: sessiekop.
	}.
	eigen sessiegegevens := eigen sessiebeheerder voor: sessie-id, laden. <- eigen sessiegegevens. # reference
}.

Webdocument bij: ['ga-naar:'] doen: { :adres
	zelf koppen-controleren.
	zelf koppen-wissen.
	eigen koppen
	toevoegen: (
		HTTP-Kop nieuw
		sleutel: ['Status'] waarde: ['303 See Other']
	),
	toevoegen: (
		HTTP-Kop nieuw
		sleutel: ['Location'] waarde: adres
	).
	zelf uitvoeren: ['Redirect'].
}.

Webdocument bij: ['sessie-vernietigen'] doen: {
	zelf koppen-controleren.
	>> verzoek := eigen verzoek.
	>> sessie-id := verzoek cookie: ['xsid'].
	sessie-id Niets? nee: {
		>> sessiekop := HTTP-Kop nieuw.
		>> tijdstip := Moment nieuw jaar: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessiekop sleutel: ['Set-Cookie'] waarde: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tijdstip,
			SEC: (eigen veilig of: ['Secure'] of: ['']),
			SSITE: (eigen zelfde-site),
			XSID: sessie-id
		).
		eigen sessiebeheerder vernietigen.
		eigen koppen toevoegen: sessiekop.
	}.
}.


Webdocument bij: ['sjabloon:'] doen: { :pad <- Sjabloon nieuw: (Bestand nieuw: pad, lezen).
}.

Webdocument bij: ['uitvoeren:type:'] doen: { :uitvoer :type
	eigen koppen-verzonden nee: {
		eigen sessiegegevens Niets? nee: {
			eigen sessiebeheerder opslaan: eigen sessiegegevens.
		}.
		eigen koppen toevoegen: (
			HTTP-Kop nieuw
			sleutel: ['Content-type'] waarde: type
		).
		eigen koppen elk: { :_ :kop
			Uit schrijf: kop.
		}.
		eigen koppen-verzonden := Ja.
		Uit schrijf: ['\r\n'].
	}.
	Uit schrijf: uitvoer.
}.

Webdocument bij: ['afronden:type:'] doen: { :uitvoer :type
	eigen koppen-verzonden nee: {
		eigen sessiegegevens Niets? nee: {
			eigen sessiebeheerder opslaan: eigen sessiegegevens.
		}.
		eigen koppen toevoegen: (
			HTTP-Kop nieuw
			sleutel: ['Content-type'] waarde: type
		).
		eigen koppen toevoegen: (
			HTTP-Kop nieuw
			sleutel: ['Content-Length'] waarde: uitvoer tekst bytes
		).
		eigen koppen elk: { :_ :kop
			Uit schrijf: kop.
		}.
		eigen koppen-verzonden := Ja.
		Uit schrijf: ['\r\n'].
	}.
	Uit schrijf: uitvoer.
}.

Webdocument bij: ['uitvoeren:'] doen: { :uitvoer
	zelf uitvoeren: uitvoer type: ['text/html; charset=utf-8'].
}.

Webdocument bij: ['afronden:'] doen: { :uitvoer
	zelf afronden: uitvoer type: ['text/html; charset=utf-8'].
}.

Webdocument bij: ['json:'] doen: { :uitvoer
	zelf uitvoeren: ( JSON jsonify: uitvoer ) type: ['application/json'].
}.

Webdocument bij: ['niet-gevonden:'] doen: { :uitvoer
	zelf koppen-wissen kop: (
		HTTP-Kop nieuw sleutel: ['Status'] waarde: ['404 Not Found']
	).
	zelf uitvoeren: uitvoer.
}.


# Interface

>> Sessie := Object nieuw.

Sessie bij: ['nieuw'] doen: { <- zelf nieuw initialiseren voor: Niets.
}.

Sessie bij: ['voor:'] doen: { :id
	eigen id := id.
}.

Sessie bij: ['laden'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

Sessie bij: ['opslaan:'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

Sessie bij: ['vernietigen'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tijdelijk-bestand-sessie := Sessie nieuw.

Tijdelijk-bestand-sessie bij: ['initialiseren'] doen: {
	eigen padbegin := ['/tmp/sess-'].
}.

Tijdelijk-bestand-sessie bij: ['padvoorvoegsel:'] doen: { :tekenreeks
	eigen padbegin := tekenreeks.
}.

Tijdelijk-bestand-sessie bij: ['bestand'] doen: { <- ( Bestand nieuw: ( eigen padbegin + eigen id + ['.txt'] ) ).
}.

Tijdelijk-bestand-sessie bij: ['laden'] doen: {
	>> bestand := zelf bestand.
	bestand bestaat nee: {
		bestand schrijf: (Lijst nieuw code).
	}. <- bestand lezen object.
}.

Tijdelijk-bestand-sessie bij: ['opslaan:'] doen: { :gegevens
	>> bestand := zelf bestand.
	bestand bestaat ja: {
		bestand schrijf: gegevens code.
	}.
}.

Tijdelijk-bestand-sessie bij: ['vernietigen'] doen: {
	>> bestand := zelf bestand.
	bestand bestaat ja: {
		bestand verwijderen.
	}.
}.


>> URL := Object nieuw.

URL bij: ['initialiseren'] doen: {
	eigen protocol := ['https://'].
	eigen host := ['localhost'].
	eigen pad := [''].
	eigen url-parameters := [''].
	eigen hash := [''].
}.

URL bij: ['nieuw'] doen: { <- zelf nieuw initialiseren.
}.

URL bij: ['tekst'] doen: { <- (
	eigen protocol +
	eigen host +
	eigen pad +
	eigen url-parameters +
	eigen hash ).
}.

URL bij: ['protocol:'] doen: { :protocol
	((Reeks nieuw ; ['http'] ; ['https']) heeft: protocol) ja: {
		eigen protocol := protocol + ['://'].
	}, nee: {
		deze-taak fout: ['Invalid protocol'].
	}.
}.

URL bij: ['host:'] doen: { :host
	#todo validate according to rfc
	eigen host := host.
}.

URL bij: ['pad:'] doen: { :pad
	eigen pad := ['/'] + pad url-coderen.
}.

URL bij: ['url-parameters:'] doen: { :koppeling
	>> url-parameters := Reeks nieuw.
	koppeling elk: { :sleutel :waarde
		url-parameters toevoegen: sleutel tekst url-coderen + ['='] + waarde tekst url-coderen.
	}.
	eigen url-parameters := ['?'] + ( url-parameters samenvoegen: ['&'] ).
}.

URL bij: ['kluts:'] doen: { :hash
	eigen hash := ['#'] + hash url-coderen.
}.

