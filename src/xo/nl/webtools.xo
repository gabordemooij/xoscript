HTTP-Request bij: ['HTTP-header:'] doen: { :key <- Programma instelling: key.
}.

>> HTTP-Header := Object nieuw.

HTTP-Header bij: ['nieuw'] doen: { <- zelf nieuw init.
}.

HTTP-Header bij: ['init'] doen: {
	eigen key := Niets.
	eigen value := Niets.
}.

HTTP-Header bij: ['key:value:'] doen: { :key :value
	eigen key := key.
	eigen value := value.
}.

HTTP-Header bij: ['key'] doen: { <- eigen key.
}.

HTTP-Header bij: ['value'] doen: { <- eigen value.
}.


HTTP-Header bij: ['tekst'] doen: {
	>> line := eigen key + [': '] + eigen value.
	line vervang: ['\r'] door: [''], vervang: ['\n'] door: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Object nieuw.

Web-Document bij: ['nieuw'] doen: { <- zelf nieuw init.
}.

Web-Document bij: ['init'] doen: {
	eigen headers := Reeks nieuw.
	eigen sess-id := Niets.
	eigen session-manager := Tempfile-Session nieuw.
	eigen sessdata := Niets.
	eigen secure := Ja.
	eigen same-site := ['Strict'].
	eigen headers-out := Nee.
	eigen request := HTTP-Request nieuw.
}.

Web-Document bij: ['request:'] doen: { :request
	eigen request := request.
}. 

Web-Document bij: ['secure-session-cookie:'] doen: { :secure
	zelf check-headers.
	eigen secure := secure.
}.

Web-Document bij: ['same-site-session-cookie:'] doen: { :value
	zelf check-headers.
	>> options := Reeks nieuw 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options bevat: value, nee: {
		deze-taak fout: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigen same-site := value.
}.

Web-Document bij: ['header:'] doen: { :header
	zelf check-headers.
	eigen headers toevoegen: header.
}.

Web-Document bij: ['clear-headers'] doen: {
	zelf check-headers.
	eigen headers := Reeks nieuw.
}.

Web-Document bij: ['session-manager:'] doen: { :manager
	zelf check-headers.
	eigen session-manager := manager.
}.

Web-Document bij: ['session-manager'] doen: { <- eigen session-manager.
}.

Web-Document bij: ['check-headers'] doen: {
	eigen headers-out ja: {
		deze-taak fout: ['Headers already sent to client.'].
	}.
}.

Web-Document bij: ['session-start'] doen: {
	zelf check-headers.
	>> request := eigen request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Niets? nee: {
		(( Patroon nieuw: ['^[A-Za-z0-9]+\\z'], overeenkomst: sess-id ) = 0) ja: {
			sess-id := Niets.
		}.
	}.
	sess-id Niets? ja: {
		sess-id := Kluis token: 30.
		>> session-header := HTTP-Header nieuw
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigen secure of: ['Secure'] of: ['']),
		SSITE: (eigen same-site),
		XSID: sess-id
		).
		eigen headers toevoegen: session-header.
	}.
	eigen sessdata := eigen session-manager for: sess-id, load. <- eigen sessdata. # reference
}.

Web-Document bij: ['goto:'] doen: { :url
	zelf check-headers.
	zelf clear-headers.
	eigen headers
	toevoegen: (
		HTTP-Header nieuw
		key: ['Status'] value: ['303 See Other']
	),
	toevoegen: (
		HTTP-Header nieuw
		key: ['Location'] value: url
	).
	zelf out: ['Redirect'].
}.

Web-Document bij: ['session-destroy'] doen: {
	zelf check-headers.
	>> request := eigen request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Niets? nee: {
		>> session-header := HTTP-Header nieuw.
		>> when := Moment nieuw jaar: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (eigen secure of: ['Secure'] of: ['']),
			SSITE: (eigen same-site),
			XSID: sess-id
		).
		eigen session-manager destroy.
		eigen headers toevoegen: session-header.
	}.
}.


Web-Document bij: ['template:'] doen: { :pad <- Template nieuw: (Bestand nieuw: pad, lezen).
}.

Web-Document bij: ['out:type:'] doen: { :output :type
	eigen headers-out nee: {
		eigen sessdata Niets? nee: {
			eigen session-manager save: eigen sessdata.
		}.
		eigen headers toevoegen: (
			HTTP-Header nieuw
			key: ['Content-type'] value: type
		).
		eigen headers elk: { :_ :header
			Uit schrijf: header.
		}.
		eigen headers-out := Ja.
		Uit schrijf: ['\r\n'].
	}.
	Uit schrijf: output.
}.

Web-Document bij: ['finish:type:'] doen: { :output :type
	eigen headers-out nee: {
		eigen sessdata Niets? nee: {
			eigen session-manager save: eigen sessdata.
		}.
		eigen headers toevoegen: (
			HTTP-Header nieuw
			key: ['Content-type'] value: type
		).
		eigen headers toevoegen: (
			HTTP-Header nieuw
			key: ['Content-Length'] value: output tekst bytes
		).
		eigen headers elk: { :_ :header
			Uit schrijf: header.
		}.
		eigen headers-out := Ja.
		Uit schrijf: ['\r\n'].
	}.
	Uit schrijf: output.
}.

Web-Document bij: ['out:'] doen: { :output
	zelf out: output type: ['text/html; charset=utf-8'].
}.

Web-Document bij: ['finish:'] doen: { :output
	zelf finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document bij: ['json:'] doen: { :output
	zelf out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document bij: ['not-found:'] doen: { :output
	zelf clear-headers header: (
		HTTP-Header nieuw key: ['Status'] value: ['404 Not Found']
	).
	zelf out: output.
}.


# Interface

>> Session := Object nieuw.

Session bij: ['nieuw'] doen: { <- zelf nieuw init for: Niets.
}.

Session bij: ['for:'] doen: { :id
	eigen id := id.
}.

Session bij: ['load'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

Session bij: ['save:'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

Session bij: ['destroy'] doen: {
	deze-taak fout: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session nieuw.

Tempfile-Session bij: ['init'] doen: {
	eigen pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session bij: ['path-prefix:'] doen: { :str
	eigen pathprefix := str.
}.

Tempfile-Session bij: ['file'] doen: { <- ( Bestand nieuw: ( eigen pathprefix + eigen id + ['.txt'] ) ).
}.

Tempfile-Session bij: ['load'] doen: {
	>> file := zelf file.
	file bestaat nee: {
		file schrijf: (Lijst nieuw code).
	}. <- file lezen object.
}.

Tempfile-Session bij: ['save:'] doen: { :data
	>> file := zelf file.
	file bestaat ja: {
		file schrijf: data code.
	}.
}.

Tempfile-Session bij: ['destroy'] doen: {
	>> file := zelf file.
	file bestaat ja: {
		file verwijderen.
	}.
}.


>> URL := Object nieuw.

URL bij: ['init'] doen: {
	eigen protocol := ['https://'].
	eigen host := ['localhost'].
	eigen pad := [''].
	eigen params := [''].
	eigen hash := [''].
}.

URL bij: ['nieuw'] doen: { <- zelf nieuw init.
}.

URL bij: ['tekst'] doen: { <- (
	eigen protocol +
	eigen host +
	eigen pad +
	eigen params +
	eigen hash ).
}.

URL bij: ['protocol:'] doen: { :protocol
	((Reeks nieuw: ['http'] ; ['https']) bevat: protocol) ja: {
		eigen protocol := protocol + ['://'].
	}, nee: {
		deze-taak fout: ['Invalid protocol'].
	}.
}.

URL bij: ['host:'] doen: { :host
	#todo validate according to rfc
	eigen host := host.
}.

URL bij: ['path:'] doen: { :pad
	eigen pad := ['/'] + pad url-coderen.
}.

URL bij: ['params:'] doen: { :map
	>> params := Reeks nieuw.
	map elk: { :key :value
		params toevoegen: key tekst url-coderen + ['='] + value tekst url-coderen.
	}.
	eigen params := ['?'] + ( params samenvoegen: ['&'] ).
}.

URL bij: ['kluts:'] doen: { :hash
	eigen hash := ['#'] + hash url-coderen.
}.

