
# ~ Simple template engine ~

>> Sjabloon := Object nieuw.

Sjabloon bij: ['nieuw'] doen: { <- zelf nieuw inhoud: [''].
}.

Sjabloon bij: ['inhoud:'] doen: { :inhoud
	eigen inhoud := inhoud. 
}.

Sjabloon bij: ['nieuw:'] doen: { :inhoud <- zelf nieuw inhoud: inhoud.
}.

Sjabloon bij: ['knippen:'] doen: { :markering
	>> startmarkering := (['<!-- cut:%id% -->'] %id%: markering).
	>> eindmarkering := (['<!-- /cut:%id% -->'] %id%: markering).
	>> delen := eigen inhoud opsplitsen: startmarkering.
	>> voorvoegsel := delen eerste.
	>> delen2 := delen laatste opsplitsen: eindmarkering.
	>> achtervoegsel := delen2 laatste.
	>> deel := delen2 eerste.
	>> rest := voorvoegsel + achtervoegsel.
	eigen inhoud := rest. <- Sjabloon nieuw: deel.
	
}.

Sjabloon bij: ['kopieer'] doen: { <- zelf nieuw: zelf tekst kopieer.
}.
	
Sjabloon bij: ['plakken:bij:'] doen: { :fragment :id
	>> plakmarkering := (['<!-- paste:%id% -->'] %id%: id).
	eigen inhoud vervang: plakmarkering door: ( fragment tekst + plakmarkering ).
}.

Sjabloon bij: ['gebruik:waarde:'] doen: { :plek :waarde
	eigen inhoud vervang: ['<!-- slot:'] + plek + [' -->'] door: ( Server html-coderen: waarde ).
}.

Sjabloon bij: ['gebruik:html:'] doen: { :plek :html
	eigen inhoud vervang: ['<!-- slot:'] + plek + [' -->'] door: html.
}.

Sjabloon bij: ['reactie:argument:'] doen: { :plek :waarde
	zelf gebruik: (plek van: 0 lengte: (plek lengte - 1)) waarde: waarde.
}.

Sjabloon bij: ['nl2br'] doen: {
	eigen inhoud vervang: ['\n'] door: ['<br>'].
}.

Sjabloon bij: ['opschonen'] doen: {
	eigen inhoud :=
		Patroon
		nieuw: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		overeenkomst: eigen inhoud
		doen: { <- ['']. }.
}.

Sjabloon bij: ['knipsels-opschonen'] doen: {
	>> elementen := Reeks nieuw.
	Patroon
	nieuw: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	overeenkomst: eigen inhoud
	doen: { :_ :deel
		elementen toevoegen: deel ? 1.
	}.
	elementen elk: { :_ :id
		eigen inhoud :=
			Patroon nieuw: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			overeenkomst: eigen inhoud
			doen: { <- ['']. }.
	 }.
}.

Sjabloon bij: ['witruimte-opschonen'] doen: {
	eigen inhoud :=
		Patroon
		nieuw: ['\\s*\\n'],
		overeenkomst: eigen inhoud
		doen: { <- ['\n']. }.
	eigen inhoud :=
		Patroon
		nieuw: ['\\n[\\s\\t]+'],
		overeenkomst: eigen inhoud
		doen: { <- ['\n']. }.
}.

Sjabloon bij: ['alles-opschonen'] doen: {
	zelf opschonen.
	zelf knipsels-opschonen.
	zelf witruimte-opschonen.
}.

Sjabloon bij: ['tekst'] doen: { <- eigen inhoud.
}.
