>> E-mail := Object nieuw.

E-mail bij: ['initialiseren'] doen: {
	eigen ontvangers := Reeks nieuw.
	eigen cc := Reeks nieuw.
	eigen bcc := Reeks nieuw.
	eigen afzender := Niets.
	eigen afzendernaam := Niets.
	eigen onderwerp := Niets.
	eigen berichttekst := Niets.
}.

E-mail bij: ['nieuw'] doen: { <- zelf nieuw initialiseren.
}.

E-mail bij: ['aan:'] doen: { :opsomming
	eigen ontvangers := opsomming.
}.
 
E-mail bij: ['cc:'] doen: { :opsomming
	eigen cc := opsomming.
}.

E-mail bij: ['bcc:'] doen: { :opsomming
	eigen bcc := opsomming.
}.

E-mail bij: ['onderwerp:'] doen: { :onderwerp
	eigen onderwerp := onderwerp.
}.

E-mail bij: ['afzender:naam:'] doen: { :afzender :naam
	eigen afzender := afzender.
	eigen afzendernaam := naam.
}.

E-mail bij: ['berichttekst:'] doen: { :berichttekst
	eigen berichttekst := berichttekst.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-mail bij: ['kop:'] doen: { :regel <- regel vervang: ['\r'] door: [''], vervang: ['\n'] door: [''].
}.

E-mail bij: ['versturen'] doen: {
	>> f := Bestand tempwrite: zelf genereren.
	Programma opdrachtregel: ['sendmail -t < '] + f pad, stop.
}.

E-mail bij: ['genereren'] doen: {
	>> regeleinde := ['\r\n'].
	>> tekenreeks := [''].
	tekenreeks toevoegen: (zelf kop: ['From: '] + eigen afzendernaam + [' <'] + ( eigen afzender ) + ['>']) + regeleinde.
	tekenreeks toevoegen: (zelf kop: ['To: '] + ( eigen ontvangers samenvoegen: [','] )) + regeleinde.
	eigen cc aantal ja: {
		tekenreeks toevoegen: (zelf kop: ['Cc: '] + ( eigen cc samenvoegen: [','] )) + regeleinde.
	}.
	eigen bcc aantal ja: {
		tekenreeks toevoegen: (zelf kop: ['Bcc: '] + ( eigen bcc samenvoegen: [','] )) + regeleinde.
	}.
	tekenreeks toevoegen: (zelf kop: ['Subject: '] + eigen onderwerp) + regeleinde.
	tekenreeks toevoegen: regeleinde.
	tekenreeks toevoegen: eigen berichttekst.
	tekenreeks toevoegen: regeleinde. <- tekenreeks.
}.

>> HTML-E-mail := E-mail nieuw.

HTML-E-mail bij: ['initialiseren'] doen: {
	zelf initialiseren.
	eigen bijlagen := Reeks nieuw.
	eigen grens := Kluis token: 40.
}.

HTML-E-mail bij: ['bijvoegen:'] doen: { :bestand
	>> id := eigen bijlagen aantal.
	>> blob := bestand blob.
	eigen bijlagen toevoegen: (
		Lijst nieuw
			bestand: bestand pad,
			mime: ['image/'] + (Server mimetype: bestand pad),
			gegevens: blob base64-coderen
	).
	blob vrij. <- ['cid:attachment'] + id.
}.

HTML-E-mail bij: ['genereren'] doen: {
	>> regeleinde := ['\r\n'].
	>> tekenreeks := [''].
	tekenreeks toevoegen: (zelf kop: ['From: '] + eigen afzendernaam + [' <'] + ( eigen afzender ) + ['>']) + regeleinde.
	tekenreeks toevoegen: (zelf kop: ['To: '] + ( eigen ontvangers samenvoegen: [','] )) + regeleinde.
	eigen cc aantal ja: {
		tekenreeks toevoegen: (zelf kop: ['Cc: '] + ( eigen cc samenvoegen: [','] )) + regeleinde.
	}.
	eigen bcc aantal ja: {
		tekenreeks toevoegen: (zelf kop: ['Bcc: '] + ( eigen bcc samenvoegen: [','] )) + regeleinde.
	}.
	tekenreeks toevoegen: (zelf kop: ['Subject: '] + eigen onderwerp) + regeleinde.
	tekenreeks toevoegen: ['MIME-Version: 1.0'] + regeleinde.
	tekenreeks toevoegen: ['Content-Type: multipart/related; boundary="'] + eigen grens + ['"; type=text/html'] + regeleinde.
	tekenreeks toevoegen: regeleinde.
	tekenreeks toevoegen: ['--'] + eigen grens + regeleinde.
	tekenreeks toevoegen: ['Content-Type: text/html; charset=UTF-8'] + regeleinde.
	tekenreeks toevoegen: ['Content-Transfer-Encoding: 7bit'] + regeleinde.
	tekenreeks toevoegen: regeleinde.
	tekenreeks toevoegen: eigen berichttekst.
	tekenreeks toevoegen: regeleinde.
	eigen bijlagen elk: { :id :info
		>> blob := info gegevens.
		tekenreeks toevoegen: ['--'] + eigen grens + regeleinde.
		tekenreeks toevoegen: ['Content-Type: '] + info mime + regeleinde.
		tekenreeks toevoegen: ['Content-Transfer-Encoding: base64'] + regeleinde.
		tekenreeks toevoegen: ['Content-ID: <attachment'] + id + ['>'] + regeleinde.
		tekenreeks toevoegen: ['Content-Disposition: inline; filename="'] + info bestand + ['"'] + regeleinde.
		tekenreeks toevoegen: regeleinde.
		>> hoogste := 76.
		>> tekstlengte := blob lengte.
		>> stukken := (tekstlengte / hoogste) hoog.
		{ :i
			>> stuk := blob kopieer van: i * hoogste lengte: hoogste.
			tekenreeks toevoegen: stuk + regeleinde.
		} * stukken.
		tekenreeks toevoegen: regeleinde.
		tekenreeks toevoegen: regeleinde.
	}.
	tekenreeks toevoegen: ['--'] + eigen grens + ['--'] + regeleinde. <- tekenreeks.
}.
