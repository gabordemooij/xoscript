
# ~ Simple template engine ~

>> Qaab-dhismeed := Walax cusub.

Qaab-dhismeed marka: ['cusub'] samee: { <- naf cusub nuxur: [''].
}.

Qaab-dhismeed marka: ['nuxur:'] samee: { :nuxur
	iska-leh nuxur := nuxur. 
}.

Qaab-dhismeed marka: ['cusub:'] samee: { :nuxur <- naf cusub nuxur: nuxur.
}.

Qaab-dhismeed marka: ['jar:'] samee: { :calaamad
	>> calaamadda-bilowga := (['<!-- cut:%id% -->'] %id%: calaamad).
	>> calaamadda-dhammaadka := (['<!-- /cut:%id% -->'] %id%: calaamad).
	>> qaybo := iska-leh nuxur kala-qaybi: calaamadda-bilowga.
	>> horgale := qaybo ugu-horreeya.
	>> qaybo2 := qaybo ugu-dambeeya kala-qaybi: calaamadda-dhammaadka.
	>> dabagale := qaybo2 ugu-dambeeya.
	>> qayb := qaybo2 ugu-horreeya.
	>> hadhaa := horgale + dabagale.
	iska-leh nuxur := hadhaa. <- Qaab-dhismeed cusub: qayb.
	
}.

Qaab-dhismeed marka: ['koobiyee'] samee: { <- naf cusub: naf qoraal koobiyee.
}.
	
Qaab-dhismeed marka: ['dhaji:furaha:'] samee: { :soo-qaatin :id
	>> calaamadda-dhajinta := (['<!-- paste:%id% -->'] %id%: id).
	iska-leh nuxur beddel: calaamadda-dhajinta ku: ( soo-qaatin qoraal + calaamadda-dhajinta ).
}.

Qaab-dhismeed marka: ['deji:qiime:'] samee: { :boos :qiime
	iska-leh nuxur beddel: ['<!-- slot:'] + boos + [' -->'] ku: ( Server html-koodee: qiime ).
}.

Qaab-dhismeed marka: ['deji:html:'] samee: { :boos :html
	iska-leh nuxur beddel: ['<!-- slot:'] + boos + [' -->'] ku: html.
}.

Qaab-dhismeed marka: ['jawaab:iyo:'] samee: { :boos :qiime
	naf deji: (boos ka: 0 dherer: (boos dherer - 1)) qiime: qiime.
}.

Qaab-dhismeed marka: ['nl2br'] samee: {
	iska-leh nuxur beddel: ['\n'] ku: ['<br>'].
}.

Qaab-dhismeed marka: ['hagaaji'] samee: {
	iska-leh nuxur :=
		Hannaan
		cusub: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		is-waafaq: iska-leh nuxur
		samee: { <- ['']. }.
}.

Qaab-dhismeed marka: ['hagaaji-jarjarka'] samee: {
	>> walxaha := Liis cusub.
	Hannaan
	cusub: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	is-waafaq: iska-leh nuxur
	samee: { :_ :qayb
		walxaha dhammaadka-ku-dar: qayb ? 1.
	}.
	walxaha mid-kasta: { :_ :id
		iska-leh nuxur :=
			Hannaan cusub: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			is-waafaq: iska-leh nuxur
			samee: { <- ['']. }.
	 }.
}.

Qaab-dhismeed marka: ['hagaaji-meelaha-banaan'] samee: {
	iska-leh nuxur :=
		Hannaan
		cusub: ['\\s*\\n'],
		is-waafaq: iska-leh nuxur
		samee: { <- ['\n']. }.
	iska-leh nuxur :=
		Hannaan
		cusub: ['\\n[\\s\\t]+'],
		is-waafaq: iska-leh nuxur
		samee: { <- ['\n']. }.
}.

Qaab-dhismeed marka: ['hagaaji-dhammaan'] samee: {
	naf hagaaji.
	naf hagaaji-jarjarka.
	naf hagaaji-meelaha-banaan.
}.

Qaab-dhismeed marka: ['qoraal'] samee: { <- iska-leh nuxur.
}.
