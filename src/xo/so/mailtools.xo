>> Iimayl := Walax cusub.

Iimayl marka: ['diyaari'] samee: {
	iska-leh qaatayaasha := Liis cusub.
	iska-leh cc := Liis cusub.
	iska-leh bcc := Liis cusub.
	iska-leh diraha := Waxba.
	iska-leh magaca-diraha := Waxba.
	iska-leh mawduuc := Waxba.
	iska-leh jirka := Waxba.
}.

Iimayl marka: ['cusub'] samee: { <- naf cusub diyaari.
}.

Iimayl marka: ['loo-diro:'] samee: { :liis-walxeed
	iska-leh qaatayaasha := liis-walxeed.
}.
 
Iimayl marka: ['cc:'] samee: { :liis-walxeed
	iska-leh cc := liis-walxeed.
}.

Iimayl marka: ['bcc:'] samee: { :liis-walxeed
	iska-leh bcc := liis-walxeed.
}.

Iimayl marka: ['mawduuc:'] samee: { :mawduuc
	iska-leh mawduuc := mawduuc.
}.

Iimayl marka: ['diraha:magac:'] samee: { :diraha :magac
	iska-leh diraha := diraha.
	iska-leh magaca-diraha := magac.
}.

Iimayl marka: ['jirka:'] samee: { :jirka
	iska-leh jirka := jirka.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Iimayl marka: ['madax:'] samee: { :sadar <- sadar beddel: ['\r'] ku: [''], beddel: ['\n'] ku: [''].
}.

Iimayl marka: ['dir'] samee: {
	>> f := Fayl tempwrite: naf abuur.
	Barnaamij nidaam: ['sendmail -t < '] + f waddada-faylka, sadar-cusub.
}.

Iimayl marka: ['abuur'] samee: {
	>> jebinta-sadarka := ['\r\n'].
	>> xarig-qoraal := [''].
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['From: '] + iska-leh magaca-diraha + [' <'] + ( iska-leh diraha ) + ['>']) + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['To: '] + ( iska-leh qaatayaasha isku-dar: [','] )) + jebinta-sadarka.
	iska-leh cc tirada-guud run: {
		xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Cc: '] + ( iska-leh cc isku-dar: [','] )) + jebinta-sadarka.
	}.
	iska-leh bcc tirada-guud run: {
		xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Bcc: '] + ( iska-leh bcc isku-dar: [','] )) + jebinta-sadarka.
	}.
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Subject: '] + iska-leh mawduuc) + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: iska-leh jirka.
	xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka. <- xarig-qoraal.
}.

>> Iimayl-HTML := Iimayl cusub.

Iimayl-HTML marka: ['diyaari'] samee: {
	naf diyaari.
	iska-leh lifaaqyo := Liis cusub.
	iska-leh xad := Khasnad token: 40.
}.

Iimayl-HTML marka: ['ku-lifaaq:'] samee: { :faylka-fadhiga
	>> id := iska-leh lifaaqyo tirada-guud.
	>> blob := faylka-fadhiga blob.
	iska-leh lifaaqyo dhammaadka-ku-dar: (
		Qaamuus cusub
			faylka-fadhiga: faylka-fadhiga waddada-faylka,
			mime: ['image/'] + (Server mimetype: faylka-fadhiga waddada-faylka),
			xog: blob base64-koodee
	).
	blob sii-daa. <- ['cid:attachment'] + id.
}.

Iimayl-HTML marka: ['abuur'] samee: {
	>> jebinta-sadarka := ['\r\n'].
	>> xarig-qoraal := [''].
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['From: '] + iska-leh magaca-diraha + [' <'] + ( iska-leh diraha ) + ['>']) + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['To: '] + ( iska-leh qaatayaasha isku-dar: [','] )) + jebinta-sadarka.
	iska-leh cc tirada-guud run: {
		xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Cc: '] + ( iska-leh cc isku-dar: [','] )) + jebinta-sadarka.
	}.
	iska-leh bcc tirada-guud run: {
		xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Bcc: '] + ( iska-leh bcc isku-dar: [','] )) + jebinta-sadarka.
	}.
	xarig-qoraal dhammaadka-ku-dar: (naf madax: ['Subject: '] + iska-leh mawduuc) + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: ['MIME-Version: 1.0'] + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: ['Content-Type: multipart/related; boundary="'] + iska-leh xad + ['"; type=text/html'] + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: ['--'] + iska-leh xad + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: ['Content-Type: text/html; charset=UTF-8'] + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: ['Content-Transfer-Encoding: 7bit'] + jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
	xarig-qoraal dhammaadka-ku-dar: iska-leh jirka.
	xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
	iska-leh lifaaqyo mid-kasta: { :id :macluumaad
		>> blob := macluumaad xog.
		xarig-qoraal dhammaadka-ku-dar: ['--'] + iska-leh xad + jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: ['Content-Type: '] + macluumaad mime + jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: ['Content-Transfer-Encoding: base64'] + jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: ['Content-ID: <attachment'] + id + ['>'] + jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: ['Content-Disposition: inline; filename="'] + macluumaad faylka-fadhiga + ['"'] + jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
		>> ugu-badnaan := 76.
		>> dhererka-qoraalka := blob dherer.
		>> gabalo := (dhererka-qoraalka / ugu-badnaan) kor-u-soo-koob.
		{ :i
			>> gabal := blob koobiyee ka: i * ugu-badnaan dherer: ugu-badnaan.
			xarig-qoraal dhammaadka-ku-dar: gabal + jebinta-sadarka.
		} * gabalo.
		xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
		xarig-qoraal dhammaadka-ku-dar: jebinta-sadarka.
	}.
	xarig-qoraal dhammaadka-ku-dar: ['--'] + iska-leh xad + ['--'] + jebinta-sadarka. <- xarig-qoraal.
}.
