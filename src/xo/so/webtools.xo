Codsi-HTTP marka: ['HTTP-madax:'] samee: { :fure <- Barnaamij dejin: fure.
}.

>> Madax-HTTP := Walax cusub.

Madax-HTTP marka: ['cusub'] samee: { <- naf cusub diyaari.
}.

Madax-HTTP marka: ['diyaari'] samee: {
	iska-leh fure := Waxba.
	iska-leh qiime := Waxba.
}.

Madax-HTTP marka: ['fure:qiime:'] samee: { :fure :qiime
	iska-leh fure := fure.
	iska-leh qiime := qiime.
}.

Madax-HTTP marka: ['fure'] samee: { <- iska-leh fure.
}.

Madax-HTTP marka: ['qiime'] samee: { <- iska-leh qiime.
}.


Madax-HTTP marka: ['qoraal'] samee: {
	>> sadar := iska-leh fure + [': '] + iska-leh qiime.
	sadar beddel: ['\r'] ku: [''], beddel: ['\n'] ku: ['']. <- sadar + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dukumeenti-Web := Walax cusub.

Dukumeenti-Web marka: ['cusub'] samee: { <- naf cusub diyaari.
}.

Dukumeenti-Web marka: ['diyaari'] samee: {
	iska-leh madaxyada := Liis cusub.
	iska-leh aqoonsiga-fadhiga := Waxba.
	iska-leh maamulaha-fadhiyada := Fadhi-fayl-ku-meel-gaar cusub.
	iska-leh xogta-fadhiga := Waxba.
	iska-leh ammaan := Run.
	iska-leh isla-goob := ['Strict'].
	iska-leh madaxyada-la-diray := Been.
	iska-leh codsi-http := Codsi-HTTP cusub.
}.

Dukumeenti-Web marka: ['codsi-http:'] samee: { :codsi-http
	iska-leh codsi-http := codsi-http.
}. 

Dukumeenti-Web marka: ['cookie-fadhi-ammaan:'] samee: { :ammaan
	naf hubi-madaxyada.
	iska-leh ammaan := ammaan.
}.

Dukumeenti-Web marka: ['cookie-fadhi-isla-goob:'] samee: { :qiime
	naf hubi-madaxyada.
	>> doorashooyin := Liis cusub 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	doorashooyin leeyahay: qiime, been: {
		hawshan qalad: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	iska-leh isla-goob := qiime.
}.

Dukumeenti-Web marka: ['madax:'] samee: { :madax
	naf hubi-madaxyada.
	iska-leh madaxyada dhammaadka-ku-dar: madax.
}.

Dukumeenti-Web marka: ['tirtir-madaxyada'] samee: {
	naf hubi-madaxyada.
	iska-leh madaxyada := Liis cusub.
}.

Dukumeenti-Web marka: ['maamulaha-fadhiyada:'] samee: { :maamule
	naf hubi-madaxyada.
	iska-leh maamulaha-fadhiyada := maamule.
}.

Dukumeenti-Web marka: ['maamulaha-fadhiyada'] samee: { <- iska-leh maamulaha-fadhiyada.
}.

Dukumeenti-Web marka: ['hubi-madaxyada'] samee: {
	iska-leh madaxyada-la-diray run: {
		hawshan qalad: ['Headers already sent to client.'].
	}.
}.

Dukumeenti-Web marka: ['bilow-fadhi'] samee: {
	naf hubi-madaxyada.
	>> codsi-http := iska-leh codsi-http.
	>> aqoonsiga-fadhiga := codsi-http cookie: ['xsid'].
	aqoonsiga-fadhiga Waxba? been: {
		(( Hannaan cusub: ['^[A-Za-z0-9]+\\z'], is-waafaq: aqoonsiga-fadhiga ) = 0) run: {
			aqoonsiga-fadhiga := Waxba.
		}.
	}.
	aqoonsiga-fadhiga Waxba? run: {
		aqoonsiga-fadhiga := Khasnad token: 30.
		>> madaxa-fadhiga := Madax-HTTP cusub
		fure: ['Set-Cookie'] qiime: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (iska-leh ammaan kan: ['Secure'] ama-kaas: ['']),
		SSITE: (iska-leh isla-goob),
		XSID: aqoonsiga-fadhiga
		).
		iska-leh madaxyada dhammaadka-ku-dar: madaxa-fadhiga.
	}.
	iska-leh xogta-fadhiga := iska-leh maamulaha-fadhiyada loogu: aqoonsiga-fadhiga, soo-rar. <- iska-leh xogta-fadhiga. # reference
}.

Dukumeenti-Web marka: ['u-gudub:'] samee: { :cinwaan
	naf hubi-madaxyada.
	naf tirtir-madaxyada.
	iska-leh madaxyada
	dhammaadka-ku-dar: (
		Madax-HTTP cusub
		fure: ['Status'] qiime: ['303 See Other']
	),
	dhammaadka-ku-dar: (
		Madax-HTTP cusub
		fure: ['Location'] qiime: cinwaan
	).
	naf soo-saar: ['Redirect'].
}.

Dukumeenti-Web marka: ['burburi-fadhiga'] samee: {
	naf hubi-madaxyada.
	>> codsi-http := iska-leh codsi-http.
	>> aqoonsiga-fadhiga := codsi-http cookie: ['xsid'].
	aqoonsiga-fadhiga Waxba? been: {
		>> madaxa-fadhiga := Madax-HTTP cusub.
		>> waqtiga-dhicitaanka := Xilli cusub sannad: 1970, qaab: ['%a, %d %b %Y %H:%M:%S GMT'].
		madaxa-fadhiga fure: ['Set-Cookie'] qiime: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: waqtiga-dhicitaanka,
			SEC: (iska-leh ammaan kan: ['Secure'] ama-kaas: ['']),
			SSITE: (iska-leh isla-goob),
			XSID: aqoonsiga-fadhiga
		).
		iska-leh maamulaha-fadhiyada burburi.
		iska-leh madaxyada dhammaadka-ku-dar: madaxa-fadhiga.
	}.
}.


Dukumeenti-Web marka: ['qaab-dhismeed:'] samee: { :waddada-faylka <- Qaab-dhismeed cusub: (Fayl cusub: waddada-faylka, akhri).
}.

Dukumeenti-Web marka: ['soo-saar:nooc:'] samee: { :natiijo :nooc
	iska-leh madaxyada-la-diray been: {
		iska-leh xogta-fadhiga Waxba? been: {
			iska-leh maamulaha-fadhiyada kaydi: iska-leh xogta-fadhiga.
		}.
		iska-leh madaxyada dhammaadka-ku-dar: (
			Madax-HTTP cusub
			fure: ['Content-type'] qiime: nooc
		).
		iska-leh madaxyada mid-kasta: { :_ :madax
			Soo-saar qor: madax.
		}.
		iska-leh madaxyada-la-diray := Run.
		Soo-saar qor: ['\r\n'].
	}.
	Soo-saar qor: natiijo.
}.

Dukumeenti-Web marka: ['dhammee:nooc:'] samee: { :natiijo :nooc
	iska-leh madaxyada-la-diray been: {
		iska-leh xogta-fadhiga Waxba? been: {
			iska-leh maamulaha-fadhiyada kaydi: iska-leh xogta-fadhiga.
		}.
		iska-leh madaxyada dhammaadka-ku-dar: (
			Madax-HTTP cusub
			fure: ['Content-type'] qiime: nooc
		).
		iska-leh madaxyada dhammaadka-ku-dar: (
			Madax-HTTP cusub
			fure: ['Content-Length'] qiime: natiijo qoraal bytes
		).
		iska-leh madaxyada mid-kasta: { :_ :madax
			Soo-saar qor: madax.
		}.
		iska-leh madaxyada-la-diray := Run.
		Soo-saar qor: ['\r\n'].
	}.
	Soo-saar qor: natiijo.
}.

Dukumeenti-Web marka: ['soo-saar:'] samee: { :natiijo
	naf soo-saar: natiijo nooc: ['text/html; charset=utf-8'].
}.

Dukumeenti-Web marka: ['dhammee:'] samee: { :natiijo
	naf dhammee: natiijo nooc: ['text/html; charset=utf-8'].
}.

Dukumeenti-Web marka: ['json:'] samee: { :natiijo
	naf soo-saar: ( JSON jsonify: natiijo ) nooc: ['application/json'].
}.

Dukumeenti-Web marka: ['lama-helin:'] samee: { :natiijo
	naf tirtir-madaxyada madax: (
		Madax-HTTP cusub fure: ['Status'] qiime: ['404 Not Found']
	).
	naf soo-saar: natiijo.
}.


# Interface

>> Fadhi := Walax cusub.

Fadhi marka: ['cusub'] samee: { <- naf cusub diyaari loogu: Waxba.
}.

Fadhi marka: ['loogu:'] samee: { :id
	iska-leh id := id.
}.

Fadhi marka: ['soo-rar'] samee: {
	hawshan qalad: ['Not implemented.'].
}.

Fadhi marka: ['kaydi:'] samee: {
	hawshan qalad: ['Not implemented.'].
}.

Fadhi marka: ['burburi'] samee: {
	hawshan qalad: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Fadhi-fayl-ku-meel-gaar := Fadhi cusub.

Fadhi-fayl-ku-meel-gaar marka: ['diyaari'] samee: {
	iska-leh bilowga-waddada := ['/tmp/sess-'].
}.

Fadhi-fayl-ku-meel-gaar marka: ['horgale-waddo:'] samee: { :xarig-qoraal
	iska-leh bilowga-waddada := xarig-qoraal.
}.

Fadhi-fayl-ku-meel-gaar marka: ['faylka-fadhiga'] samee: { <- ( Fayl cusub: ( iska-leh bilowga-waddada + iska-leh id + ['.txt'] ) ).
}.

Fadhi-fayl-ku-meel-gaar marka: ['soo-rar'] samee: {
	>> faylka-fadhiga := naf faylka-fadhiga.
	faylka-fadhiga jira been: {
		faylka-fadhiga qor: (Qaamuus cusub koodh).
	}. <- faylka-fadhiga akhri walax.
}.

Fadhi-fayl-ku-meel-gaar marka: ['kaydi:'] samee: { :xog
	>> faylka-fadhiga := naf faylka-fadhiga.
	faylka-fadhiga jira run: {
		faylka-fadhiga qor: xog koodh.
	}.
}.

Fadhi-fayl-ku-meel-gaar marka: ['burburi'] samee: {
	>> faylka-fadhiga := naf faylka-fadhiga.
	faylka-fadhiga jira run: {
		faylka-fadhiga tirtir.
	}.
}.


>> URL := Walax cusub.

URL marka: ['diyaari'] samee: {
	iska-leh nidaam-isgaarsiin := ['https://'].
	iska-leh martigeliye := ['localhost'].
	iska-leh waddada-faylka := [''].
	iska-leh halbeegyada-url := [''].
	iska-leh hash := [''].
}.

URL marka: ['cusub'] samee: { <- naf cusub diyaari.
}.

URL marka: ['qoraal'] samee: { <- (
	iska-leh nidaam-isgaarsiin +
	iska-leh martigeliye +
	iska-leh waddada-faylka +
	iska-leh halbeegyada-url +
	iska-leh hash ).
}.

URL marka: ['nidaam-isgaarsiin:'] samee: { :nidaam-isgaarsiin
	((Liis cusub ; ['http'] ; ['https']) leeyahay: nidaam-isgaarsiin) run: {
		iska-leh nidaam-isgaarsiin := nidaam-isgaarsiin + ['://'].
	}, been: {
		hawshan qalad: ['Invalid protocol'].
	}.
}.

URL marka: ['martigeliye:'] samee: { :martigeliye
	#todo validate according to rfc
	iska-leh martigeliye := martigeliye.
}.

URL marka: ['waddada-faylka:'] samee: { :waddada-faylka
	iska-leh waddada-faylka := ['/'] + waddada-faylka url-koodee.
}.

URL marka: ['halbeegyada-url:'] samee: { :khariidayn
	>> halbeegyada-url := Liis cusub.
	khariidayn mid-kasta: { :fure :qiime
		halbeegyada-url dhammaadka-ku-dar: fure qoraal url-koodee + ['='] + qiime qoraal url-koodee.
	}.
	iska-leh halbeegyada-url := ['?'] + ( halbeegyada-url isku-dar: ['&'] ).
}.

URL marka: ['hash:'] samee: { :hash
	iska-leh hash := ['#'] + hash url-koodee.
}.

