
# ~ Simple template engine ~

>> Plantilla := Objecte nou.

Plantilla en: ['nou'] fes: { <- jo nou contingut: [''].
}.

Plantilla en: ['contingut:'] fes: { :contingut
	propi contingut := contingut. 
}.

Plantilla en: ['nou:'] fes: { :contingut <- jo nou contingut: contingut.
}.

Plantilla en: ['retallar:'] fes: { :marcador
	>> marcador-inici := (['<!-- cut:%id% -->'] %id%: marcador).
	>> marcador-final := (['<!-- /cut:%id% -->'] %id%: marcador).
	>> parts := propi contingut divideix: marcador-inici.
	>> prefix := parts primer.
	>> parts2 := parts últim divideix: marcador-final.
	>> sufix := parts2 últim.
	>> part := parts2 primer.
	>> resta := prefix + sufix.
	propi contingut := resta. <- Plantilla nou: part.
	
}.

Plantilla en: ['copia'] fes: { <- jo nou: jo text copia.
}.
	
Plantilla en: ['enganxar:a:'] fes: { :retall :id
	>> marcador-enganxar := (['<!-- paste:%id% -->'] %id%: id).
	propi contingut substitueix: marcador-enganxar per: ( retall text + marcador-enganxar ).
}.

Plantilla en: ['estableix:valor:'] fes: { :espai :valor
	propi contingut substitueix: ['<!-- slot:'] + espai + [' -->'] per: ( Server html-codifica: valor ).
}.

Plantilla en: ['estableix:html:'] fes: { :espai :html
	propi contingut substitueix: ['<!-- slot:'] + espai + [' -->'] per: html.
}.

Plantilla en: ['respon:i:'] fes: { :espai :valor
	jo estableix: (espai de: 0 longitud: (espai longitud - 1)) valor: valor.
}.

Plantilla en: ['nl2br'] fes: {
	propi contingut substitueix: ['\n'] per: ['<br>'].
}.

Plantilla en: ['netejar'] fes: {
	propi contingut :=
		Patró
		nou: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		coincidència: propi contingut
		fes: { <- ['']. }.
}.

Plantilla en: ['netejar-talls'] fes: {
	>> elements := Llista nou.
	Patró
	nou: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	coincidència: propi contingut
	fes: { :_ :part
		elements afegeix-al-final: part ? 1.
	}.
	elements cada: { :_ :id
		propi contingut :=
			Patró nou: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			coincidència: propi contingut
			fes: { <- ['']. }.
	 }.
}.

Plantilla en: ['netejar-espais'] fes: {
	propi contingut :=
		Patró
		nou: ['\\s*\\n'],
		coincidència: propi contingut
		fes: { <- ['\n']. }.
	propi contingut :=
		Patró
		nou: ['\\n[\\s\\t]+'],
		coincidència: propi contingut
		fes: { <- ['\n']. }.
}.

Plantilla en: ['netejar-tot'] fes: {
	jo netejar.
	jo netejar-talls.
	jo netejar-espais.
}.

Plantilla en: ['text'] fes: { <- propi contingut.
}.
