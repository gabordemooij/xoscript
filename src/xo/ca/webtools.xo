Petició-HTTP en: ['HTTP-capçalera:'] fes: { :clau <- Programa configuració: clau.
}.

>> Capçalera-HTTP := Objecte nou.

Capçalera-HTTP en: ['nou'] fes: { <- jo nou inicialitzar.
}.

Capçalera-HTTP en: ['inicialitzar'] fes: {
	propi clau := Res.
	propi valor := Res.
}.

Capçalera-HTTP en: ['clau:valor:'] fes: { :clau :valor
	propi clau := clau.
	propi valor := valor.
}.

Capçalera-HTTP en: ['clau'] fes: { <- propi clau.
}.

Capçalera-HTTP en: ['valor'] fes: { <- propi valor.
}.


Capçalera-HTTP en: ['text'] fes: {
	>> línia := propi clau + [': '] + propi valor.
	línia substitueix: ['\r'] per: [''], substitueix: ['\n'] per: ['']. <- línia + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Document-Web := Objecte nou.

Document-Web en: ['nou'] fes: { <- jo nou inicialitzar.
}.

Document-Web en: ['inicialitzar'] fes: {
	propi capçaleres := Llista nou.
	propi id-sessió := Res.
	propi gestor-sessió := Sessió-fitxer-temporal nou.
	propi dades-sessió := Res.
	propi segur := Cert.
	propi mateix-lloc := ['Strict'].
	propi capçaleres-enviades := Fals.
	propi petició := Petició-HTTP nou.
}.

Document-Web en: ['petició:'] fes: { :petició
	propi petició := petició.
}. 

Document-Web en: ['galeta-sessió-segura:'] fes: { :segur
	jo comprovar-capçaleres.
	propi segur := segur.
}.

Document-Web en: ['galeta-sessió-mateix-lloc:'] fes: { :valor
	jo comprovar-capçaleres.
	>> opcions := Llista nou 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcions té: valor, fals: {
		aquesta-tasca error: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propi mateix-lloc := valor.
}.

Document-Web en: ['capçalera:'] fes: { :capçalera
	jo comprovar-capçaleres.
	propi capçaleres afegeix-al-final: capçalera.
}.

Document-Web en: ['buidar-capçaleres'] fes: {
	jo comprovar-capçaleres.
	propi capçaleres := Llista nou.
}.

Document-Web en: ['gestor-sessió:'] fes: { :gestor
	jo comprovar-capçaleres.
	propi gestor-sessió := gestor.
}.

Document-Web en: ['gestor-sessió'] fes: { <- propi gestor-sessió.
}.

Document-Web en: ['comprovar-capçaleres'] fes: {
	propi capçaleres-enviades cert: {
		aquesta-tasca error: ['Headers already sent to client.'].
	}.
}.

Document-Web en: ['iniciar-sessió'] fes: {
	jo comprovar-capçaleres.
	>> petició := propi petició.
	>> id-sessió := petició cookie: ['xsid'].
	id-sessió Res? fals: {
		(( Patró nou: ['^[A-Za-z0-9]+\\z'], coincidència: id-sessió ) = 0) cert: {
			id-sessió := Res.
		}.
	}.
	id-sessió Res? cert: {
		id-sessió := Caixa-forta token: 30.
		>> capçalera-sessió := Capçalera-HTTP nou
		clau: ['Set-Cookie'] valor: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propi segur o-bé: ['Secure'] o: ['']),
		SSITE: (propi mateix-lloc),
		XSID: id-sessió
		).
		propi capçaleres afegeix-al-final: capçalera-sessió.
	}.
	propi dades-sessió := propi gestor-sessió per-a: id-sessió, carregar. <- propi dades-sessió. # reference
}.

Document-Web en: ['anar-a:'] fes: { :adreça
	jo comprovar-capçaleres.
	jo buidar-capçaleres.
	propi capçaleres
	afegeix-al-final: (
		Capçalera-HTTP nou
		clau: ['Status'] valor: ['303 See Other']
	),
	afegeix-al-final: (
		Capçalera-HTTP nou
		clau: ['Location'] valor: adreça
	).
	jo emetre: ['Redirect'].
}.

Document-Web en: ['destruir-sessió'] fes: {
	jo comprovar-capçaleres.
	>> petició := propi petició.
	>> id-sessió := petició cookie: ['xsid'].
	id-sessió Res? fals: {
		>> capçalera-sessió := Capçalera-HTTP nou.
		>> moment := Moment nou any: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		capçalera-sessió clau: ['Set-Cookie'] valor: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: moment,
			SEC: (propi segur o-bé: ['Secure'] o: ['']),
			SSITE: (propi mateix-lloc),
			XSID: id-sessió
		).
		propi gestor-sessió destruir.
		propi capçaleres afegeix-al-final: capçalera-sessió.
	}.
}.


Document-Web en: ['plantilla:'] fes: { :camí <- Plantilla nou: (Fitxer nou: camí, llegeix).
}.

Document-Web en: ['emetre:tipus:'] fes: { :sortida :tipus
	propi capçaleres-enviades fals: {
		propi dades-sessió Res? fals: {
			propi gestor-sessió desar: propi dades-sessió.
		}.
		propi capçaleres afegeix-al-final: (
			Capçalera-HTTP nou
			clau: ['Content-type'] valor: tipus
		).
		propi capçaleres cada: { :_ :capçalera
			Sortida escriu: capçalera.
		}.
		propi capçaleres-enviades := Cert.
		Sortida escriu: ['\r\n'].
	}.
	Sortida escriu: sortida.
}.

Document-Web en: ['finalitzar:tipus:'] fes: { :sortida :tipus
	propi capçaleres-enviades fals: {
		propi dades-sessió Res? fals: {
			propi gestor-sessió desar: propi dades-sessió.
		}.
		propi capçaleres afegeix-al-final: (
			Capçalera-HTTP nou
			clau: ['Content-type'] valor: tipus
		).
		propi capçaleres afegeix-al-final: (
			Capçalera-HTTP nou
			clau: ['Content-Length'] valor: sortida text bytes
		).
		propi capçaleres cada: { :_ :capçalera
			Sortida escriu: capçalera.
		}.
		propi capçaleres-enviades := Cert.
		Sortida escriu: ['\r\n'].
	}.
	Sortida escriu: sortida.
}.

Document-Web en: ['emetre:'] fes: { :sortida
	jo emetre: sortida tipus: ['text/html; charset=utf-8'].
}.

Document-Web en: ['finalitzar:'] fes: { :sortida
	jo finalitzar: sortida tipus: ['text/html; charset=utf-8'].
}.

Document-Web en: ['json:'] fes: { :sortida
	jo emetre: ( JSON jsonify: sortida ) tipus: ['application/json'].
}.

Document-Web en: ['no-trobat:'] fes: { :sortida
	jo buidar-capçaleres capçalera: (
		Capçalera-HTTP nou clau: ['Status'] valor: ['404 Not Found']
	).
	jo emetre: sortida.
}.


# Interface

>> Sessió := Objecte nou.

Sessió en: ['nou'] fes: { <- jo nou inicialitzar per-a: Res.
}.

Sessió en: ['per-a:'] fes: { :id
	propi id := id.
}.

Sessió en: ['carregar'] fes: {
	aquesta-tasca error: ['Not implemented.'].
}.

Sessió en: ['desar:'] fes: {
	aquesta-tasca error: ['Not implemented.'].
}.

Sessió en: ['destruir'] fes: {
	aquesta-tasca error: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sessió-fitxer-temporal := Sessió nou.

Sessió-fitxer-temporal en: ['inicialitzar'] fes: {
	propi prefixcamí := ['/tmp/sess-'].
}.

Sessió-fitxer-temporal en: ['prefix-camí:'] fes: { :cadena
	propi prefixcamí := cadena.
}.

Sessió-fitxer-temporal en: ['fitxer'] fes: { <- ( Fitxer nou: ( propi prefixcamí + propi id + ['.txt'] ) ).
}.

Sessió-fitxer-temporal en: ['carregar'] fes: {
	>> fitxer := jo fitxer.
	fitxer existeix fals: {
		fitxer escriu: (Diccionari nou codi).
	}. <- fitxer llegeix objecte.
}.

Sessió-fitxer-temporal en: ['desar:'] fes: { :dades
	>> fitxer := jo fitxer.
	fitxer existeix cert: {
		fitxer escriu: dades codi.
	}.
}.

Sessió-fitxer-temporal en: ['destruir'] fes: {
	>> fitxer := jo fitxer.
	fitxer existeix cert: {
		fitxer suprimeix.
	}.
}.


>> URL := Objecte nou.

URL en: ['inicialitzar'] fes: {
	propi protocol := ['https://'].
	propi amfitrió := ['localhost'].
	propi camí := [''].
	propi paràmetres-url := [''].
	propi hash := [''].
}.

URL en: ['nou'] fes: { <- jo nou inicialitzar.
}.

URL en: ['text'] fes: { <- (
	propi protocol +
	propi amfitrió +
	propi camí +
	propi paràmetres-url +
	propi hash ).
}.

URL en: ['protocol:'] fes: { :protocol
	((Llista nou ; ['http'] ; ['https']) té: protocol) cert: {
		propi protocol := protocol + ['://'].
	}, fals: {
		aquesta-tasca error: ['Invalid protocol'].
	}.
}.

URL en: ['amfitrió:'] fes: { :amfitrió
	#todo validate according to rfc
	propi amfitrió := amfitrió.
}.

URL en: ['camí:'] fes: { :camí
	propi camí := ['/'] + camí url-codifica.
}.

URL en: ['paràmetres-url:'] fes: { :mapa
	>> paràmetres-url := Llista nou.
	mapa cada: { :clau :valor
		paràmetres-url afegeix-al-final: clau text url-codifica + ['='] + valor text url-codifica.
	}.
	propi paràmetres-url := ['?'] + ( paràmetres-url uneix: ['&'] ).
}.

URL en: ['resum:'] fes: { :hash
	propi hash := ['#'] + hash url-codifica.
}.

