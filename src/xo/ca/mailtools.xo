>> Correu := Objecte nou.

Correu en: ['inicialitzar'] fes: {
	propi destinataris := Llista nou.
	propi cc := Llista nou.
	propi bcc := Llista nou.
	propi remitent := Res.
	propi nom-remitent := Res.
	propi assumpte := Res.
	propi cos-missatge := Res.
}.

Correu en: ['nou'] fes: { <- jo nou inicialitzar.
}.

Correu en: ['destinatari:'] fes: { :llista
	propi destinataris := llista.
}.
 
Correu en: ['cc:'] fes: { :llista
	propi cc := llista.
}.

Correu en: ['bcc:'] fes: { :llista
	propi bcc := llista.
}.

Correu en: ['assumpte:'] fes: { :assumpte
	propi assumpte := assumpte.
}.

Correu en: ['remitent:nom:'] fes: { :remitent :nom
	propi remitent := remitent.
	propi nom-remitent := nom.
}.

Correu en: ['cos-missatge:'] fes: { :cos-missatge
	propi cos-missatge := cos-missatge.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Correu en: ['capçalera:'] fes: { :línia <- línia substitueix: ['\r'] per: [''], substitueix: ['\n'] per: [''].
}.

Correu en: ['enviar'] fes: {
	>> f := Fitxer tempwrite: jo generar.
	Programa sistema: ['sendmail -t < '] + f camí, salt-de-línia.
}.

Correu en: ['generar'] fes: {
	>> salt := ['\r\n'].
	>> cadena := [''].
	cadena afegeix-al-final: (jo capçalera: ['From: '] + propi nom-remitent + [' <'] + ( propi remitent ) + ['>']) + salt.
	cadena afegeix-al-final: (jo capçalera: ['To: '] + ( propi destinataris uneix: [','] )) + salt.
	propi cc compta cert: {
		cadena afegeix-al-final: (jo capçalera: ['Cc: '] + ( propi cc uneix: [','] )) + salt.
	}.
	propi bcc compta cert: {
		cadena afegeix-al-final: (jo capçalera: ['Bcc: '] + ( propi bcc uneix: [','] )) + salt.
	}.
	cadena afegeix-al-final: (jo capçalera: ['Subject: '] + propi assumpte) + salt.
	cadena afegeix-al-final: salt.
	cadena afegeix-al-final: propi cos-missatge.
	cadena afegeix-al-final: salt. <- cadena.
}.

>> Correu-HTML := Correu nou.

Correu-HTML en: ['inicialitzar'] fes: {
	jo inicialitzar.
	propi adjunts := Llista nou.
	propi frontera := Caixa-forta token: 40.
}.

Correu-HTML en: ['adjuntar:'] fes: { :fitxer
	>> id := propi adjunts compta.
	>> blob := fitxer blob.
	propi adjunts afegeix-al-final: (
		Diccionari nou
			fitxer: fitxer camí,
			mime: ['image/'] + (Server mimetype: fitxer camí),
			dades: blob base64-codifica
	).
	blob allibera. <- ['cid:attachment'] + id.
}.

Correu-HTML en: ['generar'] fes: {
	>> salt := ['\r\n'].
	>> cadena := [''].
	cadena afegeix-al-final: (jo capçalera: ['From: '] + propi nom-remitent + [' <'] + ( propi remitent ) + ['>']) + salt.
	cadena afegeix-al-final: (jo capçalera: ['To: '] + ( propi destinataris uneix: [','] )) + salt.
	propi cc compta cert: {
		cadena afegeix-al-final: (jo capçalera: ['Cc: '] + ( propi cc uneix: [','] )) + salt.
	}.
	propi bcc compta cert: {
		cadena afegeix-al-final: (jo capçalera: ['Bcc: '] + ( propi bcc uneix: [','] )) + salt.
	}.
	cadena afegeix-al-final: (jo capçalera: ['Subject: '] + propi assumpte) + salt.
	cadena afegeix-al-final: ['MIME-Version: 1.0'] + salt.
	cadena afegeix-al-final: ['Content-Type: multipart/related; boundary="'] + propi frontera + ['"; type=text/html'] + salt.
	cadena afegeix-al-final: salt.
	cadena afegeix-al-final: ['--'] + propi frontera + salt.
	cadena afegeix-al-final: ['Content-Type: text/html; charset=UTF-8'] + salt.
	cadena afegeix-al-final: ['Content-Transfer-Encoding: 7bit'] + salt.
	cadena afegeix-al-final: salt.
	cadena afegeix-al-final: propi cos-missatge.
	cadena afegeix-al-final: salt.
	propi adjunts cada: { :id :info
		>> blob := info dades.
		cadena afegeix-al-final: ['--'] + propi frontera + salt.
		cadena afegeix-al-final: ['Content-Type: '] + info mime + salt.
		cadena afegeix-al-final: ['Content-Transfer-Encoding: base64'] + salt.
		cadena afegeix-al-final: ['Content-ID: <attachment'] + id + ['>'] + salt.
		cadena afegeix-al-final: ['Content-Disposition: inline; filename="'] + info fitxer + ['"'] + salt.
		cadena afegeix-al-final: salt.
		>> sostre := 76.
		>> llargada-text := blob longitud.
		>> trossos := (llargada-text / sostre) arrodoneix-amunt.
		{ :i
			>> tros := blob copia de: i * sostre longitud: sostre.
			cadena afegeix-al-final: tros + salt.
		} * trossos.
		cadena afegeix-al-final: salt.
		cadena afegeix-al-final: salt.
	}.
	cadena afegeix-al-final: ['--'] + propi frontera + ['--'] + salt. <- cadena.
}.
