>> Email := Objecte nou.

Email en: ['init'] fes: {
	propi recipients := Llista nou.
	propi cc := Llista nou.
	propi bcc := Llista nou.
	propi from := Res.
	propi from-name := Res.
	propi subject := Res.
	propi body := Res.
}.

Email en: ['nou'] fes: { <- jo nou init.
}.

Email en: ['to:'] fes: { :list
	propi recipients := list.
}.
 
Email en: ['cc:'] fes: { :list
	propi cc := list.
}.

Email en: ['bcc:'] fes: { :list
	propi bcc := list.
}.

Email en: ['subject:'] fes: { :subject
	propi subject := subject.
}.

Email en: ['from:name:'] fes: { :from :nom
	propi from := from.
	propi from-name := nom.
}.

Email en: ['body:'] fes: { :body
	propi body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email en: ['header:'] fes: { :line <- line substitueix: ['\r'] per: [''], substitueix: ['\n'] per: [''].
}.

Email en: ['send'] fes: {
	>> f := Fitxer tempwrite: jo generate.
	Programa sistema: ['sendmail -t < '] + f camí, salt-de-línia.
}.

Email en: ['generate'] fes: {
	>> brk := ['\r\n'].
	>> str := [''].
	str afegeix-al-final: (jo header: ['From: '] + propi from-name + [' <'] + ( propi from ) + ['>']) + brk.
	str afegeix-al-final: (jo header: ['To: '] + ( propi recipients uneix: [','] )) + brk.
	propi cc compta cert: {
		str afegeix-al-final: (jo header: ['Cc: '] + ( propi cc uneix: [','] )) + brk.
	}.
	propi bcc compta cert: {
		str afegeix-al-final: (jo header: ['Bcc: '] + ( propi bcc uneix: [','] )) + brk.
	}.
	str afegeix-al-final: (jo header: ['Subject: '] + propi subject) + brk.
	str afegeix-al-final: brk.
	str afegeix-al-final: propi body.
	str afegeix-al-final: brk. <- str.
}.

>> HTML-Email := Email nou.

HTML-Email en: ['init'] fes: {
	jo init.
	propi attachments := Llista nou.
	propi boundary := Caixa-forta token: 40.
}.

HTML-Email en: ['attach:'] fes: { :file
	>> id := propi attachments compta.
	>> blob := file blob.
	propi attachments afegeix-al-final: (
		Diccionari nou
			file: file camí,
			mime: ['image/'] + (Server mimetype: file camí),
			data: blob base64-codifica
	).
	blob allibera. <- ['cid:attachment'] + id.
}.

HTML-Email en: ['generate'] fes: {
	>> brk := ['\r\n'].
	>> str := [''].
	str afegeix-al-final: (jo header: ['From: '] + propi from-name + [' <'] + ( propi from ) + ['>']) + brk.
	str afegeix-al-final: (jo header: ['To: '] + ( propi recipients uneix: [','] )) + brk.
	propi cc compta cert: {
		str afegeix-al-final: (jo header: ['Cc: '] + ( propi cc uneix: [','] )) + brk.
	}.
	propi bcc compta cert: {
		str afegeix-al-final: (jo header: ['Bcc: '] + ( propi bcc uneix: [','] )) + brk.
	}.
	str afegeix-al-final: (jo header: ['Subject: '] + propi subject) + brk.
	str afegeix-al-final: ['MIME-Version: 1.0'] + brk.
	str afegeix-al-final: ['Content-Type: multipart/related; boundary="'] + propi boundary + ['"; type=text/html'] + brk.
	str afegeix-al-final: brk.
	str afegeix-al-final: ['--'] + propi boundary + brk.
	str afegeix-al-final: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str afegeix-al-final: ['Content-Transfer-Encoding: 7bit'] + brk.
	str afegeix-al-final: brk.
	str afegeix-al-final: propi body.
	str afegeix-al-final: brk.
	propi attachments cada: { :id :info
		>> blob := info data.
		str afegeix-al-final: ['--'] + propi boundary + brk.
		str afegeix-al-final: ['Content-Type: '] + info mime + brk.
		str afegeix-al-final: ['Content-Transfer-Encoding: base64'] + brk.
		str afegeix-al-final: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str afegeix-al-final: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str afegeix-al-final: brk.
		>> max := 76.
		>> len := blob longitud.
		>> chunks := (len / max) arrodoneix-amunt.
		{ :i
			>> chunk := blob copia de: i * max longitud: max.
			str afegeix-al-final: chunk + brk.
		} * chunks.
		str afegeix-al-final: brk.
		str afegeix-al-final: brk.
	}.
	str afegeix-al-final: ['--'] + propi boundary + ['--'] + brk. <- str.
}.
