>> Elektron-pochta := Obyekt yangi.

Elektron-pochta kelganda: ['ishga-tushir'] bajar: {
	oʻzining qabul-qiluvchilar := Roʻyxat yangi.
	oʻzining cc := Roʻyxat yangi.
	oʻzining bcc := Roʻyxat yangi.
	oʻzining yuboruvchi := Hech.
	oʻzining yuboruvchi-nomi := Hech.
	oʻzining mavzu := Hech.
	oʻzining tana := Hech.
}.

Elektron-pochta kelganda: ['yangi'] bajar: { <- oʻzi yangi ishga-tushir.
}.

Elektron-pochta kelganda: ['qabul-qiluvchiga:'] bajar: { :sanab-oʻtish
	oʻzining qabul-qiluvchilar := sanab-oʻtish.
}.
 
Elektron-pochta kelganda: ['cc:'] bajar: { :sanab-oʻtish
	oʻzining cc := sanab-oʻtish.
}.

Elektron-pochta kelganda: ['bcc:'] bajar: { :sanab-oʻtish
	oʻzining bcc := sanab-oʻtish.
}.

Elektron-pochta kelganda: ['mavzu:'] bajar: { :mavzu
	oʻzining mavzu := mavzu.
}.

Elektron-pochta kelganda: ['yuboruvchi:nom:'] bajar: { :yuboruvchi :nom
	oʻzining yuboruvchi := yuboruvchi.
	oʻzining yuboruvchi-nomi := nom.
}.

Elektron-pochta kelganda: ['tana:'] bajar: { :tana
	oʻzining tana := tana.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Elektron-pochta kelganda: ['sarlavha:'] bajar: { :qator <- qator almashtirish: ['\r'] bunga: [''], almashtirish: ['\n'] bunga: [''].
}.

Elektron-pochta kelganda: ['yubor'] bajar: {
	>> f := Fayl tempwrite: oʻzi yarat.
	Dastur tizim: ['sendmail -t < '] + f yoʻl, yangi-qator.
}.

Elektron-pochta kelganda: ['yarat'] bajar: {
	>> qator-uzilishi := ['\r\n'].
	>> satr := [''].
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['From: '] + oʻzining yuboruvchi-nomi + [' <'] + ( oʻzining yuboruvchi ) + ['>']) + qator-uzilishi.
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['To: '] + ( oʻzining qabul-qiluvchilar birlashtirish: [','] )) + qator-uzilishi.
	oʻzining cc soni rost-boʻlsa: {
		satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Cc: '] + ( oʻzining cc birlashtirish: [','] )) + qator-uzilishi.
	}.
	oʻzining bcc soni rost-boʻlsa: {
		satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Bcc: '] + ( oʻzining bcc birlashtirish: [','] )) + qator-uzilishi.
	}.
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Subject: '] + oʻzining mavzu) + qator-uzilishi.
	satr oxiriga-qoʻshish: qator-uzilishi.
	satr oxiriga-qoʻshish: oʻzining tana.
	satr oxiriga-qoʻshish: qator-uzilishi. <- satr.
}.

>> HTML-Elektron-pochta := Elektron-pochta yangi.

HTML-Elektron-pochta kelganda: ['ishga-tushir'] bajar: {
	oʻzi ishga-tushir.
	oʻzining ilovalar := Roʻyxat yangi.
	oʻzining chegara := Seyf token: 40.
}.

HTML-Elektron-pochta kelganda: ['biriktir:'] bajar: { :fayl
	>> id := oʻzining ilovalar soni.
	>> blob := fayl blob.
	oʻzining ilovalar oxiriga-qoʻshish: (
		Lugʻat yangi
			fayl: fayl yoʻl,
			mime: ['image/'] + (Server mimetype: fayl yoʻl),
			maʼlumotlar: blob base64-kodlash
	).
	blob boʻshatish. <- ['cid:attachment'] + id.
}.

HTML-Elektron-pochta kelganda: ['yarat'] bajar: {
	>> qator-uzilishi := ['\r\n'].
	>> satr := [''].
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['From: '] + oʻzining yuboruvchi-nomi + [' <'] + ( oʻzining yuboruvchi ) + ['>']) + qator-uzilishi.
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['To: '] + ( oʻzining qabul-qiluvchilar birlashtirish: [','] )) + qator-uzilishi.
	oʻzining cc soni rost-boʻlsa: {
		satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Cc: '] + ( oʻzining cc birlashtirish: [','] )) + qator-uzilishi.
	}.
	oʻzining bcc soni rost-boʻlsa: {
		satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Bcc: '] + ( oʻzining bcc birlashtirish: [','] )) + qator-uzilishi.
	}.
	satr oxiriga-qoʻshish: (oʻzi sarlavha: ['Subject: '] + oʻzining mavzu) + qator-uzilishi.
	satr oxiriga-qoʻshish: ['MIME-Version: 1.0'] + qator-uzilishi.
	satr oxiriga-qoʻshish: ['Content-Type: multipart/related; boundary="'] + oʻzining chegara + ['"; type=text/html'] + qator-uzilishi.
	satr oxiriga-qoʻshish: qator-uzilishi.
	satr oxiriga-qoʻshish: ['--'] + oʻzining chegara + qator-uzilishi.
	satr oxiriga-qoʻshish: ['Content-Type: text/html; charset=UTF-8'] + qator-uzilishi.
	satr oxiriga-qoʻshish: ['Content-Transfer-Encoding: 7bit'] + qator-uzilishi.
	satr oxiriga-qoʻshish: qator-uzilishi.
	satr oxiriga-qoʻshish: oʻzining tana.
	satr oxiriga-qoʻshish: qator-uzilishi.
	oʻzining ilovalar har-bir: { :id :axborot
		>> blob := axborot maʼlumotlar.
		satr oxiriga-qoʻshish: ['--'] + oʻzining chegara + qator-uzilishi.
		satr oxiriga-qoʻshish: ['Content-Type: '] + axborot mime + qator-uzilishi.
		satr oxiriga-qoʻshish: ['Content-Transfer-Encoding: base64'] + qator-uzilishi.
		satr oxiriga-qoʻshish: ['Content-ID: <attachment'] + id + ['>'] + qator-uzilishi.
		satr oxiriga-qoʻshish: ['Content-Disposition: inline; filename="'] + axborot fayl + ['"'] + qator-uzilishi.
		satr oxiriga-qoʻshish: qator-uzilishi.
		>> eng-koʻp := 76.
		>> matn-uzunligi := blob uzunlik.
		>> boʻlaklar := (matn-uzunligi / eng-koʻp) yuqoriga-yaxlitlash.
		{ :i
			>> boʻlak := blob nusxa boshlab: i * eng-koʻp uzunlik: eng-koʻp.
			satr oxiriga-qoʻshish: boʻlak + qator-uzilishi.
		} * boʻlaklar.
		satr oxiriga-qoʻshish: qator-uzilishi.
		satr oxiriga-qoʻshish: qator-uzilishi.
	}.
	satr oxiriga-qoʻshish: ['--'] + oʻzining chegara + ['--'] + qator-uzilishi. <- satr.
}.
