
# ~ Simple template engine ~

>> Qolip := Obyekt yangi.

Qolip kelganda: ['yangi'] bajar: { <- oʻzi yangi mazmun: [''].
}.

Qolip kelganda: ['mazmun:'] bajar: { :mazmun
	oʻzining mazmun := mazmun. 
}.

Qolip kelganda: ['yangi:'] bajar: { :mazmun <- oʻzi yangi mazmun: mazmun.
}.

Qolip kelganda: ['kes:'] bajar: { :belgi
	>> boshlanish-belgisi := (['<!-- cut:%id% -->'] %id%: belgi).
	>> tugash-belgisi := (['<!-- /cut:%id% -->'] %id%: belgi).
	>> qismlar := oʻzining mazmun boʻlish: boshlanish-belgisi.
	>> prefiks := qismlar birinchi.
	>> qismlar2 := qismlar oxirgi boʻlish: tugash-belgisi.
	>> qoʻshimcha := qismlar2 oxirgi.
	>> qism := qismlar2 birinchi.
	>> qoldiq := prefiks + qoʻshimcha.
	oʻzining mazmun := qoldiq. <- Qolip yangi: qism.
	
}.

Qolip kelganda: ['nusxa'] bajar: { <- oʻzi yangi: oʻzi matn nusxa.
}.
	
Qolip kelganda: ['joylashtir:kalit:'] bajar: { :parcha :id
	>> joylashtirish-belgisi := (['<!-- paste:%id% -->'] %id%: id).
	oʻzining mazmun almashtirish: joylashtirish-belgisi bunga: ( parcha matn + joylashtirish-belgisi ).
}.

Qolip kelganda: ['oʻrnatish:qiymat:'] bajar: { :oʻrin :qiymat
	oʻzining mazmun almashtirish: ['<!-- slot:'] + oʻrin + [' -->'] bunga: ( Server html-kodlash: qiymat ).
}.

Qolip kelganda: ['oʻrnatish:html:'] bajar: { :oʻrin :html
	oʻzining mazmun almashtirish: ['<!-- slot:'] + oʻrin + [' -->'] bunga: html.
}.

Qolip kelganda: ['javob:va:'] bajar: { :oʻrin :qiymat
	oʻzi oʻrnatish: (oʻrin boshlab: 0 uzunlik: (oʻrin uzunlik - 1)) qiymat: qiymat.
}.

Qolip kelganda: ['nl2br'] bajar: {
	oʻzining mazmun almashtirish: ['\n'] bunga: ['<br>'].
}.

Qolip kelganda: ['tartibla'] bajar: {
	oʻzining mazmun :=
		Andoza
		yangi: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		moslik: oʻzining mazmun
		bajar: { <- ['']. }.
}.

Qolip kelganda: ['kesmalarni-tartibla'] bajar: {
	>> elementlar := Roʻyxat yangi.
	Andoza
	yangi: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	moslik: oʻzining mazmun
	bajar: { :_ :qism
		elementlar oxiriga-qoʻshish: qism ? 1.
	}.
	elementlar har-bir: { :_ :id
		oʻzining mazmun :=
			Andoza yangi: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			moslik: oʻzining mazmun
			bajar: { <- ['']. }.
	 }.
}.

Qolip kelganda: ['boʻshliqlarni-tartibla'] bajar: {
	oʻzining mazmun :=
		Andoza
		yangi: ['\\s*\\n'],
		moslik: oʻzining mazmun
		bajar: { <- ['\n']. }.
	oʻzining mazmun :=
		Andoza
		yangi: ['\\n[\\s\\t]+'],
		moslik: oʻzining mazmun
		bajar: { <- ['\n']. }.
}.

Qolip kelganda: ['hammasini-tartibla'] bajar: {
	oʻzi tartibla.
	oʻzi kesmalarni-tartibla.
	oʻzi boʻshliqlarni-tartibla.
}.

Qolip kelganda: ['matn'] bajar: { <- oʻzining mazmun.
}.
