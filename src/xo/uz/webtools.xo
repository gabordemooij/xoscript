HTTP-Soʻrov kelganda: ['HTTP-sarlavha:'] bajar: { :kalit <- Dastur sozlama: kalit.
}.

>> HTTP-Sarlavha := Obyekt yangi.

HTTP-Sarlavha kelganda: ['yangi'] bajar: { <- oʻzi yangi ishga-tushir.
}.

HTTP-Sarlavha kelganda: ['ishga-tushir'] bajar: {
	oʻzining kalit := Hech.
	oʻzining qiymat := Hech.
}.

HTTP-Sarlavha kelganda: ['kalit:qiymat:'] bajar: { :kalit :qiymat
	oʻzining kalit := kalit.
	oʻzining qiymat := qiymat.
}.

HTTP-Sarlavha kelganda: ['kalit'] bajar: { <- oʻzining kalit.
}.

HTTP-Sarlavha kelganda: ['qiymat'] bajar: { <- oʻzining qiymat.
}.


HTTP-Sarlavha kelganda: ['matn'] bajar: {
	>> qator := oʻzining kalit + [': '] + oʻzining qiymat.
	qator almashtirish: ['\r'] bunga: [''], almashtirish: ['\n'] bunga: ['']. <- qator + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Veb-hujjat := Obyekt yangi.

Veb-hujjat kelganda: ['yangi'] bajar: { <- oʻzi yangi ishga-tushir.
}.

Veb-hujjat kelganda: ['ishga-tushir'] bajar: {
	oʻzining sarlavhalar := Roʻyxat yangi.
	oʻzining seans-id := Hech.
	oʻzining seans-boshqaruvchisi := Vaqtinchalik-fayl-seansi yangi.
	oʻzining seans-maʼlumotlari := Hech.
	oʻzining xavfsiz := Rost.
	oʻzining bir-xil-sayt := ['Strict'].
	oʻzining sarlavhalar-yuborildi := Yolgʻon.
	oʻzining http-soʻrov := HTTP-Soʻrov yangi.
}.

Veb-hujjat kelganda: ['http-soʻrov:'] bajar: { :http-soʻrov
	oʻzining http-soʻrov := http-soʻrov.
}. 

Veb-hujjat kelganda: ['xavfsiz-seans-cookie:'] bajar: { :xavfsiz
	oʻzi sarlavhalarni-tekshir.
	oʻzining xavfsiz := xavfsiz.
}.

Veb-hujjat kelganda: ['bir-xil-sayt-seans-cookie:'] bajar: { :qiymat
	oʻzi sarlavhalarni-tekshir.
	>> variantlar := Roʻyxat yangi 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	variantlar bormi: qiymat, yolgʻon-boʻlsa: {
		shu-vazifa xato: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	oʻzining bir-xil-sayt := qiymat.
}.

Veb-hujjat kelganda: ['sarlavha:'] bajar: { :sarlavha
	oʻzi sarlavhalarni-tekshir.
	oʻzining sarlavhalar oxiriga-qoʻshish: sarlavha.
}.

Veb-hujjat kelganda: ['sarlavhalarni-boʻshat'] bajar: {
	oʻzi sarlavhalarni-tekshir.
	oʻzining sarlavhalar := Roʻyxat yangi.
}.

Veb-hujjat kelganda: ['seans-boshqaruvchisi:'] bajar: { :boshqaruvchi
	oʻzi sarlavhalarni-tekshir.
	oʻzining seans-boshqaruvchisi := boshqaruvchi.
}.

Veb-hujjat kelganda: ['seans-boshqaruvchisi'] bajar: { <- oʻzining seans-boshqaruvchisi.
}.

Veb-hujjat kelganda: ['sarlavhalarni-tekshir'] bajar: {
	oʻzining sarlavhalar-yuborildi rost-boʻlsa: {
		shu-vazifa xato: ['Headers already sent to client.'].
	}.
}.

Veb-hujjat kelganda: ['seansni-boshla'] bajar: {
	oʻzi sarlavhalarni-tekshir.
	>> http-soʻrov := oʻzining http-soʻrov.
	>> seans-id := http-soʻrov cookie: ['xsid'].
	seans-id Hech? yolgʻon-boʻlsa: {
		(( Andoza yangi: ['^[A-Za-z0-9]+\\z'], moslik: seans-id ) = 0) rost-boʻlsa: {
			seans-id := Hech.
		}.
	}.
	seans-id Hech? rost-boʻlsa: {
		seans-id := Seyf token: 30.
		>> seans-sarlavhasi := HTTP-Sarlavha yangi
		kalit: ['Set-Cookie'] qiymat: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (oʻzining xavfsiz bu: ['Secure'] yoki-u: ['']),
		SSITE: (oʻzining bir-xil-sayt),
		XSID: seans-id
		).
		oʻzining sarlavhalar oxiriga-qoʻshish: seans-sarlavhasi.
	}.
	oʻzining seans-maʼlumotlari := oʻzining seans-boshqaruvchisi uchun: seans-id, yukla. <- oʻzining seans-maʼlumotlari. # reference
}.

Veb-hujjat kelganda: ['oʻt:'] bajar: { :manzil
	oʻzi sarlavhalarni-tekshir.
	oʻzi sarlavhalarni-boʻshat.
	oʻzining sarlavhalar
	oxiriga-qoʻshish: (
		HTTP-Sarlavha yangi
		kalit: ['Status'] qiymat: ['303 See Other']
	),
	oxiriga-qoʻshish: (
		HTTP-Sarlavha yangi
		kalit: ['Location'] qiymat: manzil
	).
	oʻzi chiqar: ['Redirect'].
}.

Veb-hujjat kelganda: ['seansni-yoʻq-qil'] bajar: {
	oʻzi sarlavhalarni-tekshir.
	>> http-soʻrov := oʻzining http-soʻrov.
	>> seans-id := http-soʻrov cookie: ['xsid'].
	seans-id Hech? yolgʻon-boʻlsa: {
		>> seans-sarlavhasi := HTTP-Sarlavha yangi.
		>> lahza := Lahza yangi yil: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		seans-sarlavhasi kalit: ['Set-Cookie'] qiymat: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: lahza,
			SEC: (oʻzining xavfsiz bu: ['Secure'] yoki-u: ['']),
			SSITE: (oʻzining bir-xil-sayt),
			XSID: seans-id
		).
		oʻzining seans-boshqaruvchisi yoʻq-qil.
		oʻzining sarlavhalar oxiriga-qoʻshish: seans-sarlavhasi.
	}.
}.


Veb-hujjat kelganda: ['qolip:'] bajar: { :yoʻl <- Qolip yangi: (Fayl yangi: yoʻl, oʻqish).
}.

Veb-hujjat kelganda: ['chiqar:tur:'] bajar: { :natija :tur
	oʻzining sarlavhalar-yuborildi yolgʻon-boʻlsa: {
		oʻzining seans-maʼlumotlari Hech? yolgʻon-boʻlsa: {
			oʻzining seans-boshqaruvchisi saqla: oʻzining seans-maʼlumotlari.
		}.
		oʻzining sarlavhalar oxiriga-qoʻshish: (
			HTTP-Sarlavha yangi
			kalit: ['Content-type'] qiymat: tur
		).
		oʻzining sarlavhalar har-bir: { :_ :sarlavha
			Chiqish yozish: sarlavha.
		}.
		oʻzining sarlavhalar-yuborildi := Rost.
		Chiqish yozish: ['\r\n'].
	}.
	Chiqish yozish: natija.
}.

Veb-hujjat kelganda: ['yakunla:tur:'] bajar: { :natija :tur
	oʻzining sarlavhalar-yuborildi yolgʻon-boʻlsa: {
		oʻzining seans-maʼlumotlari Hech? yolgʻon-boʻlsa: {
			oʻzining seans-boshqaruvchisi saqla: oʻzining seans-maʼlumotlari.
		}.
		oʻzining sarlavhalar oxiriga-qoʻshish: (
			HTTP-Sarlavha yangi
			kalit: ['Content-type'] qiymat: tur
		).
		oʻzining sarlavhalar oxiriga-qoʻshish: (
			HTTP-Sarlavha yangi
			kalit: ['Content-Length'] qiymat: natija matn bytes
		).
		oʻzining sarlavhalar har-bir: { :_ :sarlavha
			Chiqish yozish: sarlavha.
		}.
		oʻzining sarlavhalar-yuborildi := Rost.
		Chiqish yozish: ['\r\n'].
	}.
	Chiqish yozish: natija.
}.

Veb-hujjat kelganda: ['chiqar:'] bajar: { :natija
	oʻzi chiqar: natija tur: ['text/html; charset=utf-8'].
}.

Veb-hujjat kelganda: ['yakunla:'] bajar: { :natija
	oʻzi yakunla: natija tur: ['text/html; charset=utf-8'].
}.

Veb-hujjat kelganda: ['json:'] bajar: { :natija
	oʻzi chiqar: ( JSON jsonify: natija ) tur: ['application/json'].
}.

Veb-hujjat kelganda: ['topilmadi:'] bajar: { :natija
	oʻzi sarlavhalarni-boʻshat sarlavha: (
		HTTP-Sarlavha yangi kalit: ['Status'] qiymat: ['404 Not Found']
	).
	oʻzi chiqar: natija.
}.


# Interface

>> Seans := Obyekt yangi.

Seans kelganda: ['yangi'] bajar: { <- oʻzi yangi ishga-tushir uchun: Hech.
}.

Seans kelganda: ['uchun:'] bajar: { :id
	oʻzining id := id.
}.

Seans kelganda: ['yukla'] bajar: {
	shu-vazifa xato: ['Not implemented.'].
}.

Seans kelganda: ['saqla:'] bajar: {
	shu-vazifa xato: ['Not implemented.'].
}.

Seans kelganda: ['yoʻq-qil'] bajar: {
	shu-vazifa xato: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Vaqtinchalik-fayl-seansi := Seans yangi.

Vaqtinchalik-fayl-seansi kelganda: ['ishga-tushir'] bajar: {
	oʻzining yoʻl-boshi := ['/tmp/sess-'].
}.

Vaqtinchalik-fayl-seansi kelganda: ['yoʻl-prefiksi:'] bajar: { :satr
	oʻzining yoʻl-boshi := satr.
}.

Vaqtinchalik-fayl-seansi kelganda: ['fayl'] bajar: { <- ( Fayl yangi: ( oʻzining yoʻl-boshi + oʻzining id + ['.txt'] ) ).
}.

Vaqtinchalik-fayl-seansi kelganda: ['yukla'] bajar: {
	>> fayl := oʻzi fayl.
	fayl mavjud yolgʻon-boʻlsa: {
		fayl yozish: (Lugʻat yangi kod).
	}. <- fayl oʻqish obyekt.
}.

Vaqtinchalik-fayl-seansi kelganda: ['saqla:'] bajar: { :maʼlumotlar
	>> fayl := oʻzi fayl.
	fayl mavjud rost-boʻlsa: {
		fayl yozish: maʼlumotlar kod.
	}.
}.

Vaqtinchalik-fayl-seansi kelganda: ['yoʻq-qil'] bajar: {
	>> fayl := oʻzi fayl.
	fayl mavjud rost-boʻlsa: {
		fayl oʻchirish.
	}.
}.


>> URL := Obyekt yangi.

URL kelganda: ['ishga-tushir'] bajar: {
	oʻzining protokol := ['https://'].
	oʻzining xost := ['localhost'].
	oʻzining yoʻl := [''].
	oʻzining url-parametrlari := [''].
	oʻzining hash := [''].
}.

URL kelganda: ['yangi'] bajar: { <- oʻzi yangi ishga-tushir.
}.

URL kelganda: ['matn'] bajar: { <- (
	oʻzining protokol +
	oʻzining xost +
	oʻzining yoʻl +
	oʻzining url-parametrlari +
	oʻzining hash ).
}.

URL kelganda: ['protokol:'] bajar: { :protokol
	((Roʻyxat yangi ; ['http'] ; ['https']) bormi: protokol) rost-boʻlsa: {
		oʻzining protokol := protokol + ['://'].
	}, yolgʻon-boʻlsa: {
		shu-vazifa xato: ['Invalid protocol'].
	}.
}.

URL kelganda: ['xost:'] bajar: { :xost
	#todo validate according to rfc
	oʻzining xost := xost.
}.

URL kelganda: ['yoʻl:'] bajar: { :yoʻl
	oʻzining yoʻl := ['/'] + yoʻl url-kodlash.
}.

URL kelganda: ['url-parametrlari:'] bajar: { :moslashtirish
	>> url-parametrlari := Roʻyxat yangi.
	moslashtirish har-bir: { :kalit :qiymat
		url-parametrlari oxiriga-qoʻshish: kalit matn url-kodlash + ['='] + qiymat matn url-kodlash.
	}.
	oʻzining url-parametrlari := ['?'] + ( url-parametrlari birlashtirish: ['&'] ).
}.

URL kelganda: ['xesh:'] bajar: { :hash
	oʻzining hash := ['#'] + hash url-kodlash.
}.

