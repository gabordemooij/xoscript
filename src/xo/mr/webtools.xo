HTTP-विनंती जेव्हा: ['HTTP-शीर्षलेख:'] करा: { :किल्ली <- प्रोग्राम सेटिंग: किल्ली.
}.

>> HTTP-शीर्षलेख := वस्तू नवीन.

HTTP-शीर्षलेख जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आरंभ-करा.
}.

HTTP-शीर्षलेख जेव्हा: ['आरंभ-करा'] करा: {
	स्वतःचे किल्ली := शून्य.
	स्वतःचे मूल्य := शून्य.
}.

HTTP-शीर्षलेख जेव्हा: ['किल्ली:मूल्य:'] करा: { :किल्ली :मूल्य
	स्वतःचे किल्ली := किल्ली.
	स्वतःचे मूल्य := मूल्य.
}.

HTTP-शीर्षलेख जेव्हा: ['किल्ली'] करा: { <- स्वतःचे किल्ली.
}.

HTTP-शीर्षलेख जेव्हा: ['मूल्य'] करा: { <- स्वतःचे मूल्य.
}.


HTTP-शीर्षलेख जेव्हा: ['मजकुरात'] करा: {
	>> ओळ := स्वतःचे किल्ली + [': '] + स्वतःचे मूल्य.
	ओळ बदला: ['\r'] ने: [''], बदला: ['\n'] ने: ['']. <- ओळ + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> वेब-दस्तऐवज := वस्तू नवीन.

वेब-दस्तऐवज जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आरंभ-करा.
}.

वेब-दस्तऐवज जेव्हा: ['आरंभ-करा'] करा: {
	स्वतःचे शीर्षलेख-यादी := सूची नवीन.
	स्वतःचे सत्र-आयडी := शून्य.
	स्वतःचे सत्र-व्यवस्थापक := तात्पुरती-फाइल-सत्र नवीन.
	स्वतःचे सत्र-माहिती := शून्य.
	स्वतःचे सुरक्षित := खरे.
	स्वतःचे समान-साइट := ['Strict'].
	स्वतःचे शीर्षलेख-पाठवले := खोटे.
	स्वतःचे विनंती-http := HTTP-विनंती नवीन.
}.

वेब-दस्तऐवज जेव्हा: ['विनंती-http:'] करा: { :विनंती-http
	स्वतःचे विनंती-http := विनंती-http.
}. 

वेब-दस्तऐवज जेव्हा: ['सुरक्षित-सत्र-कुकी:'] करा: { :सुरक्षित
	स्वतः शीर्षलेख-तपासा.
	स्वतःचे सुरक्षित := सुरक्षित.
}.

वेब-दस्तऐवज जेव्हा: ['समान-साइट-सत्र-कुकी:'] करा: { :मूल्य
	स्वतः शीर्षलेख-तपासा.
	>> पर्याय := सूची नवीन 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	पर्याय आहे-का: मूल्य, खोटे-असल्यास: {
		हे-कार्य त्रुटी: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	स्वतःचे समान-साइट := मूल्य.
}.

वेब-दस्तऐवज जेव्हा: ['शीर्षलेख:'] करा: { :शीर्षलेख
	स्वतः शीर्षलेख-तपासा.
	स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: शीर्षलेख.
}.

वेब-दस्तऐवज जेव्हा: ['शीर्षलेख-रिकामे-करा'] करा: {
	स्वतः शीर्षलेख-तपासा.
	स्वतःचे शीर्षलेख-यादी := सूची नवीन.
}.

वेब-दस्तऐवज जेव्हा: ['सत्र-व्यवस्थापक:'] करा: { :व्यवस्थापक
	स्वतः शीर्षलेख-तपासा.
	स्वतःचे सत्र-व्यवस्थापक := व्यवस्थापक.
}.

वेब-दस्तऐवज जेव्हा: ['सत्र-व्यवस्थापक'] करा: { <- स्वतःचे सत्र-व्यवस्थापक.
}.

वेब-दस्तऐवज जेव्हा: ['शीर्षलेख-तपासा'] करा: {
	स्वतःचे शीर्षलेख-पाठवले खरे-असल्यास: {
		हे-कार्य त्रुटी: ['Headers already sent to client.'].
	}.
}.

वेब-दस्तऐवज जेव्हा: ['सत्र-सुरू-करा'] करा: {
	स्वतः शीर्षलेख-तपासा.
	>> विनंती-http := स्वतःचे विनंती-http.
	>> सत्र-आयडी := विनंती-http cookie: ['xsid'].
	सत्र-आयडी शून्य? खोटे-असल्यास: {
		(( पॅटर्न नवीन: ['^[A-Za-z0-9]+\\z'], जुळणी: सत्र-आयडी ) = 0) खरे-असल्यास: {
			सत्र-आयडी := शून्य.
		}.
	}.
	सत्र-आयडी शून्य? खरे-असल्यास: {
		सत्र-आयडी := तिजोरी टोकन: 30.
		>> सत्र-शीर्षलेख := HTTP-शीर्षलेख नवीन
		किल्ली: ['Set-Cookie'] मूल्य: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (स्वतःचे सुरक्षित हे: ['Secure'] नाहीतर: ['']),
		SSITE: (स्वतःचे समान-साइट),
		XSID: सत्र-आयडी
		).
		स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: सत्र-शीर्षलेख.
	}.
	स्वतःचे सत्र-माहिती := स्वतःचे सत्र-व्यवस्थापक साठी: सत्र-आयडी, लोड-करा. <- स्वतःचे सत्र-माहिती. # reference
}.

वेब-दस्तऐवज जेव्हा: ['जा:'] करा: { :पत्ता
	स्वतः शीर्षलेख-तपासा.
	स्वतः शीर्षलेख-रिकामे-करा.
	स्वतःचे शीर्षलेख-यादी
	शेवटी-जोडा: (
		HTTP-शीर्षलेख नवीन
		किल्ली: ['Status'] मूल्य: ['303 See Other']
	),
	शेवटी-जोडा: (
		HTTP-शीर्षलेख नवीन
		किल्ली: ['Location'] मूल्य: पत्ता
	).
	स्वतः आउटपुट-करा: ['Redirect'].
}.

वेब-दस्तऐवज जेव्हा: ['सत्र-नष्ट-करा'] करा: {
	स्वतः शीर्षलेख-तपासा.
	>> विनंती-http := स्वतःचे विनंती-http.
	>> सत्र-आयडी := विनंती-http cookie: ['xsid'].
	सत्र-आयडी शून्य? खोटे-असल्यास: {
		>> सत्र-शीर्षलेख := HTTP-शीर्षलेख नवीन.
		>> समाप्ती-वेळ := क्षण नवीन वर्ष: 1970, स्वरूपात: ['%a, %d %b %Y %H:%M:%S GMT'].
		सत्र-शीर्षलेख किल्ली: ['Set-Cookie'] मूल्य: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: समाप्ती-वेळ,
			SEC: (स्वतःचे सुरक्षित हे: ['Secure'] नाहीतर: ['']),
			SSITE: (स्वतःचे समान-साइट),
			XSID: सत्र-आयडी
		).
		स्वतःचे सत्र-व्यवस्थापक नष्ट-करा.
		स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: सत्र-शीर्षलेख.
	}.
}.


वेब-दस्तऐवज जेव्हा: ['साचा:'] करा: { :फाइल-मार्ग <- साचा नवीन: (फाइल नवीन: फाइल-मार्ग, वाचा).
}.

वेब-दस्तऐवज जेव्हा: ['आउटपुट-करा:प्रकार:'] करा: { :परिणाम :प्रकार
	स्वतःचे शीर्षलेख-पाठवले खोटे-असल्यास: {
		स्वतःचे सत्र-माहिती शून्य? खोटे-असल्यास: {
			स्वतःचे सत्र-व्यवस्थापक जतन-करा: स्वतःचे सत्र-माहिती.
		}.
		स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: (
			HTTP-शीर्षलेख नवीन
			किल्ली: ['Content-type'] मूल्य: प्रकार
		).
		स्वतःचे शीर्षलेख-यादी प्रत्येक: { :_ :शीर्षलेख
			आउटपुट लिहा: शीर्षलेख.
		}.
		स्वतःचे शीर्षलेख-पाठवले := खरे.
		आउटपुट लिहा: ['\r\n'].
	}.
	आउटपुट लिहा: परिणाम.
}.

वेब-दस्तऐवज जेव्हा: ['पूर्ण-करा:प्रकार:'] करा: { :परिणाम :प्रकार
	स्वतःचे शीर्षलेख-पाठवले खोटे-असल्यास: {
		स्वतःचे सत्र-माहिती शून्य? खोटे-असल्यास: {
			स्वतःचे सत्र-व्यवस्थापक जतन-करा: स्वतःचे सत्र-माहिती.
		}.
		स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: (
			HTTP-शीर्षलेख नवीन
			किल्ली: ['Content-type'] मूल्य: प्रकार
		).
		स्वतःचे शीर्षलेख-यादी शेवटी-जोडा: (
			HTTP-शीर्षलेख नवीन
			किल्ली: ['Content-Length'] मूल्य: परिणाम मजकुरात bytes
		).
		स्वतःचे शीर्षलेख-यादी प्रत्येक: { :_ :शीर्षलेख
			आउटपुट लिहा: शीर्षलेख.
		}.
		स्वतःचे शीर्षलेख-पाठवले := खरे.
		आउटपुट लिहा: ['\r\n'].
	}.
	आउटपुट लिहा: परिणाम.
}.

वेब-दस्तऐवज जेव्हा: ['आउटपुट-करा:'] करा: { :परिणाम
	स्वतः आउटपुट-करा: परिणाम प्रकार: ['text/html; charset=utf-8'].
}.

वेब-दस्तऐवज जेव्हा: ['पूर्ण-करा:'] करा: { :परिणाम
	स्वतः पूर्ण-करा: परिणाम प्रकार: ['text/html; charset=utf-8'].
}.

वेब-दस्तऐवज जेव्हा: ['json:'] करा: { :परिणाम
	स्वतः आउटपुट-करा: ( JSON jsonify: परिणाम ) प्रकार: ['application/json'].
}.

वेब-दस्तऐवज जेव्हा: ['सापडले-नाही:'] करा: { :परिणाम
	स्वतः शीर्षलेख-रिकामे-करा शीर्षलेख: (
		HTTP-शीर्षलेख नवीन किल्ली: ['Status'] मूल्य: ['404 Not Found']
	).
	स्वतः आउटपुट-करा: परिणाम.
}.


# Interface

>> सत्र := वस्तू नवीन.

सत्र जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आरंभ-करा साठी: शून्य.
}.

सत्र जेव्हा: ['साठी:'] करा: { :id
	स्वतःचे id := id.
}.

सत्र जेव्हा: ['लोड-करा'] करा: {
	हे-कार्य त्रुटी: ['Not implemented.'].
}.

सत्र जेव्हा: ['जतन-करा:'] करा: {
	हे-कार्य त्रुटी: ['Not implemented.'].
}.

सत्र जेव्हा: ['नष्ट-करा'] करा: {
	हे-कार्य त्रुटी: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> तात्पुरती-फाइल-सत्र := सत्र नवीन.

तात्पुरती-फाइल-सत्र जेव्हा: ['आरंभ-करा'] करा: {
	स्वतःचे मार्ग-सुरुवात := ['/tmp/sess-'].
}.

तात्पुरती-फाइल-सत्र जेव्हा: ['मार्ग-उपसर्ग:'] करा: { :मजकूर-माळ
	स्वतःचे मार्ग-सुरुवात := मजकूर-माळ.
}.

तात्पुरती-फाइल-सत्र जेव्हा: ['सत्र-फाइल'] करा: { <- ( फाइल नवीन: ( स्वतःचे मार्ग-सुरुवात + स्वतःचे id + ['.txt'] ) ).
}.

तात्पुरती-फाइल-सत्र जेव्हा: ['लोड-करा'] करा: {
	>> सत्र-फाइल := स्वतः सत्र-फाइल.
	सत्र-फाइल अस्तित्वात खोटे-असल्यास: {
		सत्र-फाइल लिहा: (शब्दकोश नवीन कोड).
	}. <- सत्र-फाइल वाचा वस्तूमध्ये.
}.

तात्पुरती-फाइल-सत्र जेव्हा: ['जतन-करा:'] करा: { :माहिती-संच
	>> सत्र-फाइल := स्वतः सत्र-फाइल.
	सत्र-फाइल अस्तित्वात खरे-असल्यास: {
		सत्र-फाइल लिहा: माहिती-संच कोड.
	}.
}.

तात्पुरती-फाइल-सत्र जेव्हा: ['नष्ट-करा'] करा: {
	>> सत्र-फाइल := स्वतः सत्र-फाइल.
	सत्र-फाइल अस्तित्वात खरे-असल्यास: {
		सत्र-फाइल हटवा.
	}.
}.


>> URL := वस्तू नवीन.

URL जेव्हा: ['आरंभ-करा'] करा: {
	स्वतःचे प्रोटोकॉल := ['https://'].
	स्वतःचे होस्ट := ['localhost'].
	स्वतःचे फाइल-मार्ग := [''].
	स्वतःचे url-मापदंड := [''].
	स्वतःचे hash := [''].
}.

URL जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आरंभ-करा.
}.

URL जेव्हा: ['मजकुरात'] करा: { <- (
	स्वतःचे प्रोटोकॉल +
	स्वतःचे होस्ट +
	स्वतःचे फाइल-मार्ग +
	स्वतःचे url-मापदंड +
	स्वतःचे hash ).
}.

URL जेव्हा: ['प्रोटोकॉल:'] करा: { :प्रोटोकॉल
	((सूची नवीन ; ['http'] ; ['https']) आहे-का: प्रोटोकॉल) खरे-असल्यास: {
		स्वतःचे प्रोटोकॉल := प्रोटोकॉल + ['://'].
	}, खोटे-असल्यास: {
		हे-कार्य त्रुटी: ['Invalid protocol'].
	}.
}.

URL जेव्हा: ['होस्ट:'] करा: { :होस्ट
	#todo validate according to rfc
	स्वतःचे होस्ट := होस्ट.
}.

URL जेव्हा: ['फाइल-मार्ग:'] करा: { :फाइल-मार्ग
	स्वतःचे फाइल-मार्ग := ['/'] + फाइल-मार्ग url-एनकोड.
}.

URL जेव्हा: ['url-मापदंड:'] करा: { :मॅपिंग
	>> url-मापदंड := सूची नवीन.
	मॅपिंग प्रत्येक: { :किल्ली :मूल्य
		url-मापदंड शेवटी-जोडा: किल्ली मजकुरात url-एनकोड + ['='] + मूल्य मजकुरात url-एनकोड.
	}.
	स्वतःचे url-मापदंड := ['?'] + ( url-मापदंड जोडा: ['&'] ).
}.

URL जेव्हा: ['हॅश:'] करा: { :hash
	स्वतःचे hash := ['#'] + hash url-एनकोड.
}.

