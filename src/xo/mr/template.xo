
# ~ Simple template engine ~

>> साचा := वस्तू नवीन.

साचा जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आशय: [''].
}.

साचा जेव्हा: ['आशय:'] करा: { :आशय
	स्वतःचे आशय := आशय. 
}.

साचा जेव्हा: ['नवीन:'] करा: { :आशय <- स्वतः नवीन आशय: आशय.
}.

साचा जेव्हा: ['कापा:'] करा: { :खूण
	>> सुरुवात-खूण := (['<!-- cut:%id% -->'] %id%: खूण).
	>> शेवट-खूण := (['<!-- /cut:%id% -->'] %id%: खूण).
	>> भाग-संच := स्वतःचे आशय विभाजित: सुरुवात-खूण.
	>> उपसर्ग := भाग-संच पहिला.
	>> भाग-संच2 := भाग-संच शेवटचा विभाजित: शेवट-खूण.
	>> प्रत्यय := भाग-संच2 शेवटचा.
	>> भाग := भाग-संच2 पहिला.
	>> उर्वरित := उपसर्ग + प्रत्यय.
	स्वतःचे आशय := उर्वरित. <- साचा नवीन: भाग.
	
}.

साचा जेव्हा: ['प्रत'] करा: { <- स्वतः नवीन: स्वतः मजकुरात प्रत.
}.
	
साचा जेव्हा: ['चिकटवा:किल्ली:'] करा: { :उतारा :id
	>> चिकटवण्याची-खूण := (['<!-- paste:%id% -->'] %id%: id).
	स्वतःचे आशय बदला: चिकटवण्याची-खूण ने: ( उतारा मजकुरात + चिकटवण्याची-खूण ).
}.

साचा जेव्हा: ['निश्चित:मूल्य:'] करा: { :जागा :मूल्य
	स्वतःचे आशय बदला: ['<!-- slot:'] + जागा + [' -->'] ने: ( Server html-एनकोड: मूल्य ).
}.

साचा जेव्हा: ['निश्चित:html:'] करा: { :जागा :html
	स्वतःचे आशय बदला: ['<!-- slot:'] + जागा + [' -->'] ने: html.
}.

साचा जेव्हा: ['उत्तर:आणि:'] करा: { :जागा :मूल्य
	स्वतः निश्चित: (जागा सुरुवात: 0 लांबी: (जागा लांबी - 1)) मूल्य: मूल्य.
}.

साचा जेव्हा: ['nl2br'] करा: {
	स्वतःचे आशय बदला: ['\n'] ने: ['<br>'].
}.

साचा जेव्हा: ['खुणा-काढा'] करा: {
	स्वतःचे आशय :=
		पॅटर्न
		नवीन: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		जुळणी: स्वतःचे आशय
		करा: { <- ['']. }.
}.

साचा जेव्हा: ['कट-काढा'] करा: {
	>> बाबी := सूची नवीन.
	पॅटर्न
	नवीन: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	जुळणी: स्वतःचे आशय
	करा: { :_ :भाग
		बाबी शेवटी-जोडा: भाग ? 1.
	}.
	बाबी प्रत्येक: { :_ :id
		स्वतःचे आशय :=
			पॅटर्न नवीन: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			जुळणी: स्वतःचे आशय
			करा: { <- ['']. }.
	 }.
}.

साचा जेव्हा: ['रिकाम्या-जागा-काढा'] करा: {
	स्वतःचे आशय :=
		पॅटर्न
		नवीन: ['\\s*\\n'],
		जुळणी: स्वतःचे आशय
		करा: { <- ['\n']. }.
	स्वतःचे आशय :=
		पॅटर्न
		नवीन: ['\\n[\\s\\t]+'],
		जुळणी: स्वतःचे आशय
		करा: { <- ['\n']. }.
}.

साचा जेव्हा: ['सर्व-खुणा-काढा'] करा: {
	स्वतः खुणा-काढा.
	स्वतः कट-काढा.
	स्वतः रिकाम्या-जागा-काढा.
}.

साचा जेव्हा: ['मजकुरात'] करा: { <- स्वतःचे आशय.
}.
