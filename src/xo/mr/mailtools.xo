>> ईमेल := वस्तू नवीन.

ईमेल जेव्हा: ['आरंभ-करा'] करा: {
	स्वतःचे प्राप्तकर्ते := सूची नवीन.
	स्वतःचे cc := सूची नवीन.
	स्वतःचे bcc := सूची नवीन.
	स्वतःचे प्रेषक := शून्य.
	स्वतःचे प्रेषकाचे-नाव := शून्य.
	स्वतःचे विषय := शून्य.
	स्वतःचे मुख्य-मजकूर := शून्य.
}.

ईमेल जेव्हा: ['नवीन'] करा: { <- स्वतः नवीन आरंभ-करा.
}.

ईमेल जेव्हा: ['प्राप्तकर्त्याला:'] करा: { :गणना-यादी
	स्वतःचे प्राप्तकर्ते := गणना-यादी.
}.
 
ईमेल जेव्हा: ['cc:'] करा: { :गणना-यादी
	स्वतःचे cc := गणना-यादी.
}.

ईमेल जेव्हा: ['bcc:'] करा: { :गणना-यादी
	स्वतःचे bcc := गणना-यादी.
}.

ईमेल जेव्हा: ['विषय:'] करा: { :विषय
	स्वतःचे विषय := विषय.
}.

ईमेल जेव्हा: ['प्रेषक:नाव:'] करा: { :प्रेषक :नाव
	स्वतःचे प्रेषक := प्रेषक.
	स्वतःचे प्रेषकाचे-नाव := नाव.
}.

ईमेल जेव्हा: ['मुख्य-मजकूर:'] करा: { :मुख्य-मजकूर
	स्वतःचे मुख्य-मजकूर := मुख्य-मजकूर.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
ईमेल जेव्हा: ['शीर्षलेख:'] करा: { :ओळ <- ओळ बदला: ['\r'] ने: [''], बदला: ['\n'] ने: [''].
}.

ईमेल जेव्हा: ['पाठवा'] करा: {
	>> f := फाइल tempwrite: स्वतः निर्माण-करा.
	प्रोग्राम सिस्टम: ['sendmail -t < '] + f फाइल-मार्ग, नवी-ओळ.
}.

ईमेल जेव्हा: ['निर्माण-करा'] करा: {
	>> ओळ-खंड := ['\r\n'].
	>> मजकूर-माळ := [''].
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['From: '] + स्वतःचे प्रेषकाचे-नाव + [' <'] + ( स्वतःचे प्रेषक ) + ['>']) + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['To: '] + ( स्वतःचे प्राप्तकर्ते जोडा: [','] )) + ओळ-खंड.
	स्वतःचे cc मोजणी खरे-असल्यास: {
		मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Cc: '] + ( स्वतःचे cc जोडा: [','] )) + ओळ-खंड.
	}.
	स्वतःचे bcc मोजणी खरे-असल्यास: {
		मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Bcc: '] + ( स्वतःचे bcc जोडा: [','] )) + ओळ-खंड.
	}.
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Subject: '] + स्वतःचे विषय) + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: स्वतःचे मुख्य-मजकूर.
	मजकूर-माळ शेवटी-जोडा: ओळ-खंड. <- मजकूर-माळ.
}.

>> HTML-ईमेल := ईमेल नवीन.

HTML-ईमेल जेव्हा: ['आरंभ-करा'] करा: {
	स्वतः आरंभ-करा.
	स्वतःचे जोडण्या := सूची नवीन.
	स्वतःचे सीमा := तिजोरी टोकन: 40.
}.

HTML-ईमेल जेव्हा: ['जोडा-फाइल:'] करा: { :सत्र-फाइल
	>> id := स्वतःचे जोडण्या मोजणी.
	>> blob := सत्र-फाइल blob.
	स्वतःचे जोडण्या शेवटी-जोडा: (
		शब्दकोश नवीन
			सत्र-फाइल: सत्र-फाइल फाइल-मार्ग,
			mime: ['image/'] + (Server mimetype: सत्र-फाइल फाइल-मार्ग),
			माहिती-संच: blob base64-एनकोड
	).
	blob मुक्त. <- ['cid:attachment'] + id.
}.

HTML-ईमेल जेव्हा: ['निर्माण-करा'] करा: {
	>> ओळ-खंड := ['\r\n'].
	>> मजकूर-माळ := [''].
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['From: '] + स्वतःचे प्रेषकाचे-नाव + [' <'] + ( स्वतःचे प्रेषक ) + ['>']) + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['To: '] + ( स्वतःचे प्राप्तकर्ते जोडा: [','] )) + ओळ-खंड.
	स्वतःचे cc मोजणी खरे-असल्यास: {
		मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Cc: '] + ( स्वतःचे cc जोडा: [','] )) + ओळ-खंड.
	}.
	स्वतःचे bcc मोजणी खरे-असल्यास: {
		मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Bcc: '] + ( स्वतःचे bcc जोडा: [','] )) + ओळ-खंड.
	}.
	मजकूर-माळ शेवटी-जोडा: (स्वतः शीर्षलेख: ['Subject: '] + स्वतःचे विषय) + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ['MIME-Version: 1.0'] + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ['Content-Type: multipart/related; boundary="'] + स्वतःचे सीमा + ['"; type=text/html'] + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ['--'] + स्वतःचे सीमा + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ['Content-Type: text/html; charset=UTF-8'] + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ['Content-Transfer-Encoding: 7bit'] + ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
	मजकूर-माळ शेवटी-जोडा: स्वतःचे मुख्य-मजकूर.
	मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
	स्वतःचे जोडण्या प्रत्येक: { :id :माहिती
		>> blob := माहिती माहिती-संच.
		मजकूर-माळ शेवटी-जोडा: ['--'] + स्वतःचे सीमा + ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ['Content-Type: '] + माहिती mime + ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ['Content-Transfer-Encoding: base64'] + ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ['Content-ID: <attachment'] + id + ['>'] + ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ['Content-Disposition: inline; filename="'] + माहिती सत्र-फाइल + ['"'] + ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
		>> वरची-मर्यादा := 76.
		>> मजकूर-लांबी := blob लांबी.
		>> तुकडे := (मजकूर-लांबी / वरची-मर्यादा) वर-पूर्णांक.
		{ :i
			>> तुकडा := blob प्रत सुरुवात: i * वरची-मर्यादा लांबी: वरची-मर्यादा.
			मजकूर-माळ शेवटी-जोडा: तुकडा + ओळ-खंड.
		} * तुकडे.
		मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
		मजकूर-माळ शेवटी-जोडा: ओळ-खंड.
	}.
	मजकूर-माळ शेवटी-जोडा: ['--'] + स्वतःचे सीमा + ['--'] + ओळ-खंड. <- मजकूर-माळ.
}.
