HTTP-Zahteva ob: ['HTTP-glava:'] izvedi: { :ključ <- Program nastavitev: ključ.
}.

>> Glava-HTTP := Objekt nov.

Glava-HTTP ob: ['nov'] izvedi: { <- sebe nov inicializiraj.
}.

Glava-HTTP ob: ['inicializiraj'] izvedi: {
	svoj ključ := Nič.
	svoj vrednost := Nič.
}.

Glava-HTTP ob: ['ključ:vrednost:'] izvedi: { :ključ :vrednost
	svoj ključ := ključ.
	svoj vrednost := vrednost.
}.

Glava-HTTP ob: ['ključ'] izvedi: { <- svoj ključ.
}.

Glava-HTTP ob: ['vrednost'] izvedi: { <- svoj vrednost.
}.


Glava-HTTP ob: ['besedilo'] izvedi: {
	>> vrstica := svoj ključ + [': '] + svoj vrednost.
	vrstica zamenjaj: ['\r'] z: [''], zamenjaj: ['\n'] z: ['']. <- vrstica + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Spletni-dokument := Objekt nov.

Spletni-dokument ob: ['nov'] izvedi: { <- sebe nov inicializiraj.
}.

Spletni-dokument ob: ['inicializiraj'] izvedi: {
	svoj glave := Seznam nov.
	svoj id-seje := Nič.
	svoj upravitelj-sej := Seja-začasna-datoteka nov.
	svoj podatki-seje := Nič.
	svoj varno := Resnično.
	svoj isto-mesto := ['Strict'].
	svoj glave-poslane := Neresnično.
	svoj zahteva := HTTP-Zahteva nov.
}.

Spletni-dokument ob: ['zahteva:'] izvedi: { :zahteva
	svoj zahteva := zahteva.
}. 

Spletni-dokument ob: ['varen-piškotek-seje:'] izvedi: { :varno
	sebe preveri-glave.
	svoj varno := varno.
}.

Spletni-dokument ob: ['piškotek-seje-isto-mesto:'] izvedi: { :vrednost
	sebe preveri-glave.
	>> možnosti := Seznam nov 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	možnosti ima: vrednost, neresnično: {
		ta-naloga napaka: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	svoj isto-mesto := vrednost.
}.

Spletni-dokument ob: ['glava:'] izvedi: { :glava
	sebe preveri-glave.
	svoj glave dodaj-na-konec: glava.
}.

Spletni-dokument ob: ['izprazni-glave'] izvedi: {
	sebe preveri-glave.
	svoj glave := Seznam nov.
}.

Spletni-dokument ob: ['upravitelj-sej:'] izvedi: { :upravitelj
	sebe preveri-glave.
	svoj upravitelj-sej := upravitelj.
}.

Spletni-dokument ob: ['upravitelj-sej'] izvedi: { <- svoj upravitelj-sej.
}.

Spletni-dokument ob: ['preveri-glave'] izvedi: {
	svoj glave-poslane resnično: {
		ta-naloga napaka: ['Headers already sent to client.'].
	}.
}.

Spletni-dokument ob: ['začni-sejo'] izvedi: {
	sebe preveri-glave.
	>> zahteva := svoj zahteva.
	>> id-seje := zahteva cookie: ['xsid'].
	id-seje Nič? neresnično: {
		(( Vzorec nov: ['^[A-Za-z0-9]+\\z'], ujemanje: id-seje ) = 0) resnično: {
			id-seje := Nič.
		}.
	}.
	id-seje Nič? resnično: {
		id-seje := Sef žeton: 30.
		>> glava-seje := Glava-HTTP nov
		ključ: ['Set-Cookie'] vrednost: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (svoj varno ali: ['Secure'] ali: ['']),
		SSITE: (svoj isto-mesto),
		XSID: id-seje
		).
		svoj glave dodaj-na-konec: glava-seje.
	}.
	svoj podatki-seje := svoj upravitelj-sej za: id-seje, naloži. <- svoj podatki-seje. # reference
}.

Spletni-dokument ob: ['pojdi-na:'] izvedi: { :naslov
	sebe preveri-glave.
	sebe izprazni-glave.
	svoj glave
	dodaj-na-konec: (
		Glava-HTTP nov
		ključ: ['Status'] vrednost: ['303 See Other']
	),
	dodaj-na-konec: (
		Glava-HTTP nov
		ključ: ['Location'] vrednost: naslov
	).
	sebe izpiši: ['Redirect'].
}.

Spletni-dokument ob: ['uniči-sejo'] izvedi: {
	sebe preveri-glave.
	>> zahteva := svoj zahteva.
	>> id-seje := zahteva cookie: ['xsid'].
	id-seje Nič? neresnično: {
		>> glava-seje := Glava-HTTP nov.
		>> trenutek := Trenutek nov leto: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		glava-seje ključ: ['Set-Cookie'] vrednost: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: trenutek,
			SEC: (svoj varno ali: ['Secure'] ali: ['']),
			SSITE: (svoj isto-mesto),
			XSID: id-seje
		).
		svoj upravitelj-sej uniči.
		svoj glave dodaj-na-konec: glava-seje.
	}.
}.


Spletni-dokument ob: ['predloga:'] izvedi: { :pot <- Predloga nov: (Datoteka nov: pot, beri).
}.

Spletni-dokument ob: ['izpiši:tip:'] izvedi: { :izhod :tip
	svoj glave-poslane neresnično: {
		svoj podatki-seje Nič? neresnično: {
			svoj upravitelj-sej shrani: svoj podatki-seje.
		}.
		svoj glave dodaj-na-konec: (
			Glava-HTTP nov
			ključ: ['Content-type'] vrednost: tip
		).
		svoj glave vsak: { :_ :glava
			Izhod piši: glava.
		}.
		svoj glave-poslane := Resnično.
		Izhod piši: ['\r\n'].
	}.
	Izhod piši: izhod.
}.

Spletni-dokument ob: ['zaključi:tip:'] izvedi: { :izhod :tip
	svoj glave-poslane neresnično: {
		svoj podatki-seje Nič? neresnično: {
			svoj upravitelj-sej shrani: svoj podatki-seje.
		}.
		svoj glave dodaj-na-konec: (
			Glava-HTTP nov
			ključ: ['Content-type'] vrednost: tip
		).
		svoj glave dodaj-na-konec: (
			Glava-HTTP nov
			ključ: ['Content-Length'] vrednost: izhod besedilo bytes
		).
		svoj glave vsak: { :_ :glava
			Izhod piši: glava.
		}.
		svoj glave-poslane := Resnično.
		Izhod piši: ['\r\n'].
	}.
	Izhod piši: izhod.
}.

Spletni-dokument ob: ['izpiši:'] izvedi: { :izhod
	sebe izpiši: izhod tip: ['text/html; charset=utf-8'].
}.

Spletni-dokument ob: ['zaključi:'] izvedi: { :izhod
	sebe zaključi: izhod tip: ['text/html; charset=utf-8'].
}.

Spletni-dokument ob: ['json:'] izvedi: { :izhod
	sebe izpiši: ( JSON jsonify: izhod ) tip: ['application/json'].
}.

Spletni-dokument ob: ['ni-najdeno:'] izvedi: { :izhod
	sebe izprazni-glave glava: (
		Glava-HTTP nov ključ: ['Status'] vrednost: ['404 Not Found']
	).
	sebe izpiši: izhod.
}.


# Interface

>> Seja := Objekt nov.

Seja ob: ['nov'] izvedi: { <- sebe nov inicializiraj za: Nič.
}.

Seja ob: ['za:'] izvedi: { :id
	svoj id := id.
}.

Seja ob: ['naloži'] izvedi: {
	ta-naloga napaka: ['Not implemented.'].
}.

Seja ob: ['shrani:'] izvedi: {
	ta-naloga napaka: ['Not implemented.'].
}.

Seja ob: ['uniči'] izvedi: {
	ta-naloga napaka: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seja-začasna-datoteka := Seja nov.

Seja-začasna-datoteka ob: ['inicializiraj'] izvedi: {
	svoj začetek-poti := ['/tmp/sess-'].
}.

Seja-začasna-datoteka ob: ['predpona-poti:'] izvedi: { :niz
	svoj začetek-poti := niz.
}.

Seja-začasna-datoteka ob: ['datoteka'] izvedi: { <- ( Datoteka nov: ( svoj začetek-poti + svoj id + ['.txt'] ) ).
}.

Seja-začasna-datoteka ob: ['naloži'] izvedi: {
	>> datoteka := sebe datoteka.
	datoteka obstaja neresnično: {
		datoteka piši: (Slovar nov koda).
	}. <- datoteka beri objekt.
}.

Seja-začasna-datoteka ob: ['shrani:'] izvedi: { :podatki
	>> datoteka := sebe datoteka.
	datoteka obstaja resnično: {
		datoteka piši: podatki koda.
	}.
}.

Seja-začasna-datoteka ob: ['uniči'] izvedi: {
	>> datoteka := sebe datoteka.
	datoteka obstaja resnično: {
		datoteka izbriši.
	}.
}.


>> URL := Objekt nov.

URL ob: ['inicializiraj'] izvedi: {
	svoj protokol := ['https://'].
	svoj gostitelj := ['localhost'].
	svoj pot := [''].
	svoj parametri-url := [''].
	svoj hash := [''].
}.

URL ob: ['nov'] izvedi: { <- sebe nov inicializiraj.
}.

URL ob: ['besedilo'] izvedi: { <- (
	svoj protokol +
	svoj gostitelj +
	svoj pot +
	svoj parametri-url +
	svoj hash ).
}.

URL ob: ['protokol:'] izvedi: { :protokol
	((Seznam nov ; ['http'] ; ['https']) ima: protokol) resnično: {
		svoj protokol := protokol + ['://'].
	}, neresnično: {
		ta-naloga napaka: ['Invalid protocol'].
	}.
}.

URL ob: ['gostitelj:'] izvedi: { :gostitelj
	#todo validate according to rfc
	svoj gostitelj := gostitelj.
}.

URL ob: ['pot:'] izvedi: { :pot
	svoj pot := ['/'] + pot url-kodiraj.
}.

URL ob: ['parametri-url:'] izvedi: { :preslikava
	>> parametri-url := Seznam nov.
	preslikava vsak: { :ključ :vrednost
		parametri-url dodaj-na-konec: ključ besedilo url-kodiraj + ['='] + vrednost besedilo url-kodiraj.
	}.
	svoj parametri-url := ['?'] + ( parametri-url združi: ['&'] ).
}.

URL ob: ['zgoščena-vrednost:'] izvedi: { :hash
	svoj hash := ['#'] + hash url-kodiraj.
}.

