
# ~ Simple template engine ~

>> Predloga := Objekt nov.

Predloga ob: ['nov'] izvedi: { <- sebe nov vsebina: [''].
}.

Predloga ob: ['vsebina:'] izvedi: { :vsebina
	svoj vsebina := vsebina. 
}.

Predloga ob: ['nov:'] izvedi: { :vsebina <- sebe nov vsebina: vsebina.
}.

Predloga ob: ['izreži:'] izvedi: { :oznaka
	>> začetna-oznaka := (['<!-- cut:%id% -->'] %id%: oznaka).
	>> končna-oznaka := (['<!-- /cut:%id% -->'] %id%: oznaka).
	>> deli := svoj vsebina razdeli: začetna-oznaka.
	>> predpona := deli prvi.
	>> deli2 := deli zadnji razdeli: končna-oznaka.
	>> pripona := deli2 zadnji.
	>> del := deli2 prvi.
	>> ostanek := predpona + pripona.
	svoj vsebina := ostanek. <- Predloga nov: del.
	
}.

Predloga ob: ['kopiraj'] izvedi: { <- sebe nov: sebe besedilo kopiraj.
}.
	
Predloga ob: ['prilepi:na:'] izvedi: { :odlomek :id
	>> oznaka-lepljenja := (['<!-- paste:%id% -->'] %id%: id).
	svoj vsebina zamenjaj: oznaka-lepljenja z: ( odlomek besedilo + oznaka-lepljenja ).
}.

Predloga ob: ['nastavi:vrednost:'] izvedi: { :reža :vrednost
	svoj vsebina zamenjaj: ['<!-- slot:'] + reža + [' -->'] z: ( Server html-kodiraj: vrednost ).
}.

Predloga ob: ['nastavi:html:'] izvedi: { :reža :html
	svoj vsebina zamenjaj: ['<!-- slot:'] + reža + [' -->'] z: html.
}.

Predloga ob: ['odgovori:in:'] izvedi: { :reža :vrednost
	sebe nastavi: (reža od: 0 dolžina: (reža dolžina - 1)) vrednost: vrednost.
}.

Predloga ob: ['nl2br'] izvedi: {
	svoj vsebina zamenjaj: ['\n'] z: ['<br>'].
}.

Predloga ob: ['pospravi'] izvedi: {
	svoj vsebina :=
		Vzorec
		nov: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ujemanje: svoj vsebina
		izvedi: { <- ['']. }.
}.

Predloga ob: ['pospravi-izreze'] izvedi: {
	>> elementi := Seznam nov.
	Vzorec
	nov: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ujemanje: svoj vsebina
	izvedi: { :_ :del
		elementi dodaj-na-konec: del ? 1.
	}.
	elementi vsak: { :_ :id
		svoj vsebina :=
			Vzorec nov: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ujemanje: svoj vsebina
			izvedi: { <- ['']. }.
	 }.
}.

Predloga ob: ['pospravi-presledke'] izvedi: {
	svoj vsebina :=
		Vzorec
		nov: ['\\s*\\n'],
		ujemanje: svoj vsebina
		izvedi: { <- ['\n']. }.
	svoj vsebina :=
		Vzorec
		nov: ['\\n[\\s\\t]+'],
		ujemanje: svoj vsebina
		izvedi: { <- ['\n']. }.
}.

Predloga ob: ['pospravi-vse'] izvedi: {
	sebe pospravi.
	sebe pospravi-izreze.
	sebe pospravi-presledke.
}.

Predloga ob: ['besedilo'] izvedi: { <- svoj vsebina.
}.
