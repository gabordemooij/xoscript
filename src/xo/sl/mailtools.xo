>> Email := Objekt nov.

Email ob: ['inicializiraj'] izvedi: {
	svoj prejemniki := Seznam nov.
	svoj cc := Seznam nov.
	svoj bcc := Seznam nov.
	svoj pošiljatelj := Nič.
	svoj ime-pošiljatelja := Nič.
	svoj zadeva := Nič.
	svoj telo := Nič.
}.

Email ob: ['nov'] izvedi: { <- sebe nov inicializiraj.
}.

Email ob: ['komu:'] izvedi: { :naštevanje
	svoj prejemniki := naštevanje.
}.
 
Email ob: ['cc:'] izvedi: { :naštevanje
	svoj cc := naštevanje.
}.

Email ob: ['bcc:'] izvedi: { :naštevanje
	svoj bcc := naštevanje.
}.

Email ob: ['zadeva:'] izvedi: { :zadeva
	svoj zadeva := zadeva.
}.

Email ob: ['pošiljatelj:ime:'] izvedi: { :pošiljatelj :ime
	svoj pošiljatelj := pošiljatelj.
	svoj ime-pošiljatelja := ime.
}.

Email ob: ['telo:'] izvedi: { :telo
	svoj telo := telo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email ob: ['glava:'] izvedi: { :vrstica <- vrstica zamenjaj: ['\r'] z: [''], zamenjaj: ['\n'] z: [''].
}.

Email ob: ['pošlji'] izvedi: {
	>> f := Datoteka tempwrite: sebe ustvari.
	Program sistem: ['sendmail -t < '] + f pot, nova-vrstica.
}.

Email ob: ['ustvari'] izvedi: {
	>> prelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-konec: (sebe glava: ['From: '] + svoj ime-pošiljatelja + [' <'] + ( svoj pošiljatelj ) + ['>']) + prelom.
	niz dodaj-na-konec: (sebe glava: ['To: '] + ( svoj prejemniki združi: [','] )) + prelom.
	svoj cc število-elementov resnično: {
		niz dodaj-na-konec: (sebe glava: ['Cc: '] + ( svoj cc združi: [','] )) + prelom.
	}.
	svoj bcc število-elementov resnično: {
		niz dodaj-na-konec: (sebe glava: ['Bcc: '] + ( svoj bcc združi: [','] )) + prelom.
	}.
	niz dodaj-na-konec: (sebe glava: ['Subject: '] + svoj zadeva) + prelom.
	niz dodaj-na-konec: prelom.
	niz dodaj-na-konec: svoj telo.
	niz dodaj-na-konec: prelom. <- niz.
}.

>> HTML-Email := Email nov.

HTML-Email ob: ['inicializiraj'] izvedi: {
	sebe inicializiraj.
	svoj priloge := Seznam nov.
	svoj meja := Sef žeton: 40.
}.

HTML-Email ob: ['priloži:'] izvedi: { :datoteka
	>> id := svoj priloge število-elementov.
	>> blob := datoteka blob.
	svoj priloge dodaj-na-konec: (
		Slovar nov
			datoteka: datoteka pot,
			mime: ['image/'] + (Server mimetype: datoteka pot),
			podatki: blob base64-kodiraj
	).
	blob sprosti. <- ['cid:attachment'] + id.
}.

HTML-Email ob: ['ustvari'] izvedi: {
	>> prelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-konec: (sebe glava: ['From: '] + svoj ime-pošiljatelja + [' <'] + ( svoj pošiljatelj ) + ['>']) + prelom.
	niz dodaj-na-konec: (sebe glava: ['To: '] + ( svoj prejemniki združi: [','] )) + prelom.
	svoj cc število-elementov resnično: {
		niz dodaj-na-konec: (sebe glava: ['Cc: '] + ( svoj cc združi: [','] )) + prelom.
	}.
	svoj bcc število-elementov resnično: {
		niz dodaj-na-konec: (sebe glava: ['Bcc: '] + ( svoj bcc združi: [','] )) + prelom.
	}.
	niz dodaj-na-konec: (sebe glava: ['Subject: '] + svoj zadeva) + prelom.
	niz dodaj-na-konec: ['MIME-Version: 1.0'] + prelom.
	niz dodaj-na-konec: ['Content-Type: multipart/related; boundary="'] + svoj meja + ['"; type=text/html'] + prelom.
	niz dodaj-na-konec: prelom.
	niz dodaj-na-konec: ['--'] + svoj meja + prelom.
	niz dodaj-na-konec: ['Content-Type: text/html; charset=UTF-8'] + prelom.
	niz dodaj-na-konec: ['Content-Transfer-Encoding: 7bit'] + prelom.
	niz dodaj-na-konec: prelom.
	niz dodaj-na-konec: svoj telo.
	niz dodaj-na-konec: prelom.
	svoj priloge vsak: { :id :info
		>> blob := info podatki.
		niz dodaj-na-konec: ['--'] + svoj meja + prelom.
		niz dodaj-na-konec: ['Content-Type: '] + info mime + prelom.
		niz dodaj-na-konec: ['Content-Transfer-Encoding: base64'] + prelom.
		niz dodaj-na-konec: ['Content-ID: <attachment'] + id + ['>'] + prelom.
		niz dodaj-na-konec: ['Content-Disposition: inline; filename="'] + info datoteka + ['"'] + prelom.
		niz dodaj-na-konec: prelom.
		>> največ := 76.
		>> dolžina-besedila := blob dolžina.
		>> kosi := (dolžina-besedila / največ) zaokroži-navzgor.
		{ :i
			>> kos := blob kopiraj od: i * največ dolžina: največ.
			niz dodaj-na-konec: kos + prelom.
		} * kosi.
		niz dodaj-na-konec: prelom.
		niz dodaj-na-konec: prelom.
	}.
	niz dodaj-na-konec: ['--'] + svoj meja + ['--'] + prelom. <- niz.
}.
