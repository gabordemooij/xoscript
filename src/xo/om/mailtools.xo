>> Imeelii := Wanta haaraa.

Imeelii irratti: ['qopheessi'] godhi: {
	koo fudhattoota := Tarree-wantootaa haaraa.
	koo cc := Tarree-wantootaa haaraa.
	koo bcc := Tarree-wantootaa haaraa.
	koo ergituu := Homaa.
	koo maqaa-ergituu := Homaa.
	koo mata-duree := Homaa.
	koo qaama := Homaa.
}.

Imeelii irratti: ['haaraa'] godhi: { <- ofii haaraa qopheessi.
}.

Imeelii irratti: ['gara:'] godhi: { :tarreessuu
	koo fudhattoota := tarreessuu.
}.
 
Imeelii irratti: ['cc:'] godhi: { :tarreessuu
	koo cc := tarreessuu.
}.

Imeelii irratti: ['bcc:'] godhi: { :tarreessuu
	koo bcc := tarreessuu.
}.

Imeelii irratti: ['mata-duree:'] godhi: { :mata-duree
	koo mata-duree := mata-duree.
}.

Imeelii irratti: ['ergituu:maqaa:'] godhi: { :ergituu :maqaa
	koo ergituu := ergituu.
	koo maqaa-ergituu := maqaa.
}.

Imeelii irratti: ['qaama:'] godhi: { :qaama
	koo qaama := qaama.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeelii irratti: ['mataa:'] godhi: { :sarara <- sarara bakka-buusi: ['\r'] tiin: [''], bakka-buusi: ['\n'] tiin: [''].
}.

Imeelii irratti: ['ergi'] godhi: {
	>> f := Faayila tempwrite: ofii uumi.
	Sagantaa shelli: ['sendmail -t < '] + f karaa, dhaabi.
}.

Imeelii irratti: ['uumi'] godhi: {
	>> cita-sararaa := ['\r\n'].
	>> tarree-barreeffamaa := [''].
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['From: '] + koo maqaa-ergituu + [' <'] + ( koo ergituu ) + ['>']) + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['To: '] + ( koo fudhattoota waliingalchi: [','] )) + cita-sararaa.
	koo cc lakkaaʼi yoodhugaa: {
		tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Cc: '] + ( koo cc waliingalchi: [','] )) + cita-sararaa.
	}.
	koo bcc lakkaaʼi yoodhugaa: {
		tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Bcc: '] + ( koo bcc waliingalchi: [','] )) + cita-sararaa.
	}.
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Subject: '] + koo mata-duree) + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: koo qaama.
	tarree-barreeffamaa dabaliboodatti: cita-sararaa. <- tarree-barreeffamaa.
}.

>> Imeelii-HTML := Imeelii haaraa.

Imeelii-HTML irratti: ['qopheessi'] godhi: {
	ofii qopheessi.
	koo maxxansaalee := Tarree-wantootaa haaraa.
	koo daangaa := Kuusaa-nageenyaa token: 40.
}.

Imeelii-HTML irratti: ['maxxansi:'] godhi: { :faayilii-marii
	>> id := koo maxxansaalee lakkaaʼi.
	>> blob := faayilii-marii blob.
	koo maxxansaalee dabaliboodatti: (
		Galmee-jechootaa haaraa
			faayilii-marii: faayilii-marii karaa,
			mime: ['image/'] + (Server mimetype: faayilii-marii karaa),
			daataa: blob base64-koodessi
	).
	blob gadi-lakkisi. <- ['cid:attachment'] + id.
}.

Imeelii-HTML irratti: ['uumi'] godhi: {
	>> cita-sararaa := ['\r\n'].
	>> tarree-barreeffamaa := [''].
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['From: '] + koo maqaa-ergituu + [' <'] + ( koo ergituu ) + ['>']) + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['To: '] + ( koo fudhattoota waliingalchi: [','] )) + cita-sararaa.
	koo cc lakkaaʼi yoodhugaa: {
		tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Cc: '] + ( koo cc waliingalchi: [','] )) + cita-sararaa.
	}.
	koo bcc lakkaaʼi yoodhugaa: {
		tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Bcc: '] + ( koo bcc waliingalchi: [','] )) + cita-sararaa.
	}.
	tarree-barreeffamaa dabaliboodatti: (ofii mataa: ['Subject: '] + koo mata-duree) + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: ['MIME-Version: 1.0'] + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: ['Content-Type: multipart/related; boundary="'] + koo daangaa + ['"; type=text/html'] + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: ['--'] + koo daangaa + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: ['Content-Type: text/html; charset=UTF-8'] + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: ['Content-Transfer-Encoding: 7bit'] + cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: cita-sararaa.
	tarree-barreeffamaa dabaliboodatti: koo qaama.
	tarree-barreeffamaa dabaliboodatti: cita-sararaa.
	koo maxxansaalee hundaaf: { :id :odeeffannoo
		>> blob := odeeffannoo daataa.
		tarree-barreeffamaa dabaliboodatti: ['--'] + koo daangaa + cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: ['Content-Type: '] + odeeffannoo mime + cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: ['Content-Transfer-Encoding: base64'] + cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: ['Content-ID: <attachment'] + id + ['>'] + cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: ['Content-Disposition: inline; filename="'] + odeeffannoo faayilii-marii + ['"'] + cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: cita-sararaa.
		>> olaanaa := 76.
		>> dheerina-barreeffamaa := blob dheerina.
		>> kutaalee-xiqqaa := (dheerina-barreeffamaa / olaanaa) oli.
		{ :i
			>> kutaa-xiqqaa := blob kopii irraa: i * olaanaa dheerina: olaanaa.
			tarree-barreeffamaa dabaliboodatti: kutaa-xiqqaa + cita-sararaa.
		} * kutaalee-xiqqaa.
		tarree-barreeffamaa dabaliboodatti: cita-sararaa.
		tarree-barreeffamaa dabaliboodatti: cita-sararaa.
	}.
	tarree-barreeffamaa dabaliboodatti: ['--'] + koo daangaa + ['--'] + cita-sararaa. <- tarree-barreeffamaa.
}.
