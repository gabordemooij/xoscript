
# ~ Simple template engine ~

>> Bocaa := Wanta haaraa.

Bocaa irratti: ['haaraa'] godhi: { <- ofii haaraa qabiyyee: [''].
}.

Bocaa irratti: ['qabiyyee:'] godhi: { :qabiyyee
	koo qabiyyee := qabiyyee. 
}.

Bocaa irratti: ['haaraa:'] godhi: { :qabiyyee <- ofii haaraa qabiyyee: qabiyyee.
}.

Bocaa irratti: ['muri:'] godhi: { :mallattoo
	>> mallattoo-jalqabaa := (['<!-- cut:%id% -->'] %id%: mallattoo).
	>> mallattoo-dhumaa := (['<!-- /cut:%id% -->'] %id%: mallattoo).
	>> kutaalee := koo qabiyyee addaan-bahi: mallattoo-jalqabaa.
	>> durgale := kutaalee jalqabaa.
	>> kutaalee2 := kutaalee dhumaa addaan-bahi: mallattoo-dhumaa.
	>> dubaale := kutaalee2 dhumaa.
	>> kutaa := kutaalee2 jalqabaa.
	>> hafe := durgale + dubaale.
	koo qabiyyee := hafe. <- Bocaa haaraa: kutaa.
	
}.

Bocaa irratti: ['kopii'] godhi: { <- ofii haaraa: ofii gara-barreeffamaatti kopii.
}.
	
Bocaa irratti: ['qabsiisi:itti:'] godhi: { :cuunfaa :id
	>> mallattoo-qabsiisuu := (['<!-- paste:%id% -->'] %id%: id).
	koo qabiyyee bakka-buusi: mallattoo-qabsiisuu tiin: ( cuunfaa gara-barreeffamaatti + mallattoo-qabsiisuu ).
}.

Bocaa irratti: ['kaaʼi:gatii:'] godhi: { :iddoo :gatii
	koo qabiyyee bakka-buusi: ['<!-- slot:'] + iddoo + [' -->'] tiin: ( Server html-koodessi: gatii ).
}.

Bocaa irratti: ['kaaʼi:html:'] godhi: { :iddoo :html
	koo qabiyyee bakka-buusi: ['<!-- slot:'] + iddoo + [' -->'] tiin: html.
}.

Bocaa irratti: ['deebii-kenni:fi:'] godhi: { :iddoo :gatii
	ofii kaaʼi: (iddoo irraa: 0 dheerina: (iddoo dheerina - 1)) gatii: gatii.
}.

Bocaa irratti: ['nl2br'] godhi: {
	koo qabiyyee bakka-buusi: ['\n'] tiin: ['<br>'].
}.

Bocaa irratti: ['qulqulleessi'] godhi: {
	koo qabiyyee :=
		Akkaataa
		haaraa: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		walsimannaa: koo qabiyyee
		godhi: { <- ['']. }.
}.

Bocaa irratti: ['kutaalee-qulqulleessi'] godhi: {
	>> wantoota := Tarree-wantootaa haaraa.
	Akkaataa
	haaraa: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	walsimannaa: koo qabiyyee
	godhi: { :_ :kutaa
		wantoota dabaliboodatti: kutaa ? 1.
	}.
	wantoota hundaaf: { :_ :id
		koo qabiyyee :=
			Akkaataa haaraa: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			walsimannaa: koo qabiyyee
			godhi: { <- ['']. }.
	 }.
}.

Bocaa irratti: ['iddoo-duwwaa-qulqulleessi'] godhi: {
	koo qabiyyee :=
		Akkaataa
		haaraa: ['\\s*\\n'],
		walsimannaa: koo qabiyyee
		godhi: { <- ['\n']. }.
	koo qabiyyee :=
		Akkaataa
		haaraa: ['\\n[\\s\\t]+'],
		walsimannaa: koo qabiyyee
		godhi: { <- ['\n']. }.
}.

Bocaa irratti: ['hunda-qulqulleessi'] godhi: {
	ofii qulqulleessi.
	ofii kutaalee-qulqulleessi.
	ofii iddoo-duwwaa-qulqulleessi.
}.

Bocaa irratti: ['gara-barreeffamaatti'] godhi: { <- koo qabiyyee.
}.
