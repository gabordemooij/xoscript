Gaaffii-HTTP irratti: ['HTTP-mataa:'] godhi: { :furtuu <- Sagantaa qindaaʼina: furtuu.
}.

>> Mataa-HTTP := Wanta haaraa.

Mataa-HTTP irratti: ['haaraa'] godhi: { <- ofii haaraa qopheessi.
}.

Mataa-HTTP irratti: ['qopheessi'] godhi: {
	koo furtuu := Homaa.
	koo gatii := Homaa.
}.

Mataa-HTTP irratti: ['furtuu:gatii:'] godhi: { :furtuu :gatii
	koo furtuu := furtuu.
	koo gatii := gatii.
}.

Mataa-HTTP irratti: ['furtuu'] godhi: { <- koo furtuu.
}.

Mataa-HTTP irratti: ['gatii'] godhi: { <- koo gatii.
}.


Mataa-HTTP irratti: ['gara-barreeffamaatti'] godhi: {
	>> sarara := koo furtuu + [': '] + koo gatii.
	sarara bakka-buusi: ['\r'] tiin: [''], bakka-buusi: ['\n'] tiin: ['']. <- sarara + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Sanada-Weebii := Wanta haaraa.

Sanada-Weebii irratti: ['haaraa'] godhi: { <- ofii haaraa qopheessi.
}.

Sanada-Weebii irratti: ['qopheessi'] godhi: {
	koo mataalee := Tarree-wantootaa haaraa.
	koo id-marii := Homaa.
	koo bulchaa-marii := Marii-faayilii-yeroo haaraa.
	koo daataa-marii := Homaa.
	koo nageenya-qabu := Dhugaa.
	koo marsariitii-tokko := ['Strict'].
	koo mataalee-ergaman := Soba.
	koo gaaffii-http := Gaaffii-HTTP haaraa.
}.

Sanada-Weebii irratti: ['gaaffii-http:'] godhi: { :gaaffii-http
	koo gaaffii-http := gaaffii-http.
}. 

Sanada-Weebii irratti: ['kuukii-marii-nageenya-qabu:'] godhi: { :nageenya-qabu
	ofii mataalee-mirkaneessi.
	koo nageenya-qabu := nageenya-qabu.
}.

Sanada-Weebii irratti: ['kuukii-marii-marsariitii-tokko:'] godhi: { :gatii
	ofii mataalee-mirkaneessi.
	>> filannoowwan := Tarree-wantootaa haaraa 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	filannoowwan qaba: gatii, yoosoba: {
		hojii-kana dogoggora: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	koo marsariitii-tokko := gatii.
}.

Sanada-Weebii irratti: ['mataa:'] godhi: { :mataa
	ofii mataalee-mirkaneessi.
	koo mataalee dabaliboodatti: mataa.
}.

Sanada-Weebii irratti: ['mataalee-haqi'] godhi: {
	ofii mataalee-mirkaneessi.
	koo mataalee := Tarree-wantootaa haaraa.
}.

Sanada-Weebii irratti: ['bulchaa-marii:'] godhi: { :bulchaa
	ofii mataalee-mirkaneessi.
	koo bulchaa-marii := bulchaa.
}.

Sanada-Weebii irratti: ['bulchaa-marii'] godhi: { <- koo bulchaa-marii.
}.

Sanada-Weebii irratti: ['mataalee-mirkaneessi'] godhi: {
	koo mataalee-ergaman yoodhugaa: {
		hojii-kana dogoggora: ['Headers already sent to client.'].
	}.
}.

Sanada-Weebii irratti: ['marii-jalqabi'] godhi: {
	ofii mataalee-mirkaneessi.
	>> gaaffii-http := koo gaaffii-http.
	>> id-marii := gaaffii-http cookie: ['xsid'].
	id-marii Homaa? yoosoba: {
		(( Akkaataa haaraa: ['^[A-Za-z0-9]+\\z'], walsimannaa: id-marii ) = 0) yoodhugaa: {
			id-marii := Homaa.
		}.
	}.
	id-marii Homaa? yoodhugaa: {
		id-marii := Kuusaa-nageenyaa token: 30.
		>> mataa-marii := Mataa-HTTP haaraa
		furtuu: ['Set-Cookie'] gatii: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (koo nageenya-qabu tokkoykn: ['Secure'] ykn: ['']),
		SSITE: (koo marsariitii-tokko),
		XSID: id-marii
		).
		koo mataalee dabaliboodatti: mataa-marii.
	}.
	koo daataa-marii := koo bulchaa-marii kan: id-marii, galchi. <- koo daataa-marii. # reference
}.

Sanada-Weebii irratti: ['gara-deemi:'] godhi: { :teessoo
	ofii mataalee-mirkaneessi.
	ofii mataalee-haqi.
	koo mataalee
	dabaliboodatti: (
		Mataa-HTTP haaraa
		furtuu: ['Status'] gatii: ['303 See Other']
	),
	dabaliboodatti: (
		Mataa-HTTP haaraa
		furtuu: ['Location'] gatii: teessoo
	).
	ofii baasi: ['Redirect'].
}.

Sanada-Weebii irratti: ['marii-balleessi'] godhi: {
	ofii mataalee-mirkaneessi.
	>> gaaffii-http := koo gaaffii-http.
	>> id-marii := gaaffii-http cookie: ['xsid'].
	id-marii Homaa? yoosoba: {
		>> mataa-marii := Mataa-HTTP haaraa.
		>> yeroo-dhumaa := Yeroo haaraa bara: 1970, bifaan: ['%a, %d %b %Y %H:%M:%S GMT'].
		mataa-marii furtuu: ['Set-Cookie'] gatii: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: yeroo-dhumaa,
			SEC: (koo nageenya-qabu tokkoykn: ['Secure'] ykn: ['']),
			SSITE: (koo marsariitii-tokko),
			XSID: id-marii
		).
		koo bulchaa-marii balleessi.
		koo mataalee dabaliboodatti: mataa-marii.
	}.
}.


Sanada-Weebii irratti: ['bocaa:'] godhi: { :karaa <- Bocaa haaraa: (Faayila haaraa: karaa, dubbisi).
}.

Sanada-Weebii irratti: ['baasi:gosa:'] godhi: { :firii :gosa
	koo mataalee-ergaman yoosoba: {
		koo daataa-marii Homaa? yoosoba: {
			koo bulchaa-marii kuusi: koo daataa-marii.
		}.
		koo mataalee dabaliboodatti: (
			Mataa-HTTP haaraa
			furtuu: ['Content-type'] gatii: gosa
		).
		koo mataalee hundaaf: { :_ :mataa
			Baʼii barreessi: mataa.
		}.
		koo mataalee-ergaman := Dhugaa.
		Baʼii barreessi: ['\r\n'].
	}.
	Baʼii barreessi: firii.
}.

Sanada-Weebii irratti: ['xumuri:gosa:'] godhi: { :firii :gosa
	koo mataalee-ergaman yoosoba: {
		koo daataa-marii Homaa? yoosoba: {
			koo bulchaa-marii kuusi: koo daataa-marii.
		}.
		koo mataalee dabaliboodatti: (
			Mataa-HTTP haaraa
			furtuu: ['Content-type'] gatii: gosa
		).
		koo mataalee dabaliboodatti: (
			Mataa-HTTP haaraa
			furtuu: ['Content-Length'] gatii: firii gara-barreeffamaatti bytes
		).
		koo mataalee hundaaf: { :_ :mataa
			Baʼii barreessi: mataa.
		}.
		koo mataalee-ergaman := Dhugaa.
		Baʼii barreessi: ['\r\n'].
	}.
	Baʼii barreessi: firii.
}.

Sanada-Weebii irratti: ['baasi:'] godhi: { :firii
	ofii baasi: firii gosa: ['text/html; charset=utf-8'].
}.

Sanada-Weebii irratti: ['xumuri:'] godhi: { :firii
	ofii xumuri: firii gosa: ['text/html; charset=utf-8'].
}.

Sanada-Weebii irratti: ['json:'] godhi: { :firii
	ofii baasi: ( JSON jsonify: firii ) gosa: ['application/json'].
}.

Sanada-Weebii irratti: ['hin-argamne:'] godhi: { :firii
	ofii mataalee-haqi mataa: (
		Mataa-HTTP haaraa furtuu: ['Status'] gatii: ['404 Not Found']
	).
	ofii baasi: firii.
}.


# Interface

>> Marii := Wanta haaraa.

Marii irratti: ['haaraa'] godhi: { <- ofii haaraa qopheessi kan: Homaa.
}.

Marii irratti: ['kan:'] godhi: { :id
	koo id := id.
}.

Marii irratti: ['galchi'] godhi: {
	hojii-kana dogoggora: ['Not implemented.'].
}.

Marii irratti: ['kuusi:'] godhi: {
	hojii-kana dogoggora: ['Not implemented.'].
}.

Marii irratti: ['balleessi'] godhi: {
	hojii-kana dogoggora: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Marii-faayilii-yeroo := Marii haaraa.

Marii-faayilii-yeroo irratti: ['qopheessi'] godhi: {
	koo jalqaba-karaa := ['/tmp/sess-'].
}.

Marii-faayilii-yeroo irratti: ['durgale-karaa:'] godhi: { :tarree-barreeffamaa
	koo jalqaba-karaa := tarree-barreeffamaa.
}.

Marii-faayilii-yeroo irratti: ['faayilii-marii'] godhi: { <- ( Faayila haaraa: ( koo jalqaba-karaa + koo id + ['.txt'] ) ).
}.

Marii-faayilii-yeroo irratti: ['galchi'] godhi: {
	>> faayilii-marii := ofii faayilii-marii.
	faayilii-marii jira yoosoba: {
		faayilii-marii barreessi: (Galmee-jechootaa haaraa koodii).
	}. <- faayilii-marii dubbisi gara-wantaatti.
}.

Marii-faayilii-yeroo irratti: ['kuusi:'] godhi: { :daataa
	>> faayilii-marii := ofii faayilii-marii.
	faayilii-marii jira yoodhugaa: {
		faayilii-marii barreessi: daataa koodii.
	}.
}.

Marii-faayilii-yeroo irratti: ['balleessi'] godhi: {
	>> faayilii-marii := ofii faayilii-marii.
	faayilii-marii jira yoodhugaa: {
		faayilii-marii haqi.
	}.
}.


>> URL := Wanta haaraa.

URL irratti: ['qopheessi'] godhi: {
	koo seera-qunnamtii := ['https://'].
	koo keessummeessaa := ['localhost'].
	koo karaa := [''].
	koo qajeelchoota-url := [''].
	koo hash := [''].
}.

URL irratti: ['haaraa'] godhi: { <- ofii haaraa qopheessi.
}.

URL irratti: ['gara-barreeffamaatti'] godhi: { <- (
	koo seera-qunnamtii +
	koo keessummeessaa +
	koo karaa +
	koo qajeelchoota-url +
	koo hash ).
}.

URL irratti: ['seera-qunnamtii:'] godhi: { :seera-qunnamtii
	((Tarree-wantootaa haaraa ; ['http'] ; ['https']) qaba: seera-qunnamtii) yoodhugaa: {
		koo seera-qunnamtii := seera-qunnamtii + ['://'].
	}, yoosoba: {
		hojii-kana dogoggora: ['Invalid protocol'].
	}.
}.

URL irratti: ['keessummeessaa:'] godhi: { :keessummeessaa
	#todo validate according to rfc
	koo keessummeessaa := keessummeessaa.
}.

URL irratti: ['karaa:'] godhi: { :karaa
	koo karaa := ['/'] + karaa url-koodessi.
}.

URL irratti: ['qajeelchoota-url:'] godhi: { :kaartaa
	>> qajeelchoota-url := Tarree-wantootaa haaraa.
	kaartaa hundaaf: { :furtuu :gatii
		qajeelchoota-url dabaliboodatti: furtuu gara-barreeffamaatti url-koodessi + ['='] + gatii gara-barreeffamaatti url-koodessi.
	}.
	koo qajeelchoota-url := ['?'] + ( qajeelchoota-url waliingalchi: ['&'] ).
}.

URL irratti: ['haashi:'] godhi: { :hash
	koo hash := ['#'] + hash url-koodessi.
}.

