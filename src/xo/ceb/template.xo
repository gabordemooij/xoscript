
# ~ Simple template engine ~

>> Plantilya := Butang bag-o.

Plantilya kon: ['bag-o'] buhata: { <- kaugalingon bag-o sulod: [''].
}.

Plantilya kon: ['sulod:'] buhata: { :sulod
	akoa sulod := sulod. 
}.

Plantilya kon: ['bag-o:'] buhata: { :sulod <- kaugalingon bag-o sulod: sulod.
}.

Plantilya kon: ['putla:'] buhata: { :timaan
	>> timaan-sa-sinugdan := (['<!-- cut:%id% -->'] %id%: timaan).
	>> timaan-sa-katapusan := (['<!-- /cut:%id% -->'] %id%: timaan).
	>> mga-bahin := akoa sulod bahina: timaan-sa-sinugdan.
	>> unlapi := mga-bahin una.
	>> mga-bahin2 := mga-bahin katapusan bahina: timaan-sa-katapusan.
	>> hulapi := mga-bahin2 katapusan.
	>> bahin := mga-bahin2 una.
	>> nahabilin := unlapi + hulapi.
	akoa sulod := nahabilin. <- Plantilya bag-o: bahin.
	
}.

Plantilya kon: ['kopyaha'] buhata: { <- kaugalingon bag-o: kaugalingon teksto kopyaha.
}.
	
Plantilya kon: ['idikit:sa:'] buhata: { :kinutlo :id
	>> timaan-sa-pagdikit := (['<!-- paste:%id% -->'] %id%: id).
	akoa sulod ilisi: timaan-sa-pagdikit ug: ( kinutlo teksto + timaan-sa-pagdikit ).
}.

Plantilya kon: ['ibutang:bili:'] buhata: { :luna :bili
	akoa sulod ilisi: ['<!-- slot:'] + luna + [' -->'] ug: ( Server html-i-encode: bili ).
}.

Plantilya kon: ['ibutang:html:'] buhata: { :luna :html
	akoa sulod ilisi: ['<!-- slot:'] + luna + [' -->'] ug: html.
}.

Plantilya kon: ['tubag:ug:'] buhata: { :luna :bili
	kaugalingon ibutang: (luna gikan-sa: 0 gitas-on: (luna gitas-on - 1)) bili: bili.
}.

Plantilya kon: ['nl2br'] buhata: {
	akoa sulod ilisi: ['\n'] ug: ['<br>'].
}.

Plantilya kon: ['hapsaya'] buhata: {
	akoa sulod :=
		Sumbanan
		bag-o: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		tukma: akoa sulod
		buhata: { <- ['']. }.
}.

Plantilya kon: ['hapsaya-ang-mga-giputol'] buhata: {
	>> mga-butang := Lista bag-o.
	Sumbanan
	bag-o: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	tukma: akoa sulod
	buhata: { :_ :bahin
		mga-butang idugang-sa-tumoy: bahin ? 1.
	}.
	mga-butang matag: { :_ :id
		akoa sulod :=
			Sumbanan bag-o: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			tukma: akoa sulod
			buhata: { <- ['']. }.
	 }.
}.

Plantilya kon: ['hapsaya-ang-mga-luna'] buhata: {
	akoa sulod :=
		Sumbanan
		bag-o: ['\\s*\\n'],
		tukma: akoa sulod
		buhata: { <- ['\n']. }.
	akoa sulod :=
		Sumbanan
		bag-o: ['\\n[\\s\\t]+'],
		tukma: akoa sulod
		buhata: { <- ['\n']. }.
}.

Plantilya kon: ['hapsaya-tanan'] buhata: {
	kaugalingon hapsaya.
	kaugalingon hapsaya-ang-mga-giputol.
	kaugalingon hapsaya-ang-mga-luna.
}.

Plantilya kon: ['teksto'] buhata: { <- akoa sulod.
}.
