Hangyo-HTTP kon: ['HTTP-ulohan:'] buhata: { :yawe <- Programa kahikayan: yawe.
}.

>> Ulohan-sa-HTTP := Butang bag-o.

Ulohan-sa-HTTP kon: ['bag-o'] buhata: { <- kaugalingon bag-o andama.
}.

Ulohan-sa-HTTP kon: ['andama'] buhata: {
	akoa yawe := Wala.
	akoa bili := Wala.
}.

Ulohan-sa-HTTP kon: ['yawe:bili:'] buhata: { :yawe :bili
	akoa yawe := yawe.
	akoa bili := bili.
}.

Ulohan-sa-HTTP kon: ['yawe'] buhata: { <- akoa yawe.
}.

Ulohan-sa-HTTP kon: ['bili'] buhata: { <- akoa bili.
}.


Ulohan-sa-HTTP kon: ['teksto'] buhata: {
	>> linya := akoa yawe + [': '] + akoa bili.
	linya ilisi: ['\r'] ug: [''], ilisi: ['\n'] ug: ['']. <- linya + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumento-sa-Web := Butang bag-o.

Dokumento-sa-Web kon: ['bag-o'] buhata: { <- kaugalingon bag-o andama.
}.

Dokumento-sa-Web kon: ['andama'] buhata: {
	akoa mga-ulohan := Lista bag-o.
	akoa id-sa-sesyon := Wala.
	akoa tigdumala-sa-sesyon := Sesyon-sa-temporaryong-file bag-o.
	akoa datos-sa-sesyon := Wala.
	akoa luwas := Tinuod.
	akoa parehas-nga-site := ['Strict'].
	akoa napadala-ang-ulohan := Bakak.
	akoa hangyo-http := Hangyo-HTTP bag-o.
}.

Dokumento-sa-Web kon: ['hangyo-http:'] buhata: { :hangyo-http
	akoa hangyo-http := hangyo-http.
}. 

Dokumento-sa-Web kon: ['luwas-nga-cookie-sa-sesyon:'] buhata: { :luwas
	kaugalingon susiha-ang-ulohan.
	akoa luwas := luwas.
}.

Dokumento-sa-Web kon: ['cookie-sa-sesyon-parehas-nga-site:'] buhata: { :bili
	kaugalingon susiha-ang-ulohan.
	>> mga-kapilian := Lista bag-o 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	mga-kapilian adunay: bili, bakak: {
		kining-buluhaton sayup: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	akoa parehas-nga-site := bili.
}.

Dokumento-sa-Web kon: ['ulohan:'] buhata: { :ulohan
	kaugalingon susiha-ang-ulohan.
	akoa mga-ulohan idugang-sa-tumoy: ulohan.
}.

Dokumento-sa-Web kon: ['haw-ang-ulohan'] buhata: {
	kaugalingon susiha-ang-ulohan.
	akoa mga-ulohan := Lista bag-o.
}.

Dokumento-sa-Web kon: ['tigdumala-sa-sesyon:'] buhata: { :tigdumala
	kaugalingon susiha-ang-ulohan.
	akoa tigdumala-sa-sesyon := tigdumala.
}.

Dokumento-sa-Web kon: ['tigdumala-sa-sesyon'] buhata: { <- akoa tigdumala-sa-sesyon.
}.

Dokumento-sa-Web kon: ['susiha-ang-ulohan'] buhata: {
	akoa napadala-ang-ulohan tinuod: {
		kining-buluhaton sayup: ['Headers already sent to client.'].
	}.
}.

Dokumento-sa-Web kon: ['sugdi-ang-sesyon'] buhata: {
	kaugalingon susiha-ang-ulohan.
	>> hangyo-http := akoa hangyo-http.
	>> id-sa-sesyon := hangyo-http cookie: ['xsid'].
	id-sa-sesyon Wala? bakak: {
		(( Sumbanan bag-o: ['^[A-Za-z0-9]+\\z'], tukma: id-sa-sesyon ) = 0) tinuod: {
			id-sa-sesyon := Wala.
		}.
	}.
	id-sa-sesyon Wala? tinuod: {
		id-sa-sesyon := Kaha token: 30.
		>> ulohan-sa-sesyon := Ulohan-sa-HTTP bag-o
		yawe: ['Set-Cookie'] bili: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (akoa luwas kini: ['Secure'] o-kana: ['']),
		SSITE: (akoa parehas-nga-site),
		XSID: id-sa-sesyon
		).
		akoa mga-ulohan idugang-sa-tumoy: ulohan-sa-sesyon.
	}.
	akoa datos-sa-sesyon := akoa tigdumala-sa-sesyon alang-sa: id-sa-sesyon, karga. <- akoa datos-sa-sesyon. # reference
}.

Dokumento-sa-Web kon: ['adto-sa:'] buhata: { :adres
	kaugalingon susiha-ang-ulohan.
	kaugalingon haw-ang-ulohan.
	akoa mga-ulohan
	idugang-sa-tumoy: (
		Ulohan-sa-HTTP bag-o
		yawe: ['Status'] bili: ['303 See Other']
	),
	idugang-sa-tumoy: (
		Ulohan-sa-HTTP bag-o
		yawe: ['Location'] bili: adres
	).
	kaugalingon ipagawas: ['Redirect'].
}.

Dokumento-sa-Web kon: ['gubaa-ang-sesyon'] buhata: {
	kaugalingon susiha-ang-ulohan.
	>> hangyo-http := akoa hangyo-http.
	>> id-sa-sesyon := hangyo-http cookie: ['xsid'].
	id-sa-sesyon Wala? bakak: {
		>> ulohan-sa-sesyon := Ulohan-sa-HTTP bag-o.
		>> higayon := Gutlo bag-o tuig: 1970, porma: ['%a, %d %b %Y %H:%M:%S GMT'].
		ulohan-sa-sesyon yawe: ['Set-Cookie'] bili: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: higayon,
			SEC: (akoa luwas kini: ['Secure'] o-kana: ['']),
			SSITE: (akoa parehas-nga-site),
			XSID: id-sa-sesyon
		).
		akoa tigdumala-sa-sesyon gubaa.
		akoa mga-ulohan idugang-sa-tumoy: ulohan-sa-sesyon.
	}.
}.


Dokumento-sa-Web kon: ['plantilya:'] buhata: { :dalan-sa-payl <- Plantilya bag-o: (Payl bag-o: dalan-sa-payl, basaha).
}.

Dokumento-sa-Web kon: ['ipagawas:matang:'] buhata: { :resulta :matang
	akoa napadala-ang-ulohan bakak: {
		akoa datos-sa-sesyon Wala? bakak: {
			akoa tigdumala-sa-sesyon tipigi: akoa datos-sa-sesyon.
		}.
		akoa mga-ulohan idugang-sa-tumoy: (
			Ulohan-sa-HTTP bag-o
			yawe: ['Content-type'] bili: matang
		).
		akoa mga-ulohan matag: { :_ :ulohan
			Gawas isulat: ulohan.
		}.
		akoa napadala-ang-ulohan := Tinuod.
		Gawas isulat: ['\r\n'].
	}.
	Gawas isulat: resulta.
}.

Dokumento-sa-Web kon: ['humana:matang:'] buhata: { :resulta :matang
	akoa napadala-ang-ulohan bakak: {
		akoa datos-sa-sesyon Wala? bakak: {
			akoa tigdumala-sa-sesyon tipigi: akoa datos-sa-sesyon.
		}.
		akoa mga-ulohan idugang-sa-tumoy: (
			Ulohan-sa-HTTP bag-o
			yawe: ['Content-type'] bili: matang
		).
		akoa mga-ulohan idugang-sa-tumoy: (
			Ulohan-sa-HTTP bag-o
			yawe: ['Content-Length'] bili: resulta teksto bytes
		).
		akoa mga-ulohan matag: { :_ :ulohan
			Gawas isulat: ulohan.
		}.
		akoa napadala-ang-ulohan := Tinuod.
		Gawas isulat: ['\r\n'].
	}.
	Gawas isulat: resulta.
}.

Dokumento-sa-Web kon: ['ipagawas:'] buhata: { :resulta
	kaugalingon ipagawas: resulta matang: ['text/html; charset=utf-8'].
}.

Dokumento-sa-Web kon: ['humana:'] buhata: { :resulta
	kaugalingon humana: resulta matang: ['text/html; charset=utf-8'].
}.

Dokumento-sa-Web kon: ['json:'] buhata: { :resulta
	kaugalingon ipagawas: ( JSON jsonify: resulta ) matang: ['application/json'].
}.

Dokumento-sa-Web kon: ['wala-makit-an:'] buhata: { :resulta
	kaugalingon haw-ang-ulohan ulohan: (
		Ulohan-sa-HTTP bag-o yawe: ['Status'] bili: ['404 Not Found']
	).
	kaugalingon ipagawas: resulta.
}.


# Interface

>> Sesyon := Butang bag-o.

Sesyon kon: ['bag-o'] buhata: { <- kaugalingon bag-o andama alang-sa: Wala.
}.

Sesyon kon: ['alang-sa:'] buhata: { :id
	akoa id := id.
}.

Sesyon kon: ['karga'] buhata: {
	kining-buluhaton sayup: ['Not implemented.'].
}.

Sesyon kon: ['tipigi:'] buhata: {
	kining-buluhaton sayup: ['Not implemented.'].
}.

Sesyon kon: ['gubaa'] buhata: {
	kining-buluhaton sayup: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesyon-sa-temporaryong-file := Sesyon bag-o.

Sesyon-sa-temporaryong-file kon: ['andama'] buhata: {
	akoa sinugdan-sa-agianan := ['/tmp/sess-'].
}.

Sesyon-sa-temporaryong-file kon: ['unlapi-sa-agianan:'] buhata: { :kuwerdas-sa-teksto
	akoa sinugdan-sa-agianan := kuwerdas-sa-teksto.
}.

Sesyon-sa-temporaryong-file kon: ['file-sa-sesyon'] buhata: { <- ( Payl bag-o: ( akoa sinugdan-sa-agianan + akoa id + ['.txt'] ) ).
}.

Sesyon-sa-temporaryong-file kon: ['karga'] buhata: {
	>> file-sa-sesyon := kaugalingon file-sa-sesyon.
	file-sa-sesyon anaa bakak: {
		file-sa-sesyon isulat: (Diksyonaryo bag-o kodigo).
	}. <- file-sa-sesyon basaha butang.
}.

Sesyon-sa-temporaryong-file kon: ['tipigi:'] buhata: { :datos
	>> file-sa-sesyon := kaugalingon file-sa-sesyon.
	file-sa-sesyon anaa tinuod: {
		file-sa-sesyon isulat: datos kodigo.
	}.
}.

Sesyon-sa-temporaryong-file kon: ['gubaa'] buhata: {
	>> file-sa-sesyon := kaugalingon file-sa-sesyon.
	file-sa-sesyon anaa tinuod: {
		file-sa-sesyon papasa.
	}.
}.


>> URL := Butang bag-o.

URL kon: ['andama'] buhata: {
	akoa protokol := ['https://'].
	akoa host := ['localhost'].
	akoa dalan-sa-payl := [''].
	akoa mga-parameter-sa-url := [''].
	akoa hash := [''].
}.

URL kon: ['bag-o'] buhata: { <- kaugalingon bag-o andama.
}.

URL kon: ['teksto'] buhata: { <- (
	akoa protokol +
	akoa host +
	akoa dalan-sa-payl +
	akoa mga-parameter-sa-url +
	akoa hash ).
}.

URL kon: ['protokol:'] buhata: { :protokol
	((Lista bag-o ; ['http'] ; ['https']) adunay: protokol) tinuod: {
		akoa protokol := protokol + ['://'].
	}, bakak: {
		kining-buluhaton sayup: ['Invalid protocol'].
	}.
}.

URL kon: ['host:'] buhata: { :host
	#todo validate according to rfc
	akoa host := host.
}.

URL kon: ['dalan-sa-payl:'] buhata: { :dalan-sa-payl
	akoa dalan-sa-payl := ['/'] + dalan-sa-payl url-i-encode.
}.

URL kon: ['mga-parameter-sa-url:'] buhata: { :pagmapa
	>> mga-parameter-sa-url := Lista bag-o.
	pagmapa matag: { :yawe :bili
		mga-parameter-sa-url idugang-sa-tumoy: yawe teksto url-i-encode + ['='] + bili teksto url-i-encode.
	}.
	akoa mga-parameter-sa-url := ['?'] + ( mga-parameter-sa-url hiusaha: ['&'] ).
}.

URL kon: ['hash:'] buhata: { :hash
	akoa hash := ['#'] + hash url-i-encode.
}.

