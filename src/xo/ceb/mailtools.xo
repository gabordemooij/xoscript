>> Email := Butang bag-o.

Email kon: ['andama'] buhata: {
	akoa mga-modawat := Lista bag-o.
	akoa cc := Lista bag-o.
	akoa bcc := Lista bag-o.
	akoa nagpadala := Wala.
	akoa ngalan-sa-nagpadala := Wala.
	akoa hilisgutan := Wala.
	akoa lawas := Wala.
}.

Email kon: ['bag-o'] buhata: { <- kaugalingon bag-o andama.
}.

Email kon: ['ngadto:'] buhata: { :paglista
	akoa mga-modawat := paglista.
}.
 
Email kon: ['cc:'] buhata: { :paglista
	akoa cc := paglista.
}.

Email kon: ['bcc:'] buhata: { :paglista
	akoa bcc := paglista.
}.

Email kon: ['hilisgutan:'] buhata: { :hilisgutan
	akoa hilisgutan := hilisgutan.
}.

Email kon: ['nagpadala:ngalan:'] buhata: { :nagpadala :ngalan
	akoa nagpadala := nagpadala.
	akoa ngalan-sa-nagpadala := ngalan.
}.

Email kon: ['lawas:'] buhata: { :lawas
	akoa lawas := lawas.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email kon: ['ulohan:'] buhata: { :linya <- linya ilisi: ['\r'] ug: [''], ilisi: ['\n'] ug: [''].
}.

Email kon: ['ipadala'] buhata: {
	>> f := Payl tempwrite: kaugalingon himoa.
	Programa sistema: ['sendmail -t < '] + f dalan-sa-payl, bag-ong-linya.
}.

Email kon: ['himoa'] buhata: {
	>> pagbuak-sa-linya := ['\r\n'].
	>> kuwerdas-sa-teksto := [''].
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['From: '] + akoa ngalan-sa-nagpadala + [' <'] + ( akoa nagpadala ) + ['>']) + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['To: '] + ( akoa mga-modawat hiusaha: [','] )) + pagbuak-sa-linya.
	akoa cc ihap tinuod: {
		kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Cc: '] + ( akoa cc hiusaha: [','] )) + pagbuak-sa-linya.
	}.
	akoa bcc ihap tinuod: {
		kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Bcc: '] + ( akoa bcc hiusaha: [','] )) + pagbuak-sa-linya.
	}.
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Subject: '] + akoa hilisgutan) + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: akoa lawas.
	kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya. <- kuwerdas-sa-teksto.
}.

>> HTML-Email := Email bag-o.

HTML-Email kon: ['andama'] buhata: {
	kaugalingon andama.
	akoa mga-lakip := Lista bag-o.
	akoa utlanan := Kaha token: 40.
}.

HTML-Email kon: ['ilakip:'] buhata: { :file-sa-sesyon
	>> id := akoa mga-lakip ihap.
	>> blob := file-sa-sesyon blob.
	akoa mga-lakip idugang-sa-tumoy: (
		Diksyonaryo bag-o
			file-sa-sesyon: file-sa-sesyon dalan-sa-payl,
			mime: ['image/'] + (Server mimetype: file-sa-sesyon dalan-sa-payl),
			datos: blob base64-i-encode
	).
	blob buhii. <- ['cid:attachment'] + id.
}.

HTML-Email kon: ['himoa'] buhata: {
	>> pagbuak-sa-linya := ['\r\n'].
	>> kuwerdas-sa-teksto := [''].
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['From: '] + akoa ngalan-sa-nagpadala + [' <'] + ( akoa nagpadala ) + ['>']) + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['To: '] + ( akoa mga-modawat hiusaha: [','] )) + pagbuak-sa-linya.
	akoa cc ihap tinuod: {
		kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Cc: '] + ( akoa cc hiusaha: [','] )) + pagbuak-sa-linya.
	}.
	akoa bcc ihap tinuod: {
		kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Bcc: '] + ( akoa bcc hiusaha: [','] )) + pagbuak-sa-linya.
	}.
	kuwerdas-sa-teksto idugang-sa-tumoy: (kaugalingon ulohan: ['Subject: '] + akoa hilisgutan) + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['MIME-Version: 1.0'] + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Type: multipart/related; boundary="'] + akoa utlanan + ['"; type=text/html'] + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['--'] + akoa utlanan + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Type: text/html; charset=UTF-8'] + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Transfer-Encoding: 7bit'] + pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
	kuwerdas-sa-teksto idugang-sa-tumoy: akoa lawas.
	kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
	akoa mga-lakip matag: { :id :impormasyon
		>> blob := impormasyon datos.
		kuwerdas-sa-teksto idugang-sa-tumoy: ['--'] + akoa utlanan + pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Type: '] + impormasyon mime + pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Transfer-Encoding: base64'] + pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-ID: <attachment'] + id + ['>'] + pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: ['Content-Disposition: inline; filename="'] + impormasyon file-sa-sesyon + ['"'] + pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
		>> labing-daghan := 76.
		>> gitas-on-sa-teksto := blob gitas-on.
		>> mga-tipak := (gitas-on-sa-teksto / labing-daghan) lingina-pataas.
		{ :i
			>> tipak := blob kopyaha gikan-sa: i * labing-daghan gitas-on: labing-daghan.
			kuwerdas-sa-teksto idugang-sa-tumoy: tipak + pagbuak-sa-linya.
		} * mga-tipak.
		kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
		kuwerdas-sa-teksto idugang-sa-tumoy: pagbuak-sa-linya.
	}.
	kuwerdas-sa-teksto idugang-sa-tumoy: ['--'] + akoa utlanan + ['--'] + pagbuak-sa-linya. <- kuwerdas-sa-teksto.
}.
