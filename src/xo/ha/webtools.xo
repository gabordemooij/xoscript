Buƙatar-HTTP idan: ['HTTP-kanun-saƙo:'] yi: { :maɓalli <- Shiri saiti: maɓalli.
}.

>> Kan-HTTP := Abu sabo.

Kan-HTTP idan: ['sabo'] yi: { <- kai sabo shirya.
}.

Kan-HTTP idan: ['shirya'] yi: {
	nasa maɓalli := Babu.
	nasa ƙima := Babu.
}.

Kan-HTTP idan: ['maɓalli:ƙima:'] yi: { :maɓalli :ƙima
	nasa maɓalli := maɓalli.
	nasa ƙima := ƙima.
}.

Kan-HTTP idan: ['maɓalli'] yi: { <- nasa maɓalli.
}.

Kan-HTTP idan: ['ƙima'] yi: { <- nasa ƙima.
}.


Kan-HTTP idan: ['rubutu'] yi: {
	>> layi := nasa maɓalli + [': '] + nasa ƙima.
	layi musanya: ['\r'] da: [''], musanya: ['\n'] da: ['']. <- layi + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Takardar-Yanar-Gizo := Abu sabo.

Takardar-Yanar-Gizo idan: ['sabo'] yi: { <- kai sabo shirya.
}.

Takardar-Yanar-Gizo idan: ['shirya'] yi: {
	nasa kanun-saƙonni := Jeri sabo.
	nasa id-zama := Babu.
	nasa manajan-zama := Zaman-fayil-na-wucin-gadi sabo.
	nasa bayanan-zama := Babu.
	nasa amintacce := Gaskiya.
	nasa shafi-ɗaya := ['Strict'].
	nasa an-aika-kanun := Ƙarya.
	nasa buƙata-http := Buƙatar-HTTP sabo.
}.

Takardar-Yanar-Gizo idan: ['buƙata-http:'] yi: { :buƙata-http
	nasa buƙata-http := buƙata-http.
}. 

Takardar-Yanar-Gizo idan: ['kuki-zama-amintacce:'] yi: { :amintacce
	kai duba-kanun-saƙonni.
	nasa amintacce := amintacce.
}.

Takardar-Yanar-Gizo idan: ['kuki-zama-shafi-ɗaya:'] yi: { :ƙima
	kai duba-kanun-saƙonni.
	>> zaɓuɓɓuka := Jeri sabo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	zaɓuɓɓuka yana-da: ƙima, ƙarya: {
		wannan-aiki kuskure: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	nasa shafi-ɗaya := ƙima.
}.

Takardar-Yanar-Gizo idan: ['kanun-saƙo:'] yi: { :kanun-saƙo
	kai duba-kanun-saƙonni.
	nasa kanun-saƙonni ƙara-a-ƙarshe: kanun-saƙo.
}.

Takardar-Yanar-Gizo idan: ['share-kanun-saƙonni'] yi: {
	kai duba-kanun-saƙonni.
	nasa kanun-saƙonni := Jeri sabo.
}.

Takardar-Yanar-Gizo idan: ['manajan-zama:'] yi: { :manaja
	kai duba-kanun-saƙonni.
	nasa manajan-zama := manaja.
}.

Takardar-Yanar-Gizo idan: ['manajan-zama'] yi: { <- nasa manajan-zama.
}.

Takardar-Yanar-Gizo idan: ['duba-kanun-saƙonni'] yi: {
	nasa an-aika-kanun gaskiya: {
		wannan-aiki kuskure: ['Headers already sent to client.'].
	}.
}.

Takardar-Yanar-Gizo idan: ['fara-zama'] yi: {
	kai duba-kanun-saƙonni.
	>> buƙata-http := nasa buƙata-http.
	>> id-zama := buƙata-http cookie: ['xsid'].
	id-zama Babu? ƙarya: {
		(( Salo sabo: ['^[A-Za-z0-9]+\\z'], dacewa: id-zama ) = 0) gaskiya: {
			id-zama := Babu.
		}.
	}.
	id-zama Babu? gaskiya: {
		id-zama := Asusu token: 30.
		>> kan-zama := Kan-HTTP sabo
		maɓalli: ['Set-Cookie'] ƙima: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (nasa amintacce ko-dai: ['Secure'] ko: ['']),
		SSITE: (nasa shafi-ɗaya),
		XSID: id-zama
		).
		nasa kanun-saƙonni ƙara-a-ƙarshe: kan-zama.
	}.
	nasa bayanan-zama := nasa manajan-zama domin: id-zama, loda. <- nasa bayanan-zama. # reference
}.

Takardar-Yanar-Gizo idan: ['je-zuwa:'] yi: { :adireshi
	kai duba-kanun-saƙonni.
	kai share-kanun-saƙonni.
	nasa kanun-saƙonni
	ƙara-a-ƙarshe: (
		Kan-HTTP sabo
		maɓalli: ['Status'] ƙima: ['303 See Other']
	),
	ƙara-a-ƙarshe: (
		Kan-HTTP sabo
		maɓalli: ['Location'] ƙima: adireshi
	).
	kai fitar: ['Redirect'].
}.

Takardar-Yanar-Gizo idan: ['lalata-zama'] yi: {
	kai duba-kanun-saƙonni.
	>> buƙata-http := nasa buƙata-http.
	>> id-zama := buƙata-http cookie: ['xsid'].
	id-zama Babu? ƙarya: {
		>> kan-zama := Kan-HTTP sabo.
		>> lokacin-ƙarewa := Lokaci sabo shekara: 1970, tsari: ['%a, %d %b %Y %H:%M:%S GMT'].
		kan-zama maɓalli: ['Set-Cookie'] ƙima: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: lokacin-ƙarewa,
			SEC: (nasa amintacce ko-dai: ['Secure'] ko: ['']),
			SSITE: (nasa shafi-ɗaya),
			XSID: id-zama
		).
		nasa manajan-zama lalata.
		nasa kanun-saƙonni ƙara-a-ƙarshe: kan-zama.
	}.
}.


Takardar-Yanar-Gizo idan: ['samfuri:'] yi: { :hanyar-fayil <- Samfuri sabo: (Fayil sabo: hanyar-fayil, karanta).
}.

Takardar-Yanar-Gizo idan: ['fitar:nauʼi:'] yi: { :sakamako :nauʼi
	nasa an-aika-kanun ƙarya: {
		nasa bayanan-zama Babu? ƙarya: {
			nasa manajan-zama ajiye: nasa bayanan-zama.
		}.
		nasa kanun-saƙonni ƙara-a-ƙarshe: (
			Kan-HTTP sabo
			maɓalli: ['Content-type'] ƙima: nauʼi
		).
		nasa kanun-saƙonni kowane: { :_ :kanun-saƙo
			Fitarwa rubuta: kanun-saƙo.
		}.
		nasa an-aika-kanun := Gaskiya.
		Fitarwa rubuta: ['\r\n'].
	}.
	Fitarwa rubuta: sakamako.
}.

Takardar-Yanar-Gizo idan: ['kammala:nauʼi:'] yi: { :sakamako :nauʼi
	nasa an-aika-kanun ƙarya: {
		nasa bayanan-zama Babu? ƙarya: {
			nasa manajan-zama ajiye: nasa bayanan-zama.
		}.
		nasa kanun-saƙonni ƙara-a-ƙarshe: (
			Kan-HTTP sabo
			maɓalli: ['Content-type'] ƙima: nauʼi
		).
		nasa kanun-saƙonni ƙara-a-ƙarshe: (
			Kan-HTTP sabo
			maɓalli: ['Content-Length'] ƙima: sakamako rubutu bytes
		).
		nasa kanun-saƙonni kowane: { :_ :kanun-saƙo
			Fitarwa rubuta: kanun-saƙo.
		}.
		nasa an-aika-kanun := Gaskiya.
		Fitarwa rubuta: ['\r\n'].
	}.
	Fitarwa rubuta: sakamako.
}.

Takardar-Yanar-Gizo idan: ['fitar:'] yi: { :sakamako
	kai fitar: sakamako nauʼi: ['text/html; charset=utf-8'].
}.

Takardar-Yanar-Gizo idan: ['kammala:'] yi: { :sakamako
	kai kammala: sakamako nauʼi: ['text/html; charset=utf-8'].
}.

Takardar-Yanar-Gizo idan: ['json:'] yi: { :sakamako
	kai fitar: ( JSON jsonify: sakamako ) nauʼi: ['application/json'].
}.

Takardar-Yanar-Gizo idan: ['ba-a-samu-ba:'] yi: { :sakamako
	kai share-kanun-saƙonni kanun-saƙo: (
		Kan-HTTP sabo maɓalli: ['Status'] ƙima: ['404 Not Found']
	).
	kai fitar: sakamako.
}.


# Interface

>> Zama := Abu sabo.

Zama idan: ['sabo'] yi: { <- kai sabo shirya domin: Babu.
}.

Zama idan: ['domin:'] yi: { :id
	nasa id := id.
}.

Zama idan: ['loda'] yi: {
	wannan-aiki kuskure: ['Not implemented.'].
}.

Zama idan: ['ajiye:'] yi: {
	wannan-aiki kuskure: ['Not implemented.'].
}.

Zama idan: ['lalata'] yi: {
	wannan-aiki kuskure: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Zaman-fayil-na-wucin-gadi := Zama sabo.

Zaman-fayil-na-wucin-gadi idan: ['shirya'] yi: {
	nasa farkon-hanya := ['/tmp/sess-'].
}.

Zaman-fayil-na-wucin-gadi idan: ['gaban-hanya:'] yi: { :jerin-haruffa
	nasa farkon-hanya := jerin-haruffa.
}.

Zaman-fayil-na-wucin-gadi idan: ['fayil-zama'] yi: { <- ( Fayil sabo: ( nasa farkon-hanya + nasa id + ['.txt'] ) ).
}.

Zaman-fayil-na-wucin-gadi idan: ['loda'] yi: {
	>> fayil-zama := kai fayil-zama.
	fayil-zama akwai ƙarya: {
		fayil-zama rubuta: (Ƙamus sabo lamba-tsari).
	}. <- fayil-zama karanta abu.
}.

Zaman-fayil-na-wucin-gadi idan: ['ajiye:'] yi: { :bayanai
	>> fayil-zama := kai fayil-zama.
	fayil-zama akwai gaskiya: {
		fayil-zama rubuta: bayanai lamba-tsari.
	}.
}.

Zaman-fayil-na-wucin-gadi idan: ['lalata'] yi: {
	>> fayil-zama := kai fayil-zama.
	fayil-zama akwai gaskiya: {
		fayil-zama goge.
	}.
}.


>> URL := Abu sabo.

URL idan: ['shirya'] yi: {
	nasa yarjejeniya := ['https://'].
	nasa mai-masauki := ['localhost'].
	nasa hanyar-fayil := [''].
	nasa sigogin-url := [''].
	nasa hash := [''].
}.

URL idan: ['sabo'] yi: { <- kai sabo shirya.
}.

URL idan: ['rubutu'] yi: { <- (
	nasa yarjejeniya +
	nasa mai-masauki +
	nasa hanyar-fayil +
	nasa sigogin-url +
	nasa hash ).
}.

URL idan: ['yarjejeniya:'] yi: { :yarjejeniya
	((Jeri sabo ; ['http'] ; ['https']) yana-da: yarjejeniya) gaskiya: {
		nasa yarjejeniya := yarjejeniya + ['://'].
	}, ƙarya: {
		wannan-aiki kuskure: ['Invalid protocol'].
	}.
}.

URL idan: ['mai-masauki:'] yi: { :mai-masauki
	#todo validate according to rfc
	nasa mai-masauki := mai-masauki.
}.

URL idan: ['hanyar-fayil:'] yi: { :hanyar-fayil
	nasa hanyar-fayil := ['/'] + hanyar-fayil url-ɓoye-lamba.
}.

URL idan: ['sigogin-url:'] yi: { :taswira
	>> sigogin-url := Jeri sabo.
	taswira kowane: { :maɓalli :ƙima
		sigogin-url ƙara-a-ƙarshe: maɓalli rubutu url-ɓoye-lamba + ['='] + ƙima rubutu url-ɓoye-lamba.
	}.
	nasa sigogin-url := ['?'] + ( sigogin-url haɗa: ['&'] ).
}.

URL idan: ['hash:'] yi: { :hash
	nasa hash := ['#'] + hash url-ɓoye-lamba.
}.

