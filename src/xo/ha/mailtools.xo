>> Imel := Abu sabo.

Imel idan: ['shirya'] yi: {
	nasa masu-karɓa := Jeri sabo.
	nasa cc := Jeri sabo.
	nasa bcc := Jeri sabo.
	nasa mai-aikawa := Babu.
	nasa sunan-mai-aikawa := Babu.
	nasa batu := Babu.
	nasa jiki := Babu.
}.

Imel idan: ['sabo'] yi: { <- kai sabo shirya.
}.

Imel idan: ['zuwa:'] yi: { :lissafawa
	nasa masu-karɓa := lissafawa.
}.
 
Imel idan: ['cc:'] yi: { :lissafawa
	nasa cc := lissafawa.
}.

Imel idan: ['bcc:'] yi: { :lissafawa
	nasa bcc := lissafawa.
}.

Imel idan: ['batu:'] yi: { :batu
	nasa batu := batu.
}.

Imel idan: ['mai-aikawa:suna:'] yi: { :mai-aikawa :suna
	nasa mai-aikawa := mai-aikawa.
	nasa sunan-mai-aikawa := suna.
}.

Imel idan: ['jiki:'] yi: { :jiki
	nasa jiki := jiki.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imel idan: ['kanun-saƙo:'] yi: { :layi <- layi musanya: ['\r'] da: [''], musanya: ['\n'] da: [''].
}.

Imel idan: ['aika'] yi: {
	>> f := Fayil tempwrite: kai samar.
	Shiri tsarin-aiki: ['sendmail -t < '] + f hanyar-fayil, sabon-layi.
}.

Imel idan: ['samar'] yi: {
	>> karya-layi := ['\r\n'].
	>> jerin-haruffa := [''].
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['From: '] + nasa sunan-mai-aikawa + [' <'] + ( nasa mai-aikawa ) + ['>']) + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['To: '] + ( nasa masu-karɓa haɗa: [','] )) + karya-layi.
	nasa cc ƙidaya gaskiya: {
		jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Cc: '] + ( nasa cc haɗa: [','] )) + karya-layi.
	}.
	nasa bcc ƙidaya gaskiya: {
		jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Bcc: '] + ( nasa bcc haɗa: [','] )) + karya-layi.
	}.
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Subject: '] + nasa batu) + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: nasa jiki.
	jerin-haruffa ƙara-a-ƙarshe: karya-layi. <- jerin-haruffa.
}.

>> Imel-HTML := Imel sabo.

Imel-HTML idan: ['shirya'] yi: {
	kai shirya.
	nasa haɗe-haɗe := Jeri sabo.
	nasa iyaka := Asusu token: 40.
}.

Imel-HTML idan: ['haɗa-fayil:'] yi: { :fayil-zama
	>> id := nasa haɗe-haɗe ƙidaya.
	>> blob := fayil-zama blob.
	nasa haɗe-haɗe ƙara-a-ƙarshe: (
		Ƙamus sabo
			fayil-zama: fayil-zama hanyar-fayil,
			mime: ['image/'] + (Server mimetype: fayil-zama hanyar-fayil),
			bayanai: blob base64-ɓoye-lamba
	).
	blob saki. <- ['cid:attachment'] + id.
}.

Imel-HTML idan: ['samar'] yi: {
	>> karya-layi := ['\r\n'].
	>> jerin-haruffa := [''].
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['From: '] + nasa sunan-mai-aikawa + [' <'] + ( nasa mai-aikawa ) + ['>']) + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['To: '] + ( nasa masu-karɓa haɗa: [','] )) + karya-layi.
	nasa cc ƙidaya gaskiya: {
		jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Cc: '] + ( nasa cc haɗa: [','] )) + karya-layi.
	}.
	nasa bcc ƙidaya gaskiya: {
		jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Bcc: '] + ( nasa bcc haɗa: [','] )) + karya-layi.
	}.
	jerin-haruffa ƙara-a-ƙarshe: (kai kanun-saƙo: ['Subject: '] + nasa batu) + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: ['MIME-Version: 1.0'] + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: ['Content-Type: multipart/related; boundary="'] + nasa iyaka + ['"; type=text/html'] + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: ['--'] + nasa iyaka + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: ['Content-Type: text/html; charset=UTF-8'] + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: ['Content-Transfer-Encoding: 7bit'] + karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: karya-layi.
	jerin-haruffa ƙara-a-ƙarshe: nasa jiki.
	jerin-haruffa ƙara-a-ƙarshe: karya-layi.
	nasa haɗe-haɗe kowane: { :id :bayani
		>> blob := bayani bayanai.
		jerin-haruffa ƙara-a-ƙarshe: ['--'] + nasa iyaka + karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: ['Content-Type: '] + bayani mime + karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: ['Content-Transfer-Encoding: base64'] + karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: ['Content-ID: <attachment'] + id + ['>'] + karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: ['Content-Disposition: inline; filename="'] + bayani fayil-zama + ['"'] + karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: karya-layi.
		>> mafi-yawa := 76.
		>> tsawon-rubutu := blob tsawo.
		>> gutsuttsura := (tsawon-rubutu / mafi-yawa) zagaye-sama.
		{ :i
			>> gutsure := blob kwafi daga: i * mafi-yawa tsawo: mafi-yawa.
			jerin-haruffa ƙara-a-ƙarshe: gutsure + karya-layi.
		} * gutsuttsura.
		jerin-haruffa ƙara-a-ƙarshe: karya-layi.
		jerin-haruffa ƙara-a-ƙarshe: karya-layi.
	}.
	jerin-haruffa ƙara-a-ƙarshe: ['--'] + nasa iyaka + ['--'] + karya-layi. <- jerin-haruffa.
}.
