
# ~ Simple template engine ~

>> Samfuri := Abu sabo.

Samfuri idan: ['sabo'] yi: { <- kai sabo abun-ciki: [''].
}.

Samfuri idan: ['abun-ciki:'] yi: { :abun-ciki
	nasa abun-ciki := abun-ciki. 
}.

Samfuri idan: ['sabo:'] yi: { :abun-ciki <- kai sabo abun-ciki: abun-ciki.
}.

Samfuri idan: ['yanke:'] yi: { :alama
	>> alamar-farko := (['<!-- cut:%id% -->'] %id%: alama).
	>> alamar-ƙarshe := (['<!-- /cut:%id% -->'] %id%: alama).
	>> sassa := nasa abun-ciki tsaga: alamar-farko.
	>> gaba := sassa na-farko.
	>> sassa2 := sassa na-ƙarshe tsaga: alamar-ƙarshe.
	>> bayanta := sassa2 na-ƙarshe.
	>> sashi := sassa2 na-farko.
	>> saura := gaba + bayanta.
	nasa abun-ciki := saura. <- Samfuri sabo: sashi.
	
}.

Samfuri idan: ['kwafi'] yi: { <- kai sabo: kai rubutu kwafi.
}.
	
Samfuri idan: ['liƙa:a:'] yi: { :ɗan-guntu :id
	>> alamar-liƙawa := (['<!-- paste:%id% -->'] %id%: id).
	nasa abun-ciki musanya: alamar-liƙawa da: ( ɗan-guntu rubutu + alamar-liƙawa ).
}.

Samfuri idan: ['saita:ƙima:'] yi: { :wuri :ƙima
	nasa abun-ciki musanya: ['<!-- slot:'] + wuri + [' -->'] da: ( Server html-ɓoye-lamba: ƙima ).
}.

Samfuri idan: ['saita:html:'] yi: { :wuri :html
	nasa abun-ciki musanya: ['<!-- slot:'] + wuri + [' -->'] da: html.
}.

Samfuri idan: ['amsa:da:'] yi: { :wuri :ƙima
	kai saita: (wuri daga: 0 tsawo: (wuri tsawo - 1)) ƙima: ƙima.
}.

Samfuri idan: ['nl2br'] yi: {
	nasa abun-ciki musanya: ['\n'] da: ['<br>'].
}.

Samfuri idan: ['gyara'] yi: {
	nasa abun-ciki :=
		Salo
		sabo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		dacewa: nasa abun-ciki
		yi: { <- ['']. }.
}.

Samfuri idan: ['gyara-yanke'] yi: {
	>> abubuwa := Jeri sabo.
	Salo
	sabo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	dacewa: nasa abun-ciki
	yi: { :_ :sashi
		abubuwa ƙara-a-ƙarshe: sashi ? 1.
	}.
	abubuwa kowane: { :_ :id
		nasa abun-ciki :=
			Salo sabo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			dacewa: nasa abun-ciki
			yi: { <- ['']. }.
	 }.
}.

Samfuri idan: ['gyara-sarari'] yi: {
	nasa abun-ciki :=
		Salo
		sabo: ['\\s*\\n'],
		dacewa: nasa abun-ciki
		yi: { <- ['\n']. }.
	nasa abun-ciki :=
		Salo
		sabo: ['\\n[\\s\\t]+'],
		dacewa: nasa abun-ciki
		yi: { <- ['\n']. }.
}.

Samfuri idan: ['gyara-duka'] yi: {
	kai gyara.
	kai gyara-yanke.
	kai gyara-sarari.
}.

Samfuri idan: ['rubutu'] yi: { <- nasa abun-ciki.
}.
