
# ~ Simple template engine ~

>> Modèle := Objet nouveau.

Modèle quand: ['nouveau'] faire: { <- soi nouveau contenu: [''].
}.

Modèle quand: ['contenu:'] faire: { :contenu
	propre contenu := contenu. 
}.

Modèle quand: ['nouveau:'] faire: { :contenu <- soi nouveau contenu: contenu.
}.

Modèle quand: ['couper:'] faire: { :marqueur
	>> marqueur-début := (['<!-- cut:%id% -->'] %id%: marqueur).
	>> marqueur-fin := (['<!-- /cut:%id% -->'] %id%: marqueur).
	>> parties := propre contenu diviser: marqueur-début.
	>> préfixe := parties premier.
	>> parties2 := parties dernier diviser: marqueur-fin.
	>> suffixe := parties2 dernier.
	>> partie := parties2 premier.
	>> reste := préfixe + suffixe.
	propre contenu := reste. <- Modèle nouveau: partie.
	
}.

Modèle quand: ['copier'] faire: { <- soi nouveau: soi texte copier.
}.
	
Modèle quand: ['coller:à:'] faire: { :extrait :id
	>> marqueur-collage := (['<!-- paste:%id% -->'] %id%: id).
	propre contenu remplacer: marqueur-collage par: ( extrait texte + marqueur-collage ).
}.

Modèle quand: ['donner:valeur:'] faire: { :emplacement :valeur
	propre contenu remplacer: ['<!-- slot:'] + emplacement + [' -->'] par: ( Server html-encoder: valeur ).
}.

Modèle quand: ['donner:html:'] faire: { :emplacement :html
	propre contenu remplacer: ['<!-- slot:'] + emplacement + [' -->'] par: html.
}.

Modèle quand: ['répondre:et:'] faire: { :emplacement :valeur
	soi donner: (emplacement de: 0 longueur: (emplacement longueur - 1)) valeur: valeur.
}.

Modèle quand: ['nl2br'] faire: {
	propre contenu remplacer: ['\n'] par: ['<br>'].
}.

Modèle quand: ['purger'] faire: {
	propre contenu :=
		Motif
		nouveau: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		correspondance: propre contenu
		faire: { <- ['']. }.
}.

Modèle quand: ['purger-coupes'] faire: {
	>> éléments := Liste nouveau.
	Motif
	nouveau: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	correspondance: propre contenu
	faire: { :_ :partie
		éléments ajouter: partie ? 1.
	}.
	éléments chaque: { :_ :id
		propre contenu :=
			Motif nouveau: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			correspondance: propre contenu
			faire: { <- ['']. }.
	 }.
}.

Modèle quand: ['purger-espaces'] faire: {
	propre contenu :=
		Motif
		nouveau: ['\\s*\\n'],
		correspondance: propre contenu
		faire: { <- ['\n']. }.
	propre contenu :=
		Motif
		nouveau: ['\\n[\\s\\t]+'],
		correspondance: propre contenu
		faire: { <- ['\n']. }.
}.

Modèle quand: ['tout-purger'] faire: {
	soi purger.
	soi purger-coupes.
	soi purger-espaces.
}.

Modèle quand: ['texte'] faire: { <- propre contenu.
}.
