Requête-HTTP quand: ['HTTP-en-tête:'] faire: { :clé <- Programme paramètre: clé.
}.

>> En-tête-HTTP := Objet nouveau.

En-tête-HTTP quand: ['nouveau'] faire: { <- soi nouveau initialiser.
}.

En-tête-HTTP quand: ['initialiser'] faire: {
	propre clé := Rien.
	propre valeur := Rien.
}.

En-tête-HTTP quand: ['clé:valeur:'] faire: { :clé :valeur
	propre clé := clé.
	propre valeur := valeur.
}.

En-tête-HTTP quand: ['clé'] faire: { <- propre clé.
}.

En-tête-HTTP quand: ['valeur'] faire: { <- propre valeur.
}.


En-tête-HTTP quand: ['texte'] faire: {
	>> ligne := propre clé + [': '] + propre valeur.
	ligne remplacer: ['\r'] par: [''], remplacer: ['\n'] par: ['']. <- ligne + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Document-Web := Objet nouveau.

Document-Web quand: ['nouveau'] faire: { <- soi nouveau initialiser.
}.

Document-Web quand: ['initialiser'] faire: {
	propre en-têtes := Liste nouveau.
	propre id-session := Rien.
	propre gestionnaire-session := Session-fichier-temporaire nouveau.
	propre données-session := Rien.
	propre sécurisé := Oui.
	propre même-site := ['Strict'].
	propre en-têtes-envoyés := Non.
	propre demande := Requête-HTTP nouveau.
}.

Document-Web quand: ['demande:'] faire: { :demande
	propre demande := demande.
}. 

Document-Web quand: ['cookie-session-sécurisé:'] faire: { :sécurisé
	soi vérifier-en-têtes.
	propre sécurisé := sécurisé.
}.

Document-Web quand: ['cookie-session-même-site:'] faire: { :valeur
	soi vérifier-en-têtes.
	>> options := Liste nouveau 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options possède: valeur, non: {
		cette-tâche erreur: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propre même-site := valeur.
}.

Document-Web quand: ['en-tête:'] faire: { :en-tête
	soi vérifier-en-têtes.
	propre en-têtes ajouter: en-tête.
}.

Document-Web quand: ['effacer-en-têtes'] faire: {
	soi vérifier-en-têtes.
	propre en-têtes := Liste nouveau.
}.

Document-Web quand: ['gestionnaire-session:'] faire: { :gestionnaire
	soi vérifier-en-têtes.
	propre gestionnaire-session := gestionnaire.
}.

Document-Web quand: ['gestionnaire-session'] faire: { <- propre gestionnaire-session.
}.

Document-Web quand: ['vérifier-en-têtes'] faire: {
	propre en-têtes-envoyés oui: {
		cette-tâche erreur: ['Headers already sent to client.'].
	}.
}.

Document-Web quand: ['démarrer-session'] faire: {
	soi vérifier-en-têtes.
	>> demande := propre demande.
	>> id-session := demande cookie: ['xsid'].
	id-session Rien? non: {
		(( Motif nouveau: ['^[A-Za-z0-9]+\\z'], correspondance: id-session ) = 0) oui: {
			id-session := Rien.
		}.
	}.
	id-session Rien? oui: {
		id-session := Coffre jeton: 30.
		>> en-tête-session := En-tête-HTTP nouveau
		clé: ['Set-Cookie'] valeur: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propre sécurisé soit: ['Secure'] soit: ['']),
		SSITE: (propre même-site),
		XSID: id-session
		).
		propre en-têtes ajouter: en-tête-session.
	}.
	propre données-session := propre gestionnaire-session pour: id-session, charger. <- propre données-session. # reference
}.

Document-Web quand: ['aller-à:'] faire: { :adresse
	soi vérifier-en-têtes.
	soi effacer-en-têtes.
	propre en-têtes
	ajouter: (
		En-tête-HTTP nouveau
		clé: ['Status'] valeur: ['303 See Other']
	),
	ajouter: (
		En-tête-HTTP nouveau
		clé: ['Location'] valeur: adresse
	).
	soi sortir: ['Redirect'].
}.

Document-Web quand: ['détruire-session'] faire: {
	soi vérifier-en-têtes.
	>> demande := propre demande.
	>> id-session := demande cookie: ['xsid'].
	id-session Rien? non: {
		>> en-tête-session := En-tête-HTTP nouveau.
		>> instant := Moment nouveau année: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		en-tête-session clé: ['Set-Cookie'] valeur: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: instant,
			SEC: (propre sécurisé soit: ['Secure'] soit: ['']),
			SSITE: (propre même-site),
			XSID: id-session
		).
		propre gestionnaire-session détruire.
		propre en-têtes ajouter: en-tête-session.
	}.
}.


Document-Web quand: ['modèle:'] faire: { :chemin <- Modèle nouveau: (Fichier nouveau: chemin, lire).
}.

Document-Web quand: ['sortir:type:'] faire: { :sortie :type
	propre en-têtes-envoyés non: {
		propre données-session Rien? non: {
			propre gestionnaire-session enregistrer: propre données-session.
		}.
		propre en-têtes ajouter: (
			En-tête-HTTP nouveau
			clé: ['Content-type'] valeur: type
		).
		propre en-têtes chaque: { :_ :en-tête
			Sortie écrire: en-tête.
		}.
		propre en-têtes-envoyés := Oui.
		Sortie écrire: ['\r\n'].
	}.
	Sortie écrire: sortie.
}.

Document-Web quand: ['terminer:type:'] faire: { :sortie :type
	propre en-têtes-envoyés non: {
		propre données-session Rien? non: {
			propre gestionnaire-session enregistrer: propre données-session.
		}.
		propre en-têtes ajouter: (
			En-tête-HTTP nouveau
			clé: ['Content-type'] valeur: type
		).
		propre en-têtes ajouter: (
			En-tête-HTTP nouveau
			clé: ['Content-Length'] valeur: sortie texte bytes
		).
		propre en-têtes chaque: { :_ :en-tête
			Sortie écrire: en-tête.
		}.
		propre en-têtes-envoyés := Oui.
		Sortie écrire: ['\r\n'].
	}.
	Sortie écrire: sortie.
}.

Document-Web quand: ['sortir:'] faire: { :sortie
	soi sortir: sortie type: ['text/html; charset=utf-8'].
}.

Document-Web quand: ['terminer:'] faire: { :sortie
	soi terminer: sortie type: ['text/html; charset=utf-8'].
}.

Document-Web quand: ['json:'] faire: { :sortie
	soi sortir: ( JSON jsonify: sortie ) type: ['application/json'].
}.

Document-Web quand: ['introuvable:'] faire: { :sortie
	soi effacer-en-têtes en-tête: (
		En-tête-HTTP nouveau clé: ['Status'] valeur: ['404 Not Found']
	).
	soi sortir: sortie.
}.


# Interface

>> Session := Objet nouveau.

Session quand: ['nouveau'] faire: { <- soi nouveau initialiser pour: Rien.
}.

Session quand: ['pour:'] faire: { :id
	propre id := id.
}.

Session quand: ['charger'] faire: {
	cette-tâche erreur: ['Not implemented.'].
}.

Session quand: ['enregistrer:'] faire: {
	cette-tâche erreur: ['Not implemented.'].
}.

Session quand: ['détruire'] faire: {
	cette-tâche erreur: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Session-fichier-temporaire := Session nouveau.

Session-fichier-temporaire quand: ['initialiser'] faire: {
	propre préfixechemin := ['/tmp/sess-'].
}.

Session-fichier-temporaire quand: ['préfixe-chemin:'] faire: { :chaîne
	propre préfixechemin := chaîne.
}.

Session-fichier-temporaire quand: ['fichier'] faire: { <- ( Fichier nouveau: ( propre préfixechemin + propre id + ['.txt'] ) ).
}.

Session-fichier-temporaire quand: ['charger'] faire: {
	>> fichier := soi fichier.
	fichier existe non: {
		fichier écrire: (Dictionnaire nouveau code).
	}. <- fichier lire objet.
}.

Session-fichier-temporaire quand: ['enregistrer:'] faire: { :données
	>> fichier := soi fichier.
	fichier existe oui: {
		fichier écrire: données code.
	}.
}.

Session-fichier-temporaire quand: ['détruire'] faire: {
	>> fichier := soi fichier.
	fichier existe oui: {
		fichier supprimer.
	}.
}.


>> URL := Objet nouveau.

URL quand: ['initialiser'] faire: {
	propre protocole := ['https://'].
	propre hôte := ['localhost'].
	propre chemin := [''].
	propre paramètres-url := [''].
	propre hash := [''].
}.

URL quand: ['nouveau'] faire: { <- soi nouveau initialiser.
}.

URL quand: ['texte'] faire: { <- (
	propre protocole +
	propre hôte +
	propre chemin +
	propre paramètres-url +
	propre hash ).
}.

URL quand: ['protocole:'] faire: { :protocole
	((Liste nouveau ; ['http'] ; ['https']) possède: protocole) oui: {
		propre protocole := protocole + ['://'].
	}, non: {
		cette-tâche erreur: ['Invalid protocol'].
	}.
}.

URL quand: ['hôte:'] faire: { :hôte
	#todo validate according to rfc
	propre hôte := hôte.
}.

URL quand: ['chemin:'] faire: { :chemin
	propre chemin := ['/'] + chemin url-encoder.
}.

URL quand: ['paramètres-url:'] faire: { :correspondance
	>> paramètres-url := Liste nouveau.
	correspondance chaque: { :clé :valeur
		paramètres-url ajouter: clé texte url-encoder + ['='] + valeur texte url-encoder.
	}.
	propre paramètres-url := ['?'] + ( paramètres-url joindre: ['&'] ).
}.

URL quand: ['hachage:'] faire: { :hash
	propre hash := ['#'] + hash url-encoder.
}.

