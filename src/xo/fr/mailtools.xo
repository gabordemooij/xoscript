>> E-mail := Objet nouveau.

E-mail quand: ['initialiser'] faire: {
	propre destinataires := Liste nouveau.
	propre cc := Liste nouveau.
	propre bcc := Liste nouveau.
	propre expéditeur := Rien.
	propre nom-expéditeur := Rien.
	propre sujet := Rien.
	propre corps := Rien.
}.

E-mail quand: ['nouveau'] faire: { <- soi nouveau initialiser.
}.

E-mail quand: ['destinataire:'] faire: { :énumération
	propre destinataires := énumération.
}.
 
E-mail quand: ['cc:'] faire: { :énumération
	propre cc := énumération.
}.

E-mail quand: ['bcc:'] faire: { :énumération
	propre bcc := énumération.
}.

E-mail quand: ['sujet:'] faire: { :sujet
	propre sujet := sujet.
}.

E-mail quand: ['expéditeur:nom:'] faire: { :expéditeur :nom
	propre expéditeur := expéditeur.
	propre nom-expéditeur := nom.
}.

E-mail quand: ['corps:'] faire: { :corps
	propre corps := corps.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-mail quand: ['en-tête:'] faire: { :ligne <- ligne remplacer: ['\r'] par: [''], remplacer: ['\n'] par: [''].
}.

E-mail quand: ['envoyer'] faire: {
	>> f := Fichier tempwrite: soi générer.
	Programme système: ['sendmail -t < '] + f chemin, stop.
}.

E-mail quand: ['générer'] faire: {
	>> saut := ['\r\n'].
	>> chaîne := [''].
	chaîne ajouter: (soi en-tête: ['From: '] + propre nom-expéditeur + [' <'] + ( propre expéditeur ) + ['>']) + saut.
	chaîne ajouter: (soi en-tête: ['To: '] + ( propre destinataires joindre: [','] )) + saut.
	propre cc compter oui: {
		chaîne ajouter: (soi en-tête: ['Cc: '] + ( propre cc joindre: [','] )) + saut.
	}.
	propre bcc compter oui: {
		chaîne ajouter: (soi en-tête: ['Bcc: '] + ( propre bcc joindre: [','] )) + saut.
	}.
	chaîne ajouter: (soi en-tête: ['Subject: '] + propre sujet) + saut.
	chaîne ajouter: saut.
	chaîne ajouter: propre corps.
	chaîne ajouter: saut. <- chaîne.
}.

>> E-mail-HTML := E-mail nouveau.

E-mail-HTML quand: ['initialiser'] faire: {
	soi initialiser.
	propre pièces-jointes := Liste nouveau.
	propre frontière := Coffre jeton: 40.
}.

E-mail-HTML quand: ['attacher:'] faire: { :fichier
	>> id := propre pièces-jointes compter.
	>> blob := fichier blob.
	propre pièces-jointes ajouter: (
		Dictionnaire nouveau
			fichier: fichier chemin,
			mime: ['image/'] + (Server mimetype: fichier chemin),
			données: blob base64-encoder
	).
	blob libérer. <- ['cid:attachment'] + id.
}.

E-mail-HTML quand: ['générer'] faire: {
	>> saut := ['\r\n'].
	>> chaîne := [''].
	chaîne ajouter: (soi en-tête: ['From: '] + propre nom-expéditeur + [' <'] + ( propre expéditeur ) + ['>']) + saut.
	chaîne ajouter: (soi en-tête: ['To: '] + ( propre destinataires joindre: [','] )) + saut.
	propre cc compter oui: {
		chaîne ajouter: (soi en-tête: ['Cc: '] + ( propre cc joindre: [','] )) + saut.
	}.
	propre bcc compter oui: {
		chaîne ajouter: (soi en-tête: ['Bcc: '] + ( propre bcc joindre: [','] )) + saut.
	}.
	chaîne ajouter: (soi en-tête: ['Subject: '] + propre sujet) + saut.
	chaîne ajouter: ['MIME-Version: 1.0'] + saut.
	chaîne ajouter: ['Content-Type: multipart/related; boundary="'] + propre frontière + ['"; type=text/html'] + saut.
	chaîne ajouter: saut.
	chaîne ajouter: ['--'] + propre frontière + saut.
	chaîne ajouter: ['Content-Type: text/html; charset=UTF-8'] + saut.
	chaîne ajouter: ['Content-Transfer-Encoding: 7bit'] + saut.
	chaîne ajouter: saut.
	chaîne ajouter: propre corps.
	chaîne ajouter: saut.
	propre pièces-jointes chaque: { :id :info
		>> blob := info données.
		chaîne ajouter: ['--'] + propre frontière + saut.
		chaîne ajouter: ['Content-Type: '] + info mime + saut.
		chaîne ajouter: ['Content-Transfer-Encoding: base64'] + saut.
		chaîne ajouter: ['Content-ID: <attachment'] + id + ['>'] + saut.
		chaîne ajouter: ['Content-Disposition: inline; filename="'] + info fichier + ['"'] + saut.
		chaîne ajouter: saut.
		>> limite-haute := 76.
		>> longueur-texte := blob longueur.
		>> morceaux := (longueur-texte / limite-haute) plafond.
		{ :i
			>> morceau := blob copier de: i * limite-haute longueur: limite-haute.
			chaîne ajouter: morceau + saut.
		} * morceaux.
		chaîne ajouter: saut.
		chaîne ajouter: saut.
	}.
	chaîne ajouter: ['--'] + propre frontière + ['--'] + saut. <- chaîne.
}.
