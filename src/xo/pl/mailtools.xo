>> Email := Obiekt nowy.

Email na: ['init'] wykonaj: {
	własny recipients := Lista nowy.
	własny cc := Lista nowy.
	własny bcc := Lista nowy.
	własny from := Nic.
	własny from-name := Nic.
	własny subject := Nic.
	własny body := Nic.
}.

Email na: ['nowy'] wykonaj: { <- sam nowy init.
}.

Email na: ['to:'] wykonaj: { :list
	własny recipients := list.
}.
 
Email na: ['cc:'] wykonaj: { :list
	własny cc := list.
}.

Email na: ['bcc:'] wykonaj: { :list
	własny bcc := list.
}.

Email na: ['subject:'] wykonaj: { :subject
	własny subject := subject.
}.

Email na: ['from:name:'] wykonaj: { :from :nazwa
	własny from := from.
	własny from-name := nazwa.
}.

Email na: ['body:'] wykonaj: { :body
	własny body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email na: ['header:'] wykonaj: { :line <- line zamień: ['\r'] na: [''], zamień: ['\n'] na: [''].
}.

Email na: ['send'] wykonaj: {
	>> f := Plik tempwrite: sam generate.
	Program system: ['sendmail -t < '] + f ścieżka, nowa-linia.
}.

Email na: ['generate'] wykonaj: {
	>> brk := ['\r\n'].
	>> str := [''].
	str dołącz: (sam header: ['From: '] + własny from-name + [' <'] + ( własny from ) + ['>']) + brk.
	str dołącz: (sam header: ['To: '] + ( własny recipients połącz: [','] )) + brk.
	własny cc liczność prawda: {
		str dołącz: (sam header: ['Cc: '] + ( własny cc połącz: [','] )) + brk.
	}.
	własny bcc liczność prawda: {
		str dołącz: (sam header: ['Bcc: '] + ( własny bcc połącz: [','] )) + brk.
	}.
	str dołącz: (sam header: ['Subject: '] + własny subject) + brk.
	str dołącz: brk.
	str dołącz: własny body.
	str dołącz: brk. <- str.
}.

>> HTML-Email := Email nowy.

HTML-Email na: ['init'] wykonaj: {
	sam init.
	własny attachments := Lista nowy.
	własny boundary := Sejf token: 40.
}.

HTML-Email na: ['attach:'] wykonaj: { :file
	>> id := własny attachments liczność.
	>> blob := file blob.
	własny attachments dołącz: (
		Słownik nowy
			file: file ścieżka,
			mime: ['image/'] + (Server mimetype: file ścieżka),
			data: blob base64-koduj
	).
	blob zwolnij. <- ['cid:attachment'] + id.
}.

HTML-Email na: ['generate'] wykonaj: {
	>> brk := ['\r\n'].
	>> str := [''].
	str dołącz: (sam header: ['From: '] + własny from-name + [' <'] + ( własny from ) + ['>']) + brk.
	str dołącz: (sam header: ['To: '] + ( własny recipients połącz: [','] )) + brk.
	własny cc liczność prawda: {
		str dołącz: (sam header: ['Cc: '] + ( własny cc połącz: [','] )) + brk.
	}.
	własny bcc liczność prawda: {
		str dołącz: (sam header: ['Bcc: '] + ( własny bcc połącz: [','] )) + brk.
	}.
	str dołącz: (sam header: ['Subject: '] + własny subject) + brk.
	str dołącz: ['MIME-Version: 1.0'] + brk.
	str dołącz: ['Content-Type: multipart/related; boundary="'] + własny boundary + ['"; type=text/html'] + brk.
	str dołącz: brk.
	str dołącz: ['--'] + własny boundary + brk.
	str dołącz: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str dołącz: ['Content-Transfer-Encoding: 7bit'] + brk.
	str dołącz: brk.
	str dołącz: własny body.
	str dołącz: brk.
	własny attachments każdy: { :id :info
		>> blob := info data.
		str dołącz: ['--'] + własny boundary + brk.
		str dołącz: ['Content-Type: '] + info mime + brk.
		str dołącz: ['Content-Transfer-Encoding: base64'] + brk.
		str dołącz: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str dołącz: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str dołącz: brk.
		>> max := 76.
		>> len := blob długość.
		>> chunks := (len / max) sufit.
		{ :i
			>> chunk := blob kopiuj od: i * max długość: max.
			str dołącz: chunk + brk.
		} * chunks.
		str dołącz: brk.
		str dołącz: brk.
	}.
	str dołącz: ['--'] + własny boundary + ['--'] + brk. <- str.
}.
