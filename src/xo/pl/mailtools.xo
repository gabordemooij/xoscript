>> Email := Obiekt nowy.

Email na: ['inicjuj'] wykonaj: {
	własny odbiorcy := Lista nowy.
	własny cc := Lista nowy.
	własny bcc := Lista nowy.
	własny nadawca := Nic.
	własny nazwa-nadawcy := Nic.
	własny temat := Nic.
	własny treść-wiadomości := Nic.
}.

Email na: ['nowy'] wykonaj: { <- sam nowy inicjuj.
}.

Email na: ['adresat:'] wykonaj: { :wyliczenie
	własny odbiorcy := wyliczenie.
}.
 
Email na: ['cc:'] wykonaj: { :wyliczenie
	własny cc := wyliczenie.
}.

Email na: ['bcc:'] wykonaj: { :wyliczenie
	własny bcc := wyliczenie.
}.

Email na: ['temat:'] wykonaj: { :temat
	własny temat := temat.
}.

Email na: ['nadawca:nazwa:'] wykonaj: { :nadawca :nazwa
	własny nadawca := nadawca.
	własny nazwa-nadawcy := nazwa.
}.

Email na: ['treść-wiadomości:'] wykonaj: { :treść-wiadomości
	własny treść-wiadomości := treść-wiadomości.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email na: ['nagłówek:'] wykonaj: { :wiersz <- wiersz zamień: ['\r'] na: [''], zamień: ['\n'] na: [''].
}.

Email na: ['wyślij'] wykonaj: {
	>> f := Plik tempwrite: sam generuj.
	Program system: ['sendmail -t < '] + f ścieżka, nowa-linia.
}.

Email na: ['generuj'] wykonaj: {
	>> łamanie := ['\r\n'].
	>> łańcuch := [''].
	łańcuch dołącz: (sam nagłówek: ['From: '] + własny nazwa-nadawcy + [' <'] + ( własny nadawca ) + ['>']) + łamanie.
	łańcuch dołącz: (sam nagłówek: ['To: '] + ( własny odbiorcy połącz: [','] )) + łamanie.
	własny cc liczność prawda: {
		łańcuch dołącz: (sam nagłówek: ['Cc: '] + ( własny cc połącz: [','] )) + łamanie.
	}.
	własny bcc liczność prawda: {
		łańcuch dołącz: (sam nagłówek: ['Bcc: '] + ( własny bcc połącz: [','] )) + łamanie.
	}.
	łańcuch dołącz: (sam nagłówek: ['Subject: '] + własny temat) + łamanie.
	łańcuch dołącz: łamanie.
	łańcuch dołącz: własny treść-wiadomości.
	łańcuch dołącz: łamanie. <- łańcuch.
}.

>> HTML-Email := Email nowy.

HTML-Email na: ['inicjuj'] wykonaj: {
	sam inicjuj.
	własny załączniki := Lista nowy.
	własny granica := Sejf token: 40.
}.

HTML-Email na: ['załącz:'] wykonaj: { :plik
	>> id := własny załączniki liczność.
	>> blob := plik blob.
	własny załączniki dołącz: (
		Słownik nowy
			plik: plik ścieżka,
			mime: ['image/'] + (Server mimetype: plik ścieżka),
			dane: blob base64-koduj
	).
	blob zwolnij. <- ['cid:attachment'] + id.
}.

HTML-Email na: ['generuj'] wykonaj: {
	>> łamanie := ['\r\n'].
	>> łańcuch := [''].
	łańcuch dołącz: (sam nagłówek: ['From: '] + własny nazwa-nadawcy + [' <'] + ( własny nadawca ) + ['>']) + łamanie.
	łańcuch dołącz: (sam nagłówek: ['To: '] + ( własny odbiorcy połącz: [','] )) + łamanie.
	własny cc liczność prawda: {
		łańcuch dołącz: (sam nagłówek: ['Cc: '] + ( własny cc połącz: [','] )) + łamanie.
	}.
	własny bcc liczność prawda: {
		łańcuch dołącz: (sam nagłówek: ['Bcc: '] + ( własny bcc połącz: [','] )) + łamanie.
	}.
	łańcuch dołącz: (sam nagłówek: ['Subject: '] + własny temat) + łamanie.
	łańcuch dołącz: ['MIME-Version: 1.0'] + łamanie.
	łańcuch dołącz: ['Content-Type: multipart/related; boundary="'] + własny granica + ['"; type=text/html'] + łamanie.
	łańcuch dołącz: łamanie.
	łańcuch dołącz: ['--'] + własny granica + łamanie.
	łańcuch dołącz: ['Content-Type: text/html; charset=UTF-8'] + łamanie.
	łańcuch dołącz: ['Content-Transfer-Encoding: 7bit'] + łamanie.
	łańcuch dołącz: łamanie.
	łańcuch dołącz: własny treść-wiadomości.
	łańcuch dołącz: łamanie.
	własny załączniki każdy: { :id :info
		>> blob := info dane.
		łańcuch dołącz: ['--'] + własny granica + łamanie.
		łańcuch dołącz: ['Content-Type: '] + info mime + łamanie.
		łańcuch dołącz: ['Content-Transfer-Encoding: base64'] + łamanie.
		łańcuch dołącz: ['Content-ID: <attachment'] + id + ['>'] + łamanie.
		łańcuch dołącz: ['Content-Disposition: inline; filename="'] + info plik + ['"'] + łamanie.
		łańcuch dołącz: łamanie.
		>> najwyżej := 76.
		>> długość-tekstu := blob długość.
		>> kawałki := (długość-tekstu / najwyżej) sufit.
		{ :i
			>> kawałek := blob kopiuj od: i * najwyżej długość: najwyżej.
			łańcuch dołącz: kawałek + łamanie.
		} * kawałki.
		łańcuch dołącz: łamanie.
		łańcuch dołącz: łamanie.
	}.
	łańcuch dołącz: ['--'] + własny granica + ['--'] + łamanie. <- łańcuch.
}.
