
# ~ Simple template engine ~

>> Szablon := Obiekt nowy.

Szablon na: ['nowy'] wykonaj: { <- sam nowy treść: [''].
}.

Szablon na: ['treść:'] wykonaj: { :treść
	własny treść := treść. 
}.

Szablon na: ['nowy:'] wykonaj: { :treść <- sam nowy treść: treść.
}.

Szablon na: ['wytnij:'] wykonaj: { :znacznik
	>> znacznik-początku := (['<!-- cut:%id% -->'] %id%: znacznik).
	>> znacznik-końca := (['<!-- /cut:%id% -->'] %id%: znacznik).
	>> części := własny treść podziel: znacznik-początku.
	>> prefiks := części pierwszy.
	>> części2 := części ostatni podziel: znacznik-końca.
	>> sufiks := części2 ostatni.
	>> część := części2 pierwszy.
	>> reszta := prefiks + sufiks.
	własny treść := reszta. <- Szablon nowy: część.
	
}.

Szablon na: ['kopiuj'] wykonaj: { <- sam nowy: sam tekst kopiuj.
}.
	
Szablon na: ['wklej:w:'] wykonaj: { :wycinek-html :id
	>> znacznik-wklejenia := (['<!-- paste:%id% -->'] %id%: id).
	własny treść zamień: znacznik-wklejenia na: ( wycinek-html tekst + znacznik-wklejenia ).
}.

Szablon na: ['ustaw:wartość:'] wykonaj: { :miejsce :wartość
	własny treść zamień: ['<!-- slot:'] + miejsce + [' -->'] na: ( Server html-koduj: wartość ).
}.

Szablon na: ['ustaw:html:'] wykonaj: { :miejsce :html
	własny treść zamień: ['<!-- slot:'] + miejsce + [' -->'] na: html.
}.

Szablon na: ['odpowiedz:i:'] wykonaj: { :miejsce :wartość
	sam ustaw: (miejsce od: 0 długość: (miejsce długość - 1)) wartość: wartość.
}.

Szablon na: ['nl2br'] wykonaj: {
	własny treść zamień: ['\n'] na: ['<br>'].
}.

Szablon na: ['uporządkuj'] wykonaj: {
	własny treść :=
		Wzorzec
		nowy: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		dopasuj: własny treść
		wykonaj: { <- ['']. }.
}.

Szablon na: ['uporządkuj-wycinki'] wykonaj: {
	>> elementy := Lista nowy.
	Wzorzec
	nowy: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	dopasuj: własny treść
	wykonaj: { :_ :część
		elementy dołącz: część ? 1.
	}.
	elementy każdy: { :_ :id
		własny treść :=
			Wzorzec nowy: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			dopasuj: własny treść
			wykonaj: { <- ['']. }.
	 }.
}.

Szablon na: ['uporządkuj-spacje'] wykonaj: {
	własny treść :=
		Wzorzec
		nowy: ['\\s*\\n'],
		dopasuj: własny treść
		wykonaj: { <- ['\n']. }.
	własny treść :=
		Wzorzec
		nowy: ['\\n[\\s\\t]+'],
		dopasuj: własny treść
		wykonaj: { <- ['\n']. }.
}.

Szablon na: ['uporządkuj-wszystko'] wykonaj: {
	sam uporządkuj.
	sam uporządkuj-wycinki.
	sam uporządkuj-spacje.
}.

Szablon na: ['tekst'] wykonaj: { <- własny treść.
}.
