Żądanie-HTTP na: ['HTTP-nagłówek:'] wykonaj: { :klucz <- Program ustawienie: klucz.
}.

>> Nagłówek-HTTP := Obiekt nowy.

Nagłówek-HTTP na: ['nowy'] wykonaj: { <- sam nowy inicjuj.
}.

Nagłówek-HTTP na: ['inicjuj'] wykonaj: {
	własny klucz := Nic.
	własny wartość := Nic.
}.

Nagłówek-HTTP na: ['klucz:wartość:'] wykonaj: { :klucz :wartość
	własny klucz := klucz.
	własny wartość := wartość.
}.

Nagłówek-HTTP na: ['klucz'] wykonaj: { <- własny klucz.
}.

Nagłówek-HTTP na: ['wartość'] wykonaj: { <- własny wartość.
}.


Nagłówek-HTTP na: ['tekst'] wykonaj: {
	>> wiersz := własny klucz + [': '] + własny wartość.
	wiersz zamień: ['\r'] na: [''], zamień: ['\n'] na: ['']. <- wiersz + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokument-Web := Obiekt nowy.

Dokument-Web na: ['nowy'] wykonaj: { <- sam nowy inicjuj.
}.

Dokument-Web na: ['inicjuj'] wykonaj: {
	własny nagłówki := Lista nowy.
	własny id-sesji := Nic.
	własny menedżer-sesji := Sesja-plik-tymczasowy nowy.
	własny dane-sesji := Nic.
	własny bezpieczne := Prawda.
	własny ta-sama-witryna := ['Strict'].
	własny nagłówki-wysłane := Fałsz.
	własny żądanie := Żądanie-HTTP nowy.
}.

Dokument-Web na: ['żądanie:'] wykonaj: { :żądanie
	własny żądanie := żądanie.
}. 

Dokument-Web na: ['bezpieczne-ciasteczko-sesji:'] wykonaj: { :bezpieczne
	sam sprawdź-nagłówki.
	własny bezpieczne := bezpieczne.
}.

Dokument-Web na: ['ciasteczko-sesji-ta-sama-witryna:'] wykonaj: { :wartość
	sam sprawdź-nagłówki.
	>> opcje := Lista nowy 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcje ma: wartość, fałsz: {
		to-zadanie błąd: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	własny ta-sama-witryna := wartość.
}.

Dokument-Web na: ['nagłówek:'] wykonaj: { :nagłówek
	sam sprawdź-nagłówki.
	własny nagłówki dołącz: nagłówek.
}.

Dokument-Web na: ['usuń-nagłówki'] wykonaj: {
	sam sprawdź-nagłówki.
	własny nagłówki := Lista nowy.
}.

Dokument-Web na: ['menedżer-sesji:'] wykonaj: { :menedżer
	sam sprawdź-nagłówki.
	własny menedżer-sesji := menedżer.
}.

Dokument-Web na: ['menedżer-sesji'] wykonaj: { <- własny menedżer-sesji.
}.

Dokument-Web na: ['sprawdź-nagłówki'] wykonaj: {
	własny nagłówki-wysłane prawda: {
		to-zadanie błąd: ['Headers already sent to client.'].
	}.
}.

Dokument-Web na: ['rozpocznij-sesję'] wykonaj: {
	sam sprawdź-nagłówki.
	>> żądanie := własny żądanie.
	>> id-sesji := żądanie cookie: ['xsid'].
	id-sesji Nic? fałsz: {
		(( Wzorzec nowy: ['^[A-Za-z0-9]+\\z'], dopasuj: id-sesji ) = 0) prawda: {
			id-sesji := Nic.
		}.
	}.
	id-sesji Nic? prawda: {
		id-sesji := Sejf token: 30.
		>> nagłówek-sesji := Nagłówek-HTTP nowy
		klucz: ['Set-Cookie'] wartość: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (własny bezpieczne albo: ['Secure'] albo: ['']),
		SSITE: (własny ta-sama-witryna),
		XSID: id-sesji
		).
		własny nagłówki dołącz: nagłówek-sesji.
	}.
	własny dane-sesji := własny menedżer-sesji dla: id-sesji, wczytaj. <- własny dane-sesji. # reference
}.

Dokument-Web na: ['przejdź-do:'] wykonaj: { :adres
	sam sprawdź-nagłówki.
	sam usuń-nagłówki.
	własny nagłówki
	dołącz: (
		Nagłówek-HTTP nowy
		klucz: ['Status'] wartość: ['303 See Other']
	),
	dołącz: (
		Nagłówek-HTTP nowy
		klucz: ['Location'] wartość: adres
	).
	sam wypisz: ['Redirect'].
}.

Dokument-Web na: ['zniszcz-sesję'] wykonaj: {
	sam sprawdź-nagłówki.
	>> żądanie := własny żądanie.
	>> id-sesji := żądanie cookie: ['xsid'].
	id-sesji Nic? fałsz: {
		>> nagłówek-sesji := Nagłówek-HTTP nowy.
		>> chwila := Moment nowy rok: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		nagłówek-sesji klucz: ['Set-Cookie'] wartość: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: chwila,
			SEC: (własny bezpieczne albo: ['Secure'] albo: ['']),
			SSITE: (własny ta-sama-witryna),
			XSID: id-sesji
		).
		własny menedżer-sesji zniszcz.
		własny nagłówki dołącz: nagłówek-sesji.
	}.
}.


Dokument-Web na: ['szablon:'] wykonaj: { :ścieżka <- Szablon nowy: (Plik nowy: ścieżka, czytaj).
}.

Dokument-Web na: ['wypisz:typ:'] wykonaj: { :wyjście :typ
	własny nagłówki-wysłane fałsz: {
		własny dane-sesji Nic? fałsz: {
			własny menedżer-sesji zapisz: własny dane-sesji.
		}.
		własny nagłówki dołącz: (
			Nagłówek-HTTP nowy
			klucz: ['Content-type'] wartość: typ
		).
		własny nagłówki każdy: { :_ :nagłówek
			Wyjście pisz: nagłówek.
		}.
		własny nagłówki-wysłane := Prawda.
		Wyjście pisz: ['\r\n'].
	}.
	Wyjście pisz: wyjście.
}.

Dokument-Web na: ['zakończ:typ:'] wykonaj: { :wyjście :typ
	własny nagłówki-wysłane fałsz: {
		własny dane-sesji Nic? fałsz: {
			własny menedżer-sesji zapisz: własny dane-sesji.
		}.
		własny nagłówki dołącz: (
			Nagłówek-HTTP nowy
			klucz: ['Content-type'] wartość: typ
		).
		własny nagłówki dołącz: (
			Nagłówek-HTTP nowy
			klucz: ['Content-Length'] wartość: wyjście tekst bytes
		).
		własny nagłówki każdy: { :_ :nagłówek
			Wyjście pisz: nagłówek.
		}.
		własny nagłówki-wysłane := Prawda.
		Wyjście pisz: ['\r\n'].
	}.
	Wyjście pisz: wyjście.
}.

Dokument-Web na: ['wypisz:'] wykonaj: { :wyjście
	sam wypisz: wyjście typ: ['text/html; charset=utf-8'].
}.

Dokument-Web na: ['zakończ:'] wykonaj: { :wyjście
	sam zakończ: wyjście typ: ['text/html; charset=utf-8'].
}.

Dokument-Web na: ['json:'] wykonaj: { :wyjście
	sam wypisz: ( JSON jsonify: wyjście ) typ: ['application/json'].
}.

Dokument-Web na: ['nie-znaleziono:'] wykonaj: { :wyjście
	sam usuń-nagłówki nagłówek: (
		Nagłówek-HTTP nowy klucz: ['Status'] wartość: ['404 Not Found']
	).
	sam wypisz: wyjście.
}.


# Interface

>> Sesja := Obiekt nowy.

Sesja na: ['nowy'] wykonaj: { <- sam nowy inicjuj dla: Nic.
}.

Sesja na: ['dla:'] wykonaj: { :id
	własny id := id.
}.

Sesja na: ['wczytaj'] wykonaj: {
	to-zadanie błąd: ['Not implemented.'].
}.

Sesja na: ['zapisz:'] wykonaj: {
	to-zadanie błąd: ['Not implemented.'].
}.

Sesja na: ['zniszcz'] wykonaj: {
	to-zadanie błąd: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesja-plik-tymczasowy := Sesja nowy.

Sesja-plik-tymczasowy na: ['inicjuj'] wykonaj: {
	własny początek-ścieżki := ['/tmp/sess-'].
}.

Sesja-plik-tymczasowy na: ['prefiks-ścieżki:'] wykonaj: { :łańcuch
	własny początek-ścieżki := łańcuch.
}.

Sesja-plik-tymczasowy na: ['plik'] wykonaj: { <- ( Plik nowy: ( własny początek-ścieżki + własny id + ['.txt'] ) ).
}.

Sesja-plik-tymczasowy na: ['wczytaj'] wykonaj: {
	>> plik := sam plik.
	plik istnieje fałsz: {
		plik pisz: (Słownik nowy code).
	}. <- plik czytaj obiekt.
}.

Sesja-plik-tymczasowy na: ['zapisz:'] wykonaj: { :dane
	>> plik := sam plik.
	plik istnieje prawda: {
		plik pisz: dane code.
	}.
}.

Sesja-plik-tymczasowy na: ['zniszcz'] wykonaj: {
	>> plik := sam plik.
	plik istnieje prawda: {
		plik usuń.
	}.
}.


>> URL := Obiekt nowy.

URL na: ['inicjuj'] wykonaj: {
	własny protokół := ['https://'].
	własny host := ['localhost'].
	własny ścieżka := [''].
	własny parametry-url := [''].
	własny hash := [''].
}.

URL na: ['nowy'] wykonaj: { <- sam nowy inicjuj.
}.

URL na: ['tekst'] wykonaj: { <- (
	własny protokół +
	własny host +
	własny ścieżka +
	własny parametry-url +
	własny hash ).
}.

URL na: ['protokół:'] wykonaj: { :protokół
	((Lista nowy ; ['http'] ; ['https']) ma: protokół) prawda: {
		własny protokół := protokół + ['://'].
	}, fałsz: {
		to-zadanie błąd: ['Invalid protocol'].
	}.
}.

URL na: ['host:'] wykonaj: { :host
	#todo validate according to rfc
	własny host := host.
}.

URL na: ['ścieżka:'] wykonaj: { :ścieżka
	własny ścieżka := ['/'] + ścieżka url-koduj.
}.

URL na: ['parametry-url:'] wykonaj: { :mapowanie
	>> parametry-url := Lista nowy.
	mapowanie każdy: { :klucz :wartość
		parametry-url dołącz: klucz tekst url-koduj + ['='] + wartość tekst url-koduj.
	}.
	własny parametry-url := ['?'] + ( parametry-url połącz: ['&'] ).
}.

URL na: ['skrót:'] wykonaj: { :hash
	własny hash := ['#'] + hash url-koduj.
}.

