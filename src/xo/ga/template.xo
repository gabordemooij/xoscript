
# ~ Simple template engine ~

>> Teimpléad := Réad nua.

Teimpléad ar: ['nua'] déan: { <- féin nua ábhar: [''].
}.

Teimpléad ar: ['ábhar:'] déan: { :ábhar
	dílis ábhar := ábhar. 
}.

Teimpléad ar: ['nua:'] déan: { :ábhar <- féin nua ábhar: ábhar.
}.

Teimpléad ar: ['gearr:'] déan: { :marcóir
	>> marcóir-tosaigh := (['<!-- cut:%id% -->'] %id%: marcóir).
	>> marcóir-deiridh := (['<!-- /cut:%id% -->'] %id%: marcóir).
	>> codanna := dílis ábhar scoilt: marcóir-tosaigh.
	>> réimír := codanna céad.
	>> codanna2 := codanna deireanach scoilt: marcóir-deiridh.
	>> iarmhír := codanna2 deireanach.
	>> cuid := codanna2 céad.
	>> fuílleach := réimír + iarmhír.
	dílis ábhar := fuílleach. <- Teimpléad nua: cuid.
	
}.

Teimpléad ar: ['cóipeáil'] déan: { <- féin nua: féin teaghrán cóipeáil.
}.
	
Teimpléad ar: ['greamaigh:ag:'] déan: { :sliocht :id
	>> marcóir-greamaithe := (['<!-- paste:%id% -->'] %id%: id).
	dílis ábhar ionadaigh: marcóir-greamaithe le: ( sliocht teaghrán + marcóir-greamaithe ).
}.

Teimpléad ar: ['socraigh:luach:'] déan: { :sliotán :luach
	dílis ábhar ionadaigh: ['<!-- slot:'] + sliotán + [' -->'] le: ( Server html-ionchódaigh: luach ).
}.

Teimpléad ar: ['socraigh:html:'] déan: { :sliotán :html
	dílis ábhar ionadaigh: ['<!-- slot:'] + sliotán + [' -->'] le: html.
}.

Teimpléad ar: ['freagair:agus:'] déan: { :sliotán :luach
	féin socraigh: (sliotán ó: 0 fad: (sliotán fad - 1)) luach: luach.
}.

Teimpléad ar: ['nl2br'] déan: {
	dílis ábhar ionadaigh: ['\n'] le: ['<br>'].
}.

Teimpléad ar: ['slachtaigh'] déan: {
	dílis ábhar :=
		Patrún
		nua: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		meaitseáil: dílis ábhar
		déan: { <- ['']. }.
}.

Teimpléad ar: ['slachtaigh-gearrthacha'] déan: {
	>> míreanna := Liosta nua.
	Patrún
	nua: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	meaitseáil: dílis ábhar
	déan: { :_ :cuid
		míreanna iarcheangail: cuid ? 1.
	}.
	míreanna gach: { :_ :id
		dílis ábhar :=
			Patrún nua: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			meaitseáil: dílis ábhar
			déan: { <- ['']. }.
	 }.
}.

Teimpléad ar: ['slachtaigh-spásanna'] déan: {
	dílis ábhar :=
		Patrún
		nua: ['\\s*\\n'],
		meaitseáil: dílis ábhar
		déan: { <- ['\n']. }.
	dílis ábhar :=
		Patrún
		nua: ['\\n[\\s\\t]+'],
		meaitseáil: dílis ábhar
		déan: { <- ['\n']. }.
}.

Teimpléad ar: ['slachtaigh-uile'] déan: {
	féin slachtaigh.
	féin slachtaigh-gearrthacha.
	féin slachtaigh-spásanna.
}.

Teimpléad ar: ['teaghrán'] déan: { <- dílis ábhar.
}.
