HTTP-Iarratas ar: ['HTTP-ceanntásc:'] déan: { :eochair <- Ríomhchlár socrú: eochair.
}.

>> Ceanntásc-HTTP := Réad nua.

Ceanntásc-HTTP ar: ['nua'] déan: { <- féin nua túsaigh.
}.

Ceanntásc-HTTP ar: ['túsaigh'] déan: {
	dílis eochair := Neamhní.
	dílis luach := Neamhní.
}.

Ceanntásc-HTTP ar: ['eochair:luach:'] déan: { :eochair :luach
	dílis eochair := eochair.
	dílis luach := luach.
}.

Ceanntásc-HTTP ar: ['eochair'] déan: { <- dílis eochair.
}.

Ceanntásc-HTTP ar: ['luach'] déan: { <- dílis luach.
}.


Ceanntásc-HTTP ar: ['teaghrán'] déan: {
	>> líne := dílis eochair + [': '] + dílis luach.
	líne ionadaigh: ['\r'] le: [''], ionadaigh: ['\n'] le: ['']. <- líne + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Doiciméad-Gréasáin := Réad nua.

Doiciméad-Gréasáin ar: ['nua'] déan: { <- féin nua túsaigh.
}.

Doiciméad-Gréasáin ar: ['túsaigh'] déan: {
	dílis ceanntáisc := Liosta nua.
	dílis aitheantas-seisiúin := Neamhní.
	dílis bainisteoir-seisiún := Seisiún-comhaid-shealadaigh nua.
	dílis sonraí-seisiúin := Neamhní.
	dílis slán := Fíor.
	dílis an-láithreán-céanna := ['Strict'].
	dílis ceanntáisc-seolta := Bréagach.
	dílis iarratas-http := HTTP-Iarratas nua.
}.

Doiciméad-Gréasáin ar: ['iarratas-http:'] déan: { :iarratas-http
	dílis iarratas-http := iarratas-http.
}. 

Doiciméad-Gréasáin ar: ['fianán-seisiúin-slán:'] déan: { :slán
	féin seiceáil-ceanntáisc.
	dílis slán := slán.
}.

Doiciméad-Gréasáin ar: ['fianán-seisiúin-an-láithreáin-chéanna:'] déan: { :luach
	féin seiceáil-ceanntáisc.
	>> roghanna := Liosta nua 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	roghanna tá-aige: luach, bréagach: {
		an-tasc-seo earráid: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	dílis an-láithreán-céanna := luach.
}.

Doiciméad-Gréasáin ar: ['ceanntásc:'] déan: { :ceanntásc
	féin seiceáil-ceanntáisc.
	dílis ceanntáisc iarcheangail: ceanntásc.
}.

Doiciméad-Gréasáin ar: ['folmhaigh-ceanntáisc'] déan: {
	féin seiceáil-ceanntáisc.
	dílis ceanntáisc := Liosta nua.
}.

Doiciméad-Gréasáin ar: ['bainisteoir-seisiún:'] déan: { :bainisteoir
	féin seiceáil-ceanntáisc.
	dílis bainisteoir-seisiún := bainisteoir.
}.

Doiciméad-Gréasáin ar: ['bainisteoir-seisiún'] déan: { <- dílis bainisteoir-seisiún.
}.

Doiciméad-Gréasáin ar: ['seiceáil-ceanntáisc'] déan: {
	dílis ceanntáisc-seolta fíor: {
		an-tasc-seo earráid: ['Headers already sent to client.'].
	}.
}.

Doiciméad-Gréasáin ar: ['tosaigh-seisiún'] déan: {
	féin seiceáil-ceanntáisc.
	>> iarratas-http := dílis iarratas-http.
	>> aitheantas-seisiúin := iarratas-http cookie: ['xsid'].
	aitheantas-seisiúin Neamhní? bréagach: {
		(( Patrún nua: ['^[A-Za-z0-9]+\\z'], meaitseáil: aitheantas-seisiúin ) = 0) fíor: {
			aitheantas-seisiúin := Neamhní.
		}.
	}.
	aitheantas-seisiúin Neamhní? fíor: {
		aitheantas-seisiúin := Taisceadán ceadchomhartha: 30.
		>> ceanntásc-seisiúin := Ceanntásc-HTTP nua
		eochair: ['Set-Cookie'] luach: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (dílis slán ceachtar: ['Secure'] nó: ['']),
		SSITE: (dílis an-láithreán-céanna),
		XSID: aitheantas-seisiúin
		).
		dílis ceanntáisc iarcheangail: ceanntásc-seisiúin.
	}.
	dílis sonraí-seisiúin := dílis bainisteoir-seisiún do: aitheantas-seisiúin, lódáil. <- dílis sonraí-seisiúin. # reference
}.

Doiciméad-Gréasáin ar: ['téigh-go:'] déan: { :seoladh
	féin seiceáil-ceanntáisc.
	féin folmhaigh-ceanntáisc.
	dílis ceanntáisc
	iarcheangail: (
		Ceanntásc-HTTP nua
		eochair: ['Status'] luach: ['303 See Other']
	),
	iarcheangail: (
		Ceanntásc-HTTP nua
		eochair: ['Location'] luach: seoladh
	).
	féin aschuir: ['Redirect'].
}.

Doiciméad-Gréasáin ar: ['scrios-seisiún'] déan: {
	féin seiceáil-ceanntáisc.
	>> iarratas-http := dílis iarratas-http.
	>> aitheantas-seisiúin := iarratas-http cookie: ['xsid'].
	aitheantas-seisiúin Neamhní? bréagach: {
		>> ceanntásc-seisiúin := Ceanntásc-HTTP nua.
		>> tráth := Tráth nua bliain: 1970, formáid: ['%a, %d %b %Y %H:%M:%S GMT'].
		ceanntásc-seisiúin eochair: ['Set-Cookie'] luach: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tráth,
			SEC: (dílis slán ceachtar: ['Secure'] nó: ['']),
			SSITE: (dílis an-láithreán-céanna),
			XSID: aitheantas-seisiúin
		).
		dílis bainisteoir-seisiún díothaigh.
		dílis ceanntáisc iarcheangail: ceanntásc-seisiúin.
	}.
}.


Doiciméad-Gréasáin ar: ['teimpléad:'] déan: { :conair <- Teimpléad nua: (Comhad nua: conair, léigh).
}.

Doiciméad-Gréasáin ar: ['aschuir:cineál:'] déan: { :aschur :cineál
	dílis ceanntáisc-seolta bréagach: {
		dílis sonraí-seisiúin Neamhní? bréagach: {
			dílis bainisteoir-seisiún sábháil: dílis sonraí-seisiúin.
		}.
		dílis ceanntáisc iarcheangail: (
			Ceanntásc-HTTP nua
			eochair: ['Content-type'] luach: cineál
		).
		dílis ceanntáisc gach: { :_ :ceanntásc
			Aschur scríobh: ceanntásc.
		}.
		dílis ceanntáisc-seolta := Fíor.
		Aschur scríobh: ['\r\n'].
	}.
	Aschur scríobh: aschur.
}.

Doiciméad-Gréasáin ar: ['críochnaigh:cineál:'] déan: { :aschur :cineál
	dílis ceanntáisc-seolta bréagach: {
		dílis sonraí-seisiúin Neamhní? bréagach: {
			dílis bainisteoir-seisiún sábháil: dílis sonraí-seisiúin.
		}.
		dílis ceanntáisc iarcheangail: (
			Ceanntásc-HTTP nua
			eochair: ['Content-type'] luach: cineál
		).
		dílis ceanntáisc iarcheangail: (
			Ceanntásc-HTTP nua
			eochair: ['Content-Length'] luach: aschur teaghrán bytes
		).
		dílis ceanntáisc gach: { :_ :ceanntásc
			Aschur scríobh: ceanntásc.
		}.
		dílis ceanntáisc-seolta := Fíor.
		Aschur scríobh: ['\r\n'].
	}.
	Aschur scríobh: aschur.
}.

Doiciméad-Gréasáin ar: ['aschuir:'] déan: { :aschur
	féin aschuir: aschur cineál: ['text/html; charset=utf-8'].
}.

Doiciméad-Gréasáin ar: ['críochnaigh:'] déan: { :aschur
	féin críochnaigh: aschur cineál: ['text/html; charset=utf-8'].
}.

Doiciméad-Gréasáin ar: ['json:'] déan: { :aschur
	féin aschuir: ( JSON jsonify: aschur ) cineál: ['application/json'].
}.

Doiciméad-Gréasáin ar: ['gan-aimsiú:'] déan: { :aschur
	féin folmhaigh-ceanntáisc ceanntásc: (
		Ceanntásc-HTTP nua eochair: ['Status'] luach: ['404 Not Found']
	).
	féin aschuir: aschur.
}.


# Interface

>> Seisiún := Réad nua.

Seisiún ar: ['nua'] déan: { <- féin nua túsaigh do: Neamhní.
}.

Seisiún ar: ['do:'] déan: { :id
	dílis id := id.
}.

Seisiún ar: ['lódáil'] déan: {
	an-tasc-seo earráid: ['Not implemented.'].
}.

Seisiún ar: ['sábháil:'] déan: {
	an-tasc-seo earráid: ['Not implemented.'].
}.

Seisiún ar: ['díothaigh'] déan: {
	an-tasc-seo earráid: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seisiún-comhaid-shealadaigh := Seisiún nua.

Seisiún-comhaid-shealadaigh ar: ['túsaigh'] déan: {
	dílis tús-cosáin := ['/tmp/sess-'].
}.

Seisiún-comhaid-shealadaigh ar: ['réimír-chosáin:'] déan: { :teaghrán-téacs
	dílis tús-cosáin := teaghrán-téacs.
}.

Seisiún-comhaid-shealadaigh ar: ['comhad'] déan: { <- ( Comhad nua: ( dílis tús-cosáin + dílis id + ['.txt'] ) ).
}.

Seisiún-comhaid-shealadaigh ar: ['lódáil'] déan: {
	>> comhad := féin comhad.
	comhad ann bréagach: {
		comhad scríobh: (Foclóir nua cód).
	}. <- comhad léigh réad.
}.

Seisiún-comhaid-shealadaigh ar: ['sábháil:'] déan: { :sonraí
	>> comhad := féin comhad.
	comhad ann fíor: {
		comhad scríobh: sonraí cód.
	}.
}.

Seisiún-comhaid-shealadaigh ar: ['díothaigh'] déan: {
	>> comhad := féin comhad.
	comhad ann fíor: {
		comhad scrios.
	}.
}.


>> URL := Réad nua.

URL ar: ['túsaigh'] déan: {
	dílis prótacal := ['https://'].
	dílis óstach := ['localhost'].
	dílis conair := [''].
	dílis paraiméadair-url := [''].
	dílis hash := [''].
}.

URL ar: ['nua'] déan: { <- féin nua túsaigh.
}.

URL ar: ['teaghrán'] déan: { <- (
	dílis prótacal +
	dílis óstach +
	dílis conair +
	dílis paraiméadair-url +
	dílis hash ).
}.

URL ar: ['prótacal:'] déan: { :prótacal
	((Liosta nua ; ['http'] ; ['https']) tá-aige: prótacal) fíor: {
		dílis prótacal := prótacal + ['://'].
	}, bréagach: {
		an-tasc-seo earráid: ['Invalid protocol'].
	}.
}.

URL ar: ['óstach:'] déan: { :óstach
	#todo validate according to rfc
	dílis óstach := óstach.
}.

URL ar: ['conair:'] déan: { :conair
	dílis conair := ['/'] + conair url-ionchódaigh.
}.

URL ar: ['paraiméadair-url:'] déan: { :mapáil
	>> paraiméadair-url := Liosta nua.
	mapáil gach: { :eochair :luach
		paraiméadair-url iarcheangail: eochair teaghrán url-ionchódaigh + ['='] + luach teaghrán url-ionchódaigh.
	}.
	dílis paraiméadair-url := ['?'] + ( paraiméadair-url ceangail: ['&'] ).
}.

URL ar: ['haiseáil:'] déan: { :hash
	dílis hash := ['#'] + hash url-ionchódaigh.
}.

