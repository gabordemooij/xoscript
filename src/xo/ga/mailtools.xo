>> Ríomhphost := Réad nua.

Ríomhphost ar: ['túsaigh'] déan: {
	dílis faighteoirí := Liosta nua.
	dílis cc := Liosta nua.
	dílis bcc := Liosta nua.
	dílis seoltóir := Neamhní.
	dílis ainm-seoltóra := Neamhní.
	dílis ábhar-teachtaireachta := Neamhní.
	dílis corp := Neamhní.
}.

Ríomhphost ar: ['nua'] déan: { <- féin nua túsaigh.
}.

Ríomhphost ar: ['chuig:'] déan: { :liostáil
	dílis faighteoirí := liostáil.
}.
 
Ríomhphost ar: ['cc:'] déan: { :liostáil
	dílis cc := liostáil.
}.

Ríomhphost ar: ['bcc:'] déan: { :liostáil
	dílis bcc := liostáil.
}.

Ríomhphost ar: ['ábhar-teachtaireachta:'] déan: { :ábhar-teachtaireachta
	dílis ábhar-teachtaireachta := ábhar-teachtaireachta.
}.

Ríomhphost ar: ['seoltóir:ainm:'] déan: { :seoltóir :ainm
	dílis seoltóir := seoltóir.
	dílis ainm-seoltóra := ainm.
}.

Ríomhphost ar: ['corp:'] déan: { :corp
	dílis corp := corp.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Ríomhphost ar: ['ceanntásc:'] déan: { :líne <- líne ionadaigh: ['\r'] le: [''], ionadaigh: ['\n'] le: [''].
}.

Ríomhphost ar: ['seol'] déan: {
	>> f := Comhad tempwrite: féin gin.
	Ríomhchlár córas: ['sendmail -t < '] + f conair, líne-nua.
}.

Ríomhphost ar: ['gin'] déan: {
	>> briseadh-líne := ['\r\n'].
	>> teaghrán-téacs := [''].
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['From: '] + dílis ainm-seoltóra + [' <'] + ( dílis seoltóir ) + ['>']) + briseadh-líne.
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['To: '] + ( dílis faighteoirí ceangail: [','] )) + briseadh-líne.
	dílis cc comhair fíor: {
		teaghrán-téacs iarcheangail: (féin ceanntásc: ['Cc: '] + ( dílis cc ceangail: [','] )) + briseadh-líne.
	}.
	dílis bcc comhair fíor: {
		teaghrán-téacs iarcheangail: (féin ceanntásc: ['Bcc: '] + ( dílis bcc ceangail: [','] )) + briseadh-líne.
	}.
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['Subject: '] + dílis ábhar-teachtaireachta) + briseadh-líne.
	teaghrán-téacs iarcheangail: briseadh-líne.
	teaghrán-téacs iarcheangail: dílis corp.
	teaghrán-téacs iarcheangail: briseadh-líne. <- teaghrán-téacs.
}.

>> Ríomhphost-HTML := Ríomhphost nua.

Ríomhphost-HTML ar: ['túsaigh'] déan: {
	féin túsaigh.
	dílis ceangaltáin := Liosta nua.
	dílis teorainn := Taisceadán ceadchomhartha: 40.
}.

Ríomhphost-HTML ar: ['iniaigh:'] déan: { :comhad
	>> id := dílis ceangaltáin comhair.
	>> blob := comhad blob.
	dílis ceangaltáin iarcheangail: (
		Foclóir nua
			comhad: comhad conair,
			mime: ['image/'] + (Server mimetype: comhad conair),
			sonraí: blob base64-ionchódaigh
	).
	blob saor. <- ['cid:attachment'] + id.
}.

Ríomhphost-HTML ar: ['gin'] déan: {
	>> briseadh-líne := ['\r\n'].
	>> teaghrán-téacs := [''].
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['From: '] + dílis ainm-seoltóra + [' <'] + ( dílis seoltóir ) + ['>']) + briseadh-líne.
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['To: '] + ( dílis faighteoirí ceangail: [','] )) + briseadh-líne.
	dílis cc comhair fíor: {
		teaghrán-téacs iarcheangail: (féin ceanntásc: ['Cc: '] + ( dílis cc ceangail: [','] )) + briseadh-líne.
	}.
	dílis bcc comhair fíor: {
		teaghrán-téacs iarcheangail: (féin ceanntásc: ['Bcc: '] + ( dílis bcc ceangail: [','] )) + briseadh-líne.
	}.
	teaghrán-téacs iarcheangail: (féin ceanntásc: ['Subject: '] + dílis ábhar-teachtaireachta) + briseadh-líne.
	teaghrán-téacs iarcheangail: ['MIME-Version: 1.0'] + briseadh-líne.
	teaghrán-téacs iarcheangail: ['Content-Type: multipart/related; boundary="'] + dílis teorainn + ['"; type=text/html'] + briseadh-líne.
	teaghrán-téacs iarcheangail: briseadh-líne.
	teaghrán-téacs iarcheangail: ['--'] + dílis teorainn + briseadh-líne.
	teaghrán-téacs iarcheangail: ['Content-Type: text/html; charset=UTF-8'] + briseadh-líne.
	teaghrán-téacs iarcheangail: ['Content-Transfer-Encoding: 7bit'] + briseadh-líne.
	teaghrán-téacs iarcheangail: briseadh-líne.
	teaghrán-téacs iarcheangail: dílis corp.
	teaghrán-téacs iarcheangail: briseadh-líne.
	dílis ceangaltáin gach: { :id :eolas
		>> blob := eolas sonraí.
		teaghrán-téacs iarcheangail: ['--'] + dílis teorainn + briseadh-líne.
		teaghrán-téacs iarcheangail: ['Content-Type: '] + eolas mime + briseadh-líne.
		teaghrán-téacs iarcheangail: ['Content-Transfer-Encoding: base64'] + briseadh-líne.
		teaghrán-téacs iarcheangail: ['Content-ID: <attachment'] + id + ['>'] + briseadh-líne.
		teaghrán-téacs iarcheangail: ['Content-Disposition: inline; filename="'] + eolas comhad + ['"'] + briseadh-líne.
		teaghrán-téacs iarcheangail: briseadh-líne.
		>> uasteorainn := 76.
		>> fad-téacs := blob fad.
		>> píosaí := (fad-téacs / uasteorainn) slánaigh-suas.
		{ :i
			>> píosa := blob cóipeáil ó: i * uasteorainn fad: uasteorainn.
			teaghrán-téacs iarcheangail: píosa + briseadh-líne.
		} * píosaí.
		teaghrán-téacs iarcheangail: briseadh-líne.
		teaghrán-téacs iarcheangail: briseadh-líne.
	}.
	teaghrán-téacs iarcheangail: ['--'] + dílis teorainn + ['--'] + briseadh-líne. <- teaghrán-téacs.
}.
