>> Surélék := Obyek anyar.

Surélék nalika: ['siapkeun'] lakukeun: {
	milik panampi := Daptar anyar.
	milik cc := Daptar anyar.
	milik bcc := Daptar anyar.
	milik pangirim := Kosong.
	milik nami-pangirim := Kosong.
	milik jejer := Kosong.
	milik awak := Kosong.
}.

Surélék nalika: ['anyar'] lakukeun: { <- diri anyar siapkeun.
}.

Surélék nalika: ['ka:'] lakukeun: { :panyebutan
	milik panampi := panyebutan.
}.
 
Surélék nalika: ['cc:'] lakukeun: { :panyebutan
	milik cc := panyebutan.
}.

Surélék nalika: ['bcc:'] lakukeun: { :panyebutan
	milik bcc := panyebutan.
}.

Surélék nalika: ['jejer:'] lakukeun: { :jejer
	milik jejer := jejer.
}.

Surélék nalika: ['pangirim:ngaran:'] lakukeun: { :pangirim :ngaran
	milik pangirim := pangirim.
	milik nami-pangirim := ngaran.
}.

Surélék nalika: ['awak:'] lakukeun: { :awak
	milik awak := awak.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Surélék nalika: ['lulugu:'] lakukeun: { :baris <- baris ganti: ['\r'] ku: [''], ganti: ['\n'] ku: [''].
}.

Surélék nalika: ['kirim'] lakukeun: {
	>> f := Berkas tempwrite: diri jieun.
	Program sistem: ['sendmail -t < '] + f jalur, baris-anyar.
}.

Surélék nalika: ['jieun'] lakukeun: {
	>> pamisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-di-tungtung: (diri lulugu: ['From: '] + milik nami-pangirim + [' <'] + ( milik pangirim ) + ['>']) + pamisah-baris.
	untaian tambah-di-tungtung: (diri lulugu: ['To: '] + ( milik panampi gabungkeun: [','] )) + pamisah-baris.
	milik cc jumlah bener: {
		untaian tambah-di-tungtung: (diri lulugu: ['Cc: '] + ( milik cc gabungkeun: [','] )) + pamisah-baris.
	}.
	milik bcc jumlah bener: {
		untaian tambah-di-tungtung: (diri lulugu: ['Bcc: '] + ( milik bcc gabungkeun: [','] )) + pamisah-baris.
	}.
	untaian tambah-di-tungtung: (diri lulugu: ['Subject: '] + milik jejer) + pamisah-baris.
	untaian tambah-di-tungtung: pamisah-baris.
	untaian tambah-di-tungtung: milik awak.
	untaian tambah-di-tungtung: pamisah-baris. <- untaian.
}.

>> Surélék-HTML := Surélék anyar.

Surélék-HTML nalika: ['siapkeun'] lakukeun: {
	diri siapkeun.
	milik lampiran := Daptar anyar.
	milik wates := Brankas token: 40.
}.

Surélék-HTML nalika: ['lampirkeun:'] lakukeun: { :berkas-sési
	>> id := milik lampiran jumlah.
	>> blob := berkas-sési blob.
	milik lampiran tambah-di-tungtung: (
		Kamus anyar
			berkas-sési: berkas-sési jalur,
			mime: ['image/'] + (Server mimetype: berkas-sési jalur),
			data: blob base64-énkode
	).
	blob bébaskeun. <- ['cid:attachment'] + id.
}.

Surélék-HTML nalika: ['jieun'] lakukeun: {
	>> pamisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-di-tungtung: (diri lulugu: ['From: '] + milik nami-pangirim + [' <'] + ( milik pangirim ) + ['>']) + pamisah-baris.
	untaian tambah-di-tungtung: (diri lulugu: ['To: '] + ( milik panampi gabungkeun: [','] )) + pamisah-baris.
	milik cc jumlah bener: {
		untaian tambah-di-tungtung: (diri lulugu: ['Cc: '] + ( milik cc gabungkeun: [','] )) + pamisah-baris.
	}.
	milik bcc jumlah bener: {
		untaian tambah-di-tungtung: (diri lulugu: ['Bcc: '] + ( milik bcc gabungkeun: [','] )) + pamisah-baris.
	}.
	untaian tambah-di-tungtung: (diri lulugu: ['Subject: '] + milik jejer) + pamisah-baris.
	untaian tambah-di-tungtung: ['MIME-Version: 1.0'] + pamisah-baris.
	untaian tambah-di-tungtung: ['Content-Type: multipart/related; boundary="'] + milik wates + ['"; type=text/html'] + pamisah-baris.
	untaian tambah-di-tungtung: pamisah-baris.
	untaian tambah-di-tungtung: ['--'] + milik wates + pamisah-baris.
	untaian tambah-di-tungtung: ['Content-Type: text/html; charset=UTF-8'] + pamisah-baris.
	untaian tambah-di-tungtung: ['Content-Transfer-Encoding: 7bit'] + pamisah-baris.
	untaian tambah-di-tungtung: pamisah-baris.
	untaian tambah-di-tungtung: milik awak.
	untaian tambah-di-tungtung: pamisah-baris.
	milik lampiran unggal: { :id :info
		>> blob := info data.
		untaian tambah-di-tungtung: ['--'] + milik wates + pamisah-baris.
		untaian tambah-di-tungtung: ['Content-Type: '] + info mime + pamisah-baris.
		untaian tambah-di-tungtung: ['Content-Transfer-Encoding: base64'] + pamisah-baris.
		untaian tambah-di-tungtung: ['Content-ID: <attachment'] + id + ['>'] + pamisah-baris.
		untaian tambah-di-tungtung: ['Content-Disposition: inline; filename="'] + info berkas-sési + ['"'] + pamisah-baris.
		untaian tambah-di-tungtung: pamisah-baris.
		>> pangluhurna := 76.
		>> panjang-téks := blob panjang.
		>> potongan-potongan := (panjang-téks / pangluhurna) buleudkeun-ka-luhur.
		{ :i
			>> potongan-data := blob salin tina: i * pangluhurna panjang: pangluhurna.
			untaian tambah-di-tungtung: potongan-data + pamisah-baris.
		} * potongan-potongan.
		untaian tambah-di-tungtung: pamisah-baris.
		untaian tambah-di-tungtung: pamisah-baris.
	}.
	untaian tambah-di-tungtung: ['--'] + milik wates + ['--'] + pamisah-baris. <- untaian.
}.
