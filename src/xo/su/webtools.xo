Paménta-HTTP nalika: ['HTTP-lulugu:'] lakukeun: { :konci-lulugu <- Program setélan: konci-lulugu.
}.

>> Lulugu-HTTP := Obyek anyar.

Lulugu-HTTP nalika: ['anyar'] lakukeun: { <- diri anyar siapkeun.
}.

Lulugu-HTTP nalika: ['siapkeun'] lakukeun: {
	milik konci-lulugu := Kosong.
	milik nilai := Kosong.
}.

Lulugu-HTTP nalika: ['konci-lulugu:nilai:'] lakukeun: { :konci-lulugu :nilai
	milik konci-lulugu := konci-lulugu.
	milik nilai := nilai.
}.

Lulugu-HTTP nalika: ['konci-lulugu'] lakukeun: { <- milik konci-lulugu.
}.

Lulugu-HTTP nalika: ['nilai'] lakukeun: { <- milik nilai.
}.


Lulugu-HTTP nalika: ['téks'] lakukeun: {
	>> baris := milik konci-lulugu + [': '] + milik nilai.
	baris ganti: ['\r'] ku: [''], ganti: ['\n'] ku: ['']. <- baris + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumén-Wéb := Obyek anyar.

Dokumén-Wéb nalika: ['anyar'] lakukeun: { <- diri anyar siapkeun.
}.

Dokumén-Wéb nalika: ['siapkeun'] lakukeun: {
	milik daptar-lulugu := Daptar anyar.
	milik id-sési := Kosong.
	milik pangatur-sési := Sési-berkas-samentawis anyar.
	milik data-sési := Kosong.
	milik aman := Bener.
	milik situs-sami := ['Strict'].
	milik lulugu-dikirim := Salah.
	milik pamundut-http := Paménta-HTTP anyar.
}.

Dokumén-Wéb nalika: ['pamundut-http:'] lakukeun: { :pamundut-http
	milik pamundut-http := pamundut-http.
}. 

Dokumén-Wéb nalika: ['kuki-sési-aman:'] lakukeun: { :aman
	diri pariksa-lulugu.
	milik aman := aman.
}.

Dokumén-Wéb nalika: ['kuki-sési-situs-sami:'] lakukeun: { :nilai
	diri pariksa-lulugu.
	>> pilihan := Daptar anyar 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	pilihan miboga: nilai, salah: {
		tugas-ieu kasalahan: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	milik situs-sami := nilai.
}.

Dokumén-Wéb nalika: ['lulugu:'] lakukeun: { :lulugu
	diri pariksa-lulugu.
	milik daptar-lulugu tambah-di-tungtung: lulugu.
}.

Dokumén-Wéb nalika: ['kosongkeun-lulugu'] lakukeun: {
	diri pariksa-lulugu.
	milik daptar-lulugu := Daptar anyar.
}.

Dokumén-Wéb nalika: ['pangatur-sési:'] lakukeun: { :pangatur
	diri pariksa-lulugu.
	milik pangatur-sési := pangatur.
}.

Dokumén-Wéb nalika: ['pangatur-sési'] lakukeun: { <- milik pangatur-sési.
}.

Dokumén-Wéb nalika: ['pariksa-lulugu'] lakukeun: {
	milik lulugu-dikirim bener: {
		tugas-ieu kasalahan: ['Headers already sent to client.'].
	}.
}.

Dokumén-Wéb nalika: ['mimitian-sési'] lakukeun: {
	diri pariksa-lulugu.
	>> pamundut-http := milik pamundut-http.
	>> id-sési := pamundut-http cookie: ['xsid'].
	id-sési Kosong? salah: {
		(( Pola anyar: ['^[A-Za-z0-9]+\\z'], cocog: id-sési ) = 0) bener: {
			id-sési := Kosong.
		}.
	}.
	id-sési Kosong? bener: {
		id-sési := Brankas token: 30.
		>> lulugu-sési := Lulugu-HTTP anyar
		konci-lulugu: ['Set-Cookie'] nilai: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (milik aman pilih: ['Secure'] atawa: ['']),
		SSITE: (milik situs-sami),
		XSID: id-sési
		).
		milik daptar-lulugu tambah-di-tungtung: lulugu-sési.
	}.
	milik data-sési := milik pangatur-sési pikeun: id-sési, muat. <- milik data-sési. # reference
}.

Dokumén-Wéb nalika: ['angkat-ka:'] lakukeun: { :alamat
	diri pariksa-lulugu.
	diri kosongkeun-lulugu.
	milik daptar-lulugu
	tambah-di-tungtung: (
		Lulugu-HTTP anyar
		konci-lulugu: ['Status'] nilai: ['303 See Other']
	),
	tambah-di-tungtung: (
		Lulugu-HTTP anyar
		konci-lulugu: ['Location'] nilai: alamat
	).
	diri kaluarkeun: ['Redirect'].
}.

Dokumén-Wéb nalika: ['ancurkeun-sési'] lakukeun: {
	diri pariksa-lulugu.
	>> pamundut-http := milik pamundut-http.
	>> id-sési := pamundut-http cookie: ['xsid'].
	id-sési Kosong? salah: {
		>> lulugu-sési := Lulugu-HTTP anyar.
		>> waktos-béak := Waktu anyar taun: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		lulugu-sési konci-lulugu: ['Set-Cookie'] nilai: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: waktos-béak,
			SEC: (milik aman pilih: ['Secure'] atawa: ['']),
			SSITE: (milik situs-sami),
			XSID: id-sési
		).
		milik pangatur-sési ancurkeun.
		milik daptar-lulugu tambah-di-tungtung: lulugu-sési.
	}.
}.


Dokumén-Wéb nalika: ['citakan:'] lakukeun: { :jalur <- Citakan anyar: (Berkas anyar: jalur, baca).
}.

Dokumén-Wéb nalika: ['kaluarkeun:tipe:'] lakukeun: { :hasil :tipe
	milik lulugu-dikirim salah: {
		milik data-sési Kosong? salah: {
			milik pangatur-sési simpen: milik data-sési.
		}.
		milik daptar-lulugu tambah-di-tungtung: (
			Lulugu-HTTP anyar
			konci-lulugu: ['Content-type'] nilai: tipe
		).
		milik daptar-lulugu unggal: { :_ :lulugu
			Kaluaran tulis: lulugu.
		}.
		milik lulugu-dikirim := Bener.
		Kaluaran tulis: ['\r\n'].
	}.
	Kaluaran tulis: hasil.
}.

Dokumén-Wéb nalika: ['réngsékeun:tipe:'] lakukeun: { :hasil :tipe
	milik lulugu-dikirim salah: {
		milik data-sési Kosong? salah: {
			milik pangatur-sési simpen: milik data-sési.
		}.
		milik daptar-lulugu tambah-di-tungtung: (
			Lulugu-HTTP anyar
			konci-lulugu: ['Content-type'] nilai: tipe
		).
		milik daptar-lulugu tambah-di-tungtung: (
			Lulugu-HTTP anyar
			konci-lulugu: ['Content-Length'] nilai: hasil téks bytes
		).
		milik daptar-lulugu unggal: { :_ :lulugu
			Kaluaran tulis: lulugu.
		}.
		milik lulugu-dikirim := Bener.
		Kaluaran tulis: ['\r\n'].
	}.
	Kaluaran tulis: hasil.
}.

Dokumén-Wéb nalika: ['kaluarkeun:'] lakukeun: { :hasil
	diri kaluarkeun: hasil tipe: ['text/html; charset=utf-8'].
}.

Dokumén-Wéb nalika: ['réngsékeun:'] lakukeun: { :hasil
	diri réngsékeun: hasil tipe: ['text/html; charset=utf-8'].
}.

Dokumén-Wéb nalika: ['json:'] lakukeun: { :hasil
	diri kaluarkeun: ( JSON jsonify: hasil ) tipe: ['application/json'].
}.

Dokumén-Wéb nalika: ['teu-kapendak:'] lakukeun: { :hasil
	diri kosongkeun-lulugu lulugu: (
		Lulugu-HTTP anyar konci-lulugu: ['Status'] nilai: ['404 Not Found']
	).
	diri kaluarkeun: hasil.
}.


# Interface

>> Sési := Obyek anyar.

Sési nalika: ['anyar'] lakukeun: { <- diri anyar siapkeun pikeun: Kosong.
}.

Sési nalika: ['pikeun:'] lakukeun: { :id
	milik id := id.
}.

Sési nalika: ['muat'] lakukeun: {
	tugas-ieu kasalahan: ['Not implemented.'].
}.

Sési nalika: ['simpen:'] lakukeun: {
	tugas-ieu kasalahan: ['Not implemented.'].
}.

Sési nalika: ['ancurkeun'] lakukeun: {
	tugas-ieu kasalahan: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sési-berkas-samentawis := Sési anyar.

Sési-berkas-samentawis nalika: ['siapkeun'] lakukeun: {
	milik awal-jalur := ['/tmp/sess-'].
}.

Sési-berkas-samentawis nalika: ['awalan-jalur:'] lakukeun: { :untaian
	milik awal-jalur := untaian.
}.

Sési-berkas-samentawis nalika: ['berkas-sési'] lakukeun: { <- ( Berkas anyar: ( milik awal-jalur + milik id + ['.txt'] ) ).
}.

Sési-berkas-samentawis nalika: ['muat'] lakukeun: {
	>> berkas-sési := diri berkas-sési.
	berkas-sési aya salah: {
		berkas-sési tulis: (Kamus anyar kode).
	}. <- berkas-sési baca obyek.
}.

Sési-berkas-samentawis nalika: ['simpen:'] lakukeun: { :data
	>> berkas-sési := diri berkas-sési.
	berkas-sési aya bener: {
		berkas-sési tulis: data kode.
	}.
}.

Sési-berkas-samentawis nalika: ['ancurkeun'] lakukeun: {
	>> berkas-sési := diri berkas-sési.
	berkas-sési aya bener: {
		berkas-sési pupus.
	}.
}.


>> URL := Obyek anyar.

URL nalika: ['siapkeun'] lakukeun: {
	milik protokol := ['https://'].
	milik hos := ['localhost'].
	milik jalur := [''].
	milik paraméter-url := [''].
	milik hash := [''].
}.

URL nalika: ['anyar'] lakukeun: { <- diri anyar siapkeun.
}.

URL nalika: ['téks'] lakukeun: { <- (
	milik protokol +
	milik hos +
	milik jalur +
	milik paraméter-url +
	milik hash ).
}.

URL nalika: ['protokol:'] lakukeun: { :protokol
	((Daptar anyar ; ['http'] ; ['https']) miboga: protokol) bener: {
		milik protokol := protokol + ['://'].
	}, salah: {
		tugas-ieu kasalahan: ['Invalid protocol'].
	}.
}.

URL nalika: ['hos:'] lakukeun: { :hos
	#todo validate according to rfc
	milik hos := hos.
}.

URL nalika: ['jalur:'] lakukeun: { :jalur
	milik jalur := ['/'] + jalur url-énkode.
}.

URL nalika: ['paraméter-url:'] lakukeun: { :pemetaan
	>> paraméter-url := Daptar anyar.
	pemetaan unggal: { :konci-lulugu :nilai
		paraméter-url tambah-di-tungtung: konci-lulugu téks url-énkode + ['='] + nilai téks url-énkode.
	}.
	milik paraméter-url := ['?'] + ( paraméter-url gabungkeun: ['&'] ).
}.

URL nalika: ['hash:'] lakukeun: { :hash
	milik hash := ['#'] + hash url-énkode.
}.

