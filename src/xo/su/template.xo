
# ~ Simple template engine ~

>> Citakan := Obyek anyar.

Citakan nalika: ['anyar'] lakukeun: { <- diri anyar eusi: [''].
}.

Citakan nalika: ['eusi:'] lakukeun: { :eusi
	milik eusi := eusi. 
}.

Citakan nalika: ['anyar:'] lakukeun: { :eusi <- diri anyar eusi: eusi.
}.

Citakan nalika: ['potong:'] lakukeun: { :tanda
	>> tanda-awal := (['<!-- cut:%id% -->'] %id%: tanda).
	>> tanda-ahir := (['<!-- /cut:%id% -->'] %id%: tanda).
	>> bagian-bagian := milik eusi pisahkeun: tanda-awal.
	>> awalan := bagian-bagian kahiji.
	>> bagian-bagian2 := bagian-bagian pamungkas pisahkeun: tanda-ahir.
	>> ahiran := bagian-bagian2 pamungkas.
	>> bagian := bagian-bagian2 kahiji.
	>> sésa := awalan + ahiran.
	milik eusi := sésa. <- Citakan anyar: bagian.
	
}.

Citakan nalika: ['salin'] lakukeun: { <- diri anyar: diri téks salin.
}.
	
Citakan nalika: ['témpélkeun:di:'] lakukeun: { :cuplikan :id
	>> tanda-témpél := (['<!-- paste:%id% -->'] %id%: id).
	milik eusi ganti: tanda-témpél ku: ( cuplikan téks + tanda-témpél ).
}.

Citakan nalika: ['atur:nilai:'] lakukeun: { :slot :nilai
	milik eusi ganti: ['<!-- slot:'] + slot + [' -->'] ku: ( Server html-énkode: nilai ).
}.

Citakan nalika: ['atur:html:'] lakukeun: { :slot :html
	milik eusi ganti: ['<!-- slot:'] + slot + [' -->'] ku: html.
}.

Citakan nalika: ['jawab:jeung:'] lakukeun: { :slot :nilai
	diri atur: (slot tina: 0 panjang: (slot panjang - 1)) nilai: nilai.
}.

Citakan nalika: ['nl2br'] lakukeun: {
	milik eusi ganti: ['\n'] ku: ['<br>'].
}.

Citakan nalika: ['rapihkeun'] lakukeun: {
	milik eusi :=
		Pola
		anyar: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		cocog: milik eusi
		lakukeun: { <- ['']. }.
}.

Citakan nalika: ['rapihkeun-potongan'] lakukeun: {
	>> item := Daptar anyar.
	Pola
	anyar: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	cocog: milik eusi
	lakukeun: { :_ :bagian
		item tambah-di-tungtung: bagian ? 1.
	}.
	item unggal: { :_ :id
		milik eusi :=
			Pola anyar: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			cocog: milik eusi
			lakukeun: { <- ['']. }.
	 }.
}.

Citakan nalika: ['rapihkeun-spasi'] lakukeun: {
	milik eusi :=
		Pola
		anyar: ['\\s*\\n'],
		cocog: milik eusi
		lakukeun: { <- ['\n']. }.
	milik eusi :=
		Pola
		anyar: ['\\n[\\s\\t]+'],
		cocog: milik eusi
		lakukeun: { <- ['\n']. }.
}.

Citakan nalika: ['rapihkeun-sadayana'] lakukeun: {
	diri rapihkeun.
	diri rapihkeun-potongan.
	diri rapihkeun-spasi.
}.

Citakan nalika: ['téks'] lakukeun: { <- milik eusi.
}.
