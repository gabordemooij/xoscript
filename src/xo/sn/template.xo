
# ~ Simple template engine ~

>> Tembiricha := Chinhu nyowani.

Tembiricha kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani zviri-mukati: [''].
}.

Tembiricha kana-zvasvika: ['zviri-mukati:'] ita: { :zviri-mukati
	zvako zviri-mukati := zviri-mukati. 
}.

Tembiricha kana-zvasvika: ['nyowani:'] ita: { :zviri-mukati <- pachako nyowani zviri-mukati: zviri-mukati.
}.

Tembiricha kana-zvasvika: ['cheka:'] ita: { :chiratidzo
	>> chiratidzo-chekutanga := (['<!-- cut:%id% -->'] %id%: chiratidzo).
	>> chiratidzo-chekupedzisira := (['<!-- /cut:%id% -->'] %id%: chiratidzo).
	>> zvikamu-zvidiki := zvako zviri-mukati patsanura: chiratidzo-chekutanga.
	>> chivambo := zvikamu-zvidiki chekutanga.
	>> zvikamu-zvidiki2 := zvikamu-zvidiki chekupedzisira patsanura: chiratidzo-chekupedzisira.
	>> chinoteverwa := zvikamu-zvidiki2 chekupedzisira.
	>> chikamu-chidiki := zvikamu-zvidiki2 chekutanga.
	>> zvasara := chivambo + chinoteverwa.
	zvako zviri-mukati := zvasara. <- Tembiricha nyowani: chikamu-chidiki.
	
}.

Tembiricha kana-zvasvika: ['kopa'] ita: { <- pachako nyowani: pachako mavara-emashoko kopa.
}.
	
Tembiricha kana-zvasvika: ['namatidza:pa:'] ita: { :chidimburo :id
	>> chiratidzo-chekunamatidza := (['<!-- paste:%id% -->'] %id%: id).
	zvako zviri-mukati tsiva: chiratidzo-chekunamatidza na: ( chidimburo mavara-emashoko + chiratidzo-chekunamatidza ).
}.

Tembiricha kana-zvasvika: ['gadza:kukosha:'] ita: { :nzvimbo-yekuisa :kukosha
	zvako zviri-mukati tsiva: ['<!-- slot:'] + nzvimbo-yekuisa + [' -->'] na: ( Server html-isa-kodhi: kukosha ).
}.

Tembiricha kana-zvasvika: ['gadza:html:'] ita: { :nzvimbo-yekuisa :html
	zvako zviri-mukati tsiva: ['<!-- slot:'] + nzvimbo-yekuisa + [' -->'] na: html.
}.

Tembiricha kana-zvasvika: ['pindura:uye:'] ita: { :nzvimbo-yekuisa :kukosha
	pachako gadza: (nzvimbo-yekuisa kubva: 0 kureba: (nzvimbo-yekuisa kureba - 1)) kukosha: kukosha.
}.

Tembiricha kana-zvasvika: ['nl2br'] ita: {
	zvako zviri-mukati tsiva: ['\n'] na: ['<br>'].
}.

Tembiricha kana-zvasvika: ['ronga'] ita: {
	zvako zviri-mukati :=
		Pateni
		nyowani: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		kuenderana: zvako zviri-mukati
		ita: { <- ['']. }.
}.

Tembiricha kana-zvasvika: ['ronga-zvakachekwa'] ita: {
	>> zvinhu := Rondedzero nyowani.
	Pateni
	nyowani: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	kuenderana: zvako zviri-mukati
	ita: { :_ :chikamu-chidiki
		zvinhu wedzera-kumagumo: chikamu-chidiki ? 1.
	}.
	zvinhu chimwe-nechimwe: { :_ :id
		zvako zviri-mukati :=
			Pateni nyowani: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			kuenderana: zvako zviri-mukati
			ita: { <- ['']. }.
	 }.
}.

Tembiricha kana-zvasvika: ['ronga-nzvimbo'] ita: {
	zvako zviri-mukati :=
		Pateni
		nyowani: ['\\s*\\n'],
		kuenderana: zvako zviri-mukati
		ita: { <- ['\n']. }.
	zvako zviri-mukati :=
		Pateni
		nyowani: ['\\n[\\s\\t]+'],
		kuenderana: zvako zviri-mukati
		ita: { <- ['\n']. }.
}.

Tembiricha kana-zvasvika: ['ronga-zvese'] ita: {
	pachako ronga.
	pachako ronga-zvakachekwa.
	pachako ronga-nzvimbo.
}.

Tembiricha kana-zvasvika: ['mavara-emashoko'] ita: { <- zvako zviri-mukati.
}.
