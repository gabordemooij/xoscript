Chikumbiro-HTTP kana-zvasvika: ['HTTP-musoro:'] ita: { :kiyi <- Chirongwa gadziriso: kiyi.
}.

>> Musoro-weHTTP := Chinhu nyowani.

Musoro-weHTTP kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani gadzirira.
}.

Musoro-weHTTP kana-zvasvika: ['gadzirira'] ita: {
	zvako kiyi := Hapana.
	zvako kukosha := Hapana.
}.

Musoro-weHTTP kana-zvasvika: ['kiyi:kukosha:'] ita: { :kiyi :kukosha
	zvako kiyi := kiyi.
	zvako kukosha := kukosha.
}.

Musoro-weHTTP kana-zvasvika: ['kiyi'] ita: { <- zvako kiyi.
}.

Musoro-weHTTP kana-zvasvika: ['kukosha'] ita: { <- zvako kukosha.
}.


Musoro-weHTTP kana-zvasvika: ['mavara-emashoko'] ita: {
	>> mutsara := zvako kiyi + [': '] + zvako kukosha.
	mutsara tsiva: ['\r'] na: [''], tsiva: ['\n'] na: ['']. <- mutsara + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Gwaro-reWebhu := Chinhu nyowani.

Gwaro-reWebhu kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani gadzirira.
}.

Gwaro-reWebhu kana-zvasvika: ['gadzirira'] ita: {
	zvako misoro := Rondedzero nyowani.
	zvako id-yechikamu := Hapana.
	zvako maneja-wezvikamu := Chikamu-chefaira-renguva-pfupi nyowani.
	zvako data-yechikamu := Hapana.
	zvako yakachengeteka := Chokwadi.
	zvako saiti-imwe := ['Strict'].
	zvako misoro-yatumirwa := Nhema.
	zvako chikumbiro-http := Chikumbiro-HTTP nyowani.
}.

Gwaro-reWebhu kana-zvasvika: ['chikumbiro-http:'] ita: { :chikumbiro-http
	zvako chikumbiro-http := chikumbiro-http.
}. 

Gwaro-reWebhu kana-zvasvika: ['kuki-yechikamu-yakachengeteka:'] ita: { :yakachengeteka
	pachako ongorora-misoro.
	zvako yakachengeteka := yakachengeteka.
}.

Gwaro-reWebhu kana-zvasvika: ['kuki-yechikamu-saiti-imwe:'] ita: { :kukosha
	pachako ongorora-misoro.
	>> sarudzo := Rondedzero nyowani 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	sarudzo ane: kukosha, nhema: {
		basa-iri chikanganiso: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	zvako saiti-imwe := kukosha.
}.

Gwaro-reWebhu kana-zvasvika: ['musoro:'] ita: { :musoro
	pachako ongorora-misoro.
	zvako misoro wedzera-kumagumo: musoro.
}.

Gwaro-reWebhu kana-zvasvika: ['bvisa-misoro'] ita: {
	pachako ongorora-misoro.
	zvako misoro := Rondedzero nyowani.
}.

Gwaro-reWebhu kana-zvasvika: ['maneja-wezvikamu:'] ita: { :maneja
	pachako ongorora-misoro.
	zvako maneja-wezvikamu := maneja.
}.

Gwaro-reWebhu kana-zvasvika: ['maneja-wezvikamu'] ita: { <- zvako maneja-wezvikamu.
}.

Gwaro-reWebhu kana-zvasvika: ['ongorora-misoro'] ita: {
	zvako misoro-yatumirwa chokwadi: {
		basa-iri chikanganiso: ['Headers already sent to client.'].
	}.
}.

Gwaro-reWebhu kana-zvasvika: ['tanga-chikamu'] ita: {
	pachako ongorora-misoro.
	>> chikumbiro-http := zvako chikumbiro-http.
	>> id-yechikamu := chikumbiro-http cookie: ['xsid'].
	id-yechikamu Hapana? nhema: {
		(( Pateni nyowani: ['^[A-Za-z0-9]+\\z'], kuenderana: id-yechikamu ) = 0) chokwadi: {
			id-yechikamu := Hapana.
		}.
	}.
	id-yechikamu Hapana? chokwadi: {
		id-yechikamu := Dura-rakachengeteka token: 30.
		>> musoro-wechikamu := Musoro-weHTTP nyowani
		kiyi: ['Set-Cookie'] kukosha: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (zvako yakachengeteka ichi: ['Secure'] kana-icho: ['']),
		SSITE: (zvako saiti-imwe),
		XSID: id-yechikamu
		).
		zvako misoro wedzera-kumagumo: musoro-wechikamu.
	}.
	zvako data-yechikamu := zvako maneja-wezvikamu nokuda-kwe: id-yechikamu, kwidza. <- zvako data-yechikamu. # reference
}.

Gwaro-reWebhu kana-zvasvika: ['enda-ku:'] ita: { :kero
	pachako ongorora-misoro.
	pachako bvisa-misoro.
	zvako misoro
	wedzera-kumagumo: (
		Musoro-weHTTP nyowani
		kiyi: ['Status'] kukosha: ['303 See Other']
	),
	wedzera-kumagumo: (
		Musoro-weHTTP nyowani
		kiyi: ['Location'] kukosha: kero
	).
	pachako buditsa: ['Redirect'].
}.

Gwaro-reWebhu kana-zvasvika: ['paradza-chikamu'] ita: {
	pachako ongorora-misoro.
	>> chikumbiro-http := zvako chikumbiro-http.
	>> id-yechikamu := chikumbiro-http cookie: ['xsid'].
	id-yechikamu Hapana? nhema: {
		>> musoro-wechikamu := Musoro-weHTTP nyowani.
		>> nguva-yekupera := Nguva-chaiyo nyowani gore: 1970, chimiro: ['%a, %d %b %Y %H:%M:%S GMT'].
		musoro-wechikamu kiyi: ['Set-Cookie'] kukosha: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: nguva-yekupera,
			SEC: (zvako yakachengeteka ichi: ['Secure'] kana-icho: ['']),
			SSITE: (zvako saiti-imwe),
			XSID: id-yechikamu
		).
		zvako maneja-wezvikamu paradza.
		zvako misoro wedzera-kumagumo: musoro-wechikamu.
	}.
}.


Gwaro-reWebhu kana-zvasvika: ['tembiricha:'] ita: { :nzira-yefaira <- Tembiricha nyowani: (Faira nyowani: nzira-yefaira, verenga).
}.

Gwaro-reWebhu kana-zvasvika: ['buditsa:mhando:'] ita: { :mhedzisiro :mhando
	zvako misoro-yatumirwa nhema: {
		zvako data-yechikamu Hapana? nhema: {
			zvako maneja-wezvikamu chengeta: zvako data-yechikamu.
		}.
		zvako misoro wedzera-kumagumo: (
			Musoro-weHTTP nyowani
			kiyi: ['Content-type'] kukosha: mhando
		).
		zvako misoro chimwe-nechimwe: { :_ :musoro
			Zvabuda nyora: musoro.
		}.
		zvako misoro-yatumirwa := Chokwadi.
		Zvabuda nyora: ['\r\n'].
	}.
	Zvabuda nyora: mhedzisiro.
}.

Gwaro-reWebhu kana-zvasvika: ['pedza:mhando:'] ita: { :mhedzisiro :mhando
	zvako misoro-yatumirwa nhema: {
		zvako data-yechikamu Hapana? nhema: {
			zvako maneja-wezvikamu chengeta: zvako data-yechikamu.
		}.
		zvako misoro wedzera-kumagumo: (
			Musoro-weHTTP nyowani
			kiyi: ['Content-type'] kukosha: mhando
		).
		zvako misoro wedzera-kumagumo: (
			Musoro-weHTTP nyowani
			kiyi: ['Content-Length'] kukosha: mhedzisiro mavara-emashoko bytes
		).
		zvako misoro chimwe-nechimwe: { :_ :musoro
			Zvabuda nyora: musoro.
		}.
		zvako misoro-yatumirwa := Chokwadi.
		Zvabuda nyora: ['\r\n'].
	}.
	Zvabuda nyora: mhedzisiro.
}.

Gwaro-reWebhu kana-zvasvika: ['buditsa:'] ita: { :mhedzisiro
	pachako buditsa: mhedzisiro mhando: ['text/html; charset=utf-8'].
}.

Gwaro-reWebhu kana-zvasvika: ['pedza:'] ita: { :mhedzisiro
	pachako pedza: mhedzisiro mhando: ['text/html; charset=utf-8'].
}.

Gwaro-reWebhu kana-zvasvika: ['json:'] ita: { :mhedzisiro
	pachako buditsa: ( JSON jsonify: mhedzisiro ) mhando: ['application/json'].
}.

Gwaro-reWebhu kana-zvasvika: ['hazvina-kuwanikwa:'] ita: { :mhedzisiro
	pachako bvisa-misoro musoro: (
		Musoro-weHTTP nyowani kiyi: ['Status'] kukosha: ['404 Not Found']
	).
	pachako buditsa: mhedzisiro.
}.


# Interface

>> Chikamu := Chinhu nyowani.

Chikamu kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani gadzirira nokuda-kwe: Hapana.
}.

Chikamu kana-zvasvika: ['nokuda-kwe:'] ita: { :id
	zvako id := id.
}.

Chikamu kana-zvasvika: ['kwidza'] ita: {
	basa-iri chikanganiso: ['Not implemented.'].
}.

Chikamu kana-zvasvika: ['chengeta:'] ita: {
	basa-iri chikanganiso: ['Not implemented.'].
}.

Chikamu kana-zvasvika: ['paradza'] ita: {
	basa-iri chikanganiso: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Chikamu-chefaira-renguva-pfupi := Chikamu nyowani.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['gadzirira'] ita: {
	zvako kutanga-kwenzira := ['/tmp/sess-'].
}.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['chivambo-chenzira:'] ita: { :tambo-yemanyorerwo
	zvako kutanga-kwenzira := tambo-yemanyorerwo.
}.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['faira-rechikamu'] ita: { <- ( Faira nyowani: ( zvako kutanga-kwenzira + zvako id + ['.txt'] ) ).
}.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['kwidza'] ita: {
	>> faira-rechikamu := pachako faira-rechikamu.
	faira-rechikamu iripo nhema: {
		faira-rechikamu nyora: (Duramazwi nyowani kodhi).
	}. <- faira-rechikamu verenga chinhu.
}.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['chengeta:'] ita: { :data
	>> faira-rechikamu := pachako faira-rechikamu.
	faira-rechikamu iripo chokwadi: {
		faira-rechikamu nyora: data kodhi.
	}.
}.

Chikamu-chefaira-renguva-pfupi kana-zvasvika: ['paradza'] ita: {
	>> faira-rechikamu := pachako faira-rechikamu.
	faira-rechikamu iripo chokwadi: {
		faira-rechikamu bvisa.
	}.
}.


>> URL := Chinhu nyowani.

URL kana-zvasvika: ['gadzirira'] ita: {
	zvako purotokoru := ['https://'].
	zvako mugamuchiri := ['localhost'].
	zvako nzira-yefaira := [''].
	zvako maparamita-url := [''].
	zvako hash := [''].
}.

URL kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani gadzirira.
}.

URL kana-zvasvika: ['mavara-emashoko'] ita: { <- (
	zvako purotokoru +
	zvako mugamuchiri +
	zvako nzira-yefaira +
	zvako maparamita-url +
	zvako hash ).
}.

URL kana-zvasvika: ['purotokoru:'] ita: { :purotokoru
	((Rondedzero nyowani ; ['http'] ; ['https']) ane: purotokoru) chokwadi: {
		zvako purotokoru := purotokoru + ['://'].
	}, nhema: {
		basa-iri chikanganiso: ['Invalid protocol'].
	}.
}.

URL kana-zvasvika: ['mugamuchiri:'] ita: { :mugamuchiri
	#todo validate according to rfc
	zvako mugamuchiri := mugamuchiri.
}.

URL kana-zvasvika: ['nzira-yefaira:'] ita: { :nzira-yefaira
	zvako nzira-yefaira := ['/'] + nzira-yefaira url-isa-kodhi.
}.

URL kana-zvasvika: ['maparamita-url:'] ita: { :mepu
	>> maparamita-url := Rondedzero nyowani.
	mepu chimwe-nechimwe: { :kiyi :kukosha
		maparamita-url wedzera-kumagumo: kiyi mavara-emashoko url-isa-kodhi + ['='] + kukosha mavara-emashoko url-isa-kodhi.
	}.
	zvako maparamita-url := ['?'] + ( maparamita-url batanidza: ['&'] ).
}.

URL kana-zvasvika: ['hash:'] ita: { :hash
	zvako hash := ['#'] + hash url-isa-kodhi.
}.

