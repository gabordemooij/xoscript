>> Imeyili := Chinhu nyowani.

Imeyili kana-zvasvika: ['gadzirira'] ita: {
	zvako vagamuchiri := Rondedzero nyowani.
	zvako cc := Rondedzero nyowani.
	zvako bcc := Rondedzero nyowani.
	zvako mutumiri := Hapana.
	zvako zita-remutumiri := Hapana.
	zvako musoro-wenyaya := Hapana.
	zvako muviri := Hapana.
}.

Imeyili kana-zvasvika: ['nyowani'] ita: { <- pachako nyowani gadzirira.
}.

Imeyili kana-zvasvika: ['ku:'] ita: { :kunyora-runyorwa
	zvako vagamuchiri := kunyora-runyorwa.
}.
 
Imeyili kana-zvasvika: ['cc:'] ita: { :kunyora-runyorwa
	zvako cc := kunyora-runyorwa.
}.

Imeyili kana-zvasvika: ['bcc:'] ita: { :kunyora-runyorwa
	zvako bcc := kunyora-runyorwa.
}.

Imeyili kana-zvasvika: ['musoro-wenyaya:'] ita: { :musoro-wenyaya
	zvako musoro-wenyaya := musoro-wenyaya.
}.

Imeyili kana-zvasvika: ['mutumiri:zita:'] ita: { :mutumiri :zita
	zvako mutumiri := mutumiri.
	zvako zita-remutumiri := zita.
}.

Imeyili kana-zvasvika: ['muviri:'] ita: { :muviri
	zvako muviri := muviri.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeyili kana-zvasvika: ['musoro:'] ita: { :mutsara <- mutsara tsiva: ['\r'] na: [''], tsiva: ['\n'] na: [''].
}.

Imeyili kana-zvasvika: ['tumira'] ita: {
	>> f := Faira tempwrite: pachako gadzira.
	Chirongwa sisitimu: ['sendmail -t < '] + f nzira-yefaira, mutsara-mutsva.
}.

Imeyili kana-zvasvika: ['gadzira'] ita: {
	>> kutyora-mutsara := ['\r\n'].
	>> tambo-yemanyorerwo := [''].
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['From: '] + zvako zita-remutumiri + [' <'] + ( zvako mutumiri ) + ['>']) + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['To: '] + ( zvako vagamuchiri batanidza: [','] )) + kutyora-mutsara.
	zvako cc huwandu chokwadi: {
		tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Cc: '] + ( zvako cc batanidza: [','] )) + kutyora-mutsara.
	}.
	zvako bcc huwandu chokwadi: {
		tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Bcc: '] + ( zvako bcc batanidza: [','] )) + kutyora-mutsara.
	}.
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Subject: '] + zvako musoro-wenyaya) + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: zvako muviri.
	tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara. <- tambo-yemanyorerwo.
}.

>> Imeyili-HTML := Imeyili nyowani.

Imeyili-HTML kana-zvasvika: ['gadzirira'] ita: {
	pachako gadzirira.
	zvako zvakabatanidzwa := Rondedzero nyowani.
	zvako muganhu := Dura-rakachengeteka token: 40.
}.

Imeyili-HTML kana-zvasvika: ['batanidza-faira:'] ita: { :faira-rechikamu
	>> id := zvako zvakabatanidzwa huwandu.
	>> blob := faira-rechikamu blob.
	zvako zvakabatanidzwa wedzera-kumagumo: (
		Duramazwi nyowani
			faira-rechikamu: faira-rechikamu nzira-yefaira,
			mime: ['image/'] + (Server mimetype: faira-rechikamu nzira-yefaira),
			data: blob base64-isa-kodhi
	).
	blob sunungura. <- ['cid:attachment'] + id.
}.

Imeyili-HTML kana-zvasvika: ['gadzira'] ita: {
	>> kutyora-mutsara := ['\r\n'].
	>> tambo-yemanyorerwo := [''].
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['From: '] + zvako zita-remutumiri + [' <'] + ( zvako mutumiri ) + ['>']) + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['To: '] + ( zvako vagamuchiri batanidza: [','] )) + kutyora-mutsara.
	zvako cc huwandu chokwadi: {
		tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Cc: '] + ( zvako cc batanidza: [','] )) + kutyora-mutsara.
	}.
	zvako bcc huwandu chokwadi: {
		tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Bcc: '] + ( zvako bcc batanidza: [','] )) + kutyora-mutsara.
	}.
	tambo-yemanyorerwo wedzera-kumagumo: (pachako musoro: ['Subject: '] + zvako musoro-wenyaya) + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: ['MIME-Version: 1.0'] + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: ['Content-Type: multipart/related; boundary="'] + zvako muganhu + ['"; type=text/html'] + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: ['--'] + zvako muganhu + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: ['Content-Type: text/html; charset=UTF-8'] + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: ['Content-Transfer-Encoding: 7bit'] + kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
	tambo-yemanyorerwo wedzera-kumagumo: zvako muviri.
	tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
	zvako zvakabatanidzwa chimwe-nechimwe: { :id :ruzivo
		>> blob := ruzivo data.
		tambo-yemanyorerwo wedzera-kumagumo: ['--'] + zvako muganhu + kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: ['Content-Type: '] + ruzivo mime + kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: ['Content-Transfer-Encoding: base64'] + kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: ['Content-ID: <attachment'] + id + ['>'] + kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: ['Content-Disposition: inline; filename="'] + ruzivo faira-rechikamu + ['"'] + kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
		>> zvakanyanya := 76.
		>> kureba-kwemanyorerwo := blob kureba.
		>> zvimedu := (kureba-kwemanyorerwo / zvakanyanya) kwidza-nhamba.
		{ :i
			>> chimedu := blob kopa kubva: i * zvakanyanya kureba: zvakanyanya.
			tambo-yemanyorerwo wedzera-kumagumo: chimedu + kutyora-mutsara.
		} * zvimedu.
		tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
		tambo-yemanyorerwo wedzera-kumagumo: kutyora-mutsara.
	}.
	tambo-yemanyorerwo wedzera-kumagumo: ['--'] + zvako muganhu + ['--'] + kutyora-mutsara. <- tambo-yemanyorerwo.
}.
