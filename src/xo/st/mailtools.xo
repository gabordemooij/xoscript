>> Imeile := Ntho ncha.

Imeile ha-ho-fihla: ['lokisa'] etsa: {
	ea-hao baamoheli := Lethathamo ncha.
	ea-hao cc := Lethathamo ncha.
	ea-hao bcc := Lethathamo ncha.
	ea-hao moromeli := Letho.
	ea-hao lebitso-la-moromeli := Letho.
	ea-hao sehlooho := Letho.
	ea-hao mmele := Letho.
}.

Imeile ha-ho-fihla: ['ncha'] etsa: { <- uena ncha lokisa.
}.

Imeile ha-ho-fihla: ['ho:'] etsa: { :lethathamo-la-lintho
	ea-hao baamoheli := lethathamo-la-lintho.
}.
 
Imeile ha-ho-fihla: ['cc:'] etsa: { :lethathamo-la-lintho
	ea-hao cc := lethathamo-la-lintho.
}.

Imeile ha-ho-fihla: ['bcc:'] etsa: { :lethathamo-la-lintho
	ea-hao bcc := lethathamo-la-lintho.
}.

Imeile ha-ho-fihla: ['sehlooho:'] etsa: { :sehlooho
	ea-hao sehlooho := sehlooho.
}.

Imeile ha-ho-fihla: ['moromeli:lebitso:'] etsa: { :moromeli :lebitso
	ea-hao moromeli := moromeli.
	ea-hao lebitso-la-moromeli := lebitso.
}.

Imeile ha-ho-fihla: ['mmele:'] etsa: { :mmele
	ea-hao mmele := mmele.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeile ha-ho-fihla: ['hlooho:'] etsa: { :mola <- mola nkela-sebaka: ['\r'] ka: [''], nkela-sebaka: ['\n'] ka: [''].
}.

Imeile ha-ho-fihla: ['romela'] etsa: {
	>> f := Faele tempwrite: uena hlahisa.
	Lenaneo sistimi: ['sendmail -t < '] + f tsela-ea-faele, mola-o-mocha.
}.

Imeile ha-ho-fihla: ['hlahisa'] etsa: {
	>> khefutso-ea-mola := ['\r\n'].
	>> khoele-ea-mongolo := [''].
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['From: '] + ea-hao lebitso-la-moromeli + [' <'] + ( ea-hao moromeli ) + ['>']) + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['To: '] + ( ea-hao baamoheli kopanya: [','] )) + khefutso-ea-mola.
	ea-hao cc palo-ea-lintho nnete: {
		khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Cc: '] + ( ea-hao cc kopanya: [','] )) + khefutso-ea-mola.
	}.
	ea-hao bcc palo-ea-lintho nnete: {
		khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Bcc: '] + ( ea-hao bcc kopanya: [','] )) + khefutso-ea-mola.
	}.
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Subject: '] + ea-hao sehlooho) + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ea-hao mmele.
	khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola. <- khoele-ea-mongolo.
}.

>> Imeile-HTML := Imeile ncha.

Imeile-HTML ha-ho-fihla: ['lokisa'] etsa: {
	uena lokisa.
	ea-hao lihokelo := Lethathamo ncha.
	ea-hao moeli := Polokelo-e-sireletsehileng token: 40.
}.

Imeile-HTML ha-ho-fihla: ['hokela:'] etsa: { :faele-ea-seboka
	>> id := ea-hao lihokelo palo-ea-lintho.
	>> blob := faele-ea-seboka blob.
	ea-hao lihokelo eketsa-qetellong: (
		Bukantswe ncha
			faele-ea-seboka: faele-ea-seboka tsela-ea-faele,
			mime: ['image/'] + (Server mimetype: faele-ea-seboka tsela-ea-faele),
			data: blob base64-kenya-khoutu
	).
	blob lokolla. <- ['cid:attachment'] + id.
}.

Imeile-HTML ha-ho-fihla: ['hlahisa'] etsa: {
	>> khefutso-ea-mola := ['\r\n'].
	>> khoele-ea-mongolo := [''].
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['From: '] + ea-hao lebitso-la-moromeli + [' <'] + ( ea-hao moromeli ) + ['>']) + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['To: '] + ( ea-hao baamoheli kopanya: [','] )) + khefutso-ea-mola.
	ea-hao cc palo-ea-lintho nnete: {
		khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Cc: '] + ( ea-hao cc kopanya: [','] )) + khefutso-ea-mola.
	}.
	ea-hao bcc palo-ea-lintho nnete: {
		khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Bcc: '] + ( ea-hao bcc kopanya: [','] )) + khefutso-ea-mola.
	}.
	khoele-ea-mongolo eketsa-qetellong: (uena hlooho: ['Subject: '] + ea-hao sehlooho) + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ['MIME-Version: 1.0'] + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ['Content-Type: multipart/related; boundary="'] + ea-hao moeli + ['"; type=text/html'] + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ['--'] + ea-hao moeli + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ['Content-Type: text/html; charset=UTF-8'] + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ['Content-Transfer-Encoding: 7bit'] + khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
	khoele-ea-mongolo eketsa-qetellong: ea-hao mmele.
	khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
	ea-hao lihokelo e-ngoe-le-e-ngoe: { :id :tlhahisoleseling
		>> blob := tlhahisoleseling data.
		khoele-ea-mongolo eketsa-qetellong: ['--'] + ea-hao moeli + khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: ['Content-Type: '] + tlhahisoleseling mime + khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: ['Content-Transfer-Encoding: base64'] + khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: ['Content-ID: <attachment'] + id + ['>'] + khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: ['Content-Disposition: inline; filename="'] + tlhahisoleseling faele-ea-seboka + ['"'] + khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
		>> boholo-ka-ho-fetisisa := 76.
		>> bolelele-ba-mongolo := blob bolelele.
		>> likarolo-nyane := (bolelele-ba-mongolo / boholo-ka-ho-fetisisa) nyolla-palo.
		{ :i
			>> karolo-nyane := blob kopitsa ho-tloha: i * boholo-ka-ho-fetisisa bolelele: boholo-ka-ho-fetisisa.
			khoele-ea-mongolo eketsa-qetellong: karolo-nyane + khefutso-ea-mola.
		} * likarolo-nyane.
		khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
		khoele-ea-mongolo eketsa-qetellong: khefutso-ea-mola.
	}.
	khoele-ea-mongolo eketsa-qetellong: ['--'] + ea-hao moeli + ['--'] + khefutso-ea-mola. <- khoele-ea-mongolo.
}.
