
# ~ Simple template engine ~

>> Thempleite := Ntho ncha.

Thempleite ha-ho-fihla: ['ncha'] etsa: { <- uena ncha litaba: [''].
}.

Thempleite ha-ho-fihla: ['litaba:'] etsa: { :litaba
	ea-hao litaba := litaba. 
}.

Thempleite ha-ho-fihla: ['ncha:'] etsa: { :litaba <- uena ncha litaba: litaba.
}.

Thempleite ha-ho-fihla: ['khaola:'] etsa: { :letšoao
	>> letšoao-la-qalo := (['<!-- cut:%id% -->'] %id%: letšoao).
	>> letšoao-la-qetello := (['<!-- /cut:%id% -->'] %id%: letšoao).
	>> likarolo := ea-hao litaba arola: letšoao-la-qalo.
	>> selelekela := likarolo ea-pele.
	>> likarolo2 := likarolo ea-ho-qetela arola: letšoao-la-qetello.
	>> sehlomathiso := likarolo2 ea-ho-qetela.
	>> karolo := likarolo2 ea-pele.
	>> tse-setseng := selelekela + sehlomathiso.
	ea-hao litaba := tse-setseng. <- Thempleite ncha: karolo.
	
}.

Thempleite ha-ho-fihla: ['kopitsa'] etsa: { <- uena ncha: uena mongolo kopitsa.
}.
	
Thempleite ha-ho-fihla: ['manehela:sebakeng:'] etsa: { :qotso :id
	>> letšoao-la-manehelo := (['<!-- paste:%id% -->'] %id%: id).
	ea-hao litaba nkela-sebaka: letšoao-la-manehelo ka: ( qotso mongolo + letšoao-la-manehelo ).
}.

Thempleite ha-ho-fihla: ['beha:boleng:'] etsa: { :sebaka :boleng
	ea-hao litaba nkela-sebaka: ['<!-- slot:'] + sebaka + [' -->'] ka: ( Server html-kenya-khoutu: boleng ).
}.

Thempleite ha-ho-fihla: ['beha:html:'] etsa: { :sebaka :html
	ea-hao litaba nkela-sebaka: ['<!-- slot:'] + sebaka + [' -->'] ka: html.
}.

Thempleite ha-ho-fihla: ['araba:le:'] etsa: { :sebaka :boleng
	uena beha: (sebaka ho-tloha: 0 bolelele: (sebaka bolelele - 1)) boleng: boleng.
}.

Thempleite ha-ho-fihla: ['nl2br'] etsa: {
	ea-hao litaba nkela-sebaka: ['\n'] ka: ['<br>'].
}.

Thempleite ha-ho-fihla: ['hlophisa'] etsa: {
	ea-hao litaba :=
		Paterone
		ncha: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		tumellano: ea-hao litaba
		etsa: { <- ['']. }.
}.

Thempleite ha-ho-fihla: ['hlophisa-tse-khaotsoeng'] etsa: {
	>> lintho := Lethathamo ncha.
	Paterone
	ncha: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	tumellano: ea-hao litaba
	etsa: { :_ :karolo
		lintho eketsa-qetellong: karolo ? 1.
	}.
	lintho e-ngoe-le-e-ngoe: { :_ :id
		ea-hao litaba :=
			Paterone ncha: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			tumellano: ea-hao litaba
			etsa: { <- ['']. }.
	 }.
}.

Thempleite ha-ho-fihla: ['hlophisa-libaka'] etsa: {
	ea-hao litaba :=
		Paterone
		ncha: ['\\s*\\n'],
		tumellano: ea-hao litaba
		etsa: { <- ['\n']. }.
	ea-hao litaba :=
		Paterone
		ncha: ['\\n[\\s\\t]+'],
		tumellano: ea-hao litaba
		etsa: { <- ['\n']. }.
}.

Thempleite ha-ho-fihla: ['hlophisa-tsohle'] etsa: {
	uena hlophisa.
	uena hlophisa-tse-khaotsoeng.
	uena hlophisa-libaka.
}.

Thempleite ha-ho-fihla: ['mongolo'] etsa: { <- ea-hao litaba.
}.
