Kopo-HTTP ha-ho-fihla: ['HTTP-hlooho:'] etsa: { :senotlolo <- Lenaneo tlhophiso: senotlolo.
}.

>> Hlooho-ea-HTTP := Ntho ncha.

Hlooho-ea-HTTP ha-ho-fihla: ['ncha'] etsa: { <- uena ncha lokisa.
}.

Hlooho-ea-HTTP ha-ho-fihla: ['lokisa'] etsa: {
	ea-hao senotlolo := Letho.
	ea-hao boleng := Letho.
}.

Hlooho-ea-HTTP ha-ho-fihla: ['senotlolo:boleng:'] etsa: { :senotlolo :boleng
	ea-hao senotlolo := senotlolo.
	ea-hao boleng := boleng.
}.

Hlooho-ea-HTTP ha-ho-fihla: ['senotlolo'] etsa: { <- ea-hao senotlolo.
}.

Hlooho-ea-HTTP ha-ho-fihla: ['boleng'] etsa: { <- ea-hao boleng.
}.


Hlooho-ea-HTTP ha-ho-fihla: ['mongolo'] etsa: {
	>> mola := ea-hao senotlolo + [': '] + ea-hao boleng.
	mola nkela-sebaka: ['\r'] ka: [''], nkela-sebaka: ['\n'] ka: ['']. <- mola + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Tokomane-ea-Webo := Ntho ncha.

Tokomane-ea-Webo ha-ho-fihla: ['ncha'] etsa: { <- uena ncha lokisa.
}.

Tokomane-ea-Webo ha-ho-fihla: ['lokisa'] etsa: {
	ea-hao lihlooho := Lethathamo ncha.
	ea-hao id-ea-seboka := Letho.
	ea-hao mookameli-oa-liboka := Seboka-sa-faele-ea-nakoana ncha.
	ea-hao data-ea-seboka := Letho.
	ea-hao sireletsehileng := Nnete.
	ea-hao sebaka-se-le-seng := ['Strict'].
	ea-hao lihlooho-li-rometsoe := Leshano.
	ea-hao kopo-http := Kopo-HTTP ncha.
}.

Tokomane-ea-Webo ha-ho-fihla: ['kopo-http:'] etsa: { :kopo-http
	ea-hao kopo-http := kopo-http.
}. 

Tokomane-ea-Webo ha-ho-fihla: ['khuki-ea-seboka-e-sireletsehileng:'] etsa: { :sireletsehileng
	uena hlahloba-lihlooho.
	ea-hao sireletsehileng := sireletsehileng.
}.

Tokomane-ea-Webo ha-ho-fihla: ['khuki-ea-seboka-sebaka-se-le-seng:'] etsa: { :boleng
	uena hlahloba-lihlooho.
	>> likhetho := Lethathamo ncha 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	likhetho e-na-le: boleng, leshano: {
		mosebetsi-ona phoso: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ea-hao sebaka-se-le-seng := boleng.
}.

Tokomane-ea-Webo ha-ho-fihla: ['hlooho:'] etsa: { :hlooho
	uena hlahloba-lihlooho.
	ea-hao lihlooho eketsa-qetellong: hlooho.
}.

Tokomane-ea-Webo ha-ho-fihla: ['tlosa-lihlooho'] etsa: {
	uena hlahloba-lihlooho.
	ea-hao lihlooho := Lethathamo ncha.
}.

Tokomane-ea-Webo ha-ho-fihla: ['mookameli-oa-liboka:'] etsa: { :mookameli
	uena hlahloba-lihlooho.
	ea-hao mookameli-oa-liboka := mookameli.
}.

Tokomane-ea-Webo ha-ho-fihla: ['mookameli-oa-liboka'] etsa: { <- ea-hao mookameli-oa-liboka.
}.

Tokomane-ea-Webo ha-ho-fihla: ['hlahloba-lihlooho'] etsa: {
	ea-hao lihlooho-li-rometsoe nnete: {
		mosebetsi-ona phoso: ['Headers already sent to client.'].
	}.
}.

Tokomane-ea-Webo ha-ho-fihla: ['qala-seboka'] etsa: {
	uena hlahloba-lihlooho.
	>> kopo-http := ea-hao kopo-http.
	>> id-ea-seboka := kopo-http cookie: ['xsid'].
	id-ea-seboka Letho? leshano: {
		(( Paterone ncha: ['^[A-Za-z0-9]+\\z'], tumellano: id-ea-seboka ) = 0) nnete: {
			id-ea-seboka := Letho.
		}.
	}.
	id-ea-seboka Letho? nnete: {
		id-ea-seboka := Polokelo-e-sireletsehileng token: 30.
		>> hlooho-ea-seboka := Hlooho-ea-HTTP ncha
		senotlolo: ['Set-Cookie'] boleng: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ea-hao sireletsehileng ena: ['Secure'] kapa-eane: ['']),
		SSITE: (ea-hao sebaka-se-le-seng),
		XSID: id-ea-seboka
		).
		ea-hao lihlooho eketsa-qetellong: hlooho-ea-seboka.
	}.
	ea-hao data-ea-seboka := ea-hao mookameli-oa-liboka bakeng-sa: id-ea-seboka, kenya. <- ea-hao data-ea-seboka. # reference
}.

Tokomane-ea-Webo ha-ho-fihla: ['eya-ho:'] etsa: { :aterese
	uena hlahloba-lihlooho.
	uena tlosa-lihlooho.
	ea-hao lihlooho
	eketsa-qetellong: (
		Hlooho-ea-HTTP ncha
		senotlolo: ['Status'] boleng: ['303 See Other']
	),
	eketsa-qetellong: (
		Hlooho-ea-HTTP ncha
		senotlolo: ['Location'] boleng: aterese
	).
	uena ntša: ['Redirect'].
}.

Tokomane-ea-Webo ha-ho-fihla: ['senya-seboka'] etsa: {
	uena hlahloba-lihlooho.
	>> kopo-http := ea-hao kopo-http.
	>> id-ea-seboka := kopo-http cookie: ['xsid'].
	id-ea-seboka Letho? leshano: {
		>> hlooho-ea-seboka := Hlooho-ea-HTTP ncha.
		>> nako-ea-ho-fela := Motsotso-nako ncha selemo: 1970, sebopeho: ['%a, %d %b %Y %H:%M:%S GMT'].
		hlooho-ea-seboka senotlolo: ['Set-Cookie'] boleng: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: nako-ea-ho-fela,
			SEC: (ea-hao sireletsehileng ena: ['Secure'] kapa-eane: ['']),
			SSITE: (ea-hao sebaka-se-le-seng),
			XSID: id-ea-seboka
		).
		ea-hao mookameli-oa-liboka senya.
		ea-hao lihlooho eketsa-qetellong: hlooho-ea-seboka.
	}.
}.


Tokomane-ea-Webo ha-ho-fihla: ['thempleite:'] etsa: { :tsela-ea-faele <- Thempleite ncha: (Faele ncha: tsela-ea-faele, bala).
}.

Tokomane-ea-Webo ha-ho-fihla: ['ntša:mofuta:'] etsa: { :sephetho :mofuta
	ea-hao lihlooho-li-rometsoe leshano: {
		ea-hao data-ea-seboka Letho? leshano: {
			ea-hao mookameli-oa-liboka boloka: ea-hao data-ea-seboka.
		}.
		ea-hao lihlooho eketsa-qetellong: (
			Hlooho-ea-HTTP ncha
			senotlolo: ['Content-type'] boleng: mofuta
		).
		ea-hao lihlooho e-ngoe-le-e-ngoe: { :_ :hlooho
			Sephetho ngola: hlooho.
		}.
		ea-hao lihlooho-li-rometsoe := Nnete.
		Sephetho ngola: ['\r\n'].
	}.
	Sephetho ngola: sephetho.
}.

Tokomane-ea-Webo ha-ho-fihla: ['qeta:mofuta:'] etsa: { :sephetho :mofuta
	ea-hao lihlooho-li-rometsoe leshano: {
		ea-hao data-ea-seboka Letho? leshano: {
			ea-hao mookameli-oa-liboka boloka: ea-hao data-ea-seboka.
		}.
		ea-hao lihlooho eketsa-qetellong: (
			Hlooho-ea-HTTP ncha
			senotlolo: ['Content-type'] boleng: mofuta
		).
		ea-hao lihlooho eketsa-qetellong: (
			Hlooho-ea-HTTP ncha
			senotlolo: ['Content-Length'] boleng: sephetho mongolo bytes
		).
		ea-hao lihlooho e-ngoe-le-e-ngoe: { :_ :hlooho
			Sephetho ngola: hlooho.
		}.
		ea-hao lihlooho-li-rometsoe := Nnete.
		Sephetho ngola: ['\r\n'].
	}.
	Sephetho ngola: sephetho.
}.

Tokomane-ea-Webo ha-ho-fihla: ['ntša:'] etsa: { :sephetho
	uena ntša: sephetho mofuta: ['text/html; charset=utf-8'].
}.

Tokomane-ea-Webo ha-ho-fihla: ['qeta:'] etsa: { :sephetho
	uena qeta: sephetho mofuta: ['text/html; charset=utf-8'].
}.

Tokomane-ea-Webo ha-ho-fihla: ['json:'] etsa: { :sephetho
	uena ntša: ( JSON jsonify: sephetho ) mofuta: ['application/json'].
}.

Tokomane-ea-Webo ha-ho-fihla: ['ha-e-fumanehe:'] etsa: { :sephetho
	uena tlosa-lihlooho hlooho: (
		Hlooho-ea-HTTP ncha senotlolo: ['Status'] boleng: ['404 Not Found']
	).
	uena ntša: sephetho.
}.


# Interface

>> Seboka := Ntho ncha.

Seboka ha-ho-fihla: ['ncha'] etsa: { <- uena ncha lokisa bakeng-sa: Letho.
}.

Seboka ha-ho-fihla: ['bakeng-sa:'] etsa: { :id
	ea-hao id := id.
}.

Seboka ha-ho-fihla: ['kenya'] etsa: {
	mosebetsi-ona phoso: ['Not implemented.'].
}.

Seboka ha-ho-fihla: ['boloka:'] etsa: {
	mosebetsi-ona phoso: ['Not implemented.'].
}.

Seboka ha-ho-fihla: ['senya'] etsa: {
	mosebetsi-ona phoso: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seboka-sa-faele-ea-nakoana := Seboka ncha.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['lokisa'] etsa: {
	ea-hao qalo-ea-tsela := ['/tmp/sess-'].
}.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['selelekela-sa-tsela:'] etsa: { :khoele-ea-mongolo
	ea-hao qalo-ea-tsela := khoele-ea-mongolo.
}.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['faele-ea-seboka'] etsa: { <- ( Faele ncha: ( ea-hao qalo-ea-tsela + ea-hao id + ['.txt'] ) ).
}.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['kenya'] etsa: {
	>> faele-ea-seboka := uena faele-ea-seboka.
	faele-ea-seboka e-teng leshano: {
		faele-ea-seboka ngola: (Bukantswe ncha khoutu).
	}. <- faele-ea-seboka bala ntho.
}.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['boloka:'] etsa: { :data
	>> faele-ea-seboka := uena faele-ea-seboka.
	faele-ea-seboka e-teng nnete: {
		faele-ea-seboka ngola: data khoutu.
	}.
}.

Seboka-sa-faele-ea-nakoana ha-ho-fihla: ['senya'] etsa: {
	>> faele-ea-seboka := uena faele-ea-seboka.
	faele-ea-seboka e-teng nnete: {
		faele-ea-seboka hlakola.
	}.
}.


>> URL := Ntho ncha.

URL ha-ho-fihla: ['lokisa'] etsa: {
	ea-hao protocol := ['https://'].
	ea-hao moamoheli := ['localhost'].
	ea-hao tsela-ea-faele := [''].
	ea-hao liparamente-tsa-url := [''].
	ea-hao hash := [''].
}.

URL ha-ho-fihla: ['ncha'] etsa: { <- uena ncha lokisa.
}.

URL ha-ho-fihla: ['mongolo'] etsa: { <- (
	ea-hao protocol +
	ea-hao moamoheli +
	ea-hao tsela-ea-faele +
	ea-hao liparamente-tsa-url +
	ea-hao hash ).
}.

URL ha-ho-fihla: ['protocol:'] etsa: { :protocol
	((Lethathamo ncha ; ['http'] ; ['https']) e-na-le: protocol) nnete: {
		ea-hao protocol := protocol + ['://'].
	}, leshano: {
		mosebetsi-ona phoso: ['Invalid protocol'].
	}.
}.

URL ha-ho-fihla: ['moamoheli:'] etsa: { :moamoheli
	#todo validate according to rfc
	ea-hao moamoheli := moamoheli.
}.

URL ha-ho-fihla: ['tsela-ea-faele:'] etsa: { :tsela-ea-faele
	ea-hao tsela-ea-faele := ['/'] + tsela-ea-faele url-kenya-khoutu.
}.

URL ha-ho-fihla: ['liparamente-tsa-url:'] etsa: { :ho-etsa-mmapa
	>> liparamente-tsa-url := Lethathamo ncha.
	ho-etsa-mmapa e-ngoe-le-e-ngoe: { :senotlolo :boleng
		liparamente-tsa-url eketsa-qetellong: senotlolo mongolo url-kenya-khoutu + ['='] + boleng mongolo url-kenya-khoutu.
	}.
	ea-hao liparamente-tsa-url := ['?'] + ( liparamente-tsa-url kopanya: ['&'] ).
}.

URL ha-ho-fihla: ['hash:'] etsa: { :hash
	ea-hao hash := ['#'] + hash url-kenya-khoutu.
}.

