درخواست-HTTP جب: ['HTTP-ہیڈر:'] کرو: { :کلید <- پروگرام ترتیب-قدر: کلید.
}.

>> ہیڈر-HTTP := آبجیکٹ نیا.

ہیڈر-HTTP جب: ['نیا'] کرو: { <- خود نیا ابتدا-کریں.
}.

ہیڈر-HTTP جب: ['ابتدا-کریں'] کرو: {
	اپنا کلید := خالی.
	اپنا قدر := خالی.
}.

ہیڈر-HTTP جب: ['کلید:قدر:'] کرو: { :کلید :قدر
	اپنا کلید := کلید.
	اپنا قدر := قدر.
}.

ہیڈر-HTTP جب: ['کلید'] کرو: { <- اپنا کلید.
}.

ہیڈر-HTTP جب: ['قدر'] کرو: { <- اپنا قدر.
}.


ہیڈر-HTTP جب: ['بطور-متن'] کرو: {
	>> سطر := اپنا کلید + [': '] + اپنا قدر.
	سطر بدلو: ['\r'] سے: [''], بدلو: ['\n'] سے: ['']. <- سطر + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> ویب-دستاویز := آبجیکٹ نیا.

ویب-دستاویز جب: ['نیا'] کرو: { <- خود نیا ابتدا-کریں.
}.

ویب-دستاویز جب: ['ابتدا-کریں'] کرو: {
	اپنا ہیڈرز := لسٹ نیا.
	اپنا سیشن-شناخت := خالی.
	اپنا سیشن-منتظم := عارضی-فائل-سیشن نیا.
	اپنا سیشن-ڈیٹا := خالی.
	اپنا محفوظ := سچ.
	اپنا ایک-ہی-سائٹ := ['Strict'].
	اپنا ہیڈرز-بھیجے-گئے := جھوٹ.
	اپنا درخواست-http := درخواست-HTTP نیا.
}.

ویب-دستاویز جب: ['درخواست-http:'] کرو: { :درخواست-http
	اپنا درخواست-http := درخواست-http.
}. 

ویب-دستاویز جب: ['محفوظ-سیشن-کوکی:'] کرو: { :محفوظ
	خود ہیڈر-جانچیں.
	اپنا محفوظ := محفوظ.
}.

ویب-دستاویز جب: ['سیشن-کوکی-ایک-ہی-سائٹ:'] کرو: { :قدر
	خود ہیڈر-جانچیں.
	>> اختیارات := لسٹ نیا 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	اختیارات رکھتا-ہے: قدر, اگر-جھوٹ: {
		یہ-کام خرابی: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	اپنا ایک-ہی-سائٹ := قدر.
}.

ویب-دستاویز جب: ['ہیڈر:'] کرو: { :ہیڈر
	خود ہیڈر-جانچیں.
	اپنا ہیڈرز آخر-میں-جوڑو: ہیڈر.
}.

ویب-دستاویز جب: ['ہیڈر-خالی-کریں'] کرو: {
	خود ہیڈر-جانچیں.
	اپنا ہیڈرز := لسٹ نیا.
}.

ویب-دستاویز جب: ['سیشن-منتظم:'] کرو: { :منتظم
	خود ہیڈر-جانچیں.
	اپنا سیشن-منتظم := منتظم.
}.

ویب-دستاویز جب: ['سیشن-منتظم'] کرو: { <- اپنا سیشن-منتظم.
}.

ویب-دستاویز جب: ['ہیڈر-جانچیں'] کرو: {
	اپنا ہیڈرز-بھیجے-گئے اگر-سچ: {
		یہ-کام خرابی: ['Headers already sent to client.'].
	}.
}.

ویب-دستاویز جب: ['سیشن-شروع-کریں'] کرو: {
	خود ہیڈر-جانچیں.
	>> درخواست-http := اپنا درخواست-http.
	>> سیشن-شناخت := درخواست-http cookie: ['xsid'].
	سیشن-شناخت خالی? اگر-جھوٹ: {
		(( نمونہ نیا: ['^[A-Za-z0-9]+\\z'], مطابقت: سیشن-شناخت ) = 0) اگر-سچ: {
			سیشن-شناخت := خالی.
		}.
	}.
	سیشن-شناخت خالی? اگر-سچ: {
		سیشن-شناخت := تجوری ٹوکن: 30.
		>> سیشن-ہیڈر := ہیڈر-HTTP نیا
		کلید: ['Set-Cookie'] قدر: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (اپنا محفوظ یہ: ['Secure'] ورنہ-وہ: ['']),
		SSITE: (اپنا ایک-ہی-سائٹ),
		XSID: سیشن-شناخت
		).
		اپنا ہیڈرز آخر-میں-جوڑو: سیشن-ہیڈر.
	}.
	اپنا سیشن-ڈیٹا := اپنا سیشن-منتظم کے-لیے: سیشن-شناخت, لوڈ-کریں. <- اپنا سیشن-ڈیٹا. # reference
}.

ویب-دستاویز جب: ['جائیں:'] کرو: { :پتہ
	خود ہیڈر-جانچیں.
	خود ہیڈر-خالی-کریں.
	اپنا ہیڈرز
	آخر-میں-جوڑو: (
		ہیڈر-HTTP نیا
		کلید: ['Status'] قدر: ['303 See Other']
	),
	آخر-میں-جوڑو: (
		ہیڈر-HTTP نیا
		کلید: ['Location'] قدر: پتہ
	).
	خود آؤٹ-پٹ-کریں: ['Redirect'].
}.

ویب-دستاویز جب: ['سیشن-تباہ-کریں'] کرو: {
	خود ہیڈر-جانچیں.
	>> درخواست-http := اپنا درخواست-http.
	>> سیشن-شناخت := درخواست-http cookie: ['xsid'].
	سیشن-شناخت خالی? اگر-جھوٹ: {
		>> سیشن-ہیڈر := ہیڈر-HTTP نیا.
		>> وقت-اختتام := لمحہ نیا سال: 1970, بوضع: ['%a, %d %b %Y %H:%M:%S GMT'].
		سیشن-ہیڈر کلید: ['Set-Cookie'] قدر: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: وقت-اختتام,
			SEC: (اپنا محفوظ یہ: ['Secure'] ورنہ-وہ: ['']),
			SSITE: (اپنا ایک-ہی-سائٹ),
			XSID: سیشن-شناخت
		).
		اپنا سیشن-منتظم تباہ-کریں.
		اپنا ہیڈرز آخر-میں-جوڑو: سیشن-ہیڈر.
	}.
}.


ویب-دستاویز جب: ['سانچہ:'] کرو: { :فائل-راستہ <- سانچہ نیا: (فائل نیا: فائل-راستہ, پڑھو).
}.

ویب-دستاویز جب: ['آؤٹ-پٹ-کریں:قسم:'] کرو: { :نتیجہ :قسم
	اپنا ہیڈرز-بھیجے-گئے اگر-جھوٹ: {
		اپنا سیشن-ڈیٹا خالی? اگر-جھوٹ: {
			اپنا سیشن-منتظم محفوظ-کریں: اپنا سیشن-ڈیٹا.
		}.
		اپنا ہیڈرز آخر-میں-جوڑو: (
			ہیڈر-HTTP نیا
			کلید: ['Content-type'] قدر: قسم
		).
		اپنا ہیڈرز ہر-ایک: { :_ :ہیڈر
			آؤٹ-پٹ لکھو: ہیڈر.
		}.
		اپنا ہیڈرز-بھیجے-گئے := سچ.
		آؤٹ-پٹ لکھو: ['\r\n'].
	}.
	آؤٹ-پٹ لکھو: نتیجہ.
}.

ویب-دستاویز جب: ['مکمل-کریں:قسم:'] کرو: { :نتیجہ :قسم
	اپنا ہیڈرز-بھیجے-گئے اگر-جھوٹ: {
		اپنا سیشن-ڈیٹا خالی? اگر-جھوٹ: {
			اپنا سیشن-منتظم محفوظ-کریں: اپنا سیشن-ڈیٹا.
		}.
		اپنا ہیڈرز آخر-میں-جوڑو: (
			ہیڈر-HTTP نیا
			کلید: ['Content-type'] قدر: قسم
		).
		اپنا ہیڈرز آخر-میں-جوڑو: (
			ہیڈر-HTTP نیا
			کلید: ['Content-Length'] قدر: نتیجہ بطور-متن بائٹس
		).
		اپنا ہیڈرز ہر-ایک: { :_ :ہیڈر
			آؤٹ-پٹ لکھو: ہیڈر.
		}.
		اپنا ہیڈرز-بھیجے-گئے := سچ.
		آؤٹ-پٹ لکھو: ['\r\n'].
	}.
	آؤٹ-پٹ لکھو: نتیجہ.
}.

ویب-دستاویز جب: ['آؤٹ-پٹ-کریں:'] کرو: { :نتیجہ
	خود آؤٹ-پٹ-کریں: نتیجہ قسم: ['text/html; charset=utf-8'].
}.

ویب-دستاویز جب: ['مکمل-کریں:'] کرو: { :نتیجہ
	خود مکمل-کریں: نتیجہ قسم: ['text/html; charset=utf-8'].
}.

ویب-دستاویز جب: ['json:'] کرو: { :نتیجہ
	خود آؤٹ-پٹ-کریں: ( JSON jsonify: نتیجہ ) قسم: ['application/json'].
}.

ویب-دستاویز جب: ['نہیں-ملا:'] کرو: { :نتیجہ
	خود ہیڈر-خالی-کریں ہیڈر: (
		ہیڈر-HTTP نیا کلید: ['Status'] قدر: ['404 Not Found']
	).
	خود آؤٹ-پٹ-کریں: نتیجہ.
}.


# Interface

>> سیشن := آبجیکٹ نیا.

سیشن جب: ['نیا'] کرو: { <- خود نیا ابتدا-کریں کے-لیے: خالی.
}.

سیشن جب: ['کے-لیے:'] کرو: { :id
	اپنا id := id.
}.

سیشن جب: ['لوڈ-کریں'] کرو: {
	یہ-کام خرابی: ['Not implemented.'].
}.

سیشن جب: ['محفوظ-کریں:'] کرو: {
	یہ-کام خرابی: ['Not implemented.'].
}.

سیشن جب: ['تباہ-کریں'] کرو: {
	یہ-کام خرابی: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> عارضی-فائل-سیشن := سیشن نیا.

عارضی-فائل-سیشن جب: ['ابتدا-کریں'] کرو: {
	اپنا راستہ-آغاز := ['/tmp/sess-'].
}.

عارضی-فائل-سیشن جب: ['راستہ-سابقہ:'] کرو: { :متنی-لڑی
	اپنا راستہ-آغاز := متنی-لڑی.
}.

عارضی-فائل-سیشن جب: ['سیشن-فائل'] کرو: { <- ( فائل نیا: ( اپنا راستہ-آغاز + اپنا id + ['.txt'] ) ).
}.

عارضی-فائل-سیشن جب: ['لوڈ-کریں'] کرو: {
	>> سیشن-فائل := خود سیشن-فائل.
	سیشن-فائل موجود اگر-جھوٹ: {
		سیشن-فائل لکھو: (لغت نیا کوڈ).
	}. <- سیشن-فائل پڑھو بطور-آبجیکٹ.
}.

عارضی-فائل-سیشن جب: ['محفوظ-کریں:'] کرو: { :ڈیٹا
	>> سیشن-فائل := خود سیشن-فائل.
	سیشن-فائل موجود اگر-سچ: {
		سیشن-فائل لکھو: ڈیٹا کوڈ.
	}.
}.

عارضی-فائل-سیشن جب: ['تباہ-کریں'] کرو: {
	>> سیشن-فائل := خود سیشن-فائل.
	سیشن-فائل موجود اگر-سچ: {
		سیشن-فائل مٹاؤ.
	}.
}.


>> URL := آبجیکٹ نیا.

URL جب: ['ابتدا-کریں'] کرو: {
	اپنا پروٹوکول := ['https://'].
	اپنا میزبان := ['localhost'].
	اپنا فائل-راستہ := [''].
	اپنا url-پیرامیٹرز := [''].
	اپنا hash := [''].
}.

URL جب: ['نیا'] کرو: { <- خود نیا ابتدا-کریں.
}.

URL جب: ['بطور-متن'] کرو: { <- (
	اپنا پروٹوکول +
	اپنا میزبان +
	اپنا فائل-راستہ +
	اپنا url-پیرامیٹرز +
	اپنا hash ).
}.

URL جب: ['پروٹوکول:'] کرو: { :پروٹوکول
	((لسٹ نیا ; ['http'] ; ['https']) رکھتا-ہے: پروٹوکول) اگر-سچ: {
		اپنا پروٹوکول := پروٹوکول + ['://'].
	}, اگر-جھوٹ: {
		یہ-کام خرابی: ['Invalid protocol'].
	}.
}.

URL جب: ['میزبان:'] کرو: { :میزبان
	#todo validate according to rfc
	اپنا میزبان := میزبان.
}.

URL جب: ['فائل-راستہ:'] کرو: { :فائل-راستہ
	اپنا فائل-راستہ := ['/'] + فائل-راستہ url-انکوڈ.
}.

URL جب: ['url-پیرامیٹرز:'] کرو: { :نقشہ-بندی
	>> url-پیرامیٹرز := لسٹ نیا.
	نقشہ-بندی ہر-ایک: { :کلید :قدر
		url-پیرامیٹرز آخر-میں-جوڑو: کلید بطور-متن url-انکوڈ + ['='] + قدر بطور-متن url-انکوڈ.
	}.
	اپنا url-پیرامیٹرز := ['?'] + ( url-پیرامیٹرز جوڑو: ['&'] ).
}.

URL جب: ['ہیش:'] کرو: { :hash
	اپنا hash := ['#'] + hash url-انکوڈ.
}.

