>> ای-میل := آبجیکٹ نیا.

ای-میل جب: ['ابتدا-کریں'] کرو: {
	اپنا وصول-کنندگان := لسٹ نیا.
	اپنا cc := لسٹ نیا.
	اپنا bcc := لسٹ نیا.
	اپنا بھیجنے-والا := خالی.
	اپنا بھیجنے-والے-کا-نام := خالی.
	اپنا موضوع := خالی.
	اپنا متن-خط := خالی.
}.

ای-میل جب: ['نیا'] کرو: { <- خود نیا ابتدا-کریں.
}.

ای-میل جب: ['بنام:'] کرو: { :فہرست-اشیاء
	اپنا وصول-کنندگان := فہرست-اشیاء.
}.
 
ای-میل جب: ['cc:'] کرو: { :فہرست-اشیاء
	اپنا cc := فہرست-اشیاء.
}.

ای-میل جب: ['bcc:'] کرو: { :فہرست-اشیاء
	اپنا bcc := فہرست-اشیاء.
}.

ای-میل جب: ['موضوع:'] کرو: { :موضوع
	اپنا موضوع := موضوع.
}.

ای-میل جب: ['بھیجنے-والا:نام:'] کرو: { :بھیجنے-والا :نام
	اپنا بھیجنے-والا := بھیجنے-والا.
	اپنا بھیجنے-والے-کا-نام := نام.
}.

ای-میل جب: ['متن-خط:'] کرو: { :متن-خط
	اپنا متن-خط := متن-خط.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
ای-میل جب: ['ہیڈر:'] کرو: { :سطر <- سطر بدلو: ['\r'] سے: [''], بدلو: ['\n'] سے: [''].
}.

ای-میل جب: ['بھیجیں'] کرو: {
	>> f := فائل عارضی-لکھائی: خود تیار-کریں.
	پروگرام سسٹم: ['sendmail -t < '] + f فائل-راستہ, نئی-سطر.
}.

ای-میل جب: ['تیار-کریں'] کرو: {
	>> لائن-بریک := ['\r\n'].
	>> متنی-لڑی := [''].
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['From: '] + اپنا بھیجنے-والے-کا-نام + [' <'] + ( اپنا بھیجنے-والا ) + ['>']) + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['To: '] + ( اپنا وصول-کنندگان جوڑو: [','] )) + لائن-بریک.
	اپنا cc تعداد اگر-سچ: {
		متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Cc: '] + ( اپنا cc جوڑو: [','] )) + لائن-بریک.
	}.
	اپنا bcc تعداد اگر-سچ: {
		متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Bcc: '] + ( اپنا bcc جوڑو: [','] )) + لائن-بریک.
	}.
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Subject: '] + اپنا موضوع) + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: اپنا متن-خط.
	متنی-لڑی آخر-میں-جوڑو: لائن-بریک. <- متنی-لڑی.
}.

>> ای-میل-HTML := ای-میل نیا.

ای-میل-HTML جب: ['ابتدا-کریں'] کرو: {
	خود ابتدا-کریں.
	اپنا منسلکات := لسٹ نیا.
	اپنا حد := تجوری ٹوکن: 40.
}.

ای-میل-HTML جب: ['منسلک-کریں:'] کرو: { :سیشن-فائل
	>> id := اپنا منسلکات تعداد.
	>> blob := سیشن-فائل blob.
	اپنا منسلکات آخر-میں-جوڑو: (
		لغت نیا
			سیشن-فائل: سیشن-فائل فائل-راستہ,
			mime: ['image/'] + (Server mimetype: سیشن-فائل فائل-راستہ),
			ڈیٹا: blob base64-انکوڈ
	).
	blob آزاد-کرو. <- ['cid:attachment'] + id.
}.

ای-میل-HTML جب: ['تیار-کریں'] کرو: {
	>> لائن-بریک := ['\r\n'].
	>> متنی-لڑی := [''].
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['From: '] + اپنا بھیجنے-والے-کا-نام + [' <'] + ( اپنا بھیجنے-والا ) + ['>']) + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['To: '] + ( اپنا وصول-کنندگان جوڑو: [','] )) + لائن-بریک.
	اپنا cc تعداد اگر-سچ: {
		متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Cc: '] + ( اپنا cc جوڑو: [','] )) + لائن-بریک.
	}.
	اپنا bcc تعداد اگر-سچ: {
		متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Bcc: '] + ( اپنا bcc جوڑو: [','] )) + لائن-بریک.
	}.
	متنی-لڑی آخر-میں-جوڑو: (خود ہیڈر: ['Subject: '] + اپنا موضوع) + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: ['MIME-Version: 1.0'] + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: ['Content-Type: multipart/related; boundary="'] + اپنا حد + ['"; type=text/html'] + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: ['--'] + اپنا حد + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: ['Content-Type: text/html; charset=UTF-8'] + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: ['Content-Transfer-Encoding: 7bit'] + لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
	متنی-لڑی آخر-میں-جوڑو: اپنا متن-خط.
	متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
	اپنا منسلکات ہر-ایک: { :id :معلومات
		>> blob := معلومات ڈیٹا.
		متنی-لڑی آخر-میں-جوڑو: ['--'] + اپنا حد + لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: ['Content-Type: '] + معلومات mime + لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: ['Content-Transfer-Encoding: base64'] + لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: ['Content-ID: <attachment'] + id + ['>'] + لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: ['Content-Disposition: inline; filename="'] + معلومات سیشن-فائل + ['"'] + لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
		>> بالائی-حد := 76.
		>> متن-کی-لمبائی := blob لمبائی.
		>> قطعات := (متن-کی-لمبائی / بالائی-حد) اوپر-گول.
		{ :i
			>> قطعہ := blob نقل آغاز: i * بالائی-حد لمبائی: بالائی-حد.
			متنی-لڑی آخر-میں-جوڑو: قطعہ + لائن-بریک.
		} * قطعات.
		متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
		متنی-لڑی آخر-میں-جوڑو: لائن-بریک.
	}.
	متنی-لڑی آخر-میں-جوڑو: ['--'] + اپنا حد + ['--'] + لائن-بریک. <- متنی-لڑی.
}.
