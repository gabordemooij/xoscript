
# ~ Simple template engine ~

>> سانچہ := آبجیکٹ نیا.

سانچہ جب: ['نیا'] کرو: { <- خود نیا مواد: [''].
}.

سانچہ جب: ['مواد:'] کرو: { :مواد
	اپنا مواد := مواد. 
}.

سانچہ جب: ['نیا:'] کرو: { :مواد <- خود نیا مواد: مواد.
}.

سانچہ جب: ['کاٹیں:'] کرو: { :نشان
	>> آغاز-نشان := (['<!-- cut:%id% -->'] %id%: نشان).
	>> اختتامی-نشان := (['<!-- /cut:%id% -->'] %id%: نشان).
	>> حصے := اپنا مواد تقسیم: آغاز-نشان.
	>> سابقہ := حصے پہلا.
	>> حصے2 := حصے آخری تقسیم: اختتامی-نشان.
	>> لاحقہ := حصے2 آخری.
	>> حصہ := حصے2 پہلا.
	>> باقی := سابقہ + لاحقہ.
	اپنا مواد := باقی. <- سانچہ نیا: حصہ.
	
}.

سانچہ جب: ['نقل'] کرو: { <- خود نیا: خود بطور-متن نقل.
}.
	
سانچہ جب: ['چسپاں-کریں:کلید:'] کرو: { :اقتباس :id
	>> چسپاں-نشان := (['<!-- paste:%id% -->'] %id%: id).
	اپنا مواد بدلو: چسپاں-نشان سے: ( اقتباس بطور-متن + چسپاں-نشان ).
}.

سانچہ جب: ['مقرر:قدر:'] کرو: { :خانہ :قدر
	اپنا مواد بدلو: ['<!-- slot:'] + خانہ + [' -->'] سے: ( Server html-انکوڈ: قدر ).
}.

سانچہ جب: ['مقرر:html:'] کرو: { :خانہ :html
	اپنا مواد بدلو: ['<!-- slot:'] + خانہ + [' -->'] سے: html.
}.

سانچہ جب: ['جواب:اور:'] کرو: { :خانہ :قدر
	خود مقرر: (خانہ آغاز: 0 لمبائی: (خانہ لمبائی - 1)) قدر: قدر.
}.

سانچہ جب: ['nl2br'] کرو: {
	اپنا مواد بدلو: ['\n'] سے: ['<br>'].
}.

سانچہ جب: ['صاف-کریں'] کرو: {
	اپنا مواد :=
		نمونہ
		نیا: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		مطابقت: اپنا مواد
		کرو: { <- ['']. }.
}.

سانچہ جب: ['کٹ-صاف-کریں'] کرو: {
	>> اشیاء := لسٹ نیا.
	نمونہ
	نیا: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	مطابقت: اپنا مواد
	کرو: { :_ :حصہ
		اشیاء آخر-میں-جوڑو: حصہ ? 1.
	}.
	اشیاء ہر-ایک: { :_ :id
		اپنا مواد :=
			نمونہ نیا: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			مطابقت: اپنا مواد
			کرو: { <- ['']. }.
	 }.
}.

سانچہ جب: ['خالی-جگہ-صاف-کریں'] کرو: {
	اپنا مواد :=
		نمونہ
		نیا: ['\\s*\\n'],
		مطابقت: اپنا مواد
		کرو: { <- ['\n']. }.
	اپنا مواد :=
		نمونہ
		نیا: ['\\n[\\s\\t]+'],
		مطابقت: اپنا مواد
		کرو: { <- ['\n']. }.
}.

سانچہ جب: ['سب-صاف-کریں'] کرو: {
	خود صاف-کریں.
	خود کٹ-صاف-کریں.
	خود خالی-جگہ-صاف-کریں.
}.

سانچہ جب: ['بطور-متن'] کرو: { <- اپنا مواد.
}.
