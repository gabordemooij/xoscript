
# ~ Simple template engine ~

>> Itemplethi := Into entsha.

Itemplethi xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha umxholo: [''].
}.

Itemplethi xa-kufika: ['umxholo:'] yenza: { :umxholo
	eyakho umxholo := umxholo. 
}.

Itemplethi xa-kufika: ['entsha:'] yenza: { :umxholo <- ngokwakho entsha umxholo: umxholo.
}.

Itemplethi xa-kufika: ['sika:'] yenza: { :uphawu
	>> uphawu-lokuqala := (['<!-- cut:%id% -->'] %id%: uphawu).
	>> uphawu-lokuphela := (['<!-- /cut:%id% -->'] %id%: uphawu).
	>> iinxalenye := eyakho umxholo yahlula: uphawu-lokuqala.
	>> isimaphambili := iinxalenye eyokuqala.
	>> iinxalenye2 := iinxalenye eyokugqibela yahlula: uphawu-lokuphela.
	>> isimamva := iinxalenye2 eyokugqibela.
	>> inxalenye := iinxalenye2 eyokuqala.
	>> intsalela := isimaphambili + isimamva.
	eyakho umxholo := intsalela. <- Itemplethi entsha: inxalenye.
	
}.

Itemplethi xa-kufika: ['kopa'] yenza: { <- ngokwakho entsha: ngokwakho umbhalo kopa.
}.
	
Itemplethi xa-kufika: ['ncamathisela:kwindawo:'] yenza: { :isicatshulwa :id
	>> uphawu-lokuncamathisela := (['<!-- paste:%id% -->'] %id%: id).
	eyakho umxholo buyisela: uphawu-lokuncamathisela nge: ( isicatshulwa umbhalo + uphawu-lokuncamathisela ).
}.

Itemplethi xa-kufika: ['misela:ixabiso:'] yenza: { :indawo :ixabiso
	eyakho umxholo buyisela: ['<!-- slot:'] + indawo + [' -->'] nge: ( Server html-faka-ikhowudi: ixabiso ).
}.

Itemplethi xa-kufika: ['misela:html:'] yenza: { :indawo :html
	eyakho umxholo buyisela: ['<!-- slot:'] + indawo + [' -->'] nge: html.
}.

Itemplethi xa-kufika: ['phendula:kwaye:'] yenza: { :indawo :ixabiso
	ngokwakho misela: (indawo ukusuka: 0 ubude: (indawo ubude - 1)) ixabiso: ixabiso.
}.

Itemplethi xa-kufika: ['nl2br'] yenza: {
	eyakho umxholo buyisela: ['\n'] nge: ['<br>'].
}.

Itemplethi xa-kufika: ['lungelelanisa'] yenza: {
	eyakho umxholo :=
		Ipateni
		entsha: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ukungqamana: eyakho umxholo
		yenza: { <- ['']. }.
}.

Itemplethi xa-kufika: ['lungelelanisa-okusikiweyo'] yenza: {
	>> izinto := Uluhlu entsha.
	Ipateni
	entsha: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ukungqamana: eyakho umxholo
	yenza: { :_ :inxalenye
		izinto yongeza-ekugqibeleni: inxalenye ? 1.
	}.
	izinto nganye: { :_ :id
		eyakho umxholo :=
			Ipateni entsha: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ukungqamana: eyakho umxholo
			yenza: { <- ['']. }.
	 }.
}.

Itemplethi xa-kufika: ['lungelelanisa-izithuba'] yenza: {
	eyakho umxholo :=
		Ipateni
		entsha: ['\\s*\\n'],
		ukungqamana: eyakho umxholo
		yenza: { <- ['\n']. }.
	eyakho umxholo :=
		Ipateni
		entsha: ['\\n[\\s\\t]+'],
		ukungqamana: eyakho umxholo
		yenza: { <- ['\n']. }.
}.

Itemplethi xa-kufika: ['lungelelanisa-konke'] yenza: {
	ngokwakho lungelelanisa.
	ngokwakho lungelelanisa-okusikiweyo.
	ngokwakho lungelelanisa-izithuba.
}.

Itemplethi xa-kufika: ['umbhalo'] yenza: { <- eyakho umxholo.
}.
