>> I-imeyile := Into entsha.

I-imeyile xa-kufika: ['lungiselela'] yenza: {
	eyakho abamkeli := Uluhlu entsha.
	eyakho cc := Uluhlu entsha.
	eyakho bcc := Uluhlu entsha.
	eyakho umthumeli := Engenanto.
	eyakho igama-lomthumeli := Engenanto.
	eyakho umbandela := Engenanto.
	eyakho umzimba := Engenanto.
}.

I-imeyile xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha lungiselela.
}.

I-imeyile xa-kufika: ['ku:'] yenza: { :uludwe-lwezinto
	eyakho abamkeli := uludwe-lwezinto.
}.
 
I-imeyile xa-kufika: ['cc:'] yenza: { :uludwe-lwezinto
	eyakho cc := uludwe-lwezinto.
}.

I-imeyile xa-kufika: ['bcc:'] yenza: { :uludwe-lwezinto
	eyakho bcc := uludwe-lwezinto.
}.

I-imeyile xa-kufika: ['umbandela:'] yenza: { :umbandela
	eyakho umbandela := umbandela.
}.

I-imeyile xa-kufika: ['umthumeli:igama:'] yenza: { :umthumeli :igama
	eyakho umthumeli := umthumeli.
	eyakho igama-lomthumeli := igama.
}.

I-imeyile xa-kufika: ['umzimba:'] yenza: { :umzimba
	eyakho umzimba := umzimba.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
I-imeyile xa-kufika: ['isihloko:'] yenza: { :umgca <- umgca buyisela: ['\r'] nge: [''], buyisela: ['\n'] nge: [''].
}.

I-imeyile xa-kufika: ['thumela'] yenza: {
	>> f := Ifayile tempwrite: ngokwakho velisa.
	Inkqubo isixokelelwano: ['sendmail -t < '] + f indlela-yefayile, umgca-omtsha.
}.

I-imeyile xa-kufika: ['velisa'] yenza: {
	>> ukwaphula-umgca := ['\r\n'].
	>> umtya-wombhalo := [''].
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['From: '] + eyakho igama-lomthumeli + [' <'] + ( eyakho umthumeli ) + ['>']) + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['To: '] + ( eyakho abamkeli dibanisa: [','] )) + ukwaphula-umgca.
	eyakho cc inani-lezinto inyaniso: {
		umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Cc: '] + ( eyakho cc dibanisa: [','] )) + ukwaphula-umgca.
	}.
	eyakho bcc inani-lezinto inyaniso: {
		umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Bcc: '] + ( eyakho bcc dibanisa: [','] )) + ukwaphula-umgca.
	}.
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Subject: '] + eyakho umbandela) + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: eyakho umzimba.
	umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca. <- umtya-wombhalo.
}.

>> I-imeyile-HTML := I-imeyile entsha.

I-imeyile-HTML xa-kufika: ['lungiselela'] yenza: {
	ngokwakho lungiselela.
	eyakho izinto-eziqhotyoshelweyo := Uluhlu entsha.
	eyakho umda := Isisefu ithokheni: 40.
}.

I-imeyile-HTML xa-kufika: ['qhoboshela:'] yenza: { :ifayile-yeseshoni
	>> id := eyakho izinto-eziqhotyoshelweyo inani-lezinto.
	>> blob := ifayile-yeseshoni blob.
	eyakho izinto-eziqhotyoshelweyo yongeza-ekugqibeleni: (
		Isichazimagama entsha
			ifayile-yeseshoni: ifayile-yeseshoni indlela-yefayile,
			mime: ['image/'] + (Server mimetype: ifayile-yeseshoni indlela-yefayile),
			idatha: blob base64-faka-ikhowudi
	).
	blob khulula. <- ['cid:attachment'] + id.
}.

I-imeyile-HTML xa-kufika: ['velisa'] yenza: {
	>> ukwaphula-umgca := ['\r\n'].
	>> umtya-wombhalo := [''].
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['From: '] + eyakho igama-lomthumeli + [' <'] + ( eyakho umthumeli ) + ['>']) + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['To: '] + ( eyakho abamkeli dibanisa: [','] )) + ukwaphula-umgca.
	eyakho cc inani-lezinto inyaniso: {
		umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Cc: '] + ( eyakho cc dibanisa: [','] )) + ukwaphula-umgca.
	}.
	eyakho bcc inani-lezinto inyaniso: {
		umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Bcc: '] + ( eyakho bcc dibanisa: [','] )) + ukwaphula-umgca.
	}.
	umtya-wombhalo yongeza-ekugqibeleni: (ngokwakho isihloko: ['Subject: '] + eyakho umbandela) + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ['MIME-Version: 1.0'] + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ['Content-Type: multipart/related; boundary="'] + eyakho umda + ['"; type=text/html'] + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ['--'] + eyakho umda + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ['Content-Type: text/html; charset=UTF-8'] + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ['Content-Transfer-Encoding: 7bit'] + ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
	umtya-wombhalo yongeza-ekugqibeleni: eyakho umzimba.
	umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
	eyakho izinto-eziqhotyoshelweyo nganye: { :id :ulwazi
		>> blob := ulwazi idatha.
		umtya-wombhalo yongeza-ekugqibeleni: ['--'] + eyakho umda + ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ['Content-Type: '] + ulwazi mime + ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ['Content-Transfer-Encoding: base64'] + ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ['Content-ID: <attachment'] + id + ['>'] + ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ['Content-Disposition: inline; filename="'] + ulwazi ifayile-yeseshoni + ['"'] + ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
		>> eyona-ninzi := 76.
		>> ubude-bombhalo := blob ubude.
		>> iziqwenga := (ubude-bombhalo / eyona-ninzi) nyusa-inani.
		{ :i
			>> isiqwenga := blob kopa ukusuka: i * eyona-ninzi ubude: eyona-ninzi.
			umtya-wombhalo yongeza-ekugqibeleni: isiqwenga + ukwaphula-umgca.
		} * iziqwenga.
		umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
		umtya-wombhalo yongeza-ekugqibeleni: ukwaphula-umgca.
	}.
	umtya-wombhalo yongeza-ekugqibeleni: ['--'] + eyakho umda + ['--'] + ukwaphula-umgca. <- umtya-wombhalo.
}.
