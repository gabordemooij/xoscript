Isicelo-HTTP xa-kufika: ['HTTP-isihloko:'] yenza: { :isitshixo <- Inkqubo isicwangciso: isitshixo.
}.

>> Isihloko-se-HTTP := Into entsha.

Isihloko-se-HTTP xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha lungiselela.
}.

Isihloko-se-HTTP xa-kufika: ['lungiselela'] yenza: {
	eyakho isitshixo := Engenanto.
	eyakho ixabiso := Engenanto.
}.

Isihloko-se-HTTP xa-kufika: ['isitshixo:ixabiso:'] yenza: { :isitshixo :ixabiso
	eyakho isitshixo := isitshixo.
	eyakho ixabiso := ixabiso.
}.

Isihloko-se-HTTP xa-kufika: ['isitshixo'] yenza: { <- eyakho isitshixo.
}.

Isihloko-se-HTTP xa-kufika: ['ixabiso'] yenza: { <- eyakho ixabiso.
}.


Isihloko-se-HTTP xa-kufika: ['umbhalo'] yenza: {
	>> umgca := eyakho isitshixo + [': '] + eyakho ixabiso.
	umgca buyisela: ['\r'] nge: [''], buyisela: ['\n'] nge: ['']. <- umgca + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Uxwebhu-lwewebhu := Into entsha.

Uxwebhu-lwewebhu xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha lungiselela.
}.

Uxwebhu-lwewebhu xa-kufika: ['lungiselela'] yenza: {
	eyakho izihloko := Uluhlu entsha.
	eyakho i-id-yeseshoni := Engenanto.
	eyakho umphathi-weeseshoni := Iseshoni-yefayile-yethutyana entsha.
	eyakho idatha-yeseshoni := Engenanto.
	eyakho ekhuselekileyo := Inyaniso.
	eyakho isiza-esinye := ['Strict'].
	eyakho izihloko-zithunyelwe := Ubuxoki.
	eyakho isicelo-http := Isicelo-HTTP entsha.
}.

Uxwebhu-lwewebhu xa-kufika: ['isicelo-http:'] yenza: { :isicelo-http
	eyakho isicelo-http := isicelo-http.
}. 

Uxwebhu-lwewebhu xa-kufika: ['ikhuki-yeseshoni-ekhuselekileyo:'] yenza: { :ekhuselekileyo
	ngokwakho khangela-izihloko.
	eyakho ekhuselekileyo := ekhuselekileyo.
}.

Uxwebhu-lwewebhu xa-kufika: ['ikhuki-yeseshoni-yesiza-esinye:'] yenza: { :ixabiso
	ngokwakho khangela-izihloko.
	>> ukhetho := Uluhlu entsha 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	ukhetho ine: ixabiso, ubuxoki: {
		lo-msebenzi impazamo: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eyakho isiza-esinye := ixabiso.
}.

Uxwebhu-lwewebhu xa-kufika: ['isihloko:'] yenza: { :isihloko
	ngokwakho khangela-izihloko.
	eyakho izihloko yongeza-ekugqibeleni: isihloko.
}.

Uxwebhu-lwewebhu xa-kufika: ['susa-izihloko'] yenza: {
	ngokwakho khangela-izihloko.
	eyakho izihloko := Uluhlu entsha.
}.

Uxwebhu-lwewebhu xa-kufika: ['umphathi-weeseshoni:'] yenza: { :umphathi
	ngokwakho khangela-izihloko.
	eyakho umphathi-weeseshoni := umphathi.
}.

Uxwebhu-lwewebhu xa-kufika: ['umphathi-weeseshoni'] yenza: { <- eyakho umphathi-weeseshoni.
}.

Uxwebhu-lwewebhu xa-kufika: ['khangela-izihloko'] yenza: {
	eyakho izihloko-zithunyelwe inyaniso: {
		lo-msebenzi impazamo: ['Headers already sent to client.'].
	}.
}.

Uxwebhu-lwewebhu xa-kufika: ['qala-iseshoni'] yenza: {
	ngokwakho khangela-izihloko.
	>> isicelo-http := eyakho isicelo-http.
	>> i-id-yeseshoni := isicelo-http cookie: ['xsid'].
	i-id-yeseshoni Engenanto? ubuxoki: {
		(( Ipateni entsha: ['^[A-Za-z0-9]+\\z'], ukungqamana: i-id-yeseshoni ) = 0) inyaniso: {
			i-id-yeseshoni := Engenanto.
		}.
	}.
	i-id-yeseshoni Engenanto? inyaniso: {
		i-id-yeseshoni := Isisefu ithokheni: 30.
		>> isihloko-seseshoni := Isihloko-se-HTTP entsha
		isitshixo: ['Set-Cookie'] ixabiso: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eyakho ekhuselekileyo oku: ['Secure'] okanye-oko: ['']),
		SSITE: (eyakho isiza-esinye),
		XSID: i-id-yeseshoni
		).
		eyakho izihloko yongeza-ekugqibeleni: isihloko-seseshoni.
	}.
	eyakho idatha-yeseshoni := eyakho umphathi-weeseshoni ukwenzela: i-id-yeseshoni, layisha. <- eyakho idatha-yeseshoni. # reference
}.

Uxwebhu-lwewebhu xa-kufika: ['yiya-ku:'] yenza: { :idilesi
	ngokwakho khangela-izihloko.
	ngokwakho susa-izihloko.
	eyakho izihloko
	yongeza-ekugqibeleni: (
		Isihloko-se-HTTP entsha
		isitshixo: ['Status'] ixabiso: ['303 See Other']
	),
	yongeza-ekugqibeleni: (
		Isihloko-se-HTTP entsha
		isitshixo: ['Location'] ixabiso: idilesi
	).
	ngokwakho khupha: ['Redirect'].
}.

Uxwebhu-lwewebhu xa-kufika: ['tshabalalisa-iseshoni'] yenza: {
	ngokwakho khangela-izihloko.
	>> isicelo-http := eyakho isicelo-http.
	>> i-id-yeseshoni := isicelo-http cookie: ['xsid'].
	i-id-yeseshoni Engenanto? ubuxoki: {
		>> isihloko-seseshoni := Isihloko-se-HTTP entsha.
		>> ixesha-lokuphela := Ixesha entsha unyaka: 1970, ifomathi: ['%a, %d %b %Y %H:%M:%S GMT'].
		isihloko-seseshoni isitshixo: ['Set-Cookie'] ixabiso: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: ixesha-lokuphela,
			SEC: (eyakho ekhuselekileyo oku: ['Secure'] okanye-oko: ['']),
			SSITE: (eyakho isiza-esinye),
			XSID: i-id-yeseshoni
		).
		eyakho umphathi-weeseshoni tshabalalisa.
		eyakho izihloko yongeza-ekugqibeleni: isihloko-seseshoni.
	}.
}.


Uxwebhu-lwewebhu xa-kufika: ['itemplethi:'] yenza: { :indlela-yefayile <- Itemplethi entsha: (Ifayile entsha: indlela-yefayile, funda).
}.

Uxwebhu-lwewebhu xa-kufika: ['khupha:uhlobo:'] yenza: { :isiphumo :uhlobo
	eyakho izihloko-zithunyelwe ubuxoki: {
		eyakho idatha-yeseshoni Engenanto? ubuxoki: {
			eyakho umphathi-weeseshoni gcina: eyakho idatha-yeseshoni.
		}.
		eyakho izihloko yongeza-ekugqibeleni: (
			Isihloko-se-HTTP entsha
			isitshixo: ['Content-type'] ixabiso: uhlobo
		).
		eyakho izihloko nganye: { :_ :isihloko
			Imveliso bhala: isihloko.
		}.
		eyakho izihloko-zithunyelwe := Inyaniso.
		Imveliso bhala: ['\r\n'].
	}.
	Imveliso bhala: isiphumo.
}.

Uxwebhu-lwewebhu xa-kufika: ['gqiba:uhlobo:'] yenza: { :isiphumo :uhlobo
	eyakho izihloko-zithunyelwe ubuxoki: {
		eyakho idatha-yeseshoni Engenanto? ubuxoki: {
			eyakho umphathi-weeseshoni gcina: eyakho idatha-yeseshoni.
		}.
		eyakho izihloko yongeza-ekugqibeleni: (
			Isihloko-se-HTTP entsha
			isitshixo: ['Content-type'] ixabiso: uhlobo
		).
		eyakho izihloko yongeza-ekugqibeleni: (
			Isihloko-se-HTTP entsha
			isitshixo: ['Content-Length'] ixabiso: isiphumo umbhalo bytes
		).
		eyakho izihloko nganye: { :_ :isihloko
			Imveliso bhala: isihloko.
		}.
		eyakho izihloko-zithunyelwe := Inyaniso.
		Imveliso bhala: ['\r\n'].
	}.
	Imveliso bhala: isiphumo.
}.

Uxwebhu-lwewebhu xa-kufika: ['khupha:'] yenza: { :isiphumo
	ngokwakho khupha: isiphumo uhlobo: ['text/html; charset=utf-8'].
}.

Uxwebhu-lwewebhu xa-kufika: ['gqiba:'] yenza: { :isiphumo
	ngokwakho gqiba: isiphumo uhlobo: ['text/html; charset=utf-8'].
}.

Uxwebhu-lwewebhu xa-kufika: ['json:'] yenza: { :isiphumo
	ngokwakho khupha: ( JSON jsonify: isiphumo ) uhlobo: ['application/json'].
}.

Uxwebhu-lwewebhu xa-kufika: ['ayifumanekanga:'] yenza: { :isiphumo
	ngokwakho susa-izihloko isihloko: (
		Isihloko-se-HTTP entsha isitshixo: ['Status'] ixabiso: ['404 Not Found']
	).
	ngokwakho khupha: isiphumo.
}.


# Interface

>> Iseshoni := Into entsha.

Iseshoni xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha lungiselela ukwenzela: Engenanto.
}.

Iseshoni xa-kufika: ['ukwenzela:'] yenza: { :id
	eyakho id := id.
}.

Iseshoni xa-kufika: ['layisha'] yenza: {
	lo-msebenzi impazamo: ['Not implemented.'].
}.

Iseshoni xa-kufika: ['gcina:'] yenza: {
	lo-msebenzi impazamo: ['Not implemented.'].
}.

Iseshoni xa-kufika: ['tshabalalisa'] yenza: {
	lo-msebenzi impazamo: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Iseshoni-yefayile-yethutyana := Iseshoni entsha.

Iseshoni-yefayile-yethutyana xa-kufika: ['lungiselela'] yenza: {
	eyakho ukuqala-kwendlela := ['/tmp/sess-'].
}.

Iseshoni-yefayile-yethutyana xa-kufika: ['isimaphambili-sendlela:'] yenza: { :umtya-wombhalo
	eyakho ukuqala-kwendlela := umtya-wombhalo.
}.

Iseshoni-yefayile-yethutyana xa-kufika: ['ifayile-yeseshoni'] yenza: { <- ( Ifayile entsha: ( eyakho ukuqala-kwendlela + eyakho id + ['.txt'] ) ).
}.

Iseshoni-yefayile-yethutyana xa-kufika: ['layisha'] yenza: {
	>> ifayile-yeseshoni := ngokwakho ifayile-yeseshoni.
	ifayile-yeseshoni ikhona ubuxoki: {
		ifayile-yeseshoni bhala: (Isichazimagama entsha ikhowudi).
	}. <- ifayile-yeseshoni funda into.
}.

Iseshoni-yefayile-yethutyana xa-kufika: ['gcina:'] yenza: { :idatha
	>> ifayile-yeseshoni := ngokwakho ifayile-yeseshoni.
	ifayile-yeseshoni ikhona inyaniso: {
		ifayile-yeseshoni bhala: idatha ikhowudi.
	}.
}.

Iseshoni-yefayile-yethutyana xa-kufika: ['tshabalalisa'] yenza: {
	>> ifayile-yeseshoni := ngokwakho ifayile-yeseshoni.
	ifayile-yeseshoni ikhona inyaniso: {
		ifayile-yeseshoni cima.
	}.
}.


>> URL := Into entsha.

URL xa-kufika: ['lungiselela'] yenza: {
	eyakho iprotocol := ['https://'].
	eyakho umamkeli := ['localhost'].
	eyakho indlela-yefayile := [''].
	eyakho iiparamitha-url := [''].
	eyakho hash := [''].
}.

URL xa-kufika: ['entsha'] yenza: { <- ngokwakho entsha lungiselela.
}.

URL xa-kufika: ['umbhalo'] yenza: { <- (
	eyakho iprotocol +
	eyakho umamkeli +
	eyakho indlela-yefayile +
	eyakho iiparamitha-url +
	eyakho hash ).
}.

URL xa-kufika: ['iprotocol:'] yenza: { :iprotocol
	((Uluhlu entsha ; ['http'] ; ['https']) ine: iprotocol) inyaniso: {
		eyakho iprotocol := iprotocol + ['://'].
	}, ubuxoki: {
		lo-msebenzi impazamo: ['Invalid protocol'].
	}.
}.

URL xa-kufika: ['umamkeli:'] yenza: { :umamkeli
	#todo validate according to rfc
	eyakho umamkeli := umamkeli.
}.

URL xa-kufika: ['indlela-yefayile:'] yenza: { :indlela-yefayile
	eyakho indlela-yefayile := ['/'] + indlela-yefayile url-faka-ikhowudi.
}.

URL xa-kufika: ['iiparamitha-url:'] yenza: { :ukumephu
	>> iiparamitha-url := Uluhlu entsha.
	ukumephu nganye: { :isitshixo :ixabiso
		iiparamitha-url yongeza-ekugqibeleni: isitshixo umbhalo url-faka-ikhowudi + ['='] + ixabiso umbhalo url-faka-ikhowudi.
	}.
	eyakho iiparamitha-url := ['?'] + ( iiparamitha-url dibanisa: ['&'] ).
}.

URL xa-kufika: ['ihashi:'] yenza: { :hash
	eyakho hash := ['#'] + hash url-faka-ikhowudi.
}.

