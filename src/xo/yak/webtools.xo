HTTP-Запрос в: ['HTTP-баһылааһын:'] сделать: { :күлүүс <- Программа параметр: күлүүс.
}.

>> HTTP-Баһылааһын := Объект саҥа.

HTTP-Баһылааһын в: ['саҥа'] сделать: { <- бэйэ саҥа саҕалааһын.
}.

HTTP-Баһылааһын в: ['саҕалааһын'] сделать: {
	бэйэм күлүүс := Кураанах.
	бэйэм суолта := Кураанах.
}.

HTTP-Баһылааһын в: ['күлүүс:суолта:'] сделать: { :күлүүс :суолта
	бэйэм күлүүс := күлүүс.
	бэйэм суолта := суолта.
}.

HTTP-Баһылааһын в: ['күлүүс'] сделать: { <- бэйэм күлүүс.
}.

HTTP-Баһылааһын в: ['суолта'] сделать: { <- бэйэм суолта.
}.


HTTP-Баһылааһын в: ['к-тексту'] сделать: {
	>> устуруока := бэйэм күлүүс + [': '] + бэйэм суолта.
	устуруока солбуй: ['\r'] на: [''], солбуй: ['\n'] на: ['']. <- устуруока + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-докумуон := Объект саҥа.

Веб-докумуон в: ['саҥа'] сделать: { <- бэйэ саҥа саҕалааһын.
}.

Веб-докумуон в: ['саҕалааһын'] сделать: {
	бэйэм баһылааһыннар := Испииһэк саҥа.
	бэйэм сеанс-id := Кураанах.
	бэйэм сеанс-салайааччыта := Кэмчэ-файл-сеанса саҥа.
	бэйэм сеанс-дааннайдара := Кураанах.
	бэйэм куттала-суох := Даа.
	бэйэм биир-саайт := ['Strict'].
	бэйэм баһылааһыннар-ыытылынна := Суох.
	бэйэм көрдөһүү := HTTP-Запрос саҥа.
}.

Веб-докумуон в: ['көрдөһүү:'] сделать: { :көрдөһүү
	бэйэм көрдөһүү := көрдөһүү.
}. 

Веб-докумуон в: ['куттала-суох-сеанс-cookie:'] сделать: { :куттала-суох
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	бэйэм куттала-суох := куттала-суох.
}.

Веб-докумуон в: ['биир-саайт-сеанс-cookie:'] сделать: { :суолта
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	>> талыылар := Испииһэк саҥа 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	талыылар имеет: суолта, суох: {
		этот-блок-кода алҕас: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	бэйэм биир-саайт := суолта.
}.

Веб-докумуон в: ['баһылааһын:'] сделать: { :баһылааһын
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	бэйэм баһылааһыннар эбэн-биэр: баһылааһын.
}.

Веб-докумуон в: ['баһылааһыннары-сот'] сделать: {
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	бэйэм баһылааһыннар := Испииһэк саҥа.
}.

Веб-докумуон в: ['сеанс-салайааччыта:'] сделать: { :салайааччы
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	бэйэм сеанс-салайааччыта := салайааччы.
}.

Веб-докумуон в: ['сеанс-салайааччыта'] сделать: { <- бэйэм сеанс-салайааччыта.
}.

Веб-докумуон в: ['баһылааһыннары-бэрэбиэркэлээ'] сделать: {
	бэйэм баһылааһыннар-ыытылынна даа: {
		этот-блок-кода алҕас: ['Headers already sent to client.'].
	}.
}.

Веб-докумуон в: ['сеаны-саҕалаа'] сделать: {
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	>> көрдөһүү := бэйэм көрдөһүү.
	>> сеанс-id := көрдөһүү cookie: ['xsid'].
	сеанс-id Кураанах? суох: {
		(( Шаблон саҥа: ['^[A-Za-z0-9]+\\z'], сөп-түбэһии: сеанс-id ) = 0) даа: {
			сеанс-id := Кураанах.
		}.
	}.
	сеанс-id Кураанах? даа: {
		сеанс-id := Сейф токен: 30.
		>> сеанс-баһылааһына := HTTP-Баһылааһын саҥа
		күлүүс: ['Set-Cookie'] суолта: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (бэйэм куттала-суох эбэтэр: ['Secure'] эбэтэр: ['']),
		SSITE: (бэйэм биир-саайт),
		XSID: сеанс-id
		).
		бэйэм баһылааһыннар эбэн-биэр: сеанс-баһылааһына.
	}.
	бэйэм сеанс-дааннайдара := бэйэм сеанс-салайааччыта иһин: сеанс-id, киллэр. <- бэйэм сеанс-дааннайдара. # reference
}.

Веб-докумуон в: ['бар:'] сделать: { :аадырыс
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	бэйэ баһылааһыннары-сот.
	бэйэм баһылааһыннар
	эбэн-биэр: (
		HTTP-Баһылааһын саҥа
		күлүүс: ['Status'] суолта: ['303 See Other']
	),
	эбэн-биэр: (
		HTTP-Баһылааһын саҥа
		күлүүс: ['Location'] суолта: аадырыс
	).
	бэйэ таһаар: ['Redirect'].
}.

Веб-докумуон в: ['сеаны-суох-гын'] сделать: {
	бэйэ баһылааһыннары-бэрэбиэркэлээ.
	>> көрдөһүү := бэйэм көрдөһүү.
	>> сеанс-id := көрдөһүү cookie: ['xsid'].
	сеанс-id Кураанах? суох: {
		>> сеанс-баһылааһына := HTTP-Баһылааһын саҥа.
		>> түгэн := Түгэн саҥа год: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		сеанс-баһылааһына күлүүс: ['Set-Cookie'] суолта: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: түгэн,
			SEC: (бэйэм куттала-суох эбэтэр: ['Secure'] эбэтэр: ['']),
			SSITE: (бэйэм биир-саайт),
			XSID: сеанс-id
		).
		бэйэм сеанс-салайааччыта суох-гын.
		бэйэм баһылааһыннар эбэн-биэр: сеанс-баһылааһына.
	}.
}.


Веб-докумуон в: ['халыып:'] сделать: { :путь <- Халыып саҥа: (Файл саҥа: путь, аах).
}.

Веб-докумуон в: ['таһаар:тип:'] сделать: { :түмүк :тип
	бэйэм баһылааһыннар-ыытылынна суох: {
		бэйэм сеанс-дааннайдара Кураанах? суох: {
			бэйэм сеанс-салайааччыта харайдаа: бэйэм сеанс-дааннайдара.
		}.
		бэйэм баһылааһыннар эбэн-биэр: (
			HTTP-Баһылааһын саҥа
			күлүүс: ['Content-type'] суолта: тип
		).
		бэйэм баһылааһыннар хас-биирдии: { :_ :баһылааһын
			Таһаарыы суруй: баһылааһын.
		}.
		бэйэм баһылааһыннар-ыытылынна := Даа.
		Таһаарыы суруй: ['\r\n'].
	}.
	Таһаарыы суруй: түмүк.
}.

Веб-докумуон в: ['бүтэр:тип:'] сделать: { :түмүк :тип
	бэйэм баһылааһыннар-ыытылынна суох: {
		бэйэм сеанс-дааннайдара Кураанах? суох: {
			бэйэм сеанс-салайааччыта харайдаа: бэйэм сеанс-дааннайдара.
		}.
		бэйэм баһылааһыннар эбэн-биэр: (
			HTTP-Баһылааһын саҥа
			күлүүс: ['Content-type'] суолта: тип
		).
		бэйэм баһылааһыннар эбэн-биэр: (
			HTTP-Баһылааһын саҥа
			күлүүс: ['Content-Length'] суолта: түмүк к-тексту bytes
		).
		бэйэм баһылааһыннар хас-биирдии: { :_ :баһылааһын
			Таһаарыы суруй: баһылааһын.
		}.
		бэйэм баһылааһыннар-ыытылынна := Даа.
		Таһаарыы суруй: ['\r\n'].
	}.
	Таһаарыы суруй: түмүк.
}.

Веб-докумуон в: ['таһаар:'] сделать: { :түмүк
	бэйэ таһаар: түмүк тип: ['text/html; charset=utf-8'].
}.

Веб-докумуон в: ['бүтэр:'] сделать: { :түмүк
	бэйэ бүтэр: түмүк тип: ['text/html; charset=utf-8'].
}.

Веб-докумуон в: ['json:'] сделать: { :түмүк
	бэйэ таһаар: ( JSON jsonify: түмүк ) тип: ['application/json'].
}.

Веб-докумуон в: ['көстүбэтэ:'] сделать: { :түмүк
	бэйэ баһылааһыннары-сот баһылааһын: (
		HTTP-Баһылааһын саҥа күлүүс: ['Status'] суолта: ['404 Not Found']
	).
	бэйэ таһаар: түмүк.
}.


# Interface

>> Сеанс := Объект саҥа.

Сеанс в: ['саҥа'] сделать: { <- бэйэ саҥа саҕалааһын иһин: Кураанах.
}.

Сеанс в: ['иһин:'] сделать: { :id
	бэйэм id := id.
}.

Сеанс в: ['киллэр'] сделать: {
	этот-блок-кода алҕас: ['Not implemented.'].
}.

Сеанс в: ['харайдаа:'] сделать: {
	этот-блок-кода алҕас: ['Not implemented.'].
}.

Сеанс в: ['суох-гын'] сделать: {
	этот-блок-кода алҕас: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Кэмчэ-файл-сеанса := Сеанс саҥа.

Кэмчэ-файл-сеанса в: ['саҕалааһын'] сделать: {
	бэйэм суол-саҕаланыыта := ['/tmp/sess-'].
}.

Кэмчэ-файл-сеанса в: ['суол-префикса:'] сделать: { :устуруока-тиһиктэ
	бэйэм суол-саҕаланыыта := устуруока-тиһиктэ.
}.

Кэмчэ-файл-сеанса в: ['файл'] сделать: { <- ( Файл саҥа: ( бэйэм суол-саҕаланыыта + бэйэм id + ['.txt'] ) ).
}.

Кэмчэ-файл-сеанса в: ['киллэр'] сделать: {
	>> файл := бэйэ файл.
	файл существует суох: {
		файл суруй: (Тылдьыт саҥа код).
	}. <- файл аах объект.
}.

Кэмчэ-файл-сеанса в: ['харайдаа:'] сделать: { :дааннайдар
	>> файл := бэйэ файл.
	файл существует даа: {
		файл суруй: дааннайдар код.
	}.
}.

Кэмчэ-файл-сеанса в: ['суох-гын'] сделать: {
	>> файл := бэйэ файл.
	файл существует даа: {
		файл ыраас.
	}.
}.


>> URL := Объект саҥа.

URL в: ['саҕалааһын'] сделать: {
	бэйэм протокол := ['https://'].
	бэйэм хост := ['localhost'].
	бэйэм путь := [''].
	бэйэм url-параметрдар := [''].
	бэйэм hash := [''].
}.

URL в: ['саҥа'] сделать: { <- бэйэ саҥа саҕалааһын.
}.

URL в: ['к-тексту'] сделать: { <- (
	бэйэм протокол +
	бэйэм хост +
	бэйэм путь +
	бэйэм url-параметрдар +
	бэйэм hash ).
}.

URL в: ['протокол:'] сделать: { :протокол
	((Испииһэк саҥа ; ['http'] ; ['https']) имеет: протокол) даа: {
		бэйэм протокол := протокол + ['://'].
	}, суох: {
		этот-блок-кода алҕас: ['Invalid protocol'].
	}.
}.

URL в: ['хост:'] сделать: { :хост
	#todo validate according to rfc
	бэйэм хост := хост.
}.

URL в: ['путь:'] сделать: { :путь
	бэйэм путь := ['/'] + путь url-кодировать.
}.

URL в: ['url-параметрдар:'] сделать: { :сөп-түбэһиннэрии
	>> url-параметрдар := Испииһэк саҥа.
	сөп-түбэһиннэрии хас-биирдии: { :күлүүс :суолта
		url-параметрдар эбэн-биэр: күлүүс к-тексту url-кодировать + ['='] + суолта к-тексту url-кодировать.
	}.
	бэйэм url-параметрдар := ['?'] + ( url-параметрдар присоединить: ['&'] ).
}.

URL в: ['хэш:'] сделать: { :hash
	бэйэм hash := ['#'] + hash url-кодировать.
}.

