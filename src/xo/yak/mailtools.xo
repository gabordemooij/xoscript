>> Электрон-сурук := Объект саҥа.

Электрон-сурук в: ['саҕалааһын'] сделать: {
	бэйэм ылааччылар := Испииһэк саҥа.
	бэйэм cc := Испииһэк саҥа.
	бэйэм bcc := Испииһэк саҥа.
	бэйэм ыытааччы := Кураанах.
	бэйэм ыытааччы-аата := Кураанах.
	бэйэм тиэмэ := Кураанах.
	бэйэм сүрүн-тиэкис := Кураанах.
}.

Электрон-сурук в: ['саҥа'] сделать: { <- бэйэ саҥа саҕалааһын.
}.

Электрон-сурук в: ['ылааччыга:'] сделать: { :ааҕыы
	бэйэм ылааччылар := ааҕыы.
}.
 
Электрон-сурук в: ['cc:'] сделать: { :ааҕыы
	бэйэм cc := ааҕыы.
}.

Электрон-сурук в: ['bcc:'] сделать: { :ааҕыы
	бэйэм bcc := ааҕыы.
}.

Электрон-сурук в: ['тиэмэ:'] сделать: { :тиэмэ
	бэйэм тиэмэ := тиэмэ.
}.

Электрон-сурук в: ['ыытааччы:аат:'] сделать: { :ыытааччы :аат
	бэйэм ыытааччы := ыытааччы.
	бэйэм ыытааччы-аата := аат.
}.

Электрон-сурук в: ['сүрүн-тиэкис:'] сделать: { :сүрүн-тиэкис
	бэйэм сүрүн-тиэкис := сүрүн-тиэкис.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Электрон-сурук в: ['баһылааһын:'] сделать: { :устуруока <- устуруока солбуй: ['\r'] на: [''], солбуй: ['\n'] на: [''].
}.

Электрон-сурук в: ['ыыт'] сделать: {
	>> f := Файл tempwrite: бэйэ айаа.
	Программа система: ['sendmail -t < '] + f путь, стоп.
}.

Электрон-сурук в: ['айаа'] сделать: {
	>> устуруока-быһыыта := ['\r\n'].
	>> устуруока-тиһиктэ := [''].
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['From: '] + бэйэм ыытааччы-аата + [' <'] + ( бэйэм ыытааччы ) + ['>']) + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['To: '] + ( бэйэм ылааччылар присоединить: [','] )) + устуруока-быһыыта.
	бэйэм cc счетчик даа: {
		устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Cc: '] + ( бэйэм cc присоединить: [','] )) + устуруока-быһыыта.
	}.
	бэйэм bcc счетчик даа: {
		устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Bcc: '] + ( бэйэм bcc присоединить: [','] )) + устуруока-быһыыта.
	}.
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Subject: '] + бэйэм тиэмэ) + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: бэйэм сүрүн-тиэкис.
	устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта. <- устуруока-тиһиктэ.
}.

>> HTML-Электрон-сурук := Электрон-сурук саҥа.

HTML-Электрон-сурук в: ['саҕалааһын'] сделать: {
	бэйэ саҕалааһын.
	бэйэм холбонуулар := Испииһэк саҥа.
	бэйэм кыраныыса := Сейф токен: 40.
}.

HTML-Электрон-сурук в: ['кыбытыннар:'] сделать: { :файл
	>> id := бэйэм холбонуулар счетчик.
	>> blob := файл blob.
	бэйэм холбонуулар эбэн-биэр: (
		Тылдьыт саҥа
			файл: файл путь,
			mime: ['image/'] + (Server mimetype: файл путь),
			дааннайдар: blob base64-кодировать
	).
	blob босхолоо. <- ['cid:attachment'] + id.
}.

HTML-Электрон-сурук в: ['айаа'] сделать: {
	>> устуруока-быһыыта := ['\r\n'].
	>> устуруока-тиһиктэ := [''].
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['From: '] + бэйэм ыытааччы-аата + [' <'] + ( бэйэм ыытааччы ) + ['>']) + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['To: '] + ( бэйэм ылааччылар присоединить: [','] )) + устуруока-быһыыта.
	бэйэм cc счетчик даа: {
		устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Cc: '] + ( бэйэм cc присоединить: [','] )) + устуруока-быһыыта.
	}.
	бэйэм bcc счетчик даа: {
		устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Bcc: '] + ( бэйэм bcc присоединить: [','] )) + устуруока-быһыыта.
	}.
	устуруока-тиһиктэ эбэн-биэр: (бэйэ баһылааһын: ['Subject: '] + бэйэм тиэмэ) + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: ['MIME-Version: 1.0'] + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: ['Content-Type: multipart/related; boundary="'] + бэйэм кыраныыса + ['"; type=text/html'] + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: ['--'] + бэйэм кыраныыса + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: ['Content-Type: text/html; charset=UTF-8'] + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: ['Content-Transfer-Encoding: 7bit'] + устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
	устуруока-тиһиктэ эбэн-биэр: бэйэм сүрүн-тиэкис.
	устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
	бэйэм холбонуулар хас-биирдии: { :id :сибидиэнньэ
		>> blob := сибидиэнньэ дааннайдар.
		устуруока-тиһиктэ эбэн-биэр: ['--'] + бэйэм кыраныыса + устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: ['Content-Type: '] + сибидиэнньэ mime + устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: ['Content-Transfer-Encoding: base64'] + устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: ['Content-ID: <attachment'] + id + ['>'] + устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: ['Content-Disposition: inline; filename="'] + сибидиэнньэ файл + ['"'] + устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
		>> саамай-элбэх := 76.
		>> тиэкис-уһуна := blob уһуна.
		>> кэрчиктэр := (тиэкис-уһуна / саамай-элбэх) үрдүк.
		{ :i
			>> кэрчик := blob скопировать от: i * саамай-элбэх уһуна: саамай-элбэх.
			устуруока-тиһиктэ эбэн-биэр: кэрчик + устуруока-быһыыта.
		} * кэрчиктэр.
		устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
		устуруока-тиһиктэ эбэн-биэр: устуруока-быһыыта.
	}.
	устуруока-тиһиктэ эбэн-биэр: ['--'] + бэйэм кыраныыса + ['--'] + устуруока-быһыыта. <- устуруока-тиһиктэ.
}.
