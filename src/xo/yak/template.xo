
# ~ Simple template engine ~

>> Халыып := Объект саҥа.

Халыып в: ['саҥа'] сделать: { <- бэйэ саҥа ис-хоһоон: [''].
}.

Халыып в: ['ис-хоһоон:'] сделать: { :ис-хоһоон
	бэйэм ис-хоһоон := ис-хоһоон. 
}.

Халыып в: ['саҥа:'] сделать: { :ис-хоһоон <- бэйэ саҥа ис-хоһоон: ис-хоһоон.
}.

Халыып в: ['быс:'] сделать: { :бэлиэ
	>> саҕаланыы-бэлиэтэ := (['<!-- cut:%id% -->'] %id%: бэлиэ).
	>> бүтэһик-бэлиэ := (['<!-- /cut:%id% -->'] %id%: бэлиэ).
	>> өлүүскэлэр := бэйэм ис-хоһоон чаастар: саҕаланыы-бэлиэтэ.
	>> префикс := өлүүскэлэр первый.
	>> өлүүскэлэр2 := өлүүскэлэр последний чаастар: бүтэһик-бэлиэ.
	>> сыһыарыы-ахсаан := өлүүскэлэр2 последний.
	>> өлүүскэ := өлүүскэлэр2 первый.
	>> ордук := префикс + сыһыарыы-ахсаан.
	бэйэм ис-хоһоон := ордук. <- Халыып саҥа: өлүүскэ.
	
}.

Халыып в: ['скопировать'] сделать: { <- бэйэ саҥа: бэйэ к-тексту скопировать.
}.
	
Халыып в: ['сыһыар:в:'] сделать: { :быһа-тардыы :id
	>> сыһыарыы-бэлиэтэ := (['<!-- paste:%id% -->'] %id%: id).
	бэйэм ис-хоһоон солбуй: сыһыарыы-бэлиэтэ на: ( быһа-тардыы к-тексту + сыһыарыы-бэлиэтэ ).
}.

Халыып в: ['туруор:суолта:'] сделать: { :миэстэ :суолта
	бэйэм ис-хоһоон солбуй: ['<!-- slot:'] + миэстэ + [' -->'] на: ( Server html-кодировать: суолта ).
}.

Халыып в: ['туруор:html:'] сделать: { :миэстэ :html
	бэйэм ис-хоһоон солбуй: ['<!-- slot:'] + миэстэ + [' -->'] на: html.
}.

Халыып в: ['хоруй:и:'] сделать: { :миэстэ :суолта
	бэйэ туруор: (миэстэ от: 0 уһуна: (миэстэ уһуна - 1)) суолта: суолта.
}.

Халыып в: ['nl2br'] сделать: {
	бэйэм ис-хоһоон солбуй: ['\n'] на: ['<br>'].
}.

Халыып в: ['бэрээдэктээ'] сделать: {
	бэйэм ис-хоһоон :=
		Шаблон
		саҥа: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		сөп-түбэһии: бэйэм ис-хоһоон
		оҥор: { <- ['']. }.
}.

Халыып в: ['быстарыылары-бэрээдэктээ'] сделать: {
	>> элеменнэр := Испииһэк саҥа.
	Шаблон
	саҥа: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	сөп-түбэһии: бэйэм ис-хоһоон
	оҥор: { :_ :өлүүскэ
		элеменнэр эбэн-биэр: өлүүскэ ? 1.
	}.
	элеменнэр хас-биирдии: { :_ :id
		бэйэм ис-хоһоон :=
			Шаблон саҥа: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			сөп-түбэһии: бэйэм ис-хоһоон
			оҥор: { <- ['']. }.
	 }.
}.

Халыып в: ['кураанахтары-бэрээдэктээ'] сделать: {
	бэйэм ис-хоһоон :=
		Шаблон
		саҥа: ['\\s*\\n'],
		сөп-түбэһии: бэйэм ис-хоһоон
		оҥор: { <- ['\n']. }.
	бэйэм ис-хоһоон :=
		Шаблон
		саҥа: ['\\n[\\s\\t]+'],
		сөп-түбэһии: бэйэм ис-хоһоон
		оҥор: { <- ['\n']. }.
}.

Халыып в: ['барытын-бэрээдэктээ'] сделать: {
	бэйэ бэрээдэктээ.
	бэйэ быстарыылары-бэрээдэктээ.
	бэйэ кураанахтары-бэрээдэктээ.
}.

Халыып в: ['к-тексту'] сделать: { <- бэйэм ис-хоһоон.
}.
