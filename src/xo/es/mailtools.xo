>> Email := Objeto crear.

Email al: ['iniciar'] hacer: {
	mi destinatarios := Lista crear.
	mi cc := Lista crear.
	mi bcc := Lista crear.
	mi remitente := Nulo.
	mi nombre-remitente := Nulo.
	mi asunto := Nulo.
	mi cuerpo := Nulo.
}.

Email al: ['crear'] hacer: { <- yo crear iniciar.
}.

Email al: ['destinatario:'] hacer: { :lista
	mi destinatarios := lista.
}.
 
Email al: ['cc:'] hacer: { :lista
	mi cc := lista.
}.

Email al: ['bcc:'] hacer: { :lista
	mi bcc := lista.
}.

Email al: ['asunto:'] hacer: { :asunto
	mi asunto := asunto.
}.

Email al: ['remitente:nombre:'] hacer: { :remitente :nombre
	mi remitente := remitente.
	mi nombre-remitente := nombre.
}.

Email al: ['cuerpo:'] hacer: { :cuerpo
	mi cuerpo := cuerpo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email al: ['cabezera:'] hacer: { :línea <- línea reemplazar: ['\r'] con: [''], reemplazar: ['\n'] con: [''].
}.

Email al: ['enviar'] hacer: {
	>> f := Archivo escritura-temporal: yo generar.
	Programa sistema: ['sendmail -t < '] + f ruta, detener.
}.

Email al: ['generar'] hacer: {
	>> salto := ['\r\n'].
	>> cadena := [''].
	cadena adjuntar: (yo cabezera: ['From: '] + mi nombre-remitente + [' <'] + ( mi remitente ) + ['>']) + salto.
	cadena adjuntar: (yo cabezera: ['To: '] + ( mi destinatarios unir: [','] )) + salto.
	mi cc contar verdadero: {
		cadena adjuntar: (yo cabezera: ['Cc: '] + ( mi cc unir: [','] )) + salto.
	}.
	mi bcc contar verdadero: {
		cadena adjuntar: (yo cabezera: ['Bcc: '] + ( mi bcc unir: [','] )) + salto.
	}.
	cadena adjuntar: (yo cabezera: ['Subject: '] + mi asunto) + salto.
	cadena adjuntar: salto.
	cadena adjuntar: mi cuerpo.
	cadena adjuntar: salto. <- cadena.
}.

>> HTML-Email := Email crear.

HTML-Email al: ['iniciar'] hacer: {
	yo iniciar.
	mi adjuntos := Lista crear.
	mi frontera := Contenedor-seguro token: 40.
}.

HTML-Email al: ['anexar:'] hacer: { :archivo
	>> id := mi adjuntos contar.
	>> blob := archivo blob.
	mi adjuntos adjuntar: (
		Diccionario crear
			archivo: archivo ruta,
			mime: ['image/'] + (Server tipo-mime: archivo ruta),
			datos: blob codificación-base64
	).
	blob liberar. <- ['cid:attachment'] + id.
}.

HTML-Email al: ['generar'] hacer: {
	>> salto := ['\r\n'].
	>> cadena := [''].
	cadena adjuntar: (yo cabezera: ['From: '] + mi nombre-remitente + [' <'] + ( mi remitente ) + ['>']) + salto.
	cadena adjuntar: (yo cabezera: ['To: '] + ( mi destinatarios unir: [','] )) + salto.
	mi cc contar verdadero: {
		cadena adjuntar: (yo cabezera: ['Cc: '] + ( mi cc unir: [','] )) + salto.
	}.
	mi bcc contar verdadero: {
		cadena adjuntar: (yo cabezera: ['Bcc: '] + ( mi bcc unir: [','] )) + salto.
	}.
	cadena adjuntar: (yo cabezera: ['Subject: '] + mi asunto) + salto.
	cadena adjuntar: ['MIME-Version: 1.0'] + salto.
	cadena adjuntar: ['Content-Type: multipart/related; boundary="'] + mi frontera + ['"; type=text/html'] + salto.
	cadena adjuntar: salto.
	cadena adjuntar: ['--'] + mi frontera + salto.
	cadena adjuntar: ['Content-Type: text/html; charset=UTF-8'] + salto.
	cadena adjuntar: ['Content-Transfer-Encoding: 7bit'] + salto.
	cadena adjuntar: salto.
	cadena adjuntar: mi cuerpo.
	cadena adjuntar: salto.
	mi adjuntos cada: { :id :info
		>> blob := info datos.
		cadena adjuntar: ['--'] + mi frontera + salto.
		cadena adjuntar: ['Content-Type: '] + info mime + salto.
		cadena adjuntar: ['Content-Transfer-Encoding: base64'] + salto.
		cadena adjuntar: ['Content-ID: <attachment'] + id + ['>'] + salto.
		cadena adjuntar: ['Content-Disposition: inline; filename="'] + info archivo + ['"'] + salto.
		cadena adjuntar: salto.
		>> tope := 76.
		>> longitud-texto := blob longitud.
		>> trozos := (longitud-texto / tope) redondear-alto.
		{ :i
			>> trozo := blob copiar desde: i * tope longitud: tope.
			cadena adjuntar: trozo + salto.
		} * trozos.
		cadena adjuntar: salto.
		cadena adjuntar: salto.
	}.
	cadena adjuntar: ['--'] + mi frontera + ['--'] + salto. <- cadena.
}.
