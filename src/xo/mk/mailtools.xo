>> Email := Објект нов.

Email при: ['init'] направи: {
	свој recipients := Листа нов.
	свој cc := Листа нов.
	свој bcc := Листа нов.
	свој from := Ништо.
	свој from-name := Ништо.
	свој subject := Ништо.
	свој body := Ништо.
}.

Email при: ['нов'] направи: { <- себе нов init.
}.

Email при: ['to:'] направи: { :list
	свој recipients := list.
}.
 
Email при: ['cc:'] направи: { :list
	свој cc := list.
}.

Email при: ['bcc:'] направи: { :list
	свој bcc := list.
}.

Email при: ['subject:'] направи: { :subject
	свој subject := subject.
}.

Email при: ['from:name:'] направи: { :from :име
	свој from := from.
	свој from-name := име.
}.

Email при: ['body:'] направи: { :body
	свој body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email при: ['header:'] направи: { :line <- line замени: ['\r'] со: [''], замени: ['\n'] со: [''].
}.

Email при: ['send'] направи: {
	>> f := Датотека tempwrite: себе generate.
	Програма систем: ['sendmail -t < '] + f патека, нов-ред.
}.

Email при: ['generate'] направи: {
	>> brk := ['\r\n'].
	>> str := [''].
	str додај-на-крај: (себе header: ['From: '] + свој from-name + [' <'] + ( свој from ) + ['>']) + brk.
	str додај-на-крај: (себе header: ['To: '] + ( свој recipients спои: [','] )) + brk.
	свој cc број-на-елементи точно: {
		str додај-на-крај: (себе header: ['Cc: '] + ( свој cc спои: [','] )) + brk.
	}.
	свој bcc број-на-елементи точно: {
		str додај-на-крај: (себе header: ['Bcc: '] + ( свој bcc спои: [','] )) + brk.
	}.
	str додај-на-крај: (себе header: ['Subject: '] + свој subject) + brk.
	str додај-на-крај: brk.
	str додај-на-крај: свој body.
	str додај-на-крај: brk. <- str.
}.

>> HTML-Email := Email нов.

HTML-Email при: ['init'] направи: {
	себе init.
	свој attachments := Листа нов.
	свој boundary := Сеф токен: 40.
}.

HTML-Email при: ['attach:'] направи: { :file
	>> id := свој attachments број-на-елементи.
	>> blob := file blob.
	свој attachments додај-на-крај: (
		Речник нов
			file: file патека,
			mime: ['image/'] + (Server mimetype: file патека),
			data: blob base64-кодирај
	).
	blob ослободи. <- ['cid:attachment'] + id.
}.

HTML-Email при: ['generate'] направи: {
	>> brk := ['\r\n'].
	>> str := [''].
	str додај-на-крај: (себе header: ['From: '] + свој from-name + [' <'] + ( свој from ) + ['>']) + brk.
	str додај-на-крај: (себе header: ['To: '] + ( свој recipients спои: [','] )) + brk.
	свој cc број-на-елементи точно: {
		str додај-на-крај: (себе header: ['Cc: '] + ( свој cc спои: [','] )) + brk.
	}.
	свој bcc број-на-елементи точно: {
		str додај-на-крај: (себе header: ['Bcc: '] + ( свој bcc спои: [','] )) + brk.
	}.
	str додај-на-крај: (себе header: ['Subject: '] + свој subject) + brk.
	str додај-на-крај: ['MIME-Version: 1.0'] + brk.
	str додај-на-крај: ['Content-Type: multipart/related; boundary="'] + свој boundary + ['"; type=text/html'] + brk.
	str додај-на-крај: brk.
	str додај-на-крај: ['--'] + свој boundary + brk.
	str додај-на-крај: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str додај-на-крај: ['Content-Transfer-Encoding: 7bit'] + brk.
	str додај-на-крај: brk.
	str додај-на-крај: свој body.
	str додај-на-крај: brk.
	свој attachments секој: { :id :info
		>> blob := info data.
		str додај-на-крај: ['--'] + свој boundary + brk.
		str додај-на-крај: ['Content-Type: '] + info mime + brk.
		str додај-на-крај: ['Content-Transfer-Encoding: base64'] + brk.
		str додај-на-крај: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str додај-на-крај: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str додај-на-крај: brk.
		>> max := 76.
		>> len := blob должина.
		>> chunks := (len / max) заокружи-нагоре.
		{ :i
			>> chunk := blob копирај од: i * max должина: max.
			str додај-на-крај: chunk + brk.
		} * chunks.
		str додај-на-крај: brk.
		str додај-на-крај: brk.
	}.
	str додај-на-крај: ['--'] + свој boundary + ['--'] + brk. <- str.
}.
