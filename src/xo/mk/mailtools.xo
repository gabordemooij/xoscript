>> Е-пошта := Објект нов.

Е-пошта при: ['иницијализирај'] направи: {
	свој примачи := Листа нов.
	свој cc := Листа нов.
	свој bcc := Листа нов.
	свој испраќач := Ништо.
	свој име-испраќач := Ништо.
	свој тема := Ништо.
	свој тело := Ништо.
}.

Е-пошта при: ['нов'] направи: { <- себе нов иницијализирај.
}.

Е-пошта при: ['примач:'] направи: { :набројување
	свој примачи := набројување.
}.
 
Е-пошта при: ['cc:'] направи: { :набројување
	свој cc := набројување.
}.

Е-пошта при: ['bcc:'] направи: { :набројување
	свој bcc := набројување.
}.

Е-пошта при: ['тема:'] направи: { :тема
	свој тема := тема.
}.

Е-пошта при: ['испраќач:име:'] направи: { :испраќач :име
	свој испраќач := испраќач.
	свој име-испраќач := име.
}.

Е-пошта при: ['тело:'] направи: { :тело
	свој тело := тело.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Е-пошта при: ['заглавие:'] направи: { :ред <- ред замени: ['\r'] со: [''], замени: ['\n'] со: [''].
}.

Е-пошта при: ['испрати'] направи: {
	>> f := Датотека tempwrite: себе генерирај.
	Програма систем: ['sendmail -t < '] + f патека, нов-ред.
}.

Е-пошта при: ['генерирај'] направи: {
	>> прекин := ['\r\n'].
	>> низа := [''].
	низа додај-на-крај: (себе заглавие: ['From: '] + свој име-испраќач + [' <'] + ( свој испраќач ) + ['>']) + прекин.
	низа додај-на-крај: (себе заглавие: ['To: '] + ( свој примачи спои: [','] )) + прекин.
	свој cc број-на-елементи точно: {
		низа додај-на-крај: (себе заглавие: ['Cc: '] + ( свој cc спои: [','] )) + прекин.
	}.
	свој bcc број-на-елементи точно: {
		низа додај-на-крај: (себе заглавие: ['Bcc: '] + ( свој bcc спои: [','] )) + прекин.
	}.
	низа додај-на-крај: (себе заглавие: ['Subject: '] + свој тема) + прекин.
	низа додај-на-крај: прекин.
	низа додај-на-крај: свој тело.
	низа додај-на-крај: прекин. <- низа.
}.

>> HTML-Е-пошта := Е-пошта нов.

HTML-Е-пошта при: ['иницијализирај'] направи: {
	себе иницијализирај.
	свој прилози := Листа нов.
	свој граница := Сеф токен: 40.
}.

HTML-Е-пошта при: ['прикачи:'] направи: { :датотека
	>> id := свој прилози број-на-елементи.
	>> blob := датотека blob.
	свој прилози додај-на-крај: (
		Речник нов
			датотека: датотека патека,
			mime: ['image/'] + (Server mimetype: датотека патека),
			податоци: blob base64-кодирај
	).
	blob ослободи. <- ['cid:attachment'] + id.
}.

HTML-Е-пошта при: ['генерирај'] направи: {
	>> прекин := ['\r\n'].
	>> низа := [''].
	низа додај-на-крај: (себе заглавие: ['From: '] + свој име-испраќач + [' <'] + ( свој испраќач ) + ['>']) + прекин.
	низа додај-на-крај: (себе заглавие: ['To: '] + ( свој примачи спои: [','] )) + прекин.
	свој cc број-на-елементи точно: {
		низа додај-на-крај: (себе заглавие: ['Cc: '] + ( свој cc спои: [','] )) + прекин.
	}.
	свој bcc број-на-елементи точно: {
		низа додај-на-крај: (себе заглавие: ['Bcc: '] + ( свој bcc спои: [','] )) + прекин.
	}.
	низа додај-на-крај: (себе заглавие: ['Subject: '] + свој тема) + прекин.
	низа додај-на-крај: ['MIME-Version: 1.0'] + прекин.
	низа додај-на-крај: ['Content-Type: multipart/related; boundary="'] + свој граница + ['"; type=text/html'] + прекин.
	низа додај-на-крај: прекин.
	низа додај-на-крај: ['--'] + свој граница + прекин.
	низа додај-на-крај: ['Content-Type: text/html; charset=UTF-8'] + прекин.
	низа додај-на-крај: ['Content-Transfer-Encoding: 7bit'] + прекин.
	низа додај-на-крај: прекин.
	низа додај-на-крај: свој тело.
	низа додај-на-крај: прекин.
	свој прилози секој: { :id :инфо
		>> blob := инфо податоци.
		низа додај-на-крај: ['--'] + свој граница + прекин.
		низа додај-на-крај: ['Content-Type: '] + инфо mime + прекин.
		низа додај-на-крај: ['Content-Transfer-Encoding: base64'] + прекин.
		низа додај-на-крај: ['Content-ID: <attachment'] + id + ['>'] + прекин.
		низа додај-на-крај: ['Content-Disposition: inline; filename="'] + инфо датотека + ['"'] + прекин.
		низа додај-на-крај: прекин.
		>> најмногу := 76.
		>> должина-текст := blob должина.
		>> парчиња := (должина-текст / најмногу) заокружи-нагоре.
		{ :i
			>> парче := blob копирај од: i * најмногу должина: најмногу.
			низа додај-на-крај: парче + прекин.
		} * парчиња.
		низа додај-на-крај: прекин.
		низа додај-на-крај: прекин.
	}.
	низа додај-на-крај: ['--'] + свој граница + ['--'] + прекин. <- низа.
}.
