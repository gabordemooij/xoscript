HTTP-Барање при: ['HTTP-заглавие:'] направи: { :клуч <- Програма поставка: клуч.
}.

>> HTTP-Заглавие := Објект нов.

HTTP-Заглавие при: ['нов'] направи: { <- себе нов иницијализирај.
}.

HTTP-Заглавие при: ['иницијализирај'] направи: {
	свој клуч := Ништо.
	свој вредност := Ништо.
}.

HTTP-Заглавие при: ['клуч:вредност:'] направи: { :клуч :вредност
	свој клуч := клуч.
	свој вредност := вредност.
}.

HTTP-Заглавие при: ['клуч'] направи: { <- свој клуч.
}.

HTTP-Заглавие при: ['вредност'] направи: { <- свој вредност.
}.


HTTP-Заглавие при: ['текст'] направи: {
	>> ред := свој клуч + [': '] + свој вредност.
	ред замени: ['\r'] со: [''], замени: ['\n'] со: ['']. <- ред + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Објект нов.

Веб-документ при: ['нов'] направи: { <- себе нов иницијализирај.
}.

Веб-документ при: ['иницијализирај'] направи: {
	свој заглавија := Листа нов.
	свој ид-сесија := Ништо.
	свој управувач-сесии := Сесија-привремена-датотека нов.
	свој податоци-сесија := Ништо.
	свој безбедно := Точно.
	свој иста-локација := ['Strict'].
	свој заглавија-испратени := Неточно.
	свој http-барање := HTTP-Барање нов.
}.

Веб-документ при: ['http-барање:'] направи: { :http-барање
	свој http-барање := http-барање.
}. 

Веб-документ при: ['безбедно-колаче-сесија:'] направи: { :безбедно
	себе провери-заглавија.
	свој безбедно := безбедно.
}.

Веб-документ при: ['колаче-сесија-иста-локација:'] направи: { :вредност
	себе провери-заглавија.
	>> опции := Листа нов 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опции има: вредност, неточно: {
		оваа-задача грешка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	свој иста-локација := вредност.
}.

Веб-документ при: ['заглавие:'] направи: { :заглавие
	себе провери-заглавија.
	свој заглавија додај-на-крај: заглавие.
}.

Веб-документ при: ['испразни-заглавија'] направи: {
	себе провери-заглавија.
	свој заглавија := Листа нов.
}.

Веб-документ при: ['управувач-сесии:'] направи: { :управувач
	себе провери-заглавија.
	свој управувач-сесии := управувач.
}.

Веб-документ при: ['управувач-сесии'] направи: { <- свој управувач-сесии.
}.

Веб-документ при: ['провери-заглавија'] направи: {
	свој заглавија-испратени точно: {
		оваа-задача грешка: ['Headers already sent to client.'].
	}.
}.

Веб-документ при: ['започни-сесија'] направи: {
	себе провери-заглавија.
	>> http-барање := свој http-барање.
	>> ид-сесија := http-барање cookie: ['xsid'].
	ид-сесија Ништо? неточно: {
		(( Шаблон нов: ['^[A-Za-z0-9]+\\z'], совпаѓање: ид-сесија ) = 0) точно: {
			ид-сесија := Ништо.
		}.
	}.
	ид-сесија Ништо? точно: {
		ид-сесија := Сеф токен: 30.
		>> заглавие-сесија := HTTP-Заглавие нов
		клуч: ['Set-Cookie'] вредност: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (свој безбедно или: ['Secure'] или: ['']),
		SSITE: (свој иста-локација),
		XSID: ид-сесија
		).
		свој заглавија додај-на-крај: заглавие-сесија.
	}.
	свој податоци-сесија := свој управувач-сесии за: ид-сесија, вчитај. <- свој податоци-сесија. # reference
}.

Веб-документ при: ['оди-на:'] направи: { :адреса
	себе провери-заглавија.
	себе испразни-заглавија.
	свој заглавија
	додај-на-крај: (
		HTTP-Заглавие нов
		клуч: ['Status'] вредност: ['303 See Other']
	),
	додај-на-крај: (
		HTTP-Заглавие нов
		клуч: ['Location'] вредност: адреса
	).
	себе испиши: ['Redirect'].
}.

Веб-документ при: ['уништи-сесија'] направи: {
	себе провери-заглавија.
	>> http-барање := свој http-барање.
	>> ид-сесија := http-барање cookie: ['xsid'].
	ид-сесија Ништо? неточно: {
		>> заглавие-сесија := HTTP-Заглавие нов.
		>> момент := Момент нов година: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		заглавие-сесија клуч: ['Set-Cookie'] вредност: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: момент,
			SEC: (свој безбедно или: ['Secure'] или: ['']),
			SSITE: (свој иста-локација),
			XSID: ид-сесија
		).
		свој управувач-сесии уништи.
		свој заглавија додај-на-крај: заглавие-сесија.
	}.
}.


Веб-документ при: ['образец:'] направи: { :патека <- Образец нов: (Датотека нов: патека, читај).
}.

Веб-документ при: ['испиши:тип:'] направи: { :излез :тип
	свој заглавија-испратени неточно: {
		свој податоци-сесија Ништо? неточно: {
			свој управувач-сесии зачувај: свој податоци-сесија.
		}.
		свој заглавија додај-на-крај: (
			HTTP-Заглавие нов
			клуч: ['Content-type'] вредност: тип
		).
		свој заглавија секој: { :_ :заглавие
			Излез напиши: заглавие.
		}.
		свој заглавија-испратени := Точно.
		Излез напиши: ['\r\n'].
	}.
	Излез напиши: излез.
}.

Веб-документ при: ['заврши:тип:'] направи: { :излез :тип
	свој заглавија-испратени неточно: {
		свој податоци-сесија Ништо? неточно: {
			свој управувач-сесии зачувај: свој податоци-сесија.
		}.
		свој заглавија додај-на-крај: (
			HTTP-Заглавие нов
			клуч: ['Content-type'] вредност: тип
		).
		свој заглавија додај-на-крај: (
			HTTP-Заглавие нов
			клуч: ['Content-Length'] вредност: излез текст bytes
		).
		свој заглавија секој: { :_ :заглавие
			Излез напиши: заглавие.
		}.
		свој заглавија-испратени := Точно.
		Излез напиши: ['\r\n'].
	}.
	Излез напиши: излез.
}.

Веб-документ при: ['испиши:'] направи: { :излез
	себе испиши: излез тип: ['text/html; charset=utf-8'].
}.

Веб-документ при: ['заврши:'] направи: { :излез
	себе заврши: излез тип: ['text/html; charset=utf-8'].
}.

Веб-документ при: ['json:'] направи: { :излез
	себе испиши: ( JSON jsonify: излез ) тип: ['application/json'].
}.

Веб-документ при: ['не-е-пронајдено:'] направи: { :излез
	себе испразни-заглавија заглавие: (
		HTTP-Заглавие нов клуч: ['Status'] вредност: ['404 Not Found']
	).
	себе испиши: излез.
}.


# Interface

>> Сесија := Објект нов.

Сесија при: ['нов'] направи: { <- себе нов иницијализирај за: Ништо.
}.

Сесија при: ['за:'] направи: { :id
	свој id := id.
}.

Сесија при: ['вчитај'] направи: {
	оваа-задача грешка: ['Not implemented.'].
}.

Сесија при: ['зачувај:'] направи: {
	оваа-задача грешка: ['Not implemented.'].
}.

Сесија при: ['уништи'] направи: {
	оваа-задача грешка: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сесија-привремена-датотека := Сесија нов.

Сесија-привремена-датотека при: ['иницијализирај'] направи: {
	свој почеток-патека := ['/tmp/sess-'].
}.

Сесија-привремена-датотека при: ['префикс-патека:'] направи: { :низа
	свој почеток-патека := низа.
}.

Сесија-привремена-датотека при: ['датотека'] направи: { <- ( Датотека нов: ( свој почеток-патека + свој id + ['.txt'] ) ).
}.

Сесија-привремена-датотека при: ['вчитај'] направи: {
	>> датотека := себе датотека.
	датотека постои неточно: {
		датотека напиши: (Речник нов код).
	}. <- датотека читај објект.
}.

Сесија-привремена-датотека при: ['зачувај:'] направи: { :податоци
	>> датотека := себе датотека.
	датотека постои точно: {
		датотека напиши: податоци код.
	}.
}.

Сесија-привремена-датотека при: ['уништи'] направи: {
	>> датотека := себе датотека.
	датотека постои точно: {
		датотека избриши.
	}.
}.


>> URL := Објект нов.

URL при: ['иницијализирај'] направи: {
	свој протокол := ['https://'].
	свој домаќин := ['localhost'].
	свој патека := [''].
	свој параметри-url := [''].
	свој hash := [''].
}.

URL при: ['нов'] направи: { <- себе нов иницијализирај.
}.

URL при: ['текст'] направи: { <- (
	свој протокол +
	свој домаќин +
	свој патека +
	свој параметри-url +
	свој hash ).
}.

URL при: ['протокол:'] направи: { :протокол
	((Листа нов ; ['http'] ; ['https']) има: протокол) точно: {
		свој протокол := протокол + ['://'].
	}, неточно: {
		оваа-задача грешка: ['Invalid protocol'].
	}.
}.

URL при: ['домаќин:'] направи: { :домаќин
	#todo validate according to rfc
	свој домаќин := домаќин.
}.

URL при: ['патека:'] направи: { :патека
	свој патека := ['/'] + патека url-кодирај.
}.

URL при: ['параметри-url:'] направи: { :мапирање
	>> параметри-url := Листа нов.
	мапирање секој: { :клуч :вредност
		параметри-url додај-на-крај: клуч текст url-кодирај + ['='] + вредност текст url-кодирај.
	}.
	свој параметри-url := ['?'] + ( параметри-url спои: ['&'] ).
}.

URL при: ['хеш:'] направи: { :hash
	свој hash := ['#'] + hash url-кодирај.
}.

