
# ~ Simple template engine ~

>> Образец := Објект нов.

Образец при: ['нов'] направи: { <- себе нов содржина: [''].
}.

Образец при: ['содржина:'] направи: { :содржина
	свој содржина := содржина. 
}.

Образец при: ['нов:'] направи: { :содржина <- себе нов содржина: содржина.
}.

Образец при: ['исечи:'] направи: { :ознака
	>> почетна-ознака := (['<!-- cut:%id% -->'] %id%: ознака).
	>> крајна-ознака := (['<!-- /cut:%id% -->'] %id%: ознака).
	>> делови := свој содржина подели: почетна-ознака.
	>> префикс := делови прв.
	>> делови2 := делови последен подели: крајна-ознака.
	>> суфикс := делови2 последен.
	>> дел := делови2 прв.
	>> остаток := префикс + суфикс.
	свој содржина := остаток. <- Образец нов: дел.
	
}.

Образец при: ['копирај'] направи: { <- себе нов: себе текст копирај.
}.
	
Образец при: ['залепи:на:'] направи: { :исечок :id
	>> ознака-лепење := (['<!-- paste:%id% -->'] %id%: id).
	свој содржина замени: ознака-лепење со: ( исечок текст + ознака-лепење ).
}.

Образец при: ['постави:вредност:'] направи: { :место :вредност
	свој содржина замени: ['<!-- slot:'] + место + [' -->'] со: ( Server html-кодирај: вредност ).
}.

Образец при: ['постави:html:'] направи: { :место :html
	свој содржина замени: ['<!-- slot:'] + место + [' -->'] со: html.
}.

Образец при: ['одговори:и:'] направи: { :место :вредност
	себе постави: (место од: 0 должина: (место должина - 1)) вредност: вредност.
}.

Образец при: ['nl2br'] направи: {
	свој содржина замени: ['\n'] со: ['<br>'].
}.

Образец при: ['расчисти'] направи: {
	свој содржина :=
		Шаблон
		нов: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		совпаѓање: свој содржина
		направи: { <- ['']. }.
}.

Образец при: ['расчисти-исечоци'] направи: {
	>> ставки := Листа нов.
	Шаблон
	нов: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	совпаѓање: свој содржина
	направи: { :_ :дел
		ставки додај-на-крај: дел ? 1.
	}.
	ставки секој: { :_ :id
		свој содржина :=
			Шаблон нов: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			совпаѓање: свој содржина
			направи: { <- ['']. }.
	 }.
}.

Образец при: ['расчисти-празнини'] направи: {
	свој содржина :=
		Шаблон
		нов: ['\\s*\\n'],
		совпаѓање: свој содржина
		направи: { <- ['\n']. }.
	свој содржина :=
		Шаблон
		нов: ['\\n[\\s\\t]+'],
		совпаѓање: свој содржина
		направи: { <- ['\n']. }.
}.

Образец при: ['расчисти-сè'] направи: {
	себе расчисти.
	себе расчисти-исечоци.
	себе расчисти-празнини.
}.

Образец при: ['текст'] направи: { <- свој содржина.
}.
