HTTP-Haýyş gelende: ['HTTP-sözbaşy:'] et: { :açar <- Programma sazlama: açar.
}.

>> HTTP-Sözbaşy := Obýekt täze.

HTTP-Sözbaşy gelende: ['täze'] et: { <- özi täze başlat.
}.

HTTP-Sözbaşy gelende: ['başlat'] et: {
	öz açar := Boş.
	öz baha := Boş.
}.

HTTP-Sözbaşy gelende: ['açar:baha:'] et: { :açar :baha
	öz açar := açar.
	öz baha := baha.
}.

HTTP-Sözbaşy gelende: ['açar'] et: { <- öz açar.
}.

HTTP-Sözbaşy gelende: ['baha'] et: { <- öz baha.
}.


HTTP-Sözbaşy gelende: ['tekst'] et: {
	>> setir := öz açar + [': '] + öz baha.
	setir çalyş: ['\r'] bilen: [''], çalyş: ['\n'] bilen: ['']. <- setir + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-resminama := Obýekt täze.

Web-resminama gelende: ['täze'] et: { <- özi täze başlat.
}.

Web-resminama gelende: ['başlat'] et: {
	öz sözbaşylar := Sanaw täze.
	öz sessiýa-id := Boş.
	öz sessiýa-dolandyryjy := Wagtlaýyn-faýl-sessiýasy täze.
	öz sessiýa-maglumatlary := Boş.
	öz howpsuz := Dogry.
	öz şol-bir-saýt := ['Strict'].
	öz sözbaşylar-iberildi := Ýalňyş.
	öz haýyş := HTTP-Haýyş täze.
}.

Web-resminama gelende: ['haýyş:'] et: { :haýyş
	öz haýyş := haýyş.
}. 

Web-resminama gelende: ['howpsuz-sessiýa-kukisi:'] et: { :howpsuz
	özi sözbaşylary-barla.
	öz howpsuz := howpsuz.
}.

Web-resminama gelende: ['şol-bir-saýt-sessiýa-kukisi:'] et: { :baha
	özi sözbaşylary-barla.
	>> opsiýalar := Sanaw täze 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsiýalar bar: baha, ýalňyş: {
		şu-wezipe ýalňyşlyk: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	öz şol-bir-saýt := baha.
}.

Web-resminama gelende: ['sözbaşy:'] et: { :sözbaşy
	özi sözbaşylary-barla.
	öz sözbaşylar soňuna-goş: sözbaşy.
}.

Web-resminama gelende: ['sözbaşylary-boşat'] et: {
	özi sözbaşylary-barla.
	öz sözbaşylar := Sanaw täze.
}.

Web-resminama gelende: ['sessiýa-dolandyryjy:'] et: { :dolandyryjy
	özi sözbaşylary-barla.
	öz sessiýa-dolandyryjy := dolandyryjy.
}.

Web-resminama gelende: ['sessiýa-dolandyryjy'] et: { <- öz sessiýa-dolandyryjy.
}.

Web-resminama gelende: ['sözbaşylary-barla'] et: {
	öz sözbaşylar-iberildi dogry: {
		şu-wezipe ýalňyşlyk: ['Headers already sent to client.'].
	}.
}.

Web-resminama gelende: ['sessiýany-başla'] et: {
	özi sözbaşylary-barla.
	>> haýyş := öz haýyş.
	>> sessiýa-id := haýyş cookie: ['xsid'].
	sessiýa-id Boş? ýalňyş: {
		(( Nusga täze: ['^[A-Za-z0-9]+\\z'], gabat-gelme: sessiýa-id ) = 0) dogry: {
			sessiýa-id := Boş.
		}.
	}.
	sessiýa-id Boş? dogry: {
		sessiýa-id := Seýf token: 30.
		>> sessiýa-sözbaşysy := HTTP-Sözbaşy täze
		açar: ['Set-Cookie'] baha: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (öz howpsuz ýa: ['Secure'] ýa-da: ['']),
		SSITE: (öz şol-bir-saýt),
		XSID: sessiýa-id
		).
		öz sözbaşylar soňuna-goş: sessiýa-sözbaşysy.
	}.
	öz sessiýa-maglumatlary := öz sessiýa-dolandyryjy üçin: sessiýa-id, ýükle. <- öz sessiýa-maglumatlary. # reference
}.

Web-resminama gelende: ['geç:'] et: { :salgy
	özi sözbaşylary-barla.
	özi sözbaşylary-boşat.
	öz sözbaşylar
	soňuna-goş: (
		HTTP-Sözbaşy täze
		açar: ['Status'] baha: ['303 See Other']
	),
	soňuna-goş: (
		HTTP-Sözbaşy täze
		açar: ['Location'] baha: salgy
	).
	özi çykar: ['Redirect'].
}.

Web-resminama gelende: ['sessiýany-ýok-et'] et: {
	özi sözbaşylary-barla.
	>> haýyş := öz haýyş.
	>> sessiýa-id := haýyş cookie: ['xsid'].
	sessiýa-id Boş? ýalňyş: {
		>> sessiýa-sözbaşysy := HTTP-Sözbaşy täze.
		>> pursat := Pursat täze ýyl: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessiýa-sözbaşysy açar: ['Set-Cookie'] baha: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: pursat,
			SEC: (öz howpsuz ýa: ['Secure'] ýa-da: ['']),
			SSITE: (öz şol-bir-saýt),
			XSID: sessiýa-id
		).
		öz sessiýa-dolandyryjy ýok-et.
		öz sözbaşylar soňuna-goş: sessiýa-sözbaşysy.
	}.
}.


Web-resminama gelende: ['şablon:'] et: { :ýol <- Şablon täze: (Faýl täze: ýol, oka).
}.

Web-resminama gelende: ['çykar:görnüş:'] et: { :netije :görnüş
	öz sözbaşylar-iberildi ýalňyş: {
		öz sessiýa-maglumatlary Boş? ýalňyş: {
			öz sessiýa-dolandyryjy sakla: öz sessiýa-maglumatlary.
		}.
		öz sözbaşylar soňuna-goş: (
			HTTP-Sözbaşy täze
			açar: ['Content-type'] baha: görnüş
		).
		öz sözbaşylar her: { :_ :sözbaşy
			Çykyş ýaz: sözbaşy.
		}.
		öz sözbaşylar-iberildi := Dogry.
		Çykyş ýaz: ['\r\n'].
	}.
	Çykyş ýaz: netije.
}.

Web-resminama gelende: ['tamamla:görnüş:'] et: { :netije :görnüş
	öz sözbaşylar-iberildi ýalňyş: {
		öz sessiýa-maglumatlary Boş? ýalňyş: {
			öz sessiýa-dolandyryjy sakla: öz sessiýa-maglumatlary.
		}.
		öz sözbaşylar soňuna-goş: (
			HTTP-Sözbaşy täze
			açar: ['Content-type'] baha: görnüş
		).
		öz sözbaşylar soňuna-goş: (
			HTTP-Sözbaşy täze
			açar: ['Content-Length'] baha: netije tekst bytes
		).
		öz sözbaşylar her: { :_ :sözbaşy
			Çykyş ýaz: sözbaşy.
		}.
		öz sözbaşylar-iberildi := Dogry.
		Çykyş ýaz: ['\r\n'].
	}.
	Çykyş ýaz: netije.
}.

Web-resminama gelende: ['çykar:'] et: { :netije
	özi çykar: netije görnüş: ['text/html; charset=utf-8'].
}.

Web-resminama gelende: ['tamamla:'] et: { :netije
	özi tamamla: netije görnüş: ['text/html; charset=utf-8'].
}.

Web-resminama gelende: ['json:'] et: { :netije
	özi çykar: ( JSON jsonify: netije ) görnüş: ['application/json'].
}.

Web-resminama gelende: ['tapylmady:'] et: { :netije
	özi sözbaşylary-boşat sözbaşy: (
		HTTP-Sözbaşy täze açar: ['Status'] baha: ['404 Not Found']
	).
	özi çykar: netije.
}.


# Interface

>> Sessiýa := Obýekt täze.

Sessiýa gelende: ['täze'] et: { <- özi täze başlat üçin: Boş.
}.

Sessiýa gelende: ['üçin:'] et: { :id
	öz id := id.
}.

Sessiýa gelende: ['ýükle'] et: {
	şu-wezipe ýalňyşlyk: ['Not implemented.'].
}.

Sessiýa gelende: ['sakla:'] et: {
	şu-wezipe ýalňyşlyk: ['Not implemented.'].
}.

Sessiýa gelende: ['ýok-et'] et: {
	şu-wezipe ýalňyşlyk: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Wagtlaýyn-faýl-sessiýasy := Sessiýa täze.

Wagtlaýyn-faýl-sessiýasy gelende: ['başlat'] et: {
	öz ýol-başy := ['/tmp/sess-'].
}.

Wagtlaýyn-faýl-sessiýasy gelende: ['ýol-prefiksi:'] et: { :setir-zynjyry
	öz ýol-başy := setir-zynjyry.
}.

Wagtlaýyn-faýl-sessiýasy gelende: ['faýl'] et: { <- ( Faýl täze: ( öz ýol-başy + öz id + ['.txt'] ) ).
}.

Wagtlaýyn-faýl-sessiýasy gelende: ['ýükle'] et: {
	>> faýl := özi faýl.
	faýl bar ýalňyş: {
		faýl ýaz: (Sözlük täze kod).
	}. <- faýl oka obýekt.
}.

Wagtlaýyn-faýl-sessiýasy gelende: ['sakla:'] et: { :maglumatlar
	>> faýl := özi faýl.
	faýl bar dogry: {
		faýl ýaz: maglumatlar kod.
	}.
}.

Wagtlaýyn-faýl-sessiýasy gelende: ['ýok-et'] et: {
	>> faýl := özi faýl.
	faýl bar dogry: {
		faýl poz.
	}.
}.


>> URL := Obýekt täze.

URL gelende: ['başlat'] et: {
	öz protokol := ['https://'].
	öz host := ['localhost'].
	öz ýol := [''].
	öz url-parametrler := [''].
	öz hash := [''].
}.

URL gelende: ['täze'] et: { <- özi täze başlat.
}.

URL gelende: ['tekst'] et: { <- (
	öz protokol +
	öz host +
	öz ýol +
	öz url-parametrler +
	öz hash ).
}.

URL gelende: ['protokol:'] et: { :protokol
	((Sanaw täze ; ['http'] ; ['https']) bar: protokol) dogry: {
		öz protokol := protokol + ['://'].
	}, ýalňyş: {
		şu-wezipe ýalňyşlyk: ['Invalid protocol'].
	}.
}.

URL gelende: ['host:'] et: { :host
	#todo validate according to rfc
	öz host := host.
}.

URL gelende: ['ýol:'] et: { :ýol
	öz ýol := ['/'] + ýol url-kodla.
}.

URL gelende: ['url-parametrler:'] et: { :gabat-getirme
	>> url-parametrler := Sanaw täze.
	gabat-getirme her: { :açar :baha
		url-parametrler soňuna-goş: açar tekst url-kodla + ['='] + baha tekst url-kodla.
	}.
	öz url-parametrler := ['?'] + ( url-parametrler birleşdir: ['&'] ).
}.

URL gelende: ['heş:'] et: { :hash
	öz hash := ['#'] + hash url-kodla.
}.

