>> E-poçta := Obýekt täze.

E-poçta gelende: ['başlat'] et: {
	öz alyjylar := Sanaw täze.
	öz cc := Sanaw täze.
	öz bcc := Sanaw täze.
	öz iberiji := Boş.
	öz iberijiniň-ady := Boş.
	öz tema := Boş.
	öz beden := Boş.
}.

E-poçta gelende: ['täze'] et: { <- özi täze başlat.
}.

E-poçta gelende: ['alyja:'] et: { :sanaw-elementler
	öz alyjylar := sanaw-elementler.
}.
 
E-poçta gelende: ['cc:'] et: { :sanaw-elementler
	öz cc := sanaw-elementler.
}.

E-poçta gelende: ['bcc:'] et: { :sanaw-elementler
	öz bcc := sanaw-elementler.
}.

E-poçta gelende: ['tema:'] et: { :tema
	öz tema := tema.
}.

E-poçta gelende: ['iberiji:at:'] et: { :iberiji :at
	öz iberiji := iberiji.
	öz iberijiniň-ady := at.
}.

E-poçta gelende: ['beden:'] et: { :beden
	öz beden := beden.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-poçta gelende: ['sözbaşy:'] et: { :setir <- setir çalyş: ['\r'] bilen: [''], çalyş: ['\n'] bilen: [''].
}.

E-poçta gelende: ['iber'] et: {
	>> f := Faýl tempwrite: özi döret.
	Programma ulgam: ['sendmail -t < '] + f ýol, täze-setir.
}.

E-poçta gelende: ['döret'] et: {
	>> setir-arakesmesi := ['\r\n'].
	>> setir-zynjyry := [''].
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['From: '] + öz iberijiniň-ady + [' <'] + ( öz iberiji ) + ['>']) + setir-arakesmesi.
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['To: '] + ( öz alyjylar birleşdir: [','] )) + setir-arakesmesi.
	öz cc sany dogry: {
		setir-zynjyry soňuna-goş: (özi sözbaşy: ['Cc: '] + ( öz cc birleşdir: [','] )) + setir-arakesmesi.
	}.
	öz bcc sany dogry: {
		setir-zynjyry soňuna-goş: (özi sözbaşy: ['Bcc: '] + ( öz bcc birleşdir: [','] )) + setir-arakesmesi.
	}.
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['Subject: '] + öz tema) + setir-arakesmesi.
	setir-zynjyry soňuna-goş: setir-arakesmesi.
	setir-zynjyry soňuna-goş: öz beden.
	setir-zynjyry soňuna-goş: setir-arakesmesi. <- setir-zynjyry.
}.

>> HTML-E-poçta := E-poçta täze.

HTML-E-poçta gelende: ['başlat'] et: {
	özi başlat.
	öz goşundylar := Sanaw täze.
	öz serhet := Seýf token: 40.
}.

HTML-E-poçta gelende: ['goşundy-goş:'] et: { :faýl
	>> id := öz goşundylar sany.
	>> blob := faýl blob.
	öz goşundylar soňuna-goş: (
		Sözlük täze
			faýl: faýl ýol,
			mime: ['image/'] + (Server mimetype: faýl ýol),
			maglumatlar: blob base64-kodla
	).
	blob boşat. <- ['cid:attachment'] + id.
}.

HTML-E-poçta gelende: ['döret'] et: {
	>> setir-arakesmesi := ['\r\n'].
	>> setir-zynjyry := [''].
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['From: '] + öz iberijiniň-ady + [' <'] + ( öz iberiji ) + ['>']) + setir-arakesmesi.
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['To: '] + ( öz alyjylar birleşdir: [','] )) + setir-arakesmesi.
	öz cc sany dogry: {
		setir-zynjyry soňuna-goş: (özi sözbaşy: ['Cc: '] + ( öz cc birleşdir: [','] )) + setir-arakesmesi.
	}.
	öz bcc sany dogry: {
		setir-zynjyry soňuna-goş: (özi sözbaşy: ['Bcc: '] + ( öz bcc birleşdir: [','] )) + setir-arakesmesi.
	}.
	setir-zynjyry soňuna-goş: (özi sözbaşy: ['Subject: '] + öz tema) + setir-arakesmesi.
	setir-zynjyry soňuna-goş: ['MIME-Version: 1.0'] + setir-arakesmesi.
	setir-zynjyry soňuna-goş: ['Content-Type: multipart/related; boundary="'] + öz serhet + ['"; type=text/html'] + setir-arakesmesi.
	setir-zynjyry soňuna-goş: setir-arakesmesi.
	setir-zynjyry soňuna-goş: ['--'] + öz serhet + setir-arakesmesi.
	setir-zynjyry soňuna-goş: ['Content-Type: text/html; charset=UTF-8'] + setir-arakesmesi.
	setir-zynjyry soňuna-goş: ['Content-Transfer-Encoding: 7bit'] + setir-arakesmesi.
	setir-zynjyry soňuna-goş: setir-arakesmesi.
	setir-zynjyry soňuna-goş: öz beden.
	setir-zynjyry soňuna-goş: setir-arakesmesi.
	öz goşundylar her: { :id :maglumat
		>> blob := maglumat maglumatlar.
		setir-zynjyry soňuna-goş: ['--'] + öz serhet + setir-arakesmesi.
		setir-zynjyry soňuna-goş: ['Content-Type: '] + maglumat mime + setir-arakesmesi.
		setir-zynjyry soňuna-goş: ['Content-Transfer-Encoding: base64'] + setir-arakesmesi.
		setir-zynjyry soňuna-goş: ['Content-ID: <attachment'] + id + ['>'] + setir-arakesmesi.
		setir-zynjyry soňuna-goş: ['Content-Disposition: inline; filename="'] + maglumat faýl + ['"'] + setir-arakesmesi.
		setir-zynjyry soňuna-goş: setir-arakesmesi.
		>> iň-köp := 76.
		>> tekst-uzynlygy := blob uzynlyk.
		>> döwümler := (tekst-uzynlygy / iň-köp) ýokary-tegelekle.
		{ :i
			>> döwüm := blob göçür başlap: i * iň-köp uzynlyk: iň-köp.
			setir-zynjyry soňuna-goş: döwüm + setir-arakesmesi.
		} * döwümler.
		setir-zynjyry soňuna-goş: setir-arakesmesi.
		setir-zynjyry soňuna-goş: setir-arakesmesi.
	}.
	setir-zynjyry soňuna-goş: ['--'] + öz serhet + ['--'] + setir-arakesmesi. <- setir-zynjyry.
}.
