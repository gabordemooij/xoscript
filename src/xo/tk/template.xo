
# ~ Simple template engine ~

>> Şablon := Obýekt täze.

Şablon gelende: ['täze'] et: { <- özi täze mazmun: [''].
}.

Şablon gelende: ['mazmun:'] et: { :mazmun
	öz mazmun := mazmun. 
}.

Şablon gelende: ['täze:'] et: { :mazmun <- özi täze mazmun: mazmun.
}.

Şablon gelende: ['kes:'] et: { :bellik
	>> başlangyç-bellik := (['<!-- cut:%id% -->'] %id%: bellik).
	>> soňky-bellik := (['<!-- /cut:%id% -->'] %id%: bellik).
	>> kesimler := öz mazmun böl: başlangyç-bellik.
	>> prefiks := kesimler birinji.
	>> kesimler2 := kesimler soňky böl: soňky-bellik.
	>> goşulma := kesimler2 soňky.
	>> kesim := kesimler2 birinji.
	>> galyndy := prefiks + goşulma.
	öz mazmun := galyndy. <- Şablon täze: kesim.
	
}.

Şablon gelende: ['göçür'] et: { <- özi täze: özi tekst göçür.
}.
	
Şablon gelende: ['ýapyşdyr:açar:'] et: { :bölejik :id
	>> ýapyşdyrma-belligi := (['<!-- paste:%id% -->'] %id%: id).
	öz mazmun çalyş: ýapyşdyrma-belligi bilen: ( bölejik tekst + ýapyşdyrma-belligi ).
}.

Şablon gelende: ['belle:baha:'] et: { :orun :baha
	öz mazmun çalyş: ['<!-- slot:'] + orun + [' -->'] bilen: ( Server html-kodla: baha ).
}.

Şablon gelende: ['belle:html:'] et: { :orun :html
	öz mazmun çalyş: ['<!-- slot:'] + orun + [' -->'] bilen: html.
}.

Şablon gelende: ['jogap-ber:we:'] et: { :orun :baha
	özi belle: (orun başlap: 0 uzynlyk: (orun uzynlyk - 1)) baha: baha.
}.

Şablon gelende: ['nl2br'] et: {
	öz mazmun çalyş: ['\n'] bilen: ['<br>'].
}.

Şablon gelende: ['tertiple'] et: {
	öz mazmun :=
		Nusga
		täze: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		gabat-gelme: öz mazmun
		et: { <- ['']. }.
}.

Şablon gelende: ['kesimleri-tertiple'] et: {
	>> elementler := Sanaw täze.
	Nusga
	täze: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	gabat-gelme: öz mazmun
	et: { :_ :kesim
		elementler soňuna-goş: kesim ? 1.
	}.
	elementler her: { :_ :id
		öz mazmun :=
			Nusga täze: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			gabat-gelme: öz mazmun
			et: { <- ['']. }.
	 }.
}.

Şablon gelende: ['boşluklary-tertiple'] et: {
	öz mazmun :=
		Nusga
		täze: ['\\s*\\n'],
		gabat-gelme: öz mazmun
		et: { <- ['\n']. }.
	öz mazmun :=
		Nusga
		täze: ['\\n[\\s\\t]+'],
		gabat-gelme: öz mazmun
		et: { <- ['\n']. }.
}.

Şablon gelende: ['hemmesini-tertiple'] et: {
	özi tertiple.
	özi kesimleri-tertiple.
	özi boşluklary-tertiple.
}.

Şablon gelende: ['tekst'] et: { <- öz mazmun.
}.
