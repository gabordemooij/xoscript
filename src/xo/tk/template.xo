
# ~ Simple template engine ~

>> Template := Obýekt täze.

Template gelende: ['täze'] et: { <- özi täze content: [''].
}.

Template gelende: ['content:'] et: { :content
	öz content := content. 
}.

Template gelende: ['täze:'] et: { :content <- özi täze content: content.
}.

Template gelende: ['cut:'] et: { :marker
	>> startmarker := (['<!-- cut:%id% -->'] %id%: marker).
	>> endmarker := (['<!-- /cut:%id% -->'] %id%: marker).
	>> parts := öz content böl: startmarker.
	>> prefix := parts birinji.
	>> parts2 := parts soňky böl: endmarker.
	>> suffix := parts2 soňky.
	>> part := parts2 birinji.
	>> rest := prefix + suffix.
	öz content := rest. <- Template täze: part.
	
}.

Template gelende: ['göçür'] et: { <- özi täze: özi tekst göçür.
}.
	
Template gelende: ['paste:at:'] et: { :snippet :id
	>> pastemarker := (['<!-- paste:%id% -->'] %id%: id).
	öz content çalyş: pastemarker bilen: ( snippet tekst + pastemarker ).
}.

Template gelende: ['belle:baha:'] et: { :slot :value
	öz content çalyş: ['<!-- slot:'] + slot + [' -->'] bilen: ( Server html-kodla: value ).
}.

Template gelende: ['set:html:'] et: { :slot :html
	öz content çalyş: ['<!-- slot:'] + slot + [' -->'] bilen: html.
}.

Template gelende: ['jogap-ber:we:'] et: { :slot :value
	özi belle: (slot başlap: 0 uzynlyk: (slot uzynlyk - 1)) baha: value.
}.

Template gelende: ['nl2br'] et: {
	öz content çalyş: ['\n'] bilen: ['<br>'].
}.

Template gelende: ['clean'] et: {
	öz content :=
		Nusga
		täze: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		gabat-gelme: öz content
		et: { <- ['']. }.
}.

Template gelende: ['clean-cuts'] et: {
	>> items := Sanaw täze.
	Nusga
	täze: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	gabat-gelme: öz content
	et: { :_ :part
		items soňuna-goş: part ? 1.
	}.
	items her: { :_ :id
		öz content :=
			Nusga täze: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			gabat-gelme: öz content
			et: { <- ['']. }.
	 }.
}.

Template gelende: ['clean-space'] et: {
	öz content :=
		Nusga
		täze: ['\\s*\\n'],
		gabat-gelme: öz content
		et: { <- ['\n']. }.
	öz content :=
		Nusga
		täze: ['\\n[\\s\\t]+'],
		gabat-gelme: öz content
		et: { <- ['\n']. }.
}.

Template gelende: ['clean-all'] et: {
	özi clean.
	özi clean-cuts.
	özi clean-space.
}.

Template gelende: ['tekst'] et: { <- öz content.
}.
