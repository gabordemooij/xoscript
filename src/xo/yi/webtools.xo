בקשה-HTTP ווען: ['HTTP-קעפל:'] טו: { :שליסל <- פּראָגראַם אײַנשטעלונג: שליסל.
}.

>> HTTP-קעפל := אָביעקט ניי.

HTTP-קעפל ווען: ['ניי'] טו: { <- זיך ניי אינעשאַלירן.
}.

HTTP-קעפל ווען: ['אינעשאַלירן'] טו: {
	אייגן שליסל := גאָרנישט.
	אייגן ווערט := גאָרנישט.
}.

HTTP-קעפל ווען: ['שליסל:ווערט:'] טו: { :שליסל :ווערט
	אייגן שליסל := שליסל.
	אייגן ווערט := ווערט.
}.

HTTP-קעפל ווען: ['שליסל'] טו: { <- אייגן שליסל.
}.

HTTP-קעפל ווען: ['ווערט'] טו: { <- אייגן ווערט.
}.


HTTP-קעפל ווען: ['צו-טעקסט'] טו: {
	>> שורה := אייגן שליסל + [': '] + אייגן ווערט.
	שורה פֿאַרבײַט: ['\r'] מיט: [''], פֿאַרבײַט: ['\n'] מיט: ['']. <- שורה + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> וועב-דאָקומענט := אָביעקט ניי.

וועב-דאָקומענט ווען: ['ניי'] טו: { <- זיך ניי אינעשאַלירן.
}.

וועב-דאָקומענט ווען: ['אינעשאַלירן'] טו: {
	אייגן קעפלעך := ליסטע ניי.
	אייגן סעסיע-id := גאָרנישט.
	אייגן סעסיע-פֿאַרוואַלטער := סעסיע-צייַטווייַליקע-טעקע ניי.
	אייגן סעסיע-דאַטן := גאָרנישט.
	אייגן זיכער := אמת.
	אייגן זעלביקער-זייטל := ['Strict'].
	אייגן קעפלעך-געשיקט := פֿאַלש.
	אייגן בקשה-http := בקשה-HTTP ניי.
}.

וועב-דאָקומענט ווען: ['בקשה-http:'] טו: { :בקשה-http
	אייגן בקשה-http := בקשה-http.
}. 

וועב-דאָקומענט ווען: ['זיכער-סעסיע-קיכל:'] טו: { :זיכער
	זיך קאָנטראָלירן-קעפלעך.
	אייגן זיכער := זיכער.
}.

וועב-דאָקומענט ווען: ['סעסיע-קיכל-זעלביקער-זייטל:'] טו: { :ווערט
	זיך קאָנטראָלירן-קעפלעך.
	>> אָפּציעס := ליסטע ניי 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	אָפּציעס האָט: ווערט, אויב-פֿאַלש: {
		די-אויפֿגאַבע טעות: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	אייגן זעלביקער-זייטל := ווערט.
}.

וועב-דאָקומענט ווען: ['קעפל:'] טו: { :קעפל
	זיך קאָנטראָלירן-קעפלעך.
	אייגן קעפלעך לייג-צו-סוף: קעפל.
}.

וועב-דאָקומענט ווען: ['אויסליידיקן-קעפלעך'] טו: {
	זיך קאָנטראָלירן-קעפלעך.
	אייגן קעפלעך := ליסטע ניי.
}.

וועב-דאָקומענט ווען: ['סעסיע-פֿאַרוואַלטער:'] טו: { :פֿאַרוואַלטער
	זיך קאָנטראָלירן-קעפלעך.
	אייגן סעסיע-פֿאַרוואַלטער := פֿאַרוואַלטער.
}.

וועב-דאָקומענט ווען: ['סעסיע-פֿאַרוואַלטער'] טו: { <- אייגן סעסיע-פֿאַרוואַלטער.
}.

וועב-דאָקומענט ווען: ['קאָנטראָלירן-קעפלעך'] טו: {
	אייגן קעפלעך-געשיקט אויב-אמת: {
		די-אויפֿגאַבע טעות: ['Headers already sent to client.'].
	}.
}.

וועב-דאָקומענט ווען: ['אָנהייבן-סעסיע'] טו: {
	זיך קאָנטראָלירן-קעפלעך.
	>> בקשה-http := אייגן בקשה-http.
	>> סעסיע-id := בקשה-http cookie: ['xsid'].
	סעסיע-id גאָרנישט? אויב-פֿאַלש: {
		(( מוסטער ניי: ['^[A-Za-z0-9]+\\z'], טרעפֿונג: סעסיע-id ) = 0) אויב-אמת: {
			סעסיע-id := גאָרנישט.
		}.
	}.
	סעסיע-id גאָרנישט? אויב-אמת: {
		סעסיע-id := סייף צייכן: 30.
		>> סעסיע-קעפל := HTTP-קעפל ניי
		שליסל: ['Set-Cookie'] ווערט: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (אייגן זיכער דאָס: ['Secure'] אָדער-יענץ: ['']),
		SSITE: (אייגן זעלביקער-זייטל),
		XSID: סעסיע-id
		).
		אייגן קעפלעך לייג-צו-סוף: סעסיע-קעפל.
	}.
	אייגן סעסיע-דאַטן := אייגן סעסיע-פֿאַרוואַלטער פֿאַר: סעסיע-id, לאָדן. <- אייגן סעסיע-דאַטן. # reference
}.

וועב-דאָקומענט ווען: ['גיין-צו:'] טו: { :אַדרעס
	זיך קאָנטראָלירן-קעפלעך.
	זיך אויסליידיקן-קעפלעך.
	אייגן קעפלעך
	לייג-צו-סוף: (
		HTTP-קעפל ניי
		שליסל: ['Status'] ווערט: ['303 See Other']
	),
	לייג-צו-סוף: (
		HTTP-קעפל ניי
		שליסל: ['Location'] ווערט: אַדרעס
	).
	זיך אַרויסגעבן: ['Redirect'].
}.

וועב-דאָקומענט ווען: ['פֿאַרניכטן-סעסיע'] טו: {
	זיך קאָנטראָלירן-קעפלעך.
	>> בקשה-http := אייגן בקשה-http.
	>> סעסיע-id := בקשה-http cookie: ['xsid'].
	סעסיע-id גאָרנישט? אויב-פֿאַלש: {
		>> סעסיע-קעפל := HTTP-קעפל ניי.
		>> צייַטפּונקט := מאָמענט ניי יאָר: 1970, אין-פֿאָרמאַט: ['%a, %d %b %Y %H:%M:%S GMT'].
		סעסיע-קעפל שליסל: ['Set-Cookie'] ווערט: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: צייַטפּונקט,
			SEC: (אייגן זיכער דאָס: ['Secure'] אָדער-יענץ: ['']),
			SSITE: (אייגן זעלביקער-זייטל),
			XSID: סעסיע-id
		).
		אייגן סעסיע-פֿאַרוואַלטער פֿאַרניכטן.
		אייגן קעפלעך לייג-צו-סוף: סעסיע-קעפל.
	}.
}.


וועב-דאָקומענט ווען: ['שאַבלאָן:'] טו: { :טעקע-וועג <- שאַבלאָן ניי: (טעקע ניי: טעקע-וועג, לייען).
}.

וועב-דאָקומענט ווען: ['אַרויסגעבן:טיפּ:'] טו: { :רעזולטאַט :טיפּ
	אייגן קעפלעך-געשיקט אויב-פֿאַלש: {
		אייגן סעסיע-דאַטן גאָרנישט? אויב-פֿאַלש: {
			אייגן סעסיע-פֿאַרוואַלטער אָפּהיטן: אייגן סעסיע-דאַטן.
		}.
		אייגן קעפלעך לייג-צו-סוף: (
			HTTP-קעפל ניי
			שליסל: ['Content-type'] ווערט: טיפּ
		).
		אייגן קעפלעך יעדער: { :_ :קעפל
			אויסגאָב שרײַב: קעפל.
		}.
		אייגן קעפלעך-געשיקט := אמת.
		אויסגאָב שרײַב: ['\r\n'].
	}.
	אויסגאָב שרײַב: רעזולטאַט.
}.

וועב-דאָקומענט ווען: ['ענדיקן:טיפּ:'] טו: { :רעזולטאַט :טיפּ
	אייגן קעפלעך-געשיקט אויב-פֿאַלש: {
		אייגן סעסיע-דאַטן גאָרנישט? אויב-פֿאַלש: {
			אייגן סעסיע-פֿאַרוואַלטער אָפּהיטן: אייגן סעסיע-דאַטן.
		}.
		אייגן קעפלעך לייג-צו-סוף: (
			HTTP-קעפל ניי
			שליסל: ['Content-type'] ווערט: טיפּ
		).
		אייגן קעפלעך לייג-צו-סוף: (
			HTTP-קעפל ניי
			שליסל: ['Content-Length'] ווערט: רעזולטאַט צו-טעקסט בייטן
		).
		אייגן קעפלעך יעדער: { :_ :קעפל
			אויסגאָב שרײַב: קעפל.
		}.
		אייגן קעפלעך-געשיקט := אמת.
		אויסגאָב שרײַב: ['\r\n'].
	}.
	אויסגאָב שרײַב: רעזולטאַט.
}.

וועב-דאָקומענט ווען: ['אַרויסגעבן:'] טו: { :רעזולטאַט
	זיך אַרויסגעבן: רעזולטאַט טיפּ: ['text/html; charset=utf-8'].
}.

וועב-דאָקומענט ווען: ['ענדיקן:'] טו: { :רעזולטאַט
	זיך ענדיקן: רעזולטאַט טיפּ: ['text/html; charset=utf-8'].
}.

וועב-דאָקומענט ווען: ['json:'] טו: { :רעזולטאַט
	זיך אַרויסגעבן: ( JSON jsonify: רעזולטאַט ) טיפּ: ['application/json'].
}.

וועב-דאָקומענט ווען: ['ניט-געפֿונען:'] טו: { :רעזולטאַט
	זיך אויסליידיקן-קעפלעך קעפל: (
		HTTP-קעפל ניי שליסל: ['Status'] ווערט: ['404 Not Found']
	).
	זיך אַרויסגעבן: רעזולטאַט.
}.


# Interface

>> סעסיע := אָביעקט ניי.

סעסיע ווען: ['ניי'] טו: { <- זיך ניי אינעשאַלירן פֿאַר: גאָרנישט.
}.

סעסיע ווען: ['פֿאַר:'] טו: { :id
	אייגן id := id.
}.

סעסיע ווען: ['לאָדן'] טו: {
	די-אויפֿגאַבע טעות: ['Not implemented.'].
}.

סעסיע ווען: ['אָפּהיטן:'] טו: {
	די-אויפֿגאַבע טעות: ['Not implemented.'].
}.

סעסיע ווען: ['פֿאַרניכטן'] טו: {
	די-אויפֿגאַבע טעות: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> סעסיע-צייַטווייַליקע-טעקע := סעסיע ניי.

סעסיע-צייַטווייַליקע-טעקע ווען: ['אינעשאַלירן'] טו: {
	אייגן וועג-אָנהייב := ['/tmp/sess-'].
}.

סעסיע-צייַטווייַליקע-טעקע ווען: ['וועג-פּרעפֿיקס:'] טו: { :טעקסט-שטריקל
	אייגן וועג-אָנהייב := טעקסט-שטריקל.
}.

סעסיע-צייַטווייַליקע-טעקע ווען: ['סעסיע-טעקע'] טו: { <- ( טעקע ניי: ( אייגן וועג-אָנהייב + אייגן id + ['.txt'] ) ).
}.

סעסיע-צייַטווייַליקע-טעקע ווען: ['לאָדן'] טו: {
	>> סעסיע-טעקע := זיך סעסיע-טעקע.
	סעסיע-טעקע עקזיסטירט אויב-פֿאַלש: {
		סעסיע-טעקע שרײַב: (ווערטערבוך ניי קאָד).
	}. <- סעסיע-טעקע לייען צו-אָביעקט.
}.

סעסיע-צייַטווייַליקע-טעקע ווען: ['אָפּהיטן:'] טו: { :דאַטן
	>> סעסיע-טעקע := זיך סעסיע-טעקע.
	סעסיע-טעקע עקזיסטירט אויב-אמת: {
		סעסיע-טעקע שרײַב: דאַטן קאָד.
	}.
}.

סעסיע-צייַטווייַליקע-טעקע ווען: ['פֿאַרניכטן'] טו: {
	>> סעסיע-טעקע := זיך סעסיע-טעקע.
	סעסיע-טעקע עקזיסטירט אויב-אמת: {
		סעסיע-טעקע מעק-אויס.
	}.
}.


>> URL := אָביעקט ניי.

URL ווען: ['אינעשאַלירן'] טו: {
	אייגן פּראָטאָקאָל := ['https://'].
	אייגן באַלעבאָס := ['localhost'].
	אייגן טעקע-וועג := [''].
	אייגן url-פּאַראַמעטערס := [''].
	אייגן hash := [''].
}.

URL ווען: ['ניי'] טו: { <- זיך ניי אינעשאַלירן.
}.

URL ווען: ['צו-טעקסט'] טו: { <- (
	אייגן פּראָטאָקאָל +
	אייגן באַלעבאָס +
	אייגן טעקע-וועג +
	אייגן url-פּאַראַמעטערס +
	אייגן hash ).
}.

URL ווען: ['פּראָטאָקאָל:'] טו: { :פּראָטאָקאָל
	((ליסטע ניי ; ['http'] ; ['https']) האָט: פּראָטאָקאָל) אויב-אמת: {
		אייגן פּראָטאָקאָל := פּראָטאָקאָל + ['://'].
	}, אויב-פֿאַלש: {
		די-אויפֿגאַבע טעות: ['Invalid protocol'].
	}.
}.

URL ווען: ['באַלעבאָס:'] טו: { :באַלעבאָס
	#todo validate according to rfc
	אייגן באַלעבאָס := באַלעבאָס.
}.

URL ווען: ['טעקע-וועג:'] טו: { :טעקע-וועג
	אייגן טעקע-וועג := ['/'] + טעקע-וועג url-קאָדירן.
}.

URL ווען: ['url-פּאַראַמעטערס:'] טו: { :מאַפּינג
	>> url-פּאַראַמעטערס := ליסטע ניי.
	מאַפּינג יעדער: { :שליסל :ווערט
		url-פּאַראַמעטערס לייג-צו-סוף: שליסל צו-טעקסט url-קאָדירן + ['='] + ווערט צו-טעקסט url-קאָדירן.
	}.
	אייגן url-פּאַראַמעטערס := ['?'] + ( url-פּאַראַמעטערס פֿאַראייניק: ['&'] ).
}.

URL ווען: ['העש:'] טו: { :hash
	אייגן hash := ['#'] + hash url-קאָדירן.
}.

