
# ~ Simple template engine ~

>> שאַבלאָן := אָביעקט ניי.

שאַבלאָן ווען: ['ניי'] טו: { <- זיך ניי אינהאַלט: [''].
}.

שאַבלאָן ווען: ['אינהאַלט:'] טו: { :אינהאַלט
	אייגן אינהאַלט := אינהאַלט. 
}.

שאַבלאָן ווען: ['ניי:'] טו: { :אינהאַלט <- זיך ניי אינהאַלט: אינהאַלט.
}.

שאַבלאָן ווען: ['שנייַדן:'] טו: { :צייכן
	>> אָנהייב-צייכן := (['<!-- cut:%id% -->'] %id%: צייכן).
	>> סוף-צייכן := (['<!-- /cut:%id% -->'] %id%: צייכן).
	>> טיילן := אייגן אינהאַלט צעטייל: אָנהייב-צייכן.
	>> פּרעפֿיקס := טיילן ערשטער.
	>> טיילן2 := טיילן לעצטער צעטייל: סוף-צייכן.
	>> סופֿיקס := טיילן2 לעצטער.
	>> טייל := טיילן2 ערשטער.
	>> רעשט := פּרעפֿיקס + סופֿיקס.
	אייגן אינהאַלט := רעשט. <- שאַבלאָן ניי: טייל.
	
}.

שאַבלאָן ווען: ['קאָפּיר'] טו: { <- זיך ניי: זיך צו-טעקסט קאָפּיר.
}.
	
שאַבלאָן ווען: ['אײַנקלעפּן:שליסל:'] טו: { :אויסצוג :id
	>> אײַנקלעפּ-צייכן := (['<!-- paste:%id% -->'] %id%: id).
	אייגן אינהאַלט פֿאַרבײַט: אײַנקלעפּ-צייכן מיט: ( אויסצוג צו-טעקסט + אײַנקלעפּ-צייכן ).
}.

שאַבלאָן ווען: ['שטעל:ווערט:'] טו: { :פּלאַץ :ווערט
	אייגן אינהאַלט פֿאַרבײַט: ['<!-- slot:'] + פּלאַץ + [' -->'] מיט: ( Server html-קאָדירן: ווערט ).
}.

שאַבלאָן ווען: ['שטעל:html:'] טו: { :פּלאַץ :html
	אייגן אינהאַלט פֿאַרבײַט: ['<!-- slot:'] + פּלאַץ + [' -->'] מיט: html.
}.

שאַבלאָן ווען: ['ענטפֿער:און:'] טו: { :פּלאַץ :ווערט
	זיך שטעל: (פּלאַץ אָנהייב: 0 לענג: (פּלאַץ לענג - 1)) ווערט: ווערט.
}.

שאַבלאָן ווען: ['nl2br'] טו: {
	אייגן אינהאַלט פֿאַרבײַט: ['\n'] מיט: ['<br>'].
}.

שאַבלאָן ווען: ['רייניקן'] טו: {
	אייגן אינהאַלט :=
		מוסטער
		ניי: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		טרעפֿונג: אייגן אינהאַלט
		טו: { <- ['']. }.
}.

שאַבלאָן ווען: ['רייניקן-שניטן'] טו: {
	>> זאַכן := ליסטע ניי.
	מוסטער
	ניי: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	טרעפֿונג: אייגן אינהאַלט
	טו: { :_ :טייל
		זאַכן לייג-צו-סוף: טייל ? 1.
	}.
	זאַכן יעדער: { :_ :id
		אייגן אינהאַלט :=
			מוסטער ניי: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			טרעפֿונג: אייגן אינהאַלט
			טו: { <- ['']. }.
	 }.
}.

שאַבלאָן ווען: ['רייניקן-ספּייסן'] טו: {
	אייגן אינהאַלט :=
		מוסטער
		ניי: ['\\s*\\n'],
		טרעפֿונג: אייגן אינהאַלט
		טו: { <- ['\n']. }.
	אייגן אינהאַלט :=
		מוסטער
		ניי: ['\\n[\\s\\t]+'],
		טרעפֿונג: אייגן אינהאַלט
		טו: { <- ['\n']. }.
}.

שאַבלאָן ווען: ['רייניקן-אַלץ'] טו: {
	זיך רייניקן.
	זיך רייניקן-שניטן.
	זיך רייניקן-ספּייסן.
}.

שאַבלאָן ווען: ['צו-טעקסט'] טו: { <- אייגן אינהאַלט.
}.
