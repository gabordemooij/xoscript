>> Mailaka := Zavatra vaovao.

Mailaka rehefa: ['omano'] ataovy: {
	azy mpandray := Lisitra vaovao.
	azy cc := Lisitra vaovao.
	azy bcc := Lisitra vaovao.
	azy mpandefa := Tsinontsinona.
	azy anaran-mpandefa := Tsinontsinona.
	azy lohahevitra := Tsinontsinona.
	azy vatana := Tsinontsinona.
}.

Mailaka rehefa: ['vaovao'] ataovy: { <- tena vaovao omano.
}.

Mailaka rehefa: ['ho-an-i:'] ataovy: { :fanisana
	azy mpandray := fanisana.
}.
 
Mailaka rehefa: ['cc:'] ataovy: { :fanisana
	azy cc := fanisana.
}.

Mailaka rehefa: ['bcc:'] ataovy: { :fanisana
	azy bcc := fanisana.
}.

Mailaka rehefa: ['lohahevitra:'] ataovy: { :lohahevitra
	azy lohahevitra := lohahevitra.
}.

Mailaka rehefa: ['mpandefa:anarana:'] ataovy: { :mpandefa :anarana
	azy mpandefa := mpandefa.
	azy anaran-mpandefa := anarana.
}.

Mailaka rehefa: ['vatana:'] ataovy: { :vatana
	azy vatana := vatana.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Mailaka rehefa: ['lohateny:'] ataovy: { :andalana <- andalana soloy: ['\r'] amin: [''], soloy: ['\n'] amin: [''].
}.

Mailaka rehefa: ['alefaso'] ataovy: {
	>> f := Rakitra tempwrite: tena mamorona.
	Fandaharana rafitra: ['sendmail -t < '] + f lalan-drakitra, andalana-vaovao.
}.

Mailaka rehefa: ['mamorona'] ataovy: {
	>> fiatoan-andalana := ['\r\n'].
	>> tady-soratra := [''].
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['From: '] + azy anaran-mpandefa + [' <'] + ( azy mpandefa ) + ['>']) + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['To: '] + ( azy mpandray atambaro: [','] )) + fiatoan-andalana.
	azy cc isan-javatra marina: {
		tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Cc: '] + ( azy cc atambaro: [','] )) + fiatoan-andalana.
	}.
	azy bcc isan-javatra marina: {
		tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Bcc: '] + ( azy bcc atambaro: [','] )) + fiatoan-andalana.
	}.
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Subject: '] + azy lohahevitra) + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: azy vatana.
	tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana. <- tady-soratra.
}.

>> Mailaka-HTML := Mailaka vaovao.

Mailaka-HTML rehefa: ['omano'] ataovy: {
	tena omano.
	azy raikitra := Lisitra vaovao.
	azy fetra := Vata-fiarovana token: 40.
}.

Mailaka-HTML rehefa: ['ampiraiketo:'] ataovy: { :rakitra-fivoriana
	>> id := azy raikitra isan-javatra.
	>> blob := rakitra-fivoriana blob.
	azy raikitra ampio-any-amin-ny-farany: (
		Rakibolana vaovao
			rakitra-fivoriana: rakitra-fivoriana lalan-drakitra,
			mime: ['image/'] + (Server mimetype: rakitra-fivoriana lalan-drakitra),
			angona: blob base64-asio-kaody
	).
	blob afaho. <- ['cid:attachment'] + id.
}.

Mailaka-HTML rehefa: ['mamorona'] ataovy: {
	>> fiatoan-andalana := ['\r\n'].
	>> tady-soratra := [''].
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['From: '] + azy anaran-mpandefa + [' <'] + ( azy mpandefa ) + ['>']) + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['To: '] + ( azy mpandray atambaro: [','] )) + fiatoan-andalana.
	azy cc isan-javatra marina: {
		tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Cc: '] + ( azy cc atambaro: [','] )) + fiatoan-andalana.
	}.
	azy bcc isan-javatra marina: {
		tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Bcc: '] + ( azy bcc atambaro: [','] )) + fiatoan-andalana.
	}.
	tady-soratra ampio-any-amin-ny-farany: (tena lohateny: ['Subject: '] + azy lohahevitra) + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: ['MIME-Version: 1.0'] + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: ['Content-Type: multipart/related; boundary="'] + azy fetra + ['"; type=text/html'] + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: ['--'] + azy fetra + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: ['Content-Type: text/html; charset=UTF-8'] + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: ['Content-Transfer-Encoding: 7bit'] + fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
	tady-soratra ampio-any-amin-ny-farany: azy vatana.
	tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
	azy raikitra tsirairay: { :id :fampahalalana
		>> blob := fampahalalana angona.
		tady-soratra ampio-any-amin-ny-farany: ['--'] + azy fetra + fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: ['Content-Type: '] + fampahalalana mime + fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: ['Content-Transfer-Encoding: base64'] + fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: ['Content-ID: <attachment'] + id + ['>'] + fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: ['Content-Disposition: inline; filename="'] + fampahalalana rakitra-fivoriana + ['"'] + fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
		>> faratampony := 76.
		>> halavan-dahatsoratra := blob halavany.
		>> potipotika := (halavan-dahatsoratra / faratampony) ampiakarina-ho-isa-feno.
		{ :i
			>> potika := blob adikao manomboka: i * faratampony halavany: faratampony.
			tady-soratra ampio-any-amin-ny-farany: potika + fiatoan-andalana.
		} * potipotika.
		tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
		tady-soratra ampio-any-amin-ny-farany: fiatoan-andalana.
	}.
	tady-soratra ampio-any-amin-ny-farany: ['--'] + azy fetra + ['--'] + fiatoan-andalana. <- tady-soratra.
}.
