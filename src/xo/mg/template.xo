
# ~ Simple template engine ~

>> Modely-pejy := Zavatra vaovao.

Modely-pejy rehefa: ['vaovao'] ataovy: { <- tena vaovao votoaty: [''].
}.

Modely-pejy rehefa: ['votoaty:'] ataovy: { :votoaty
	azy votoaty := votoaty. 
}.

Modely-pejy rehefa: ['vaovao:'] ataovy: { :votoaty <- tena vaovao votoaty: votoaty.
}.

Modely-pejy rehefa: ['tapaho:'] ataovy: { :marika
	>> marika-fanombohana := (['<!-- cut:%id% -->'] %id%: marika).
	>> marika-farany := (['<!-- /cut:%id% -->'] %id%: marika).
	>> ampahany-maro := azy votoaty zarao: marika-fanombohana.
	>> tovona := ampahany-maro voalohany.
	>> ampahany-maro2 := ampahany-maro farany zarao: marika-farany.
	>> tovana := ampahany-maro2 farany.
	>> ampahany := ampahany-maro2 voalohany.
	>> sisa := tovona + tovana.
	azy votoaty := sisa. <- Modely-pejy vaovao: ampahany.
	
}.

Modely-pejy rehefa: ['adikao'] ataovy: { <- tena vaovao: tena soratra adikao.
}.
	
Modely-pejy rehefa: ['apetaho:eo:'] ataovy: { :sombin-teny :id
	>> marika-fametahana := (['<!-- paste:%id% -->'] %id%: id).
	azy votoaty soloy: marika-fametahana amin: ( sombin-teny soratra + marika-fametahana ).
}.

Modely-pejy rehefa: ['apetraho:sanda:'] ataovy: { :toerana :sanda
	azy votoaty soloy: ['<!-- slot:'] + toerana + [' -->'] amin: ( Server html-asio-kaody: sanda ).
}.

Modely-pejy rehefa: ['apetraho:html:'] ataovy: { :toerana :html
	azy votoaty soloy: ['<!-- slot:'] + toerana + [' -->'] amin: html.
}.

Modely-pejy rehefa: ['valio:ary:'] ataovy: { :toerana :sanda
	tena apetraho: (toerana manomboka: 0 halavany: (toerana halavany - 1)) sanda: sanda.
}.

Modely-pejy rehefa: ['nl2br'] ataovy: {
	azy votoaty soloy: ['\n'] amin: ['<br>'].
}.

Modely-pejy rehefa: ['alamino'] ataovy: {
	azy votoaty :=
		Lamina
		vaovao: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		fifanarahana: azy votoaty
		ataovy: { <- ['']. }.
}.

Modely-pejy rehefa: ['alamino-tapaka'] ataovy: {
	>> singa := Lisitra vaovao.
	Lamina
	vaovao: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	fifanarahana: azy votoaty
	ataovy: { :_ :ampahany
		singa ampio-any-amin-ny-farany: ampahany ? 1.
	}.
	singa tsirairay: { :_ :id
		azy votoaty :=
			Lamina vaovao: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			fifanarahana: azy votoaty
			ataovy: { <- ['']. }.
	 }.
}.

Modely-pejy rehefa: ['alamino-elanelana'] ataovy: {
	azy votoaty :=
		Lamina
		vaovao: ['\\s*\\n'],
		fifanarahana: azy votoaty
		ataovy: { <- ['\n']. }.
	azy votoaty :=
		Lamina
		vaovao: ['\\n[\\s\\t]+'],
		fifanarahana: azy votoaty
		ataovy: { <- ['\n']. }.
}.

Modely-pejy rehefa: ['alamino-avokoa'] ataovy: {
	tena alamino.
	tena alamino-tapaka.
	tena alamino-elanelana.
}.

Modely-pejy rehefa: ['soratra'] ataovy: { <- azy votoaty.
}.
