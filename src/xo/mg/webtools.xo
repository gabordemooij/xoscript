Fangatahana-HTTP rehefa: ['HTTP-lohateny:'] ataovy: { :lakile <- Fandaharana fikirakirana: lakile.
}.

>> Lohateny-HTTP := Zavatra vaovao.

Lohateny-HTTP rehefa: ['vaovao'] ataovy: { <- tena vaovao omano.
}.

Lohateny-HTTP rehefa: ['omano'] ataovy: {
	azy lakile := Tsinontsinona.
	azy sanda := Tsinontsinona.
}.

Lohateny-HTTP rehefa: ['lakile:sanda:'] ataovy: { :lakile :sanda
	azy lakile := lakile.
	azy sanda := sanda.
}.

Lohateny-HTTP rehefa: ['lakile'] ataovy: { <- azy lakile.
}.

Lohateny-HTTP rehefa: ['sanda'] ataovy: { <- azy sanda.
}.


Lohateny-HTTP rehefa: ['soratra'] ataovy: {
	>> andalana := azy lakile + [': '] + azy sanda.
	andalana soloy: ['\r'] amin: [''], soloy: ['\n'] amin: ['']. <- andalana + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Antontan-taratasy-Web := Zavatra vaovao.

Antontan-taratasy-Web rehefa: ['vaovao'] ataovy: { <- tena vaovao omano.
}.

Antontan-taratasy-Web rehefa: ['omano'] ataovy: {
	azy lohateny-rehetra := Lisitra vaovao.
	azy id-fivoriana := Tsinontsinona.
	azy mpitantana-fivoriana := Fivoriana-rakitra-vonjimaika vaovao.
	azy angona-fivoriana := Tsinontsinona.
	azy azo-antoka := Marina.
	azy tranonkala-mitovy := ['Strict'].
	azy lohateny-nalefa := Diso.
	azy fangatahana-http := Fangatahana-HTTP vaovao.
}.

Antontan-taratasy-Web rehefa: ['fangatahana-http:'] ataovy: { :fangatahana-http
	azy fangatahana-http := fangatahana-http.
}. 

Antontan-taratasy-Web rehefa: ['cookie-fivoriana-azo-antoka:'] ataovy: { :azo-antoka
	tena hamarino-lohateny.
	azy azo-antoka := azo-antoka.
}.

Antontan-taratasy-Web rehefa: ['cookie-fivoriana-tranonkala-mitovy:'] ataovy: { :sanda
	tena hamarino-lohateny.
	>> safidy := Lisitra vaovao 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	safidy manana: sanda, diso: {
		ity-asa-ity fahadisoana: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	azy tranonkala-mitovy := sanda.
}.

Antontan-taratasy-Web rehefa: ['lohateny:'] ataovy: { :lohateny
	tena hamarino-lohateny.
	azy lohateny-rehetra ampio-any-amin-ny-farany: lohateny.
}.

Antontan-taratasy-Web rehefa: ['foano-lohateny'] ataovy: {
	tena hamarino-lohateny.
	azy lohateny-rehetra := Lisitra vaovao.
}.

Antontan-taratasy-Web rehefa: ['mpitantana-fivoriana:'] ataovy: { :mpitantana
	tena hamarino-lohateny.
	azy mpitantana-fivoriana := mpitantana.
}.

Antontan-taratasy-Web rehefa: ['mpitantana-fivoriana'] ataovy: { <- azy mpitantana-fivoriana.
}.

Antontan-taratasy-Web rehefa: ['hamarino-lohateny'] ataovy: {
	azy lohateny-nalefa marina: {
		ity-asa-ity fahadisoana: ['Headers already sent to client.'].
	}.
}.

Antontan-taratasy-Web rehefa: ['atombohy-ny-fivoriana'] ataovy: {
	tena hamarino-lohateny.
	>> fangatahana-http := azy fangatahana-http.
	>> id-fivoriana := fangatahana-http cookie: ['xsid'].
	id-fivoriana Tsinontsinona? diso: {
		(( Lamina vaovao: ['^[A-Za-z0-9]+\\z'], fifanarahana: id-fivoriana ) = 0) marina: {
			id-fivoriana := Tsinontsinona.
		}.
	}.
	id-fivoriana Tsinontsinona? marina: {
		id-fivoriana := Vata-fiarovana token: 30.
		>> lohateny-fivoriana := Lohateny-HTTP vaovao
		lakile: ['Set-Cookie'] sanda: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (azy azo-antoka ity: ['Secure'] na-iry: ['']),
		SSITE: (azy tranonkala-mitovy),
		XSID: id-fivoriana
		).
		azy lohateny-rehetra ampio-any-amin-ny-farany: lohateny-fivoriana.
	}.
	azy angona-fivoriana := azy mpitantana-fivoriana ho-an-ny: id-fivoriana, ampidiro. <- azy angona-fivoriana. # reference
}.

Antontan-taratasy-Web rehefa: ['mandehana-any:'] ataovy: { :adiresy
	tena hamarino-lohateny.
	tena foano-lohateny.
	azy lohateny-rehetra
	ampio-any-amin-ny-farany: (
		Lohateny-HTTP vaovao
		lakile: ['Status'] sanda: ['303 See Other']
	),
	ampio-any-amin-ny-farany: (
		Lohateny-HTTP vaovao
		lakile: ['Location'] sanda: adiresy
	).
	tena avoahy: ['Redirect'].
}.

Antontan-taratasy-Web rehefa: ['ravao-ny-fivoriana'] ataovy: {
	tena hamarino-lohateny.
	>> fangatahana-http := azy fangatahana-http.
	>> id-fivoriana := fangatahana-http cookie: ['xsid'].
	id-fivoriana Tsinontsinona? diso: {
		>> lohateny-fivoriana := Lohateny-HTTP vaovao.
		>> fotoana-lany := Fotoana vaovao taona: 1970, endrika: ['%a, %d %b %Y %H:%M:%S GMT'].
		lohateny-fivoriana lakile: ['Set-Cookie'] sanda: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: fotoana-lany,
			SEC: (azy azo-antoka ity: ['Secure'] na-iry: ['']),
			SSITE: (azy tranonkala-mitovy),
			XSID: id-fivoriana
		).
		azy mpitantana-fivoriana ravao.
		azy lohateny-rehetra ampio-any-amin-ny-farany: lohateny-fivoriana.
	}.
}.


Antontan-taratasy-Web rehefa: ['modely-pejy:'] ataovy: { :lalan-drakitra <- Modely-pejy vaovao: (Rakitra vaovao: lalan-drakitra, vakio).
}.

Antontan-taratasy-Web rehefa: ['avoahy:karazana:'] ataovy: { :vokatra :karazana
	azy lohateny-nalefa diso: {
		azy angona-fivoriana Tsinontsinona? diso: {
			azy mpitantana-fivoriana tehirizo: azy angona-fivoriana.
		}.
		azy lohateny-rehetra ampio-any-amin-ny-farany: (
			Lohateny-HTTP vaovao
			lakile: ['Content-type'] sanda: karazana
		).
		azy lohateny-rehetra tsirairay: { :_ :lohateny
			Vokatra soraty: lohateny.
		}.
		azy lohateny-nalefa := Marina.
		Vokatra soraty: ['\r\n'].
	}.
	Vokatra soraty: vokatra.
}.

Antontan-taratasy-Web rehefa: ['vitao:karazana:'] ataovy: { :vokatra :karazana
	azy lohateny-nalefa diso: {
		azy angona-fivoriana Tsinontsinona? diso: {
			azy mpitantana-fivoriana tehirizo: azy angona-fivoriana.
		}.
		azy lohateny-rehetra ampio-any-amin-ny-farany: (
			Lohateny-HTTP vaovao
			lakile: ['Content-type'] sanda: karazana
		).
		azy lohateny-rehetra ampio-any-amin-ny-farany: (
			Lohateny-HTTP vaovao
			lakile: ['Content-Length'] sanda: vokatra soratra bytes
		).
		azy lohateny-rehetra tsirairay: { :_ :lohateny
			Vokatra soraty: lohateny.
		}.
		azy lohateny-nalefa := Marina.
		Vokatra soraty: ['\r\n'].
	}.
	Vokatra soraty: vokatra.
}.

Antontan-taratasy-Web rehefa: ['avoahy:'] ataovy: { :vokatra
	tena avoahy: vokatra karazana: ['text/html; charset=utf-8'].
}.

Antontan-taratasy-Web rehefa: ['vitao:'] ataovy: { :vokatra
	tena vitao: vokatra karazana: ['text/html; charset=utf-8'].
}.

Antontan-taratasy-Web rehefa: ['json:'] ataovy: { :vokatra
	tena avoahy: ( JSON jsonify: vokatra ) karazana: ['application/json'].
}.

Antontan-taratasy-Web rehefa: ['tsy-hita:'] ataovy: { :vokatra
	tena foano-lohateny lohateny: (
		Lohateny-HTTP vaovao lakile: ['Status'] sanda: ['404 Not Found']
	).
	tena avoahy: vokatra.
}.


# Interface

>> Fivoriana := Zavatra vaovao.

Fivoriana rehefa: ['vaovao'] ataovy: { <- tena vaovao omano ho-an-ny: Tsinontsinona.
}.

Fivoriana rehefa: ['ho-an-ny:'] ataovy: { :id
	azy id := id.
}.

Fivoriana rehefa: ['ampidiro'] ataovy: {
	ity-asa-ity fahadisoana: ['Not implemented.'].
}.

Fivoriana rehefa: ['tehirizo:'] ataovy: {
	ity-asa-ity fahadisoana: ['Not implemented.'].
}.

Fivoriana rehefa: ['ravao'] ataovy: {
	ity-asa-ity fahadisoana: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Fivoriana-rakitra-vonjimaika := Fivoriana vaovao.

Fivoriana-rakitra-vonjimaika rehefa: ['omano'] ataovy: {
	azy fiandohan-dalana := ['/tmp/sess-'].
}.

Fivoriana-rakitra-vonjimaika rehefa: ['tovona-lalana:'] ataovy: { :tady-soratra
	azy fiandohan-dalana := tady-soratra.
}.

Fivoriana-rakitra-vonjimaika rehefa: ['rakitra-fivoriana'] ataovy: { <- ( Rakitra vaovao: ( azy fiandohan-dalana + azy id + ['.txt'] ) ).
}.

Fivoriana-rakitra-vonjimaika rehefa: ['ampidiro'] ataovy: {
	>> rakitra-fivoriana := tena rakitra-fivoriana.
	rakitra-fivoriana misy diso: {
		rakitra-fivoriana soraty: (Rakibolana vaovao kaody).
	}. <- rakitra-fivoriana vakio zavatra.
}.

Fivoriana-rakitra-vonjimaika rehefa: ['tehirizo:'] ataovy: { :angona
	>> rakitra-fivoriana := tena rakitra-fivoriana.
	rakitra-fivoriana misy marina: {
		rakitra-fivoriana soraty: angona kaody.
	}.
}.

Fivoriana-rakitra-vonjimaika rehefa: ['ravao'] ataovy: {
	>> rakitra-fivoriana := tena rakitra-fivoriana.
	rakitra-fivoriana misy marina: {
		rakitra-fivoriana fafao.
	}.
}.


>> URL := Zavatra vaovao.

URL rehefa: ['omano'] ataovy: {
	azy protokolya := ['https://'].
	azy mpampiantrano := ['localhost'].
	azy lalan-drakitra := [''].
	azy masontsivana-url := [''].
	azy hash := [''].
}.

URL rehefa: ['vaovao'] ataovy: { <- tena vaovao omano.
}.

URL rehefa: ['soratra'] ataovy: { <- (
	azy protokolya +
	azy mpampiantrano +
	azy lalan-drakitra +
	azy masontsivana-url +
	azy hash ).
}.

URL rehefa: ['protokolya:'] ataovy: { :protokolya
	((Lisitra vaovao ; ['http'] ; ['https']) manana: protokolya) marina: {
		azy protokolya := protokolya + ['://'].
	}, diso: {
		ity-asa-ity fahadisoana: ['Invalid protocol'].
	}.
}.

URL rehefa: ['mpampiantrano:'] ataovy: { :mpampiantrano
	#todo validate according to rfc
	azy mpampiantrano := mpampiantrano.
}.

URL rehefa: ['lalan-drakitra:'] ataovy: { :lalan-drakitra
	azy lalan-drakitra := ['/'] + lalan-drakitra url-asio-kaody.
}.

URL rehefa: ['masontsivana-url:'] ataovy: { :fifandraisana
	>> masontsivana-url := Lisitra vaovao.
	fifandraisana tsirairay: { :lakile :sanda
		masontsivana-url ampio-any-amin-ny-farany: lakile soratra url-asio-kaody + ['='] + sanda soratra url-asio-kaody.
	}.
	azy masontsivana-url := ['?'] + ( masontsivana-url atambaro: ['&'] ).
}.

URL rehefa: ['hash:'] ataovy: { :hash
	azy hash := ['#'] + hash url-asio-kaody.
}.

