
# ~ Simple template engine ~

>> Templed := Gwrthrych newydd.

Templed ar: ['newydd'] gwneud: { <- hun newydd cynnwys: [''].
}.

Templed ar: ['cynnwys:'] gwneud: { :cynnwys
	eiddo cynnwys := cynnwys. 
}.

Templed ar: ['newydd:'] gwneud: { :cynnwys <- hun newydd cynnwys: cynnwys.
}.

Templed ar: ['torri:'] gwneud: { :nod
	>> nod-dechrau := (['<!-- cut:%id% -->'] %id%: nod).
	>> nod-diwedd := (['<!-- /cut:%id% -->'] %id%: nod).
	>> rhannau := eiddo cynnwys hollti: nod-dechrau.
	>> rhagddodiad := rhannau cyntaf.
	>> rhannau2 := rhannau olaf hollti: nod-diwedd.
	>> ôl-ddodiad := rhannau2 olaf.
	>> rhan := rhannau2 cyntaf.
	>> gweddill := rhagddodiad + ôl-ddodiad.
	eiddo cynnwys := gweddill. <- Templed newydd: rhan.
	
}.

Templed ar: ['copïo'] gwneud: { <- hun newydd: hun llinyn copïo.
}.
	
Templed ar: ['gludo:yn:'] gwneud: { :pyt :id
	>> nod-gludo := (['<!-- paste:%id% -->'] %id%: id).
	eiddo cynnwys disodli: nod-gludo gyda: ( pyt llinyn + nod-gludo ).
}.

Templed ar: ['gosod:gwerth:'] gwneud: { :slot :gwerth
	eiddo cynnwys disodli: ['<!-- slot:'] + slot + [' -->'] gyda: ( Server html-amgodio: gwerth ).
}.

Templed ar: ['gosod:html:'] gwneud: { :slot :html
	eiddo cynnwys disodli: ['<!-- slot:'] + slot + [' -->'] gyda: html.
}.

Templed ar: ['ymateb:a:'] gwneud: { :slot :gwerth
	hun gosod: (slot o: 0 hyd: (slot hyd - 1)) gwerth: gwerth.
}.

Templed ar: ['nl2br'] gwneud: {
	eiddo cynnwys disodli: ['\n'] gyda: ['<br>'].
}.

Templed ar: ['glanhau'] gwneud: {
	eiddo cynnwys :=
		Patrwm
		newydd: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		cydweddu: eiddo cynnwys
		gwneud: { <- ['']. }.
}.

Templed ar: ['glanhau-toriadau'] gwneud: {
	>> eitemau := Rhestr newydd.
	Patrwm
	newydd: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	cydweddu: eiddo cynnwys
	gwneud: { :_ :rhan
		eitemau atodi: rhan ? 1.
	}.
	eitemau pob: { :_ :id
		eiddo cynnwys :=
			Patrwm newydd: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			cydweddu: eiddo cynnwys
			gwneud: { <- ['']. }.
	 }.
}.

Templed ar: ['glanhau-bylchau'] gwneud: {
	eiddo cynnwys :=
		Patrwm
		newydd: ['\\s*\\n'],
		cydweddu: eiddo cynnwys
		gwneud: { <- ['\n']. }.
	eiddo cynnwys :=
		Patrwm
		newydd: ['\\n[\\s\\t]+'],
		cydweddu: eiddo cynnwys
		gwneud: { <- ['\n']. }.
}.

Templed ar: ['glanhau-popeth'] gwneud: {
	hun glanhau.
	hun glanhau-toriadau.
	hun glanhau-bylchau.
}.

Templed ar: ['llinyn'] gwneud: { <- eiddo cynnwys.
}.
