>> E-bost := Gwrthrych newydd.

E-bost ar: ['paratoi'] gwneud: {
	eiddo derbynwyr := Rhestr newydd.
	eiddo cc := Rhestr newydd.
	eiddo bcc := Rhestr newydd.
	eiddo anfonwr := Dim.
	eiddo enw-anfonwr := Dim.
	eiddo pwnc := Dim.
	eiddo corff := Dim.
}.

E-bost ar: ['newydd'] gwneud: { <- hun newydd paratoi.
}.

E-bost ar: ['at:'] gwneud: { :rhestriad
	eiddo derbynwyr := rhestriad.
}.
 
E-bost ar: ['cc:'] gwneud: { :rhestriad
	eiddo cc := rhestriad.
}.

E-bost ar: ['bcc:'] gwneud: { :rhestriad
	eiddo bcc := rhestriad.
}.

E-bost ar: ['pwnc:'] gwneud: { :pwnc
	eiddo pwnc := pwnc.
}.

E-bost ar: ['anfonwr:enw:'] gwneud: { :anfonwr :enw
	eiddo anfonwr := anfonwr.
	eiddo enw-anfonwr := enw.
}.

E-bost ar: ['corff:'] gwneud: { :corff
	eiddo corff := corff.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-bost ar: ['pennawd:'] gwneud: { :llinell <- llinell disodli: ['\r'] gyda: [''], disodli: ['\n'] gyda: [''].
}.

E-bost ar: ['anfon'] gwneud: {
	>> f := Ffeil tempwrite: hun cynhyrchu.
	Rhaglen system: ['sendmail -t < '] + f llwybr, llinell-newydd.
}.

E-bost ar: ['cynhyrchu'] gwneud: {
	>> toriad-llinell := ['\r\n'].
	>> llinyn-testun := [''].
	llinyn-testun atodi: (hun pennawd: ['From: '] + eiddo enw-anfonwr + [' <'] + ( eiddo anfonwr ) + ['>']) + toriad-llinell.
	llinyn-testun atodi: (hun pennawd: ['To: '] + ( eiddo derbynwyr cyfuno: [','] )) + toriad-llinell.
	eiddo cc cyfrif gwir: {
		llinyn-testun atodi: (hun pennawd: ['Cc: '] + ( eiddo cc cyfuno: [','] )) + toriad-llinell.
	}.
	eiddo bcc cyfrif gwir: {
		llinyn-testun atodi: (hun pennawd: ['Bcc: '] + ( eiddo bcc cyfuno: [','] )) + toriad-llinell.
	}.
	llinyn-testun atodi: (hun pennawd: ['Subject: '] + eiddo pwnc) + toriad-llinell.
	llinyn-testun atodi: toriad-llinell.
	llinyn-testun atodi: eiddo corff.
	llinyn-testun atodi: toriad-llinell. <- llinyn-testun.
}.

>> E-bost-HTML := E-bost newydd.

E-bost-HTML ar: ['paratoi'] gwneud: {
	hun paratoi.
	eiddo atodiadau := Rhestr newydd.
	eiddo ffin := Cromgell tocyn: 40.
}.

E-bost-HTML ar: ['atodi-ffeil:'] gwneud: { :ffeil
	>> id := eiddo atodiadau cyfrif.
	>> blob := ffeil blob.
	eiddo atodiadau atodi: (
		Geiriadur newydd
			ffeil: ffeil llwybr,
			mime: ['image/'] + (Server mimetype: ffeil llwybr),
			data: blob base64-amgodio
	).
	blob rhyddhau. <- ['cid:attachment'] + id.
}.

E-bost-HTML ar: ['cynhyrchu'] gwneud: {
	>> toriad-llinell := ['\r\n'].
	>> llinyn-testun := [''].
	llinyn-testun atodi: (hun pennawd: ['From: '] + eiddo enw-anfonwr + [' <'] + ( eiddo anfonwr ) + ['>']) + toriad-llinell.
	llinyn-testun atodi: (hun pennawd: ['To: '] + ( eiddo derbynwyr cyfuno: [','] )) + toriad-llinell.
	eiddo cc cyfrif gwir: {
		llinyn-testun atodi: (hun pennawd: ['Cc: '] + ( eiddo cc cyfuno: [','] )) + toriad-llinell.
	}.
	eiddo bcc cyfrif gwir: {
		llinyn-testun atodi: (hun pennawd: ['Bcc: '] + ( eiddo bcc cyfuno: [','] )) + toriad-llinell.
	}.
	llinyn-testun atodi: (hun pennawd: ['Subject: '] + eiddo pwnc) + toriad-llinell.
	llinyn-testun atodi: ['MIME-Version: 1.0'] + toriad-llinell.
	llinyn-testun atodi: ['Content-Type: multipart/related; boundary="'] + eiddo ffin + ['"; type=text/html'] + toriad-llinell.
	llinyn-testun atodi: toriad-llinell.
	llinyn-testun atodi: ['--'] + eiddo ffin + toriad-llinell.
	llinyn-testun atodi: ['Content-Type: text/html; charset=UTF-8'] + toriad-llinell.
	llinyn-testun atodi: ['Content-Transfer-Encoding: 7bit'] + toriad-llinell.
	llinyn-testun atodi: toriad-llinell.
	llinyn-testun atodi: eiddo corff.
	llinyn-testun atodi: toriad-llinell.
	eiddo atodiadau pob: { :id :gwybodaeth
		>> blob := gwybodaeth data.
		llinyn-testun atodi: ['--'] + eiddo ffin + toriad-llinell.
		llinyn-testun atodi: ['Content-Type: '] + gwybodaeth mime + toriad-llinell.
		llinyn-testun atodi: ['Content-Transfer-Encoding: base64'] + toriad-llinell.
		llinyn-testun atodi: ['Content-ID: <attachment'] + id + ['>'] + toriad-llinell.
		llinyn-testun atodi: ['Content-Disposition: inline; filename="'] + gwybodaeth ffeil + ['"'] + toriad-llinell.
		llinyn-testun atodi: toriad-llinell.
		>> uchafswm := 76.
		>> hyd-testun := blob hyd.
		>> talpiau := (hyd-testun / uchafswm) talgrynnu-i-fyny.
		{ :i
			>> talp := blob copïo o: i * uchafswm hyd: uchafswm.
			llinyn-testun atodi: talp + toriad-llinell.
		} * talpiau.
		llinyn-testun atodi: toriad-llinell.
		llinyn-testun atodi: toriad-llinell.
	}.
	llinyn-testun atodi: ['--'] + eiddo ffin + ['--'] + toriad-llinell. <- llinyn-testun.
}.
