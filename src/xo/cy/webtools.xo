HTTP-Cais ar: ['HTTP-pennawd:'] gwneud: { :allwedd <- Rhaglen gosodiad: allwedd.
}.

>> Pennawd-HTTP := Gwrthrych newydd.

Pennawd-HTTP ar: ['newydd'] gwneud: { <- hun newydd paratoi.
}.

Pennawd-HTTP ar: ['paratoi'] gwneud: {
	eiddo allwedd := Dim.
	eiddo gwerth := Dim.
}.

Pennawd-HTTP ar: ['allwedd:gwerth:'] gwneud: { :allwedd :gwerth
	eiddo allwedd := allwedd.
	eiddo gwerth := gwerth.
}.

Pennawd-HTTP ar: ['allwedd'] gwneud: { <- eiddo allwedd.
}.

Pennawd-HTTP ar: ['gwerth'] gwneud: { <- eiddo gwerth.
}.


Pennawd-HTTP ar: ['llinyn'] gwneud: {
	>> llinell := eiddo allwedd + [': '] + eiddo gwerth.
	llinell disodli: ['\r'] gyda: [''], disodli: ['\n'] gyda: ['']. <- llinell + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dogfen-We := Gwrthrych newydd.

Dogfen-We ar: ['newydd'] gwneud: { <- hun newydd paratoi.
}.

Dogfen-We ar: ['paratoi'] gwneud: {
	eiddo penawdau := Rhestr newydd.
	eiddo id-sesiwn := Dim.
	eiddo rheolwr-sesiynau := Sesiwn-ffeil-dros-dro newydd.
	eiddo data-sesiwn := Dim.
	eiddo diogel := Gwir.
	eiddo yr-un-safle := ['Strict'].
	eiddo penawdau-wedi-anfon := Gau.
	eiddo cais := HTTP-Cais newydd.
}.

Dogfen-We ar: ['cais:'] gwneud: { :cais
	eiddo cais := cais.
}. 

Dogfen-We ar: ['cwci-sesiwn-diogel:'] gwneud: { :diogel
	hun gwirio-penawdau.
	eiddo diogel := diogel.
}.

Dogfen-We ar: ['cwci-sesiwn-yr-un-safle:'] gwneud: { :gwerth
	hun gwirio-penawdau.
	>> opsiynau := Rhestr newydd 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsiynau mae-ganddo: gwerth, gau: {
		y-dasg-hon gwall: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eiddo yr-un-safle := gwerth.
}.

Dogfen-We ar: ['pennawd:'] gwneud: { :pennawd
	hun gwirio-penawdau.
	eiddo penawdau atodi: pennawd.
}.

Dogfen-We ar: ['clirio-penawdau'] gwneud: {
	hun gwirio-penawdau.
	eiddo penawdau := Rhestr newydd.
}.

Dogfen-We ar: ['rheolwr-sesiynau:'] gwneud: { :rheolwr
	hun gwirio-penawdau.
	eiddo rheolwr-sesiynau := rheolwr.
}.

Dogfen-We ar: ['rheolwr-sesiynau'] gwneud: { <- eiddo rheolwr-sesiynau.
}.

Dogfen-We ar: ['gwirio-penawdau'] gwneud: {
	eiddo penawdau-wedi-anfon gwir: {
		y-dasg-hon gwall: ['Headers already sent to client.'].
	}.
}.

Dogfen-We ar: ['dechrau-sesiwn'] gwneud: {
	hun gwirio-penawdau.
	>> cais := eiddo cais.
	>> id-sesiwn := cais cookie: ['xsid'].
	id-sesiwn Dim? gau: {
		(( Patrwm newydd: ['^[A-Za-z0-9]+\\z'], cydweddu: id-sesiwn ) = 0) gwir: {
			id-sesiwn := Dim.
		}.
	}.
	id-sesiwn Dim? gwir: {
		id-sesiwn := Cromgell tocyn: 30.
		>> pennawd-sesiwn := Pennawd-HTTP newydd
		allwedd: ['Set-Cookie'] gwerth: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eiddo diogel naill-ai: ['Secure'] neu: ['']),
		SSITE: (eiddo yr-un-safle),
		XSID: id-sesiwn
		).
		eiddo penawdau atodi: pennawd-sesiwn.
	}.
	eiddo data-sesiwn := eiddo rheolwr-sesiynau ar-gyfer: id-sesiwn, llwytho. <- eiddo data-sesiwn. # reference
}.

Dogfen-We ar: ['mynd-i:'] gwneud: { :cyfeiriad
	hun gwirio-penawdau.
	hun clirio-penawdau.
	eiddo penawdau
	atodi: (
		Pennawd-HTTP newydd
		allwedd: ['Status'] gwerth: ['303 See Other']
	),
	atodi: (
		Pennawd-HTTP newydd
		allwedd: ['Location'] gwerth: cyfeiriad
	).
	hun allbynnu: ['Redirect'].
}.

Dogfen-We ar: ['dinistrio-sesiwn'] gwneud: {
	hun gwirio-penawdau.
	>> cais := eiddo cais.
	>> id-sesiwn := cais cookie: ['xsid'].
	id-sesiwn Dim? gau: {
		>> pennawd-sesiwn := Pennawd-HTTP newydd.
		>> adeg := Ennyd newydd blwyddyn: 1970, fformat: ['%a, %d %b %Y %H:%M:%S GMT'].
		pennawd-sesiwn allwedd: ['Set-Cookie'] gwerth: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: adeg,
			SEC: (eiddo diogel naill-ai: ['Secure'] neu: ['']),
			SSITE: (eiddo yr-un-safle),
			XSID: id-sesiwn
		).
		eiddo rheolwr-sesiynau dinistrio.
		eiddo penawdau atodi: pennawd-sesiwn.
	}.
}.


Dogfen-We ar: ['templed:'] gwneud: { :llwybr <- Templed newydd: (Ffeil newydd: llwybr, darllen).
}.

Dogfen-We ar: ['allbynnu:math:'] gwneud: { :allbwn :math
	eiddo penawdau-wedi-anfon gau: {
		eiddo data-sesiwn Dim? gau: {
			eiddo rheolwr-sesiynau cadw: eiddo data-sesiwn.
		}.
		eiddo penawdau atodi: (
			Pennawd-HTTP newydd
			allwedd: ['Content-type'] gwerth: math
		).
		eiddo penawdau pob: { :_ :pennawd
			Allbwn ysgrifennu: pennawd.
		}.
		eiddo penawdau-wedi-anfon := Gwir.
		Allbwn ysgrifennu: ['\r\n'].
	}.
	Allbwn ysgrifennu: allbwn.
}.

Dogfen-We ar: ['gorffen:math:'] gwneud: { :allbwn :math
	eiddo penawdau-wedi-anfon gau: {
		eiddo data-sesiwn Dim? gau: {
			eiddo rheolwr-sesiynau cadw: eiddo data-sesiwn.
		}.
		eiddo penawdau atodi: (
			Pennawd-HTTP newydd
			allwedd: ['Content-type'] gwerth: math
		).
		eiddo penawdau atodi: (
			Pennawd-HTTP newydd
			allwedd: ['Content-Length'] gwerth: allbwn llinyn bytes
		).
		eiddo penawdau pob: { :_ :pennawd
			Allbwn ysgrifennu: pennawd.
		}.
		eiddo penawdau-wedi-anfon := Gwir.
		Allbwn ysgrifennu: ['\r\n'].
	}.
	Allbwn ysgrifennu: allbwn.
}.

Dogfen-We ar: ['allbynnu:'] gwneud: { :allbwn
	hun allbynnu: allbwn math: ['text/html; charset=utf-8'].
}.

Dogfen-We ar: ['gorffen:'] gwneud: { :allbwn
	hun gorffen: allbwn math: ['text/html; charset=utf-8'].
}.

Dogfen-We ar: ['json:'] gwneud: { :allbwn
	hun allbynnu: ( JSON jsonify: allbwn ) math: ['application/json'].
}.

Dogfen-We ar: ['heb-ei-ganfod:'] gwneud: { :allbwn
	hun clirio-penawdau pennawd: (
		Pennawd-HTTP newydd allwedd: ['Status'] gwerth: ['404 Not Found']
	).
	hun allbynnu: allbwn.
}.


# Interface

>> Sesiwn := Gwrthrych newydd.

Sesiwn ar: ['newydd'] gwneud: { <- hun newydd paratoi ar-gyfer: Dim.
}.

Sesiwn ar: ['ar-gyfer:'] gwneud: { :id
	eiddo id := id.
}.

Sesiwn ar: ['llwytho'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

Sesiwn ar: ['cadw:'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

Sesiwn ar: ['dinistrio'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesiwn-ffeil-dros-dro := Sesiwn newydd.

Sesiwn-ffeil-dros-dro ar: ['paratoi'] gwneud: {
	eiddo dechrau-llwybr := ['/tmp/sess-'].
}.

Sesiwn-ffeil-dros-dro ar: ['rhagddodiad-llwybr:'] gwneud: { :llinyn-testun
	eiddo dechrau-llwybr := llinyn-testun.
}.

Sesiwn-ffeil-dros-dro ar: ['ffeil'] gwneud: { <- ( Ffeil newydd: ( eiddo dechrau-llwybr + eiddo id + ['.txt'] ) ).
}.

Sesiwn-ffeil-dros-dro ar: ['llwytho'] gwneud: {
	>> ffeil := hun ffeil.
	ffeil yn-bodoli gau: {
		ffeil ysgrifennu: (Geiriadur newydd cod).
	}. <- ffeil darllen gwrthrych.
}.

Sesiwn-ffeil-dros-dro ar: ['cadw:'] gwneud: { :data
	>> ffeil := hun ffeil.
	ffeil yn-bodoli gwir: {
		ffeil ysgrifennu: data cod.
	}.
}.

Sesiwn-ffeil-dros-dro ar: ['dinistrio'] gwneud: {
	>> ffeil := hun ffeil.
	ffeil yn-bodoli gwir: {
		ffeil dileu.
	}.
}.


>> URL := Gwrthrych newydd.

URL ar: ['paratoi'] gwneud: {
	eiddo protocol := ['https://'].
	eiddo gwesteiwr := ['localhost'].
	eiddo llwybr := [''].
	eiddo paramedrau-url := [''].
	eiddo hash := [''].
}.

URL ar: ['newydd'] gwneud: { <- hun newydd paratoi.
}.

URL ar: ['llinyn'] gwneud: { <- (
	eiddo protocol +
	eiddo gwesteiwr +
	eiddo llwybr +
	eiddo paramedrau-url +
	eiddo hash ).
}.

URL ar: ['protocol:'] gwneud: { :protocol
	((Rhestr newydd ; ['http'] ; ['https']) mae-ganddo: protocol) gwir: {
		eiddo protocol := protocol + ['://'].
	}, gau: {
		y-dasg-hon gwall: ['Invalid protocol'].
	}.
}.

URL ar: ['gwesteiwr:'] gwneud: { :gwesteiwr
	#todo validate according to rfc
	eiddo gwesteiwr := gwesteiwr.
}.

URL ar: ['llwybr:'] gwneud: { :llwybr
	eiddo llwybr := ['/'] + llwybr url-amgodio.
}.

URL ar: ['paramedrau-url:'] gwneud: { :mapio
	>> paramedrau-url := Rhestr newydd.
	mapio pob: { :allwedd :gwerth
		paramedrau-url atodi: allwedd llinyn url-amgodio + ['='] + gwerth llinyn url-amgodio.
	}.
	eiddo paramedrau-url := ['?'] + ( paramedrau-url cyfuno: ['&'] ).
}.

URL ar: ['stwnsh:'] gwneud: { :hash
	eiddo hash := ['#'] + hash url-amgodio.
}.

