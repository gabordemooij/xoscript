HTTP-Cais ar: ['HTTP-header:'] gwneud: { :key <- Rhaglen gosodiad: key.
}.

>> HTTP-Header := Gwrthrych newydd.

HTTP-Header ar: ['newydd'] gwneud: { <- hun newydd init.
}.

HTTP-Header ar: ['init'] gwneud: {
	eiddo key := Dim.
	eiddo value := Dim.
}.

HTTP-Header ar: ['key:value:'] gwneud: { :key :value
	eiddo key := key.
	eiddo value := value.
}.

HTTP-Header ar: ['key'] gwneud: { <- eiddo key.
}.

HTTP-Header ar: ['value'] gwneud: { <- eiddo value.
}.


HTTP-Header ar: ['llinyn'] gwneud: {
	>> line := eiddo key + [': '] + eiddo value.
	line disodli: ['\r'] gyda: [''], disodli: ['\n'] gyda: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Gwrthrych newydd.

Web-Document ar: ['newydd'] gwneud: { <- hun newydd init.
}.

Web-Document ar: ['init'] gwneud: {
	eiddo headers := Rhestr newydd.
	eiddo sess-id := Dim.
	eiddo session-manager := Tempfile-Session newydd.
	eiddo sessdata := Dim.
	eiddo secure := Gwir.
	eiddo same-site := ['Strict'].
	eiddo headers-out := Gau.
	eiddo request := HTTP-Cais newydd.
}.

Web-Document ar: ['request:'] gwneud: { :request
	eiddo request := request.
}. 

Web-Document ar: ['secure-session-cookie:'] gwneud: { :secure
	hun check-headers.
	eiddo secure := secure.
}.

Web-Document ar: ['same-site-session-cookie:'] gwneud: { :value
	hun check-headers.
	>> options := Rhestr newydd 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options yn-cynnwys: value, gau: {
		y-dasg-hon gwall: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eiddo same-site := value.
}.

Web-Document ar: ['header:'] gwneud: { :header
	hun check-headers.
	eiddo headers atodi: header.
}.

Web-Document ar: ['clear-headers'] gwneud: {
	hun check-headers.
	eiddo headers := Rhestr newydd.
}.

Web-Document ar: ['session-manager:'] gwneud: { :manager
	hun check-headers.
	eiddo session-manager := manager.
}.

Web-Document ar: ['session-manager'] gwneud: { <- eiddo session-manager.
}.

Web-Document ar: ['check-headers'] gwneud: {
	eiddo headers-out gwir: {
		y-dasg-hon gwall: ['Headers already sent to client.'].
	}.
}.

Web-Document ar: ['session-start'] gwneud: {
	hun check-headers.
	>> request := eiddo request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Dim? gau: {
		(( Patrwm newydd: ['^[A-Za-z0-9]+\\z'], cydweddu: sess-id ) = 0) gwir: {
			sess-id := Dim.
		}.
	}.
	sess-id Dim? gwir: {
		sess-id := Cromgell tocyn: 30.
		>> session-header := HTTP-Header newydd
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eiddo secure naill-ai: ['Secure'] neu: ['']),
		SSITE: (eiddo same-site),
		XSID: sess-id
		).
		eiddo headers atodi: session-header.
	}.
	eiddo sessdata := eiddo session-manager for: sess-id, load. <- eiddo sessdata. # reference
}.

Web-Document ar: ['goto:'] gwneud: { :url
	hun check-headers.
	hun clear-headers.
	eiddo headers
	atodi: (
		HTTP-Header newydd
		key: ['Status'] value: ['303 See Other']
	),
	atodi: (
		HTTP-Header newydd
		key: ['Location'] value: url
	).
	hun out: ['Redirect'].
}.

Web-Document ar: ['session-destroy'] gwneud: {
	hun check-headers.
	>> request := eiddo request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Dim? gau: {
		>> session-header := HTTP-Header newydd.
		>> when := Ennyd newydd blwyddyn: 1970, fformat: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (eiddo secure naill-ai: ['Secure'] neu: ['']),
			SSITE: (eiddo same-site),
			XSID: sess-id
		).
		eiddo session-manager destroy.
		eiddo headers atodi: session-header.
	}.
}.


Web-Document ar: ['template:'] gwneud: { :llwybr <- Template newydd: (Ffeil newydd: llwybr, darllen).
}.

Web-Document ar: ['out:type:'] gwneud: { :output :math
	eiddo headers-out gau: {
		eiddo sessdata Dim? gau: {
			eiddo session-manager save: eiddo sessdata.
		}.
		eiddo headers atodi: (
			HTTP-Header newydd
			key: ['Content-type'] value: math
		).
		eiddo headers pob: { :_ :header
			Allbwn ysgrifennu: header.
		}.
		eiddo headers-out := Gwir.
		Allbwn ysgrifennu: ['\r\n'].
	}.
	Allbwn ysgrifennu: output.
}.

Web-Document ar: ['finish:type:'] gwneud: { :output :math
	eiddo headers-out gau: {
		eiddo sessdata Dim? gau: {
			eiddo session-manager save: eiddo sessdata.
		}.
		eiddo headers atodi: (
			HTTP-Header newydd
			key: ['Content-type'] value: math
		).
		eiddo headers atodi: (
			HTTP-Header newydd
			key: ['Content-Length'] value: output llinyn bytes
		).
		eiddo headers pob: { :_ :header
			Allbwn ysgrifennu: header.
		}.
		eiddo headers-out := Gwir.
		Allbwn ysgrifennu: ['\r\n'].
	}.
	Allbwn ysgrifennu: output.
}.

Web-Document ar: ['out:'] gwneud: { :output
	hun out: output type: ['text/html; charset=utf-8'].
}.

Web-Document ar: ['finish:'] gwneud: { :output
	hun finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document ar: ['json:'] gwneud: { :output
	hun out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document ar: ['not-found:'] gwneud: { :output
	hun clear-headers header: (
		HTTP-Header newydd key: ['Status'] value: ['404 Not Found']
	).
	hun out: output.
}.


# Interface

>> Session := Gwrthrych newydd.

Session ar: ['newydd'] gwneud: { <- hun newydd init for: Dim.
}.

Session ar: ['for:'] gwneud: { :id
	eiddo id := id.
}.

Session ar: ['load'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

Session ar: ['save:'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

Session ar: ['destroy'] gwneud: {
	y-dasg-hon gwall: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session newydd.

Tempfile-Session ar: ['init'] gwneud: {
	eiddo pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session ar: ['path-prefix:'] gwneud: { :str
	eiddo pathprefix := str.
}.

Tempfile-Session ar: ['file'] gwneud: { <- ( Ffeil newydd: ( eiddo pathprefix + eiddo id + ['.txt'] ) ).
}.

Tempfile-Session ar: ['load'] gwneud: {
	>> file := hun file.
	file yn-bodoli gau: {
		file ysgrifennu: (Geiriadur newydd cod).
	}. <- file darllen gwrthrych.
}.

Tempfile-Session ar: ['save:'] gwneud: { :data
	>> file := hun file.
	file yn-bodoli gwir: {
		file ysgrifennu: data cod.
	}.
}.

Tempfile-Session ar: ['destroy'] gwneud: {
	>> file := hun file.
	file yn-bodoli gwir: {
		file dileu.
	}.
}.


>> URL := Gwrthrych newydd.

URL ar: ['init'] gwneud: {
	eiddo protocol := ['https://'].
	eiddo gwesteiwr := ['localhost'].
	eiddo llwybr := [''].
	eiddo params := [''].
	eiddo hash := [''].
}.

URL ar: ['newydd'] gwneud: { <- hun newydd init.
}.

URL ar: ['llinyn'] gwneud: { <- (
	eiddo protocol +
	eiddo gwesteiwr +
	eiddo llwybr +
	eiddo params +
	eiddo hash ).
}.

URL ar: ['protocol:'] gwneud: { :protocol
	((Rhestr newydd: ['http'] ; ['https']) yn-cynnwys: protocol) gwir: {
		eiddo protocol := protocol + ['://'].
	}, gau: {
		y-dasg-hon gwall: ['Invalid protocol'].
	}.
}.

URL ar: ['gwesteiwr:'] gwneud: { :gwesteiwr
	#todo validate according to rfc
	eiddo gwesteiwr := gwesteiwr.
}.

URL ar: ['path:'] gwneud: { :llwybr
	eiddo llwybr := ['/'] + llwybr url-amgodio.
}.

URL ar: ['params:'] gwneud: { :map
	>> params := Rhestr newydd.
	map pob: { :key :value
		params atodi: key llinyn url-amgodio + ['='] + value llinyn url-amgodio.
	}.
	eiddo params := ['?'] + ( params cyfuno: ['&'] ).
}.

URL ar: ['stwnsh:'] gwneud: { :hash
	eiddo hash := ['#'] + hash url-amgodio.
}.

