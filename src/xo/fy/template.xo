
# ~ Simple template engine ~

>> Sjabloan := Objekt nĳ.

Sjabloan by: ['nĳ'] dwaan: { <- sels nĳ ynhâld: [''].
}.

Sjabloan by: ['ynhâld:'] dwaan: { :ynhâld
	eigen ynhâld := ynhâld. 
}.

Sjabloan by: ['nĳ:'] dwaan: { :ynhâld <- sels nĳ ynhâld: ynhâld.
}.

Sjabloan by: ['knippe:'] dwaan: { :markearring
	>> startmarkearring := (['<!-- cut:%id% -->'] %id%: markearring).
	>> einmarkearring := (['<!-- /cut:%id% -->'] %id%: markearring).
	>> dielen := eigen ynhâld splitse: startmarkearring.
	>> foarheaksel := dielen earste.
	>> dielen2 := dielen lêste splitse: einmarkearring.
	>> efterheaksel := dielen2 lêste.
	>> diel := dielen2 earste.
	>> rest := foarheaksel + efterheaksel.
	eigen ynhâld := rest. <- Sjabloan nĳ: diel.
	
}.

Sjabloan by: ['kopiearje'] dwaan: { <- sels nĳ: sels tekst kopiearje.
}.
	
Sjabloan by: ['plakke:by:'] dwaan: { :fragmint :id
	>> plakmarkearring := (['<!-- paste:%id% -->'] %id%: id).
	eigen ynhâld ferfange: plakmarkearring troch: ( fragmint tekst + plakmarkearring ).
}.

Sjabloan by: ['ynstelle:wearde:'] dwaan: { :plak :wearde
	eigen ynhâld ferfange: ['<!-- slot:'] + plak + [' -->'] troch: ( Server html-kodearje: wearde ).
}.

Sjabloan by: ['ynstelle:html:'] dwaan: { :plak :html
	eigen ynhâld ferfange: ['<!-- slot:'] + plak + [' -->'] troch: html.
}.

Sjabloan by: ['reagearje:en:'] dwaan: { :plak :wearde
	sels ynstelle: (plak fan: 0 lingte: (plak lingte - 1)) wearde: wearde.
}.

Sjabloan by: ['nl2br'] dwaan: {
	eigen ynhâld ferfange: ['\n'] troch: ['<br>'].
}.

Sjabloan by: ['skjinje'] dwaan: {
	eigen ynhâld :=
		Patroan
		nĳ: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		oerienkomst: eigen ynhâld
		dwaan: { <- ['']. }.
}.

Sjabloan by: ['knipsels-skjinje'] dwaan: {
	>> eleminten := Rige nĳ.
	Patroan
	nĳ: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	oerienkomst: eigen ynhâld
	dwaan: { :_ :diel
		eleminten tafoegje: diel ? 1.
	}.
	eleminten elk: { :_ :id
		eigen ynhâld :=
			Patroan nĳ: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			oerienkomst: eigen ynhâld
			dwaan: { <- ['']. }.
	 }.
}.

Sjabloan by: ['wytromte-skjinje'] dwaan: {
	eigen ynhâld :=
		Patroan
		nĳ: ['\\s*\\n'],
		oerienkomst: eigen ynhâld
		dwaan: { <- ['\n']. }.
	eigen ynhâld :=
		Patroan
		nĳ: ['\\n[\\s\\t]+'],
		oerienkomst: eigen ynhâld
		dwaan: { <- ['\n']. }.
}.

Sjabloan by: ['alles-skjinje'] dwaan: {
	sels skjinje.
	sels knipsels-skjinje.
	sels wytromte-skjinje.
}.

Sjabloan by: ['tekst'] dwaan: { <- eigen ynhâld.
}.
