>> E-mail := Objekt nĳ.

E-mail by: ['inisjalisearje'] dwaan: {
	eigen ûntfangers := Rige nĳ.
	eigen cc := Rige nĳ.
	eigen bcc := Rige nĳ.
	eigen ôfstjoerder := Neat.
	eigen ôfstjoerdernamme := Neat.
	eigen ûnderwerp := Neat.
	eigen berjochttekst := Neat.
}.

E-mail by: ['nĳ'] dwaan: { <- sels nĳ inisjalisearje.
}.

E-mail by: ['oan:'] dwaan: { :opsomming
	eigen ûntfangers := opsomming.
}.
 
E-mail by: ['cc:'] dwaan: { :opsomming
	eigen cc := opsomming.
}.

E-mail by: ['bcc:'] dwaan: { :opsomming
	eigen bcc := opsomming.
}.

E-mail by: ['ûnderwerp:'] dwaan: { :ûnderwerp
	eigen ûnderwerp := ûnderwerp.
}.

E-mail by: ['ôfstjoerder:namme:'] dwaan: { :ôfstjoerder :namme
	eigen ôfstjoerder := ôfstjoerder.
	eigen ôfstjoerdernamme := namme.
}.

E-mail by: ['berjochttekst:'] dwaan: { :berjochttekst
	eigen berjochttekst := berjochttekst.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-mail by: ['kop:'] dwaan: { :rigel <- rigel ferfange: ['\r'] troch: [''], ferfange: ['\n'] troch: [''].
}.

E-mail by: ['stjoere'] dwaan: {
	>> f := Bestand tempwrite: sels generearje.
	Programma systeem: ['sendmail -t < '] + f paad, nije-rigel.
}.

E-mail by: ['generearje'] dwaan: {
	>> rigeleinde := ['\r\n'].
	>> tekenrige := [''].
	tekenrige tafoegje: (sels kop: ['From: '] + eigen ôfstjoerdernamme + [' <'] + ( eigen ôfstjoerder ) + ['>']) + rigeleinde.
	tekenrige tafoegje: (sels kop: ['To: '] + ( eigen ûntfangers gearfoegje: [','] )) + rigeleinde.
	eigen cc telle ja: {
		tekenrige tafoegje: (sels kop: ['Cc: '] + ( eigen cc gearfoegje: [','] )) + rigeleinde.
	}.
	eigen bcc telle ja: {
		tekenrige tafoegje: (sels kop: ['Bcc: '] + ( eigen bcc gearfoegje: [','] )) + rigeleinde.
	}.
	tekenrige tafoegje: (sels kop: ['Subject: '] + eigen ûnderwerp) + rigeleinde.
	tekenrige tafoegje: rigeleinde.
	tekenrige tafoegje: eigen berjochttekst.
	tekenrige tafoegje: rigeleinde. <- tekenrige.
}.

>> HTML-E-mail := E-mail nĳ.

HTML-E-mail by: ['inisjalisearje'] dwaan: {
	sels inisjalisearje.
	eigen bylagen := Rige nĳ.
	eigen grins := Klûs token: 40.
}.

HTML-E-mail by: ['taheakje:'] dwaan: { :bestân
	>> id := eigen bylagen telle.
	>> blob := bestân blob.
	eigen bylagen tafoegje: (
		List nĳ
			bestân: bestân paad,
			mime: ['image/'] + (Server mimetype: bestân paad),
			gegevens: blob base64-kodearje
	).
	blob frijjaan. <- ['cid:attachment'] + id.
}.

HTML-E-mail by: ['generearje'] dwaan: {
	>> rigeleinde := ['\r\n'].
	>> tekenrige := [''].
	tekenrige tafoegje: (sels kop: ['From: '] + eigen ôfstjoerdernamme + [' <'] + ( eigen ôfstjoerder ) + ['>']) + rigeleinde.
	tekenrige tafoegje: (sels kop: ['To: '] + ( eigen ûntfangers gearfoegje: [','] )) + rigeleinde.
	eigen cc telle ja: {
		tekenrige tafoegje: (sels kop: ['Cc: '] + ( eigen cc gearfoegje: [','] )) + rigeleinde.
	}.
	eigen bcc telle ja: {
		tekenrige tafoegje: (sels kop: ['Bcc: '] + ( eigen bcc gearfoegje: [','] )) + rigeleinde.
	}.
	tekenrige tafoegje: (sels kop: ['Subject: '] + eigen ûnderwerp) + rigeleinde.
	tekenrige tafoegje: ['MIME-Version: 1.0'] + rigeleinde.
	tekenrige tafoegje: ['Content-Type: multipart/related; boundary="'] + eigen grins + ['"; type=text/html'] + rigeleinde.
	tekenrige tafoegje: rigeleinde.
	tekenrige tafoegje: ['--'] + eigen grins + rigeleinde.
	tekenrige tafoegje: ['Content-Type: text/html; charset=UTF-8'] + rigeleinde.
	tekenrige tafoegje: ['Content-Transfer-Encoding: 7bit'] + rigeleinde.
	tekenrige tafoegje: rigeleinde.
	tekenrige tafoegje: eigen berjochttekst.
	tekenrige tafoegje: rigeleinde.
	eigen bylagen elk: { :id :ynfo
		>> blob := ynfo gegevens.
		tekenrige tafoegje: ['--'] + eigen grins + rigeleinde.
		tekenrige tafoegje: ['Content-Type: '] + ynfo mime + rigeleinde.
		tekenrige tafoegje: ['Content-Transfer-Encoding: base64'] + rigeleinde.
		tekenrige tafoegje: ['Content-ID: <attachment'] + id + ['>'] + rigeleinde.
		tekenrige tafoegje: ['Content-Disposition: inline; filename="'] + ynfo bestân + ['"'] + rigeleinde.
		tekenrige tafoegje: rigeleinde.
		>> heechste := 76.
		>> tekstlingte := blob lingte.
		>> stikken := (tekstlingte / heechste) ôfrûnje-op.
		{ :i
			>> stik := blob kopiearje fan: i * heechste lingte: heechste.
			tekenrige tafoegje: stik + rigeleinde.
		} * stikken.
		tekenrige tafoegje: rigeleinde.
		tekenrige tafoegje: rigeleinde.
	}.
	tekenrige tafoegje: ['--'] + eigen grins + ['--'] + rigeleinde. <- tekenrige.
}.
