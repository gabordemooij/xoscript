HTTP-Fersyk by: ['HTTP-kop:'] dwaan: { :kaai <- Programma ynstelling: kaai.
}.

>> HTTP-Kop := Objekt nĳ.

HTTP-Kop by: ['nĳ'] dwaan: { <- sels nĳ inisjalisearje.
}.

HTTP-Kop by: ['inisjalisearje'] dwaan: {
	eigen kaai := Neat.
	eigen wearde := Neat.
}.

HTTP-Kop by: ['kaai:wearde:'] dwaan: { :kaai :wearde
	eigen kaai := kaai.
	eigen wearde := wearde.
}.

HTTP-Kop by: ['kaai'] dwaan: { <- eigen kaai.
}.

HTTP-Kop by: ['wearde'] dwaan: { <- eigen wearde.
}.


HTTP-Kop by: ['tekst'] dwaan: {
	>> rigel := eigen kaai + [': '] + eigen wearde.
	rigel ferfange: ['\r'] troch: [''], ferfange: ['\n'] troch: ['']. <- rigel + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdokumint := Objekt nĳ.

Webdokumint by: ['nĳ'] dwaan: { <- sels nĳ inisjalisearje.
}.

Webdokumint by: ['inisjalisearje'] dwaan: {
	eigen koppen := Rige nĳ.
	eigen sesje-id := Neat.
	eigen sesjebehearder := Tydlik-bestân-sesje nĳ.
	eigen sesjegegevens := Neat.
	eigen feilich := Ja.
	eigen selde-side := ['Strict'].
	eigen koppen-ferstjoerd := Nee.
	eigen fersyk := HTTP-Fersyk nĳ.
}.

Webdokumint by: ['fersyk:'] dwaan: { :fersyk
	eigen fersyk := fersyk.
}. 

Webdokumint by: ['feilige-sesjekoekje:'] dwaan: { :feilich
	sels koppen-kontrolearje.
	eigen feilich := feilich.
}.

Webdokumint by: ['selde-side-sesjekoekje:'] dwaan: { :wearde
	sels koppen-kontrolearje.
	>> opsjes := Rige nĳ 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsjes hat: wearde, nee: {
		dizze-taak flater: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigen selde-side := wearde.
}.

Webdokumint by: ['kop:'] dwaan: { :kop
	sels koppen-kontrolearje.
	eigen koppen tafoegje: kop.
}.

Webdokumint by: ['koppen-wiskje'] dwaan: {
	sels koppen-kontrolearje.
	eigen koppen := Rige nĳ.
}.

Webdokumint by: ['sesjebehearder:'] dwaan: { :behearder
	sels koppen-kontrolearje.
	eigen sesjebehearder := behearder.
}.

Webdokumint by: ['sesjebehearder'] dwaan: { <- eigen sesjebehearder.
}.

Webdokumint by: ['koppen-kontrolearje'] dwaan: {
	eigen koppen-ferstjoerd ja: {
		dizze-taak flater: ['Headers already sent to client.'].
	}.
}.

Webdokumint by: ['sesje-begjinne'] dwaan: {
	sels koppen-kontrolearje.
	>> fersyk := eigen fersyk.
	>> sesje-id := fersyk cookie: ['xsid'].
	sesje-id Neat? nee: {
		(( Patroan nĳ: ['^[A-Za-z0-9]+\\z'], oerienkomst: sesje-id ) = 0) ja: {
			sesje-id := Neat.
		}.
	}.
	sesje-id Neat? ja: {
		sesje-id := Klûs token: 30.
		>> sesjekop := HTTP-Kop nĳ
		kaai: ['Set-Cookie'] wearde: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigen feilich of: ['Secure'] of: ['']),
		SSITE: (eigen selde-side),
		XSID: sesje-id
		).
		eigen koppen tafoegje: sesjekop.
	}.
	eigen sesjegegevens := eigen sesjebehearder foar: sesje-id, lade. <- eigen sesjegegevens. # reference
}.

Webdokumint by: ['gean-nei:'] dwaan: { :adres
	sels koppen-kontrolearje.
	sels koppen-wiskje.
	eigen koppen
	tafoegje: (
		HTTP-Kop nĳ
		kaai: ['Status'] wearde: ['303 See Other']
	),
	tafoegje: (
		HTTP-Kop nĳ
		kaai: ['Location'] wearde: adres
	).
	sels útfiere: ['Redirect'].
}.

Webdokumint by: ['sesje-fernielje'] dwaan: {
	sels koppen-kontrolearje.
	>> fersyk := eigen fersyk.
	>> sesje-id := fersyk cookie: ['xsid'].
	sesje-id Neat? nee: {
		>> sesjekop := HTTP-Kop nĳ.
		>> tiidstip := Momint nĳ jier: 1970, formaat: ['%a, %d %b %Y %H:%M:%S GMT'].
		sesjekop kaai: ['Set-Cookie'] wearde: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tiidstip,
			SEC: (eigen feilich of: ['Secure'] of: ['']),
			SSITE: (eigen selde-side),
			XSID: sesje-id
		).
		eigen sesjebehearder fernielje.
		eigen koppen tafoegje: sesjekop.
	}.
}.


Webdokumint by: ['sjabloan:'] dwaan: { :paad <- Sjabloan nĳ: (Bestand nĳ: paad, lêze).
}.

Webdokumint by: ['útfiere:type:'] dwaan: { :útfier :type
	eigen koppen-ferstjoerd nee: {
		eigen sesjegegevens Neat? nee: {
			eigen sesjebehearder bewarje: eigen sesjegegevens.
		}.
		eigen koppen tafoegje: (
			HTTP-Kop nĳ
			kaai: ['Content-type'] wearde: type
		).
		eigen koppen elk: { :_ :kop
			Utfier skriuwe: kop.
		}.
		eigen koppen-ferstjoerd := Ja.
		Utfier skriuwe: ['\r\n'].
	}.
	Utfier skriuwe: útfier.
}.

Webdokumint by: ['ôfslute:type:'] dwaan: { :útfier :type
	eigen koppen-ferstjoerd nee: {
		eigen sesjegegevens Neat? nee: {
			eigen sesjebehearder bewarje: eigen sesjegegevens.
		}.
		eigen koppen tafoegje: (
			HTTP-Kop nĳ
			kaai: ['Content-type'] wearde: type
		).
		eigen koppen tafoegje: (
			HTTP-Kop nĳ
			kaai: ['Content-Length'] wearde: útfier tekst bytes
		).
		eigen koppen elk: { :_ :kop
			Utfier skriuwe: kop.
		}.
		eigen koppen-ferstjoerd := Ja.
		Utfier skriuwe: ['\r\n'].
	}.
	Utfier skriuwe: útfier.
}.

Webdokumint by: ['útfiere:'] dwaan: { :útfier
	sels útfiere: útfier type: ['text/html; charset=utf-8'].
}.

Webdokumint by: ['ôfslute:'] dwaan: { :útfier
	sels ôfslute: útfier type: ['text/html; charset=utf-8'].
}.

Webdokumint by: ['json:'] dwaan: { :útfier
	sels útfiere: ( JSON jsonify: útfier ) type: ['application/json'].
}.

Webdokumint by: ['net-fûn:'] dwaan: { :útfier
	sels koppen-wiskje kop: (
		HTTP-Kop nĳ kaai: ['Status'] wearde: ['404 Not Found']
	).
	sels útfiere: útfier.
}.


# Interface

>> Sesje := Objekt nĳ.

Sesje by: ['nĳ'] dwaan: { <- sels nĳ inisjalisearje foar: Neat.
}.

Sesje by: ['foar:'] dwaan: { :id
	eigen id := id.
}.

Sesje by: ['lade'] dwaan: {
	dizze-taak flater: ['Not implemented.'].
}.

Sesje by: ['bewarje:'] dwaan: {
	dizze-taak flater: ['Not implemented.'].
}.

Sesje by: ['fernielje'] dwaan: {
	dizze-taak flater: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tydlik-bestân-sesje := Sesje nĳ.

Tydlik-bestân-sesje by: ['inisjalisearje'] dwaan: {
	eigen paadbegjin := ['/tmp/sess-'].
}.

Tydlik-bestân-sesje by: ['paadfoarheaksel:'] dwaan: { :tekenrige
	eigen paadbegjin := tekenrige.
}.

Tydlik-bestân-sesje by: ['bestân'] dwaan: { <- ( Bestand nĳ: ( eigen paadbegjin + eigen id + ['.txt'] ) ).
}.

Tydlik-bestân-sesje by: ['lade'] dwaan: {
	>> bestân := sels bestân.
	bestân bestiet nee: {
		bestân skriuwe: (List nĳ koade).
	}. <- bestân lêze objekt.
}.

Tydlik-bestân-sesje by: ['bewarje:'] dwaan: { :gegevens
	>> bestân := sels bestân.
	bestân bestiet ja: {
		bestân skriuwe: gegevens koade.
	}.
}.

Tydlik-bestân-sesje by: ['fernielje'] dwaan: {
	>> bestân := sels bestân.
	bestân bestiet ja: {
		bestân wiskje.
	}.
}.


>> URL := Objekt nĳ.

URL by: ['inisjalisearje'] dwaan: {
	eigen protokol := ['https://'].
	eigen host := ['localhost'].
	eigen paad := [''].
	eigen url-parameters := [''].
	eigen hash := [''].
}.

URL by: ['nĳ'] dwaan: { <- sels nĳ inisjalisearje.
}.

URL by: ['tekst'] dwaan: { <- (
	eigen protokol +
	eigen host +
	eigen paad +
	eigen url-parameters +
	eigen hash ).
}.

URL by: ['protokol:'] dwaan: { :protokol
	((Rige nĳ ; ['http'] ; ['https']) hat: protokol) ja: {
		eigen protokol := protokol + ['://'].
	}, nee: {
		dizze-taak flater: ['Invalid protocol'].
	}.
}.

URL by: ['host:'] dwaan: { :host
	#todo validate according to rfc
	eigen host := host.
}.

URL by: ['paad:'] dwaan: { :paad
	eigen paad := ['/'] + paad url-kodearje.
}.

URL by: ['url-parameters:'] dwaan: { :keppeling
	>> url-parameters := Rige nĳ.
	keppeling elk: { :kaai :wearde
		url-parameters tafoegje: kaai tekst url-kodearje + ['='] + wearde tekst url-kodearje.
	}.
	eigen url-parameters := ['?'] + ( url-parameters gearfoegje: ['&'] ).
}.

URL by: ['hash:'] dwaan: { :hash
	eigen hash := ['#'] + hash url-kodearje.
}.

