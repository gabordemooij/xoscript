HTTP-অনুরোধ যখন: ['HTTP-হেডার:'] করো: { :চাবি <- প্রোগ্রাম সেটিং: চাবি.
}.

>> HTTP-হেডার := বস্তু নতুন.

HTTP-হেডার যখন: ['নতুন'] করো: { <- নিজে নতুন প্রস্তুত-করো.
}.

HTTP-হেডার যখন: ['প্রস্তুত-করো'] করো: {
	নিজের চাবি := শূন্য.
	নিজের মূল্য := শূন্য.
}.

HTTP-হেডার যখন: ['চাবি:মূল্য:'] করো: { :চাবি :মূল্য
	নিজের চাবি := চাবি.
	নিজের মূল্য := মূল্য.
}.

HTTP-হেডার যখন: ['চাবি'] করো: { <- নিজের চাবি.
}.

HTTP-হেডার যখন: ['মূল্য'] করো: { <- নিজের মূল্য.
}.


HTTP-হেডার যখন: ['পাঠে'] করো: {
	>> লাইন := নিজের চাবি + [': '] + নিজের মূল্য.
	লাইন বদলাও: ['\r'] দিয়ে: [''], বদলাও: ['\n'] দিয়ে: ['']. <- লাইন + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> ওয়েব-নথি := বস্তু নতুন.

ওয়েব-নথি যখন: ['নতুন'] করো: { <- নিজে নতুন প্রস্তুত-করো.
}.

ওয়েব-নথি যখন: ['প্রস্তুত-করো'] করো: {
	নিজের হেডারগুলি := লিস্ট নতুন.
	নিজের সেশন-আইডি := শূন্য.
	নিজের সেশন-ব্যবস্থাপক := অস্থায়ী-ফাইল-সেশন নতুন.
	নিজের সেশন-উপাত্ত := শূন্য.
	নিজের নিরাপদ := সত্য.
	নিজের একই-সাইট := ['Strict'].
	নিজের হেডার-পাঠানো-হয়েছে := মিথ্যা.
	নিজের অনুরোধ-http := HTTP-অনুরোধ নতুন.
}.

ওয়েব-নথি যখন: ['অনুরোধ-http:'] করো: { :অনুরোধ-http
	নিজের অনুরোধ-http := অনুরোধ-http.
}. 

ওয়েব-নথি যখন: ['নিরাপদ-সেশন-কুকি:'] করো: { :নিরাপদ
	নিজে হেডার-যাচাই.
	নিজের নিরাপদ := নিরাপদ.
}.

ওয়েব-নথি যখন: ['একই-সাইট-সেশন-কুকি:'] করো: { :মূল্য
	নিজে হেডার-যাচাই.
	>> বিকল্প := লিস্ট নতুন 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	বিকল্প আছে-কি: মূল্য, মিথ্যা-হলে: {
		এই-কাজ ত্রুটি: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	নিজের একই-সাইট := মূল্য.
}.

ওয়েব-নথি যখন: ['হেডার:'] করো: { :হেডার
	নিজে হেডার-যাচাই.
	নিজের হেডারগুলি শেষে-যোগ: হেডার.
}.

ওয়েব-নথি যখন: ['হেডার-খালি-করো'] করো: {
	নিজে হেডার-যাচাই.
	নিজের হেডারগুলি := লিস্ট নতুন.
}.

ওয়েব-নথি যখন: ['সেশন-ব্যবস্থাপক:'] করো: { :ব্যবস্থাপক
	নিজে হেডার-যাচাই.
	নিজের সেশন-ব্যবস্থাপক := ব্যবস্থাপক.
}.

ওয়েব-নথি যখন: ['সেশন-ব্যবস্থাপক'] করো: { <- নিজের সেশন-ব্যবস্থাপক.
}.

ওয়েব-নথি যখন: ['হেডার-যাচাই'] করো: {
	নিজের হেডার-পাঠানো-হয়েছে সত্য-হলে: {
		এই-কাজ ত্রুটি: ['Headers already sent to client.'].
	}.
}.

ওয়েব-নথি যখন: ['সেশন-শুরু-করো'] করো: {
	নিজে হেডার-যাচাই.
	>> অনুরোধ-http := নিজের অনুরোধ-http.
	>> সেশন-আইডি := অনুরোধ-http cookie: ['xsid'].
	সেশন-আইডি শূন্য? মিথ্যা-হলে: {
		(( প্যাটার্ন নতুন: ['^[A-Za-z0-9]+\\z'], মিল: সেশন-আইডি ) = 0) সত্য-হলে: {
			সেশন-আইডি := শূন্য.
		}.
	}.
	সেশন-আইডি শূন্য? সত্য-হলে: {
		সেশন-আইডি := সিন্দুক টোকেন: 30.
		>> সেশন-হেডার := HTTP-হেডার নতুন
		চাবি: ['Set-Cookie'] মূল্য: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (নিজের নিরাপদ এটি: ['Secure'] নয়তো: ['']),
		SSITE: (নিজের একই-সাইট),
		XSID: সেশন-আইডি
		).
		নিজের হেডারগুলি শেষে-যোগ: সেশন-হেডার.
	}.
	নিজের সেশন-উপাত্ত := নিজের সেশন-ব্যবস্থাপক জন্য: সেশন-আইডি, লোড-করো. <- নিজের সেশন-উপাত্ত. # reference
}.

ওয়েব-নথি যখন: ['যাও:'] করো: { :ঠিকানা
	নিজে হেডার-যাচাই.
	নিজে হেডার-খালি-করো.
	নিজের হেডারগুলি
	শেষে-যোগ: (
		HTTP-হেডার নতুন
		চাবি: ['Status'] মূল্য: ['303 See Other']
	),
	শেষে-যোগ: (
		HTTP-হেডার নতুন
		চাবি: ['Location'] মূল্য: ঠিকানা
	).
	নিজে আউটপুট-দাও: ['Redirect'].
}.

ওয়েব-নথি যখন: ['সেশন-ধ্বংস-করো'] করো: {
	নিজে হেডার-যাচাই.
	>> অনুরোধ-http := নিজের অনুরোধ-http.
	>> সেশন-আইডি := অনুরোধ-http cookie: ['xsid'].
	সেশন-আইডি শূন্য? মিথ্যা-হলে: {
		>> সেশন-হেডার := HTTP-হেডার নতুন.
		>> মেয়াদ-শেষ := মুহূর্ত নতুন বছর: 1970, বিন্যাসে: ['%a, %d %b %Y %H:%M:%S GMT'].
		সেশন-হেডার চাবি: ['Set-Cookie'] মূল্য: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: মেয়াদ-শেষ,
			SEC: (নিজের নিরাপদ এটি: ['Secure'] নয়তো: ['']),
			SSITE: (নিজের একই-সাইট),
			XSID: সেশন-আইডি
		).
		নিজের সেশন-ব্যবস্থাপক ধ্বংস-করো.
		নিজের হেডারগুলি শেষে-যোগ: সেশন-হেডার.
	}.
}.


ওয়েব-নথি যখন: ['ছাঁচ:'] করো: { :ফাইল-পথ <- ছাঁচ নতুন: (ফাইল নতুন: ফাইল-পথ, পড়ো).
}.

ওয়েব-নথি যখন: ['আউটপুট-দাও:ধরন:'] করো: { :ফলাফল :ধরন
	নিজের হেডার-পাঠানো-হয়েছে মিথ্যা-হলে: {
		নিজের সেশন-উপাত্ত শূন্য? মিথ্যা-হলে: {
			নিজের সেশন-ব্যবস্থাপক সংরক্ষণ-করো: নিজের সেশন-উপাত্ত.
		}.
		নিজের হেডারগুলি শেষে-যোগ: (
			HTTP-হেডার নতুন
			চাবি: ['Content-type'] মূল্য: ধরন
		).
		নিজের হেডারগুলি প্রতিটি: { :_ :হেডার
			আউটপুট লেখো: হেডার.
		}.
		নিজের হেডার-পাঠানো-হয়েছে := সত্য.
		আউটপুট লেখো: ['\r\n'].
	}.
	আউটপুট লেখো: ফলাফল.
}.

ওয়েব-নথি যখন: ['সম্পন্ন-করো:ধরন:'] করো: { :ফলাফল :ধরন
	নিজের হেডার-পাঠানো-হয়েছে মিথ্যা-হলে: {
		নিজের সেশন-উপাত্ত শূন্য? মিথ্যা-হলে: {
			নিজের সেশন-ব্যবস্থাপক সংরক্ষণ-করো: নিজের সেশন-উপাত্ত.
		}.
		নিজের হেডারগুলি শেষে-যোগ: (
			HTTP-হেডার নতুন
			চাবি: ['Content-type'] মূল্য: ধরন
		).
		নিজের হেডারগুলি শেষে-যোগ: (
			HTTP-হেডার নতুন
			চাবি: ['Content-Length'] মূল্য: ফলাফল পাঠে bytes
		).
		নিজের হেডারগুলি প্রতিটি: { :_ :হেডার
			আউটপুট লেখো: হেডার.
		}.
		নিজের হেডার-পাঠানো-হয়েছে := সত্য.
		আউটপুট লেখো: ['\r\n'].
	}.
	আউটপুট লেখো: ফলাফল.
}.

ওয়েব-নথি যখন: ['আউটপুট-দাও:'] করো: { :ফলাফল
	নিজে আউটপুট-দাও: ফলাফল ধরন: ['text/html; charset=utf-8'].
}.

ওয়েব-নথি যখন: ['সম্পন্ন-করো:'] করো: { :ফলাফল
	নিজে সম্পন্ন-করো: ফলাফল ধরন: ['text/html; charset=utf-8'].
}.

ওয়েব-নথি যখন: ['json:'] করো: { :ফলাফল
	নিজে আউটপুট-দাও: ( JSON jsonify: ফলাফল ) ধরন: ['application/json'].
}.

ওয়েব-নথি যখন: ['পাওয়া-যায়নি:'] করো: { :ফলাফল
	নিজে হেডার-খালি-করো হেডার: (
		HTTP-হেডার নতুন চাবি: ['Status'] মূল্য: ['404 Not Found']
	).
	নিজে আউটপুট-দাও: ফলাফল.
}.


# Interface

>> সেশন := বস্তু নতুন.

সেশন যখন: ['নতুন'] করো: { <- নিজে নতুন প্রস্তুত-করো জন্য: শূন্য.
}.

সেশন যখন: ['জন্য:'] করো: { :id
	নিজের id := id.
}.

সেশন যখন: ['লোড-করো'] করো: {
	এই-কাজ ত্রুটি: ['Not implemented.'].
}.

সেশন যখন: ['সংরক্ষণ-করো:'] করো: {
	এই-কাজ ত্রুটি: ['Not implemented.'].
}.

সেশন যখন: ['ধ্বংস-করো'] করো: {
	এই-কাজ ত্রুটি: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> অস্থায়ী-ফাইল-সেশন := সেশন নতুন.

অস্থায়ী-ফাইল-সেশন যখন: ['প্রস্তুত-করো'] করো: {
	নিজের পথ-শুরু := ['/tmp/sess-'].
}.

অস্থায়ী-ফাইল-সেশন যখন: ['পথ-উপসর্গ:'] করো: { :পাঠ্য-শৃঙ্খল
	নিজের পথ-শুরু := পাঠ্য-শৃঙ্খল.
}.

অস্থায়ী-ফাইল-সেশন যখন: ['সেশন-ফাইল'] করো: { <- ( ফাইল নতুন: ( নিজের পথ-শুরু + নিজের id + ['.txt'] ) ).
}.

অস্থায়ী-ফাইল-সেশন যখন: ['লোড-করো'] করো: {
	>> সেশন-ফাইল := নিজে সেশন-ফাইল.
	সেশন-ফাইল আছে মিথ্যা-হলে: {
		সেশন-ফাইল লেখো: (অভিধান নতুন কোড).
	}. <- সেশন-ফাইল পড়ো বস্তুতে.
}.

অস্থায়ী-ফাইল-সেশন যখন: ['সংরক্ষণ-করো:'] করো: { :উপাত্ত
	>> সেশন-ফাইল := নিজে সেশন-ফাইল.
	সেশন-ফাইল আছে সত্য-হলে: {
		সেশন-ফাইল লেখো: উপাত্ত কোড.
	}.
}.

অস্থায়ী-ফাইল-সেশন যখন: ['ধ্বংস-করো'] করো: {
	>> সেশন-ফাইল := নিজে সেশন-ফাইল.
	সেশন-ফাইল আছে সত্য-হলে: {
		সেশন-ফাইল মুছো.
	}.
}.


>> URL := বস্তু নতুন.

URL যখন: ['প্রস্তুত-করো'] করো: {
	নিজের প্রোটোকল := ['https://'].
	নিজের হোস্ট := ['localhost'].
	নিজের ফাইল-পথ := [''].
	নিজের url-প্যারামিটার := [''].
	নিজের hash := [''].
}.

URL যখন: ['নতুন'] করো: { <- নিজে নতুন প্রস্তুত-করো.
}.

URL যখন: ['পাঠে'] করো: { <- (
	নিজের প্রোটোকল +
	নিজের হোস্ট +
	নিজের ফাইল-পথ +
	নিজের url-প্যারামিটার +
	নিজের hash ).
}.

URL যখন: ['প্রোটোকল:'] করো: { :প্রোটোকল
	((লিস্ট নতুন ; ['http'] ; ['https']) আছে-কি: প্রোটোকল) সত্য-হলে: {
		নিজের প্রোটোকল := প্রোটোকল + ['://'].
	}, মিথ্যা-হলে: {
		এই-কাজ ত্রুটি: ['Invalid protocol'].
	}.
}.

URL যখন: ['হোস্ট:'] করো: { :হোস্ট
	#todo validate according to rfc
	নিজের হোস্ট := হোস্ট.
}.

URL যখন: ['ফাইল-পথ:'] করো: { :ফাইল-পথ
	নিজের ফাইল-পথ := ['/'] + ফাইল-পথ url-এনকোড.
}.

URL যখন: ['url-প্যারামিটার:'] করো: { :মানচিত্রণ
	>> url-প্যারামিটার := লিস্ট নতুন.
	মানচিত্রণ প্রতিটি: { :চাবি :মূল্য
		url-প্যারামিটার শেষে-যোগ: চাবি পাঠে url-এনকোড + ['='] + মূল্য পাঠে url-এনকোড.
	}.
	নিজের url-প্যারামিটার := ['?'] + ( url-প্যারামিটার জোড়া-দাও: ['&'] ).
}.

URL যখন: ['হ্যাশ:'] করো: { :hash
	নিজের hash := ['#'] + hash url-এনকোড.
}.

