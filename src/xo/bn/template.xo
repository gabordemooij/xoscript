
# ~ Simple template engine ~

>> ছাঁচ := বস্তু নতুন.

ছাঁচ যখন: ['নতুন'] করো: { <- নিজে নতুন বিষয়বস্তু: [''].
}.

ছাঁচ যখন: ['বিষয়বস্তু:'] করো: { :বিষয়বস্তু
	নিজের বিষয়বস্তু := বিষয়বস্তু. 
}.

ছাঁচ যখন: ['নতুন:'] করো: { :বিষয়বস্তু <- নিজে নতুন বিষয়বস্তু: বিষয়বস্তু.
}.

ছাঁচ যখন: ['কাটো:'] করো: { :চিহ্ন
	>> শুরুর-চিহ্ন := (['<!-- cut:%id% -->'] %id%: চিহ্ন).
	>> শেষ-চিহ্ন := (['<!-- /cut:%id% -->'] %id%: চিহ্ন).
	>> অংশগুলি := নিজের বিষয়বস্তু ভাগ-করো: শুরুর-চিহ্ন.
	>> উপসর্গ := অংশগুলি প্রথম.
	>> অংশগুলি2 := অংশগুলি শেষ-উপাদান ভাগ-করো: শেষ-চিহ্ন.
	>> প্রত্যয় := অংশগুলি2 শেষ-উপাদান.
	>> অংশ := অংশগুলি2 প্রথম.
	>> অবশিষ্ট := উপসর্গ + প্রত্যয়.
	নিজের বিষয়বস্তু := অবশিষ্ট. <- ছাঁচ নতুন: অংশ.
	
}.

ছাঁচ যখন: ['অনুলিপি'] করো: { <- নিজে নতুন: নিজে পাঠে অনুলিপি.
}.
	
ছাঁচ যখন: ['সাঁটো:চাবিতে:'] করো: { :উদ্ধৃতি :id
	>> সাঁটার-চিহ্ন := (['<!-- paste:%id% -->'] %id%: id).
	নিজের বিষয়বস্তু বদলাও: সাঁটার-চিহ্ন দিয়ে: ( উদ্ধৃতি পাঠে + সাঁটার-চিহ্ন ).
}.

ছাঁচ যখন: ['নির্ধারণ:মান:'] করো: { :স্থান :মূল্য
	নিজের বিষয়বস্তু বদলাও: ['<!-- slot:'] + স্থান + [' -->'] দিয়ে: ( Server html-এনকোড: মূল্য ).
}.

ছাঁচ যখন: ['নির্ধারণ:html:'] করো: { :স্থান :html
	নিজের বিষয়বস্তু বদলাও: ['<!-- slot:'] + স্থান + [' -->'] দিয়ে: html.
}.

ছাঁচ যখন: ['উত্তর:এবং:'] করো: { :স্থান :মূল্য
	নিজে নির্ধারণ: (স্থান শুরু: 0 দৈর্ঘ্য: (স্থান দৈর্ঘ্য - 1)) মান: মূল্য.
}.

ছাঁচ যখন: ['nl2br'] করো: {
	নিজের বিষয়বস্তু বদলাও: ['\n'] দিয়ে: ['<br>'].
}.

ছাঁচ যখন: ['চিহ্ন-মোছো'] করো: {
	নিজের বিষয়বস্তু :=
		প্যাটার্ন
		নতুন: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		মিল: নিজের বিষয়বস্তু
		করো: { <- ['']. }.
}.

ছাঁচ যখন: ['কাট-মোছো'] করো: {
	>> আইটেম := লিস্ট নতুন.
	প্যাটার্ন
	নতুন: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	মিল: নিজের বিষয়বস্তু
	করো: { :_ :অংশ
		আইটেম শেষে-যোগ: অংশ ? 1.
	}.
	আইটেম প্রতিটি: { :_ :id
		নিজের বিষয়বস্তু :=
			প্যাটার্ন নতুন: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			মিল: নিজের বিষয়বস্তু
			করো: { <- ['']. }.
	 }.
}.

ছাঁচ যখন: ['ফাঁকা-মোছো'] করো: {
	নিজের বিষয়বস্তু :=
		প্যাটার্ন
		নতুন: ['\\s*\\n'],
		মিল: নিজের বিষয়বস্তু
		করো: { <- ['\n']. }.
	নিজের বিষয়বস্তু :=
		প্যাটার্ন
		নতুন: ['\\n[\\s\\t]+'],
		মিল: নিজের বিষয়বস্তু
		করো: { <- ['\n']. }.
}.

ছাঁচ যখন: ['সব-চিহ্ন-মোছো'] করো: {
	নিজে চিহ্ন-মোছো.
	নিজে কাট-মোছো.
	নিজে ফাঁকা-মোছো.
}.

ছাঁচ যখন: ['পাঠে'] করো: { <- নিজের বিষয়বস্তু.
}.
