HTTP-Požiadavka pri: ['HTTP-hlavička:'] urobiť: { :kľúč <- Program nastavenie: kľúč.
}.

>> HTTP-Hlavička := Objekt nový.

HTTP-Hlavička pri: ['nový'] urobiť: { <- seba nový inicializovať.
}.

HTTP-Hlavička pri: ['inicializovať'] urobiť: {
	vlastný kľúč := Nič.
	vlastný hodnota := Nič.
}.

HTTP-Hlavička pri: ['kľúč:hodnota:'] urobiť: { :kľúč :hodnota
	vlastný kľúč := kľúč.
	vlastný hodnota := hodnota.
}.

HTTP-Hlavička pri: ['kľúč'] urobiť: { <- vlastný kľúč.
}.

HTTP-Hlavička pri: ['hodnota'] urobiť: { <- vlastný hodnota.
}.


HTTP-Hlavička pri: ['text'] urobiť: {
	>> riadok := vlastný kľúč + [': '] + vlastný hodnota.
	riadok nahradiť: ['\r'] za: [''], nahradiť: ['\n'] za: ['']. <- riadok + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webový-dokument := Objekt nový.

Webový-dokument pri: ['nový'] urobiť: { <- seba nový inicializovať.
}.

Webový-dokument pri: ['inicializovať'] urobiť: {
	vlastný hlavičky := Zoznam nový.
	vlastný id-relácie := Nič.
	vlastný správca-relácií := Relácia-dočasný-súbor nový.
	vlastný údaje-relácie := Nič.
	vlastný zabezpečené := Pravda.
	vlastný rovnaký-web := ['Strict'].
	vlastný hlavičky-odoslané := Nepravda.
	vlastný požiadavka := HTTP-Požiadavka nový.
}.

Webový-dokument pri: ['požiadavka:'] urobiť: { :požiadavka
	vlastný požiadavka := požiadavka.
}. 

Webový-dokument pri: ['zabezpečená-reláčná-cookie:'] urobiť: { :zabezpečené
	seba skontrolovať-hlavičky.
	vlastný zabezpečené := zabezpečené.
}.

Webový-dokument pri: ['reláčná-cookie-rovnaký-web:'] urobiť: { :hodnota
	seba skontrolovať-hlavičky.
	>> voľby := Zoznam nový 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	voľby má: hodnota, nepravda: {
		táto-úloha chyba: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	vlastný rovnaký-web := hodnota.
}.

Webový-dokument pri: ['hlavička:'] urobiť: { :hlavička
	seba skontrolovať-hlavičky.
	vlastný hlavičky pripojiť: hlavička.
}.

Webový-dokument pri: ['vymazať-hlavičky'] urobiť: {
	seba skontrolovať-hlavičky.
	vlastný hlavičky := Zoznam nový.
}.

Webový-dokument pri: ['správca-relácií:'] urobiť: { :správca
	seba skontrolovať-hlavičky.
	vlastný správca-relácií := správca.
}.

Webový-dokument pri: ['správca-relácií'] urobiť: { <- vlastný správca-relácií.
}.

Webový-dokument pri: ['skontrolovať-hlavičky'] urobiť: {
	vlastný hlavičky-odoslané pravda: {
		táto-úloha chyba: ['Headers already sent to client.'].
	}.
}.

Webový-dokument pri: ['začať-reláciu'] urobiť: {
	seba skontrolovať-hlavičky.
	>> požiadavka := vlastný požiadavka.
	>> id-relácie := požiadavka cookie: ['xsid'].
	id-relácie Nič? nepravda: {
		(( Vzor nový: ['^[A-Za-z0-9]+\\z'], zhoda: id-relácie ) = 0) pravda: {
			id-relácie := Nič.
		}.
	}.
	id-relácie Nič? pravda: {
		id-relácie := Trezor token: 30.
		>> hlavička-relácie := HTTP-Hlavička nový
		kľúč: ['Set-Cookie'] hodnota: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (vlastný zabezpečené buď: ['Secure'] alebo: ['']),
		SSITE: (vlastný rovnaký-web),
		XSID: id-relácie
		).
		vlastný hlavičky pripojiť: hlavička-relácie.
	}.
	vlastný údaje-relácie := vlastný správca-relácií pre: id-relácie, načítať. <- vlastný údaje-relácie. # reference
}.

Webový-dokument pri: ['prejsť-na:'] urobiť: { :adresa
	seba skontrolovať-hlavičky.
	seba vymazať-hlavičky.
	vlastný hlavičky
	pripojiť: (
		HTTP-Hlavička nový
		kľúč: ['Status'] hodnota: ['303 See Other']
	),
	pripojiť: (
		HTTP-Hlavička nový
		kľúč: ['Location'] hodnota: adresa
	).
	seba vypísať: ['Redirect'].
}.

Webový-dokument pri: ['zničiť-reláciu'] urobiť: {
	seba skontrolovať-hlavičky.
	>> požiadavka := vlastný požiadavka.
	>> id-relácie := požiadavka cookie: ['xsid'].
	id-relácie Nič? nepravda: {
		>> hlavička-relácie := HTTP-Hlavička nový.
		>> okamih := Okamih nový rok: 1970, formát: ['%a, %d %b %Y %H:%M:%S GMT'].
		hlavička-relácie kľúč: ['Set-Cookie'] hodnota: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: okamih,
			SEC: (vlastný zabezpečené buď: ['Secure'] alebo: ['']),
			SSITE: (vlastný rovnaký-web),
			XSID: id-relácie
		).
		vlastný správca-relácií zničiť.
		vlastný hlavičky pripojiť: hlavička-relácie.
	}.
}.


Webový-dokument pri: ['šablóna:'] urobiť: { :cesta <- Šablóna nový: (Súbor nový: cesta, čítať).
}.

Webový-dokument pri: ['vypísať:typ:'] urobiť: { :výstup :typ
	vlastný hlavičky-odoslané nepravda: {
		vlastný údaje-relácie Nič? nepravda: {
			vlastný správca-relácií uložiť: vlastný údaje-relácie.
		}.
		vlastný hlavičky pripojiť: (
			HTTP-Hlavička nový
			kľúč: ['Content-type'] hodnota: typ
		).
		vlastný hlavičky každý: { :_ :hlavička
			Výstup písať: hlavička.
		}.
		vlastný hlavičky-odoslané := Pravda.
		Výstup písať: ['\r\n'].
	}.
	Výstup písať: výstup.
}.

Webový-dokument pri: ['dokončiť:typ:'] urobiť: { :výstup :typ
	vlastný hlavičky-odoslané nepravda: {
		vlastný údaje-relácie Nič? nepravda: {
			vlastný správca-relácií uložiť: vlastný údaje-relácie.
		}.
		vlastný hlavičky pripojiť: (
			HTTP-Hlavička nový
			kľúč: ['Content-type'] hodnota: typ
		).
		vlastný hlavičky pripojiť: (
			HTTP-Hlavička nový
			kľúč: ['Content-Length'] hodnota: výstup text bytes
		).
		vlastný hlavičky každý: { :_ :hlavička
			Výstup písať: hlavička.
		}.
		vlastný hlavičky-odoslané := Pravda.
		Výstup písať: ['\r\n'].
	}.
	Výstup písať: výstup.
}.

Webový-dokument pri: ['vypísať:'] urobiť: { :výstup
	seba vypísať: výstup typ: ['text/html; charset=utf-8'].
}.

Webový-dokument pri: ['dokončiť:'] urobiť: { :výstup
	seba dokončiť: výstup typ: ['text/html; charset=utf-8'].
}.

Webový-dokument pri: ['json:'] urobiť: { :výstup
	seba vypísať: ( JSON jsonify: výstup ) typ: ['application/json'].
}.

Webový-dokument pri: ['nenájdené:'] urobiť: { :výstup
	seba vymazať-hlavičky hlavička: (
		HTTP-Hlavička nový kľúč: ['Status'] hodnota: ['404 Not Found']
	).
	seba vypísať: výstup.
}.


# Interface

>> Relácia := Objekt nový.

Relácia pri: ['nový'] urobiť: { <- seba nový inicializovať pre: Nič.
}.

Relácia pri: ['pre:'] urobiť: { :id
	vlastný id := id.
}.

Relácia pri: ['načítať'] urobiť: {
	táto-úloha chyba: ['Not implemented.'].
}.

Relácia pri: ['uložiť:'] urobiť: {
	táto-úloha chyba: ['Not implemented.'].
}.

Relácia pri: ['zničiť'] urobiť: {
	táto-úloha chyba: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Relácia-dočasný-súbor := Relácia nový.

Relácia-dočasný-súbor pri: ['inicializovať'] urobiť: {
	vlastný začiatok-cesty := ['/tmp/sess-'].
}.

Relácia-dočasný-súbor pri: ['predpona-cesty:'] urobiť: { :reťazec
	vlastný začiatok-cesty := reťazec.
}.

Relácia-dočasný-súbor pri: ['súbor'] urobiť: { <- ( Súbor nový: ( vlastný začiatok-cesty + vlastný id + ['.txt'] ) ).
}.

Relácia-dočasný-súbor pri: ['načítať'] urobiť: {
	>> súbor := seba súbor.
	súbor existuje nepravda: {
		súbor písať: (Slovník nový kód).
	}. <- súbor čítať objekt.
}.

Relácia-dočasný-súbor pri: ['uložiť:'] urobiť: { :údaje
	>> súbor := seba súbor.
	súbor existuje pravda: {
		súbor písať: údaje kód.
	}.
}.

Relácia-dočasný-súbor pri: ['zničiť'] urobiť: {
	>> súbor := seba súbor.
	súbor existuje pravda: {
		súbor vymazať.
	}.
}.


>> URL := Objekt nový.

URL pri: ['inicializovať'] urobiť: {
	vlastný protokol := ['https://'].
	vlastný hostiteľ := ['localhost'].
	vlastný cesta := [''].
	vlastný url-parametre := [''].
	vlastný hash := [''].
}.

URL pri: ['nový'] urobiť: { <- seba nový inicializovať.
}.

URL pri: ['text'] urobiť: { <- (
	vlastný protokol +
	vlastný hostiteľ +
	vlastný cesta +
	vlastný url-parametre +
	vlastný hash ).
}.

URL pri: ['protokol:'] urobiť: { :protokol
	((Zoznam nový ; ['http'] ; ['https']) má: protokol) pravda: {
		vlastný protokol := protokol + ['://'].
	}, nepravda: {
		táto-úloha chyba: ['Invalid protocol'].
	}.
}.

URL pri: ['hostiteľ:'] urobiť: { :hostiteľ
	#todo validate according to rfc
	vlastný hostiteľ := hostiteľ.
}.

URL pri: ['cesta:'] urobiť: { :cesta
	vlastný cesta := ['/'] + cesta url-kódovať.
}.

URL pri: ['url-parametre:'] urobiť: { :mapovanie
	>> url-parametre := Zoznam nový.
	mapovanie každý: { :kľúč :hodnota
		url-parametre pripojiť: kľúč text url-kódovať + ['='] + hodnota text url-kódovať.
	}.
	vlastný url-parametre := ['?'] + ( url-parametre spojiť: ['&'] ).
}.

URL pri: ['heš:'] urobiť: { :hash
	vlastný hash := ['#'] + hash url-kódovať.
}.

