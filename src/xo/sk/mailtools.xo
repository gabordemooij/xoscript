>> Email := Objekt nový.

Email pri: ['inicializovať'] urobiť: {
	vlastný príjemcovia := Zoznam nový.
	vlastný cc := Zoznam nový.
	vlastný bcc := Zoznam nový.
	vlastný odosielateľ := Nič.
	vlastný meno-odosielateľa := Nič.
	vlastný predmet := Nič.
	vlastný telo := Nič.
}.

Email pri: ['nový'] urobiť: { <- seba nový inicializovať.
}.

Email pri: ['komu:'] urobiť: { :výpočet
	vlastný príjemcovia := výpočet.
}.
 
Email pri: ['cc:'] urobiť: { :výpočet
	vlastný cc := výpočet.
}.

Email pri: ['bcc:'] urobiť: { :výpočet
	vlastný bcc := výpočet.
}.

Email pri: ['predmet:'] urobiť: { :predmet
	vlastný predmet := predmet.
}.

Email pri: ['odosielateľ:názov:'] urobiť: { :odosielateľ :názov
	vlastný odosielateľ := odosielateľ.
	vlastný meno-odosielateľa := názov.
}.

Email pri: ['telo:'] urobiť: { :telo
	vlastný telo := telo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email pri: ['hlavička:'] urobiť: { :riadok <- riadok nahradiť: ['\r'] za: [''], nahradiť: ['\n'] za: [''].
}.

Email pri: ['odoslať'] urobiť: {
	>> f := Súbor tempwrite: seba generovať.
	Program systém: ['sendmail -t < '] + f cesta, nový-riadok.
}.

Email pri: ['generovať'] urobiť: {
	>> zalomenie := ['\r\n'].
	>> reťazec := [''].
	reťazec pripojiť: (seba hlavička: ['From: '] + vlastný meno-odosielateľa + [' <'] + ( vlastný odosielateľ ) + ['>']) + zalomenie.
	reťazec pripojiť: (seba hlavička: ['To: '] + ( vlastný príjemcovia spojiť: [','] )) + zalomenie.
	vlastný cc počet pravda: {
		reťazec pripojiť: (seba hlavička: ['Cc: '] + ( vlastný cc spojiť: [','] )) + zalomenie.
	}.
	vlastný bcc počet pravda: {
		reťazec pripojiť: (seba hlavička: ['Bcc: '] + ( vlastný bcc spojiť: [','] )) + zalomenie.
	}.
	reťazec pripojiť: (seba hlavička: ['Subject: '] + vlastný predmet) + zalomenie.
	reťazec pripojiť: zalomenie.
	reťazec pripojiť: vlastný telo.
	reťazec pripojiť: zalomenie. <- reťazec.
}.

>> HTML-Email := Email nový.

HTML-Email pri: ['inicializovať'] urobiť: {
	seba inicializovať.
	vlastný prílohy := Zoznam nový.
	vlastný hranica := Trezor token: 40.
}.

HTML-Email pri: ['priložiť:'] urobiť: { :súbor
	>> id := vlastný prílohy počet.
	>> blob := súbor blob.
	vlastný prílohy pripojiť: (
		Slovník nový
			súbor: súbor cesta,
			mime: ['image/'] + (Server mimetype: súbor cesta),
			údaje: blob base64-kódovať
	).
	blob uvoľniť. <- ['cid:attachment'] + id.
}.

HTML-Email pri: ['generovať'] urobiť: {
	>> zalomenie := ['\r\n'].
	>> reťazec := [''].
	reťazec pripojiť: (seba hlavička: ['From: '] + vlastný meno-odosielateľa + [' <'] + ( vlastný odosielateľ ) + ['>']) + zalomenie.
	reťazec pripojiť: (seba hlavička: ['To: '] + ( vlastný príjemcovia spojiť: [','] )) + zalomenie.
	vlastný cc počet pravda: {
		reťazec pripojiť: (seba hlavička: ['Cc: '] + ( vlastný cc spojiť: [','] )) + zalomenie.
	}.
	vlastný bcc počet pravda: {
		reťazec pripojiť: (seba hlavička: ['Bcc: '] + ( vlastný bcc spojiť: [','] )) + zalomenie.
	}.
	reťazec pripojiť: (seba hlavička: ['Subject: '] + vlastný predmet) + zalomenie.
	reťazec pripojiť: ['MIME-Version: 1.0'] + zalomenie.
	reťazec pripojiť: ['Content-Type: multipart/related; boundary="'] + vlastný hranica + ['"; type=text/html'] + zalomenie.
	reťazec pripojiť: zalomenie.
	reťazec pripojiť: ['--'] + vlastný hranica + zalomenie.
	reťazec pripojiť: ['Content-Type: text/html; charset=UTF-8'] + zalomenie.
	reťazec pripojiť: ['Content-Transfer-Encoding: 7bit'] + zalomenie.
	reťazec pripojiť: zalomenie.
	reťazec pripojiť: vlastný telo.
	reťazec pripojiť: zalomenie.
	vlastný prílohy každý: { :id :info
		>> blob := info údaje.
		reťazec pripojiť: ['--'] + vlastný hranica + zalomenie.
		reťazec pripojiť: ['Content-Type: '] + info mime + zalomenie.
		reťazec pripojiť: ['Content-Transfer-Encoding: base64'] + zalomenie.
		reťazec pripojiť: ['Content-ID: <attachment'] + id + ['>'] + zalomenie.
		reťazec pripojiť: ['Content-Disposition: inline; filename="'] + info súbor + ['"'] + zalomenie.
		reťazec pripojiť: zalomenie.
		>> najviac := 76.
		>> dĺžka-textu := blob dĺžka.
		>> kusy := (dĺžka-textu / najviac) horná-celá-časť.
		{ :i
			>> kus := blob kopírovať od: i * najviac dĺžka: najviac.
			reťazec pripojiť: kus + zalomenie.
		} * kusy.
		reťazec pripojiť: zalomenie.
		reťazec pripojiť: zalomenie.
	}.
	reťazec pripojiť: ['--'] + vlastný hranica + ['--'] + zalomenie. <- reťazec.
}.
