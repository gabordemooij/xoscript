
# ~ Simple template engine ~

>> Šablóna := Objekt nový.

Šablóna pri: ['nový'] urobiť: { <- seba nový obsah: [''].
}.

Šablóna pri: ['obsah:'] urobiť: { :obsah
	vlastný obsah := obsah. 
}.

Šablóna pri: ['nový:'] urobiť: { :obsah <- seba nový obsah: obsah.
}.

Šablóna pri: ['vystrihnúť:'] urobiť: { :značka
	>> počiatočná-značka := (['<!-- cut:%id% -->'] %id%: značka).
	>> koncová-značka := (['<!-- /cut:%id% -->'] %id%: značka).
	>> časti := vlastný obsah rozdeliť: počiatočná-značka.
	>> predpona := časti prvý.
	>> časti2 := časti posledný rozdeliť: koncová-značka.
	>> prípona := časti2 posledný.
	>> časť := časti2 prvý.
	>> zvyšok := predpona + prípona.
	vlastný obsah := zvyšok. <- Šablóna nový: časť.
	
}.

Šablóna pri: ['kopírovať'] urobiť: { <- seba nový: seba text kopírovať.
}.
	
Šablóna pri: ['vložiť:na:'] urobiť: { :úryvok :id
	>> vkladacia-značka := (['<!-- paste:%id% -->'] %id%: id).
	vlastný obsah nahradiť: vkladacia-značka za: ( úryvok text + vkladacia-značka ).
}.

Šablóna pri: ['nastaviť:hodnota:'] urobiť: { :slot :hodnota
	vlastný obsah nahradiť: ['<!-- slot:'] + slot + [' -->'] za: ( Server html-kódovať: hodnota ).
}.

Šablóna pri: ['nastaviť:html:'] urobiť: { :slot :html
	vlastný obsah nahradiť: ['<!-- slot:'] + slot + [' -->'] za: html.
}.

Šablóna pri: ['odpovedať:a:'] urobiť: { :slot :hodnota
	seba nastaviť: (slot od: 0 dĺžka: (slot dĺžka - 1)) hodnota: hodnota.
}.

Šablóna pri: ['nl2br'] urobiť: {
	vlastný obsah nahradiť: ['\n'] za: ['<br>'].
}.

Šablóna pri: ['očistiť'] urobiť: {
	vlastný obsah :=
		Vzor
		nový: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		zhoda: vlastný obsah
		urobiť: { <- ['']. }.
}.

Šablóna pri: ['očistiť-výrezy'] urobiť: {
	>> položky := Zoznam nový.
	Vzor
	nový: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	zhoda: vlastný obsah
	urobiť: { :_ :časť
		položky pripojiť: časť ? 1.
	}.
	položky každý: { :_ :id
		vlastný obsah :=
			Vzor nový: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			zhoda: vlastný obsah
			urobiť: { <- ['']. }.
	 }.
}.

Šablóna pri: ['očistiť-medzery'] urobiť: {
	vlastný obsah :=
		Vzor
		nový: ['\\s*\\n'],
		zhoda: vlastný obsah
		urobiť: { <- ['\n']. }.
	vlastný obsah :=
		Vzor
		nový: ['\\n[\\s\\t]+'],
		zhoda: vlastný obsah
		urobiť: { <- ['\n']. }.
}.

Šablóna pri: ['očistiť-všetko'] urobiť: {
	seba očistiť.
	seba očistiť-výrezy.
	seba očistiť-medzery.
}.

Šablóna pri: ['text'] urobiť: { <- vlastný obsah.
}.
