Pempho-HTTP chikafika: ['HTTP-mutu:'] chitani: { :kiyi <- Pulogalamu kakhazikitsidwe: kiyi.
}.

>> Mutu-wa-HTTP := Chinthu chatsopano.

Mutu-wa-HTTP chikafika: ['chatsopano'] chitani: { <- wekha chatsopano konzekera.
}.

Mutu-wa-HTTP chikafika: ['konzekera'] chitani: {
	zake kiyi := Palibe.
	zake mtengo := Palibe.
}.

Mutu-wa-HTTP chikafika: ['kiyi:mtengo:'] chitani: { :kiyi :mtengo
	zake kiyi := kiyi.
	zake mtengo := mtengo.
}.

Mutu-wa-HTTP chikafika: ['kiyi'] chitani: { <- zake kiyi.
}.

Mutu-wa-HTTP chikafika: ['mtengo'] chitani: { <- zake mtengo.
}.


Mutu-wa-HTTP chikafika: ['malemba-a-mawu'] chitani: {
	>> mzere := zake kiyi + [': '] + zake mtengo.
	mzere sinthani: ['\r'] ndi: [''], sinthani: ['\n'] ndi: ['']. <- mzere + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Chikalata-cha-Webusayiti := Chinthu chatsopano.

Chikalata-cha-Webusayiti chikafika: ['chatsopano'] chitani: { <- wekha chatsopano konzekera.
}.

Chikalata-cha-Webusayiti chikafika: ['konzekera'] chitani: {
	zake mitu := Mndandanda chatsopano.
	zake id-ya-gawo := Palibe.
	zake woyanganira-magawo := Gawo-la-fayilo-lakanthawi chatsopano.
	zake deta-ya-gawo := Palibe.
	zake yotetezeka := Zoona.
	zake tsamba-limodzi := ['Strict'].
	zake mitu-yatumizidwa := Zabodza.
	zake pempho-http := Pempho-HTTP chatsopano.
}.

Chikalata-cha-Webusayiti chikafika: ['pempho-http:'] chitani: { :pempho-http
	zake pempho-http := pempho-http.
}. 

Chikalata-cha-Webusayiti chikafika: ['kuki-ya-gawo-yotetezeka:'] chitani: { :yotetezeka
	wekha fufuza-mitu.
	zake yotetezeka := yotetezeka.
}.

Chikalata-cha-Webusayiti chikafika: ['kuki-ya-gawo-tsamba-limodzi:'] chitani: { :mtengo
	wekha fufuza-mitu.
	>> zosankha := Mndandanda chatsopano 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	zosankha chili-ndi: mtengo, zabodza: {
		ntchito-iyi cholakwika: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	zake tsamba-limodzi := mtengo.
}.

Chikalata-cha-Webusayiti chikafika: ['mutu:'] chitani: { :mutu
	wekha fufuza-mitu.
	zake mitu onjeza-kumapeto: mutu.
}.

Chikalata-cha-Webusayiti chikafika: ['chotsa-mitu'] chitani: {
	wekha fufuza-mitu.
	zake mitu := Mndandanda chatsopano.
}.

Chikalata-cha-Webusayiti chikafika: ['woyanganira-magawo:'] chitani: { :woyanganira
	wekha fufuza-mitu.
	zake woyanganira-magawo := woyanganira.
}.

Chikalata-cha-Webusayiti chikafika: ['woyanganira-magawo'] chitani: { <- zake woyanganira-magawo.
}.

Chikalata-cha-Webusayiti chikafika: ['fufuza-mitu'] chitani: {
	zake mitu-yatumizidwa zoona: {
		ntchito-iyi cholakwika: ['Headers already sent to client.'].
	}.
}.

Chikalata-cha-Webusayiti chikafika: ['yamba-gawo'] chitani: {
	wekha fufuza-mitu.
	>> pempho-http := zake pempho-http.
	>> id-ya-gawo := pempho-http cookie: ['xsid'].
	id-ya-gawo Palibe? zabodza: {
		(( Chitsanzo-chofufuzira chatsopano: ['^[A-Za-z0-9]+\\z'], kufanana: id-ya-gawo ) = 0) zoona: {
			id-ya-gawo := Palibe.
		}.
	}.
	id-ya-gawo Palibe? zoona: {
		id-ya-gawo := Nkhokwe-yotetezedwa token: 30.
		>> mutu-wa-gawo := Mutu-wa-HTTP chatsopano
		kiyi: ['Set-Cookie'] mtengo: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (zake yotetezeka ichi: ['Secure'] kapena-icho: ['']),
		SSITE: (zake tsamba-limodzi),
		XSID: id-ya-gawo
		).
		zake mitu onjeza-kumapeto: mutu-wa-gawo.
	}.
	zake deta-ya-gawo := zake woyanganira-magawo za: id-ya-gawo, tsegula. <- zake deta-ya-gawo. # reference
}.

Chikalata-cha-Webusayiti chikafika: ['pita-ku:'] chitani: { :adilesi
	wekha fufuza-mitu.
	wekha chotsa-mitu.
	zake mitu
	onjeza-kumapeto: (
		Mutu-wa-HTTP chatsopano
		kiyi: ['Status'] mtengo: ['303 See Other']
	),
	onjeza-kumapeto: (
		Mutu-wa-HTTP chatsopano
		kiyi: ['Location'] mtengo: adilesi
	).
	wekha tulutsa: ['Redirect'].
}.

Chikalata-cha-Webusayiti chikafika: ['wononga-gawo'] chitani: {
	wekha fufuza-mitu.
	>> pempho-http := zake pempho-http.
	>> id-ya-gawo := pempho-http cookie: ['xsid'].
	id-ya-gawo Palibe? zabodza: {
		>> mutu-wa-gawo := Mutu-wa-HTTP chatsopano.
		>> nthawi-yotha := Nthawi-yeniyeni chatsopano chaka: 1970, kapangidwe: ['%a, %d %b %Y %H:%M:%S GMT'].
		mutu-wa-gawo kiyi: ['Set-Cookie'] mtengo: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: nthawi-yotha,
			SEC: (zake yotetezeka ichi: ['Secure'] kapena-icho: ['']),
			SSITE: (zake tsamba-limodzi),
			XSID: id-ya-gawo
		).
		zake woyanganira-magawo wononga.
		zake mitu onjeza-kumapeto: mutu-wa-gawo.
	}.
}.


Chikalata-cha-Webusayiti chikafika: ['chitsanzo:'] chitani: { :njira-ya-fayilo <- Chitsanzo chatsopano: (Fayilo chatsopano: njira-ya-fayilo, werengani).
}.

Chikalata-cha-Webusayiti chikafika: ['tulutsa:mtundu:'] chitani: { :zotsatira :mtundu
	zake mitu-yatumizidwa zabodza: {
		zake deta-ya-gawo Palibe? zabodza: {
			zake woyanganira-magawo sunga: zake deta-ya-gawo.
		}.
		zake mitu onjeza-kumapeto: (
			Mutu-wa-HTTP chatsopano
			kiyi: ['Content-type'] mtengo: mtundu
		).
		zake mitu chilichonse: { :_ :mutu
			Zotuluka lembani: mutu.
		}.
		zake mitu-yatumizidwa := Zoona.
		Zotuluka lembani: ['\r\n'].
	}.
	Zotuluka lembani: zotsatira.
}.

Chikalata-cha-Webusayiti chikafika: ['maliza:mtundu:'] chitani: { :zotsatira :mtundu
	zake mitu-yatumizidwa zabodza: {
		zake deta-ya-gawo Palibe? zabodza: {
			zake woyanganira-magawo sunga: zake deta-ya-gawo.
		}.
		zake mitu onjeza-kumapeto: (
			Mutu-wa-HTTP chatsopano
			kiyi: ['Content-type'] mtengo: mtundu
		).
		zake mitu onjeza-kumapeto: (
			Mutu-wa-HTTP chatsopano
			kiyi: ['Content-Length'] mtengo: zotsatira malemba-a-mawu bytes
		).
		zake mitu chilichonse: { :_ :mutu
			Zotuluka lembani: mutu.
		}.
		zake mitu-yatumizidwa := Zoona.
		Zotuluka lembani: ['\r\n'].
	}.
	Zotuluka lembani: zotsatira.
}.

Chikalata-cha-Webusayiti chikafika: ['tulutsa:'] chitani: { :zotsatira
	wekha tulutsa: zotsatira mtundu: ['text/html; charset=utf-8'].
}.

Chikalata-cha-Webusayiti chikafika: ['maliza:'] chitani: { :zotsatira
	wekha maliza: zotsatira mtundu: ['text/html; charset=utf-8'].
}.

Chikalata-cha-Webusayiti chikafika: ['json:'] chitani: { :zotsatira
	wekha tulutsa: ( JSON jsonify: zotsatira ) mtundu: ['application/json'].
}.

Chikalata-cha-Webusayiti chikafika: ['sizinapezeke:'] chitani: { :zotsatira
	wekha chotsa-mitu mutu: (
		Mutu-wa-HTTP chatsopano kiyi: ['Status'] mtengo: ['404 Not Found']
	).
	wekha tulutsa: zotsatira.
}.


# Interface

>> Gawo-la-ntchito := Chinthu chatsopano.

Gawo-la-ntchito chikafika: ['chatsopano'] chitani: { <- wekha chatsopano konzekera za: Palibe.
}.

Gawo-la-ntchito chikafika: ['za:'] chitani: { :id
	zake id := id.
}.

Gawo-la-ntchito chikafika: ['tsegula'] chitani: {
	ntchito-iyi cholakwika: ['Not implemented.'].
}.

Gawo-la-ntchito chikafika: ['sunga:'] chitani: {
	ntchito-iyi cholakwika: ['Not implemented.'].
}.

Gawo-la-ntchito chikafika: ['wononga'] chitani: {
	ntchito-iyi cholakwika: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Gawo-la-fayilo-lakanthawi := Gawo-la-ntchito chatsopano.

Gawo-la-fayilo-lakanthawi chikafika: ['konzekera'] chitani: {
	zake koyambira-njira := ['/tmp/sess-'].
}.

Gawo-la-fayilo-lakanthawi chikafika: ['chiyambi-cha-njira:'] chitani: { :mndandanda-wa-mawu
	zake koyambira-njira := mndandanda-wa-mawu.
}.

Gawo-la-fayilo-lakanthawi chikafika: ['fayilo-ya-gawo'] chitani: { <- ( Fayilo chatsopano: ( zake koyambira-njira + zake id + ['.txt'] ) ).
}.

Gawo-la-fayilo-lakanthawi chikafika: ['tsegula'] chitani: {
	>> fayilo-ya-gawo := wekha fayilo-ya-gawo.
	fayilo-ya-gawo lilipo zabodza: {
		fayilo-ya-gawo lembani: (Mtanthauziramawu chatsopano khodi).
	}. <- fayilo-ya-gawo werengani chinthu.
}.

Gawo-la-fayilo-lakanthawi chikafika: ['sunga:'] chitani: { :deta
	>> fayilo-ya-gawo := wekha fayilo-ya-gawo.
	fayilo-ya-gawo lilipo zoona: {
		fayilo-ya-gawo lembani: deta khodi.
	}.
}.

Gawo-la-fayilo-lakanthawi chikafika: ['wononga'] chitani: {
	>> fayilo-ya-gawo := wekha fayilo-ya-gawo.
	fayilo-ya-gawo lilipo zoona: {
		fayilo-ya-gawo chotsani.
	}.
}.


>> URL := Chinthu chatsopano.

URL chikafika: ['konzekera'] chitani: {
	zake ndondomeko := ['https://'].
	zake wolandira := ['localhost'].
	zake njira-ya-fayilo := [''].
	zake magawo-a-url := [''].
	zake hash := [''].
}.

URL chikafika: ['chatsopano'] chitani: { <- wekha chatsopano konzekera.
}.

URL chikafika: ['malemba-a-mawu'] chitani: { <- (
	zake ndondomeko +
	zake wolandira +
	zake njira-ya-fayilo +
	zake magawo-a-url +
	zake hash ).
}.

URL chikafika: ['ndondomeko:'] chitani: { :ndondomeko
	((Mndandanda chatsopano ; ['http'] ; ['https']) chili-ndi: ndondomeko) zoona: {
		zake ndondomeko := ndondomeko + ['://'].
	}, zabodza: {
		ntchito-iyi cholakwika: ['Invalid protocol'].
	}.
}.

URL chikafika: ['wolandira:'] chitani: { :wolandira
	#todo validate according to rfc
	zake wolandira := wolandira.
}.

URL chikafika: ['njira-ya-fayilo:'] chitani: { :njira-ya-fayilo
	zake njira-ya-fayilo := ['/'] + njira-ya-fayilo url-ika-khodi.
}.

URL chikafika: ['magawo-a-url:'] chitani: { :mapu
	>> magawo-a-url := Mndandanda chatsopano.
	mapu chilichonse: { :kiyi :mtengo
		magawo-a-url onjeza-kumapeto: kiyi malemba-a-mawu url-ika-khodi + ['='] + mtengo malemba-a-mawu url-ika-khodi.
	}.
	zake magawo-a-url := ['?'] + ( magawo-a-url lumikiza: ['&'] ).
}.

URL chikafika: ['hash:'] chitani: { :hash
	zake hash := ['#'] + hash url-ika-khodi.
}.

