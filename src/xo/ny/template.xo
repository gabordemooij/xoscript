
# ~ Simple template engine ~

>> Chitsanzo := Chinthu chatsopano.

Chitsanzo chikafika: ['chatsopano'] chitani: { <- wekha chatsopano zomwe-zili-mkati: [''].
}.

Chitsanzo chikafika: ['zomwe-zili-mkati:'] chitani: { :zomwe-zili-mkati
	zake zomwe-zili-mkati := zomwe-zili-mkati. 
}.

Chitsanzo chikafika: ['chatsopano:'] chitani: { :zomwe-zili-mkati <- wekha chatsopano zomwe-zili-mkati: zomwe-zili-mkati.
}.

Chitsanzo chikafika: ['dula:'] chitani: { :chizindikiro
	>> chizindikiro-choyamba := (['<!-- cut:%id% -->'] %id%: chizindikiro).
	>> chizindikiro-chomaliza := (['<!-- /cut:%id% -->'] %id%: chizindikiro).
	>> magawo := zake zomwe-zili-mkati gawa: chizindikiro-choyamba.
	>> chiyambi := magawo choyamba.
	>> magawo2 := magawo chomaliza gawa: chizindikiro-chomaliza.
	>> mchira := magawo2 chomaliza.
	>> gawo := magawo2 choyamba.
	>> otsala := chiyambi + mchira.
	zake zomwe-zili-mkati := otsala. <- Chitsanzo chatsopano: gawo.
	
}.

Chitsanzo chikafika: ['koperani'] chitani: { <- wekha chatsopano: wekha malemba-a-mawu koperani.
}.
	
Chitsanzo chikafika: ['matira:pa:'] chitani: { :mawu-ochepa :id
	>> chizindikiro-chomatira := (['<!-- paste:%id% -->'] %id%: id).
	zake zomwe-zili-mkati sinthani: chizindikiro-chomatira ndi: ( mawu-ochepa malemba-a-mawu + chizindikiro-chomatira ).
}.

Chitsanzo chikafika: ['khazikitsa:mtengo:'] chitani: { :malo :mtengo
	zake zomwe-zili-mkati sinthani: ['<!-- slot:'] + malo + [' -->'] ndi: ( Server html-ika-khodi: mtengo ).
}.

Chitsanzo chikafika: ['khazikitsa:html:'] chitani: { :malo :html
	zake zomwe-zili-mkati sinthani: ['<!-- slot:'] + malo + [' -->'] ndi: html.
}.

Chitsanzo chikafika: ['yankha:ndi:'] chitani: { :malo :mtengo
	wekha khazikitsa: (malo kuchokera: 0 kutalika: (malo kutalika - 1)) mtengo: mtengo.
}.

Chitsanzo chikafika: ['nl2br'] chitani: {
	zake zomwe-zili-mkati sinthani: ['\n'] ndi: ['<br>'].
}.

Chitsanzo chikafika: ['konza'] chitani: {
	zake zomwe-zili-mkati :=
		Chitsanzo-chofufuzira
		chatsopano: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		kufanana: zake zomwe-zili-mkati
		chitani: { <- ['']. }.
}.

Chitsanzo chikafika: ['konza-zodulidwa'] chitani: {
	>> zinthu := Mndandanda chatsopano.
	Chitsanzo-chofufuzira
	chatsopano: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	kufanana: zake zomwe-zili-mkati
	chitani: { :_ :gawo
		zinthu onjeza-kumapeto: gawo ? 1.
	}.
	zinthu chilichonse: { :_ :id
		zake zomwe-zili-mkati :=
			Chitsanzo-chofufuzira chatsopano: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			kufanana: zake zomwe-zili-mkati
			chitani: { <- ['']. }.
	 }.
}.

Chitsanzo chikafika: ['konza-mipata'] chitani: {
	zake zomwe-zili-mkati :=
		Chitsanzo-chofufuzira
		chatsopano: ['\\s*\\n'],
		kufanana: zake zomwe-zili-mkati
		chitani: { <- ['\n']. }.
	zake zomwe-zili-mkati :=
		Chitsanzo-chofufuzira
		chatsopano: ['\\n[\\s\\t]+'],
		kufanana: zake zomwe-zili-mkati
		chitani: { <- ['\n']. }.
}.

Chitsanzo chikafika: ['konza-zonse'] chitani: {
	wekha konza.
	wekha konza-zodulidwa.
	wekha konza-mipata.
}.

Chitsanzo chikafika: ['malemba-a-mawu'] chitani: { <- zake zomwe-zili-mkati.
}.
