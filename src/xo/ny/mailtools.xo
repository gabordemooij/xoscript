>> Imelo := Chinthu chatsopano.

Imelo chikafika: ['konzekera'] chitani: {
	zake olandira := Mndandanda chatsopano.
	zake cc := Mndandanda chatsopano.
	zake bcc := Mndandanda chatsopano.
	zake wotumiza := Palibe.
	zake dzina-la-wotumiza := Palibe.
	zake nkhani := Palibe.
	zake thupi := Palibe.
}.

Imelo chikafika: ['chatsopano'] chitani: { <- wekha chatsopano konzekera.
}.

Imelo chikafika: ['kwa:'] chitani: { :kulemba-mndandanda
	zake olandira := kulemba-mndandanda.
}.
 
Imelo chikafika: ['cc:'] chitani: { :kulemba-mndandanda
	zake cc := kulemba-mndandanda.
}.

Imelo chikafika: ['bcc:'] chitani: { :kulemba-mndandanda
	zake bcc := kulemba-mndandanda.
}.

Imelo chikafika: ['nkhani:'] chitani: { :nkhani
	zake nkhani := nkhani.
}.

Imelo chikafika: ['wotumiza:dzina:'] chitani: { :wotumiza :dzina
	zake wotumiza := wotumiza.
	zake dzina-la-wotumiza := dzina.
}.

Imelo chikafika: ['thupi:'] chitani: { :thupi
	zake thupi := thupi.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imelo chikafika: ['mutu:'] chitani: { :mzere <- mzere sinthani: ['\r'] ndi: [''], sinthani: ['\n'] ndi: [''].
}.

Imelo chikafika: ['tumiza'] chitani: {
	>> f := Fayilo tempwrite: wekha pangani.
	Pulogalamu dongosolo-la-makina: ['sendmail -t < '] + f njira-ya-fayilo, mzere-watsopano.
}.

Imelo chikafika: ['pangani'] chitani: {
	>> kuswa-mzere := ['\r\n'].
	>> mndandanda-wa-mawu := [''].
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['From: '] + zake dzina-la-wotumiza + [' <'] + ( zake wotumiza ) + ['>']) + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['To: '] + ( zake olandira lumikiza: [','] )) + kuswa-mzere.
	zake cc chiwerengero-cha-zinthu zoona: {
		mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Cc: '] + ( zake cc lumikiza: [','] )) + kuswa-mzere.
	}.
	zake bcc chiwerengero-cha-zinthu zoona: {
		mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Bcc: '] + ( zake bcc lumikiza: [','] )) + kuswa-mzere.
	}.
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Subject: '] + zake nkhani) + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: zake thupi.
	mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere. <- mndandanda-wa-mawu.
}.

>> Imelo-HTML := Imelo chatsopano.

Imelo-HTML chikafika: ['konzekera'] chitani: {
	wekha konzekera.
	zake zolumikizidwa := Mndandanda chatsopano.
	zake malire := Nkhokwe-yotetezedwa token: 40.
}.

Imelo-HTML chikafika: ['lumikiza-fayilo:'] chitani: { :fayilo-ya-gawo
	>> id := zake zolumikizidwa chiwerengero-cha-zinthu.
	>> blob := fayilo-ya-gawo blob.
	zake zolumikizidwa onjeza-kumapeto: (
		Mtanthauziramawu chatsopano
			fayilo-ya-gawo: fayilo-ya-gawo njira-ya-fayilo,
			mime: ['image/'] + (Server mimetype: fayilo-ya-gawo njira-ya-fayilo),
			deta: blob base64-ika-khodi
	).
	blob masula. <- ['cid:attachment'] + id.
}.

Imelo-HTML chikafika: ['pangani'] chitani: {
	>> kuswa-mzere := ['\r\n'].
	>> mndandanda-wa-mawu := [''].
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['From: '] + zake dzina-la-wotumiza + [' <'] + ( zake wotumiza ) + ['>']) + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['To: '] + ( zake olandira lumikiza: [','] )) + kuswa-mzere.
	zake cc chiwerengero-cha-zinthu zoona: {
		mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Cc: '] + ( zake cc lumikiza: [','] )) + kuswa-mzere.
	}.
	zake bcc chiwerengero-cha-zinthu zoona: {
		mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Bcc: '] + ( zake bcc lumikiza: [','] )) + kuswa-mzere.
	}.
	mndandanda-wa-mawu onjeza-kumapeto: (wekha mutu: ['Subject: '] + zake nkhani) + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: ['MIME-Version: 1.0'] + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: ['Content-Type: multipart/related; boundary="'] + zake malire + ['"; type=text/html'] + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: ['--'] + zake malire + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: ['Content-Type: text/html; charset=UTF-8'] + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: ['Content-Transfer-Encoding: 7bit'] + kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
	mndandanda-wa-mawu onjeza-kumapeto: zake thupi.
	mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
	zake zolumikizidwa chilichonse: { :id :zambiri
		>> blob := zambiri deta.
		mndandanda-wa-mawu onjeza-kumapeto: ['--'] + zake malire + kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: ['Content-Type: '] + zambiri mime + kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: ['Content-Transfer-Encoding: base64'] + kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: ['Content-ID: <attachment'] + id + ['>'] + kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: ['Content-Disposition: inline; filename="'] + zambiri fayilo-ya-gawo + ['"'] + kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
		>> kwambiri := 76.
		>> kutalika-kwa-mawu := blob kutalika.
		>> tizidutswa := (kutalika-kwa-mawu / kwambiri) kweza-nambala.
		{ :i
			>> kachidutswa := blob koperani kuchokera: i * kwambiri kutalika: kwambiri.
			mndandanda-wa-mawu onjeza-kumapeto: kachidutswa + kuswa-mzere.
		} * tizidutswa.
		mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
		mndandanda-wa-mawu onjeza-kumapeto: kuswa-mzere.
	}.
	mndandanda-wa-mawu onjeza-kumapeto: ['--'] + zake malire + ['--'] + kuswa-mzere. <- mndandanda-wa-mawu.
}.
