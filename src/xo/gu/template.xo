
# ~ Simple template engine ~

>> ઢાંચો := વસ્તુ નવું.

ઢાંચો જ્યારે: ['નવું'] કરો: { <- પોતે નવું સામગ્રી: [''].
}.

ઢાંચો જ્યારે: ['સામગ્રી:'] કરો: { :સામગ્રી
	પોતાનું સામગ્રી := સામગ્રી. 
}.

ઢાંચો જ્યારે: ['નવું:'] કરો: { :સામગ્રી <- પોતે નવું સામગ્રી: સામગ્રી.
}.

ઢાંચો જ્યારે: ['કાપો:'] કરો: { :નિશાન
	>> શરૂઆત-નિશાન := (['<!-- cut:%id% -->'] %id%: નિશાન).
	>> અંત-નિશાન := (['<!-- /cut:%id% -->'] %id%: નિશાન).
	>> ભાગો := પોતાનું સામગ્રી વિભાજન: શરૂઆત-નિશાન.
	>> ઉપસર્ગ := ભાગો પહેલું.
	>> ભાગો2 := ભાગો છેલ્લું વિભાજન: અંત-નિશાન.
	>> પ્રત્યય := ભાગો2 છેલ્લું.
	>> ભાગ := ભાગો2 પહેલું.
	>> બાકી := ઉપસર્ગ + પ્રત્યય.
	પોતાનું સામગ્રી := બાકી. <- ઢાંચો નવું: ભાગ.
	
}.

ઢાંચો જ્યારે: ['નકલ'] કરો: { <- પોતે નવું: પોતે લખાણમાં નકલ.
}.
	
ઢાંચો જ્યારે: ['ચોંટાડો:ચાવી:'] કરો: { :અવતરણ :id
	>> ચોંટાડવાનું-નિશાન := (['<!-- paste:%id% -->'] %id%: id).
	પોતાનું સામગ્રી બદલો: ચોંટાડવાનું-નિશાન વડે: ( અવતરણ લખાણમાં + ચોંટાડવાનું-નિશાન ).
}.

ઢાંચો જ્યારે: ['નક્કી:મૂલ્ય:'] કરો: { :સ્થાન :મૂલ્ય
	પોતાનું સામગ્રી બદલો: ['<!-- slot:'] + સ્થાન + [' -->'] વડે: ( Server html-એન્કોડ: મૂલ્ય ).
}.

ઢાંચો જ્યારે: ['નક્કી:html:'] કરો: { :સ્થાન :html
	પોતાનું સામગ્રી બદલો: ['<!-- slot:'] + સ્થાન + [' -->'] વડે: html.
}.

ઢાંચો જ્યારે: ['જવાબ:અને:'] કરો: { :સ્થાન :મૂલ્ય
	પોતે નક્કી: (સ્થાન શરૂઆત: 0 લંબાઈ: (સ્થાન લંબાઈ - 1)) મૂલ્ય: મૂલ્ય.
}.

ઢાંચો જ્યારે: ['nl2br'] કરો: {
	પોતાનું સામગ્રી બદલો: ['\n'] વડે: ['<br>'].
}.

ઢાંચો જ્યારે: ['નિશાન-દૂર-કરો'] કરો: {
	પોતાનું સામગ્રી :=
		પેટર્ન
		નવું: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		મેળ: પોતાનું સામગ્રી
		કરો: { <- ['']. }.
}.

ઢાંચો જ્યારે: ['કટ-દૂર-કરો'] કરો: {
	>> વસ્તુઓ := સૂચિ નવું.
	પેટર્ન
	નવું: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	મેળ: પોતાનું સામગ્રી
	કરો: { :_ :ભાગ
		વસ્તુઓ અંતે-ઉમેરો: ભાગ ? 1.
	}.
	વસ્તુઓ દરેક: { :_ :id
		પોતાનું સામગ્રી :=
			પેટર્ન નવું: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			મેળ: પોતાનું સામગ્રી
			કરો: { <- ['']. }.
	 }.
}.

ઢાંચો જ્યારે: ['જગ્યા-દૂર-કરો'] કરો: {
	પોતાનું સામગ્રી :=
		પેટર્ન
		નવું: ['\\s*\\n'],
		મેળ: પોતાનું સામગ્રી
		કરો: { <- ['\n']. }.
	પોતાનું સામગ્રી :=
		પેટર્ન
		નવું: ['\\n[\\s\\t]+'],
		મેળ: પોતાનું સામગ્રી
		કરો: { <- ['\n']. }.
}.

ઢાંચો જ્યારે: ['બધા-નિશાન-દૂર-કરો'] કરો: {
	પોતે નિશાન-દૂર-કરો.
	પોતે કટ-દૂર-કરો.
	પોતે જગ્યા-દૂર-કરો.
}.

ઢાંચો જ્યારે: ['લખાણમાં'] કરો: { <- પોતાનું સામગ્રી.
}.
