
# ~ Simple template engine ~

>> テンプレート := オブジェクト 新規.

テンプレート 受信時: ['新規'] 実行: { <- 自身 新規 内容: [''].
}.

テンプレート 受信時: ['内容:'] 実行: { :内容
	自分の 内容 := 内容. 
}.

テンプレート 受信時: ['新規:'] 実行: { :内容 <- 自身 新規 内容: 内容.
}.

テンプレート 受信時: ['切り取り:'] 実行: { :マーカー
	>> 開始マーカー := (['<!-- cut:%id% -->'] %id%: マーカー).
	>> 終了マーカー := (['<!-- /cut:%id% -->'] %id%: マーカー).
	>> 部分群 := 自分の 内容 分割: 開始マーカー.
	>> 接頭辞 := 部分群 最初.
	>> 部分群2 := 部分群 最後 分割: 終了マーカー.
	>> 接尾辞 := 部分群2 最後.
	>> 部分 := 部分群2 最初.
	>> 残り := 接頭辞 + 接尾辞.
	自分の 内容 := 残り. <- テンプレート 新規: 部分.
	
}.

テンプレート 受信時: ['複製'] 実行: { <- 自身 新規: 自身 文字列化 複製.
}.
	
テンプレート 受信時: ['貼り付け:場所:'] 実行: { :断片 :id
	>> 貼り付けマーカー := (['<!-- paste:%id% -->'] %id%: id).
	自分の 内容 置換: 貼り付けマーカー 新: ( 断片 文字列化 + 貼り付けマーカー ).
}.

テンプレート 受信時: ['設定:値:'] 実行: { :差し込み口 :設定値
	自分の 内容 置換: ['<!-- slot:'] + 差し込み口 + [' -->'] 新: ( Server html-エンコード: 設定値 ).
}.

テンプレート 受信時: ['設定:html:'] 実行: { :差し込み口 :html
	自分の 内容 置換: ['<!-- slot:'] + 差し込み口 + [' -->'] 新: html.
}.

テンプレート 受信時: ['応答:かつ:'] 実行: { :差し込み口 :設定値
	自身 設定: (差し込み口 開始: 0 長さ: (差し込み口 長さ - 1)) 値: 設定値.
}.

テンプレート 受信時: ['nl2br'] 実行: {
	自分の 内容 置換: ['\n'] 新: ['<br>'].
}.

テンプレート 受信時: ['マーカー除去'] 実行: {
	自分の 内容 :=
		パターン
		新規: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		一致: 自分の 内容
		実行: { <- ['']. }.
}.

テンプレート 受信時: ['カット除去'] 実行: {
	>> 項目 := リスト 新規.
	パターン
	新規: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	一致: 自分の 内容
	実行: { :_ :部分
		項目 末尾に追加: 部分 ? 1.
	}.
	項目 各要素: { :_ :id
		自分の 内容 :=
			パターン 新規: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			一致: 自分の 内容
			実行: { <- ['']. }.
	 }.
}.

テンプレート 受信時: ['余白除去'] 実行: {
	自分の 内容 :=
		パターン
		新規: ['\\s*\\n'],
		一致: 自分の 内容
		実行: { <- ['\n']. }.
	自分の 内容 :=
		パターン
		新規: ['\\n[\\s\\t]+'],
		一致: 自分の 内容
		実行: { <- ['\n']. }.
}.

テンプレート 受信時: ['全部除去'] 実行: {
	自身 マーカー除去.
	自身 カット除去.
	自身 余白除去.
}.

テンプレート 受信時: ['文字列化'] 実行: { <- 自分の 内容.
}.
