>> Электрон-хат := Объект яңа.

Электрон-хат килгәндә: ['башлангыч-халәт'] эшлә: {
	үзенең алучылар := Тезмә яңа.
	үзенең cc := Тезмә яңа.
	үзенең bcc := Тезмә яңа.
	үзенең җибәрүче := Буш.
	үзенең җибәрүче-исеме := Буш.
	үзенең тема := Буш.
	үзенең төп-текст := Буш.
}.

Электрон-хат килгәндә: ['яңа'] эшлә: { <- үзе яңа башлангыч-халәт.
}.

Электрон-хат килгәндә: ['алучыга:'] эшлә: { :санап-чыгу
	үзенең алучылар := санап-чыгу.
}.
 
Электрон-хат килгәндә: ['cc:'] эшлә: { :санап-чыгу
	үзенең cc := санап-чыгу.
}.

Электрон-хат килгәндә: ['bcc:'] эшлә: { :санап-чыгу
	үзенең bcc := санап-чыгу.
}.

Электрон-хат килгәндә: ['тема:'] эшлә: { :тема
	үзенең тема := тема.
}.

Электрон-хат килгәндә: ['җибәрүче:исем:'] эшлә: { :җибәрүче :исем
	үзенең җибәрүче := җибәрүче.
	үзенең җибәрүче-исеме := исем.
}.

Электрон-хат килгәндә: ['төп-текст:'] эшлә: { :төп-текст
	үзенең төп-текст := төп-текст.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Электрон-хат килгәндә: ['башлык:'] эшлә: { :юл-текст <- юл-текст алыштыр: ['\r'] белән: [''], алыштыр: ['\n'] белән: [''].
}.

Электрон-хат килгәндә: ['җибәрү'] эшлә: {
	>> f := Файл tempwrite: үзе ясау.
	Программа система: ['sendmail -t < '] + f юл, яңа-юл.
}.

Электрон-хат килгәндә: ['ясау'] эшлә: {
	>> юл-өзелеше := ['\r\n'].
	>> юл-тезмәсе := [''].
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['From: '] + үзенең җибәрүче-исеме + [' <'] + ( үзенең җибәрүче ) + ['>']) + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['To: '] + ( үзенең алучылар берләштер: [','] )) + юл-өзелеше.
	үзенең cc саны дөрес: {
		юл-тезмәсе ахырга-өстә: (үзе башлык: ['Cc: '] + ( үзенең cc берләштер: [','] )) + юл-өзелеше.
	}.
	үзенең bcc саны дөрес: {
		юл-тезмәсе ахырга-өстә: (үзе башлык: ['Bcc: '] + ( үзенең bcc берләштер: [','] )) + юл-өзелеше.
	}.
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['Subject: '] + үзенең тема) + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: юл-өзелеше.
	юл-тезмәсе ахырга-өстә: үзенең төп-текст.
	юл-тезмәсе ахырга-өстә: юл-өзелеше. <- юл-тезмәсе.
}.

>> HTML-Электрон-хат := Электрон-хат яңа.

HTML-Электрон-хат килгәндә: ['башлангыч-халәт'] эшлә: {
	үзе башлангыч-халәт.
	үзенең беркетмәләр := Тезмә яңа.
	үзенең чик := Сейф токен: 40.
}.

HTML-Электрон-хат килгәндә: ['беркетү:'] эшлә: { :файл
	>> id := үзенең беркетмәләр саны.
	>> blob := файл blob.
	үзенең беркетмәләр ахырга-өстә: (
		Сүзлек яңа
			файл: файл юл,
			mime: ['image/'] + (Server mimetype: файл юл),
			мәгълүматлар: blob base64-кодлау
	).
	blob бушат. <- ['cid:attachment'] + id.
}.

HTML-Электрон-хат килгәндә: ['ясау'] эшлә: {
	>> юл-өзелеше := ['\r\n'].
	>> юл-тезмәсе := [''].
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['From: '] + үзенең җибәрүче-исеме + [' <'] + ( үзенең җибәрүче ) + ['>']) + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['To: '] + ( үзенең алучылар берләштер: [','] )) + юл-өзелеше.
	үзенең cc саны дөрес: {
		юл-тезмәсе ахырга-өстә: (үзе башлык: ['Cc: '] + ( үзенең cc берләштер: [','] )) + юл-өзелеше.
	}.
	үзенең bcc саны дөрес: {
		юл-тезмәсе ахырга-өстә: (үзе башлык: ['Bcc: '] + ( үзенең bcc берләштер: [','] )) + юл-өзелеше.
	}.
	юл-тезмәсе ахырга-өстә: (үзе башлык: ['Subject: '] + үзенең тема) + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: ['MIME-Version: 1.0'] + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: ['Content-Type: multipart/related; boundary="'] + үзенең чик + ['"; type=text/html'] + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: юл-өзелеше.
	юл-тезмәсе ахырга-өстә: ['--'] + үзенең чик + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: ['Content-Type: text/html; charset=UTF-8'] + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: ['Content-Transfer-Encoding: 7bit'] + юл-өзелеше.
	юл-тезмәсе ахырга-өстә: юл-өзелеше.
	юл-тезмәсе ахырга-өстә: үзенең төп-текст.
	юл-тезмәсе ахырга-өстә: юл-өзелеше.
	үзенең беркетмәләр һәрбер: { :id :белешмә
		>> blob := белешмә мәгълүматлар.
		юл-тезмәсе ахырга-өстә: ['--'] + үзенең чик + юл-өзелеше.
		юл-тезмәсе ахырга-өстә: ['Content-Type: '] + белешмә mime + юл-өзелеше.
		юл-тезмәсе ахырга-өстә: ['Content-Transfer-Encoding: base64'] + юл-өзелеше.
		юл-тезмәсе ахырга-өстә: ['Content-ID: <attachment'] + id + ['>'] + юл-өзелеше.
		юл-тезмәсе ахырга-өстә: ['Content-Disposition: inline; filename="'] + белешмә файл + ['"'] + юл-өзелеше.
		юл-тезмәсе ахырга-өстә: юл-өзелеше.
		>> иң-күп := 76.
		>> текст-озынлыгы := blob озынлык.
		>> кисәкләр := (текст-озынлыгы / иң-күп) өскә-түгәрәкләү.
		{ :i
			>> кисәк := blob күчермә башлап: i * иң-күп озынлык: иң-күп.
			юл-тезмәсе ахырга-өстә: кисәк + юл-өзелеше.
		} * кисәкләр.
		юл-тезмәсе ахырга-өстә: юл-өзелеше.
		юл-тезмәсе ахырга-өстә: юл-өзелеше.
	}.
	юл-тезмәсе ахырга-өстә: ['--'] + үзенең чик + ['--'] + юл-өзелеше. <- юл-тезмәсе.
}.
