
# ~ Simple template engine ~

>> Калып := Объект яңа.

Калып килгәндә: ['яңа'] эшлә: { <- үзе яңа эчтәлек: [''].
}.

Калып килгәндә: ['эчтәлек:'] эшлә: { :эчтәлек
	үзенең эчтәлек := эчтәлек. 
}.

Калып килгәндә: ['яңа:'] эшлә: { :эчтәлек <- үзе яңа эчтәлек: эчтәлек.
}.

Калып килгәндә: ['кисү:'] эшлә: { :билге
	>> башлангыч-билге := (['<!-- cut:%id% -->'] %id%: билге).
	>> ахыргы-билге := (['<!-- /cut:%id% -->'] %id%: билге).
	>> бүлекләр := үзенең эчтәлек бүл: башлангыч-билге.
	>> префикс := бүлекләр беренче.
	>> бүлекләр2 := бүлекләр соңгы бүл: ахыргы-билге.
	>> кушымча := бүлекләр2 соңгы.
	>> бүлек := бүлекләр2 беренче.
	>> калдык := префикс + кушымча.
	үзенең эчтәлек := калдык. <- Калып яңа: бүлек.
	
}.

Калып килгәндә: ['күчермә'] эшлә: { <- үзе яңа: үзе текст күчермә.
}.
	
Калып килгәндә: ['ябыштыру:ачкыч:'] эшлә: { :өзек :id
	>> ябыштыру-билгесе := (['<!-- paste:%id% -->'] %id%: id).
	үзенең эчтәлек алыштыр: ябыштыру-билгесе белән: ( өзек текст + ябыштыру-билгесе ).
}.

Калып килгәндә: ['билгелә:кыйммәт:'] эшлә: { :урын :кыйммәт
	үзенең эчтәлек алыштыр: ['<!-- slot:'] + урын + [' -->'] белән: ( Server html-кодлау: кыйммәт ).
}.

Калып килгәндә: ['билгелә:html:'] эшлә: { :урын :html
	үзенең эчтәлек алыштыр: ['<!-- slot:'] + урын + [' -->'] белән: html.
}.

Калып килгәндә: ['җавап-бир:һәм:'] эшлә: { :урын :кыйммәт
	үзе билгелә: (урын башлап: 0 озынлык: (урын озынлык - 1)) кыйммәт: кыйммәт.
}.

Калып килгәндә: ['nl2br'] эшлә: {
	үзенең эчтәлек алыштыр: ['\n'] белән: ['<br>'].
}.

Калып килгәндә: ['тәртипкә-салу'] эшлә: {
	үзенең эчтәлек :=
		Үрнәк
		яңа: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		туры-килү: үзенең эчтәлек
		эшлә: { <- ['']. }.
}.

Калып килгәндә: ['киселмәләрне-тәртипкә-салу'] эшлә: {
	>> элементлар := Тезмә яңа.
	Үрнәк
	яңа: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	туры-килү: үзенең эчтәлек
	эшлә: { :_ :бүлек
		элементлар ахырга-өстә: бүлек ? 1.
	}.
	элементлар һәрбер: { :_ :id
		үзенең эчтәлек :=
			Үрнәк яңа: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			туры-килү: үзенең эчтәлек
			эшлә: { <- ['']. }.
	 }.
}.

Калып килгәндә: ['бушлыкларны-тәртипкә-салу'] эшлә: {
	үзенең эчтәлек :=
		Үрнәк
		яңа: ['\\s*\\n'],
		туры-килү: үзенең эчтәлек
		эшлә: { <- ['\n']. }.
	үзенең эчтәлек :=
		Үрнәк
		яңа: ['\\n[\\s\\t]+'],
		туры-килү: үзенең эчтәлек
		эшлә: { <- ['\n']. }.
}.

Калып килгәндә: ['барысын-тәртипкә-салу'] эшлә: {
	үзе тәртипкә-салу.
	үзе киселмәләрне-тәртипкә-салу.
	үзе бушлыкларны-тәртипкә-салу.
}.

Калып килгәндә: ['текст'] эшлә: { <- үзенең эчтәлек.
}.
