HTTP-Сорау килгәндә: ['HTTP-башлык:'] эшлә: { :ачкыч <- Программа көйләү: ачкыч.
}.

>> HTTP-Башлык := Объект яңа.

HTTP-Башлык килгәндә: ['яңа'] эшлә: { <- үзе яңа башлангыч-халәт.
}.

HTTP-Башлык килгәндә: ['башлангыч-халәт'] эшлә: {
	үзенең ачкыч := Буш.
	үзенең кыйммәт := Буш.
}.

HTTP-Башлык килгәндә: ['ачкыч:кыйммәт:'] эшлә: { :ачкыч :кыйммәт
	үзенең ачкыч := ачкыч.
	үзенең кыйммәт := кыйммәт.
}.

HTTP-Башлык килгәндә: ['ачкыч'] эшлә: { <- үзенең ачкыч.
}.

HTTP-Башлык килгәндә: ['кыйммәт'] эшлә: { <- үзенең кыйммәт.
}.


HTTP-Башлык килгәндә: ['текст'] эшлә: {
	>> юл-текст := үзенең ачкыч + [': '] + үзенең кыйммәт.
	юл-текст алыштыр: ['\r'] белән: [''], алыштыр: ['\n'] белән: ['']. <- юл-текст + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Объект яңа.

Веб-документ килгәндә: ['яңа'] эшлә: { <- үзе яңа башлангыч-халәт.
}.

Веб-документ килгәндә: ['башлангыч-халәт'] эшлә: {
	үзенең башлыклар := Тезмә яңа.
	үзенең сеанс-id := Буш.
	үзенең сеанс-идарәчесе := Вакытлыча-файл-сеансы яңа.
	үзенең сеанс-мәгълүматлары := Буш.
	үзенең куркынычсыз := Дөрес.
	үзенең бер-сайт := ['Strict'].
	үзенең башлыклар-җибәрелде := Ялган.
	үзенең http-сорау := HTTP-Сорау яңа.
}.

Веб-документ килгәндә: ['http-сорау:'] эшлә: { :http-сорау
	үзенең http-сорау := http-сорау.
}. 

Веб-документ килгәндә: ['куркынычсыз-сеанс-cookie:'] эшлә: { :куркынычсыз
	үзе башлыкларны-тикшерү.
	үзенең куркынычсыз := куркынычсыз.
}.

Веб-документ килгәндә: ['бер-сайт-сеанс-cookie:'] эшлә: { :кыйммәт
	үзе башлыкларны-тикшерү.
	>> вариантлар := Тезмә яңа 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	вариантлар бар: кыйммәт, ялган: {
		бу-бирем хата: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	үзенең бер-сайт := кыйммәт.
}.

Веб-документ килгәндә: ['башлык:'] эшлә: { :башлык
	үзе башлыкларны-тикшерү.
	үзенең башлыклар ахырга-өстә: башлык.
}.

Веб-документ килгәндә: ['башлыкларны-бушату'] эшлә: {
	үзе башлыкларны-тикшерү.
	үзенең башлыклар := Тезмә яңа.
}.

Веб-документ килгәндә: ['сеанс-идарәчесе:'] эшлә: { :идарәче
	үзе башлыкларны-тикшерү.
	үзенең сеанс-идарәчесе := идарәче.
}.

Веб-документ килгәндә: ['сеанс-идарәчесе'] эшлә: { <- үзенең сеанс-идарәчесе.
}.

Веб-документ килгәндә: ['башлыкларны-тикшерү'] эшлә: {
	үзенең башлыклар-җибәрелде дөрес: {
		бу-бирем хата: ['Headers already sent to client.'].
	}.
}.

Веб-документ килгәндә: ['сеансны-башлау'] эшлә: {
	үзе башлыкларны-тикшерү.
	>> http-сорау := үзенең http-сорау.
	>> сеанс-id := http-сорау cookie: ['xsid'].
	сеанс-id Буш? ялган: {
		(( Үрнәк яңа: ['^[A-Za-z0-9]+\\z'], туры-килү: сеанс-id ) = 0) дөрес: {
			сеанс-id := Буш.
		}.
	}.
	сеанс-id Буш? дөрес: {
		сеанс-id := Сейф токен: 30.
		>> сеанс-башлыгы := HTTP-Башлык яңа
		ачкыч: ['Set-Cookie'] кыйммәт: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (үзенең куркынычсыз бу: ['Secure'] яки-теге: ['']),
		SSITE: (үзенең бер-сайт),
		XSID: сеанс-id
		).
		үзенең башлыклар ахырга-өстә: сеанс-башлыгы.
	}.
	үзенең сеанс-мәгълүматлары := үзенең сеанс-идарәчесе өчен: сеанс-id, йөкләү. <- үзенең сеанс-мәгълүматлары. # reference
}.

Веб-документ килгәндә: ['күчү:'] эшлә: { :адрес
	үзе башлыкларны-тикшерү.
	үзе башлыкларны-бушату.
	үзенең башлыклар
	ахырга-өстә: (
		HTTP-Башлык яңа
		ачкыч: ['Status'] кыйммәт: ['303 See Other']
	),
	ахырга-өстә: (
		HTTP-Башлык яңа
		ачкыч: ['Location'] кыйммәт: адрес
	).
	үзе чыгару: ['Redirect'].
}.

Веб-документ килгәндә: ['сеансны-юк-итү'] эшлә: {
	үзе башлыкларны-тикшерү.
	>> http-сорау := үзенең http-сорау.
	>> сеанс-id := http-сорау cookie: ['xsid'].
	сеанс-id Буш? ялган: {
		>> сеанс-башлыгы := HTTP-Башлык яңа.
		>> мизгел := Мизгел яңа ел: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		сеанс-башлыгы ачкыч: ['Set-Cookie'] кыйммәт: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: мизгел,
			SEC: (үзенең куркынычсыз бу: ['Secure'] яки-теге: ['']),
			SSITE: (үзенең бер-сайт),
			XSID: сеанс-id
		).
		үзенең сеанс-идарәчесе юк-итү.
		үзенең башлыклар ахырга-өстә: сеанс-башлыгы.
	}.
}.


Веб-документ килгәндә: ['калып:'] эшлә: { :юл <- Калып яңа: (Файл яңа: юл, укы).
}.

Веб-документ килгәндә: ['чыгару:төр:'] эшлә: { :нәтиҗә :төр
	үзенең башлыклар-җибәрелде ялган: {
		үзенең сеанс-мәгълүматлары Буш? ялган: {
			үзенең сеанс-идарәчесе саклау: үзенең сеанс-мәгълүматлары.
		}.
		үзенең башлыклар ахырга-өстә: (
			HTTP-Башлык яңа
			ачкыч: ['Content-type'] кыйммәт: төр
		).
		үзенең башлыклар һәрбер: { :_ :башлык
			Чыгыш яз: башлык.
		}.
		үзенең башлыклар-җибәрелде := Дөрес.
		Чыгыш яз: ['\r\n'].
	}.
	Чыгыш яз: нәтиҗә.
}.

Веб-документ килгәндә: ['тәмамлау:төр:'] эшлә: { :нәтиҗә :төр
	үзенең башлыклар-җибәрелде ялган: {
		үзенең сеанс-мәгълүматлары Буш? ялган: {
			үзенең сеанс-идарәчесе саклау: үзенең сеанс-мәгълүматлары.
		}.
		үзенең башлыклар ахырга-өстә: (
			HTTP-Башлык яңа
			ачкыч: ['Content-type'] кыйммәт: төр
		).
		үзенең башлыклар ахырга-өстә: (
			HTTP-Башлык яңа
			ачкыч: ['Content-Length'] кыйммәт: нәтиҗә текст bytes
		).
		үзенең башлыклар һәрбер: { :_ :башлык
			Чыгыш яз: башлык.
		}.
		үзенең башлыклар-җибәрелде := Дөрес.
		Чыгыш яз: ['\r\n'].
	}.
	Чыгыш яз: нәтиҗә.
}.

Веб-документ килгәндә: ['чыгару:'] эшлә: { :нәтиҗә
	үзе чыгару: нәтиҗә төр: ['text/html; charset=utf-8'].
}.

Веб-документ килгәндә: ['тәмамлау:'] эшлә: { :нәтиҗә
	үзе тәмамлау: нәтиҗә төр: ['text/html; charset=utf-8'].
}.

Веб-документ килгәндә: ['json:'] эшлә: { :нәтиҗә
	үзе чыгару: ( JSON jsonify: нәтиҗә ) төр: ['application/json'].
}.

Веб-документ килгәндә: ['табылмады:'] эшлә: { :нәтиҗә
	үзе башлыкларны-бушату башлык: (
		HTTP-Башлык яңа ачкыч: ['Status'] кыйммәт: ['404 Not Found']
	).
	үзе чыгару: нәтиҗә.
}.


# Interface

>> Сеанс := Объект яңа.

Сеанс килгәндә: ['яңа'] эшлә: { <- үзе яңа башлангыч-халәт өчен: Буш.
}.

Сеанс килгәндә: ['өчен:'] эшлә: { :id
	үзенең id := id.
}.

Сеанс килгәндә: ['йөкләү'] эшлә: {
	бу-бирем хата: ['Not implemented.'].
}.

Сеанс килгәндә: ['саклау:'] эшлә: {
	бу-бирем хата: ['Not implemented.'].
}.

Сеанс килгәндә: ['юк-итү'] эшлә: {
	бу-бирем хата: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Вакытлыча-файл-сеансы := Сеанс яңа.

Вакытлыча-файл-сеансы килгәндә: ['башлангыч-халәт'] эшлә: {
	үзенең юл-башы := ['/tmp/sess-'].
}.

Вакытлыча-файл-сеансы килгәндә: ['юл-префиксы:'] эшлә: { :юл-тезмәсе
	үзенең юл-башы := юл-тезмәсе.
}.

Вакытлыча-файл-сеансы килгәндә: ['файл'] эшлә: { <- ( Файл яңа: ( үзенең юл-башы + үзенең id + ['.txt'] ) ).
}.

Вакытлыча-файл-сеансы килгәндә: ['йөкләү'] эшлә: {
	>> файл := үзе файл.
	файл бар ялган: {
		файл яз: (Сүзлек яңа код).
	}. <- файл укы объект.
}.

Вакытлыча-файл-сеансы килгәндә: ['саклау:'] эшлә: { :мәгълүматлар
	>> файл := үзе файл.
	файл бар дөрес: {
		файл яз: мәгълүматлар код.
	}.
}.

Вакытлыча-файл-сеансы килгәндә: ['юк-итү'] эшлә: {
	>> файл := үзе файл.
	файл бар дөрес: {
		файл бетер.
	}.
}.


>> URL := Объект яңа.

URL килгәндә: ['башлангыч-халәт'] эшлә: {
	үзенең протокол := ['https://'].
	үзенең хост := ['localhost'].
	үзенең юл := [''].
	үзенең url-параметрлары := [''].
	үзенең hash := [''].
}.

URL килгәндә: ['яңа'] эшлә: { <- үзе яңа башлангыч-халәт.
}.

URL килгәндә: ['текст'] эшлә: { <- (
	үзенең протокол +
	үзенең хост +
	үзенең юл +
	үзенең url-параметрлары +
	үзенең hash ).
}.

URL килгәндә: ['протокол:'] эшлә: { :протокол
	((Тезмә яңа ; ['http'] ; ['https']) бар: протокол) дөрес: {
		үзенең протокол := протокол + ['://'].
	}, ялган: {
		бу-бирем хата: ['Invalid protocol'].
	}.
}.

URL килгәндә: ['хост:'] эшлә: { :хост
	#todo validate according to rfc
	үзенең хост := хост.
}.

URL килгәндә: ['юл:'] эшлә: { :юл
	үзенең юл := ['/'] + юл url-кодлау.
}.

URL килгәндә: ['url-параметрлары:'] эшлә: { :туры-китерү
	>> url-параметрлары := Тезмә яңа.
	туры-китерү һәрбер: { :ачкыч :кыйммәт
		url-параметрлары ахырга-өстә: ачкыч текст url-кодлау + ['='] + кыйммәт текст url-кодлау.
	}.
	үзенең url-параметрлары := ['?'] + ( url-параметрлары берләштер: ['&'] ).
}.

URL килгәндә: ['хэш:'] эшлә: { :hash
	үзенең hash := ['#'] + hash url-кодлау.
}.

