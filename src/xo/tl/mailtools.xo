>> Email := Bagay bago.

Email kapag: ['ihanda'] gawin: {
	sarili-ko mga-tatanggap := Listahan bago.
	sarili-ko cc := Listahan bago.
	sarili-ko bcc := Listahan bago.
	sarili-ko nagpadala := Wala.
	sarili-ko pangalan-ng-nagpadala := Wala.
	sarili-ko paksa := Wala.
	sarili-ko katawan := Wala.
}.

Email kapag: ['bago'] gawin: { <- sarili bago ihanda.
}.

Email kapag: ['kay:'] gawin: { :pag-iisa-isa
	sarili-ko mga-tatanggap := pag-iisa-isa.
}.
 
Email kapag: ['cc:'] gawin: { :pag-iisa-isa
	sarili-ko cc := pag-iisa-isa.
}.

Email kapag: ['bcc:'] gawin: { :pag-iisa-isa
	sarili-ko bcc := pag-iisa-isa.
}.

Email kapag: ['paksa:'] gawin: { :paksa
	sarili-ko paksa := paksa.
}.

Email kapag: ['nagpadala:pangalan:'] gawin: { :nagpadala :pangalan
	sarili-ko nagpadala := nagpadala.
	sarili-ko pangalan-ng-nagpadala := pangalan.
}.

Email kapag: ['katawan:'] gawin: { :katawan
	sarili-ko katawan := katawan.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email kapag: ['header:'] gawin: { :linya <- linya palitan: ['\r'] ng: [''], palitan: ['\n'] ng: [''].
}.

Email kapag: ['ipadala'] gawin: {
	>> f := Talaksan tempwrite: sarili bumuo.
	Programa sistema: ['sendmail -t < '] + f landas-ng-file, bagong-linya.
}.

Email kapag: ['bumuo'] gawin: {
	>> putol-linya := ['\r\n'].
	>> string-ng-teksto := [''].
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['From: '] + sarili-ko pangalan-ng-nagpadala + [' <'] + ( sarili-ko nagpadala ) + ['>']) + putol-linya.
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['To: '] + ( sarili-ko mga-tatanggap pagsamahin: [','] )) + putol-linya.
	sarili-ko cc bilangin totoo: {
		string-ng-teksto idagdag-sa-dulo: (sarili header: ['Cc: '] + ( sarili-ko cc pagsamahin: [','] )) + putol-linya.
	}.
	sarili-ko bcc bilangin totoo: {
		string-ng-teksto idagdag-sa-dulo: (sarili header: ['Bcc: '] + ( sarili-ko bcc pagsamahin: [','] )) + putol-linya.
	}.
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['Subject: '] + sarili-ko paksa) + putol-linya.
	string-ng-teksto idagdag-sa-dulo: putol-linya.
	string-ng-teksto idagdag-sa-dulo: sarili-ko katawan.
	string-ng-teksto idagdag-sa-dulo: putol-linya. <- string-ng-teksto.
}.

>> HTML-Email := Email bago.

HTML-Email kapag: ['ihanda'] gawin: {
	sarili ihanda.
	sarili-ko mga-lakip := Listahan bago.
	sarili-ko hangganan := Kaha token: 40.
}.

HTML-Email kapag: ['ilakip:'] gawin: { :file-ng-sesyon
	>> id := sarili-ko mga-lakip bilangin.
	>> blob := file-ng-sesyon blob.
	sarili-ko mga-lakip idagdag-sa-dulo: (
		Diksyunaryo bago
			file-ng-sesyon: file-ng-sesyon landas-ng-file,
			mime: ['image/'] + (Server mimetype: file-ng-sesyon landas-ng-file),
			datos: blob base64-i-encode
	).
	blob palayain. <- ['cid:attachment'] + id.
}.

HTML-Email kapag: ['bumuo'] gawin: {
	>> putol-linya := ['\r\n'].
	>> string-ng-teksto := [''].
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['From: '] + sarili-ko pangalan-ng-nagpadala + [' <'] + ( sarili-ko nagpadala ) + ['>']) + putol-linya.
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['To: '] + ( sarili-ko mga-tatanggap pagsamahin: [','] )) + putol-linya.
	sarili-ko cc bilangin totoo: {
		string-ng-teksto idagdag-sa-dulo: (sarili header: ['Cc: '] + ( sarili-ko cc pagsamahin: [','] )) + putol-linya.
	}.
	sarili-ko bcc bilangin totoo: {
		string-ng-teksto idagdag-sa-dulo: (sarili header: ['Bcc: '] + ( sarili-ko bcc pagsamahin: [','] )) + putol-linya.
	}.
	string-ng-teksto idagdag-sa-dulo: (sarili header: ['Subject: '] + sarili-ko paksa) + putol-linya.
	string-ng-teksto idagdag-sa-dulo: ['MIME-Version: 1.0'] + putol-linya.
	string-ng-teksto idagdag-sa-dulo: ['Content-Type: multipart/related; boundary="'] + sarili-ko hangganan + ['"; type=text/html'] + putol-linya.
	string-ng-teksto idagdag-sa-dulo: putol-linya.
	string-ng-teksto idagdag-sa-dulo: ['--'] + sarili-ko hangganan + putol-linya.
	string-ng-teksto idagdag-sa-dulo: ['Content-Type: text/html; charset=UTF-8'] + putol-linya.
	string-ng-teksto idagdag-sa-dulo: ['Content-Transfer-Encoding: 7bit'] + putol-linya.
	string-ng-teksto idagdag-sa-dulo: putol-linya.
	string-ng-teksto idagdag-sa-dulo: sarili-ko katawan.
	string-ng-teksto idagdag-sa-dulo: putol-linya.
	sarili-ko mga-lakip bawat: { :id :impormasyon
		>> blob := impormasyon datos.
		string-ng-teksto idagdag-sa-dulo: ['--'] + sarili-ko hangganan + putol-linya.
		string-ng-teksto idagdag-sa-dulo: ['Content-Type: '] + impormasyon mime + putol-linya.
		string-ng-teksto idagdag-sa-dulo: ['Content-Transfer-Encoding: base64'] + putol-linya.
		string-ng-teksto idagdag-sa-dulo: ['Content-ID: <attachment'] + id + ['>'] + putol-linya.
		string-ng-teksto idagdag-sa-dulo: ['Content-Disposition: inline; filename="'] + impormasyon file-ng-sesyon + ['"'] + putol-linya.
		string-ng-teksto idagdag-sa-dulo: putol-linya.
		>> pinakamarami := 76.
		>> haba-ng-teksto := blob haba.
		>> mga-piraso := (haba-ng-teksto / pinakamarami) itaas-ang-bilog.
		{ :i
			>> piraso := blob kopyahin mula-sa: i * pinakamarami haba: pinakamarami.
			string-ng-teksto idagdag-sa-dulo: piraso + putol-linya.
		} * mga-piraso.
		string-ng-teksto idagdag-sa-dulo: putol-linya.
		string-ng-teksto idagdag-sa-dulo: putol-linya.
	}.
	string-ng-teksto idagdag-sa-dulo: ['--'] + sarili-ko hangganan + ['--'] + putol-linya. <- string-ng-teksto.
}.
