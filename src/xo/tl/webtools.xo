Kahilingan-HTTP kapag: ['HTTP-header:'] gawin: { :susi <- Programa kaayusan: susi.
}.

>> Header-ng-HTTP := Bagay bago.

Header-ng-HTTP kapag: ['bago'] gawin: { <- sarili bago ihanda.
}.

Header-ng-HTTP kapag: ['ihanda'] gawin: {
	sarili-ko susi := Wala.
	sarili-ko halaga := Wala.
}.

Header-ng-HTTP kapag: ['susi:halaga:'] gawin: { :susi :halaga
	sarili-ko susi := susi.
	sarili-ko halaga := halaga.
}.

Header-ng-HTTP kapag: ['susi'] gawin: { <- sarili-ko susi.
}.

Header-ng-HTTP kapag: ['halaga'] gawin: { <- sarili-ko halaga.
}.


Header-ng-HTTP kapag: ['teksto'] gawin: {
	>> linya := sarili-ko susi + [': '] + sarili-ko halaga.
	linya palitan: ['\r'] ng: [''], palitan: ['\n'] ng: ['']. <- linya + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumentong-Web := Bagay bago.

Dokumentong-Web kapag: ['bago'] gawin: { <- sarili bago ihanda.
}.

Dokumentong-Web kapag: ['ihanda'] gawin: {
	sarili-ko mga-header := Listahan bago.
	sarili-ko id-ng-sesyon := Wala.
	sarili-ko tagapamahala-ng-sesyon := Sesyon-pansamantalang-file bago.
	sarili-ko datos-ng-sesyon := Wala.
	sarili-ko ligtas := Totoo.
	sarili-ko parehong-site := ['Strict'].
	sarili-ko naipadala-ang-header := Mali.
	sarili-ko kahilingang-http := Kahilingan-HTTP bago.
}.

Dokumentong-Web kapag: ['kahilingang-http:'] gawin: { :kahilingang-http
	sarili-ko kahilingang-http := kahilingang-http.
}. 

Dokumentong-Web kapag: ['ligtas-na-cookie-ng-sesyon:'] gawin: { :ligtas
	sarili suriin-ang-header.
	sarili-ko ligtas := ligtas.
}.

Dokumentong-Web kapag: ['cookie-ng-sesyon-parehong-site:'] gawin: { :halaga
	sarili suriin-ang-header.
	>> mga-opsyon := Listahan bago 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	mga-opsyon mayroon: halaga, mali: {
		gawaing-ito mali-sa-labas: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	sarili-ko parehong-site := halaga.
}.

Dokumentong-Web kapag: ['header:'] gawin: { :header
	sarili suriin-ang-header.
	sarili-ko mga-header idagdag-sa-dulo: header.
}.

Dokumentong-Web kapag: ['alisin-ang-header'] gawin: {
	sarili suriin-ang-header.
	sarili-ko mga-header := Listahan bago.
}.

Dokumentong-Web kapag: ['tagapamahala-ng-sesyon:'] gawin: { :tagapamahala
	sarili suriin-ang-header.
	sarili-ko tagapamahala-ng-sesyon := tagapamahala.
}.

Dokumentong-Web kapag: ['tagapamahala-ng-sesyon'] gawin: { <- sarili-ko tagapamahala-ng-sesyon.
}.

Dokumentong-Web kapag: ['suriin-ang-header'] gawin: {
	sarili-ko naipadala-ang-header totoo: {
		gawaing-ito mali-sa-labas: ['Headers already sent to client.'].
	}.
}.

Dokumentong-Web kapag: ['simulan-ang-sesyon'] gawin: {
	sarili suriin-ang-header.
	>> kahilingang-http := sarili-ko kahilingang-http.
	>> id-ng-sesyon := kahilingang-http cookie: ['xsid'].
	id-ng-sesyon Wala? mali: {
		(( Padron bago: ['^[A-Za-z0-9]+\\z'], tugma: id-ng-sesyon ) = 0) totoo: {
			id-ng-sesyon := Wala.
		}.
	}.
	id-ng-sesyon Wala? totoo: {
		id-ng-sesyon := Kaha token: 30.
		>> header-ng-sesyon := Header-ng-HTTP bago
		susi: ['Set-Cookie'] halaga: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (sarili-ko ligtas alinman: ['Secure'] o: ['']),
		SSITE: (sarili-ko parehong-site),
		XSID: id-ng-sesyon
		).
		sarili-ko mga-header idagdag-sa-dulo: header-ng-sesyon.
	}.
	sarili-ko datos-ng-sesyon := sarili-ko tagapamahala-ng-sesyon para-sa: id-ng-sesyon, ikarga. <- sarili-ko datos-ng-sesyon. # reference
}.

Dokumentong-Web kapag: ['pumunta-sa:'] gawin: { :address
	sarili suriin-ang-header.
	sarili alisin-ang-header.
	sarili-ko mga-header
	idagdag-sa-dulo: (
		Header-ng-HTTP bago
		susi: ['Status'] halaga: ['303 See Other']
	),
	idagdag-sa-dulo: (
		Header-ng-HTTP bago
		susi: ['Location'] halaga: address
	).
	sarili ilabas: ['Redirect'].
}.

Dokumentong-Web kapag: ['wasakin-ang-sesyon'] gawin: {
	sarili suriin-ang-header.
	>> kahilingang-http := sarili-ko kahilingang-http.
	>> id-ng-sesyon := kahilingang-http cookie: ['xsid'].
	id-ng-sesyon Wala? mali: {
		>> header-ng-sesyon := Header-ng-HTTP bago.
		>> sandali := Sandali bago taon: 1970, anyo: ['%a, %d %b %Y %H:%M:%S GMT'].
		header-ng-sesyon susi: ['Set-Cookie'] halaga: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: sandali,
			SEC: (sarili-ko ligtas alinman: ['Secure'] o: ['']),
			SSITE: (sarili-ko parehong-site),
			XSID: id-ng-sesyon
		).
		sarili-ko tagapamahala-ng-sesyon wasakin.
		sarili-ko mga-header idagdag-sa-dulo: header-ng-sesyon.
	}.
}.


Dokumentong-Web kapag: ['huwaran:'] gawin: { :landas-ng-file <- Huwaran bago: (Talaksan bago: landas-ng-file, basahin).
}.

Dokumentong-Web kapag: ['ilabas:uri:'] gawin: { :resulta :uri
	sarili-ko naipadala-ang-header mali: {
		sarili-ko datos-ng-sesyon Wala? mali: {
			sarili-ko tagapamahala-ng-sesyon i-save: sarili-ko datos-ng-sesyon.
		}.
		sarili-ko mga-header idagdag-sa-dulo: (
			Header-ng-HTTP bago
			susi: ['Content-type'] halaga: uri
		).
		sarili-ko mga-header bawat: { :_ :header
			Labas isulat: header.
		}.
		sarili-ko naipadala-ang-header := Totoo.
		Labas isulat: ['\r\n'].
	}.
	Labas isulat: resulta.
}.

Dokumentong-Web kapag: ['tapusin:uri:'] gawin: { :resulta :uri
	sarili-ko naipadala-ang-header mali: {
		sarili-ko datos-ng-sesyon Wala? mali: {
			sarili-ko tagapamahala-ng-sesyon i-save: sarili-ko datos-ng-sesyon.
		}.
		sarili-ko mga-header idagdag-sa-dulo: (
			Header-ng-HTTP bago
			susi: ['Content-type'] halaga: uri
		).
		sarili-ko mga-header idagdag-sa-dulo: (
			Header-ng-HTTP bago
			susi: ['Content-Length'] halaga: resulta teksto bytes
		).
		sarili-ko mga-header bawat: { :_ :header
			Labas isulat: header.
		}.
		sarili-ko naipadala-ang-header := Totoo.
		Labas isulat: ['\r\n'].
	}.
	Labas isulat: resulta.
}.

Dokumentong-Web kapag: ['ilabas:'] gawin: { :resulta
	sarili ilabas: resulta uri: ['text/html; charset=utf-8'].
}.

Dokumentong-Web kapag: ['tapusin:'] gawin: { :resulta
	sarili tapusin: resulta uri: ['text/html; charset=utf-8'].
}.

Dokumentong-Web kapag: ['json:'] gawin: { :resulta
	sarili ilabas: ( JSON jsonify: resulta ) uri: ['application/json'].
}.

Dokumentong-Web kapag: ['hindi-nahanap:'] gawin: { :resulta
	sarili alisin-ang-header header: (
		Header-ng-HTTP bago susi: ['Status'] halaga: ['404 Not Found']
	).
	sarili ilabas: resulta.
}.


# Interface

>> Sesyon := Bagay bago.

Sesyon kapag: ['bago'] gawin: { <- sarili bago ihanda para-sa: Wala.
}.

Sesyon kapag: ['para-sa:'] gawin: { :id
	sarili-ko id := id.
}.

Sesyon kapag: ['ikarga'] gawin: {
	gawaing-ito mali-sa-labas: ['Not implemented.'].
}.

Sesyon kapag: ['i-save:'] gawin: {
	gawaing-ito mali-sa-labas: ['Not implemented.'].
}.

Sesyon kapag: ['wasakin'] gawin: {
	gawaing-ito mali-sa-labas: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesyon-pansamantalang-file := Sesyon bago.

Sesyon-pansamantalang-file kapag: ['ihanda'] gawin: {
	sarili-ko simula-ng-landas := ['/tmp/sess-'].
}.

Sesyon-pansamantalang-file kapag: ['unlapi-ng-landas:'] gawin: { :string-ng-teksto
	sarili-ko simula-ng-landas := string-ng-teksto.
}.

Sesyon-pansamantalang-file kapag: ['file-ng-sesyon'] gawin: { <- ( Talaksan bago: ( sarili-ko simula-ng-landas + sarili-ko id + ['.txt'] ) ).
}.

Sesyon-pansamantalang-file kapag: ['ikarga'] gawin: {
	>> file-ng-sesyon := sarili file-ng-sesyon.
	file-ng-sesyon umiiral mali: {
		file-ng-sesyon isulat: (Diksyunaryo bago kodigo).
	}. <- file-ng-sesyon basahin bagay.
}.

Sesyon-pansamantalang-file kapag: ['i-save:'] gawin: { :datos
	>> file-ng-sesyon := sarili file-ng-sesyon.
	file-ng-sesyon umiiral totoo: {
		file-ng-sesyon isulat: datos kodigo.
	}.
}.

Sesyon-pansamantalang-file kapag: ['wasakin'] gawin: {
	>> file-ng-sesyon := sarili file-ng-sesyon.
	file-ng-sesyon umiiral totoo: {
		file-ng-sesyon tanggalin.
	}.
}.


>> URL := Bagay bago.

URL kapag: ['ihanda'] gawin: {
	sarili-ko protokol := ['https://'].
	sarili-ko host := ['localhost'].
	sarili-ko landas-ng-file := [''].
	sarili-ko mga-parameter-ng-url := [''].
	sarili-ko hash := [''].
}.

URL kapag: ['bago'] gawin: { <- sarili bago ihanda.
}.

URL kapag: ['teksto'] gawin: { <- (
	sarili-ko protokol +
	sarili-ko host +
	sarili-ko landas-ng-file +
	sarili-ko mga-parameter-ng-url +
	sarili-ko hash ).
}.

URL kapag: ['protokol:'] gawin: { :protokol
	((Listahan bago ; ['http'] ; ['https']) mayroon: protokol) totoo: {
		sarili-ko protokol := protokol + ['://'].
	}, mali: {
		gawaing-ito mali-sa-labas: ['Invalid protocol'].
	}.
}.

URL kapag: ['host:'] gawin: { :host
	#todo validate according to rfc
	sarili-ko host := host.
}.

URL kapag: ['landas-ng-file:'] gawin: { :landas-ng-file
	sarili-ko landas-ng-file := ['/'] + landas-ng-file url-i-encode.
}.

URL kapag: ['mga-parameter-ng-url:'] gawin: { :pagmamapa
	>> mga-parameter-ng-url := Listahan bago.
	pagmamapa bawat: { :susi :halaga
		mga-parameter-ng-url idagdag-sa-dulo: susi teksto url-i-encode + ['='] + halaga teksto url-i-encode.
	}.
	sarili-ko mga-parameter-ng-url := ['?'] + ( mga-parameter-ng-url pagsamahin: ['&'] ).
}.

URL kapag: ['hash:'] gawin: { :hash
	sarili-ko hash := ['#'] + hash url-i-encode.
}.

