
# ~ Simple template engine ~

>> Huwaran := Bagay bago.

Huwaran kapag: ['bago'] gawin: { <- sarili bago nilalaman: [''].
}.

Huwaran kapag: ['nilalaman:'] gawin: { :nilalaman
	sarili-ko nilalaman := nilalaman. 
}.

Huwaran kapag: ['bago:'] gawin: { :nilalaman <- sarili bago nilalaman: nilalaman.
}.

Huwaran kapag: ['gupitin:'] gawin: { :pananda
	>> pananda-ng-simula := (['<!-- cut:%id% -->'] %id%: pananda).
	>> pananda-ng-dulo := (['<!-- /cut:%id% -->'] %id%: pananda).
	>> mga-parte := sarili-ko nilalaman hatiin: pananda-ng-simula.
	>> unlapi := mga-parte una.
	>> mga-parte2 := mga-parte huli hatiin: pananda-ng-dulo.
	>> hulapi := mga-parte2 huli.
	>> parte := mga-parte2 una.
	>> natitira := unlapi + hulapi.
	sarili-ko nilalaman := natitira. <- Huwaran bago: parte.
	
}.

Huwaran kapag: ['kopyahin'] gawin: { <- sarili bago: sarili teksto kopyahin.
}.
	
Huwaran kapag: ['idikit:sa:'] gawin: { :sipi :id
	>> pananda-ng-pagdikit := (['<!-- paste:%id% -->'] %id%: id).
	sarili-ko nilalaman palitan: pananda-ng-pagdikit ng: ( sipi teksto + pananda-ng-pagdikit ).
}.

Huwaran kapag: ['itakda:halaga:'] gawin: { :puwang :halaga
	sarili-ko nilalaman palitan: ['<!-- slot:'] + puwang + [' -->'] ng: ( Server html-i-encode: halaga ).
}.

Huwaran kapag: ['itakda:html:'] gawin: { :puwang :html
	sarili-ko nilalaman palitan: ['<!-- slot:'] + puwang + [' -->'] ng: html.
}.

Huwaran kapag: ['tumugon:at:'] gawin: { :puwang :halaga
	sarili itakda: (puwang mula-sa: 0 haba: (puwang haba - 1)) halaga: halaga.
}.

Huwaran kapag: ['nl2br'] gawin: {
	sarili-ko nilalaman palitan: ['\n'] ng: ['<br>'].
}.

Huwaran kapag: ['ayusin'] gawin: {
	sarili-ko nilalaman :=
		Padron
		bago: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		tugma: sarili-ko nilalaman
		gawin: { <- ['']. }.
}.

Huwaran kapag: ['ayusin-ang-gupit'] gawin: {
	>> mga-aytem := Listahan bago.
	Padron
	bago: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	tugma: sarili-ko nilalaman
	gawin: { :_ :parte
		mga-aytem idagdag-sa-dulo: parte ? 1.
	}.
	mga-aytem bawat: { :_ :id
		sarili-ko nilalaman :=
			Padron bago: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			tugma: sarili-ko nilalaman
			gawin: { <- ['']. }.
	 }.
}.

Huwaran kapag: ['ayusin-ang-espasyo'] gawin: {
	sarili-ko nilalaman :=
		Padron
		bago: ['\\s*\\n'],
		tugma: sarili-ko nilalaman
		gawin: { <- ['\n']. }.
	sarili-ko nilalaman :=
		Padron
		bago: ['\\n[\\s\\t]+'],
		tugma: sarili-ko nilalaman
		gawin: { <- ['\n']. }.
}.

Huwaran kapag: ['ayusin-lahat'] gawin: {
	sarili ayusin.
	sarili ayusin-ang-gupit.
	sarili ayusin-ang-espasyo.
}.

Huwaran kapag: ['teksto'] gawin: { <- sarili-ko nilalaman.
}.
