>> Імейл := Обʼєкт новий.

Імейл при: ['ініціалізувати'] виконати: {
	свій одержувачі := Список новий.
	свій cc := Список новий.
	свій bcc := Список новий.
	свій відправник := Ніщо.
	свій імʼя-відправника := Ніщо.
	свій тема := Ніщо.
	свій тіло := Ніщо.
}.

Імейл при: ['новий'] виконати: { <- сам новий ініціалізувати.
}.

Імейл при: ['кому:'] виконати: { :перелік
	свій одержувачі := перелік.
}.
 
Імейл при: ['cc:'] виконати: { :перелік
	свій cc := перелік.
}.

Імейл при: ['bcc:'] виконати: { :перелік
	свій bcc := перелік.
}.

Імейл при: ['тема:'] виконати: { :тема
	свій тема := тема.
}.

Імейл при: ['відправник:імʼя:'] виконати: { :відправник :імʼя
	свій відправник := відправник.
	свій імʼя-відправника := імʼя.
}.

Імейл при: ['тіло:'] виконати: { :тіло
	свій тіло := тіло.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Імейл при: ['заголовок:'] виконати: { :лінія <- лінія замінити: ['\r'] на: [''], замінити: ['\n'] на: [''].
}.

Імейл при: ['надіслати'] виконати: {
	>> f := Файл tempwrite: сам згенерувати.
	Програма система: ['sendmail -t < '] + f шлях, новий-рядок.
}.

Імейл при: ['згенерувати'] виконати: {
	>> перенесення := ['\r\n'].
	>> рядок := [''].
	рядок додати-в-кінець: (сам заголовок: ['From: '] + свій імʼя-відправника + [' <'] + ( свій відправник ) + ['>']) + перенесення.
	рядок додати-в-кінець: (сам заголовок: ['To: '] + ( свій одержувачі зʼєднати: [','] )) + перенесення.
	свій cc кількість істина: {
		рядок додати-в-кінець: (сам заголовок: ['Cc: '] + ( свій cc зʼєднати: [','] )) + перенесення.
	}.
	свій bcc кількість істина: {
		рядок додати-в-кінець: (сам заголовок: ['Bcc: '] + ( свій bcc зʼєднати: [','] )) + перенесення.
	}.
	рядок додати-в-кінець: (сам заголовок: ['Subject: '] + свій тема) + перенесення.
	рядок додати-в-кінець: перенесення.
	рядок додати-в-кінець: свій тіло.
	рядок додати-в-кінець: перенесення. <- рядок.
}.

>> HTML-Імейл := Імейл новий.

HTML-Імейл при: ['ініціалізувати'] виконати: {
	сам ініціалізувати.
	свій вкладення := Список новий.
	свій межа := Сховище токен: 40.
}.

HTML-Імейл при: ['прикріпити:'] виконати: { :файл
	>> id := свій вкладення кількість.
	>> blob := файл blob.
	свій вкладення додати-в-кінець: (
		Словник новий
			файл: файл шлях,
			mime: ['image/'] + (Server mimetype: файл шлях),
			дані: blob base64-кодувати
	).
	blob звільнити. <- ['cid:attachment'] + id.
}.

HTML-Імейл при: ['згенерувати'] виконати: {
	>> перенесення := ['\r\n'].
	>> рядок := [''].
	рядок додати-в-кінець: (сам заголовок: ['From: '] + свій імʼя-відправника + [' <'] + ( свій відправник ) + ['>']) + перенесення.
	рядок додати-в-кінець: (сам заголовок: ['To: '] + ( свій одержувачі зʼєднати: [','] )) + перенесення.
	свій cc кількість істина: {
		рядок додати-в-кінець: (сам заголовок: ['Cc: '] + ( свій cc зʼєднати: [','] )) + перенесення.
	}.
	свій bcc кількість істина: {
		рядок додати-в-кінець: (сам заголовок: ['Bcc: '] + ( свій bcc зʼєднати: [','] )) + перенесення.
	}.
	рядок додати-в-кінець: (сам заголовок: ['Subject: '] + свій тема) + перенесення.
	рядок додати-в-кінець: ['MIME-Version: 1.0'] + перенесення.
	рядок додати-в-кінець: ['Content-Type: multipart/related; boundary="'] + свій межа + ['"; type=text/html'] + перенесення.
	рядок додати-в-кінець: перенесення.
	рядок додати-в-кінець: ['--'] + свій межа + перенесення.
	рядок додати-в-кінець: ['Content-Type: text/html; charset=UTF-8'] + перенесення.
	рядок додати-в-кінець: ['Content-Transfer-Encoding: 7bit'] + перенесення.
	рядок додати-в-кінець: перенесення.
	рядок додати-в-кінець: свій тіло.
	рядок додати-в-кінець: перенесення.
	свій вкладення кожен: { :id :інфо
		>> blob := інфо дані.
		рядок додати-в-кінець: ['--'] + свій межа + перенесення.
		рядок додати-в-кінець: ['Content-Type: '] + інфо mime + перенесення.
		рядок додати-в-кінець: ['Content-Transfer-Encoding: base64'] + перенесення.
		рядок додати-в-кінець: ['Content-ID: <attachment'] + id + ['>'] + перенесення.
		рядок додати-в-кінець: ['Content-Disposition: inline; filename="'] + інфо файл + ['"'] + перенесення.
		рядок додати-в-кінець: перенесення.
		>> найбільше := 76.
		>> довжина-тексту := blob довжина.
		>> шматки := (довжина-тексту / найбільше) округлити-вгору.
		{ :i
			>> шматок := blob копіювати від: i * найбільше довжина: найбільше.
			рядок додати-в-кінець: шматок + перенесення.
		} * шматки.
		рядок додати-в-кінець: перенесення.
		рядок додати-в-кінець: перенесення.
	}.
	рядок додати-в-кінець: ['--'] + свій межа + ['--'] + перенесення. <- рядок.
}.
