HTTP-Запит при: ['HTTP-заголовок:'] виконати: { :ключ <- Програма налаштування: ключ.
}.

>> HTTP-Заголовок := Обʼєкт новий.

HTTP-Заголовок при: ['новий'] виконати: { <- сам новий ініціалізувати.
}.

HTTP-Заголовок при: ['ініціалізувати'] виконати: {
	свій ключ := Ніщо.
	свій величина := Ніщо.
}.

HTTP-Заголовок при: ['ключ:величина:'] виконати: { :ключ :величина
	свій ключ := ключ.
	свій величина := величина.
}.

HTTP-Заголовок при: ['ключ'] виконати: { <- свій ключ.
}.

HTTP-Заголовок при: ['величина'] виконати: { <- свій величина.
}.


HTTP-Заголовок при: ['текст'] виконати: {
	>> лінія := свій ключ + [': '] + свій величина.
	лінія замінити: ['\r'] на: [''], замінити: ['\n'] на: ['']. <- лінія + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Обʼєкт новий.

Веб-документ при: ['новий'] виконати: { <- сам новий ініціалізувати.
}.

Веб-документ при: ['ініціалізувати'] виконати: {
	свій заголовки := Список новий.
	свій ід-сесії := Ніщо.
	свій менеджер-сесій := Сесія-тимчасовий-файл новий.
	свій дані-сесії := Ніщо.
	свій захищено := Істина.
	свій той-самий-сайт := ['Strict'].
	свій заголовки-надіслано := Хиба.
	свій http-запит := HTTP-Запит новий.
}.

Веб-документ при: ['http-запит:'] виконати: { :http-запит
	свій http-запит := http-запит.
}. 

Веб-документ при: ['захищений-cookie-сесії:'] виконати: { :захищено
	сам перевірити-заголовки.
	свій захищено := захищено.
}.

Веб-документ при: ['cookie-сесії-same-site:'] виконати: { :величина
	сам перевірити-заголовки.
	>> опції := Список новий 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опції має: величина, хиба: {
		це-завдання помилка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	свій той-самий-сайт := величина.
}.

Веб-документ при: ['заголовок:'] виконати: { :заголовок
	сам перевірити-заголовки.
	свій заголовки додати-в-кінець: заголовок.
}.

Веб-документ при: ['скинути-заголовки'] виконати: {
	сам перевірити-заголовки.
	свій заголовки := Список новий.
}.

Веб-документ при: ['менеджер-сесій:'] виконати: { :менеджер
	сам перевірити-заголовки.
	свій менеджер-сесій := менеджер.
}.

Веб-документ при: ['менеджер-сесій'] виконати: { <- свій менеджер-сесій.
}.

Веб-документ при: ['перевірити-заголовки'] виконати: {
	свій заголовки-надіслано істина: {
		це-завдання помилка: ['Headers already sent to client.'].
	}.
}.

Веб-документ при: ['почати-сесію'] виконати: {
	сам перевірити-заголовки.
	>> http-запит := свій http-запит.
	>> ід-сесії := http-запит cookie: ['xsid'].
	ід-сесії Ніщо? хиба: {
		(( Шаблон новий: ['^[A-Za-z0-9]+\\z'], збіг: ід-сесії ) = 0) істина: {
			ід-сесії := Ніщо.
		}.
	}.
	ід-сесії Ніщо? істина: {
		ід-сесії := Сховище токен: 30.
		>> заголовок-сесії := HTTP-Заголовок новий
		ключ: ['Set-Cookie'] величина: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (свій захищено або: ['Secure'] або: ['']),
		SSITE: (свій той-самий-сайт),
		XSID: ід-сесії
		).
		свій заголовки додати-в-кінець: заголовок-сесії.
	}.
	свій дані-сесії := свій менеджер-сесій для: ід-сесії, завантажити. <- свій дані-сесії. # reference
}.

Веб-документ при: ['перейти-до:'] виконати: { :адреса
	сам перевірити-заголовки.
	сам скинути-заголовки.
	свій заголовки
	додати-в-кінець: (
		HTTP-Заголовок новий
		ключ: ['Status'] величина: ['303 See Other']
	),
	додати-в-кінець: (
		HTTP-Заголовок новий
		ключ: ['Location'] величина: адреса
	).
	сам вивести: ['Redirect'].
}.

Веб-документ при: ['знищити-сесію'] виконати: {
	сам перевірити-заголовки.
	>> http-запит := свій http-запит.
	>> ід-сесії := http-запит cookie: ['xsid'].
	ід-сесії Ніщо? хиба: {
		>> заголовок-сесії := HTTP-Заголовок новий.
		>> момент := Момент новий рік: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		заголовок-сесії ключ: ['Set-Cookie'] величина: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: момент,
			SEC: (свій захищено або: ['Secure'] або: ['']),
			SSITE: (свій той-самий-сайт),
			XSID: ід-сесії
		).
		свій менеджер-сесій знищити.
		свій заголовки додати-в-кінець: заголовок-сесії.
	}.
}.


Веб-документ при: ['заготовка:'] виконати: { :шлях <- Заготовка новий: (Файл новий: шлях, читати).
}.

Веб-документ при: ['вивести:тип:'] виконати: { :вивід :тип
	свій заголовки-надіслано хиба: {
		свій дані-сесії Ніщо? хиба: {
			свій менеджер-сесій зберегти: свій дані-сесії.
		}.
		свій заголовки додати-в-кінець: (
			HTTP-Заголовок новий
			ключ: ['Content-type'] величина: тип
		).
		свій заголовки кожен: { :_ :заголовок
			Вивід написати: заголовок.
		}.
		свій заголовки-надіслано := Істина.
		Вивід написати: ['\r\n'].
	}.
	Вивід написати: вивід.
}.

Веб-документ при: ['завершити:тип:'] виконати: { :вивід :тип
	свій заголовки-надіслано хиба: {
		свій дані-сесії Ніщо? хиба: {
			свій менеджер-сесій зберегти: свій дані-сесії.
		}.
		свій заголовки додати-в-кінець: (
			HTTP-Заголовок новий
			ключ: ['Content-type'] величина: тип
		).
		свій заголовки додати-в-кінець: (
			HTTP-Заголовок новий
			ключ: ['Content-Length'] величина: вивід текст bytes
		).
		свій заголовки кожен: { :_ :заголовок
			Вивід написати: заголовок.
		}.
		свій заголовки-надіслано := Істина.
		Вивід написати: ['\r\n'].
	}.
	Вивід написати: вивід.
}.

Веб-документ при: ['вивести:'] виконати: { :вивід
	сам вивести: вивід тип: ['text/html; charset=utf-8'].
}.

Веб-документ при: ['завершити:'] виконати: { :вивід
	сам завершити: вивід тип: ['text/html; charset=utf-8'].
}.

Веб-документ при: ['json:'] виконати: { :вивід
	сам вивести: ( JSON jsonify: вивід ) тип: ['application/json'].
}.

Веб-документ при: ['не-знайдено:'] виконати: { :вивід
	сам скинути-заголовки заголовок: (
		HTTP-Заголовок новий ключ: ['Status'] величина: ['404 Not Found']
	).
	сам вивести: вивід.
}.


# Interface

>> Сесія := Обʼєкт новий.

Сесія при: ['новий'] виконати: { <- сам новий ініціалізувати для: Ніщо.
}.

Сесія при: ['для:'] виконати: { :id
	свій id := id.
}.

Сесія при: ['завантажити'] виконати: {
	це-завдання помилка: ['Not implemented.'].
}.

Сесія при: ['зберегти:'] виконати: {
	це-завдання помилка: ['Not implemented.'].
}.

Сесія при: ['знищити'] виконати: {
	це-завдання помилка: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сесія-тимчасовий-файл := Сесія новий.

Сесія-тимчасовий-файл при: ['ініціалізувати'] виконати: {
	свій початок-шляху := ['/tmp/sess-'].
}.

Сесія-тимчасовий-файл при: ['префікс-шляху:'] виконати: { :рядок
	свій початок-шляху := рядок.
}.

Сесія-тимчасовий-файл при: ['файл'] виконати: { <- ( Файл новий: ( свій початок-шляху + свій id + ['.txt'] ) ).
}.

Сесія-тимчасовий-файл при: ['завантажити'] виконати: {
	>> файл := сам файл.
	файл існує хиба: {
		файл написати: (Словник новий код).
	}. <- файл читати обʼєкт.
}.

Сесія-тимчасовий-файл при: ['зберегти:'] виконати: { :дані
	>> файл := сам файл.
	файл існує істина: {
		файл написати: дані код.
	}.
}.

Сесія-тимчасовий-файл при: ['знищити'] виконати: {
	>> файл := сам файл.
	файл існує істина: {
		файл видалити.
	}.
}.


>> URL := Обʼєкт новий.

URL при: ['ініціалізувати'] виконати: {
	свій протокол := ['https://'].
	свій хост := ['localhost'].
	свій шлях := [''].
	свій параметри-url := [''].
	свій hash := [''].
}.

URL при: ['новий'] виконати: { <- сам новий ініціалізувати.
}.

URL при: ['текст'] виконати: { <- (
	свій протокол +
	свій хост +
	свій шлях +
	свій параметри-url +
	свій hash ).
}.

URL при: ['протокол:'] виконати: { :протокол
	((Список новий ; ['http'] ; ['https']) має: протокол) істина: {
		свій протокол := протокол + ['://'].
	}, хиба: {
		це-завдання помилка: ['Invalid protocol'].
	}.
}.

URL при: ['хост:'] виконати: { :хост
	#todo validate according to rfc
	свій хост := хост.
}.

URL при: ['шлях:'] виконати: { :шлях
	свій шлях := ['/'] + шлях url-кодувати.
}.

URL при: ['параметри-url:'] виконати: { :відповідність
	>> параметри-url := Список новий.
	відповідність кожен: { :ключ :величина
		параметри-url додати-в-кінець: ключ текст url-кодувати + ['='] + величина текст url-кодувати.
	}.
	свій параметри-url := ['?'] + ( параметри-url зʼєднати: ['&'] ).
}.

URL при: ['хеш:'] виконати: { :hash
	свій hash := ['#'] + hash url-кодувати.
}.

