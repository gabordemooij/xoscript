
# ~ Simple template engine ~

>> Заготовка := Обʼєкт новий.

Заготовка при: ['новий'] виконати: { <- сам новий вміст: [''].
}.

Заготовка при: ['вміст:'] виконати: { :вміст
	свій вміст := вміст. 
}.

Заготовка при: ['новий:'] виконати: { :вміст <- сам новий вміст: вміст.
}.

Заготовка при: ['вирізати:'] виконати: { :маркер
	>> початковий-маркер := (['<!-- cut:%id% -->'] %id%: маркер).
	>> кінцевий-маркер := (['<!-- /cut:%id% -->'] %id%: маркер).
	>> частини := свій вміст розділити: початковий-маркер.
	>> префікс := частини перший.
	>> частини2 := частини останній розділити: кінцевий-маркер.
	>> суфікс := частини2 останній.
	>> частина := частини2 перший.
	>> залишок := префікс + суфікс.
	свій вміст := залишок. <- Заготовка новий: частина.
	
}.

Заготовка при: ['копіювати'] виконати: { <- сам новий: сам текст копіювати.
}.
	
Заготовка при: ['вставити:у:'] виконати: { :фрагмент-html :id
	>> маркер-вставки := (['<!-- paste:%id% -->'] %id%: id).
	свій вміст замінити: маркер-вставки на: ( фрагмент-html текст + маркер-вставки ).
}.

Заготовка при: ['задати:значення:'] виконати: { :слот :величина
	свій вміст замінити: ['<!-- slot:'] + слот + [' -->'] на: ( Server html-кодувати: величина ).
}.

Заготовка при: ['задати:html:'] виконати: { :слот :html
	свій вміст замінити: ['<!-- slot:'] + слот + [' -->'] на: html.
}.

Заготовка при: ['відповісти:і:'] виконати: { :слот :величина
	сам задати: (слот від: 0 довжина: (слот довжина - 1)) значення: величина.
}.

Заготовка при: ['nl2br'] виконати: {
	свій вміст замінити: ['\n'] на: ['<br>'].
}.

Заготовка при: ['підчистити'] виконати: {
	свій вміст :=
		Шаблон
		новий: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		збіг: свій вміст
		виконати: { <- ['']. }.
}.

Заготовка при: ['підчистити-вирізки'] виконати: {
	>> елементи := Список новий.
	Шаблон
	новий: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	збіг: свій вміст
	виконати: { :_ :частина
		елементи додати-в-кінець: частина ? 1.
	}.
	елементи кожен: { :_ :id
		свій вміст :=
			Шаблон новий: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			збіг: свій вміст
			виконати: { <- ['']. }.
	 }.
}.

Заготовка при: ['підчистити-пробіли'] виконати: {
	свій вміст :=
		Шаблон
		новий: ['\\s*\\n'],
		збіг: свій вміст
		виконати: { <- ['\n']. }.
	свій вміст :=
		Шаблон
		новий: ['\\n[\\s\\t]+'],
		збіг: свій вміст
		виконати: { <- ['\n']. }.
}.

Заготовка при: ['підчистити-все'] виконати: {
	сам підчистити.
	сам підчистити-вирізки.
	сам підчистити-пробіли.
}.

Заготовка при: ['текст'] виконати: { <- свій вміст.
}.
