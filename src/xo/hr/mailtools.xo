>> Email := Objekt novi.

Email na: ['inicijaliziraj'] učini: {
	svoj primatelji := Popis novi.
	svoj cc := Popis novi.
	svoj bcc := Popis novi.
	svoj pošiljatelj := Ništa.
	svoj ime-pošiljatelja := Ništa.
	svoj predmet := Ništa.
	svoj tijelo := Ništa.
}.

Email na: ['novi'] učini: { <- sebe novi inicijaliziraj.
}.

Email na: ['prima:'] učini: { :nabrajanje
	svoj primatelji := nabrajanje.
}.
 
Email na: ['cc:'] učini: { :nabrajanje
	svoj cc := nabrajanje.
}.

Email na: ['bcc:'] učini: { :nabrajanje
	svoj bcc := nabrajanje.
}.

Email na: ['predmet:'] učini: { :predmet
	svoj predmet := predmet.
}.

Email na: ['pošiljatelj:naziv:'] učini: { :pošiljatelj :naziv
	svoj pošiljatelj := pošiljatelj.
	svoj ime-pošiljatelja := naziv.
}.

Email na: ['tijelo:'] učini: { :tijelo
	svoj tijelo := tijelo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email na: ['zaglavlje:'] učini: { :redak <- redak zamijeni: ['\r'] s: [''], zamijeni: ['\n'] s: [''].
}.

Email na: ['pošalji'] učini: {
	>> f := Datoteka tempwrite: sebe generiraj.
	Program sustav: ['sendmail -t < '] + f putanja, novi-red.
}.

Email na: ['generiraj'] učini: {
	>> prijelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-kraj: (sebe zaglavlje: ['From: '] + svoj ime-pošiljatelja + [' <'] + ( svoj pošiljatelj ) + ['>']) + prijelom.
	niz dodaj-na-kraj: (sebe zaglavlje: ['To: '] + ( svoj primatelji spoji: [','] )) + prijelom.
	svoj cc broj-elemenata istina: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Cc: '] + ( svoj cc spoji: [','] )) + prijelom.
	}.
	svoj bcc broj-elemenata istina: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Bcc: '] + ( svoj bcc spoji: [','] )) + prijelom.
	}.
	niz dodaj-na-kraj: (sebe zaglavlje: ['Subject: '] + svoj predmet) + prijelom.
	niz dodaj-na-kraj: prijelom.
	niz dodaj-na-kraj: svoj tijelo.
	niz dodaj-na-kraj: prijelom. <- niz.
}.

>> HTML-Email := Email novi.

HTML-Email na: ['inicijaliziraj'] učini: {
	sebe inicijaliziraj.
	svoj privitci := Popis novi.
	svoj granica := Sef token: 40.
}.

HTML-Email na: ['priloži:'] učini: { :datoteka
	>> id := svoj privitci broj-elemenata.
	>> blob := datoteka blob.
	svoj privitci dodaj-na-kraj: (
		Rječnik novi
			datoteka: datoteka putanja,
			mime: ['image/'] + (Server mimetype: datoteka putanja),
			podaci: blob base64-kodiraj
	).
	blob oslobodi. <- ['cid:attachment'] + id.
}.

HTML-Email na: ['generiraj'] učini: {
	>> prijelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-kraj: (sebe zaglavlje: ['From: '] + svoj ime-pošiljatelja + [' <'] + ( svoj pošiljatelj ) + ['>']) + prijelom.
	niz dodaj-na-kraj: (sebe zaglavlje: ['To: '] + ( svoj primatelji spoji: [','] )) + prijelom.
	svoj cc broj-elemenata istina: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Cc: '] + ( svoj cc spoji: [','] )) + prijelom.
	}.
	svoj bcc broj-elemenata istina: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Bcc: '] + ( svoj bcc spoji: [','] )) + prijelom.
	}.
	niz dodaj-na-kraj: (sebe zaglavlje: ['Subject: '] + svoj predmet) + prijelom.
	niz dodaj-na-kraj: ['MIME-Version: 1.0'] + prijelom.
	niz dodaj-na-kraj: ['Content-Type: multipart/related; boundary="'] + svoj granica + ['"; type=text/html'] + prijelom.
	niz dodaj-na-kraj: prijelom.
	niz dodaj-na-kraj: ['--'] + svoj granica + prijelom.
	niz dodaj-na-kraj: ['Content-Type: text/html; charset=UTF-8'] + prijelom.
	niz dodaj-na-kraj: ['Content-Transfer-Encoding: 7bit'] + prijelom.
	niz dodaj-na-kraj: prijelom.
	niz dodaj-na-kraj: svoj tijelo.
	niz dodaj-na-kraj: prijelom.
	svoj privitci svaki: { :id :info
		>> blob := info podaci.
		niz dodaj-na-kraj: ['--'] + svoj granica + prijelom.
		niz dodaj-na-kraj: ['Content-Type: '] + info mime + prijelom.
		niz dodaj-na-kraj: ['Content-Transfer-Encoding: base64'] + prijelom.
		niz dodaj-na-kraj: ['Content-ID: <attachment'] + id + ['>'] + prijelom.
		niz dodaj-na-kraj: ['Content-Disposition: inline; filename="'] + info datoteka + ['"'] + prijelom.
		niz dodaj-na-kraj: prijelom.
		>> najviše := 76.
		>> duljina-teksta := blob duljina.
		>> komadi := (duljina-teksta / najviše) zaokruži-gore.
		{ :i
			>> komad := blob kopiraj od: i * najviše duljina: najviše.
			niz dodaj-na-kraj: komad + prijelom.
		} * komadi.
		niz dodaj-na-kraj: prijelom.
		niz dodaj-na-kraj: prijelom.
	}.
	niz dodaj-na-kraj: ['--'] + svoj granica + ['--'] + prijelom. <- niz.
}.
