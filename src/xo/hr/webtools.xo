HTTP-Zahtjev na: ['HTTP-zaglavlje:'] učini: { :ključ <- Program postavka: ključ.
}.

>> HTTP-Zaglavlje := Objekt novi.

HTTP-Zaglavlje na: ['novi'] učini: { <- sebe novi inicijaliziraj.
}.

HTTP-Zaglavlje na: ['inicijaliziraj'] učini: {
	svoj ključ := Ništa.
	svoj vrijednost := Ništa.
}.

HTTP-Zaglavlje na: ['ključ:vrijednost:'] učini: { :ključ :vrijednost
	svoj ključ := ključ.
	svoj vrijednost := vrijednost.
}.

HTTP-Zaglavlje na: ['ključ'] učini: { <- svoj ključ.
}.

HTTP-Zaglavlje na: ['vrijednost'] učini: { <- svoj vrijednost.
}.


HTTP-Zaglavlje na: ['tekst'] učini: {
	>> redak := svoj ključ + [': '] + svoj vrijednost.
	redak zamijeni: ['\r'] s: [''], zamijeni: ['\n'] s: ['']. <- redak + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-dokument := Objekt novi.

Web-dokument na: ['novi'] učini: { <- sebe novi inicijaliziraj.
}.

Web-dokument na: ['inicijaliziraj'] učini: {
	svoj zaglavlja := Popis novi.
	svoj id-sesije := Ništa.
	svoj upravitelj-sesija := Sesija-privremena-datoteka novi.
	svoj podaci-sesije := Ništa.
	svoj sigurno := Istina.
	svoj isto-mjesto := ['Strict'].
	svoj zaglavlja-poslana := Laž.
	svoj zahtjev := HTTP-Zahtjev novi.
}.

Web-dokument na: ['zahtjev:'] učini: { :zahtjev
	svoj zahtjev := zahtjev.
}. 

Web-dokument na: ['sigurni-kolačić-sesije:'] učini: { :sigurno
	sebe provjeri-zaglavlja.
	svoj sigurno := sigurno.
}.

Web-dokument na: ['kolačić-sesije-isto-mjesto:'] učini: { :vrijednost
	sebe provjeri-zaglavlja.
	>> opcije := Popis novi 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcije ima: vrijednost, laž: {
		ovaj-zadatak pogreška: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	svoj isto-mjesto := vrijednost.
}.

Web-dokument na: ['zaglavlje:'] učini: { :zaglavlje
	sebe provjeri-zaglavlja.
	svoj zaglavlja dodaj-na-kraj: zaglavlje.
}.

Web-dokument na: ['isprazni-zaglavlja'] učini: {
	sebe provjeri-zaglavlja.
	svoj zaglavlja := Popis novi.
}.

Web-dokument na: ['upravitelj-sesija:'] učini: { :upravitelj
	sebe provjeri-zaglavlja.
	svoj upravitelj-sesija := upravitelj.
}.

Web-dokument na: ['upravitelj-sesija'] učini: { <- svoj upravitelj-sesija.
}.

Web-dokument na: ['provjeri-zaglavlja'] učini: {
	svoj zaglavlja-poslana istina: {
		ovaj-zadatak pogreška: ['Headers already sent to client.'].
	}.
}.

Web-dokument na: ['pokreni-sesiju'] učini: {
	sebe provjeri-zaglavlja.
	>> zahtjev := svoj zahtjev.
	>> id-sesije := zahtjev cookie: ['xsid'].
	id-sesije Ništa? laž: {
		(( Uzorak novi: ['^[A-Za-z0-9]+\\z'], podudaranje: id-sesije ) = 0) istina: {
			id-sesije := Ništa.
		}.
	}.
	id-sesije Ništa? istina: {
		id-sesije := Sef token: 30.
		>> zaglavlje-sesije := HTTP-Zaglavlje novi
		ključ: ['Set-Cookie'] vrijednost: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (svoj sigurno ili: ['Secure'] ili: ['']),
		SSITE: (svoj isto-mjesto),
		XSID: id-sesije
		).
		svoj zaglavlja dodaj-na-kraj: zaglavlje-sesije.
	}.
	svoj podaci-sesije := svoj upravitelj-sesija za: id-sesije, učitaj. <- svoj podaci-sesije. # reference
}.

Web-dokument na: ['idi-na:'] učini: { :adresa
	sebe provjeri-zaglavlja.
	sebe isprazni-zaglavlja.
	svoj zaglavlja
	dodaj-na-kraj: (
		HTTP-Zaglavlje novi
		ključ: ['Status'] vrijednost: ['303 See Other']
	),
	dodaj-na-kraj: (
		HTTP-Zaglavlje novi
		ključ: ['Location'] vrijednost: adresa
	).
	sebe ispiši: ['Redirect'].
}.

Web-dokument na: ['uništi-sesiju'] učini: {
	sebe provjeri-zaglavlja.
	>> zahtjev := svoj zahtjev.
	>> id-sesije := zahtjev cookie: ['xsid'].
	id-sesije Ništa? laž: {
		>> zaglavlje-sesije := HTTP-Zaglavlje novi.
		>> trenutak := Trenutak novi godina: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		zaglavlje-sesije ključ: ['Set-Cookie'] vrijednost: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: trenutak,
			SEC: (svoj sigurno ili: ['Secure'] ili: ['']),
			SSITE: (svoj isto-mjesto),
			XSID: id-sesije
		).
		svoj upravitelj-sesija uništi.
		svoj zaglavlja dodaj-na-kraj: zaglavlje-sesije.
	}.
}.


Web-dokument na: ['predložak:'] učini: { :putanja <- Predložak novi: (Datoteka novi: putanja, čitaj).
}.

Web-dokument na: ['ispiši:tip:'] učini: { :izlaz :tip
	svoj zaglavlja-poslana laž: {
		svoj podaci-sesije Ništa? laž: {
			svoj upravitelj-sesija spremi: svoj podaci-sesije.
		}.
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-type'] vrijednost: tip
		).
		svoj zaglavlja svaki: { :_ :zaglavlje
			Izlaz piši: zaglavlje.
		}.
		svoj zaglavlja-poslana := Istina.
		Izlaz piši: ['\r\n'].
	}.
	Izlaz piši: izlaz.
}.

Web-dokument na: ['dovrši:tip:'] učini: { :izlaz :tip
	svoj zaglavlja-poslana laž: {
		svoj podaci-sesije Ništa? laž: {
			svoj upravitelj-sesija spremi: svoj podaci-sesije.
		}.
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-type'] vrijednost: tip
		).
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-Length'] vrijednost: izlaz tekst bytes
		).
		svoj zaglavlja svaki: { :_ :zaglavlje
			Izlaz piši: zaglavlje.
		}.
		svoj zaglavlja-poslana := Istina.
		Izlaz piši: ['\r\n'].
	}.
	Izlaz piši: izlaz.
}.

Web-dokument na: ['ispiši:'] učini: { :izlaz
	sebe ispiši: izlaz tip: ['text/html; charset=utf-8'].
}.

Web-dokument na: ['dovrši:'] učini: { :izlaz
	sebe dovrši: izlaz tip: ['text/html; charset=utf-8'].
}.

Web-dokument na: ['json:'] učini: { :izlaz
	sebe ispiši: ( JSON jsonify: izlaz ) tip: ['application/json'].
}.

Web-dokument na: ['nije-pronađeno:'] učini: { :izlaz
	sebe isprazni-zaglavlja zaglavlje: (
		HTTP-Zaglavlje novi ključ: ['Status'] vrijednost: ['404 Not Found']
	).
	sebe ispiši: izlaz.
}.


# Interface

>> Sesija := Objekt novi.

Sesija na: ['novi'] učini: { <- sebe novi inicijaliziraj za: Ništa.
}.

Sesija na: ['za:'] učini: { :id
	svoj id := id.
}.

Sesija na: ['učitaj'] učini: {
	ovaj-zadatak pogreška: ['Not implemented.'].
}.

Sesija na: ['spremi:'] učini: {
	ovaj-zadatak pogreška: ['Not implemented.'].
}.

Sesija na: ['uništi'] učini: {
	ovaj-zadatak pogreška: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesija-privremena-datoteka := Sesija novi.

Sesija-privremena-datoteka na: ['inicijaliziraj'] učini: {
	svoj početak-putanje := ['/tmp/sess-'].
}.

Sesija-privremena-datoteka na: ['prefiks-putanje:'] učini: { :niz
	svoj početak-putanje := niz.
}.

Sesija-privremena-datoteka na: ['datoteka'] učini: { <- ( Datoteka novi: ( svoj početak-putanje + svoj id + ['.txt'] ) ).
}.

Sesija-privremena-datoteka na: ['učitaj'] učini: {
	>> datoteka := sebe datoteka.
	datoteka postoji laž: {
		datoteka piši: (Rječnik novi kod).
	}. <- datoteka čitaj objekt.
}.

Sesija-privremena-datoteka na: ['spremi:'] učini: { :podaci
	>> datoteka := sebe datoteka.
	datoteka postoji istina: {
		datoteka piši: podaci kod.
	}.
}.

Sesija-privremena-datoteka na: ['uništi'] učini: {
	>> datoteka := sebe datoteka.
	datoteka postoji istina: {
		datoteka izbriši.
	}.
}.


>> URL := Objekt novi.

URL na: ['inicijaliziraj'] učini: {
	svoj protokol := ['https://'].
	svoj domaćin := ['localhost'].
	svoj putanja := [''].
	svoj parametri-url := [''].
	svoj hash := [''].
}.

URL na: ['novi'] učini: { <- sebe novi inicijaliziraj.
}.

URL na: ['tekst'] učini: { <- (
	svoj protokol +
	svoj domaćin +
	svoj putanja +
	svoj parametri-url +
	svoj hash ).
}.

URL na: ['protokol:'] učini: { :protokol
	((Popis novi ; ['http'] ; ['https']) ima: protokol) istina: {
		svoj protokol := protokol + ['://'].
	}, laž: {
		ovaj-zadatak pogreška: ['Invalid protocol'].
	}.
}.

URL na: ['domaćin:'] učini: { :domaćin
	#todo validate according to rfc
	svoj domaćin := domaćin.
}.

URL na: ['putanja:'] učini: { :putanja
	svoj putanja := ['/'] + putanja url-kodiraj.
}.

URL na: ['parametri-url:'] učini: { :preslikavanje
	>> parametri-url := Popis novi.
	preslikavanje svaki: { :ključ :vrijednost
		parametri-url dodaj-na-kraj: ključ tekst url-kodiraj + ['='] + vrijednost tekst url-kodiraj.
	}.
	svoj parametri-url := ['?'] + ( parametri-url spoji: ['&'] ).
}.

URL na: ['sažetak:'] učini: { :hash
	svoj hash := ['#'] + hash url-kodiraj.
}.

