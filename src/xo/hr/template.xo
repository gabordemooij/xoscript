
# ~ Simple template engine ~

>> Predložak := Objekt novi.

Predložak na: ['novi'] učini: { <- sebe novi sadržaj: [''].
}.

Predložak na: ['sadržaj:'] učini: { :sadržaj
	svoj sadržaj := sadržaj. 
}.

Predložak na: ['novi:'] učini: { :sadržaj <- sebe novi sadržaj: sadržaj.
}.

Predložak na: ['izreži:'] učini: { :oznaka
	>> početna-oznaka := (['<!-- cut:%id% -->'] %id%: oznaka).
	>> završna-oznaka := (['<!-- /cut:%id% -->'] %id%: oznaka).
	>> dijelovi := svoj sadržaj podijeli: početna-oznaka.
	>> prefiks := dijelovi prvi.
	>> dijelovi2 := dijelovi posljednji podijeli: završna-oznaka.
	>> sufiks := dijelovi2 posljednji.
	>> dio := dijelovi2 prvi.
	>> ostatak := prefiks + sufiks.
	svoj sadržaj := ostatak. <- Predložak novi: dio.
	
}.

Predložak na: ['kopiraj'] učini: { <- sebe novi: sebe tekst kopiraj.
}.
	
Predložak na: ['zalijepi:na:'] učini: { :isječak :id
	>> oznaka-lijepljenja := (['<!-- paste:%id% -->'] %id%: id).
	svoj sadržaj zamijeni: oznaka-lijepljenja s: ( isječak tekst + oznaka-lijepljenja ).
}.

Predložak na: ['postavi:vrijednost:'] učini: { :utor :vrijednost
	svoj sadržaj zamijeni: ['<!-- slot:'] + utor + [' -->'] s: ( Server html-kodiraj: vrijednost ).
}.

Predložak na: ['postavi:html:'] učini: { :utor :html
	svoj sadržaj zamijeni: ['<!-- slot:'] + utor + [' -->'] s: html.
}.

Predložak na: ['odgovori:i:'] učini: { :utor :vrijednost
	sebe postavi: (utor od: 0 duljina: (utor duljina - 1)) vrijednost: vrijednost.
}.

Predložak na: ['nl2br'] učini: {
	svoj sadržaj zamijeni: ['\n'] s: ['<br>'].
}.

Predložak na: ['očisti'] učini: {
	svoj sadržaj :=
		Uzorak
		novi: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		podudaranje: svoj sadržaj
		učini: { <- ['']. }.
}.

Predložak na: ['očisti-izreze'] učini: {
	>> stavke := Popis novi.
	Uzorak
	novi: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	podudaranje: svoj sadržaj
	učini: { :_ :dio
		stavke dodaj-na-kraj: dio ? 1.
	}.
	stavke svaki: { :_ :id
		svoj sadržaj :=
			Uzorak novi: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			podudaranje: svoj sadržaj
			učini: { <- ['']. }.
	 }.
}.

Predložak na: ['očisti-razmake'] učini: {
	svoj sadržaj :=
		Uzorak
		novi: ['\\s*\\n'],
		podudaranje: svoj sadržaj
		učini: { <- ['\n']. }.
	svoj sadržaj :=
		Uzorak
		novi: ['\\n[\\s\\t]+'],
		podudaranje: svoj sadržaj
		učini: { <- ['\n']. }.
}.

Predložak na: ['očisti-sve'] učini: {
	sebe očisti.
	sebe očisti-izreze.
	sebe očisti-razmake.
}.

Predložak na: ['tekst'] učini: { <- svoj sadržaj.
}.
