
# ~ Simple template engine ~

>> Şablon := Nesne yeni.

Şablon olunca: ['yeni'] yap: { <- kendi yeni içerik: [''].
}.

Şablon olunca: ['içerik:'] yap: { :içerik
	öz içerik := içerik. 
}.

Şablon olunca: ['yeni:'] yap: { :içerik <- kendi yeni içerik: içerik.
}.

Şablon olunca: ['kes:'] yap: { :işaret
	>> başlangıç-işareti := (['<!-- cut:%id% -->'] %id%: işaret).
	>> bitiş-işareti := (['<!-- /cut:%id% -->'] %id%: işaret).
	>> kısımlar := öz içerik böl: başlangıç-işareti.
	>> önek := kısımlar ilk.
	>> kısımlar2 := kısımlar sonuncu böl: bitiş-işareti.
	>> sonek := kısımlar2 sonuncu.
	>> kısım := kısımlar2 ilk.
	>> kalan := önek + sonek.
	öz içerik := kalan. <- Şablon yeni: kısım.
	
}.

Şablon olunca: ['kopyala'] yap: { <- kendi yeni: kendi metin kopyala.
}.
	
Şablon olunca: ['yapıştır:konum:'] yap: { :kesit :id
	>> yapıştırma-işareti := (['<!-- paste:%id% -->'] %id%: id).
	öz içerik değiştir: yapıştırma-işareti yenisi: ( kesit metin + yapıştırma-işareti ).
}.

Şablon olunca: ['ayarla:değer:'] yap: { :yuva :değer
	öz içerik değiştir: ['<!-- slot:'] + yuva + [' -->'] yenisi: ( Server html-kodla: değer ).
}.

Şablon olunca: ['ayarla:html:'] yap: { :yuva :html
	öz içerik değiştir: ['<!-- slot:'] + yuva + [' -->'] yenisi: html.
}.

Şablon olunca: ['yanıtla:ve:'] yap: { :yuva :değer
	kendi ayarla: (yuva başlangıç: 0 uzunluk: (yuva uzunluk - 1)) değer: değer.
}.

Şablon olunca: ['nl2br'] yap: {
	öz içerik değiştir: ['\n'] yenisi: ['<br>'].
}.

Şablon olunca: ['arındır'] yap: {
	öz içerik :=
		Desen
		yeni: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		eşleş: öz içerik
		yap: { <- ['']. }.
}.

Şablon olunca: ['kesimleri-arındır'] yap: {
	>> öğeler := Liste yeni.
	Desen
	yeni: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	eşleş: öz içerik
	yap: { :_ :kısım
		öğeler sona-ekle: kısım ? 1.
	}.
	öğeler her: { :_ :id
		öz içerik :=
			Desen yeni: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			eşleş: öz içerik
			yap: { <- ['']. }.
	 }.
}.

Şablon olunca: ['boşlukları-arındır'] yap: {
	öz içerik :=
		Desen
		yeni: ['\\s*\\n'],
		eşleş: öz içerik
		yap: { <- ['\n']. }.
	öz içerik :=
		Desen
		yeni: ['\\n[\\s\\t]+'],
		eşleş: öz içerik
		yap: { <- ['\n']. }.
}.

Şablon olunca: ['tümünü-arındır'] yap: {
	kendi arındır.
	kendi kesimleri-arındır.
	kendi boşlukları-arındır.
}.

Şablon olunca: ['metin'] yap: { <- öz içerik.
}.
