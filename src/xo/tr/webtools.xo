HTTP-İstek olunca: ['HTTP-başlık:'] yap: { :anahtar <- Program ayar: anahtar.
}.

>> HTTP-Başlığı := Nesne yeni.

HTTP-Başlığı olunca: ['yeni'] yap: { <- kendi yeni hazırla.
}.

HTTP-Başlığı olunca: ['hazırla'] yap: {
	öz anahtar := Hiç.
	öz değer := Hiç.
}.

HTTP-Başlığı olunca: ['anahtar:değer:'] yap: { :anahtar :değer
	öz anahtar := anahtar.
	öz değer := değer.
}.

HTTP-Başlığı olunca: ['anahtar'] yap: { <- öz anahtar.
}.

HTTP-Başlığı olunca: ['değer'] yap: { <- öz değer.
}.


HTTP-Başlığı olunca: ['metin'] yap: {
	>> satır := öz anahtar + [': '] + öz değer.
	satır değiştir: ['\r'] yenisi: [''], değiştir: ['\n'] yenisi: ['']. <- satır + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Belgesi := Nesne yeni.

Web-Belgesi olunca: ['yeni'] yap: { <- kendi yeni hazırla.
}.

Web-Belgesi olunca: ['hazırla'] yap: {
	öz başlıklar := Liste yeni.
	öz oturum-kimliği := Hiç.
	öz oturum-yöneticisi := Geçici-dosya-oturumu yeni.
	öz oturum-verisi := Hiç.
	öz güvenli := Doğru.
	öz aynı-site := ['Strict'].
	öz başlıklar-gönderildi := Yanlış.
	öz istek := HTTP-İstek yeni.
}.

Web-Belgesi olunca: ['istek:'] yap: { :istek
	öz istek := istek.
}. 

Web-Belgesi olunca: ['güvenli-oturum-çerezi:'] yap: { :güvenli
	kendi başlıkları-denetle.
	öz güvenli := güvenli.
}.

Web-Belgesi olunca: ['aynı-site-oturum-çerezi:'] yap: { :değer
	kendi başlıkları-denetle.
	>> seçenekler := Liste yeni 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	seçenekler içerir: değer, yanlış: {
		bu-görev hata: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	öz aynı-site := değer.
}.

Web-Belgesi olunca: ['başlık:'] yap: { :başlık
	kendi başlıkları-denetle.
	öz başlıklar sona-ekle: başlık.
}.

Web-Belgesi olunca: ['başlıkları-boşalt'] yap: {
	kendi başlıkları-denetle.
	öz başlıklar := Liste yeni.
}.

Web-Belgesi olunca: ['oturum-yöneticisi:'] yap: { :yönetici
	kendi başlıkları-denetle.
	öz oturum-yöneticisi := yönetici.
}.

Web-Belgesi olunca: ['oturum-yöneticisi'] yap: { <- öz oturum-yöneticisi.
}.

Web-Belgesi olunca: ['başlıkları-denetle'] yap: {
	öz başlıklar-gönderildi doğru: {
		bu-görev hata: ['Headers already sent to client.'].
	}.
}.

Web-Belgesi olunca: ['oturumu-başlat'] yap: {
	kendi başlıkları-denetle.
	>> istek := öz istek.
	>> oturum-kimliği := istek cookie: ['xsid'].
	oturum-kimliği Hiç? yanlış: {
		(( Desen yeni: ['^[A-Za-z0-9]+\\z'], eşleş: oturum-kimliği ) = 0) doğru: {
			oturum-kimliği := Hiç.
		}.
	}.
	oturum-kimliği Hiç? doğru: {
		oturum-kimliği := Kasa jeton: 30.
		>> oturum-başlığı := HTTP-Başlığı yeni
		anahtar: ['Set-Cookie'] değer: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (öz güvenli ya: ['Secure'] veya: ['']),
		SSITE: (öz aynı-site),
		XSID: oturum-kimliği
		).
		öz başlıklar sona-ekle: oturum-başlığı.
	}.
	öz oturum-verisi := öz oturum-yöneticisi için: oturum-kimliği, yükle. <- öz oturum-verisi. # reference
}.

Web-Belgesi olunca: ['git:'] yap: { :adres
	kendi başlıkları-denetle.
	kendi başlıkları-boşalt.
	öz başlıklar
	sona-ekle: (
		HTTP-Başlığı yeni
		anahtar: ['Status'] değer: ['303 See Other']
	),
	sona-ekle: (
		HTTP-Başlığı yeni
		anahtar: ['Location'] değer: adres
	).
	kendi çıktıla: ['Redirect'].
}.

Web-Belgesi olunca: ['oturumu-yok-et'] yap: {
	kendi başlıkları-denetle.
	>> istek := öz istek.
	>> oturum-kimliği := istek cookie: ['xsid'].
	oturum-kimliği Hiç? yanlış: {
		>> oturum-başlığı := HTTP-Başlığı yeni.
		>> an := An yeni yıl: 1970, biçim: ['%a, %d %b %Y %H:%M:%S GMT'].
		oturum-başlığı anahtar: ['Set-Cookie'] değer: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: an,
			SEC: (öz güvenli ya: ['Secure'] veya: ['']),
			SSITE: (öz aynı-site),
			XSID: oturum-kimliği
		).
		öz oturum-yöneticisi yok-et.
		öz başlıklar sona-ekle: oturum-başlığı.
	}.
}.


Web-Belgesi olunca: ['şablon:'] yap: { :yol <- Şablon yeni: (Dosya yeni: yol, oku).
}.

Web-Belgesi olunca: ['çıktıla:tür:'] yap: { :çıktı :tür
	öz başlıklar-gönderildi yanlış: {
		öz oturum-verisi Hiç? yanlış: {
			öz oturum-yöneticisi kaydet: öz oturum-verisi.
		}.
		öz başlıklar sona-ekle: (
			HTTP-Başlığı yeni
			anahtar: ['Content-type'] değer: tür
		).
		öz başlıklar her: { :_ :başlık
			Çıktı yaz: başlık.
		}.
		öz başlıklar-gönderildi := Doğru.
		Çıktı yaz: ['\r\n'].
	}.
	Çıktı yaz: çıktı.
}.

Web-Belgesi olunca: ['bitir:tür:'] yap: { :çıktı :tür
	öz başlıklar-gönderildi yanlış: {
		öz oturum-verisi Hiç? yanlış: {
			öz oturum-yöneticisi kaydet: öz oturum-verisi.
		}.
		öz başlıklar sona-ekle: (
			HTTP-Başlığı yeni
			anahtar: ['Content-type'] değer: tür
		).
		öz başlıklar sona-ekle: (
			HTTP-Başlığı yeni
			anahtar: ['Content-Length'] değer: çıktı metin bytes
		).
		öz başlıklar her: { :_ :başlık
			Çıktı yaz: başlık.
		}.
		öz başlıklar-gönderildi := Doğru.
		Çıktı yaz: ['\r\n'].
	}.
	Çıktı yaz: çıktı.
}.

Web-Belgesi olunca: ['çıktıla:'] yap: { :çıktı
	kendi çıktıla: çıktı tür: ['text/html; charset=utf-8'].
}.

Web-Belgesi olunca: ['bitir:'] yap: { :çıktı
	kendi bitir: çıktı tür: ['text/html; charset=utf-8'].
}.

Web-Belgesi olunca: ['json:'] yap: { :çıktı
	kendi çıktıla: ( JSON jsonify: çıktı ) tür: ['application/json'].
}.

Web-Belgesi olunca: ['bulunamadı:'] yap: { :çıktı
	kendi başlıkları-boşalt başlık: (
		HTTP-Başlığı yeni anahtar: ['Status'] değer: ['404 Not Found']
	).
	kendi çıktıla: çıktı.
}.


# Interface

>> Oturum := Nesne yeni.

Oturum olunca: ['yeni'] yap: { <- kendi yeni hazırla için: Hiç.
}.

Oturum olunca: ['için:'] yap: { :id
	öz id := id.
}.

Oturum olunca: ['yükle'] yap: {
	bu-görev hata: ['Not implemented.'].
}.

Oturum olunca: ['kaydet:'] yap: {
	bu-görev hata: ['Not implemented.'].
}.

Oturum olunca: ['yok-et'] yap: {
	bu-görev hata: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Geçici-dosya-oturumu := Oturum yeni.

Geçici-dosya-oturumu olunca: ['hazırla'] yap: {
	öz yol-başı := ['/tmp/sess-'].
}.

Geçici-dosya-oturumu olunca: ['yol-öneki:'] yap: { :dizgi
	öz yol-başı := dizgi.
}.

Geçici-dosya-oturumu olunca: ['dosya'] yap: { <- ( Dosya yeni: ( öz yol-başı + öz id + ['.txt'] ) ).
}.

Geçici-dosya-oturumu olunca: ['yükle'] yap: {
	>> dosya := kendi dosya.
	dosya var yanlış: {
		dosya yaz: (Sözlük yeni kod).
	}. <- dosya oku nesne.
}.

Geçici-dosya-oturumu olunca: ['kaydet:'] yap: { :veri
	>> dosya := kendi dosya.
	dosya var doğru: {
		dosya yaz: veri kod.
	}.
}.

Geçici-dosya-oturumu olunca: ['yok-et'] yap: {
	>> dosya := kendi dosya.
	dosya var doğru: {
		dosya sil.
	}.
}.


>> URL := Nesne yeni.

URL olunca: ['hazırla'] yap: {
	öz protokol := ['https://'].
	öz sunucu-adı := ['localhost'].
	öz yol := [''].
	öz url-parametreleri := [''].
	öz hash := [''].
}.

URL olunca: ['yeni'] yap: { <- kendi yeni hazırla.
}.

URL olunca: ['metin'] yap: { <- (
	öz protokol +
	öz sunucu-adı +
	öz yol +
	öz url-parametreleri +
	öz hash ).
}.

URL olunca: ['protokol:'] yap: { :protokol
	((Liste yeni ; ['http'] ; ['https']) içerir: protokol) doğru: {
		öz protokol := protokol + ['://'].
	}, yanlış: {
		bu-görev hata: ['Invalid protocol'].
	}.
}.

URL olunca: ['sunucu-adı:'] yap: { :sunucu-adı
	#todo validate according to rfc
	öz sunucu-adı := sunucu-adı.
}.

URL olunca: ['yol:'] yap: { :yol
	öz yol := ['/'] + yol url-kodla.
}.

URL olunca: ['url-parametreleri:'] yap: { :eşleme
	>> url-parametreleri := Liste yeni.
	eşleme her: { :anahtar :değer
		url-parametreleri sona-ekle: anahtar metin url-kodla + ['='] + değer metin url-kodla.
	}.
	öz url-parametreleri := ['?'] + ( url-parametreleri birleştir: ['&'] ).
}.

URL olunca: ['özet:'] yap: { :hash
	öz hash := ['#'] + hash url-kodla.
}.

