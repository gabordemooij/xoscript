>> Eposta := Nesne yeni.

Eposta olunca: ['hazırla'] yap: {
	öz alıcılar := Liste yeni.
	öz cc := Liste yeni.
	öz bcc := Liste yeni.
	öz gönderen := Hiç.
	öz gönderen-adı := Hiç.
	öz konu := Hiç.
	öz gövde := Hiç.
}.

Eposta olunca: ['yeni'] yap: { <- kendi yeni hazırla.
}.

Eposta olunca: ['alıcı:'] yap: { :döküm
	öz alıcılar := döküm.
}.
 
Eposta olunca: ['cc:'] yap: { :döküm
	öz cc := döküm.
}.

Eposta olunca: ['bcc:'] yap: { :döküm
	öz bcc := döküm.
}.

Eposta olunca: ['konu:'] yap: { :konu
	öz konu := konu.
}.

Eposta olunca: ['gönderen:ad:'] yap: { :gönderen :ad
	öz gönderen := gönderen.
	öz gönderen-adı := ad.
}.

Eposta olunca: ['gövde:'] yap: { :gövde
	öz gövde := gövde.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Eposta olunca: ['başlık:'] yap: { :satır <- satır değiştir: ['\r'] yenisi: [''], değiştir: ['\n'] yenisi: [''].
}.

Eposta olunca: ['gönder'] yap: {
	>> f := Dosya tempwrite: kendi üret.
	Program sistem: ['sendmail -t < '] + f yol, yeni-satır.
}.

Eposta olunca: ['üret'] yap: {
	>> satır-sonu := ['\r\n'].
	>> dizgi := [''].
	dizgi sona-ekle: (kendi başlık: ['From: '] + öz gönderen-adı + [' <'] + ( öz gönderen ) + ['>']) + satır-sonu.
	dizgi sona-ekle: (kendi başlık: ['To: '] + ( öz alıcılar birleştir: [','] )) + satır-sonu.
	öz cc adet doğru: {
		dizgi sona-ekle: (kendi başlık: ['Cc: '] + ( öz cc birleştir: [','] )) + satır-sonu.
	}.
	öz bcc adet doğru: {
		dizgi sona-ekle: (kendi başlık: ['Bcc: '] + ( öz bcc birleştir: [','] )) + satır-sonu.
	}.
	dizgi sona-ekle: (kendi başlık: ['Subject: '] + öz konu) + satır-sonu.
	dizgi sona-ekle: satır-sonu.
	dizgi sona-ekle: öz gövde.
	dizgi sona-ekle: satır-sonu. <- dizgi.
}.

>> HTML-Eposta := Eposta yeni.

HTML-Eposta olunca: ['hazırla'] yap: {
	kendi hazırla.
	öz ekler := Liste yeni.
	öz sınır := Kasa jeton: 40.
}.

HTML-Eposta olunca: ['iliştir:'] yap: { :dosya
	>> id := öz ekler adet.
	>> blob := dosya blob.
	öz ekler sona-ekle: (
		Sözlük yeni
			dosya: dosya yol,
			mime: ['image/'] + (Server mimetype: dosya yol),
			veri: blob base64-kodla
	).
	blob serbest-bırak. <- ['cid:attachment'] + id.
}.

HTML-Eposta olunca: ['üret'] yap: {
	>> satır-sonu := ['\r\n'].
	>> dizgi := [''].
	dizgi sona-ekle: (kendi başlık: ['From: '] + öz gönderen-adı + [' <'] + ( öz gönderen ) + ['>']) + satır-sonu.
	dizgi sona-ekle: (kendi başlık: ['To: '] + ( öz alıcılar birleştir: [','] )) + satır-sonu.
	öz cc adet doğru: {
		dizgi sona-ekle: (kendi başlık: ['Cc: '] + ( öz cc birleştir: [','] )) + satır-sonu.
	}.
	öz bcc adet doğru: {
		dizgi sona-ekle: (kendi başlık: ['Bcc: '] + ( öz bcc birleştir: [','] )) + satır-sonu.
	}.
	dizgi sona-ekle: (kendi başlık: ['Subject: '] + öz konu) + satır-sonu.
	dizgi sona-ekle: ['MIME-Version: 1.0'] + satır-sonu.
	dizgi sona-ekle: ['Content-Type: multipart/related; boundary="'] + öz sınır + ['"; type=text/html'] + satır-sonu.
	dizgi sona-ekle: satır-sonu.
	dizgi sona-ekle: ['--'] + öz sınır + satır-sonu.
	dizgi sona-ekle: ['Content-Type: text/html; charset=UTF-8'] + satır-sonu.
	dizgi sona-ekle: ['Content-Transfer-Encoding: 7bit'] + satır-sonu.
	dizgi sona-ekle: satır-sonu.
	dizgi sona-ekle: öz gövde.
	dizgi sona-ekle: satır-sonu.
	öz ekler her: { :id :bilgi
		>> blob := bilgi veri.
		dizgi sona-ekle: ['--'] + öz sınır + satır-sonu.
		dizgi sona-ekle: ['Content-Type: '] + bilgi mime + satır-sonu.
		dizgi sona-ekle: ['Content-Transfer-Encoding: base64'] + satır-sonu.
		dizgi sona-ekle: ['Content-ID: <attachment'] + id + ['>'] + satır-sonu.
		dizgi sona-ekle: ['Content-Disposition: inline; filename="'] + bilgi dosya + ['"'] + satır-sonu.
		dizgi sona-ekle: satır-sonu.
		>> en-fazla := 76.
		>> metin-uzunluğu := blob uzunluk.
		>> öbekler := (metin-uzunluğu / en-fazla) yukarı-yuvarla.
		{ :i
			>> öbek := blob kopyala başlangıç: i * en-fazla uzunluk: en-fazla.
			dizgi sona-ekle: öbek + satır-sonu.
		} * öbekler.
		dizgi sona-ekle: satır-sonu.
		dizgi sona-ekle: satır-sonu.
	}.
	dizgi sona-ekle: ['--'] + öz sınır + ['--'] + satır-sonu. <- dizgi.
}.
