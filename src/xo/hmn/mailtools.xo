>> Email := Yam-khoom tshiab.

Email thaum-tuaj: ['npaj'] ua: {
	nws-li cov-neeg-txais := Daim-teev tshiab.
	nws-li cc := Daim-teev tshiab.
	nws-li bcc := Daim-teev tshiab.
	nws-li tus-xa := Tsis-muaj-dabtsi.
	nws-li npe-tus-xa := Tsis-muaj-dabtsi.
	nws-li lub-ntsiab := Tsis-muaj-dabtsi.
	nws-li lub-cev := Tsis-muaj-dabtsi.
}.

Email thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab npaj.
}.

Email thaum-tuaj: ['mus-cuag:'] ua: { :kev-teev
	nws-li cov-neeg-txais := kev-teev.
}.
 
Email thaum-tuaj: ['cc:'] ua: { :kev-teev
	nws-li cc := kev-teev.
}.

Email thaum-tuaj: ['bcc:'] ua: { :kev-teev
	nws-li bcc := kev-teev.
}.

Email thaum-tuaj: ['lub-ntsiab:'] ua: { :lub-ntsiab
	nws-li lub-ntsiab := lub-ntsiab.
}.

Email thaum-tuaj: ['tus-xa:npe:'] ua: { :tus-xa :npe
	nws-li tus-xa := tus-xa.
	nws-li npe-tus-xa := npe.
}.

Email thaum-tuaj: ['lub-cev:'] ua: { :lub-cev
	nws-li lub-cev := lub-cev.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email thaum-tuaj: ['taub-hau:'] ua: { :kab <- kab hloov: ['\r'] nrog: [''], hloov: ['\n'] nrog: [''].
}.

Email thaum-tuaj: ['xa'] ua: {
	>> f := Ntaub-ntawv tempwrite: tus-kheej tsim.
	Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['sendmail -t < '] + f txoj-kev-ntaub-ntawv, kab-tshiab.
}.

Email thaum-tuaj: ['tsim'] ua: {
	>> txiav-kab := ['\r\n'].
	>> kab-lus-ntawv := [''].
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['From: '] + nws-li npe-tus-xa + [' <'] + ( nws-li tus-xa ) + ['>']) + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['To: '] + ( nws-li cov-neeg-txais muab-sib-txuas: [','] )) + txiav-kab.
	nws-li cc tus-lej-suav tseeb: {
		kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Cc: '] + ( nws-li cc muab-sib-txuas: [','] )) + txiav-kab.
	}.
	nws-li bcc tus-lej-suav tseeb: {
		kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Bcc: '] + ( nws-li bcc muab-sib-txuas: [','] )) + txiav-kab.
	}.
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Subject: '] + nws-li lub-ntsiab) + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: nws-li lub-cev.
	kab-lus-ntawv ntxiv-tom-kawg: txiav-kab. <- kab-lus-ntawv.
}.

>> HTML-Email := Email tshiab.

HTML-Email thaum-tuaj: ['npaj'] ua: {
	tus-kheej npaj.
	nws-li cov-ntawv-txuas := Daim-teev tshiab.
	nws-li ciam-teb := Lub-thawv-ruaj-ntseg token: 40.
}.

HTML-Email thaum-tuaj: ['txuas-ntxiv:'] ua: { :ntawv-kev-sib-txuas
	>> id := nws-li cov-ntawv-txuas tus-lej-suav.
	>> blob := ntawv-kev-sib-txuas blob.
	nws-li cov-ntawv-txuas ntxiv-tom-kawg: (
		Phau-txhais-lus tshiab
			ntawv-kev-sib-txuas: ntawv-kev-sib-txuas txoj-kev-ntaub-ntawv,
			mime: ['image/'] + (Server mimetype: ntawv-kev-sib-txuas txoj-kev-ntaub-ntawv),
			cov-ntaub-ntawv: blob base64-ua-cim
	).
	blob tso-tawm. <- ['cid:attachment'] + id.
}.

HTML-Email thaum-tuaj: ['tsim'] ua: {
	>> txiav-kab := ['\r\n'].
	>> kab-lus-ntawv := [''].
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['From: '] + nws-li npe-tus-xa + [' <'] + ( nws-li tus-xa ) + ['>']) + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['To: '] + ( nws-li cov-neeg-txais muab-sib-txuas: [','] )) + txiav-kab.
	nws-li cc tus-lej-suav tseeb: {
		kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Cc: '] + ( nws-li cc muab-sib-txuas: [','] )) + txiav-kab.
	}.
	nws-li bcc tus-lej-suav tseeb: {
		kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Bcc: '] + ( nws-li bcc muab-sib-txuas: [','] )) + txiav-kab.
	}.
	kab-lus-ntawv ntxiv-tom-kawg: (tus-kheej taub-hau: ['Subject: '] + nws-li lub-ntsiab) + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: ['MIME-Version: 1.0'] + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: ['Content-Type: multipart/related; boundary="'] + nws-li ciam-teb + ['"; type=text/html'] + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: ['--'] + nws-li ciam-teb + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: ['Content-Type: text/html; charset=UTF-8'] + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: ['Content-Transfer-Encoding: 7bit'] + txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
	kab-lus-ntawv ntxiv-tom-kawg: nws-li lub-cev.
	kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
	nws-li cov-ntawv-txuas txhua: { :id :xov-xwm
		>> blob := xov-xwm cov-ntaub-ntawv.
		kab-lus-ntawv ntxiv-tom-kawg: ['--'] + nws-li ciam-teb + txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: ['Content-Type: '] + xov-xwm mime + txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: ['Content-Transfer-Encoding: base64'] + txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: ['Content-ID: <attachment'] + id + ['>'] + txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: ['Content-Disposition: inline; filename="'] + xov-xwm ntawv-kev-sib-txuas + ['"'] + txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
		>> ntau-tshaj := 76.
		>> ntev-ntawv := blob qhov-ntev.
		>> cov-daim := (ntev-ntawv / ntau-tshaj) puag-ncig-nce.
		{ :i
			>> daim := blob luam los-ntawm: i * ntau-tshaj ntev: ntau-tshaj.
			kab-lus-ntawv ntxiv-tom-kawg: daim + txiav-kab.
		} * cov-daim.
		kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
		kab-lus-ntawv ntxiv-tom-kawg: txiav-kab.
	}.
	kab-lus-ntawv ntxiv-tom-kawg: ['--'] + nws-li ciam-teb + ['--'] + txiav-kab. <- kab-lus-ntawv.
}.
