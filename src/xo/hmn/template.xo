
# ~ Simple template engine ~

>> Qauv-nplooj := Yam-khoom tshiab.

Qauv-nplooj thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab cov-ntsiab: [''].
}.

Qauv-nplooj thaum-tuaj: ['cov-ntsiab:'] ua: { :cov-ntsiab
	nws-li cov-ntsiab := cov-ntsiab. 
}.

Qauv-nplooj thaum-tuaj: ['tshiab:'] ua: { :cov-ntsiab <- tus-kheej tshiab cov-ntsiab: cov-ntsiab.
}.

Qauv-nplooj thaum-tuaj: ['txiav:'] ua: { :cim
	>> cim-pib := (['<!-- cut:%id% -->'] %id%: cim).
	>> cim-kawg := (['<!-- /cut:%id% -->'] %id%: cim).
	>> cov-feem := nws-li cov-ntsiab phua: cim-pib.
	>> ua-ntej := cov-feem thawj-zaug.
	>> cov-feem2 := cov-feem kawg phua: cim-kawg.
	>> tom-qab := cov-feem2 kawg.
	>> feem := cov-feem2 thawj-zaug.
	>> seem := ua-ntej + tom-qab.
	nws-li cov-ntsiab := seem. <- Qauv-nplooj tshiab: feem.
	
}.

Qauv-nplooj thaum-tuaj: ['luam'] ua: { <- tus-kheej tshiab: tus-kheej kab-ntawv luam.
}.
	
Qauv-nplooj thaum-tuaj: ['lo:rau:'] ua: { :ib-nqe :id
	>> cim-lo := (['<!-- paste:%id% -->'] %id%: id).
	nws-li cov-ntsiab hloov: cim-lo nrog: ( ib-nqe kab-ntawv + cim-lo ).
}.

Qauv-nplooj thaum-tuaj: ['teem:tus-nqi:'] ua: { :qhov :nqi
	nws-li cov-ntsiab hloov: ['<!-- slot:'] + qhov + [' -->'] nrog: ( Server html-ua-cim: nqi ).
}.

Qauv-nplooj thaum-tuaj: ['teem:html:'] ua: { :qhov :html
	nws-li cov-ntsiab hloov: ['<!-- slot:'] + qhov + [' -->'] nrog: html.
}.

Qauv-nplooj thaum-tuaj: ['teb:thiab:'] ua: { :qhov :nqi
	tus-kheej teem: (qhov los-ntawm: 0 ntev: (qhov qhov-ntev - 1)) tus-nqi: nqi.
}.

Qauv-nplooj thaum-tuaj: ['nl2br'] ua: {
	nws-li cov-ntsiab hloov: ['\n'] nrog: ['<br>'].
}.

Qauv-nplooj thaum-tuaj: ['ntxuav'] ua: {
	nws-li cov-ntsiab :=
		Qauv-nrhiav
		tshiab: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		sib-phim: nws-li cov-ntsiab
		ua: { <- ['']. }.
}.

Qauv-nplooj thaum-tuaj: ['ntxuav-cov-txiav'] ua: {
	>> cov-khoom := Daim-teev tshiab.
	Qauv-nrhiav
	tshiab: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	sib-phim: nws-li cov-ntsiab
	ua: { :_ :feem
		cov-khoom ntxiv-tom-kawg: feem ? 1.
	}.
	cov-khoom txhua: { :_ :id
		nws-li cov-ntsiab :=
			Qauv-nrhiav tshiab: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			sib-phim: nws-li cov-ntsiab
			ua: { <- ['']. }.
	 }.
}.

Qauv-nplooj thaum-tuaj: ['ntxuav-qhov-chaw'] ua: {
	nws-li cov-ntsiab :=
		Qauv-nrhiav
		tshiab: ['\\s*\\n'],
		sib-phim: nws-li cov-ntsiab
		ua: { <- ['\n']. }.
	nws-li cov-ntsiab :=
		Qauv-nrhiav
		tshiab: ['\\n[\\s\\t]+'],
		sib-phim: nws-li cov-ntsiab
		ua: { <- ['\n']. }.
}.

Qauv-nplooj thaum-tuaj: ['ntxuav-tag-nrho'] ua: {
	tus-kheej ntxuav.
	tus-kheej ntxuav-cov-txiav.
	tus-kheej ntxuav-qhov-chaw.
}.

Qauv-nplooj thaum-tuaj: ['kab-ntawv'] ua: { <- nws-li cov-ntsiab.
}.
