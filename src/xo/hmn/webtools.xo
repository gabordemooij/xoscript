Kev-thov-HTTP thaum-tuaj: ['HTTP-taub-hau:'] ua: { :yuam-sij <- Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: yuam-sij.
}.

>> Taub-hau-HTTP := Yam-khoom tshiab.

Taub-hau-HTTP thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab npaj.
}.

Taub-hau-HTTP thaum-tuaj: ['npaj'] ua: {
	nws-li yuam-sij := Tsis-muaj-dabtsi.
	nws-li nqi := Tsis-muaj-dabtsi.
}.

Taub-hau-HTTP thaum-tuaj: ['yuam-sij:nqi:'] ua: { :yuam-sij :nqi
	nws-li yuam-sij := yuam-sij.
	nws-li nqi := nqi.
}.

Taub-hau-HTTP thaum-tuaj: ['yuam-sij'] ua: { <- nws-li yuam-sij.
}.

Taub-hau-HTTP thaum-tuaj: ['nqi'] ua: { <- nws-li nqi.
}.


Taub-hau-HTTP thaum-tuaj: ['kab-ntawv'] ua: {
	>> kab := nws-li yuam-sij + [': '] + nws-li nqi.
	kab hloov: ['\r'] nrog: [''], hloov: ['\n'] nrog: ['']. <- kab + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Ntaub-ntawv-Web := Yam-khoom tshiab.

Ntaub-ntawv-Web thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab npaj.
}.

Ntaub-ntawv-Web thaum-tuaj: ['npaj'] ua: {
	nws-li cov-taub-hau := Daim-teev tshiab.
	nws-li id-kev-sib-txuas := Tsis-muaj-dabtsi.
	nws-li tus-tswj-kev-sib-txuas := Kev-sib-txuas-ntaub-ntawv-ib-ntus tshiab.
	nws-li ntaub-ntawv-kev-sib-txuas := Tsis-muaj-dabtsi.
	nws-li ruaj-ntseg := Tseeb.
	nws-li tib-lub-vev-xaib := ['Strict'].
	nws-li taub-hau-xa-lawm := Cuav.
	nws-li kev-thov-http := Kev-thov-HTTP tshiab.
}.

Ntaub-ntawv-Web thaum-tuaj: ['kev-thov-http:'] ua: { :kev-thov-http
	nws-li kev-thov-http := kev-thov-http.
}. 

Ntaub-ntawv-Web thaum-tuaj: ['ncuav-kev-sib-txuas-ruaj-ntseg:'] ua: { :ruaj-ntseg
	tus-kheej kuaj-taub-hau.
	nws-li ruaj-ntseg := ruaj-ntseg.
}.

Ntaub-ntawv-Web thaum-tuaj: ['ncuav-kev-sib-txuas-tib-lub-vev-xaib:'] ua: { :nqi
	tus-kheej kuaj-taub-hau.
	>> kev-xaiv := Daim-teev tshiab 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	kev-xaiv muaj-nyob-hauv: nqi, cuav: {
		txoj-haujlwm-no yuam-kev: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	nws-li tib-lub-vev-xaib := nqi.
}.

Ntaub-ntawv-Web thaum-tuaj: ['taub-hau:'] ua: { :taub-hau
	tus-kheej kuaj-taub-hau.
	nws-li cov-taub-hau ntxiv-tom-kawg: taub-hau.
}.

Ntaub-ntawv-Web thaum-tuaj: ['tshem-taub-hau'] ua: {
	tus-kheej kuaj-taub-hau.
	nws-li cov-taub-hau := Daim-teev tshiab.
}.

Ntaub-ntawv-Web thaum-tuaj: ['tus-tswj-kev-sib-txuas:'] ua: { :tus-tswj
	tus-kheej kuaj-taub-hau.
	nws-li tus-tswj-kev-sib-txuas := tus-tswj.
}.

Ntaub-ntawv-Web thaum-tuaj: ['tus-tswj-kev-sib-txuas'] ua: { <- nws-li tus-tswj-kev-sib-txuas.
}.

Ntaub-ntawv-Web thaum-tuaj: ['kuaj-taub-hau'] ua: {
	nws-li taub-hau-xa-lawm tseeb: {
		txoj-haujlwm-no yuam-kev: ['Headers already sent to client.'].
	}.
}.

Ntaub-ntawv-Web thaum-tuaj: ['pib-kev-sib-txuas'] ua: {
	tus-kheej kuaj-taub-hau.
	>> kev-thov-http := nws-li kev-thov-http.
	>> id-kev-sib-txuas := kev-thov-http cookie: ['xsid'].
	id-kev-sib-txuas Tsis-muaj-dabtsi? cuav: {
		(( Qauv-nrhiav tshiab: ['^[A-Za-z0-9]+\\z'], sib-phim: id-kev-sib-txuas ) = 0) tseeb: {
			id-kev-sib-txuas := Tsis-muaj-dabtsi.
		}.
	}.
	id-kev-sib-txuas Tsis-muaj-dabtsi? tseeb: {
		id-kev-sib-txuas := Lub-thawv-ruaj-ntseg token: 30.
		>> taub-hau-kev-sib-txuas := Taub-hau-HTTP tshiab
		yuam-sij: ['Set-Cookie'] nqi: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (nws-li ruaj-ntseg qhov-no: ['Secure'] lossis-qhov-ntawd: ['']),
		SSITE: (nws-li tib-lub-vev-xaib),
		XSID: id-kev-sib-txuas
		).
		nws-li cov-taub-hau ntxiv-tom-kawg: taub-hau-kev-sib-txuas.
	}.
	nws-li ntaub-ntawv-kev-sib-txuas := nws-li tus-tswj-kev-sib-txuas rau: id-kev-sib-txuas, thauj. <- nws-li ntaub-ntawv-kev-sib-txuas. # reference
}.

Ntaub-ntawv-Web thaum-tuaj: ['mus-rau:'] ua: { :chaw-nyob
	tus-kheej kuaj-taub-hau.
	tus-kheej tshem-taub-hau.
	nws-li cov-taub-hau
	ntxiv-tom-kawg: (
		Taub-hau-HTTP tshiab
		yuam-sij: ['Status'] nqi: ['303 See Other']
	),
	ntxiv-tom-kawg: (
		Taub-hau-HTTP tshiab
		yuam-sij: ['Location'] nqi: chaw-nyob
	).
	tus-kheej tso-tawm: ['Redirect'].
}.

Ntaub-ntawv-Web thaum-tuaj: ['rhuav-kev-sib-txuas'] ua: {
	tus-kheej kuaj-taub-hau.
	>> kev-thov-http := nws-li kev-thov-http.
	>> id-kev-sib-txuas := kev-thov-http cookie: ['xsid'].
	id-kev-sib-txuas Tsis-muaj-dabtsi? cuav: {
		>> taub-hau-kev-sib-txuas := Taub-hau-HTTP tshiab.
		>> lub-sij-hawm-tag := Lub-sijhawm tshiab xyoo: 1970, hom-ntawv: ['%a, %d %b %Y %H:%M:%S GMT'].
		taub-hau-kev-sib-txuas yuam-sij: ['Set-Cookie'] nqi: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: lub-sij-hawm-tag,
			SEC: (nws-li ruaj-ntseg qhov-no: ['Secure'] lossis-qhov-ntawd: ['']),
			SSITE: (nws-li tib-lub-vev-xaib),
			XSID: id-kev-sib-txuas
		).
		nws-li tus-tswj-kev-sib-txuas rhuav-tshem.
		nws-li cov-taub-hau ntxiv-tom-kawg: taub-hau-kev-sib-txuas.
	}.
}.


Ntaub-ntawv-Web thaum-tuaj: ['qauv-nplooj:'] ua: { :txoj-kev-ntaub-ntawv <- Qauv-nplooj tshiab: (Ntaub-ntawv tshiab: txoj-kev-ntaub-ntawv, nyeem).
}.

Ntaub-ntawv-Web thaum-tuaj: ['tso-tawm:hom:'] ua: { :qhov-tshwm :hom
	nws-li taub-hau-xa-lawm cuav: {
		nws-li ntaub-ntawv-kev-sib-txuas Tsis-muaj-dabtsi? cuav: {
			nws-li tus-tswj-kev-sib-txuas txuag: nws-li ntaub-ntawv-kev-sib-txuas.
		}.
		nws-li cov-taub-hau ntxiv-tom-kawg: (
			Taub-hau-HTTP tshiab
			yuam-sij: ['Content-type'] nqi: hom
		).
		nws-li cov-taub-hau txhua: { :_ :taub-hau
			Tawm sau-ntawv: taub-hau.
		}.
		nws-li taub-hau-xa-lawm := Tseeb.
		Tawm sau-ntawv: ['\r\n'].
	}.
	Tawm sau-ntawv: qhov-tshwm.
}.

Ntaub-ntawv-Web thaum-tuaj: ['ua-tiav:hom:'] ua: { :qhov-tshwm :hom
	nws-li taub-hau-xa-lawm cuav: {
		nws-li ntaub-ntawv-kev-sib-txuas Tsis-muaj-dabtsi? cuav: {
			nws-li tus-tswj-kev-sib-txuas txuag: nws-li ntaub-ntawv-kev-sib-txuas.
		}.
		nws-li cov-taub-hau ntxiv-tom-kawg: (
			Taub-hau-HTTP tshiab
			yuam-sij: ['Content-type'] nqi: hom
		).
		nws-li cov-taub-hau ntxiv-tom-kawg: (
			Taub-hau-HTTP tshiab
			yuam-sij: ['Content-Length'] nqi: qhov-tshwm kab-ntawv bytes
		).
		nws-li cov-taub-hau txhua: { :_ :taub-hau
			Tawm sau-ntawv: taub-hau.
		}.
		nws-li taub-hau-xa-lawm := Tseeb.
		Tawm sau-ntawv: ['\r\n'].
	}.
	Tawm sau-ntawv: qhov-tshwm.
}.

Ntaub-ntawv-Web thaum-tuaj: ['tso-tawm:'] ua: { :qhov-tshwm
	tus-kheej tso-tawm: qhov-tshwm hom: ['text/html; charset=utf-8'].
}.

Ntaub-ntawv-Web thaum-tuaj: ['ua-tiav:'] ua: { :qhov-tshwm
	tus-kheej ua-tiav: qhov-tshwm hom: ['text/html; charset=utf-8'].
}.

Ntaub-ntawv-Web thaum-tuaj: ['json:'] ua: { :qhov-tshwm
	tus-kheej tso-tawm: ( JSON jsonify: qhov-tshwm ) hom: ['application/json'].
}.

Ntaub-ntawv-Web thaum-tuaj: ['nrhiav-tsis-tau:'] ua: { :qhov-tshwm
	tus-kheej tshem-taub-hau taub-hau: (
		Taub-hau-HTTP tshiab yuam-sij: ['Status'] nqi: ['404 Not Found']
	).
	tus-kheej tso-tawm: qhov-tshwm.
}.


# Interface

>> Kev-sib-txuas := Yam-khoom tshiab.

Kev-sib-txuas thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab npaj rau: Tsis-muaj-dabtsi.
}.

Kev-sib-txuas thaum-tuaj: ['rau:'] ua: { :id
	nws-li id := id.
}.

Kev-sib-txuas thaum-tuaj: ['thauj'] ua: {
	txoj-haujlwm-no yuam-kev: ['Not implemented.'].
}.

Kev-sib-txuas thaum-tuaj: ['txuag:'] ua: {
	txoj-haujlwm-no yuam-kev: ['Not implemented.'].
}.

Kev-sib-txuas thaum-tuaj: ['rhuav-tshem'] ua: {
	txoj-haujlwm-no yuam-kev: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Kev-sib-txuas-ntaub-ntawv-ib-ntus := Kev-sib-txuas tshiab.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['npaj'] ua: {
	nws-li pib-txoj-kev := ['/tmp/sess-'].
}.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['ua-ntej-txoj-kev:'] ua: { :kab-lus-ntawv
	nws-li pib-txoj-kev := kab-lus-ntawv.
}.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['ntawv-kev-sib-txuas'] ua: { <- ( Ntaub-ntawv tshiab: ( nws-li pib-txoj-kev + nws-li id + ['.txt'] ) ).
}.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['thauj'] ua: {
	>> ntawv-kev-sib-txuas := tus-kheej ntawv-kev-sib-txuas.
	ntawv-kev-sib-txuas muaj-nyob cuav: {
		ntawv-kev-sib-txuas sau-ntawv: (Phau-txhais-lus tshiab cim-khoos-phis-tawj).
	}. <- ntawv-kev-sib-txuas nyeem yam-khoom.
}.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['txuag:'] ua: { :cov-ntaub-ntawv
	>> ntawv-kev-sib-txuas := tus-kheej ntawv-kev-sib-txuas.
	ntawv-kev-sib-txuas muaj-nyob tseeb: {
		ntawv-kev-sib-txuas sau-ntawv: cov-ntaub-ntawv cim-khoos-phis-tawj.
	}.
}.

Kev-sib-txuas-ntaub-ntawv-ib-ntus thaum-tuaj: ['rhuav-tshem'] ua: {
	>> ntawv-kev-sib-txuas := tus-kheej ntawv-kev-sib-txuas.
	ntawv-kev-sib-txuas muaj-nyob tseeb: {
		ntawv-kev-sib-txuas rho-tawm.
	}.
}.


>> URL := Yam-khoom tshiab.

URL thaum-tuaj: ['npaj'] ua: {
	nws-li txheej-txheem := ['https://'].
	nws-li tus-tswv-tsev := ['localhost'].
	nws-li txoj-kev-ntaub-ntawv := [''].
	nws-li cov-ntsuas-url := [''].
	nws-li hash := [''].
}.

URL thaum-tuaj: ['tshiab'] ua: { <- tus-kheej tshiab npaj.
}.

URL thaum-tuaj: ['kab-ntawv'] ua: { <- (
	nws-li txheej-txheem +
	nws-li tus-tswv-tsev +
	nws-li txoj-kev-ntaub-ntawv +
	nws-li cov-ntsuas-url +
	nws-li hash ).
}.

URL thaum-tuaj: ['txheej-txheem:'] ua: { :txheej-txheem
	((Daim-teev tshiab ; ['http'] ; ['https']) muaj-nyob-hauv: txheej-txheem) tseeb: {
		nws-li txheej-txheem := txheej-txheem + ['://'].
	}, cuav: {
		txoj-haujlwm-no yuam-kev: ['Invalid protocol'].
	}.
}.

URL thaum-tuaj: ['tus-tswv-tsev:'] ua: { :tus-tswv-tsev
	#todo validate according to rfc
	nws-li tus-tswv-tsev := tus-tswv-tsev.
}.

URL thaum-tuaj: ['txoj-kev-ntaub-ntawv:'] ua: { :txoj-kev-ntaub-ntawv
	nws-li txoj-kev-ntaub-ntawv := ['/'] + txoj-kev-ntaub-ntawv url-ua-cim.
}.

URL thaum-tuaj: ['cov-ntsuas-url:'] ua: { :kev-sib-piv
	>> cov-ntsuas-url := Daim-teev tshiab.
	kev-sib-piv txhua: { :yuam-sij :nqi
		cov-ntsuas-url ntxiv-tom-kawg: yuam-sij kab-ntawv url-ua-cim + ['='] + nqi kab-ntawv url-ua-cim.
	}.
	nws-li cov-ntsuas-url := ['?'] + ( cov-ntsuas-url muab-sib-txuas: ['&'] ).
}.

URL thaum-tuaj: ['hash:'] ua: { :hash
	nws-li hash := ['#'] + hash url-ua-cim.
}.

