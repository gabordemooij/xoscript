>> Email := Ikintu gishya.

Email bigeze: ['init'] kora: {
	icyacyo recipients := Urutonde gishya.
	icyacyo cc := Urutonde gishya.
	icyacyo bcc := Urutonde gishya.
	icyacyo from := Ntacyo.
	icyacyo from-name := Ntacyo.
	icyacyo subject := Ntacyo.
	icyacyo body := Ntacyo.
}.

Email bigeze: ['gishya'] kora: { <- ubwacyo gishya init.
}.

Email bigeze: ['to:'] kora: { :list
	icyacyo recipients := list.
}.
 
Email bigeze: ['cc:'] kora: { :list
	icyacyo cc := list.
}.

Email bigeze: ['bcc:'] kora: { :list
	icyacyo bcc := list.
}.

Email bigeze: ['subject:'] kora: { :subject
	icyacyo subject := subject.
}.

Email bigeze: ['from:name:'] kora: { :from :izina
	icyacyo from := from.
	icyacyo from-name := izina.
}.

Email bigeze: ['body:'] kora: { :body
	icyacyo body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email bigeze: ['header:'] kora: { :line <- line simbuza: ['\r'] na: [''], simbuza: ['\n'] na: [''].
}.

Email bigeze: ['send'] kora: {
	>> f := Dosiye tempwrite: ubwacyo generate.
	Gahunda sisitemu: ['sendmail -t < '] + f inzira-ya-dosiye, umurongo-mushya.
}.

Email bigeze: ['generate'] kora: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ongera-ku-mpera: (ubwacyo header: ['From: '] + icyacyo from-name + [' <'] + ( icyacyo from ) + ['>']) + brk.
	str ongera-ku-mpera: (ubwacyo header: ['To: '] + ( icyacyo recipients huza: [','] )) + brk.
	icyacyo cc umubare-wibintu ukuri: {
		str ongera-ku-mpera: (ubwacyo header: ['Cc: '] + ( icyacyo cc huza: [','] )) + brk.
	}.
	icyacyo bcc umubare-wibintu ukuri: {
		str ongera-ku-mpera: (ubwacyo header: ['Bcc: '] + ( icyacyo bcc huza: [','] )) + brk.
	}.
	str ongera-ku-mpera: (ubwacyo header: ['Subject: '] + icyacyo subject) + brk.
	str ongera-ku-mpera: brk.
	str ongera-ku-mpera: icyacyo body.
	str ongera-ku-mpera: brk. <- str.
}.

>> HTML-Email := Email gishya.

HTML-Email bigeze: ['init'] kora: {
	ubwacyo init.
	icyacyo attachments := Urutonde gishya.
	icyacyo boundary := Isanduku-yumutekano token: 40.
}.

HTML-Email bigeze: ['attach:'] kora: { :file
	>> id := icyacyo attachments umubare-wibintu.
	>> blob := file blob.
	icyacyo attachments ongera-ku-mpera: (
		Inkoranyamagambo gishya
			file: file inzira-ya-dosiye,
			mime: ['image/'] + (Server mimetype: file inzira-ya-dosiye),
			data: blob base64-shyira-kode
	).
	blob rekura. <- ['cid:attachment'] + id.
}.

HTML-Email bigeze: ['generate'] kora: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ongera-ku-mpera: (ubwacyo header: ['From: '] + icyacyo from-name + [' <'] + ( icyacyo from ) + ['>']) + brk.
	str ongera-ku-mpera: (ubwacyo header: ['To: '] + ( icyacyo recipients huza: [','] )) + brk.
	icyacyo cc umubare-wibintu ukuri: {
		str ongera-ku-mpera: (ubwacyo header: ['Cc: '] + ( icyacyo cc huza: [','] )) + brk.
	}.
	icyacyo bcc umubare-wibintu ukuri: {
		str ongera-ku-mpera: (ubwacyo header: ['Bcc: '] + ( icyacyo bcc huza: [','] )) + brk.
	}.
	str ongera-ku-mpera: (ubwacyo header: ['Subject: '] + icyacyo subject) + brk.
	str ongera-ku-mpera: ['MIME-Version: 1.0'] + brk.
	str ongera-ku-mpera: ['Content-Type: multipart/related; boundary="'] + icyacyo boundary + ['"; type=text/html'] + brk.
	str ongera-ku-mpera: brk.
	str ongera-ku-mpera: ['--'] + icyacyo boundary + brk.
	str ongera-ku-mpera: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str ongera-ku-mpera: ['Content-Transfer-Encoding: 7bit'] + brk.
	str ongera-ku-mpera: brk.
	str ongera-ku-mpera: icyacyo body.
	str ongera-ku-mpera: brk.
	icyacyo attachments buri: { :id :info
		>> blob := info data.
		str ongera-ku-mpera: ['--'] + icyacyo boundary + brk.
		str ongera-ku-mpera: ['Content-Type: '] + info mime + brk.
		str ongera-ku-mpera: ['Content-Transfer-Encoding: base64'] + brk.
		str ongera-ku-mpera: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str ongera-ku-mpera: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str ongera-ku-mpera: brk.
		>> max := 76.
		>> len := blob uburebure.
		>> chunks := (len / max) zamura-umubare.
		{ :i
			>> chunk := blob koporora kuva: i * max uburebure: max.
			str ongera-ku-mpera: chunk + brk.
		} * chunks.
		str ongera-ku-mpera: brk.
		str ongera-ku-mpera: brk.
	}.
	str ongera-ku-mpera: ['--'] + icyacyo boundary + ['--'] + brk. <- str.
}.
