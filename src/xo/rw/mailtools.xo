>> Imeyili := Ikintu gishya.

Imeyili bigeze: ['tegura'] kora: {
	icyacyo abakira := Urutonde gishya.
	icyacyo cc := Urutonde gishya.
	icyacyo bcc := Urutonde gishya.
	icyacyo uwohereje := Ntacyo.
	icyacyo izina-ry-uwohereje := Ntacyo.
	icyacyo insanganyamatsiko := Ntacyo.
	icyacyo umubiri := Ntacyo.
}.

Imeyili bigeze: ['gishya'] kora: { <- ubwacyo gishya tegura.
}.

Imeyili bigeze: ['kuri:'] kora: { :urutonde-rw-ibintu
	icyacyo abakira := urutonde-rw-ibintu.
}.
 
Imeyili bigeze: ['cc:'] kora: { :urutonde-rw-ibintu
	icyacyo cc := urutonde-rw-ibintu.
}.

Imeyili bigeze: ['bcc:'] kora: { :urutonde-rw-ibintu
	icyacyo bcc := urutonde-rw-ibintu.
}.

Imeyili bigeze: ['insanganyamatsiko:'] kora: { :insanganyamatsiko
	icyacyo insanganyamatsiko := insanganyamatsiko.
}.

Imeyili bigeze: ['uwohereje:izina:'] kora: { :uwohereje :izina
	icyacyo uwohereje := uwohereje.
	icyacyo izina-ry-uwohereje := izina.
}.

Imeyili bigeze: ['umubiri:'] kora: { :umubiri
	icyacyo umubiri := umubiri.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeyili bigeze: ['umutwe:'] kora: { :umurongo <- umurongo simbuza: ['\r'] na: [''], simbuza: ['\n'] na: [''].
}.

Imeyili bigeze: ['ohereza'] kora: {
	>> f := Dosiye tempwrite: ubwacyo hanga.
	Gahunda sisitemu: ['sendmail -t < '] + f inzira-ya-dosiye, umurongo-mushya.
}.

Imeyili bigeze: ['hanga'] kora: {
	>> gucamo-umurongo := ['\r\n'].
	>> umugozi-w-umwandiko := [''].
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['From: '] + icyacyo izina-ry-uwohereje + [' <'] + ( icyacyo uwohereje ) + ['>']) + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['To: '] + ( icyacyo abakira huza: [','] )) + gucamo-umurongo.
	icyacyo cc umubare-wibintu ukuri: {
		umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Cc: '] + ( icyacyo cc huza: [','] )) + gucamo-umurongo.
	}.
	icyacyo bcc umubare-wibintu ukuri: {
		umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Bcc: '] + ( icyacyo bcc huza: [','] )) + gucamo-umurongo.
	}.
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Subject: '] + icyacyo insanganyamatsiko) + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: icyacyo umubiri.
	umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo. <- umugozi-w-umwandiko.
}.

>> Imeyili-HTML := Imeyili gishya.

Imeyili-HTML bigeze: ['tegura'] kora: {
	ubwacyo tegura.
	icyacyo imigereka := Urutonde gishya.
	icyacyo imbibi := Isanduku-yumutekano token: 40.
}.

Imeyili-HTML bigeze: ['fatanya:'] kora: { :dosiye-y-igihe
	>> id := icyacyo imigereka umubare-wibintu.
	>> blob := dosiye-y-igihe blob.
	icyacyo imigereka ongera-ku-mpera: (
		Inkoranyamagambo gishya
			dosiye-y-igihe: dosiye-y-igihe inzira-ya-dosiye,
			mime: ['image/'] + (Server mimetype: dosiye-y-igihe inzira-ya-dosiye),
			amakuru: blob base64-shyira-kode
	).
	blob rekura. <- ['cid:attachment'] + id.
}.

Imeyili-HTML bigeze: ['hanga'] kora: {
	>> gucamo-umurongo := ['\r\n'].
	>> umugozi-w-umwandiko := [''].
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['From: '] + icyacyo izina-ry-uwohereje + [' <'] + ( icyacyo uwohereje ) + ['>']) + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['To: '] + ( icyacyo abakira huza: [','] )) + gucamo-umurongo.
	icyacyo cc umubare-wibintu ukuri: {
		umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Cc: '] + ( icyacyo cc huza: [','] )) + gucamo-umurongo.
	}.
	icyacyo bcc umubare-wibintu ukuri: {
		umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Bcc: '] + ( icyacyo bcc huza: [','] )) + gucamo-umurongo.
	}.
	umugozi-w-umwandiko ongera-ku-mpera: (ubwacyo umutwe: ['Subject: '] + icyacyo insanganyamatsiko) + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: ['MIME-Version: 1.0'] + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: ['Content-Type: multipart/related; boundary="'] + icyacyo imbibi + ['"; type=text/html'] + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: ['--'] + icyacyo imbibi + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: ['Content-Type: text/html; charset=UTF-8'] + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: ['Content-Transfer-Encoding: 7bit'] + gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
	umugozi-w-umwandiko ongera-ku-mpera: icyacyo umubiri.
	umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
	icyacyo imigereka buri: { :id :amakuru-make
		>> blob := amakuru-make amakuru.
		umugozi-w-umwandiko ongera-ku-mpera: ['--'] + icyacyo imbibi + gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: ['Content-Type: '] + amakuru-make mime + gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: ['Content-Transfer-Encoding: base64'] + gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: ['Content-ID: <attachment'] + id + ['>'] + gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: ['Content-Disposition: inline; filename="'] + amakuru-make dosiye-y-igihe + ['"'] + gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
		>> ntarengwa := 76.
		>> uburebure-bw-umwandiko := blob uburebure.
		>> ibice-bito := (uburebure-bw-umwandiko / ntarengwa) zamura-umubare.
		{ :i
			>> igice-gito := blob koporora kuva: i * ntarengwa uburebure: ntarengwa.
			umugozi-w-umwandiko ongera-ku-mpera: igice-gito + gucamo-umurongo.
		} * ibice-bito.
		umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
		umugozi-w-umwandiko ongera-ku-mpera: gucamo-umurongo.
	}.
	umugozi-w-umwandiko ongera-ku-mpera: ['--'] + icyacyo imbibi + ['--'] + gucamo-umurongo. <- umugozi-w-umwandiko.
}.
