
# ~ Simple template engine ~

>> Template := Ikintu gishya.

Template bigeze: ['gishya'] kora: { <- ubwacyo gishya content: [''].
}.

Template bigeze: ['content:'] kora: { :content
	icyacyo content := content. 
}.

Template bigeze: ['gishya:'] kora: { :content <- ubwacyo gishya content: content.
}.

Template bigeze: ['cut:'] kora: { :marker
	>> startmarker := (['<!-- cut:%id% -->'] %id%: marker).
	>> endmarker := (['<!-- /cut:%id% -->'] %id%: marker).
	>> parts := icyacyo content gabanya: startmarker.
	>> prefix := parts icya-mbere.
	>> parts2 := parts icya-nyuma gabanya: endmarker.
	>> suffix := parts2 icya-nyuma.
	>> part := parts2 icya-mbere.
	>> rest := prefix + suffix.
	icyacyo content := rest. <- Template gishya: part.
	
}.

Template bigeze: ['koporora'] kora: { <- ubwacyo gishya: ubwacyo inyandiko koporora.
}.
	
Template bigeze: ['paste:at:'] kora: { :snippet :id
	>> pastemarker := (['<!-- paste:%id% -->'] %id%: id).
	icyacyo content simbuza: pastemarker na: ( snippet inyandiko + pastemarker ).
}.

Template bigeze: ['shyiraho:agaciro:'] kora: { :slot :value
	icyacyo content simbuza: ['<!-- slot:'] + slot + [' -->'] na: ( Server html-shyira-kode: value ).
}.

Template bigeze: ['set:html:'] kora: { :slot :html
	icyacyo content simbuza: ['<!-- slot:'] + slot + [' -->'] na: html.
}.

Template bigeze: ['subiza:na:'] kora: { :slot :value
	ubwacyo shyiraho: (slot kuva: 0 uburebure: (slot uburebure - 1)) agaciro: value.
}.

Template bigeze: ['nl2br'] kora: {
	icyacyo content simbuza: ['\n'] na: ['<br>'].
}.

Template bigeze: ['clean'] kora: {
	icyacyo content :=
		Icyitegererezo-cyishakisha
		gishya: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		guhura: icyacyo content
		kora: { <- ['']. }.
}.

Template bigeze: ['clean-cuts'] kora: {
	>> items := Urutonde gishya.
	Icyitegererezo-cyishakisha
	gishya: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	guhura: icyacyo content
	kora: { :_ :part
		items ongera-ku-mpera: part ? 1.
	}.
	items buri: { :_ :id
		icyacyo content :=
			Icyitegererezo-cyishakisha gishya: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			guhura: icyacyo content
			kora: { <- ['']. }.
	 }.
}.

Template bigeze: ['clean-space'] kora: {
	icyacyo content :=
		Icyitegererezo-cyishakisha
		gishya: ['\\s*\\n'],
		guhura: icyacyo content
		kora: { <- ['\n']. }.
	icyacyo content :=
		Icyitegererezo-cyishakisha
		gishya: ['\\n[\\s\\t]+'],
		guhura: icyacyo content
		kora: { <- ['\n']. }.
}.

Template bigeze: ['clean-all'] kora: {
	ubwacyo clean.
	ubwacyo clean-cuts.
	ubwacyo clean-space.
}.

Template bigeze: ['inyandiko'] kora: { <- icyacyo content.
}.
