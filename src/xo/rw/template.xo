
# ~ Simple template engine ~

>> Icyitegererezo := Ikintu gishya.

Icyitegererezo bigeze: ['gishya'] kora: { <- ubwacyo gishya ibikubiyemo: [''].
}.

Icyitegererezo bigeze: ['ibikubiyemo:'] kora: { :ibikubiyemo
	icyacyo ibikubiyemo := ibikubiyemo. 
}.

Icyitegererezo bigeze: ['gishya:'] kora: { :ibikubiyemo <- ubwacyo gishya ibikubiyemo: ibikubiyemo.
}.

Icyitegererezo bigeze: ['ca:'] kora: { :ikimenyetso
	>> ikimenyetso-cy-intangiriro := (['<!-- cut:%id% -->'] %id%: ikimenyetso).
	>> ikimenyetso-cy-iherezo := (['<!-- /cut:%id% -->'] %id%: ikimenyetso).
	>> ingingo := icyacyo ibikubiyemo gabanya: ikimenyetso-cy-intangiriro.
	>> imbanziriza := ingingo icya-mbere.
	>> ingingo2 := ingingo icya-nyuma gabanya: ikimenyetso-cy-iherezo.
	>> umugereka := ingingo2 icya-nyuma.
	>> urugingo := ingingo2 icya-mbere.
	>> ibisigaye := imbanziriza + umugereka.
	icyacyo ibikubiyemo := ibisigaye. <- Icyitegererezo gishya: urugingo.
	
}.

Icyitegererezo bigeze: ['koporora'] kora: { <- ubwacyo gishya: ubwacyo inyandiko koporora.
}.
	
Icyitegererezo bigeze: ['komeka:kuri:'] kora: { :agace :id
	>> ikimenyetso-cyo-komeka := (['<!-- paste:%id% -->'] %id%: id).
	icyacyo ibikubiyemo simbuza: ikimenyetso-cyo-komeka na: ( agace inyandiko + ikimenyetso-cyo-komeka ).
}.

Icyitegererezo bigeze: ['shyiraho:agaciro:'] kora: { :umwanya :agaciro
	icyacyo ibikubiyemo simbuza: ['<!-- slot:'] + umwanya + [' -->'] na: ( Server html-shyira-kode: agaciro ).
}.

Icyitegererezo bigeze: ['shyiraho:html:'] kora: { :umwanya :html
	icyacyo ibikubiyemo simbuza: ['<!-- slot:'] + umwanya + [' -->'] na: html.
}.

Icyitegererezo bigeze: ['subiza:na:'] kora: { :umwanya :agaciro
	ubwacyo shyiraho: (umwanya kuva: 0 uburebure: (umwanya uburebure - 1)) agaciro: agaciro.
}.

Icyitegererezo bigeze: ['nl2br'] kora: {
	icyacyo ibikubiyemo simbuza: ['\n'] na: ['<br>'].
}.

Icyitegererezo bigeze: ['tunganya'] kora: {
	icyacyo ibikubiyemo :=
		Icyitegererezo-cyishakisha
		gishya: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		guhura: icyacyo ibikubiyemo
		kora: { <- ['']. }.
}.

Icyitegererezo bigeze: ['tunganya-ibyaciwe'] kora: {
	>> ibintu := Urutonde gishya.
	Icyitegererezo-cyishakisha
	gishya: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	guhura: icyacyo ibikubiyemo
	kora: { :_ :urugingo
		ibintu ongera-ku-mpera: urugingo ? 1.
	}.
	ibintu buri: { :_ :id
		icyacyo ibikubiyemo :=
			Icyitegererezo-cyishakisha gishya: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			guhura: icyacyo ibikubiyemo
			kora: { <- ['']. }.
	 }.
}.

Icyitegererezo bigeze: ['tunganya-imyanya'] kora: {
	icyacyo ibikubiyemo :=
		Icyitegererezo-cyishakisha
		gishya: ['\\s*\\n'],
		guhura: icyacyo ibikubiyemo
		kora: { <- ['\n']. }.
	icyacyo ibikubiyemo :=
		Icyitegererezo-cyishakisha
		gishya: ['\\n[\\s\\t]+'],
		guhura: icyacyo ibikubiyemo
		kora: { <- ['\n']. }.
}.

Icyitegererezo bigeze: ['tunganya-byose'] kora: {
	ubwacyo tunganya.
	ubwacyo tunganya-ibyaciwe.
	ubwacyo tunganya-imyanya.
}.

Icyitegererezo bigeze: ['inyandiko'] kora: { <- icyacyo ibikubiyemo.
}.
