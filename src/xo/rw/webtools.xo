Ubusabe-HTTP bigeze: ['HTTP-umutwe:'] kora: { :urufunguzo <- Gahunda igenamiterere: urufunguzo.
}.

>> Umutwe-wa-HTTP := Ikintu gishya.

Umutwe-wa-HTTP bigeze: ['gishya'] kora: { <- ubwacyo gishya tegura.
}.

Umutwe-wa-HTTP bigeze: ['tegura'] kora: {
	icyacyo urufunguzo := Ntacyo.
	icyacyo agaciro := Ntacyo.
}.

Umutwe-wa-HTTP bigeze: ['urufunguzo:agaciro:'] kora: { :urufunguzo :agaciro
	icyacyo urufunguzo := urufunguzo.
	icyacyo agaciro := agaciro.
}.

Umutwe-wa-HTTP bigeze: ['urufunguzo'] kora: { <- icyacyo urufunguzo.
}.

Umutwe-wa-HTTP bigeze: ['agaciro'] kora: { <- icyacyo agaciro.
}.


Umutwe-wa-HTTP bigeze: ['inyandiko'] kora: {
	>> umurongo := icyacyo urufunguzo + [': '] + icyacyo agaciro.
	umurongo simbuza: ['\r'] na: [''], simbuza: ['\n'] na: ['']. <- umurongo + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Inyandiko-ya-Interineti := Ikintu gishya.

Inyandiko-ya-Interineti bigeze: ['gishya'] kora: { <- ubwacyo gishya tegura.
}.

Inyandiko-ya-Interineti bigeze: ['tegura'] kora: {
	icyacyo imitwe := Urutonde gishya.
	icyacyo id-y-igihe := Ntacyo.
	icyacyo umuyobozi-w-ibihe := Igihe-cya-dosiye-y-agateganyo gishya.
	icyacyo amakuru-y-igihe := Ntacyo.
	icyacyo itekanye := Ukuri.
	icyacyo urubuga-rumwe := ['Strict'].
	icyacyo imitwe-yoherejwe := Ikinyoma.
	icyacyo icyifuzo-http := Ubusabe-HTTP gishya.
}.

Inyandiko-ya-Interineti bigeze: ['icyifuzo-http:'] kora: { :icyifuzo-http
	icyacyo icyifuzo-http := icyifuzo-http.
}. 

Inyandiko-ya-Interineti bigeze: ['kuki-y-igihe-itekanye:'] kora: { :itekanye
	ubwacyo genzura-imitwe.
	icyacyo itekanye := itekanye.
}.

Inyandiko-ya-Interineti bigeze: ['kuki-y-igihe-urubuga-rumwe:'] kora: { :agaciro
	ubwacyo genzura-imitwe.
	>> amahitamo := Urutonde gishya 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	amahitamo ifite: agaciro, ikinyoma: {
		uyu-murimo ikosa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	icyacyo urubuga-rumwe := agaciro.
}.

Inyandiko-ya-Interineti bigeze: ['umutwe:'] kora: { :umutwe
	ubwacyo genzura-imitwe.
	icyacyo imitwe ongera-ku-mpera: umutwe.
}.

Inyandiko-ya-Interineti bigeze: ['kuraho-imitwe'] kora: {
	ubwacyo genzura-imitwe.
	icyacyo imitwe := Urutonde gishya.
}.

Inyandiko-ya-Interineti bigeze: ['umuyobozi-w-ibihe:'] kora: { :umuyobozi
	ubwacyo genzura-imitwe.
	icyacyo umuyobozi-w-ibihe := umuyobozi.
}.

Inyandiko-ya-Interineti bigeze: ['umuyobozi-w-ibihe'] kora: { <- icyacyo umuyobozi-w-ibihe.
}.

Inyandiko-ya-Interineti bigeze: ['genzura-imitwe'] kora: {
	icyacyo imitwe-yoherejwe ukuri: {
		uyu-murimo ikosa: ['Headers already sent to client.'].
	}.
}.

Inyandiko-ya-Interineti bigeze: ['tangira-igihe'] kora: {
	ubwacyo genzura-imitwe.
	>> icyifuzo-http := icyacyo icyifuzo-http.
	>> id-y-igihe := icyifuzo-http cookie: ['xsid'].
	id-y-igihe Ntacyo? ikinyoma: {
		(( Icyitegererezo-cyishakisha gishya: ['^[A-Za-z0-9]+\\z'], guhura: id-y-igihe ) = 0) ukuri: {
			id-y-igihe := Ntacyo.
		}.
	}.
	id-y-igihe Ntacyo? ukuri: {
		id-y-igihe := Isanduku-yumutekano token: 30.
		>> umutwe-w-igihe := Umutwe-wa-HTTP gishya
		urufunguzo: ['Set-Cookie'] agaciro: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (icyacyo itekanye iki: ['Secure'] cyangwa-kiriya: ['']),
		SSITE: (icyacyo urubuga-rumwe),
		XSID: id-y-igihe
		).
		icyacyo imitwe ongera-ku-mpera: umutwe-w-igihe.
	}.
	icyacyo amakuru-y-igihe := icyacyo umuyobozi-w-ibihe kubwa: id-y-igihe, zana. <- icyacyo amakuru-y-igihe. # reference
}.

Inyandiko-ya-Interineti bigeze: ['jya-kuri:'] kora: { :aderesi
	ubwacyo genzura-imitwe.
	ubwacyo kuraho-imitwe.
	icyacyo imitwe
	ongera-ku-mpera: (
		Umutwe-wa-HTTP gishya
		urufunguzo: ['Status'] agaciro: ['303 See Other']
	),
	ongera-ku-mpera: (
		Umutwe-wa-HTTP gishya
		urufunguzo: ['Location'] agaciro: aderesi
	).
	ubwacyo sohora: ['Redirect'].
}.

Inyandiko-ya-Interineti bigeze: ['senya-igihe'] kora: {
	ubwacyo genzura-imitwe.
	>> icyifuzo-http := icyacyo icyifuzo-http.
	>> id-y-igihe := icyifuzo-http cookie: ['xsid'].
	id-y-igihe Ntacyo? ikinyoma: {
		>> umutwe-w-igihe := Umutwe-wa-HTTP gishya.
		>> igihe-cyo-kurangira := Akanya gishya umwaka: 1970, imiterere: ['%a, %d %b %Y %H:%M:%S GMT'].
		umutwe-w-igihe urufunguzo: ['Set-Cookie'] agaciro: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: igihe-cyo-kurangira,
			SEC: (icyacyo itekanye iki: ['Secure'] cyangwa-kiriya: ['']),
			SSITE: (icyacyo urubuga-rumwe),
			XSID: id-y-igihe
		).
		icyacyo umuyobozi-w-ibihe senya.
		icyacyo imitwe ongera-ku-mpera: umutwe-w-igihe.
	}.
}.


Inyandiko-ya-Interineti bigeze: ['icyitegererezo:'] kora: { :inzira-ya-dosiye <- Icyitegererezo gishya: (Dosiye gishya: inzira-ya-dosiye, soma).
}.

Inyandiko-ya-Interineti bigeze: ['sohora:ubwoko:'] kora: { :igisubizo :ubwoko
	icyacyo imitwe-yoherejwe ikinyoma: {
		icyacyo amakuru-y-igihe Ntacyo? ikinyoma: {
			icyacyo umuyobozi-w-ibihe bika: icyacyo amakuru-y-igihe.
		}.
		icyacyo imitwe ongera-ku-mpera: (
			Umutwe-wa-HTTP gishya
			urufunguzo: ['Content-type'] agaciro: ubwoko
		).
		icyacyo imitwe buri: { :_ :umutwe
			Ibisohoka andika: umutwe.
		}.
		icyacyo imitwe-yoherejwe := Ukuri.
		Ibisohoka andika: ['\r\n'].
	}.
	Ibisohoka andika: igisubizo.
}.

Inyandiko-ya-Interineti bigeze: ['soza:ubwoko:'] kora: { :igisubizo :ubwoko
	icyacyo imitwe-yoherejwe ikinyoma: {
		icyacyo amakuru-y-igihe Ntacyo? ikinyoma: {
			icyacyo umuyobozi-w-ibihe bika: icyacyo amakuru-y-igihe.
		}.
		icyacyo imitwe ongera-ku-mpera: (
			Umutwe-wa-HTTP gishya
			urufunguzo: ['Content-type'] agaciro: ubwoko
		).
		icyacyo imitwe ongera-ku-mpera: (
			Umutwe-wa-HTTP gishya
			urufunguzo: ['Content-Length'] agaciro: igisubizo inyandiko bytes
		).
		icyacyo imitwe buri: { :_ :umutwe
			Ibisohoka andika: umutwe.
		}.
		icyacyo imitwe-yoherejwe := Ukuri.
		Ibisohoka andika: ['\r\n'].
	}.
	Ibisohoka andika: igisubizo.
}.

Inyandiko-ya-Interineti bigeze: ['sohora:'] kora: { :igisubizo
	ubwacyo sohora: igisubizo ubwoko: ['text/html; charset=utf-8'].
}.

Inyandiko-ya-Interineti bigeze: ['soza:'] kora: { :igisubizo
	ubwacyo soza: igisubizo ubwoko: ['text/html; charset=utf-8'].
}.

Inyandiko-ya-Interineti bigeze: ['json:'] kora: { :igisubizo
	ubwacyo sohora: ( JSON jsonify: igisubizo ) ubwoko: ['application/json'].
}.

Inyandiko-ya-Interineti bigeze: ['ntibibonetse:'] kora: { :igisubizo
	ubwacyo kuraho-imitwe umutwe: (
		Umutwe-wa-HTTP gishya urufunguzo: ['Status'] agaciro: ['404 Not Found']
	).
	ubwacyo sohora: igisubizo.
}.


# Interface

>> Igihe-cy-ikoreshwa := Ikintu gishya.

Igihe-cy-ikoreshwa bigeze: ['gishya'] kora: { <- ubwacyo gishya tegura kubwa: Ntacyo.
}.

Igihe-cy-ikoreshwa bigeze: ['kubwa:'] kora: { :id
	icyacyo id := id.
}.

Igihe-cy-ikoreshwa bigeze: ['zana'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

Igihe-cy-ikoreshwa bigeze: ['bika:'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

Igihe-cy-ikoreshwa bigeze: ['senya'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Igihe-cya-dosiye-y-agateganyo := Igihe-cy-ikoreshwa gishya.

Igihe-cya-dosiye-y-agateganyo bigeze: ['tegura'] kora: {
	icyacyo intangiriro-y-inzira := ['/tmp/sess-'].
}.

Igihe-cya-dosiye-y-agateganyo bigeze: ['imbanziriza-nzira:'] kora: { :umugozi-w-umwandiko
	icyacyo intangiriro-y-inzira := umugozi-w-umwandiko.
}.

Igihe-cya-dosiye-y-agateganyo bigeze: ['dosiye-y-igihe'] kora: { <- ( Dosiye gishya: ( icyacyo intangiriro-y-inzira + icyacyo id + ['.txt'] ) ).
}.

Igihe-cya-dosiye-y-agateganyo bigeze: ['zana'] kora: {
	>> dosiye-y-igihe := ubwacyo dosiye-y-igihe.
	dosiye-y-igihe ibaho ikinyoma: {
		dosiye-y-igihe andika: (Inkoranyamagambo gishya kode).
	}. <- dosiye-y-igihe soma ikintu.
}.

Igihe-cya-dosiye-y-agateganyo bigeze: ['bika:'] kora: { :amakuru
	>> dosiye-y-igihe := ubwacyo dosiye-y-igihe.
	dosiye-y-igihe ibaho ukuri: {
		dosiye-y-igihe andika: amakuru kode.
	}.
}.

Igihe-cya-dosiye-y-agateganyo bigeze: ['senya'] kora: {
	>> dosiye-y-igihe := ubwacyo dosiye-y-igihe.
	dosiye-y-igihe ibaho ukuri: {
		dosiye-y-igihe siba.
	}.
}.


>> URL := Ikintu gishya.

URL bigeze: ['tegura'] kora: {
	icyacyo porotokole := ['https://'].
	icyacyo uwakira := ['localhost'].
	icyacyo inzira-ya-dosiye := [''].
	icyacyo ibipimo-bya-url := [''].
	icyacyo hash := [''].
}.

URL bigeze: ['gishya'] kora: { <- ubwacyo gishya tegura.
}.

URL bigeze: ['inyandiko'] kora: { <- (
	icyacyo porotokole +
	icyacyo uwakira +
	icyacyo inzira-ya-dosiye +
	icyacyo ibipimo-bya-url +
	icyacyo hash ).
}.

URL bigeze: ['porotokole:'] kora: { :porotokole
	((Urutonde gishya ; ['http'] ; ['https']) ifite: porotokole) ukuri: {
		icyacyo porotokole := porotokole + ['://'].
	}, ikinyoma: {
		uyu-murimo ikosa: ['Invalid protocol'].
	}.
}.

URL bigeze: ['uwakira:'] kora: { :uwakira
	#todo validate according to rfc
	icyacyo uwakira := uwakira.
}.

URL bigeze: ['inzira-ya-dosiye:'] kora: { :inzira-ya-dosiye
	icyacyo inzira-ya-dosiye := ['/'] + inzira-ya-dosiye url-shyira-kode.
}.

URL bigeze: ['ibipimo-bya-url:'] kora: { :ishushanya
	>> ibipimo-bya-url := Urutonde gishya.
	ishushanya buri: { :urufunguzo :agaciro
		ibipimo-bya-url ongera-ku-mpera: urufunguzo inyandiko url-shyira-kode + ['='] + agaciro inyandiko url-shyira-kode.
	}.
	icyacyo ibipimo-bya-url := ['?'] + ( ibipimo-bya-url huza: ['&'] ).
}.

URL bigeze: ['hash:'] kora: { :hash
	icyacyo hash := ['#'] + hash url-shyira-kode.
}.

