Ubusabe-HTTP bigeze: ['HTTP-header:'] kora: { :key <- Gahunda igenamiterere: key.
}.

>> HTTP-Header := Ikintu gishya.

HTTP-Header bigeze: ['gishya'] kora: { <- ubwacyo gishya init.
}.

HTTP-Header bigeze: ['init'] kora: {
	icyacyo key := Ntacyo.
	icyacyo value := Ntacyo.
}.

HTTP-Header bigeze: ['key:value:'] kora: { :key :value
	icyacyo key := key.
	icyacyo value := value.
}.

HTTP-Header bigeze: ['key'] kora: { <- icyacyo key.
}.

HTTP-Header bigeze: ['value'] kora: { <- icyacyo value.
}.


HTTP-Header bigeze: ['inyandiko'] kora: {
	>> line := icyacyo key + [': '] + icyacyo value.
	line simbuza: ['\r'] na: [''], simbuza: ['\n'] na: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Ikintu gishya.

Web-Document bigeze: ['gishya'] kora: { <- ubwacyo gishya init.
}.

Web-Document bigeze: ['init'] kora: {
	icyacyo headers := Urutonde gishya.
	icyacyo sess-id := Ntacyo.
	icyacyo session-manager := Tempfile-Session gishya.
	icyacyo sessdata := Ntacyo.
	icyacyo secure := Ukuri.
	icyacyo same-site := ['Strict'].
	icyacyo headers-out := Ikinyoma.
	icyacyo request := Ubusabe-HTTP gishya.
}.

Web-Document bigeze: ['request:'] kora: { :request
	icyacyo request := request.
}. 

Web-Document bigeze: ['secure-session-cookie:'] kora: { :secure
	ubwacyo check-headers.
	icyacyo secure := secure.
}.

Web-Document bigeze: ['same-site-session-cookie:'] kora: { :value
	ubwacyo check-headers.
	>> options := Urutonde gishya 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options ikubiyemo: value, ikinyoma: {
		uyu-murimo ikosa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	icyacyo same-site := value.
}.

Web-Document bigeze: ['header:'] kora: { :header
	ubwacyo check-headers.
	icyacyo headers ongera-ku-mpera: header.
}.

Web-Document bigeze: ['clear-headers'] kora: {
	ubwacyo check-headers.
	icyacyo headers := Urutonde gishya.
}.

Web-Document bigeze: ['session-manager:'] kora: { :manager
	ubwacyo check-headers.
	icyacyo session-manager := manager.
}.

Web-Document bigeze: ['session-manager'] kora: { <- icyacyo session-manager.
}.

Web-Document bigeze: ['check-headers'] kora: {
	icyacyo headers-out ukuri: {
		uyu-murimo ikosa: ['Headers already sent to client.'].
	}.
}.

Web-Document bigeze: ['session-start'] kora: {
	ubwacyo check-headers.
	>> request := icyacyo request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ntacyo? ikinyoma: {
		(( Icyitegererezo-cyishakisha gishya: ['^[A-Za-z0-9]+\\z'], guhura: sess-id ) = 0) ukuri: {
			sess-id := Ntacyo.
		}.
	}.
	sess-id Ntacyo? ukuri: {
		sess-id := Isanduku-yumutekano token: 30.
		>> session-header := HTTP-Header gishya
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (icyacyo secure iki: ['Secure'] cyangwa-kiriya: ['']),
		SSITE: (icyacyo same-site),
		XSID: sess-id
		).
		icyacyo headers ongera-ku-mpera: session-header.
	}.
	icyacyo sessdata := icyacyo session-manager for: sess-id, load. <- icyacyo sessdata. # reference
}.

Web-Document bigeze: ['goto:'] kora: { :url
	ubwacyo check-headers.
	ubwacyo clear-headers.
	icyacyo headers
	ongera-ku-mpera: (
		HTTP-Header gishya
		key: ['Status'] value: ['303 See Other']
	),
	ongera-ku-mpera: (
		HTTP-Header gishya
		key: ['Location'] value: url
	).
	ubwacyo out: ['Redirect'].
}.

Web-Document bigeze: ['session-destroy'] kora: {
	ubwacyo check-headers.
	>> request := icyacyo request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ntacyo? ikinyoma: {
		>> session-header := HTTP-Header gishya.
		>> when := Akanya gishya umwaka: 1970, imiterere: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (icyacyo secure iki: ['Secure'] cyangwa-kiriya: ['']),
			SSITE: (icyacyo same-site),
			XSID: sess-id
		).
		icyacyo session-manager destroy.
		icyacyo headers ongera-ku-mpera: session-header.
	}.
}.


Web-Document bigeze: ['template:'] kora: { :inzira-ya-dosiye <- Template gishya: (Dosiye gishya: inzira-ya-dosiye, soma).
}.

Web-Document bigeze: ['out:type:'] kora: { :output :ubwoko
	icyacyo headers-out ikinyoma: {
		icyacyo sessdata Ntacyo? ikinyoma: {
			icyacyo session-manager save: icyacyo sessdata.
		}.
		icyacyo headers ongera-ku-mpera: (
			HTTP-Header gishya
			key: ['Content-type'] value: ubwoko
		).
		icyacyo headers buri: { :_ :header
			Ibisohoka andika: header.
		}.
		icyacyo headers-out := Ukuri.
		Ibisohoka andika: ['\r\n'].
	}.
	Ibisohoka andika: output.
}.

Web-Document bigeze: ['finish:type:'] kora: { :output :ubwoko
	icyacyo headers-out ikinyoma: {
		icyacyo sessdata Ntacyo? ikinyoma: {
			icyacyo session-manager save: icyacyo sessdata.
		}.
		icyacyo headers ongera-ku-mpera: (
			HTTP-Header gishya
			key: ['Content-type'] value: ubwoko
		).
		icyacyo headers ongera-ku-mpera: (
			HTTP-Header gishya
			key: ['Content-Length'] value: output inyandiko bytes
		).
		icyacyo headers buri: { :_ :header
			Ibisohoka andika: header.
		}.
		icyacyo headers-out := Ukuri.
		Ibisohoka andika: ['\r\n'].
	}.
	Ibisohoka andika: output.
}.

Web-Document bigeze: ['out:'] kora: { :output
	ubwacyo out: output type: ['text/html; charset=utf-8'].
}.

Web-Document bigeze: ['finish:'] kora: { :output
	ubwacyo finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document bigeze: ['json:'] kora: { :output
	ubwacyo out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document bigeze: ['not-found:'] kora: { :output
	ubwacyo clear-headers header: (
		HTTP-Header gishya key: ['Status'] value: ['404 Not Found']
	).
	ubwacyo out: output.
}.


# Interface

>> Session := Ikintu gishya.

Session bigeze: ['gishya'] kora: { <- ubwacyo gishya init for: Ntacyo.
}.

Session bigeze: ['for:'] kora: { :id
	icyacyo id := id.
}.

Session bigeze: ['load'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

Session bigeze: ['save:'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

Session bigeze: ['destroy'] kora: {
	uyu-murimo ikosa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session gishya.

Tempfile-Session bigeze: ['init'] kora: {
	icyacyo pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session bigeze: ['path-prefix:'] kora: { :str
	icyacyo pathprefix := str.
}.

Tempfile-Session bigeze: ['file'] kora: { <- ( Dosiye gishya: ( icyacyo pathprefix + icyacyo id + ['.txt'] ) ).
}.

Tempfile-Session bigeze: ['load'] kora: {
	>> file := ubwacyo file.
	file ibaho ikinyoma: {
		file andika: (Inkoranyamagambo gishya kode).
	}. <- file soma ikintu.
}.

Tempfile-Session bigeze: ['save:'] kora: { :data
	>> file := ubwacyo file.
	file ibaho ukuri: {
		file andika: data kode.
	}.
}.

Tempfile-Session bigeze: ['destroy'] kora: {
	>> file := ubwacyo file.
	file ibaho ukuri: {
		file siba.
	}.
}.


>> URL := Ikintu gishya.

URL bigeze: ['init'] kora: {
	icyacyo protocol := ['https://'].
	icyacyo uwakira := ['localhost'].
	icyacyo inzira-ya-dosiye := [''].
	icyacyo params := [''].
	icyacyo hash := [''].
}.

URL bigeze: ['gishya'] kora: { <- ubwacyo gishya init.
}.

URL bigeze: ['inyandiko'] kora: { <- (
	icyacyo protocol +
	icyacyo uwakira +
	icyacyo inzira-ya-dosiye +
	icyacyo params +
	icyacyo hash ).
}.

URL bigeze: ['protocol:'] kora: { :protocol
	((Urutonde gishya: ['http'] ; ['https']) ikubiyemo: protocol) ukuri: {
		icyacyo protocol := protocol + ['://'].
	}, ikinyoma: {
		uyu-murimo ikosa: ['Invalid protocol'].
	}.
}.

URL bigeze: ['uwakira:'] kora: { :uwakira
	#todo validate according to rfc
	icyacyo uwakira := uwakira.
}.

URL bigeze: ['path:'] kora: { :inzira-ya-dosiye
	icyacyo inzira-ya-dosiye := ['/'] + inzira-ya-dosiye url-shyira-kode.
}.

URL bigeze: ['params:'] kora: { :map
	>> params := Urutonde gishya.
	map buri: { :key :value
		params ongera-ku-mpera: key inyandiko url-shyira-kode + ['='] + value inyandiko url-shyira-kode.
	}.
	icyacyo params := ['?'] + ( params huza: ['&'] ).
}.

URL bigeze: ['hash:'] kora: { :hash
	icyacyo hash := ['#'] + hash url-shyira-kode.
}.

