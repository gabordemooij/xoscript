
# ~ Simple template engine ~

>> Sagoma := Oggetto nuovo.

Sagoma on: ['nuovo'] fare: { <- io nuovo contenuto: [''].
}.

Sagoma on: ['contenuto:'] fare: { :contenuto
	mio contenuto := contenuto. 
}.

Sagoma on: ['nuovo:'] fare: { :contenuto <- io nuovo contenuto: contenuto.
}.

Sagoma on: ['tagliare:'] fare: { :marcatore
	>> marcatore-inizio := (['<!-- cut:%id% -->'] %id%: marcatore).
	>> marcatore-fine := (['<!-- /cut:%id% -->'] %id%: marcatore).
	>> parti := mio contenuto diviso: marcatore-inizio.
	>> prefisso := parti primo.
	>> parti2 := parti scorso diviso: marcatore-fine.
	>> suffisso := parti2 scorso.
	>> parte := parti2 primo.
	>> resto := prefisso + suffisso.
	mio contenuto := resto. <- Sagoma nuovo: parte.
	
}.

Sagoma on: ['copia'] fare: { <- io nuovo: io testo copia.
}.
	
Sagoma on: ['incollare:a:'] fare: { :ritaglio :id
	>> marcatore-incolla := (['<!-- paste:%id% -->'] %id%: id).
	mio contenuto sostituirlo: marcatore-incolla con: ( ritaglio testo + marcatore-incolla ).
}.

Sagoma on: ['valore:impostato:'] fare: { :segnaposto :valore
	mio contenuto sostituirlo: ['<!-- slot:'] + segnaposto + [' -->'] con: ( Server html-codifica: valore ).
}.

Sagoma on: ['valore:html:'] fare: { :segnaposto :html
	mio contenuto sostituirlo: ['<!-- slot:'] + segnaposto + [' -->'] con: html.
}.

Sagoma on: ['rispondere:e:'] fare: { :segnaposto :valore
	io valore: (segnaposto da: 0 lunghezza: (segnaposto lunghezza - 1)) impostato: valore.
}.

Sagoma on: ['nl2br'] fare: {
	mio contenuto sostituirlo: ['\n'] con: ['<br>'].
}.

Sagoma on: ['pulire'] fare: {
	mio contenuto :=
		Modello
		nuovo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		corrispondenza: mio contenuto
		fai: { <- ['']. }.
}.

Sagoma on: ['pulire-tagli'] fare: {
	>> elementi := Serie nuovo.
	Modello
	nuovo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	corrispondenza: mio contenuto
	fai: { :_ :parte
		elementi aggiungere: parte ? 1.
	}.
	elementi ogni: { :_ :id
		mio contenuto :=
			Modello nuovo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			corrispondenza: mio contenuto
			fai: { <- ['']. }.
	 }.
}.

Sagoma on: ['pulire-spazi'] fare: {
	mio contenuto :=
		Modello
		nuovo: ['\\s*\\n'],
		corrispondenza: mio contenuto
		fai: { <- ['\n']. }.
	mio contenuto :=
		Modello
		nuovo: ['\\n[\\s\\t]+'],
		corrispondenza: mio contenuto
		fai: { <- ['\n']. }.
}.

Sagoma on: ['pulire-tutto'] fare: {
	io pulire.
	io pulire-tagli.
	io pulire-spazi.
}.

Sagoma on: ['testo'] fare: { <- mio contenuto.
}.
