Richiesta-HTTP on: ['HTTP-intestazione:'] fare: { :chiave <- Programma instelling: chiave.
}.

>> Intestazione-HTTP := Oggetto nuovo.

Intestazione-HTTP on: ['nuovo'] fare: { <- io nuovo inizializzare.
}.

Intestazione-HTTP on: ['inizializzare'] fare: {
	mio chiave := Nil.
	mio valore := Nil.
}.

Intestazione-HTTP on: ['chiave:valore:'] fare: { :chiave :valore
	mio chiave := chiave.
	mio valore := valore.
}.

Intestazione-HTTP on: ['chiave'] fare: { <- mio chiave.
}.

Intestazione-HTTP on: ['valore'] fare: { <- mio valore.
}.


Intestazione-HTTP on: ['testo'] fare: {
	>> riga := mio chiave + [': '] + mio valore.
	riga sostituirlo: ['\r'] con: [''], sostituirlo: ['\n'] con: ['']. <- riga + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Documento-Web := Oggetto nuovo.

Documento-Web on: ['nuovo'] fare: { <- io nuovo inizializzare.
}.

Documento-Web on: ['inizializzare'] fare: {
	mio intestazioni := Serie nuovo.
	mio id-sessione := Nil.
	mio gestore-sessione := Sessione-file-temporaneo nuovo.
	mio dati-sessione := Nil.
	mio sicuro := Vero.
	mio stesso-sito := ['Strict'].
	mio intestazioni-inviate := Falso.
	mio richiesta := Richiesta-HTTP nuovo.
}.

Documento-Web on: ['richiesta:'] fare: { :richiesta
	mio richiesta := richiesta.
}. 

Documento-Web on: ['cookie-sessione-sicuro:'] fare: { :sicuro
	io controllare-intestazioni.
	mio sicuro := sicuro.
}.

Documento-Web on: ['cookie-sessione-stesso-sito:'] fare: { :valore
	io controllare-intestazioni.
	>> opzioni := Serie nuovo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opzioni ha: valore, falso: {
		questo-compito errore: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	mio stesso-sito := valore.
}.

Documento-Web on: ['intestazione:'] fare: { :intestazione
	io controllare-intestazioni.
	mio intestazioni aggiungere: intestazione.
}.

Documento-Web on: ['svuotare-intestazioni'] fare: {
	io controllare-intestazioni.
	mio intestazioni := Serie nuovo.
}.

Documento-Web on: ['gestore-sessione:'] fare: { :gestore
	io controllare-intestazioni.
	mio gestore-sessione := gestore.
}.

Documento-Web on: ['gestore-sessione'] fare: { <- mio gestore-sessione.
}.

Documento-Web on: ['controllare-intestazioni'] fare: {
	mio intestazioni-inviate vero: {
		questo-compito errore: ['Headers already sent to client.'].
	}.
}.

Documento-Web on: ['avviare-sessione'] fare: {
	io controllare-intestazioni.
	>> richiesta := mio richiesta.
	>> id-sessione := richiesta cookie: ['xsid'].
	id-sessione nil? falso: {
		(( Modello nuovo: ['^[A-Za-z0-9]+\\z'], corrispondenza: id-sessione ) = 0) vero: {
			id-sessione := Nil.
		}.
	}.
	id-sessione nil? vero: {
		id-sessione := Caveau token: 30.
		>> intestazione-sessione := Intestazione-HTTP nuovo
		chiave: ['Set-Cookie'] valore: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (mio sicuro o: ['Secure'] o: ['']),
		SSITE: (mio stesso-sito),
		XSID: id-sessione
		).
		mio intestazioni aggiungere: intestazione-sessione.
	}.
	mio dati-sessione := mio gestore-sessione per: id-sessione, caricare. <- mio dati-sessione. # reference
}.

Documento-Web on: ['vai-a:'] fare: { :indirizzo
	io controllare-intestazioni.
	io svuotare-intestazioni.
	mio intestazioni
	aggiungere: (
		Intestazione-HTTP nuovo
		chiave: ['Status'] valore: ['303 See Other']
	),
	aggiungere: (
		Intestazione-HTTP nuovo
		chiave: ['Location'] valore: indirizzo
	).
	io emettere: ['Redirect'].
}.

Documento-Web on: ['distruggere-sessione'] fare: {
	io controllare-intestazioni.
	>> richiesta := mio richiesta.
	>> id-sessione := richiesta cookie: ['xsid'].
	id-sessione nil? falso: {
		>> intestazione-sessione := Intestazione-HTTP nuovo.
		>> momento := Momento nuovo anno: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		intestazione-sessione chiave: ['Set-Cookie'] valore: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: momento,
			SEC: (mio sicuro o: ['Secure'] o: ['']),
			SSITE: (mio stesso-sito),
			XSID: id-sessione
		).
		mio gestore-sessione distruggere.
		mio intestazioni aggiungere: intestazione-sessione.
	}.
}.


Documento-Web on: ['sagoma:'] fare: { :sentiero <- Sagoma nuovo: (File nuovo: sentiero, leggere).
}.

Documento-Web on: ['emettere:genere:'] fare: { :uscita :genere
	mio intestazioni-inviate falso: {
		mio dati-sessione nil? falso: {
			mio gestore-sessione salvare: mio dati-sessione.
		}.
		mio intestazioni aggiungere: (
			Intestazione-HTTP nuovo
			chiave: ['Content-type'] valore: genere
		).
		mio intestazioni ogni: { :_ :intestazione
			Uscita scrivi: intestazione.
		}.
		mio intestazioni-inviate := Vero.
		Uscita scrivi: ['\r\n'].
	}.
	Uscita scrivi: uscita.
}.

Documento-Web on: ['terminare:genere:'] fare: { :uscita :genere
	mio intestazioni-inviate falso: {
		mio dati-sessione nil? falso: {
			mio gestore-sessione salvare: mio dati-sessione.
		}.
		mio intestazioni aggiungere: (
			Intestazione-HTTP nuovo
			chiave: ['Content-type'] valore: genere
		).
		mio intestazioni aggiungere: (
			Intestazione-HTTP nuovo
			chiave: ['Content-Length'] valore: uscita testo bytes
		).
		mio intestazioni ogni: { :_ :intestazione
			Uscita scrivi: intestazione.
		}.
		mio intestazioni-inviate := Vero.
		Uscita scrivi: ['\r\n'].
	}.
	Uscita scrivi: uscita.
}.

Documento-Web on: ['emettere:'] fare: { :uscita
	io emettere: uscita genere: ['text/html; charset=utf-8'].
}.

Documento-Web on: ['terminare:'] fare: { :uscita
	io terminare: uscita genere: ['text/html; charset=utf-8'].
}.

Documento-Web on: ['json:'] fare: { :uscita
	io emettere: ( JSON jsonifica: uscita ) genere: ['application/json'].
}.

Documento-Web on: ['non-trovato:'] fare: { :uscita
	io svuotare-intestazioni intestazione: (
		Intestazione-HTTP nuovo chiave: ['Status'] valore: ['404 Not Found']
	).
	io emettere: uscita.
}.


# Interface

>> Sessione := Oggetto nuovo.

Sessione on: ['nuovo'] fare: { <- io nuovo inizializzare per: Nil.
}.

Sessione on: ['per:'] fare: { :id
	mio id := id.
}.

Sessione on: ['caricare'] fare: {
	questo-compito errore: ['Not implemented.'].
}.

Sessione on: ['salvare:'] fare: {
	questo-compito errore: ['Not implemented.'].
}.

Sessione on: ['distruggere'] fare: {
	questo-compito errore: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sessione-file-temporaneo := Sessione nuovo.

Sessione-file-temporaneo on: ['inizializzare'] fare: {
	mio prefissopercorso := ['/tmp/sess-'].
}.

Sessione-file-temporaneo on: ['prefisso-percorso:'] fare: { :stringa
	mio prefissopercorso := stringa.
}.

Sessione-file-temporaneo on: ['file'] fare: { <- ( File nuovo: ( mio prefissopercorso + mio id + ['.txt'] ) ).
}.

Sessione-file-temporaneo on: ['caricare'] fare: {
	>> file := io file.
	file esiste falso: {
		file scrivi: (Elenco nuovo code).
	}. <- file leggere oggetto.
}.

Sessione-file-temporaneo on: ['salvare:'] fare: { :dati
	>> file := io file.
	file esiste vero: {
		file scrivi: dati code.
	}.
}.

Sessione-file-temporaneo on: ['distruggere'] fare: {
	>> file := io file.
	file esiste vero: {
		file elimina.
	}.
}.


>> URL := Oggetto nuovo.

URL on: ['inizializzare'] fare: {
	mio protocollo := ['https://'].
	mio host := ['localhost'].
	mio sentiero := [''].
	mio parametri-url := [''].
	mio hash := [''].
}.

URL on: ['nuovo'] fare: { <- io nuovo inizializzare.
}.

URL on: ['testo'] fare: { <- (
	mio protocollo +
	mio host +
	mio sentiero +
	mio parametri-url +
	mio hash ).
}.

URL on: ['protocollo:'] fare: { :protocollo
	((Serie nuovo ; ['http'] ; ['https']) ha: protocollo) vero: {
		mio protocollo := protocollo + ['://'].
	}, falso: {
		questo-compito errore: ['Invalid protocol'].
	}.
}.

URL on: ['host:'] fare: { :host
	#todo validate according to rfc
	mio host := host.
}.

URL on: ['sentiero:'] fare: { :sentiero
	mio sentiero := ['/'] + sentiero url-codifica.
}.

URL on: ['parametri-url:'] fare: { :mappa
	>> parametri-url := Serie nuovo.
	mappa ogni: { :chiave :valore
		parametri-url aggiungere: chiave testo url-codifica + ['='] + valore testo url-codifica.
	}.
	mio parametri-url := ['?'] + ( parametri-url aderire: ['&'] ).
}.

URL on: ['hash:'] fare: { :hash
	mio hash := ['#'] + hash url-codifica.
}.

