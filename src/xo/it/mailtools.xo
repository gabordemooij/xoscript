>> Email := Oggetto nuovo.

Email on: ['init'] fare: {
	mio recipients := Serie nuovo.
	mio cc := Serie nuovo.
	mio bcc := Serie nuovo.
	mio from := Nil.
	mio from-name := Nil.
	mio subject := Nil.
	mio body := Nil.
}.

Email on: ['nuovo'] fare: { <- io nuovo init.
}.

Email on: ['to:'] fare: { :list
	mio recipients := list.
}.
 
Email on: ['cc:'] fare: { :list
	mio cc := list.
}.

Email on: ['bcc:'] fare: { :list
	mio bcc := list.
}.

Email on: ['subject:'] fare: { :subject
	mio subject := subject.
}.

Email on: ['from:name:'] fare: { :from :nome
	mio from := from.
	mio from-name := nome.
}.

Email on: ['body:'] fare: { :body
	mio body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email on: ['header:'] fare: { :line <- line sostituirlo: ['\r'] con: [''], sostituirlo: ['\n'] con: [''].
}.

Email on: ['send'] fare: {
	>> f := File tempwrite: io generate.
	Programma sistema: ['sendmail -t < '] + f sentiero, stop.
}.

Email on: ['generate'] fare: {
	>> brk := ['\r\n'].
	>> str := [''].
	str aggiungere: (io header: ['From: '] + mio from-name + [' <'] + ( mio from ) + ['>']) + brk.
	str aggiungere: (io header: ['To: '] + ( mio recipients aderire: [','] )) + brk.
	mio cc contare vero: {
		str aggiungere: (io header: ['Cc: '] + ( mio cc aderire: [','] )) + brk.
	}.
	mio bcc contare vero: {
		str aggiungere: (io header: ['Bcc: '] + ( mio bcc aderire: [','] )) + brk.
	}.
	str aggiungere: (io header: ['Subject: '] + mio subject) + brk.
	str aggiungere: brk.
	str aggiungere: mio body.
	str aggiungere: brk. <- str.
}.

>> HTML-Email := Email nuovo.

HTML-Email on: ['init'] fare: {
	io init.
	mio attachments := Serie nuovo.
	mio boundary := Caveau token: 40.
}.

HTML-Email on: ['attach:'] fare: { :file
	>> id := mio attachments contare.
	>> blob := file blob.
	mio attachments aggiungere: (
		Elenco nuovo
			file: file sentiero,
			mime: ['image/'] + (Server mimetype: file sentiero),
			data: blob base64-codifica
	).
	blob libero. <- ['cid:attachment'] + id.
}.

HTML-Email on: ['generate'] fare: {
	>> brk := ['\r\n'].
	>> str := [''].
	str aggiungere: (io header: ['From: '] + mio from-name + [' <'] + ( mio from ) + ['>']) + brk.
	str aggiungere: (io header: ['To: '] + ( mio recipients aderire: [','] )) + brk.
	mio cc contare vero: {
		str aggiungere: (io header: ['Cc: '] + ( mio cc aderire: [','] )) + brk.
	}.
	mio bcc contare vero: {
		str aggiungere: (io header: ['Bcc: '] + ( mio bcc aderire: [','] )) + brk.
	}.
	str aggiungere: (io header: ['Subject: '] + mio subject) + brk.
	str aggiungere: ['MIME-Version: 1.0'] + brk.
	str aggiungere: ['Content-Type: multipart/related; boundary="'] + mio boundary + ['"; type=text/html'] + brk.
	str aggiungere: brk.
	str aggiungere: ['--'] + mio boundary + brk.
	str aggiungere: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str aggiungere: ['Content-Transfer-Encoding: 7bit'] + brk.
	str aggiungere: brk.
	str aggiungere: mio body.
	str aggiungere: brk.
	mio attachments ogni: { :id :info
		>> blob := info data.
		str aggiungere: ['--'] + mio boundary + brk.
		str aggiungere: ['Content-Type: '] + info mime + brk.
		str aggiungere: ['Content-Transfer-Encoding: base64'] + brk.
		str aggiungere: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str aggiungere: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str aggiungere: brk.
		>> max := 76.
		>> len := blob lunghezza.
		>> chunks := (len / max) eccesso.
		{ :i
			>> chunk := blob copia da: i * max lunghezza: max.
			str aggiungere: chunk + brk.
		} * chunks.
		str aggiungere: brk.
		str aggiungere: brk.
	}.
	str aggiungere: ['--'] + mio boundary + ['--'] + brk. <- str.
}.
