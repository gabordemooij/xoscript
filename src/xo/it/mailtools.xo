>> Email := Oggetto nuovo.

Email on: ['inizializzare'] fare: {
	mio destinatari := Serie nuovo.
	mio cc := Serie nuovo.
	mio bcc := Serie nuovo.
	mio mittente := Nil.
	mio nome-mittente := Nil.
	mio soggetto := Nil.
	mio corpo := Nil.
}.

Email on: ['nuovo'] fare: { <- io nuovo inizializzare.
}.

Email on: ['destinatario:'] fare: { :elenco
	mio destinatari := elenco.
}.
 
Email on: ['cc:'] fare: { :elenco
	mio cc := elenco.
}.

Email on: ['bcc:'] fare: { :elenco
	mio bcc := elenco.
}.

Email on: ['soggetto:'] fare: { :soggetto
	mio soggetto := soggetto.
}.

Email on: ['mittente:nome:'] fare: { :mittente :nome
	mio mittente := mittente.
	mio nome-mittente := nome.
}.

Email on: ['corpo:'] fare: { :corpo
	mio corpo := corpo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email on: ['intestazione:'] fare: { :riga <- riga sostituirlo: ['\r'] con: [''], sostituirlo: ['\n'] con: [''].
}.

Email on: ['inviare'] fare: {
	>> f := File tempwrite: io generare.
	Programma sistema: ['sendmail -t < '] + f sentiero, stop.
}.

Email on: ['generare'] fare: {
	>> acapo := ['\r\n'].
	>> stringa := [''].
	stringa aggiungere: (io intestazione: ['From: '] + mio nome-mittente + [' <'] + ( mio mittente ) + ['>']) + acapo.
	stringa aggiungere: (io intestazione: ['To: '] + ( mio destinatari aderire: [','] )) + acapo.
	mio cc contare vero: {
		stringa aggiungere: (io intestazione: ['Cc: '] + ( mio cc aderire: [','] )) + acapo.
	}.
	mio bcc contare vero: {
		stringa aggiungere: (io intestazione: ['Bcc: '] + ( mio bcc aderire: [','] )) + acapo.
	}.
	stringa aggiungere: (io intestazione: ['Subject: '] + mio soggetto) + acapo.
	stringa aggiungere: acapo.
	stringa aggiungere: mio corpo.
	stringa aggiungere: acapo. <- stringa.
}.

>> Email-HTML := Email nuovo.

Email-HTML on: ['inizializzare'] fare: {
	io inizializzare.
	mio allegati := Serie nuovo.
	mio confine := Caveau token: 40.
}.

Email-HTML on: ['allegare:'] fare: { :file
	>> id := mio allegati contare.
	>> blob := file blob.
	mio allegati aggiungere: (
		Elenco nuovo
			file: file sentiero,
			mime: ['image/'] + (Server mimetype: file sentiero),
			dati: blob base64-codifica
	).
	blob libero. <- ['cid:attachment'] + id.
}.

Email-HTML on: ['generare'] fare: {
	>> acapo := ['\r\n'].
	>> stringa := [''].
	stringa aggiungere: (io intestazione: ['From: '] + mio nome-mittente + [' <'] + ( mio mittente ) + ['>']) + acapo.
	stringa aggiungere: (io intestazione: ['To: '] + ( mio destinatari aderire: [','] )) + acapo.
	mio cc contare vero: {
		stringa aggiungere: (io intestazione: ['Cc: '] + ( mio cc aderire: [','] )) + acapo.
	}.
	mio bcc contare vero: {
		stringa aggiungere: (io intestazione: ['Bcc: '] + ( mio bcc aderire: [','] )) + acapo.
	}.
	stringa aggiungere: (io intestazione: ['Subject: '] + mio soggetto) + acapo.
	stringa aggiungere: ['MIME-Version: 1.0'] + acapo.
	stringa aggiungere: ['Content-Type: multipart/related; boundary="'] + mio confine + ['"; type=text/html'] + acapo.
	stringa aggiungere: acapo.
	stringa aggiungere: ['--'] + mio confine + acapo.
	stringa aggiungere: ['Content-Type: text/html; charset=UTF-8'] + acapo.
	stringa aggiungere: ['Content-Transfer-Encoding: 7bit'] + acapo.
	stringa aggiungere: acapo.
	stringa aggiungere: mio corpo.
	stringa aggiungere: acapo.
	mio allegati ogni: { :id :info
		>> blob := info dati.
		stringa aggiungere: ['--'] + mio confine + acapo.
		stringa aggiungere: ['Content-Type: '] + info mime + acapo.
		stringa aggiungere: ['Content-Transfer-Encoding: base64'] + acapo.
		stringa aggiungere: ['Content-ID: <attachment'] + id + ['>'] + acapo.
		stringa aggiungere: ['Content-Disposition: inline; filename="'] + info file + ['"'] + acapo.
		stringa aggiungere: acapo.
		>> tetto := 76.
		>> lunghezza-testo := blob lunghezza.
		>> pezzi := (lunghezza-testo / tetto) eccesso.
		{ :i
			>> pezzo := blob copia da: i * tetto lunghezza: tetto.
			stringa aggiungere: pezzo + acapo.
		} * pezzi.
		stringa aggiungere: acapo.
		stringa aggiungere: acapo.
	}.
	stringa aggiungere: ['--'] + mio confine + ['--'] + acapo. <- stringa.
}.
