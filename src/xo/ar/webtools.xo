طلب-HTTP عند: ['HTTP-header:'] نفذ: { :key <- برنامج إعداد: key.
}.

>> HTTP-Header := كائن جديد.

HTTP-Header عند: ['جديد'] نفذ: { <- ذات جديد init.
}.

HTTP-Header عند: ['init'] نفذ: {
	خاص key := لاشيء.
	خاص value := لاشيء.
}.

HTTP-Header عند: ['key:value:'] نفذ: { :key :value
	خاص key := key.
	خاص value := value.
}.

HTTP-Header عند: ['key'] نفذ: { <- خاص key.
}.

HTTP-Header عند: ['value'] نفذ: { <- خاص value.
}.


HTTP-Header عند: ['كنص'] نفذ: {
	>> line := خاص key + [': '] + خاص value.
	line استبدل: ['\r'] ببديل: [''], استبدل: ['\n'] ببديل: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := كائن جديد.

Web-Document عند: ['جديد'] نفذ: { <- ذات جديد init.
}.

Web-Document عند: ['init'] نفذ: {
	خاص headers := قائمة جديد.
	خاص sess-id := لاشيء.
	خاص session-manager := Tempfile-Session جديد.
	خاص sessdata := لاشيء.
	خاص secure := صحيح.
	خاص same-site := ['Strict'].
	خاص headers-out := خطأ.
	خاص request := طلب-HTTP جديد.
}.

Web-Document عند: ['request:'] نفذ: { :request
	خاص request := request.
}. 

Web-Document عند: ['secure-session-cookie:'] نفذ: { :secure
	ذات check-headers.
	خاص secure := secure.
}.

Web-Document عند: ['same-site-session-cookie:'] نفذ: { :value
	ذات check-headers.
	>> options := قائمة جديد 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options يحتوي: value, إذا-خطأ: {
		هذه-المهمة خطأ-مخرج: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	خاص same-site := value.
}.

Web-Document عند: ['header:'] نفذ: { :header
	ذات check-headers.
	خاص headers ألحق: header.
}.

Web-Document عند: ['clear-headers'] نفذ: {
	ذات check-headers.
	خاص headers := قائمة جديد.
}.

Web-Document عند: ['session-manager:'] نفذ: { :manager
	ذات check-headers.
	خاص session-manager := manager.
}.

Web-Document عند: ['session-manager'] نفذ: { <- خاص session-manager.
}.

Web-Document عند: ['check-headers'] نفذ: {
	خاص headers-out إذا-صحيح: {
		هذه-المهمة خطأ-مخرج: ['Headers already sent to client.'].
	}.
}.

Web-Document عند: ['session-start'] نفذ: {
	ذات check-headers.
	>> request := خاص request.
	>> sess-id := request cookie: ['xsid'].
	sess-id لاشيء? إذا-خطأ: {
		(( نمط جديد: ['^[A-Za-z0-9]+\\z'], طابق: sess-id ) = 0) إذا-صحيح: {
			sess-id := لاشيء.
		}.
	}.
	sess-id لاشيء? إذا-صحيح: {
		sess-id := خزنة رمز-مميز: 30.
		>> session-header := HTTP-Header جديد
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (خاص secure إما: ['Secure'] وإما: ['']),
		SSITE: (خاص same-site),
		XSID: sess-id
		).
		خاص headers ألحق: session-header.
	}.
	خاص sessdata := خاص session-manager for: sess-id, load. <- خاص sessdata. # reference
}.

Web-Document عند: ['goto:'] نفذ: { :url
	ذات check-headers.
	ذات clear-headers.
	خاص headers
	ألحق: (
		HTTP-Header جديد
		key: ['Status'] value: ['303 See Other']
	),
	ألحق: (
		HTTP-Header جديد
		key: ['Location'] value: url
	).
	ذات out: ['Redirect'].
}.

Web-Document عند: ['session-destroy'] نفذ: {
	ذات check-headers.
	>> request := خاص request.
	>> sess-id := request cookie: ['xsid'].
	sess-id لاشيء? إذا-خطأ: {
		>> session-header := HTTP-Header جديد.
		>> when := لحظة جديد سنة: 1970, بتنسيق: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (خاص secure إما: ['Secure'] وإما: ['']),
			SSITE: (خاص same-site),
			XSID: sess-id
		).
		خاص session-manager destroy.
		خاص headers ألحق: session-header.
	}.
}.


Web-Document عند: ['template:'] نفذ: { :مسار-الملف <- Template جديد: (ملف جديد: مسار-الملف, اقرأ).
}.

Web-Document عند: ['out:type:'] نفذ: { :output :نوع
	خاص headers-out إذا-خطأ: {
		خاص sessdata لاشيء? إذا-خطأ: {
			خاص session-manager save: خاص sessdata.
		}.
		خاص headers ألحق: (
			HTTP-Header جديد
			key: ['Content-type'] value: نوع
		).
		خاص headers لكل: { :_ :header
			مخرج اكتب: header.
		}.
		خاص headers-out := صحيح.
		مخرج اكتب: ['\r\n'].
	}.
	مخرج اكتب: output.
}.

Web-Document عند: ['finish:type:'] نفذ: { :output :نوع
	خاص headers-out إذا-خطأ: {
		خاص sessdata لاشيء? إذا-خطأ: {
			خاص session-manager save: خاص sessdata.
		}.
		خاص headers ألحق: (
			HTTP-Header جديد
			key: ['Content-type'] value: نوع
		).
		خاص headers ألحق: (
			HTTP-Header جديد
			key: ['Content-Length'] value: output كنص بايتات
		).
		خاص headers لكل: { :_ :header
			مخرج اكتب: header.
		}.
		خاص headers-out := صحيح.
		مخرج اكتب: ['\r\n'].
	}.
	مخرج اكتب: output.
}.

Web-Document عند: ['out:'] نفذ: { :output
	ذات out: output type: ['text/html; charset=utf-8'].
}.

Web-Document عند: ['finish:'] نفذ: { :output
	ذات finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document عند: ['json:'] نفذ: { :output
	ذات out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document عند: ['not-found:'] نفذ: { :output
	ذات clear-headers header: (
		HTTP-Header جديد key: ['Status'] value: ['404 Not Found']
	).
	ذات out: output.
}.


# Interface

>> Session := كائن جديد.

Session عند: ['جديد'] نفذ: { <- ذات جديد init for: لاشيء.
}.

Session عند: ['for:'] نفذ: { :id
	خاص id := id.
}.

Session عند: ['load'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

Session عند: ['save:'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

Session عند: ['destroy'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session جديد.

Tempfile-Session عند: ['init'] نفذ: {
	خاص pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session عند: ['path-prefix:'] نفذ: { :str
	خاص pathprefix := str.
}.

Tempfile-Session عند: ['file'] نفذ: { <- ( ملف جديد: ( خاص pathprefix + خاص id + ['.txt'] ) ).
}.

Tempfile-Session عند: ['load'] نفذ: {
	>> file := ذات file.
	file موجود إذا-خطأ: {
		file اكتب: (قاموس جديد شفرة).
	}. <- file اقرأ ككائن.
}.

Tempfile-Session عند: ['save:'] نفذ: { :data
	>> file := ذات file.
	file موجود إذا-صحيح: {
		file اكتب: data شفرة.
	}.
}.

Tempfile-Session عند: ['destroy'] نفذ: {
	>> file := ذات file.
	file موجود إذا-صحيح: {
		file احذف.
	}.
}.


>> URL := كائن جديد.

URL عند: ['init'] نفذ: {
	خاص protocol := ['https://'].
	خاص مضيف := ['localhost'].
	خاص مسار-الملف := [''].
	خاص params := [''].
	خاص hash := [''].
}.

URL عند: ['جديد'] نفذ: { <- ذات جديد init.
}.

URL عند: ['كنص'] نفذ: { <- (
	خاص protocol +
	خاص مضيف +
	خاص مسار-الملف +
	خاص params +
	خاص hash ).
}.

URL عند: ['protocol:'] نفذ: { :protocol
	((قائمة جديد: ['http'] ; ['https']) يحتوي: protocol) إذا-صحيح: {
		خاص protocol := protocol + ['://'].
	}, إذا-خطأ: {
		هذه-المهمة خطأ-مخرج: ['Invalid protocol'].
	}.
}.

URL عند: ['مضيف:'] نفذ: { :مضيف
	#todo validate according to rfc
	خاص مضيف := مضيف.
}.

URL عند: ['path:'] نفذ: { :مسار-الملف
	خاص مسار-الملف := ['/'] + مسار-الملف url-ترميز.
}.

URL عند: ['params:'] نفذ: { :map
	>> params := قائمة جديد.
	map لكل: { :key :value
		params ألحق: key كنص url-ترميز + ['='] + value كنص url-ترميز.
	}.
	خاص params := ['?'] + ( params ادمج: ['&'] ).
}.

URL عند: ['تجزئة:'] نفذ: { :hash
	خاص hash := ['#'] + hash url-ترميز.
}.

