طلب-HTTP عند: ['HTTP-ترويسة:'] نفذ: { :مفتاح <- برنامج إعداد: مفتاح.
}.

>> ترويسة-HTTP := كائن جديد.

ترويسة-HTTP عند: ['جديد'] نفذ: { <- ذات جديد هيئ.
}.

ترويسة-HTTP عند: ['هيئ'] نفذ: {
	خاص مفتاح := لاشيء.
	خاص قيمة := لاشيء.
}.

ترويسة-HTTP عند: ['مفتاح:قيمة:'] نفذ: { :مفتاح :قيمة
	خاص مفتاح := مفتاح.
	خاص قيمة := قيمة.
}.

ترويسة-HTTP عند: ['مفتاح'] نفذ: { <- خاص مفتاح.
}.

ترويسة-HTTP عند: ['قيمة'] نفذ: { <- خاص قيمة.
}.


ترويسة-HTTP عند: ['كنص'] نفذ: {
	>> سطر := خاص مفتاح + [': '] + خاص قيمة.
	سطر استبدل: ['\r'] ببديل: [''], استبدل: ['\n'] ببديل: ['']. <- سطر + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> مستند-ويب := كائن جديد.

مستند-ويب عند: ['جديد'] نفذ: { <- ذات جديد هيئ.
}.

مستند-ويب عند: ['هيئ'] نفذ: {
	خاص ترويسات := قائمة جديد.
	خاص معرف-الجلسة := لاشيء.
	خاص مدير-الجلسات := جلسة-ملف-مؤقت جديد.
	خاص بيانات-الجلسة := لاشيء.
	خاص آمن := صحيح.
	خاص نفس-الموقع := ['Strict'].
	خاص ترويسات-مرسلة := خطأ.
	خاص طلب-http := طلب-HTTP جديد.
}.

مستند-ويب عند: ['طلب-http:'] نفذ: { :طلب-http
	خاص طلب-http := طلب-http.
}. 

مستند-ويب عند: ['كعكة-جلسة-آمنة:'] نفذ: { :آمن
	ذات افحص-الترويسات.
	خاص آمن := آمن.
}.

مستند-ويب عند: ['كعكة-جلسة-نفس-الموقع:'] نفذ: { :قيمة
	ذات افحص-الترويسات.
	>> خيارات := قائمة جديد 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	خيارات يملك: قيمة, إذا-خطأ: {
		هذه-المهمة خطأ-مخرج: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	خاص نفس-الموقع := قيمة.
}.

مستند-ويب عند: ['ترويسة:'] نفذ: { :ترويسة
	ذات افحص-الترويسات.
	خاص ترويسات ألحق: ترويسة.
}.

مستند-ويب عند: ['أفرغ-الترويسات'] نفذ: {
	ذات افحص-الترويسات.
	خاص ترويسات := قائمة جديد.
}.

مستند-ويب عند: ['مدير-الجلسات:'] نفذ: { :مدير
	ذات افحص-الترويسات.
	خاص مدير-الجلسات := مدير.
}.

مستند-ويب عند: ['مدير-الجلسات'] نفذ: { <- خاص مدير-الجلسات.
}.

مستند-ويب عند: ['افحص-الترويسات'] نفذ: {
	خاص ترويسات-مرسلة إذا-صحيح: {
		هذه-المهمة خطأ-مخرج: ['Headers already sent to client.'].
	}.
}.

مستند-ويب عند: ['ابدأ-الجلسة'] نفذ: {
	ذات افحص-الترويسات.
	>> طلب-http := خاص طلب-http.
	>> معرف-الجلسة := طلب-http cookie: ['xsid'].
	معرف-الجلسة لاشيء? إذا-خطأ: {
		(( نمط جديد: ['^[A-Za-z0-9]+\\z'], طابق: معرف-الجلسة ) = 0) إذا-صحيح: {
			معرف-الجلسة := لاشيء.
		}.
	}.
	معرف-الجلسة لاشيء? إذا-صحيح: {
		معرف-الجلسة := خزنة رمز-مميز: 30.
		>> ترويسة-الجلسة := ترويسة-HTTP جديد
		مفتاح: ['Set-Cookie'] قيمة: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (خاص آمن إما: ['Secure'] وإما: ['']),
		SSITE: (خاص نفس-الموقع),
		XSID: معرف-الجلسة
		).
		خاص ترويسات ألحق: ترويسة-الجلسة.
	}.
	خاص بيانات-الجلسة := خاص مدير-الجلسات لأجل: معرف-الجلسة, حمل. <- خاص بيانات-الجلسة. # reference
}.

مستند-ويب عند: ['اذهب-إلى:'] نفذ: { :عنوان
	ذات افحص-الترويسات.
	ذات أفرغ-الترويسات.
	خاص ترويسات
	ألحق: (
		ترويسة-HTTP جديد
		مفتاح: ['Status'] قيمة: ['303 See Other']
	),
	ألحق: (
		ترويسة-HTTP جديد
		مفتاح: ['Location'] قيمة: عنوان
	).
	ذات أخرج: ['Redirect'].
}.

مستند-ويب عند: ['دمر-الجلسة'] نفذ: {
	ذات افحص-الترويسات.
	>> طلب-http := خاص طلب-http.
	>> معرف-الجلسة := طلب-http cookie: ['xsid'].
	معرف-الجلسة لاشيء? إذا-خطأ: {
		>> ترويسة-الجلسة := ترويسة-HTTP جديد.
		>> وقت-انتهاء := لحظة جديد سنة: 1970, بتنسيق: ['%a, %d %b %Y %H:%M:%S GMT'].
		ترويسة-الجلسة مفتاح: ['Set-Cookie'] قيمة: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: وقت-انتهاء,
			SEC: (خاص آمن إما: ['Secure'] وإما: ['']),
			SSITE: (خاص نفس-الموقع),
			XSID: معرف-الجلسة
		).
		خاص مدير-الجلسات دمر.
		خاص ترويسات ألحق: ترويسة-الجلسة.
	}.
}.


مستند-ويب عند: ['قالب:'] نفذ: { :مسار-الملف <- قالب جديد: (ملف جديد: مسار-الملف, اقرأ).
}.

مستند-ويب عند: ['أخرج:نوع:'] نفذ: { :ناتج :نوع
	خاص ترويسات-مرسلة إذا-خطأ: {
		خاص بيانات-الجلسة لاشيء? إذا-خطأ: {
			خاص مدير-الجلسات احفظ: خاص بيانات-الجلسة.
		}.
		خاص ترويسات ألحق: (
			ترويسة-HTTP جديد
			مفتاح: ['Content-type'] قيمة: نوع
		).
		خاص ترويسات لكل: { :_ :ترويسة
			مخرج اكتب: ترويسة.
		}.
		خاص ترويسات-مرسلة := صحيح.
		مخرج اكتب: ['\r\n'].
	}.
	مخرج اكتب: ناتج.
}.

مستند-ويب عند: ['أنه:نوع:'] نفذ: { :ناتج :نوع
	خاص ترويسات-مرسلة إذا-خطأ: {
		خاص بيانات-الجلسة لاشيء? إذا-خطأ: {
			خاص مدير-الجلسات احفظ: خاص بيانات-الجلسة.
		}.
		خاص ترويسات ألحق: (
			ترويسة-HTTP جديد
			مفتاح: ['Content-type'] قيمة: نوع
		).
		خاص ترويسات ألحق: (
			ترويسة-HTTP جديد
			مفتاح: ['Content-Length'] قيمة: ناتج كنص بايتات
		).
		خاص ترويسات لكل: { :_ :ترويسة
			مخرج اكتب: ترويسة.
		}.
		خاص ترويسات-مرسلة := صحيح.
		مخرج اكتب: ['\r\n'].
	}.
	مخرج اكتب: ناتج.
}.

مستند-ويب عند: ['أخرج:'] نفذ: { :ناتج
	ذات أخرج: ناتج نوع: ['text/html; charset=utf-8'].
}.

مستند-ويب عند: ['أنه:'] نفذ: { :ناتج
	ذات أنه: ناتج نوع: ['text/html; charset=utf-8'].
}.

مستند-ويب عند: ['json:'] نفذ: { :ناتج
	ذات أخرج: ( JSON jsonify: ناتج ) نوع: ['application/json'].
}.

مستند-ويب عند: ['غير-موجود:'] نفذ: { :ناتج
	ذات أفرغ-الترويسات ترويسة: (
		ترويسة-HTTP جديد مفتاح: ['Status'] قيمة: ['404 Not Found']
	).
	ذات أخرج: ناتج.
}.


# Interface

>> جلسة := كائن جديد.

جلسة عند: ['جديد'] نفذ: { <- ذات جديد هيئ لأجل: لاشيء.
}.

جلسة عند: ['لأجل:'] نفذ: { :id
	خاص id := id.
}.

جلسة عند: ['حمل'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

جلسة عند: ['احفظ:'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

جلسة عند: ['دمر'] نفذ: {
	هذه-المهمة خطأ-مخرج: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> جلسة-ملف-مؤقت := جلسة جديد.

جلسة-ملف-مؤقت عند: ['هيئ'] نفذ: {
	خاص بداية-المسار := ['/tmp/sess-'].
}.

جلسة-ملف-مؤقت عند: ['بادئة-المسار:'] نفذ: { :سلسلة-نصية
	خاص بداية-المسار := سلسلة-نصية.
}.

جلسة-ملف-مؤقت عند: ['ملف-الجلسة'] نفذ: { <- ( ملف جديد: ( خاص بداية-المسار + خاص id + ['.txt'] ) ).
}.

جلسة-ملف-مؤقت عند: ['حمل'] نفذ: {
	>> ملف-الجلسة := ذات ملف-الجلسة.
	ملف-الجلسة موجود إذا-خطأ: {
		ملف-الجلسة اكتب: (قاموس جديد شفرة).
	}. <- ملف-الجلسة اقرأ ككائن.
}.

جلسة-ملف-مؤقت عند: ['احفظ:'] نفذ: { :بيانات
	>> ملف-الجلسة := ذات ملف-الجلسة.
	ملف-الجلسة موجود إذا-صحيح: {
		ملف-الجلسة اكتب: بيانات شفرة.
	}.
}.

جلسة-ملف-مؤقت عند: ['دمر'] نفذ: {
	>> ملف-الجلسة := ذات ملف-الجلسة.
	ملف-الجلسة موجود إذا-صحيح: {
		ملف-الجلسة احذف.
	}.
}.


>> URL := كائن جديد.

URL عند: ['هيئ'] نفذ: {
	خاص بروتوكول := ['https://'].
	خاص مضيف := ['localhost'].
	خاص مسار-الملف := [''].
	خاص معاملات-url := [''].
	خاص hash := [''].
}.

URL عند: ['جديد'] نفذ: { <- ذات جديد هيئ.
}.

URL عند: ['كنص'] نفذ: { <- (
	خاص بروتوكول +
	خاص مضيف +
	خاص مسار-الملف +
	خاص معاملات-url +
	خاص hash ).
}.

URL عند: ['بروتوكول:'] نفذ: { :بروتوكول
	((قائمة جديد ; ['http'] ; ['https']) يملك: بروتوكول) إذا-صحيح: {
		خاص بروتوكول := بروتوكول + ['://'].
	}, إذا-خطأ: {
		هذه-المهمة خطأ-مخرج: ['Invalid protocol'].
	}.
}.

URL عند: ['مضيف:'] نفذ: { :مضيف
	#todo validate according to rfc
	خاص مضيف := مضيف.
}.

URL عند: ['مسار-الملف:'] نفذ: { :مسار-الملف
	خاص مسار-الملف := ['/'] + مسار-الملف url-ترميز.
}.

URL عند: ['معاملات-url:'] نفذ: { :مطابقة
	>> معاملات-url := قائمة جديد.
	مطابقة لكل: { :مفتاح :قيمة
		معاملات-url ألحق: مفتاح كنص url-ترميز + ['='] + قيمة كنص url-ترميز.
	}.
	خاص معاملات-url := ['?'] + ( معاملات-url ادمج: ['&'] ).
}.

URL عند: ['تجزئة:'] نفذ: { :hash
	خاص hash := ['#'] + hash url-ترميز.
}.

