
# ~ Simple template engine ~

>> قالب := كائن جديد.

قالب عند: ['جديد'] نفذ: { <- ذات جديد محتوى: [''].
}.

قالب عند: ['محتوى:'] نفذ: { :محتوى
	خاص محتوى := محتوى. 
}.

قالب عند: ['جديد:'] نفذ: { :محتوى <- ذات جديد محتوى: محتوى.
}.

قالب عند: ['قص:'] نفذ: { :علامة
	>> علامة-البداية := (['<!-- cut:%id% -->'] %id%: علامة).
	>> علامة-النهاية := (['<!-- /cut:%id% -->'] %id%: علامة).
	>> أقسام := خاص محتوى قسم: علامة-البداية.
	>> بادئة := أقسام الأول.
	>> أقسام2 := أقسام الأخير قسم: علامة-النهاية.
	>> لاحقة := أقسام2 الأخير.
	>> قسم := أقسام2 الأول.
	>> باقي := بادئة + لاحقة.
	خاص محتوى := باقي. <- قالب جديد: قسم.
	
}.

قالب عند: ['انسخ'] نفذ: { <- ذات جديد: ذات كنص انسخ.
}.
	
قالب عند: ['ألصق:عند:'] نفذ: { :مقتطف :id
	>> علامة-اللصق := (['<!-- paste:%id% -->'] %id%: id).
	خاص محتوى استبدل: علامة-اللصق ببديل: ( مقتطف كنص + علامة-اللصق ).
}.

قالب عند: ['عين:قيمة:'] نفذ: { :خانة :قيمة
	خاص محتوى استبدل: ['<!-- slot:'] + خانة + [' -->'] ببديل: ( Server html-ترميز: قيمة ).
}.

قالب عند: ['عين:html:'] نفذ: { :خانة :html
	خاص محتوى استبدل: ['<!-- slot:'] + خانة + [' -->'] ببديل: html.
}.

قالب عند: ['استجب:و:'] نفذ: { :خانة :قيمة
	ذات عين: (خانة بداية: 0 طول: (خانة طول - 1)) قيمة: قيمة.
}.

قالب عند: ['nl2br'] نفذ: {
	خاص محتوى استبدل: ['\n'] ببديل: ['<br>'].
}.

قالب عند: ['هذب'] نفذ: {
	خاص محتوى :=
		نمط
		جديد: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		طابق: خاص محتوى
		نفذ: { <- ['']. }.
}.

قالب عند: ['هذب-القصاصات'] نفذ: {
	>> عناصر := قائمة جديد.
	نمط
	جديد: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	طابق: خاص محتوى
	نفذ: { :_ :قسم
		عناصر ألحق: قسم ? 1.
	}.
	عناصر لكل: { :_ :id
		خاص محتوى :=
			نمط جديد: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			طابق: خاص محتوى
			نفذ: { <- ['']. }.
	 }.
}.

قالب عند: ['هذب-المسافات'] نفذ: {
	خاص محتوى :=
		نمط
		جديد: ['\\s*\\n'],
		طابق: خاص محتوى
		نفذ: { <- ['\n']. }.
	خاص محتوى :=
		نمط
		جديد: ['\\n[\\s\\t]+'],
		طابق: خاص محتوى
		نفذ: { <- ['\n']. }.
}.

قالب عند: ['هذب-الكل'] نفذ: {
	ذات هذب.
	ذات هذب-القصاصات.
	ذات هذب-المسافات.
}.

قالب عند: ['كنص'] نفذ: { <- خاص محتوى.
}.
