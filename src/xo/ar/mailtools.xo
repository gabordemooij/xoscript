>> بريد-إلكتروني := كائن جديد.

بريد-إلكتروني عند: ['هيئ'] نفذ: {
	خاص المستلمون := قائمة جديد.
	خاص cc := قائمة جديد.
	خاص bcc := قائمة جديد.
	خاص المرسل := لاشيء.
	خاص اسم-المرسل := لاشيء.
	خاص الموضوع := لاشيء.
	خاص متن := لاشيء.
}.

بريد-إلكتروني عند: ['جديد'] نفذ: { <- ذات جديد هيئ.
}.

بريد-إلكتروني عند: ['إلى:'] نفذ: { :تعداد
	خاص المستلمون := تعداد.
}.
 
بريد-إلكتروني عند: ['cc:'] نفذ: { :تعداد
	خاص cc := تعداد.
}.

بريد-إلكتروني عند: ['bcc:'] نفذ: { :تعداد
	خاص bcc := تعداد.
}.

بريد-إلكتروني عند: ['الموضوع:'] نفذ: { :الموضوع
	خاص الموضوع := الموضوع.
}.

بريد-إلكتروني عند: ['المرسل:اسم:'] نفذ: { :المرسل :اسم
	خاص المرسل := المرسل.
	خاص اسم-المرسل := اسم.
}.

بريد-إلكتروني عند: ['متن:'] نفذ: { :متن
	خاص متن := متن.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
بريد-إلكتروني عند: ['ترويسة:'] نفذ: { :سطر <- سطر استبدل: ['\r'] ببديل: [''], استبدل: ['\n'] ببديل: [''].
}.

بريد-إلكتروني عند: ['أرسل'] نفذ: {
	>> f := ملف كتابة-مؤقتة: ذات ولد.
	برنامج نظام: ['sendmail -t < '] + f مسار-الملف, سطر-جديد.
}.

بريد-إلكتروني عند: ['ولد'] نفذ: {
	>> فاصل-سطر := ['\r\n'].
	>> سلسلة-نصية := [''].
	سلسلة-نصية ألحق: (ذات ترويسة: ['From: '] + خاص اسم-المرسل + [' <'] + ( خاص المرسل ) + ['>']) + فاصل-سطر.
	سلسلة-نصية ألحق: (ذات ترويسة: ['To: '] + ( خاص المستلمون ادمج: [','] )) + فاصل-سطر.
	خاص cc عدد-العناصر إذا-صحيح: {
		سلسلة-نصية ألحق: (ذات ترويسة: ['Cc: '] + ( خاص cc ادمج: [','] )) + فاصل-سطر.
	}.
	خاص bcc عدد-العناصر إذا-صحيح: {
		سلسلة-نصية ألحق: (ذات ترويسة: ['Bcc: '] + ( خاص bcc ادمج: [','] )) + فاصل-سطر.
	}.
	سلسلة-نصية ألحق: (ذات ترويسة: ['Subject: '] + خاص الموضوع) + فاصل-سطر.
	سلسلة-نصية ألحق: فاصل-سطر.
	سلسلة-نصية ألحق: خاص متن.
	سلسلة-نصية ألحق: فاصل-سطر. <- سلسلة-نصية.
}.

>> بريد-HTML := بريد-إلكتروني جديد.

بريد-HTML عند: ['هيئ'] نفذ: {
	ذات هيئ.
	خاص مرفقات := قائمة جديد.
	خاص حد := خزنة رمز-مميز: 40.
}.

بريد-HTML عند: ['أرفق:'] نفذ: { :ملف-الجلسة
	>> id := خاص مرفقات عدد-العناصر.
	>> blob := ملف-الجلسة blob.
	خاص مرفقات ألحق: (
		قاموس جديد
			ملف-الجلسة: ملف-الجلسة مسار-الملف,
			mime: ['image/'] + (Server mimetype: ملف-الجلسة مسار-الملف),
			بيانات: blob base64-ترميز
	).
	blob حرر. <- ['cid:attachment'] + id.
}.

بريد-HTML عند: ['ولد'] نفذ: {
	>> فاصل-سطر := ['\r\n'].
	>> سلسلة-نصية := [''].
	سلسلة-نصية ألحق: (ذات ترويسة: ['From: '] + خاص اسم-المرسل + [' <'] + ( خاص المرسل ) + ['>']) + فاصل-سطر.
	سلسلة-نصية ألحق: (ذات ترويسة: ['To: '] + ( خاص المستلمون ادمج: [','] )) + فاصل-سطر.
	خاص cc عدد-العناصر إذا-صحيح: {
		سلسلة-نصية ألحق: (ذات ترويسة: ['Cc: '] + ( خاص cc ادمج: [','] )) + فاصل-سطر.
	}.
	خاص bcc عدد-العناصر إذا-صحيح: {
		سلسلة-نصية ألحق: (ذات ترويسة: ['Bcc: '] + ( خاص bcc ادمج: [','] )) + فاصل-سطر.
	}.
	سلسلة-نصية ألحق: (ذات ترويسة: ['Subject: '] + خاص الموضوع) + فاصل-سطر.
	سلسلة-نصية ألحق: ['MIME-Version: 1.0'] + فاصل-سطر.
	سلسلة-نصية ألحق: ['Content-Type: multipart/related; boundary="'] + خاص حد + ['"; type=text/html'] + فاصل-سطر.
	سلسلة-نصية ألحق: فاصل-سطر.
	سلسلة-نصية ألحق: ['--'] + خاص حد + فاصل-سطر.
	سلسلة-نصية ألحق: ['Content-Type: text/html; charset=UTF-8'] + فاصل-سطر.
	سلسلة-نصية ألحق: ['Content-Transfer-Encoding: 7bit'] + فاصل-سطر.
	سلسلة-نصية ألحق: فاصل-سطر.
	سلسلة-نصية ألحق: خاص متن.
	سلسلة-نصية ألحق: فاصل-سطر.
	خاص مرفقات لكل: { :id :معلومات
		>> blob := معلومات بيانات.
		سلسلة-نصية ألحق: ['--'] + خاص حد + فاصل-سطر.
		سلسلة-نصية ألحق: ['Content-Type: '] + معلومات mime + فاصل-سطر.
		سلسلة-نصية ألحق: ['Content-Transfer-Encoding: base64'] + فاصل-سطر.
		سلسلة-نصية ألحق: ['Content-ID: <attachment'] + id + ['>'] + فاصل-سطر.
		سلسلة-نصية ألحق: ['Content-Disposition: inline; filename="'] + معلومات ملف-الجلسة + ['"'] + فاصل-سطر.
		سلسلة-نصية ألحق: فاصل-سطر.
		>> أقصى := 76.
		>> طول-النص := blob طول.
		>> قطع := (طول-النص / أقصى) تقريب-للأعلى.
		{ :i
			>> قطعة := blob انسخ بداية: i * أقصى طول: أقصى.
			سلسلة-نصية ألحق: قطعة + فاصل-سطر.
		} * قطع.
		سلسلة-نصية ألحق: فاصل-سطر.
		سلسلة-نصية ألحق: فاصل-سطر.
	}.
	سلسلة-نصية ألحق: ['--'] + خاص حد + ['--'] + فاصل-سطر. <- سلسلة-نصية.
}.
