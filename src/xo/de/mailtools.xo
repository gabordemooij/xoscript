>> E-Mail := Objekt neu.

E-Mail wenn: ['initialisieren'] tun: {
	eigen empfänger := Liste neu.
	eigen cc := Liste neu.
	eigen bcc := Liste neu.
	eigen absender := Nichts.
	eigen absendername := Nichts.
	eigen betreff := Nichts.
	eigen textkörper := Nichts.
}.

E-Mail wenn: ['neu'] tun: { <- selbst neu initialisieren.
}.

E-Mail wenn: ['an:'] tun: { :aufzählung
	eigen empfänger := aufzählung.
}.
 
E-Mail wenn: ['cc:'] tun: { :aufzählung
	eigen cc := aufzählung.
}.

E-Mail wenn: ['bcc:'] tun: { :aufzählung
	eigen bcc := aufzählung.
}.

E-Mail wenn: ['betreff:'] tun: { :betreff
	eigen betreff := betreff.
}.

E-Mail wenn: ['absender:name:'] tun: { :absender :name
	eigen absender := absender.
	eigen absendername := name.
}.

E-Mail wenn: ['textkörper:'] tun: { :textkörper
	eigen textkörper := textkörper.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-Mail wenn: ['kopfzeile:'] tun: { :zeile <- zeile ersetzen: ['\r'] mit: [''], ersetzen: ['\n'] mit: [''].
}.

E-Mail wenn: ['senden'] tun: {
	>> f := Datei tempwrite: selbst erzeugen.
	Programm system: ['sendmail -t < '] + f pfad, stopp.
}.

E-Mail wenn: ['erzeugen'] tun: {
	>> umbruch := ['\r\n'].
	>> zeichenkette := [''].
	zeichenkette anhängen: (selbst kopfzeile: ['From: '] + eigen absendername + [' <'] + ( eigen absender ) + ['>']) + umbruch.
	zeichenkette anhängen: (selbst kopfzeile: ['To: '] + ( eigen empfänger zusammenfügen: [','] )) + umbruch.
	eigen cc anzahl ja: {
		zeichenkette anhängen: (selbst kopfzeile: ['Cc: '] + ( eigen cc zusammenfügen: [','] )) + umbruch.
	}.
	eigen bcc anzahl ja: {
		zeichenkette anhängen: (selbst kopfzeile: ['Bcc: '] + ( eigen bcc zusammenfügen: [','] )) + umbruch.
	}.
	zeichenkette anhängen: (selbst kopfzeile: ['Subject: '] + eigen betreff) + umbruch.
	zeichenkette anhängen: umbruch.
	zeichenkette anhängen: eigen textkörper.
	zeichenkette anhängen: umbruch. <- zeichenkette.
}.

>> HTML-E-Mail := E-Mail neu.

HTML-E-Mail wenn: ['initialisieren'] tun: {
	selbst initialisieren.
	eigen anhänge := Liste neu.
	eigen grenze := Tresor token: 40.
}.

HTML-E-Mail wenn: ['beifügen:'] tun: { :datei
	>> id := eigen anhänge anzahl.
	>> blob := datei blob.
	eigen anhänge anhängen: (
		Wörterbuch neu
			datei: datei pfad,
			mime: ['image/'] + (Server mimetype: datei pfad),
			daten: blob base64-kodieren
	).
	blob freigeben. <- ['cid:attachment'] + id.
}.

HTML-E-Mail wenn: ['erzeugen'] tun: {
	>> umbruch := ['\r\n'].
	>> zeichenkette := [''].
	zeichenkette anhängen: (selbst kopfzeile: ['From: '] + eigen absendername + [' <'] + ( eigen absender ) + ['>']) + umbruch.
	zeichenkette anhängen: (selbst kopfzeile: ['To: '] + ( eigen empfänger zusammenfügen: [','] )) + umbruch.
	eigen cc anzahl ja: {
		zeichenkette anhängen: (selbst kopfzeile: ['Cc: '] + ( eigen cc zusammenfügen: [','] )) + umbruch.
	}.
	eigen bcc anzahl ja: {
		zeichenkette anhängen: (selbst kopfzeile: ['Bcc: '] + ( eigen bcc zusammenfügen: [','] )) + umbruch.
	}.
	zeichenkette anhängen: (selbst kopfzeile: ['Subject: '] + eigen betreff) + umbruch.
	zeichenkette anhängen: ['MIME-Version: 1.0'] + umbruch.
	zeichenkette anhängen: ['Content-Type: multipart/related; boundary="'] + eigen grenze + ['"; type=text/html'] + umbruch.
	zeichenkette anhängen: umbruch.
	zeichenkette anhängen: ['--'] + eigen grenze + umbruch.
	zeichenkette anhängen: ['Content-Type: text/html; charset=UTF-8'] + umbruch.
	zeichenkette anhängen: ['Content-Transfer-Encoding: 7bit'] + umbruch.
	zeichenkette anhängen: umbruch.
	zeichenkette anhängen: eigen textkörper.
	zeichenkette anhängen: umbruch.
	eigen anhänge jedes: { :id :info
		>> blob := info daten.
		zeichenkette anhängen: ['--'] + eigen grenze + umbruch.
		zeichenkette anhängen: ['Content-Type: '] + info mime + umbruch.
		zeichenkette anhängen: ['Content-Transfer-Encoding: base64'] + umbruch.
		zeichenkette anhängen: ['Content-ID: <attachment'] + id + ['>'] + umbruch.
		zeichenkette anhängen: ['Content-Disposition: inline; filename="'] + info datei + ['"'] + umbruch.
		zeichenkette anhängen: umbruch.
		>> höchstwert := 76.
		>> textlänge := blob länge.
		>> stücke := (textlänge / höchstwert) aufgerundet.
		{ :i
			>> stück := blob kopieren von: i * höchstwert länge: höchstwert.
			zeichenkette anhängen: stück + umbruch.
		} * stücke.
		zeichenkette anhängen: umbruch.
		zeichenkette anhängen: umbruch.
	}.
	zeichenkette anhängen: ['--'] + eigen grenze + ['--'] + umbruch. <- zeichenkette.
}.
