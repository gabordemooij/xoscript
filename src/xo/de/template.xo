
# ~ Simple template engine ~

>> Vorlage := Objekt neu.

Vorlage wenn: ['neu'] tun: { <- selbst neu inhalt: [''].
}.

Vorlage wenn: ['inhalt:'] tun: { :inhalt
	eigen inhalt := inhalt. 
}.

Vorlage wenn: ['neu:'] tun: { :inhalt <- selbst neu inhalt: inhalt.
}.

Vorlage wenn: ['ausschneiden:'] tun: { :markierung
	>> startmarkierung := (['<!-- cut:%id% -->'] %id%: markierung).
	>> endmarkierung := (['<!-- /cut:%id% -->'] %id%: markierung).
	>> teile := eigen inhalt teilen: startmarkierung.
	>> präfix := teile erstes.
	>> teile2 := teile letztes teilen: endmarkierung.
	>> suffix := teile2 letztes.
	>> teil := teile2 erstes.
	>> rest := präfix + suffix.
	eigen inhalt := rest. <- Vorlage neu: teil.
	
}.

Vorlage wenn: ['kopieren'] tun: { <- selbst neu: selbst text kopieren.
}.
	
Vorlage wenn: ['einfügen:auf:'] tun: { :schnipsel :id
	>> einfügemarke := (['<!-- paste:%id% -->'] %id%: id).
	eigen inhalt ersetzen: einfügemarke mit: ( schnipsel text + einfügemarke ).
}.

Vorlage wenn: ['setzen:wert:'] tun: { :platz :wert
	eigen inhalt ersetzen: ['<!-- slot:'] + platz + [' -->'] mit: ( Server html-kodieren: wert ).
}.

Vorlage wenn: ['setzen:html:'] tun: { :platz :html
	eigen inhalt ersetzen: ['<!-- slot:'] + platz + [' -->'] mit: html.
}.

Vorlage wenn: ['antworten:und:'] tun: { :platz :wert
	selbst setzen: (platz von: 0 länge: (platz länge - 1)) wert: wert.
}.

Vorlage wenn: ['nl2br'] tun: {
	eigen inhalt ersetzen: ['\n'] mit: ['<br>'].
}.

Vorlage wenn: ['säubern'] tun: {
	eigen inhalt :=
		Muster
		neu: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		treffer: eigen inhalt
		tun: { <- ['']. }.
}.

Vorlage wenn: ['schnitte-säubern'] tun: {
	>> elemente := Liste neu.
	Muster
	neu: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	treffer: eigen inhalt
	tun: { :_ :teil
		elemente anhängen: teil ? 1.
	}.
	elemente jedes: { :_ :id
		eigen inhalt :=
			Muster neu: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			treffer: eigen inhalt
			tun: { <- ['']. }.
	 }.
}.

Vorlage wenn: ['leerraum-säubern'] tun: {
	eigen inhalt :=
		Muster
		neu: ['\\s*\\n'],
		treffer: eigen inhalt
		tun: { <- ['\n']. }.
	eigen inhalt :=
		Muster
		neu: ['\\n[\\s\\t]+'],
		treffer: eigen inhalt
		tun: { <- ['\n']. }.
}.

Vorlage wenn: ['alles-säubern'] tun: {
	selbst säubern.
	selbst schnitte-säubern.
	selbst leerraum-säubern.
}.

Vorlage wenn: ['text'] tun: { <- eigen inhalt.
}.
