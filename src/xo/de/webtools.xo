HTTP-Anfrage wenn: ['HTTP-kopfzeile:'] tun: { :schlüssel <- Programm einstellung: schlüssel.
}.

>> HTTP-Kopfzeile := Objekt neu.

HTTP-Kopfzeile wenn: ['neu'] tun: { <- selbst neu initialisieren.
}.

HTTP-Kopfzeile wenn: ['initialisieren'] tun: {
	eigen schlüssel := Nichts.
	eigen wert := Nichts.
}.

HTTP-Kopfzeile wenn: ['schlüssel:wert:'] tun: { :schlüssel :wert
	eigen schlüssel := schlüssel.
	eigen wert := wert.
}.

HTTP-Kopfzeile wenn: ['schlüssel'] tun: { <- eigen schlüssel.
}.

HTTP-Kopfzeile wenn: ['wert'] tun: { <- eigen wert.
}.


HTTP-Kopfzeile wenn: ['text'] tun: {
	>> zeile := eigen schlüssel + [': '] + eigen wert.
	zeile ersetzen: ['\r'] mit: [''], ersetzen: ['\n'] mit: ['']. <- zeile + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Dokument := Objekt neu.

Web-Dokument wenn: ['neu'] tun: { <- selbst neu initialisieren.
}.

Web-Dokument wenn: ['initialisieren'] tun: {
	eigen kopfzeilen := Liste neu.
	eigen sitzungs-id := Nichts.
	eigen sitzungsverwalter := Tempdatei-Sitzung neu.
	eigen sitzungsdaten := Nichts.
	eigen sicher := Ja.
	eigen gleiche-site := ['Strict'].
	eigen kopfzeilen-gesendet := Nein.
	eigen anfrage := HTTP-Anfrage neu.
}.

Web-Dokument wenn: ['anfrage:'] tun: { :anfrage
	eigen anfrage := anfrage.
}. 

Web-Dokument wenn: ['sicheres-sitzungscookie:'] tun: { :sicher
	selbst kopfzeilen-prüfen.
	eigen sicher := sicher.
}.

Web-Dokument wenn: ['same-site-sitzungscookie:'] tun: { :wert
	selbst kopfzeilen-prüfen.
	>> optionen := Liste neu 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	optionen hat: wert, nein: {
		diese-aufgabe fehler: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigen gleiche-site := wert.
}.

Web-Dokument wenn: ['kopfzeile:'] tun: { :kopfzeile
	selbst kopfzeilen-prüfen.
	eigen kopfzeilen anhängen: kopfzeile.
}.

Web-Dokument wenn: ['kopfzeilen-leeren'] tun: {
	selbst kopfzeilen-prüfen.
	eigen kopfzeilen := Liste neu.
}.

Web-Dokument wenn: ['sitzungsverwalter:'] tun: { :verwalter
	selbst kopfzeilen-prüfen.
	eigen sitzungsverwalter := verwalter.
}.

Web-Dokument wenn: ['sitzungsverwalter'] tun: { <- eigen sitzungsverwalter.
}.

Web-Dokument wenn: ['kopfzeilen-prüfen'] tun: {
	eigen kopfzeilen-gesendet ja: {
		diese-aufgabe fehler: ['Headers already sent to client.'].
	}.
}.

Web-Dokument wenn: ['sitzung-starten'] tun: {
	selbst kopfzeilen-prüfen.
	>> anfrage := eigen anfrage.
	>> sitzungs-id := anfrage cookie: ['xsid'].
	sitzungs-id Nichts? nein: {
		(( Muster neu: ['^[A-Za-z0-9]+\\z'], treffer: sitzungs-id ) = 0) ja: {
			sitzungs-id := Nichts.
		}.
	}.
	sitzungs-id Nichts? ja: {
		sitzungs-id := Tresor token: 30.
		>> sitzungs-kopfzeile := HTTP-Kopfzeile neu
		schlüssel: ['Set-Cookie'] wert: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigen sicher entweder: ['Secure'] oder: ['']),
		SSITE: (eigen gleiche-site),
		XSID: sitzungs-id
		).
		eigen kopfzeilen anhängen: sitzungs-kopfzeile.
	}.
	eigen sitzungsdaten := eigen sitzungsverwalter für: sitzungs-id, laden. <- eigen sitzungsdaten. # reference
}.

Web-Dokument wenn: ['gehe-zu:'] tun: { :adresse
	selbst kopfzeilen-prüfen.
	selbst kopfzeilen-leeren.
	eigen kopfzeilen
	anhängen: (
		HTTP-Kopfzeile neu
		schlüssel: ['Status'] wert: ['303 See Other']
	),
	anhängen: (
		HTTP-Kopfzeile neu
		schlüssel: ['Location'] wert: adresse
	).
	selbst ausgeben: ['Redirect'].
}.

Web-Dokument wenn: ['sitzung-beenden'] tun: {
	selbst kopfzeilen-prüfen.
	>> anfrage := eigen anfrage.
	>> sitzungs-id := anfrage cookie: ['xsid'].
	sitzungs-id Nichts? nein: {
		>> sitzungs-kopfzeile := HTTP-Kopfzeile neu.
		>> zeitpunkt := Moment neu jahr: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sitzungs-kopfzeile schlüssel: ['Set-Cookie'] wert: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: zeitpunkt,
			SEC: (eigen sicher entweder: ['Secure'] oder: ['']),
			SSITE: (eigen gleiche-site),
			XSID: sitzungs-id
		).
		eigen sitzungsverwalter vernichten.
		eigen kopfzeilen anhängen: sitzungs-kopfzeile.
	}.
}.


Web-Dokument wenn: ['vorlage:'] tun: { :pfad <- Vorlage neu: (Datei neu: pfad, lesen).
}.

Web-Dokument wenn: ['ausgeben:typ:'] tun: { :ergebnis :typ
	eigen kopfzeilen-gesendet nein: {
		eigen sitzungsdaten Nichts? nein: {
			eigen sitzungsverwalter speichern: eigen sitzungsdaten.
		}.
		eigen kopfzeilen anhängen: (
			HTTP-Kopfzeile neu
			schlüssel: ['Content-type'] wert: typ
		).
		eigen kopfzeilen jedes: { :_ :kopfzeile
			Ausgabe schreiben: kopfzeile.
		}.
		eigen kopfzeilen-gesendet := Ja.
		Ausgabe schreiben: ['\r\n'].
	}.
	Ausgabe schreiben: ergebnis.
}.

Web-Dokument wenn: ['abschließen:typ:'] tun: { :ergebnis :typ
	eigen kopfzeilen-gesendet nein: {
		eigen sitzungsdaten Nichts? nein: {
			eigen sitzungsverwalter speichern: eigen sitzungsdaten.
		}.
		eigen kopfzeilen anhängen: (
			HTTP-Kopfzeile neu
			schlüssel: ['Content-type'] wert: typ
		).
		eigen kopfzeilen anhängen: (
			HTTP-Kopfzeile neu
			schlüssel: ['Content-Length'] wert: ergebnis text bytes
		).
		eigen kopfzeilen jedes: { :_ :kopfzeile
			Ausgabe schreiben: kopfzeile.
		}.
		eigen kopfzeilen-gesendet := Ja.
		Ausgabe schreiben: ['\r\n'].
	}.
	Ausgabe schreiben: ergebnis.
}.

Web-Dokument wenn: ['ausgeben:'] tun: { :ergebnis
	selbst ausgeben: ergebnis typ: ['text/html; charset=utf-8'].
}.

Web-Dokument wenn: ['abschließen:'] tun: { :ergebnis
	selbst abschließen: ergebnis typ: ['text/html; charset=utf-8'].
}.

Web-Dokument wenn: ['json:'] tun: { :ergebnis
	selbst ausgeben: ( JSON jsonify: ergebnis ) typ: ['application/json'].
}.

Web-Dokument wenn: ['nicht-gefunden:'] tun: { :ergebnis
	selbst kopfzeilen-leeren kopfzeile: (
		HTTP-Kopfzeile neu schlüssel: ['Status'] wert: ['404 Not Found']
	).
	selbst ausgeben: ergebnis.
}.


# Interface

>> Sitzung := Objekt neu.

Sitzung wenn: ['neu'] tun: { <- selbst neu initialisieren für: Nichts.
}.

Sitzung wenn: ['für:'] tun: { :id
	eigen id := id.
}.

Sitzung wenn: ['laden'] tun: {
	diese-aufgabe fehler: ['Not implemented.'].
}.

Sitzung wenn: ['speichern:'] tun: {
	diese-aufgabe fehler: ['Not implemented.'].
}.

Sitzung wenn: ['vernichten'] tun: {
	diese-aufgabe fehler: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempdatei-Sitzung := Sitzung neu.

Tempdatei-Sitzung wenn: ['initialisieren'] tun: {
	eigen pfadpräfix := ['/tmp/sess-'].
}.

Tempdatei-Sitzung wenn: ['pfad-präfix:'] tun: { :zeichenkette
	eigen pfadpräfix := zeichenkette.
}.

Tempdatei-Sitzung wenn: ['datei'] tun: { <- ( Datei neu: ( eigen pfadpräfix + eigen id + ['.txt'] ) ).
}.

Tempdatei-Sitzung wenn: ['laden'] tun: {
	>> datei := selbst datei.
	datei existiert nein: {
		datei schreiben: (Wörterbuch neu code).
	}. <- datei lesen objekt.
}.

Tempdatei-Sitzung wenn: ['speichern:'] tun: { :daten
	>> datei := selbst datei.
	datei existiert ja: {
		datei schreiben: daten code.
	}.
}.

Tempdatei-Sitzung wenn: ['vernichten'] tun: {
	>> datei := selbst datei.
	datei existiert ja: {
		datei löschen.
	}.
}.


>> URL := Objekt neu.

URL wenn: ['initialisieren'] tun: {
	eigen protokoll := ['https://'].
	eigen host := ['localhost'].
	eigen pfad := [''].
	eigen url-parameter := [''].
	eigen hash := [''].
}.

URL wenn: ['neu'] tun: { <- selbst neu initialisieren.
}.

URL wenn: ['text'] tun: { <- (
	eigen protokoll +
	eigen host +
	eigen pfad +
	eigen url-parameter +
	eigen hash ).
}.

URL wenn: ['protokoll:'] tun: { :protokoll
	((Liste neu ; ['http'] ; ['https']) hat: protokoll) ja: {
		eigen protokoll := protokoll + ['://'].
	}, nein: {
		diese-aufgabe fehler: ['Invalid protocol'].
	}.
}.

URL wenn: ['host:'] tun: { :host
	#todo validate according to rfc
	eigen host := host.
}.

URL wenn: ['pfad:'] tun: { :pfad
	eigen pfad := ['/'] + pfad url-kodieren.
}.

URL wenn: ['url-parameter:'] tun: { :zuordnung
	>> url-parameter := Liste neu.
	zuordnung jedes: { :schlüssel :wert
		url-parameter anhängen: schlüssel text url-kodieren + ['='] + wert text url-kodieren.
	}.
	eigen url-parameter := ['?'] + ( url-parameter zusammenfügen: ['&'] ).
}.

URL wenn: ['hash:'] tun: { :hash
	eigen hash := ['#'] + hash url-kodieren.
}.

