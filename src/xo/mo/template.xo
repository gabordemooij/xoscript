
# ~ Simple template engine ~

>> Model := Obiect nou.

Model la: ['nou'] execută: { <- sine nou conținut: [''].
}.

Model la: ['conținut:'] execută: { :conținut
	propriu conținut := conținut. 
}.

Model la: ['nou:'] execută: { :conținut <- sine nou conținut: conținut.
}.

Model la: ['taie:'] execută: { :marcaj
	>> marcaj-început := (['<!-- cut:%id% -->'] %id%: marcaj).
	>> marcaj-sfârșit := (['<!-- /cut:%id% -->'] %id%: marcaj).
	>> părți := propriu conținut împarte: marcaj-început.
	>> prefix := părți primul.
	>> părți2 := părți ultimul împarte: marcaj-sfârșit.
	>> sufix := părți2 ultimul.
	>> parte := părți2 primul.
	>> rest := prefix + sufix.
	propriu conținut := rest. <- Model nou: parte.
	
}.

Model la: ['copiază'] execută: { <- sine nou: sine text copiază.
}.
	
Model la: ['lipește:la:'] execută: { :extras :id
	>> marcaj-lipire := (['<!-- paste:%id% -->'] %id%: id).
	propriu conținut înlocuiește: marcaj-lipire cu: ( extras text + marcaj-lipire ).
}.

Model la: ['setează:valoare:'] execută: { :loc :valoare
	propriu conținut înlocuiește: ['<!-- slot:'] + loc + [' -->'] cu: ( Server html-codifică: valoare ).
}.

Model la: ['setează:html:'] execută: { :loc :html
	propriu conținut înlocuiește: ['<!-- slot:'] + loc + [' -->'] cu: html.
}.

Model la: ['răspunde:și:'] execută: { :loc :valoare
	sine setează: (loc de-la: 0 lungime: (loc lungime - 1)) valoare: valoare.
}.

Model la: ['nl2br'] execută: {
	propriu conținut înlocuiește: ['\n'] cu: ['<br>'].
}.

Model la: ['epurează'] execută: {
	propriu conținut :=
		Șablon
		nou: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		potrivire: propriu conținut
		fă: { <- ['']. }.
}.

Model la: ['epurează-tăieturi'] execută: {
	>> elemente := Listă nou.
	Șablon
	nou: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	potrivire: propriu conținut
	fă: { :_ :parte
		elemente adaugă-la-sfârșit: parte ? 1.
	}.
	elemente fiecare: { :_ :id
		propriu conținut :=
			Șablon nou: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			potrivire: propriu conținut
			fă: { <- ['']. }.
	 }.
}.

Model la: ['epurează-spații'] execută: {
	propriu conținut :=
		Șablon
		nou: ['\\s*\\n'],
		potrivire: propriu conținut
		fă: { <- ['\n']. }.
	propriu conținut :=
		Șablon
		nou: ['\\n[\\s\\t]+'],
		potrivire: propriu conținut
		fă: { <- ['\n']. }.
}.

Model la: ['epurează-tot'] execută: {
	sine epurează.
	sine epurează-tăieturi.
	sine epurează-spații.
}.

Model la: ['text'] execută: { <- propriu conținut.
}.
