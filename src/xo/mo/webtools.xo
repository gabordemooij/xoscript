Cerere-HTTP la: ['HTTP-antet:'] execută: { :cheie <- Program setare: cheie.
}.

>> Antet-HTTP := Obiect nou.

Antet-HTTP la: ['nou'] execută: { <- sine nou inițializează.
}.

Antet-HTTP la: ['inițializează'] execută: {
	propriu cheie := Nimic.
	propriu valoare := Nimic.
}.

Antet-HTTP la: ['cheie:valoare:'] execută: { :cheie :valoare
	propriu cheie := cheie.
	propriu valoare := valoare.
}.

Antet-HTTP la: ['cheie'] execută: { <- propriu cheie.
}.

Antet-HTTP la: ['valoare'] execută: { <- propriu valoare.
}.


Antet-HTTP la: ['text'] execută: {
	>> linie := propriu cheie + [': '] + propriu valoare.
	linie înlocuiește: ['\r'] cu: [''], înlocuiește: ['\n'] cu: ['']. <- linie + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Document-Web := Obiect nou.

Document-Web la: ['nou'] execută: { <- sine nou inițializează.
}.

Document-Web la: ['inițializează'] execută: {
	propriu antete := Listă nou.
	propriu id-sesiune := Nimic.
	propriu manager-sesiune := Sesiune-fișier-temporar nou.
	propriu date-sesiune := Nimic.
	propriu securizat := Adevărat.
	propriu același-site := ['Strict'].
	propriu antete-trimise := Fals.
	propriu cerere := Cerere-HTTP nou.
}.

Document-Web la: ['cerere:'] execută: { :cerere
	propriu cerere := cerere.
}. 

Document-Web la: ['cookie-sesiune-securizat:'] execută: { :securizat
	sine verifică-antete.
	propriu securizat := securizat.
}.

Document-Web la: ['cookie-sesiune-același-site:'] execută: { :valoare
	sine verifică-antete.
	>> opțiuni := Listă nou 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opțiuni are: valoare, fals: {
		această-sarcină eroare: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propriu același-site := valoare.
}.

Document-Web la: ['antet:'] execută: { :antet
	sine verifică-antete.
	propriu antete adaugă-la-sfârșit: antet.
}.

Document-Web la: ['golește-antete'] execută: {
	sine verifică-antete.
	propriu antete := Listă nou.
}.

Document-Web la: ['manager-sesiune:'] execută: { :manager
	sine verifică-antete.
	propriu manager-sesiune := manager.
}.

Document-Web la: ['manager-sesiune'] execută: { <- propriu manager-sesiune.
}.

Document-Web la: ['verifică-antete'] execută: {
	propriu antete-trimise adevărat: {
		această-sarcină eroare: ['Headers already sent to client.'].
	}.
}.

Document-Web la: ['pornește-sesiune'] execută: {
	sine verifică-antete.
	>> cerere := propriu cerere.
	>> id-sesiune := cerere cookie: ['xsid'].
	id-sesiune Nimic? fals: {
		(( Șablon nou: ['^[A-Za-z0-9]+\\z'], potrivire: id-sesiune ) = 0) adevărat: {
			id-sesiune := Nimic.
		}.
	}.
	id-sesiune Nimic? adevărat: {
		id-sesiune := Seif jeton: 30.
		>> antet-sesiune := Antet-HTTP nou
		cheie: ['Set-Cookie'] valoare: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propriu securizat sau: ['Secure'] sau: ['']),
		SSITE: (propriu același-site),
		XSID: id-sesiune
		).
		propriu antete adaugă-la-sfârșit: antet-sesiune.
	}.
	propriu date-sesiune := propriu manager-sesiune pentru: id-sesiune, încarcă. <- propriu date-sesiune. # reference
}.

Document-Web la: ['mergi-la:'] execută: { :adresă
	sine verifică-antete.
	sine golește-antete.
	propriu antete
	adaugă-la-sfârșit: (
		Antet-HTTP nou
		cheie: ['Status'] valoare: ['303 See Other']
	),
	adaugă-la-sfârșit: (
		Antet-HTTP nou
		cheie: ['Location'] valoare: adresă
	).
	sine scrie-ieșire: ['Redirect'].
}.

Document-Web la: ['distruge-sesiune'] execută: {
	sine verifică-antete.
	>> cerere := propriu cerere.
	>> id-sesiune := cerere cookie: ['xsid'].
	id-sesiune Nimic? fals: {
		>> antet-sesiune := Antet-HTTP nou.
		>> moment := Moment nou an: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		antet-sesiune cheie: ['Set-Cookie'] valoare: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: moment,
			SEC: (propriu securizat sau: ['Secure'] sau: ['']),
			SSITE: (propriu același-site),
			XSID: id-sesiune
		).
		propriu manager-sesiune distruge.
		propriu antete adaugă-la-sfârșit: antet-sesiune.
	}.
}.


Document-Web la: ['model:'] execută: { :cale <- Model nou: (Fișier nou: cale, citește).
}.

Document-Web la: ['scrie-ieșire:tip:'] execută: { :ieșire :tip
	propriu antete-trimise fals: {
		propriu date-sesiune Nimic? fals: {
			propriu manager-sesiune salvează: propriu date-sesiune.
		}.
		propriu antete adaugă-la-sfârșit: (
			Antet-HTTP nou
			cheie: ['Content-type'] valoare: tip
		).
		propriu antete fiecare: { :_ :antet
			Ieșire scrie: antet.
		}.
		propriu antete-trimise := Adevărat.
		Ieșire scrie: ['\r\n'].
	}.
	Ieșire scrie: ieșire.
}.

Document-Web la: ['finalizează:tip:'] execută: { :ieșire :tip
	propriu antete-trimise fals: {
		propriu date-sesiune Nimic? fals: {
			propriu manager-sesiune salvează: propriu date-sesiune.
		}.
		propriu antete adaugă-la-sfârșit: (
			Antet-HTTP nou
			cheie: ['Content-type'] valoare: tip
		).
		propriu antete adaugă-la-sfârșit: (
			Antet-HTTP nou
			cheie: ['Content-Length'] valoare: ieșire text bytes
		).
		propriu antete fiecare: { :_ :antet
			Ieșire scrie: antet.
		}.
		propriu antete-trimise := Adevărat.
		Ieșire scrie: ['\r\n'].
	}.
	Ieșire scrie: ieșire.
}.

Document-Web la: ['scrie-ieșire:'] execută: { :ieșire
	sine scrie-ieșire: ieșire tip: ['text/html; charset=utf-8'].
}.

Document-Web la: ['finalizează:'] execută: { :ieșire
	sine finalizează: ieșire tip: ['text/html; charset=utf-8'].
}.

Document-Web la: ['json:'] execută: { :ieșire
	sine scrie-ieșire: ( JSON jsonify: ieșire ) tip: ['application/json'].
}.

Document-Web la: ['negăsit:'] execută: { :ieșire
	sine golește-antete antet: (
		Antet-HTTP nou cheie: ['Status'] valoare: ['404 Not Found']
	).
	sine scrie-ieșire: ieșire.
}.


# Interface

>> Sesiune := Obiect nou.

Sesiune la: ['nou'] execută: { <- sine nou inițializează pentru: Nimic.
}.

Sesiune la: ['pentru:'] execută: { :id
	propriu id := id.
}.

Sesiune la: ['încarcă'] execută: {
	această-sarcină eroare: ['Not implemented.'].
}.

Sesiune la: ['salvează:'] execută: {
	această-sarcină eroare: ['Not implemented.'].
}.

Sesiune la: ['distruge'] execută: {
	această-sarcină eroare: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesiune-fișier-temporar := Sesiune nou.

Sesiune-fișier-temporar la: ['inițializează'] execută: {
	propriu prefixcale := ['/tmp/sess-'].
}.

Sesiune-fișier-temporar la: ['prefix-cale:'] execută: { :șir
	propriu prefixcale := șir.
}.

Sesiune-fișier-temporar la: ['fișier'] execută: { <- ( Fișier nou: ( propriu prefixcale + propriu id + ['.txt'] ) ).
}.

Sesiune-fișier-temporar la: ['încarcă'] execută: {
	>> fișier := sine fișier.
	fișier există fals: {
		fișier scrie: (Dicționar nou cod).
	}. <- fișier citește obiect.
}.

Sesiune-fișier-temporar la: ['salvează:'] execută: { :date
	>> fișier := sine fișier.
	fișier există adevărat: {
		fișier scrie: date cod.
	}.
}.

Sesiune-fișier-temporar la: ['distruge'] execută: {
	>> fișier := sine fișier.
	fișier există adevărat: {
		fișier șterge.
	}.
}.


>> URL := Obiect nou.

URL la: ['inițializează'] execută: {
	propriu protocol := ['https://'].
	propriu gazdă := ['localhost'].
	propriu cale := [''].
	propriu parametri-url := [''].
	propriu hash := [''].
}.

URL la: ['nou'] execută: { <- sine nou inițializează.
}.

URL la: ['text'] execută: { <- (
	propriu protocol +
	propriu gazdă +
	propriu cale +
	propriu parametri-url +
	propriu hash ).
}.

URL la: ['protocol:'] execută: { :protocol
	((Listă nou ; ['http'] ; ['https']) are: protocol) adevărat: {
		propriu protocol := protocol + ['://'].
	}, fals: {
		această-sarcină eroare: ['Invalid protocol'].
	}.
}.

URL la: ['gazdă:'] execută: { :gazdă
	#todo validate according to rfc
	propriu gazdă := gazdă.
}.

URL la: ['cale:'] execută: { :cale
	propriu cale := ['/'] + cale url-codifică.
}.

URL la: ['parametri-url:'] execută: { :asociere
	>> parametri-url := Listă nou.
	asociere fiecare: { :cheie :valoare
		parametri-url adaugă-la-sfârșit: cheie text url-codifică + ['='] + valoare text url-codifică.
	}.
	propriu parametri-url := ['?'] + ( parametri-url unește: ['&'] ).
}.

URL la: ['rezumat:'] execută: { :hash
	propriu hash := ['#'] + hash url-codifică.
}.

