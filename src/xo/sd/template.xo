
# ~ Simple template engine ~

>> سانچو := شيء نئون.

سانچو جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون مواد: [''].
}.

سانچو جڏهن: ['مواد:'] ڪريو: { :مواد
	پنهنجو مواد := مواد. 
}.

سانچو جڏهن: ['نئون:'] ڪريو: { :مواد <- پاڻ نئون مواد: مواد.
}.

سانچو جڏهن: ['ڪٽيو:'] ڪريو: { :نشان
	>> شروعاتي-نشان := (['<!-- cut:%id% -->'] %id%: نشان).
	>> پڇاڙي-نشان := (['<!-- /cut:%id% -->'] %id%: نشان).
	>> حصا := پنهنجو مواد ورهايو: شروعاتي-نشان.
	>> اڳياڙي := حصا پهريون.
	>> حصا2 := حصا آخري ورهايو: پڇاڙي-نشان.
	>> پڇاڙي := حصا2 آخري.
	>> حصو := حصا2 پهريون.
	>> باقي := اڳياڙي + پڇاڙي.
	پنهنجو مواد := باقي. <- سانچو نئون: حصو.
	
}.

سانچو جڏهن: ['نقل'] ڪريو: { <- پاڻ نئون: پاڻ متن-طور نقل.
}.
	
سانچو جڏهن: ['چنبڙايو:ڪنجي:'] ڪريو: { :اقتباس :id
	>> چنبڙائڻ-نشان := (['<!-- paste:%id% -->'] %id%: id).
	پنهنجو مواد مٽايو: چنبڙائڻ-نشان سان: ( اقتباس متن-طور + چنبڙائڻ-نشان ).
}.

سانچو جڏهن: ['مقرر:قدر:'] ڪريو: { :خانو :قيمت
	پنهنجو مواد مٽايو: ['<!-- slot:'] + خانو + [' -->'] سان: ( Server html-انڪوڊ: قيمت ).
}.

سانچو جڏهن: ['مقرر:html:'] ڪريو: { :خانو :html
	پنهنجو مواد مٽايو: ['<!-- slot:'] + خانو + [' -->'] سان: html.
}.

سانچو جڏهن: ['جواب:۽:'] ڪريو: { :خانو :قيمت
	پاڻ مقرر: (خانو شروعات: 0 ڊيگهه: (خانو ڊيگهه - 1)) قدر: قيمت.
}.

سانچو جڏهن: ['nl2br'] ڪريو: {
	پنهنجو مواد مٽايو: ['\n'] سان: ['<br>'].
}.

سانچو جڏهن: ['صاف-ڪريو'] ڪريو: {
	پنهنجو مواد :=
		نمونو-ڳولا
		نئون: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ميلاپ: پنهنجو مواد
		ڪريو: { <- ['']. }.
}.

سانچو جڏهن: ['ڪٽ-صاف-ڪريو'] ڪريو: {
	>> شيون := لسٽ نئون.
	نمونو-ڳولا
	نئون: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ميلاپ: پنهنجو مواد
	ڪريو: { :_ :حصو
		شيون آخر-۾-جوڙيو: حصو ? 1.
	}.
	شيون هر-هڪ: { :_ :id
		پنهنجو مواد :=
			نمونو-ڳولا نئون: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ميلاپ: پنهنجو مواد
			ڪريو: { <- ['']. }.
	 }.
}.

سانچو جڏهن: ['خال-صاف-ڪريو'] ڪريو: {
	پنهنجو مواد :=
		نمونو-ڳولا
		نئون: ['\\s*\\n'],
		ميلاپ: پنهنجو مواد
		ڪريو: { <- ['\n']. }.
	پنهنجو مواد :=
		نمونو-ڳولا
		نئون: ['\\n[\\s\\t]+'],
		ميلاپ: پنهنجو مواد
		ڪريو: { <- ['\n']. }.
}.

سانچو جڏهن: ['سڀ-صاف-ڪريو'] ڪريو: {
	پاڻ صاف-ڪريو.
	پاڻ ڪٽ-صاف-ڪريو.
	پاڻ خال-صاف-ڪريو.
}.

سانچو جڏهن: ['متن-طور'] ڪريو: { <- پنهنجو مواد.
}.
