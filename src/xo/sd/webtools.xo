درخواست-HTTP جڏهن: ['HTTP-هيڊر:'] ڪريو: { :ڪنجي <- پروگرام سيٽنگ: ڪنجي.
}.

>> هيڊر-HTTP := شيء نئون.

هيڊر-HTTP جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون شروعات-ڪريو.
}.

هيڊر-HTTP جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پنهنجو ڪنجي := خالي.
	پنهنجو قيمت := خالي.
}.

هيڊر-HTTP جڏهن: ['ڪنجي:قيمت:'] ڪريو: { :ڪنجي :قيمت
	پنهنجو ڪنجي := ڪنجي.
	پنهنجو قيمت := قيمت.
}.

هيڊر-HTTP جڏهن: ['ڪنجي'] ڪريو: { <- پنهنجو ڪنجي.
}.

هيڊر-HTTP جڏهن: ['قيمت'] ڪريو: { <- پنهنجو قيمت.
}.


هيڊر-HTTP جڏهن: ['متن-طور'] ڪريو: {
	>> سٽ := پنهنجو ڪنجي + [': '] + پنهنجو قيمت.
	سٽ مٽايو: ['\r'] سان: [''], مٽايو: ['\n'] سان: ['']. <- سٽ + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> ويب-دستاويز := شيء نئون.

ويب-دستاويز جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون شروعات-ڪريو.
}.

ويب-دستاويز جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پنهنجو هيڊرز := لسٽ نئون.
	پنهنجو سيشن-سڃاڻپ := خالي.
	پنهنجو سيشن-منتظم := عارضي-فائل-سيشن نئون.
	پنهنجو سيشن-ڊيٽا := خالي.
	پنهنجو محفوظ := سچ.
	پنهنجو ساڳي-سائيٽ := ['Strict'].
	پنهنجو هيڊرز-موڪليا := ڪوڙ.
	پنهنجو درخواست-http := درخواست-HTTP نئون.
}.

ويب-دستاويز جڏهن: ['درخواست-http:'] ڪريو: { :درخواست-http
	پنهنجو درخواست-http := درخواست-http.
}. 

ويب-دستاويز جڏهن: ['محفوظ-سيشن-ڪوڪي:'] ڪريو: { :محفوظ
	پاڻ هيڊر-جانچيو.
	پنهنجو محفوظ := محفوظ.
}.

ويب-دستاويز جڏهن: ['سيشن-ڪوڪي-ساڳي-سائيٽ:'] ڪريو: { :قيمت
	پاڻ هيڊر-جانچيو.
	>> اختيار := لسٽ نئون 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	اختيار رکي-ٿو: قيمت, جيڪڏهن-ڪوڙ: {
		هي-ڪم غلطي: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	پنهنجو ساڳي-سائيٽ := قيمت.
}.

ويب-دستاويز جڏهن: ['هيڊر:'] ڪريو: { :هيڊر
	پاڻ هيڊر-جانچيو.
	پنهنجو هيڊرز آخر-۾-جوڙيو: هيڊر.
}.

ويب-دستاويز جڏهن: ['هيڊر-خالي-ڪريو'] ڪريو: {
	پاڻ هيڊر-جانچيو.
	پنهنجو هيڊرز := لسٽ نئون.
}.

ويب-دستاويز جڏهن: ['سيشن-منتظم:'] ڪريو: { :منتظم
	پاڻ هيڊر-جانچيو.
	پنهنجو سيشن-منتظم := منتظم.
}.

ويب-دستاويز جڏهن: ['سيشن-منتظم'] ڪريو: { <- پنهنجو سيشن-منتظم.
}.

ويب-دستاويز جڏهن: ['هيڊر-جانچيو'] ڪريو: {
	پنهنجو هيڊرز-موڪليا جيڪڏهن-سچ: {
		هي-ڪم غلطي: ['Headers already sent to client.'].
	}.
}.

ويب-دستاويز جڏهن: ['سيشن-شروع-ڪريو'] ڪريو: {
	پاڻ هيڊر-جانچيو.
	>> درخواست-http := پنهنجو درخواست-http.
	>> سيشن-سڃاڻپ := درخواست-http cookie: ['xsid'].
	سيشن-سڃاڻپ خالي? جيڪڏهن-ڪوڙ: {
		(( نمونو-ڳولا نئون: ['^[A-Za-z0-9]+\\z'], ميلاپ: سيشن-سڃاڻپ ) = 0) جيڪڏهن-سچ: {
			سيشن-سڃاڻپ := خالي.
		}.
	}.
	سيشن-سڃاڻپ خالي? جيڪڏهن-سچ: {
		سيشن-سڃاڻپ := ٽجوڙي ٽوڪن: 30.
		>> سيشن-هيڊر := هيڊر-HTTP نئون
		ڪنجي: ['Set-Cookie'] قيمت: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (پنهنجو محفوظ هي: ['Secure'] يا-هو: ['']),
		SSITE: (پنهنجو ساڳي-سائيٽ),
		XSID: سيشن-سڃاڻپ
		).
		پنهنجو هيڊرز آخر-۾-جوڙيو: سيشن-هيڊر.
	}.
	پنهنجو سيشن-ڊيٽا := پنهنجو سيشن-منتظم لاءِ: سيشن-سڃاڻپ, لوڊ-ڪريو. <- پنهنجو سيشن-ڊيٽا. # reference
}.

ويب-دستاويز جڏهن: ['وڃو:'] ڪريو: { :پتو
	پاڻ هيڊر-جانچيو.
	پاڻ هيڊر-خالي-ڪريو.
	پنهنجو هيڊرز
	آخر-۾-جوڙيو: (
		هيڊر-HTTP نئون
		ڪنجي: ['Status'] قيمت: ['303 See Other']
	),
	آخر-۾-جوڙيو: (
		هيڊر-HTTP نئون
		ڪنجي: ['Location'] قيمت: پتو
	).
	پاڻ ٻاهر-ڪڍو: ['Redirect'].
}.

ويب-دستاويز جڏهن: ['سيشن-ناس-ڪريو'] ڪريو: {
	پاڻ هيڊر-جانچيو.
	>> درخواست-http := پنهنجو درخواست-http.
	>> سيشن-سڃاڻپ := درخواست-http cookie: ['xsid'].
	سيشن-سڃاڻپ خالي? جيڪڏهن-ڪوڙ: {
		>> سيشن-هيڊر := هيڊر-HTTP نئون.
		>> وقت-ختم := لمحو نئون سال: 1970, فارميٽ-۾: ['%a, %d %b %Y %H:%M:%S GMT'].
		سيشن-هيڊر ڪنجي: ['Set-Cookie'] قيمت: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: وقت-ختم,
			SEC: (پنهنجو محفوظ هي: ['Secure'] يا-هو: ['']),
			SSITE: (پنهنجو ساڳي-سائيٽ),
			XSID: سيشن-سڃاڻپ
		).
		پنهنجو سيشن-منتظم ناس-ڪريو.
		پنهنجو هيڊرز آخر-۾-جوڙيو: سيشن-هيڊر.
	}.
}.


ويب-دستاويز جڏهن: ['سانچو:'] ڪريو: { :فائل-رستو <- سانچو نئون: (فائل نئون: فائل-رستو, پڙهو).
}.

ويب-دستاويز جڏهن: ['ٻاهر-ڪڍو:قسم:'] ڪريو: { :نتيجو :قسم
	پنهنجو هيڊرز-موڪليا جيڪڏهن-ڪوڙ: {
		پنهنجو سيشن-ڊيٽا خالي? جيڪڏهن-ڪوڙ: {
			پنهنجو سيشن-منتظم محفوظ-ڪريو: پنهنجو سيشن-ڊيٽا.
		}.
		پنهنجو هيڊرز آخر-۾-جوڙيو: (
			هيڊر-HTTP نئون
			ڪنجي: ['Content-type'] قيمت: قسم
		).
		پنهنجو هيڊرز هر-هڪ: { :_ :هيڊر
			آئوٽ-پٽ لکو: هيڊر.
		}.
		پنهنجو هيڊرز-موڪليا := سچ.
		آئوٽ-پٽ لکو: ['\r\n'].
	}.
	آئوٽ-پٽ لکو: نتيجو.
}.

ويب-دستاويز جڏهن: ['پورو-ڪريو:قسم:'] ڪريو: { :نتيجو :قسم
	پنهنجو هيڊرز-موڪليا جيڪڏهن-ڪوڙ: {
		پنهنجو سيشن-ڊيٽا خالي? جيڪڏهن-ڪوڙ: {
			پنهنجو سيشن-منتظم محفوظ-ڪريو: پنهنجو سيشن-ڊيٽا.
		}.
		پنهنجو هيڊرز آخر-۾-جوڙيو: (
			هيڊر-HTTP نئون
			ڪنجي: ['Content-type'] قيمت: قسم
		).
		پنهنجو هيڊرز آخر-۾-جوڙيو: (
			هيڊر-HTTP نئون
			ڪنجي: ['Content-Length'] قيمت: نتيجو متن-طور بائيٽس
		).
		پنهنجو هيڊرز هر-هڪ: { :_ :هيڊر
			آئوٽ-پٽ لکو: هيڊر.
		}.
		پنهنجو هيڊرز-موڪليا := سچ.
		آئوٽ-پٽ لکو: ['\r\n'].
	}.
	آئوٽ-پٽ لکو: نتيجو.
}.

ويب-دستاويز جڏهن: ['ٻاهر-ڪڍو:'] ڪريو: { :نتيجو
	پاڻ ٻاهر-ڪڍو: نتيجو قسم: ['text/html; charset=utf-8'].
}.

ويب-دستاويز جڏهن: ['پورو-ڪريو:'] ڪريو: { :نتيجو
	پاڻ پورو-ڪريو: نتيجو قسم: ['text/html; charset=utf-8'].
}.

ويب-دستاويز جڏهن: ['json:'] ڪريو: { :نتيجو
	پاڻ ٻاهر-ڪڍو: ( JSON jsonify: نتيجو ) قسم: ['application/json'].
}.

ويب-دستاويز جڏهن: ['نه-مليو:'] ڪريو: { :نتيجو
	پاڻ هيڊر-خالي-ڪريو هيڊر: (
		هيڊر-HTTP نئون ڪنجي: ['Status'] قيمت: ['404 Not Found']
	).
	پاڻ ٻاهر-ڪڍو: نتيجو.
}.


# Interface

>> سيشن := شيء نئون.

سيشن جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون شروعات-ڪريو لاءِ: خالي.
}.

سيشن جڏهن: ['لاءِ:'] ڪريو: { :id
	پنهنجو id := id.
}.

سيشن جڏهن: ['لوڊ-ڪريو'] ڪريو: {
	هي-ڪم غلطي: ['Not implemented.'].
}.

سيشن جڏهن: ['محفوظ-ڪريو:'] ڪريو: {
	هي-ڪم غلطي: ['Not implemented.'].
}.

سيشن جڏهن: ['ناس-ڪريو'] ڪريو: {
	هي-ڪم غلطي: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> عارضي-فائل-سيشن := سيشن نئون.

عارضي-فائل-سيشن جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پنهنجو رستي-جي-شروعات := ['/tmp/sess-'].
}.

عارضي-فائل-سيشن جڏهن: ['رستي-جو-اڳياڙي:'] ڪريو: { :متني-لڙي
	پنهنجو رستي-جي-شروعات := متني-لڙي.
}.

عارضي-فائل-سيشن جڏهن: ['سيشن-فائل'] ڪريو: { <- ( فائل نئون: ( پنهنجو رستي-جي-شروعات + پنهنجو id + ['.txt'] ) ).
}.

عارضي-فائل-سيشن جڏهن: ['لوڊ-ڪريو'] ڪريو: {
	>> سيشن-فائل := پاڻ سيشن-فائل.
	سيشن-فائل موجود جيڪڏهن-ڪوڙ: {
		سيشن-فائل لکو: (لغت نئون ڪوڊ).
	}. <- سيشن-فائل پڙهو شيء-طور.
}.

عارضي-فائل-سيشن جڏهن: ['محفوظ-ڪريو:'] ڪريو: { :ڊيٽا
	>> سيشن-فائل := پاڻ سيشن-فائل.
	سيشن-فائل موجود جيڪڏهن-سچ: {
		سيشن-فائل لکو: ڊيٽا ڪوڊ.
	}.
}.

عارضي-فائل-سيشن جڏهن: ['ناس-ڪريو'] ڪريو: {
	>> سيشن-فائل := پاڻ سيشن-فائل.
	سيشن-فائل موجود جيڪڏهن-سچ: {
		سيشن-فائل ڊاهيو.
	}.
}.


>> URL := شيء نئون.

URL جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پنهنجو پروٽوڪول := ['https://'].
	پنهنجو ميزبان := ['localhost'].
	پنهنجو فائل-رستو := [''].
	پنهنجو url-پيراميٽر := [''].
	پنهنجو hash := [''].
}.

URL جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون شروعات-ڪريو.
}.

URL جڏهن: ['متن-طور'] ڪريو: { <- (
	پنهنجو پروٽوڪول +
	پنهنجو ميزبان +
	پنهنجو فائل-رستو +
	پنهنجو url-پيراميٽر +
	پنهنجو hash ).
}.

URL جڏهن: ['پروٽوڪول:'] ڪريو: { :پروٽوڪول
	((لسٽ نئون ; ['http'] ; ['https']) رکي-ٿو: پروٽوڪول) جيڪڏهن-سچ: {
		پنهنجو پروٽوڪول := پروٽوڪول + ['://'].
	}, جيڪڏهن-ڪوڙ: {
		هي-ڪم غلطي: ['Invalid protocol'].
	}.
}.

URL جڏهن: ['ميزبان:'] ڪريو: { :ميزبان
	#todo validate according to rfc
	پنهنجو ميزبان := ميزبان.
}.

URL جڏهن: ['فائل-رستو:'] ڪريو: { :فائل-رستو
	پنهنجو فائل-رستو := ['/'] + فائل-رستو url-انڪوڊ.
}.

URL جڏهن: ['url-پيراميٽر:'] ڪريو: { :نقشو
	>> url-پيراميٽر := لسٽ نئون.
	نقشو هر-هڪ: { :ڪنجي :قيمت
		url-پيراميٽر آخر-۾-جوڙيو: ڪنجي متن-طور url-انڪوڊ + ['='] + قيمت متن-طور url-انڪوڊ.
	}.
	پنهنجو url-پيراميٽر := ['?'] + ( url-پيراميٽر ملايو: ['&'] ).
}.

URL جڏهن: ['هيش:'] ڪريو: { :hash
	پنهنجو hash := ['#'] + hash url-انڪوڊ.
}.

