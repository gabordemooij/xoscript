>> اي-ميل := شيء نئون.

اي-ميل جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پنهنجو وصول-ڪندڙ := لسٽ نئون.
	پنهنجو cc := لسٽ نئون.
	پنهنجو bcc := لسٽ نئون.
	پنهنجو موڪليندڙ := خالي.
	پنهنجو موڪليندڙ-جو-نالو := خالي.
	پنهنجو موضوع := خالي.
	پنهنجو خط-جو-متن := خالي.
}.

اي-ميل جڏهن: ['نئون'] ڪريو: { <- پاڻ نئون شروعات-ڪريو.
}.

اي-ميل جڏهن: ['ڏانهن:'] ڪريو: { :فهرست-شيون
	پنهنجو وصول-ڪندڙ := فهرست-شيون.
}.
 
اي-ميل جڏهن: ['cc:'] ڪريو: { :فهرست-شيون
	پنهنجو cc := فهرست-شيون.
}.

اي-ميل جڏهن: ['bcc:'] ڪريو: { :فهرست-شيون
	پنهنجو bcc := فهرست-شيون.
}.

اي-ميل جڏهن: ['موضوع:'] ڪريو: { :موضوع
	پنهنجو موضوع := موضوع.
}.

اي-ميل جڏهن: ['موڪليندڙ:نالو:'] ڪريو: { :موڪليندڙ :نالو
	پنهنجو موڪليندڙ := موڪليندڙ.
	پنهنجو موڪليندڙ-جو-نالو := نالو.
}.

اي-ميل جڏهن: ['خط-جو-متن:'] ڪريو: { :خط-جو-متن
	پنهنجو خط-جو-متن := خط-جو-متن.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
اي-ميل جڏهن: ['هيڊر:'] ڪريو: { :سٽ <- سٽ مٽايو: ['\r'] سان: [''], مٽايو: ['\n'] سان: [''].
}.

اي-ميل جڏهن: ['موڪليو'] ڪريو: {
	>> f := فائل عارضي-لکت: پاڻ ٺاهيو.
	پروگرام سسٽم: ['sendmail -t < '] + f فائل-رستو, نئين-سٽ.
}.

اي-ميل جڏهن: ['ٺاهيو'] ڪريو: {
	>> سٽ-ٽوڙ := ['\r\n'].
	>> متني-لڙي := [''].
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['From: '] + پنهنجو موڪليندڙ-جو-نالو + [' <'] + ( پنهنجو موڪليندڙ ) + ['>']) + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['To: '] + ( پنهنجو وصول-ڪندڙ ملايو: [','] )) + سٽ-ٽوڙ.
	پنهنجو cc ڳڻپ جيڪڏهن-سچ: {
		متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Cc: '] + ( پنهنجو cc ملايو: [','] )) + سٽ-ٽوڙ.
	}.
	پنهنجو bcc ڳڻپ جيڪڏهن-سچ: {
		متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Bcc: '] + ( پنهنجو bcc ملايو: [','] )) + سٽ-ٽوڙ.
	}.
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Subject: '] + پنهنجو موضوع) + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: پنهنجو خط-جو-متن.
	متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ. <- متني-لڙي.
}.

>> اي-ميل-HTML := اي-ميل نئون.

اي-ميل-HTML جڏهن: ['شروعات-ڪريو'] ڪريو: {
	پاڻ شروعات-ڪريو.
	پنهنجو ڳنڍيل := لسٽ نئون.
	پنهنجو حد := ٽجوڙي ٽوڪن: 40.
}.

اي-ميل-HTML جڏهن: ['منسلڪ-ڪريو:'] ڪريو: { :سيشن-فائل
	>> id := پنهنجو ڳنڍيل ڳڻپ.
	>> blob := سيشن-فائل blob.
	پنهنجو ڳنڍيل آخر-۾-جوڙيو: (
		لغت نئون
			سيشن-فائل: سيشن-فائل فائل-رستو,
			mime: ['image/'] + (Server mimetype: سيشن-فائل فائل-رستو),
			ڊيٽا: blob base64-انڪوڊ
	).
	blob آزاد-ڪريو. <- ['cid:attachment'] + id.
}.

اي-ميل-HTML جڏهن: ['ٺاهيو'] ڪريو: {
	>> سٽ-ٽوڙ := ['\r\n'].
	>> متني-لڙي := [''].
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['From: '] + پنهنجو موڪليندڙ-جو-نالو + [' <'] + ( پنهنجو موڪليندڙ ) + ['>']) + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['To: '] + ( پنهنجو وصول-ڪندڙ ملايو: [','] )) + سٽ-ٽوڙ.
	پنهنجو cc ڳڻپ جيڪڏهن-سچ: {
		متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Cc: '] + ( پنهنجو cc ملايو: [','] )) + سٽ-ٽوڙ.
	}.
	پنهنجو bcc ڳڻپ جيڪڏهن-سچ: {
		متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Bcc: '] + ( پنهنجو bcc ملايو: [','] )) + سٽ-ٽوڙ.
	}.
	متني-لڙي آخر-۾-جوڙيو: (پاڻ هيڊر: ['Subject: '] + پنهنجو موضوع) + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: ['MIME-Version: 1.0'] + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: ['Content-Type: multipart/related; boundary="'] + پنهنجو حد + ['"; type=text/html'] + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: ['--'] + پنهنجو حد + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: ['Content-Type: text/html; charset=UTF-8'] + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: ['Content-Transfer-Encoding: 7bit'] + سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
	متني-لڙي آخر-۾-جوڙيو: پنهنجو خط-جو-متن.
	متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
	پنهنجو ڳنڍيل هر-هڪ: { :id :معلومات
		>> blob := معلومات ڊيٽا.
		متني-لڙي آخر-۾-جوڙيو: ['--'] + پنهنجو حد + سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: ['Content-Type: '] + معلومات mime + سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: ['Content-Transfer-Encoding: base64'] + سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: ['Content-ID: <attachment'] + id + ['>'] + سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: ['Content-Disposition: inline; filename="'] + معلومات سيشن-فائل + ['"'] + سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
		>> مٿين-حد := 76.
		>> متن-جي-ڊيگهه := blob ڊيگهه.
		>> قطعا := (متن-جي-ڊيگهه / مٿين-حد) مٿي-گول.
		{ :i
			>> قطعو := blob نقل شروعات: i * مٿين-حد ڊيگهه: مٿين-حد.
			متني-لڙي آخر-۾-جوڙيو: قطعو + سٽ-ٽوڙ.
		} * قطعا.
		متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
		متني-لڙي آخر-۾-جوڙيو: سٽ-ٽوڙ.
	}.
	متني-لڙي آخر-۾-جوڙيو: ['--'] + پنهنجو حد + ['--'] + سٽ-ٽوڙ. <- متني-لڙي.
}.
