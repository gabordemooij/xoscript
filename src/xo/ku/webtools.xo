Daxwaza-HTTP gava: ['HTTP-sernivîs:'] bike: { :mifte <- Bername mîheng: mifte.
}.

>> Sernivîsa-HTTP := Tişt nû.

Sernivîsa-HTTP gava: ['nû'] bike: { <- xwe nû amade-bike.
}.

Sernivîsa-HTTP gava: ['amade-bike'] bike: {
	xweyî mifte := Tune.
	xweyî buha := Tune.
}.

Sernivîsa-HTTP gava: ['mifte:buha:'] bike: { :mifte :buha
	xweyî mifte := mifte.
	xweyî buha := buha.
}.

Sernivîsa-HTTP gava: ['mifte'] bike: { <- xweyî mifte.
}.

Sernivîsa-HTTP gava: ['buha'] bike: { <- xweyî buha.
}.


Sernivîsa-HTTP gava: ['nivîs'] bike: {
	>> rêz := xweyî mifte + [': '] + xweyî buha.
	rêz biguherîne: ['\r'] bi: [''], biguherîne: ['\n'] bi: ['']. <- rêz + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Belgeya-Webê := Tişt nû.

Belgeya-Webê gava: ['nû'] bike: { <- xwe nû amade-bike.
}.

Belgeya-Webê gava: ['amade-bike'] bike: {
	xweyî sernivîsan := Lîste nû.
	xweyî nasnameya-danişînê := Tune.
	xweyî rêveberê-danişînan := Danişîna-pela-demkî nû.
	xweyî daneyên-danişînê := Tune.
	xweyî ewle := Rast.
	xweyî heman-malper := ['Strict'].
	xweyî sernivîs-hatin-şandin := Şaş.
	xweyî daxwaz-http := Daxwaza-HTTP nû.
}.

Belgeya-Webê gava: ['daxwaz-http:'] bike: { :daxwaz-http
	xweyî daxwaz-http := daxwaz-http.
}. 

Belgeya-Webê gava: ['cookie-ya-danişînê-ewle:'] bike: { :ewle
	xwe sernivîsan-kontrol-bike.
	xweyî ewle := ewle.
}.

Belgeya-Webê gava: ['cookie-ya-danişînê-heman-malper:'] bike: { :buha
	xwe sernivîsan-kontrol-bike.
	>> vebijark := Lîste nû 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	vebijark heye: buha, şaş: {
		ev-kar şaşî: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	xweyî heman-malper := buha.
}.

Belgeya-Webê gava: ['sernivîs:'] bike: { :sernivîs
	xwe sernivîsan-kontrol-bike.
	xweyî sernivîsan li-dawiyê-zêde-bike: sernivîs.
}.

Belgeya-Webê gava: ['sernivîsan-vala-bike'] bike: {
	xwe sernivîsan-kontrol-bike.
	xweyî sernivîsan := Lîste nû.
}.

Belgeya-Webê gava: ['rêveberê-danişînan:'] bike: { :rêvebir
	xwe sernivîsan-kontrol-bike.
	xweyî rêveberê-danişînan := rêvebir.
}.

Belgeya-Webê gava: ['rêveberê-danişînan'] bike: { <- xweyî rêveberê-danişînan.
}.

Belgeya-Webê gava: ['sernivîsan-kontrol-bike'] bike: {
	xweyî sernivîs-hatin-şandin rast: {
		ev-kar şaşî: ['Headers already sent to client.'].
	}.
}.

Belgeya-Webê gava: ['danişînê-dest-pê-bike'] bike: {
	xwe sernivîsan-kontrol-bike.
	>> daxwaz-http := xweyî daxwaz-http.
	>> nasnameya-danişînê := daxwaz-http cookie: ['xsid'].
	nasnameya-danişînê Tune? şaş: {
		(( Qalib nû: ['^[A-Za-z0-9]+\\z'], lihevhatin: nasnameya-danişînê ) = 0) rast: {
			nasnameya-danişînê := Tune.
		}.
	}.
	nasnameya-danişînê Tune? rast: {
		nasnameya-danişînê := Qasa token: 30.
		>> sernivîsa-danişînê := Sernivîsa-HTTP nû
		mifte: ['Set-Cookie'] buha: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (xweyî ewle ev: ['Secure'] an-ew: ['']),
		SSITE: (xweyî heman-malper),
		XSID: nasnameya-danişînê
		).
		xweyî sernivîsan li-dawiyê-zêde-bike: sernivîsa-danişînê.
	}.
	xweyî daneyên-danişînê := xweyî rêveberê-danişînan ji-bo: nasnameya-danişînê, bar-bike. <- xweyî daneyên-danişînê. # reference
}.

Belgeya-Webê gava: ['here:'] bike: { :navnîşan
	xwe sernivîsan-kontrol-bike.
	xwe sernivîsan-vala-bike.
	xweyî sernivîsan
	li-dawiyê-zêde-bike: (
		Sernivîsa-HTTP nû
		mifte: ['Status'] buha: ['303 See Other']
	),
	li-dawiyê-zêde-bike: (
		Sernivîsa-HTTP nû
		mifte: ['Location'] buha: navnîşan
	).
	xwe derxe: ['Redirect'].
}.

Belgeya-Webê gava: ['danişînê-tune-bike'] bike: {
	xwe sernivîsan-kontrol-bike.
	>> daxwaz-http := xweyî daxwaz-http.
	>> nasnameya-danişînê := daxwaz-http cookie: ['xsid'].
	nasnameya-danişînê Tune? şaş: {
		>> sernivîsa-danişînê := Sernivîsa-HTTP nû.
		>> kêlî := Kêlî nû sal: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sernivîsa-danişînê mifte: ['Set-Cookie'] buha: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: kêlî,
			SEC: (xweyî ewle ev: ['Secure'] an-ew: ['']),
			SSITE: (xweyî heman-malper),
			XSID: nasnameya-danişînê
		).
		xweyî rêveberê-danişînan tune-bike.
		xweyî sernivîsan li-dawiyê-zêde-bike: sernivîsa-danişînê.
	}.
}.


Belgeya-Webê gava: ['şablon:'] bike: { :riya-pelê <- Şablon nû: (Pel nû: riya-pelê, bixwîne).
}.

Belgeya-Webê gava: ['derxe:cure:'] bike: { :encam :cure
	xweyî sernivîs-hatin-şandin şaş: {
		xweyî daneyên-danişînê Tune? şaş: {
			xweyî rêveberê-danişînan qeyd-bike: xweyî daneyên-danişînê.
		}.
		xweyî sernivîsan li-dawiyê-zêde-bike: (
			Sernivîsa-HTTP nû
			mifte: ['Content-type'] buha: cure
		).
		xweyî sernivîsan her-yek: { :_ :sernivîs
			Derketin binivîse: sernivîs.
		}.
		xweyî sernivîs-hatin-şandin := Rast.
		Derketin binivîse: ['\r\n'].
	}.
	Derketin binivîse: encam.
}.

Belgeya-Webê gava: ['biqedîne:cure:'] bike: { :encam :cure
	xweyî sernivîs-hatin-şandin şaş: {
		xweyî daneyên-danişînê Tune? şaş: {
			xweyî rêveberê-danişînan qeyd-bike: xweyî daneyên-danişînê.
		}.
		xweyî sernivîsan li-dawiyê-zêde-bike: (
			Sernivîsa-HTTP nû
			mifte: ['Content-type'] buha: cure
		).
		xweyî sernivîsan li-dawiyê-zêde-bike: (
			Sernivîsa-HTTP nû
			mifte: ['Content-Length'] buha: encam nivîs bytes
		).
		xweyî sernivîsan her-yek: { :_ :sernivîs
			Derketin binivîse: sernivîs.
		}.
		xweyî sernivîs-hatin-şandin := Rast.
		Derketin binivîse: ['\r\n'].
	}.
	Derketin binivîse: encam.
}.

Belgeya-Webê gava: ['derxe:'] bike: { :encam
	xwe derxe: encam cure: ['text/html; charset=utf-8'].
}.

Belgeya-Webê gava: ['biqedîne:'] bike: { :encam
	xwe biqedîne: encam cure: ['text/html; charset=utf-8'].
}.

Belgeya-Webê gava: ['json:'] bike: { :encam
	xwe derxe: ( JSON jsonify: encam ) cure: ['application/json'].
}.

Belgeya-Webê gava: ['nehat-dîtin:'] bike: { :encam
	xwe sernivîsan-vala-bike sernivîs: (
		Sernivîsa-HTTP nû mifte: ['Status'] buha: ['404 Not Found']
	).
	xwe derxe: encam.
}.


# Interface

>> Danişîn := Tişt nû.

Danişîn gava: ['nû'] bike: { <- xwe nû amade-bike ji-bo: Tune.
}.

Danişîn gava: ['ji-bo:'] bike: { :id
	xweyî id := id.
}.

Danişîn gava: ['bar-bike'] bike: {
	ev-kar şaşî: ['Not implemented.'].
}.

Danişîn gava: ['qeyd-bike:'] bike: {
	ev-kar şaşî: ['Not implemented.'].
}.

Danişîn gava: ['tune-bike'] bike: {
	ev-kar şaşî: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Danişîna-pela-demkî := Danişîn nû.

Danişîna-pela-demkî gava: ['amade-bike'] bike: {
	xweyî destpêka-rêyê := ['/tmp/sess-'].
}.

Danişîna-pela-demkî gava: ['pêşgira-rêyê:'] bike: { :rêzenivîs
	xweyî destpêka-rêyê := rêzenivîs.
}.

Danişîna-pela-demkî gava: ['pela-danişînê'] bike: { <- ( Pel nû: ( xweyî destpêka-rêyê + xweyî id + ['.txt'] ) ).
}.

Danişîna-pela-demkî gava: ['bar-bike'] bike: {
	>> pela-danişînê := xwe pela-danişînê.
	pela-danişînê heye şaş: {
		pela-danişînê binivîse: (Ferheng nû kod).
	}. <- pela-danişînê bixwîne tişt.
}.

Danişîna-pela-demkî gava: ['qeyd-bike:'] bike: { :dane
	>> pela-danişînê := xwe pela-danişînê.
	pela-danişînê heye rast: {
		pela-danişînê binivîse: dane kod.
	}.
}.

Danişîna-pela-demkî gava: ['tune-bike'] bike: {
	>> pela-danişînê := xwe pela-danişînê.
	pela-danişînê heye rast: {
		pela-danişînê jê-bibe.
	}.
}.


>> URL := Tişt nû.

URL gava: ['amade-bike'] bike: {
	xweyî protokol := ['https://'].
	xweyî mêvandar := ['localhost'].
	xweyî riya-pelê := [''].
	xweyî parametreyên-url := [''].
	xweyî hash := [''].
}.

URL gava: ['nû'] bike: { <- xwe nû amade-bike.
}.

URL gava: ['nivîs'] bike: { <- (
	xweyî protokol +
	xweyî mêvandar +
	xweyî riya-pelê +
	xweyî parametreyên-url +
	xweyî hash ).
}.

URL gava: ['protokol:'] bike: { :protokol
	((Lîste nû ; ['http'] ; ['https']) heye: protokol) rast: {
		xweyî protokol := protokol + ['://'].
	}, şaş: {
		ev-kar şaşî: ['Invalid protocol'].
	}.
}.

URL gava: ['mêvandar:'] bike: { :mêvandar
	#todo validate according to rfc
	xweyî mêvandar := mêvandar.
}.

URL gava: ['riya-pelê:'] bike: { :riya-pelê
	xweyî riya-pelê := ['/'] + riya-pelê url-kod-bike.
}.

URL gava: ['parametreyên-url:'] bike: { :nexşekirin
	>> parametreyên-url := Lîste nû.
	nexşekirin her-yek: { :mifte :buha
		parametreyên-url li-dawiyê-zêde-bike: mifte nivîs url-kod-bike + ['='] + buha nivîs url-kod-bike.
	}.
	xweyî parametreyên-url := ['?'] + ( parametreyên-url bigihîne-hev: ['&'] ).
}.

URL gava: ['haş:'] bike: { :hash
	xweyî hash := ['#'] + hash url-kod-bike.
}.

