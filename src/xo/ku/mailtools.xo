>> E-name := Tişt nû.

E-name gava: ['amade-bike'] bike: {
	xweyî wergir := Lîste nû.
	xweyî cc := Lîste nû.
	xweyî bcc := Lîste nû.
	xweyî şandyar := Tune.
	xweyî navê-şandyar := Tune.
	xweyî mijar := Tune.
	xweyî laş := Tune.
}.

E-name gava: ['nû'] bike: { <- xwe nû amade-bike.
}.

E-name gava: ['ji-re:'] bike: { :lîstekirin
	xweyî wergir := lîstekirin.
}.
 
E-name gava: ['cc:'] bike: { :lîstekirin
	xweyî cc := lîstekirin.
}.

E-name gava: ['bcc:'] bike: { :lîstekirin
	xweyî bcc := lîstekirin.
}.

E-name gava: ['mijar:'] bike: { :mijar
	xweyî mijar := mijar.
}.

E-name gava: ['şandyar:nav:'] bike: { :şandyar :nav
	xweyî şandyar := şandyar.
	xweyî navê-şandyar := nav.
}.

E-name gava: ['laş:'] bike: { :laş
	xweyî laş := laş.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-name gava: ['sernivîs:'] bike: { :rêz <- rêz biguherîne: ['\r'] bi: [''], biguherîne: ['\n'] bi: [''].
}.

E-name gava: ['bişîne'] bike: {
	>> f := Pel tempwrite: xwe çêbike.
	Bername pergal: ['sendmail -t < '] + f riya-pelê, rêza-nû.
}.

E-name gava: ['çêbike'] bike: {
	>> xêzbirîn := ['\r\n'].
	>> rêzenivîs := [''].
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['From: '] + xweyî navê-şandyar + [' <'] + ( xweyî şandyar ) + ['>']) + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['To: '] + ( xweyî wergir bigihîne-hev: [','] )) + xêzbirîn.
	xweyî cc hejmara-tiştan rast: {
		rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Cc: '] + ( xweyî cc bigihîne-hev: [','] )) + xêzbirîn.
	}.
	xweyî bcc hejmara-tiştan rast: {
		rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Bcc: '] + ( xweyî bcc bigihîne-hev: [','] )) + xêzbirîn.
	}.
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Subject: '] + xweyî mijar) + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: xweyî laş.
	rêzenivîs li-dawiyê-zêde-bike: xêzbirîn. <- rêzenivîs.
}.

>> E-name-HTML := E-name nû.

E-name-HTML gava: ['amade-bike'] bike: {
	xwe amade-bike.
	xweyî pêvek := Lîste nû.
	xweyî sînor := Qasa token: 40.
}.

E-name-HTML gava: ['pêve-bike:'] bike: { :pela-danişînê
	>> id := xweyî pêvek hejmara-tiştan.
	>> blob := pela-danişînê blob.
	xweyî pêvek li-dawiyê-zêde-bike: (
		Ferheng nû
			pela-danişînê: pela-danişînê riya-pelê,
			mime: ['image/'] + (Server mimetype: pela-danişînê riya-pelê),
			dane: blob base64-kod-bike
	).
	blob azad-bike. <- ['cid:attachment'] + id.
}.

E-name-HTML gava: ['çêbike'] bike: {
	>> xêzbirîn := ['\r\n'].
	>> rêzenivîs := [''].
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['From: '] + xweyî navê-şandyar + [' <'] + ( xweyî şandyar ) + ['>']) + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['To: '] + ( xweyî wergir bigihîne-hev: [','] )) + xêzbirîn.
	xweyî cc hejmara-tiştan rast: {
		rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Cc: '] + ( xweyî cc bigihîne-hev: [','] )) + xêzbirîn.
	}.
	xweyî bcc hejmara-tiştan rast: {
		rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Bcc: '] + ( xweyî bcc bigihîne-hev: [','] )) + xêzbirîn.
	}.
	rêzenivîs li-dawiyê-zêde-bike: (xwe sernivîs: ['Subject: '] + xweyî mijar) + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: ['MIME-Version: 1.0'] + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: ['Content-Type: multipart/related; boundary="'] + xweyî sînor + ['"; type=text/html'] + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: ['--'] + xweyî sînor + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: ['Content-Type: text/html; charset=UTF-8'] + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: ['Content-Transfer-Encoding: 7bit'] + xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
	rêzenivîs li-dawiyê-zêde-bike: xweyî laş.
	rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
	xweyî pêvek her-yek: { :id :agahî
		>> blob := agahî dane.
		rêzenivîs li-dawiyê-zêde-bike: ['--'] + xweyî sînor + xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: ['Content-Type: '] + agahî mime + xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: ['Content-Transfer-Encoding: base64'] + xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: ['Content-ID: <attachment'] + id + ['>'] + xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: ['Content-Disposition: inline; filename="'] + agahî pela-danişînê + ['"'] + xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
		>> herî-zêde := 76.
		>> dirêjiya-nivîsê := blob dirêjî.
		>> keriyan := (dirêjiya-nivîsê / herî-zêde) ber-bi-jor-gilover.
		{ :i
			>> kerî := blob kopî-bike ji: i * herî-zêde dirêjî: herî-zêde.
			rêzenivîs li-dawiyê-zêde-bike: kerî + xêzbirîn.
		} * keriyan.
		rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
		rêzenivîs li-dawiyê-zêde-bike: xêzbirîn.
	}.
	rêzenivîs li-dawiyê-zêde-bike: ['--'] + xweyî sînor + ['--'] + xêzbirîn. <- rêzenivîs.
}.
