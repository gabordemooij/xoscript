
# ~ Simple template engine ~

>> Şablon := Tişt nû.

Şablon gava: ['nû'] bike: { <- xwe nû naverok: [''].
}.

Şablon gava: ['naverok:'] bike: { :naverok
	xweyî naverok := naverok. 
}.

Şablon gava: ['nû:'] bike: { :naverok <- xwe nû naverok: naverok.
}.

Şablon gava: ['bibire:'] bike: { :nîşan
	>> nîşana-destpêkê := (['<!-- cut:%id% -->'] %id%: nîşan).
	>> nîşana-dawiyê := (['<!-- /cut:%id% -->'] %id%: nîşan).
	>> beşan := xweyî naverok parçe-bike: nîşana-destpêkê.
	>> pêşgir := beşan yekem.
	>> beşan2 := beşan ya-dawî parçe-bike: nîşana-dawiyê.
	>> paşgir := beşan2 ya-dawî.
	>> beş := beşan2 yekem.
	>> mayî := pêşgir + paşgir.
	xweyî naverok := mayî. <- Şablon nû: beş.
	
}.

Şablon gava: ['kopî-bike'] bike: { <- xwe nû: xwe nivîs kopî-bike.
}.
	
Şablon gava: ['bizeliqîne:li:'] bike: { :parçe-nivîs :id
	>> nîşana-zeliqandinê := (['<!-- paste:%id% -->'] %id%: id).
	xweyî naverok biguherîne: nîşana-zeliqandinê bi: ( parçe-nivîs nivîs + nîşana-zeliqandinê ).
}.

Şablon gava: ['saz-bike:nirx:'] bike: { :cih :buha
	xweyî naverok biguherîne: ['<!-- slot:'] + cih + [' -->'] bi: ( Server html-kod-bike: buha ).
}.

Şablon gava: ['saz-bike:html:'] bike: { :cih :html
	xweyî naverok biguherîne: ['<!-- slot:'] + cih + [' -->'] bi: html.
}.

Şablon gava: ['bersiv-bide:û:'] bike: { :cih :buha
	xwe saz-bike: (cih ji: 0 dirêjî: (cih dirêjî - 1)) nirx: buha.
}.

Şablon gava: ['nl2br'] bike: {
	xweyî naverok biguherîne: ['\n'] bi: ['<br>'].
}.

Şablon gava: ['xweş-bike'] bike: {
	xweyî naverok :=
		Qalib
		nû: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		lihevhatin: xweyî naverok
		bike: { <- ['']. }.
}.

Şablon gava: ['birînan-xweş-bike'] bike: {
	>> hêman := Lîste nû.
	Qalib
	nû: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	lihevhatin: xweyî naverok
	bike: { :_ :beş
		hêman li-dawiyê-zêde-bike: beş ? 1.
	}.
	hêman her-yek: { :_ :id
		xweyî naverok :=
			Qalib nû: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			lihevhatin: xweyî naverok
			bike: { <- ['']. }.
	 }.
}.

Şablon gava: ['valahiyan-xweş-bike'] bike: {
	xweyî naverok :=
		Qalib
		nû: ['\\s*\\n'],
		lihevhatin: xweyî naverok
		bike: { <- ['\n']. }.
	xweyî naverok :=
		Qalib
		nû: ['\\n[\\s\\t]+'],
		lihevhatin: xweyî naverok
		bike: { <- ['\n']. }.
}.

Şablon gava: ['hemûyan-xweş-bike'] bike: {
	xwe xweş-bike.
	xwe birînan-xweş-bike.
	xwe valahiyan-xweş-bike.
}.

Şablon gava: ['nivîs'] bike: { <- xweyî naverok.
}.
