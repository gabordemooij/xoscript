
# ~ Simple template engine ~

>> کينډۍ := څیز نوی.

کينډۍ کله: ['نوی'] وکړه: { <- ځان نوی منځپانګه: [''].
}.

کينډۍ کله: ['منځپانګه:'] وکړه: { :منځپانګه
	خپل منځپانګه := منځپانګه. 
}.

کينډۍ کله: ['نوی:'] وکړه: { :منځپانګه <- ځان نوی منځپانګه: منځپانګه.
}.

کينډۍ کله: ['پرې-کړه:'] وکړه: { :نښه
	>> د-پیل-نښه := (['<!-- cut:%id% -->'] %id%: نښه).
	>> د-پای-نښه := (['<!-- /cut:%id% -->'] %id%: نښه).
	>> برخې := خپل منځپانګه وویشه: د-پیل-نښه.
	>> مختاړی := برخې لومړی.
	>> برخې2 := برخې وروستی وویشه: د-پای-نښه.
	>> وروستاړی := برخې2 وروستی.
	>> برخه := برخې2 لومړی.
	>> پاتې := مختاړی + وروستاړی.
	خپل منځپانګه := پاتې. <- کينډۍ نوی: برخه.
	
}.

کينډۍ کله: ['کاپي'] وکړه: { <- ځان نوی: ځان په-متن کاپي.
}.
	
کينډۍ کله: ['ونښلوه:کیلي:'] وکړه: { :اقتباس :id
	>> د-نښلولو-نښه := (['<!-- paste:%id% -->'] %id%: id).
	خپل منځپانګه بدل-کړه: د-نښلولو-نښه په: ( اقتباس په-متن + د-نښلولو-نښه ).
}.

کينډۍ کله: ['وټاکه:ارزښت:'] وکړه: { :ځای :ارزښت
	خپل منځپانګه بدل-کړه: ['<!-- slot:'] + ځای + [' -->'] په: ( Server html-کوډول: ارزښت ).
}.

کينډۍ کله: ['وټاکه:html:'] وکړه: { :ځای :html
	خپل منځپانګه بدل-کړه: ['<!-- slot:'] + ځای + [' -->'] په: html.
}.

کينډۍ کله: ['ځواب:او:'] وکړه: { :ځای :ارزښت
	ځان وټاکه: (ځای پیل: 0 اوږدوالی: (ځای اوږدوالی - 1)) ارزښت: ارزښت.
}.

کينډۍ کله: ['nl2br'] وکړه: {
	خپل منځپانګه بدل-کړه: ['\n'] په: ['<br>'].
}.

کينډۍ کله: ['پاک-کړه'] وکړه: {
	خپل منځپانګه :=
		بېلګه
		نوی: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		سمون: خپل منځپانګه
		وکړه: { <- ['']. }.
}.

کينډۍ کله: ['پرېکړې-پاک-کړه'] وکړه: {
	>> توکي := لیست نوی.
	بېلګه
	نوی: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	سمون: خپل منځپانګه
	وکړه: { :_ :برخه
		توکي پای-ته-زیات-کړه: برخه ? 1.
	}.
	توکي هر-یو: { :_ :id
		خپل منځپانګه :=
			بېلګه نوی: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			سمون: خپل منځپانګه
			وکړه: { <- ['']. }.
	 }.
}.

کينډۍ کله: ['تشې-پاک-کړه'] وکړه: {
	خپل منځپانګه :=
		بېلګه
		نوی: ['\\s*\\n'],
		سمون: خپل منځپانګه
		وکړه: { <- ['\n']. }.
	خپل منځپانګه :=
		بېلګه
		نوی: ['\\n[\\s\\t]+'],
		سمون: خپل منځپانګه
		وکړه: { <- ['\n']. }.
}.

کينډۍ کله: ['ټول-پاک-کړه'] وکړه: {
	ځان پاک-کړه.
	ځان پرېکړې-پاک-کړه.
	ځان تشې-پاک-کړه.
}.

کينډۍ کله: ['په-متن'] وکړه: { <- خپل منځپانګه.
}.
