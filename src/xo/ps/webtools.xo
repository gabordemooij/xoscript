غوښتنه-HTTP کله: ['HTTP-سرلیک:'] وکړه: { :کیلي <- پروګرام تنظیم: کیلي.
}.

>> سرلیک-HTTP := څیز نوی.

سرلیک-HTTP کله: ['نوی'] وکړه: { <- ځان نوی پیل-کول.
}.

سرلیک-HTTP کله: ['پیل-کول'] وکړه: {
	خپل کیلي := هیڅ.
	خپل ارزښت := هیڅ.
}.

سرلیک-HTTP کله: ['کیلي:ارزښت:'] وکړه: { :کیلي :ارزښت
	خپل کیلي := کیلي.
	خپل ارزښت := ارزښت.
}.

سرلیک-HTTP کله: ['کیلي'] وکړه: { <- خپل کیلي.
}.

سرلیک-HTTP کله: ['ارزښت'] وکړه: { <- خپل ارزښت.
}.


سرلیک-HTTP کله: ['په-متن'] وکړه: {
	>> کرښه := خپل کیلي + [': '] + خپل ارزښت.
	کرښه بدل-کړه: ['\r'] په: [''], بدل-کړه: ['\n'] په: ['']. <- کرښه + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> ویب-سند := څیز نوی.

ویب-سند کله: ['نوی'] وکړه: { <- ځان نوی پیل-کول.
}.

ویب-سند کله: ['پیل-کول'] وکړه: {
	خپل سرلیکونه := لیست نوی.
	خپل د-ناستې-پېژند := هیڅ.
	خپل د-ناستو-مدیر := لنډمهاله-دوتنه-ناسته نوی.
	خپل د-ناستې-معلومات := هیڅ.
	خپل خوندي := رښتیا.
	خپل ورته-سایټ := ['Strict'].
	خپل سرلیکونه-لېږل-شوي := دروغ.
	خپل غوښتنه-http := غوښتنه-HTTP نوی.
}.

ویب-سند کله: ['غوښتنه-http:'] وکړه: { :غوښتنه-http
	خپل غوښتنه-http := غوښتنه-http.
}. 

ویب-سند کله: ['خوندي-ناستې-کوکي:'] وکړه: { :خوندي
	ځان سرلیکونه-وګوره.
	خپل خوندي := خوندي.
}.

ویب-سند کله: ['د-ورته-سایټ-ناستې-کوکي:'] وکړه: { :ارزښت
	ځان سرلیکونه-وګوره.
	>> انتخابونه := لیست نوی 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	انتخابونه لري: ارزښت, که-دروغ: {
		دا-دنده تېروتنه: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	خپل ورته-سایټ := ارزښت.
}.

ویب-سند کله: ['سرلیک:'] وکړه: { :سرلیک
	ځان سرلیکونه-وګوره.
	خپل سرلیکونه پای-ته-زیات-کړه: سرلیک.
}.

ویب-سند کله: ['سرلیکونه-تش-کړه'] وکړه: {
	ځان سرلیکونه-وګوره.
	خپل سرلیکونه := لیست نوی.
}.

ویب-سند کله: ['د-ناستو-مدیر:'] وکړه: { :مدیر
	ځان سرلیکونه-وګوره.
	خپل د-ناستو-مدیر := مدیر.
}.

ویب-سند کله: ['د-ناستو-مدیر'] وکړه: { <- خپل د-ناستو-مدیر.
}.

ویب-سند کله: ['سرلیکونه-وګوره'] وکړه: {
	خپل سرلیکونه-لېږل-شوي که-رښتیا: {
		دا-دنده تېروتنه: ['Headers already sent to client.'].
	}.
}.

ویب-سند کله: ['ناسته-پیل-کړه'] وکړه: {
	ځان سرلیکونه-وګوره.
	>> غوښتنه-http := خپل غوښتنه-http.
	>> د-ناستې-پېژند := غوښتنه-http cookie: ['xsid'].
	د-ناستې-پېژند هیڅ? که-دروغ: {
		(( بېلګه نوی: ['^[A-Za-z0-9]+\\z'], سمون: د-ناستې-پېژند ) = 0) که-رښتیا: {
			د-ناستې-پېژند := هیڅ.
		}.
	}.
	د-ناستې-پېژند هیڅ? که-رښتیا: {
		د-ناستې-پېژند := خزانه ټوکن: 30.
		>> د-ناستې-سرلیک := سرلیک-HTTP نوی
		کیلي: ['Set-Cookie'] ارزښت: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (خپل خوندي دا: ['Secure'] یا-هغه: ['']),
		SSITE: (خپل ورته-سایټ),
		XSID: د-ناستې-پېژند
		).
		خپل سرلیکونه پای-ته-زیات-کړه: د-ناستې-سرلیک.
	}.
	خپل د-ناستې-معلومات := خپل د-ناستو-مدیر لپاره: د-ناستې-پېژند, پورته-کړه. <- خپل د-ناستې-معلومات. # reference
}.

ویب-سند کله: ['ورشه:'] وکړه: { :پته
	ځان سرلیکونه-وګوره.
	ځان سرلیکونه-تش-کړه.
	خپل سرلیکونه
	پای-ته-زیات-کړه: (
		سرلیک-HTTP نوی
		کیلي: ['Status'] ارزښت: ['303 See Other']
	),
	پای-ته-زیات-کړه: (
		سرلیک-HTTP نوی
		کیلي: ['Location'] ارزښت: پته
	).
	ځان وباسه: ['Redirect'].
}.

ویب-سند کله: ['ناسته-ورکه-کړه'] وکړه: {
	ځان سرلیکونه-وګوره.
	>> غوښتنه-http := خپل غوښتنه-http.
	>> د-ناستې-پېژند := غوښتنه-http cookie: ['xsid'].
	د-ناستې-پېژند هیڅ? که-دروغ: {
		>> د-ناستې-سرلیک := سرلیک-HTTP نوی.
		>> شېبه := شیبه نوی کال: 1970, په-بڼه: ['%a, %d %b %Y %H:%M:%S GMT'].
		د-ناستې-سرلیک کیلي: ['Set-Cookie'] ارزښت: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: شېبه,
			SEC: (خپل خوندي دا: ['Secure'] یا-هغه: ['']),
			SSITE: (خپل ورته-سایټ),
			XSID: د-ناستې-پېژند
		).
		خپل د-ناستو-مدیر ورک-کړه.
		خپل سرلیکونه پای-ته-زیات-کړه: د-ناستې-سرلیک.
	}.
}.


ویب-سند کله: ['کينډۍ:'] وکړه: { :د-دوتنې-لار <- کينډۍ نوی: (دوتنه نوی: د-دوتنې-لار, ولوله).
}.

ویب-سند کله: ['وباسه:ډول:'] وکړه: { :پایله :ډول
	خپل سرلیکونه-لېږل-شوي که-دروغ: {
		خپل د-ناستې-معلومات هیڅ? که-دروغ: {
			خپل د-ناستو-مدیر خوندي-کړه: خپل د-ناستې-معلومات.
		}.
		خپل سرلیکونه پای-ته-زیات-کړه: (
			سرلیک-HTTP نوی
			کیلي: ['Content-type'] ارزښت: ډول
		).
		خپل سرلیکونه هر-یو: { :_ :سرلیک
			وتنه ولیکه: سرلیک.
		}.
		خپل سرلیکونه-لېږل-شوي := رښتیا.
		وتنه ولیکه: ['\r\n'].
	}.
	وتنه ولیکه: پایله.
}.

ویب-سند کله: ['بشپړ-کړه:ډول:'] وکړه: { :پایله :ډول
	خپل سرلیکونه-لېږل-شوي که-دروغ: {
		خپل د-ناستې-معلومات هیڅ? که-دروغ: {
			خپل د-ناستو-مدیر خوندي-کړه: خپل د-ناستې-معلومات.
		}.
		خپل سرلیکونه پای-ته-زیات-کړه: (
			سرلیک-HTTP نوی
			کیلي: ['Content-type'] ارزښت: ډول
		).
		خپل سرلیکونه پای-ته-زیات-کړه: (
			سرلیک-HTTP نوی
			کیلي: ['Content-Length'] ارزښت: پایله په-متن بایټونه
		).
		خپل سرلیکونه هر-یو: { :_ :سرلیک
			وتنه ولیکه: سرلیک.
		}.
		خپل سرلیکونه-لېږل-شوي := رښتیا.
		وتنه ولیکه: ['\r\n'].
	}.
	وتنه ولیکه: پایله.
}.

ویب-سند کله: ['وباسه:'] وکړه: { :پایله
	ځان وباسه: پایله ډول: ['text/html; charset=utf-8'].
}.

ویب-سند کله: ['بشپړ-کړه:'] وکړه: { :پایله
	ځان بشپړ-کړه: پایله ډول: ['text/html; charset=utf-8'].
}.

ویب-سند کله: ['json:'] وکړه: { :پایله
	ځان وباسه: ( JSON jsonify: پایله ) ډول: ['application/json'].
}.

ویب-سند کله: ['ونه-موندل-شو:'] وکړه: { :پایله
	ځان سرلیکونه-تش-کړه سرلیک: (
		سرلیک-HTTP نوی کیلي: ['Status'] ارزښت: ['404 Not Found']
	).
	ځان وباسه: پایله.
}.


# Interface

>> ناسته := څیز نوی.

ناسته کله: ['نوی'] وکړه: { <- ځان نوی پیل-کول لپاره: هیڅ.
}.

ناسته کله: ['لپاره:'] وکړه: { :id
	خپل id := id.
}.

ناسته کله: ['پورته-کړه'] وکړه: {
	دا-دنده تېروتنه: ['Not implemented.'].
}.

ناسته کله: ['خوندي-کړه:'] وکړه: {
	دا-دنده تېروتنه: ['Not implemented.'].
}.

ناسته کله: ['ورک-کړه'] وکړه: {
	دا-دنده تېروتنه: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> لنډمهاله-دوتنه-ناسته := ناسته نوی.

لنډمهاله-دوتنه-ناسته کله: ['پیل-کول'] وکړه: {
	خپل د-لارې-پیل := ['/tmp/sess-'].
}.

لنډمهاله-دوتنه-ناسته کله: ['د-لارې-مختاړی:'] وکړه: { :متني-لړۍ
	خپل د-لارې-پیل := متني-لړۍ.
}.

لنډمهاله-دوتنه-ناسته کله: ['د-ناستې-دوتنه'] وکړه: { <- ( دوتنه نوی: ( خپل د-لارې-پیل + خپل id + ['.txt'] ) ).
}.

لنډمهاله-دوتنه-ناسته کله: ['پورته-کړه'] وکړه: {
	>> د-ناستې-دوتنه := ځان د-ناستې-دوتنه.
	د-ناستې-دوتنه شته که-دروغ: {
		د-ناستې-دوتنه ولیکه: (قاموس نوی کوډ).
	}. <- د-ناستې-دوتنه ولوله په-څیز.
}.

لنډمهاله-دوتنه-ناسته کله: ['خوندي-کړه:'] وکړه: { :معلومات
	>> د-ناستې-دوتنه := ځان د-ناستې-دوتنه.
	د-ناستې-دوتنه شته که-رښتیا: {
		د-ناستې-دوتنه ولیکه: معلومات کوډ.
	}.
}.

لنډمهاله-دوتنه-ناسته کله: ['ورک-کړه'] وکړه: {
	>> د-ناستې-دوتنه := ځان د-ناستې-دوتنه.
	د-ناستې-دوتنه شته که-رښتیا: {
		د-ناستې-دوتنه ړنګ-کړه.
	}.
}.


>> URL := څیز نوی.

URL کله: ['پیل-کول'] وکړه: {
	خپل پروتوکول := ['https://'].
	خپل کوربه := ['localhost'].
	خپل د-دوتنې-لار := [''].
	خپل url-پارامیټرونه := [''].
	خپل hash := [''].
}.

URL کله: ['نوی'] وکړه: { <- ځان نوی پیل-کول.
}.

URL کله: ['په-متن'] وکړه: { <- (
	خپل پروتوکول +
	خپل کوربه +
	خپل د-دوتنې-لار +
	خپل url-پارامیټرونه +
	خپل hash ).
}.

URL کله: ['پروتوکول:'] وکړه: { :پروتوکول
	((لیست نوی ; ['http'] ; ['https']) لري: پروتوکول) که-رښتیا: {
		خپل پروتوکول := پروتوکول + ['://'].
	}, که-دروغ: {
		دا-دنده تېروتنه: ['Invalid protocol'].
	}.
}.

URL کله: ['کوربه:'] وکړه: { :کوربه
	#todo validate according to rfc
	خپل کوربه := کوربه.
}.

URL کله: ['د-دوتنې-لار:'] وکړه: { :د-دوتنې-لار
	خپل د-دوتنې-لار := ['/'] + د-دوتنې-لار url-کوډول.
}.

URL کله: ['url-پارامیټرونه:'] وکړه: { :نقشه-کول
	>> url-پارامیټرونه := لیست نوی.
	نقشه-کول هر-یو: { :کیلي :ارزښت
		url-پارامیټرونه پای-ته-زیات-کړه: کیلي په-متن url-کوډول + ['='] + ارزښت په-متن url-کوډول.
	}.
	خپل url-پارامیټرونه := ['?'] + ( url-پارامیټرونه یوځای-کړه: ['&'] ).
}.

URL کله: ['هش:'] وکړه: { :hash
	خپل hash := ['#'] + hash url-کوډول.
}.

