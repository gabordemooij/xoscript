>> بریښنالیک := څیز نوی.

بریښنالیک کله: ['پیل-کول'] وکړه: {
	خپل ترلاسه-کوونکي := لیست نوی.
	خپل cc := لیست نوی.
	خپل bcc := لیست نوی.
	خپل لېږونکی := هیڅ.
	خپل د-لېږونکي-نوم := هیڅ.
	خپل موضوع := هیڅ.
	خپل متن-لیک := هیڅ.
}.

بریښنالیک کله: ['نوی'] وکړه: { <- ځان نوی پیل-کول.
}.

بریښنالیک کله: ['ته:'] وکړه: { :شمېرنه
	خپل ترلاسه-کوونکي := شمېرنه.
}.
 
بریښنالیک کله: ['cc:'] وکړه: { :شمېرنه
	خپل cc := شمېرنه.
}.

بریښنالیک کله: ['bcc:'] وکړه: { :شمېرنه
	خپل bcc := شمېرنه.
}.

بریښنالیک کله: ['موضوع:'] وکړه: { :موضوع
	خپل موضوع := موضوع.
}.

بریښنالیک کله: ['لېږونکی:نوم:'] وکړه: { :لېږونکی :نوم
	خپل لېږونکی := لېږونکی.
	خپل د-لېږونکي-نوم := نوم.
}.

بریښنالیک کله: ['متن-لیک:'] وکړه: { :متن-لیک
	خپل متن-لیک := متن-لیک.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
بریښنالیک کله: ['سرلیک:'] وکړه: { :کرښه <- کرښه بدل-کړه: ['\r'] په: [''], بدل-کړه: ['\n'] په: [''].
}.

بریښنالیک کله: ['ولېږه'] وکړه: {
	>> f := دوتنه لنډمهاله-لیکنه: ځان جوړ-کړه.
	پروګرام سیسټم: ['sendmail -t < '] + f د-دوتنې-لار, نوې-کرښه.
}.

بریښنالیک کله: ['جوړ-کړه'] وکړه: {
	>> کرښې-ماتول := ['\r\n'].
	>> متني-لړۍ := [''].
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['From: '] + خپل د-لېږونکي-نوم + [' <'] + ( خپل لېږونکی ) + ['>']) + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['To: '] + ( خپل ترلاسه-کوونکي یوځای-کړه: [','] )) + کرښې-ماتول.
	خپل cc شمېر که-رښتیا: {
		متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Cc: '] + ( خپل cc یوځای-کړه: [','] )) + کرښې-ماتول.
	}.
	خپل bcc شمېر که-رښتیا: {
		متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Bcc: '] + ( خپل bcc یوځای-کړه: [','] )) + کرښې-ماتول.
	}.
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Subject: '] + خپل موضوع) + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: خپل متن-لیک.
	متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول. <- متني-لړۍ.
}.

>> بریښنالیک-HTML := بریښنالیک نوی.

بریښنالیک-HTML کله: ['پیل-کول'] وکړه: {
	ځان پیل-کول.
	خپل ضمیمې := لیست نوی.
	خپل پوله := خزانه ټوکن: 40.
}.

بریښنالیک-HTML کله: ['ضمیمه-کړه:'] وکړه: { :د-ناستې-دوتنه
	>> id := خپل ضمیمې شمېر.
	>> blob := د-ناستې-دوتنه blob.
	خپل ضمیمې پای-ته-زیات-کړه: (
		قاموس نوی
			د-ناستې-دوتنه: د-ناستې-دوتنه د-دوتنې-لار,
			mime: ['image/'] + (Server mimetype: د-ناستې-دوتنه د-دوتنې-لار),
			معلومات: blob base64-کوډول
	).
	blob ازاد-کړه. <- ['cid:attachment'] + id.
}.

بریښنالیک-HTML کله: ['جوړ-کړه'] وکړه: {
	>> کرښې-ماتول := ['\r\n'].
	>> متني-لړۍ := [''].
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['From: '] + خپل د-لېږونکي-نوم + [' <'] + ( خپل لېږونکی ) + ['>']) + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['To: '] + ( خپل ترلاسه-کوونکي یوځای-کړه: [','] )) + کرښې-ماتول.
	خپل cc شمېر که-رښتیا: {
		متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Cc: '] + ( خپل cc یوځای-کړه: [','] )) + کرښې-ماتول.
	}.
	خپل bcc شمېر که-رښتیا: {
		متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Bcc: '] + ( خپل bcc یوځای-کړه: [','] )) + کرښې-ماتول.
	}.
	متني-لړۍ پای-ته-زیات-کړه: (ځان سرلیک: ['Subject: '] + خپل موضوع) + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: ['MIME-Version: 1.0'] + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: ['Content-Type: multipart/related; boundary="'] + خپل پوله + ['"; type=text/html'] + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: ['--'] + خپل پوله + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: ['Content-Type: text/html; charset=UTF-8'] + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: ['Content-Transfer-Encoding: 7bit'] + کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
	متني-لړۍ پای-ته-زیات-کړه: خپل متن-لیک.
	متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
	خپل ضمیمې هر-یو: { :id :خبرتیا
		>> blob := خبرتیا معلومات.
		متني-لړۍ پای-ته-زیات-کړه: ['--'] + خپل پوله + کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: ['Content-Type: '] + خبرتیا mime + کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: ['Content-Transfer-Encoding: base64'] + کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: ['Content-ID: <attachment'] + id + ['>'] + کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: ['Content-Disposition: inline; filename="'] + خبرتیا د-ناستې-دوتنه + ['"'] + کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
		>> تر-ټولو-ډېر := 76.
		>> د-متن-اوږدوالی := blob اوږدوالی.
		>> ټوکرونه := (د-متن-اوږدوالی / تر-ټولو-ډېر) پورته-ګردول.
		{ :i
			>> ټوکر := blob کاپي پیل: i * تر-ټولو-ډېر اوږدوالی: تر-ټولو-ډېر.
			متني-لړۍ پای-ته-زیات-کړه: ټوکر + کرښې-ماتول.
		} * ټوکرونه.
		متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
		متني-لړۍ پای-ته-زیات-کړه: کرښې-ماتول.
	}.
	متني-لړۍ پای-ته-زیات-کړه: ['--'] + خپل پوله + ['--'] + کرښې-ماتول. <- متني-لړۍ.
}.
