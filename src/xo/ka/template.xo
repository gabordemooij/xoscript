
# ~ Simple template engine ~

>> მაკეტი := ობიექტი ახალი.

მაკეტი როცა: ['ახალი'] გააკეთე: { <- თავად ახალი შიგთავსი: [''].
}.

მაკეტი როცა: ['შიგთავსი:'] გააკეთე: { :შიგთავსი
	საკუთარი შიგთავსი := შიგთავსი. 
}.

მაკეტი როცა: ['ახალი:'] გააკეთე: { :შიგთავსი <- თავად ახალი შიგთავსი: შიგთავსი.
}.

მაკეტი როცა: ['ამოჭრა:'] გააკეთე: { :მარკერი
	>> დაწყების-მარკერი := (['<!-- cut:%id% -->'] %id%: მარკერი).
	>> ბოლოს-მარკერი := (['<!-- /cut:%id% -->'] %id%: მარკერი).
	>> ნაწილები := საკუთარი შიგთავსი გაყოფა: დაწყების-მარკერი.
	>> პრეფიქსი := ნაწილები პირველი.
	>> ნაწილები2 := ნაწილები ბოლო გაყოფა: ბოლოს-მარკერი.
	>> სუფიქსი := ნაწილები2 ბოლო.
	>> ნაწილი := ნაწილები2 პირველი.
	>> ნაშთი := პრეფიქსი + სუფიქსი.
	საკუთარი შიგთავსი := ნაშთი. <- მაკეტი ახალი: ნაწილი.
	
}.

მაკეტი როცა: ['კოპირება'] გააკეთე: { <- თავად ახალი: თავად ტექსტად კოპირება.
}.
	
მაკეტი როცა: ['ჩაკვრა:ადგილზე:'] გააკეთე: { :ფრაგმენტი-html :id
	>> ჩასმის-მარკერი := (['<!-- paste:%id% -->'] %id%: id).
	საკუთარი შიგთავსი შეცვლა: ჩასმის-მარკერი ახლით: ( ფრაგმენტი-html ტექსტად + ჩასმის-მარკერი ).
}.

მაკეტი როცა: ['დაყენება:მნიშვნელობა:'] გააკეთე: { :სლოტი :მნიშვნელობა
	საკუთარი შიგთავსი შეცვლა: ['<!-- slot:'] + სლოტი + [' -->'] ახლით: ( Server html-კოდირება: მნიშვნელობა ).
}.

მაკეტი როცა: ['დაყენება:html:'] გააკეთე: { :სლოტი :html
	საკუთარი შიგთავსი შეცვლა: ['<!-- slot:'] + სლოტი + [' -->'] ახლით: html.
}.

მაკეტი როცა: ['უპასუხე:და:'] გააკეთე: { :სლოტი :მნიშვნელობა
	თავად დაყენება: (სლოტი საიდან: 0 სიგრძე: (სლოტი სიგრძე - 1)) მნიშვნელობა: მნიშვნელობა.
}.

მაკეტი როცა: ['nl2br'] გააკეთე: {
	საკუთარი შიგთავსი შეცვლა: ['\n'] ახლით: ['<br>'].
}.

მაკეტი როცა: ['მოწესრიგება'] გააკეთე: {
	საკუთარი შიგთავსი :=
		შაბლონი
		ახალი: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		დამთხვევა: საკუთარი შიგთავსი
		გააკეთე: { <- ['']. }.
}.

მაკეტი როცა: ['ამონაჭრების-მოწესრიგება'] გააკეთე: {
	>> ელემენტები := სია ახალი.
	შაბლონი
	ახალი: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	დამთხვევა: საკუთარი შიგთავსი
	გააკეთე: { :_ :ნაწილი
		ელემენტები ბოლოში-დამატება: ნაწილი ? 1.
	}.
	ელემენტები თითოეული: { :_ :id
		საკუთარი შიგთავსი :=
			შაბლონი ახალი: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			დამთხვევა: საკუთარი შიგთავსი
			გააკეთე: { <- ['']. }.
	 }.
}.

მაკეტი როცა: ['ჰარების-მოწესრიგება'] გააკეთე: {
	საკუთარი შიგთავსი :=
		შაბლონი
		ახალი: ['\\s*\\n'],
		დამთხვევა: საკუთარი შიგთავსი
		გააკეთე: { <- ['\n']. }.
	საკუთარი შიგთავსი :=
		შაბლონი
		ახალი: ['\\n[\\s\\t]+'],
		დამთხვევა: საკუთარი შიგთავსი
		გააკეთე: { <- ['\n']. }.
}.

მაკეტი როცა: ['ყველაფრის-მოწესრიგება'] გააკეთე: {
	თავად მოწესრიგება.
	თავად ამონაჭრების-მოწესრიგება.
	თავად ჰარების-მოწესრიგება.
}.

მაკეტი როცა: ['ტექსტად'] გააკეთე: { <- საკუთარი შიგთავსი.
}.
