>> Email := ობიექტი ახალი.

Email როცა: ['init'] გააკეთე: {
	საკუთარი recipients := სია ახალი.
	საკუთარი cc := სია ახალი.
	საკუთარი bcc := სია ახალი.
	საკუთარი from := არაფერი.
	საკუთარი from-name := არაფერი.
	საკუთარი subject := არაფერი.
	საკუთარი body := არაფერი.
}.

Email როცა: ['ახალი'] გააკეთე: { <- თავად ახალი init.
}.

Email როცა: ['to:'] გააკეთე: { :list
	საკუთარი recipients := list.
}.
 
Email როცა: ['cc:'] გააკეთე: { :list
	საკუთარი cc := list.
}.

Email როცა: ['bcc:'] გააკეთე: { :list
	საკუთარი bcc := list.
}.

Email როცა: ['subject:'] გააკეთე: { :subject
	საკუთარი subject := subject.
}.

Email როცა: ['from:name:'] გააკეთე: { :from :სახელი
	საკუთარი from := from.
	საკუთარი from-name := სახელი.
}.

Email როცა: ['body:'] გააკეთე: { :body
	საკუთარი body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email როცა: ['header:'] გააკეთე: { :line <- line შეცვლა: ['\r'] ახლით: [''], შეცვლა: ['\n'] ახლით: [''].
}.

Email როცა: ['send'] გააკეთე: {
	>> f := ფაილი tempwrite: თავად generate.
	პროგრამა სისტემა: ['sendmail -t < '] + f ბილიკი, ახალი-ხაზი.
}.

Email როცა: ['generate'] გააკეთე: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ბოლოში-დამატება: (თავად header: ['From: '] + საკუთარი from-name + [' <'] + ( საკუთარი from ) + ['>']) + brk.
	str ბოლოში-დამატება: (თავად header: ['To: '] + ( საკუთარი recipients გაერთიანება: [','] )) + brk.
	საკუთარი cc რაოდენობა ჭეშმარიტი: {
		str ბოლოში-დამატება: (თავად header: ['Cc: '] + ( საკუთარი cc გაერთიანება: [','] )) + brk.
	}.
	საკუთარი bcc რაოდენობა ჭეშმარიტი: {
		str ბოლოში-დამატება: (თავად header: ['Bcc: '] + ( საკუთარი bcc გაერთიანება: [','] )) + brk.
	}.
	str ბოლოში-დამატება: (თავად header: ['Subject: '] + საკუთარი subject) + brk.
	str ბოლოში-დამატება: brk.
	str ბოლოში-დამატება: საკუთარი body.
	str ბოლოში-დამატება: brk. <- str.
}.

>> HTML-Email := Email ახალი.

HTML-Email როცა: ['init'] გააკეთე: {
	თავად init.
	საკუთარი attachments := სია ახალი.
	საკუთარი boundary := სეიფი ტოკენი: 40.
}.

HTML-Email როცა: ['attach:'] გააკეთე: { :file
	>> id := საკუთარი attachments რაოდენობა.
	>> blob := file blob.
	საკუთარი attachments ბოლოში-დამატება: (
		ლექსიკონი ახალი
			file: file ბილიკი,
			mime: ['image/'] + (Server mimetype: file ბილიკი),
			data: blob base64-კოდირება
	).
	blob გათავისუფლება. <- ['cid:attachment'] + id.
}.

HTML-Email როცა: ['generate'] გააკეთე: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ბოლოში-დამატება: (თავად header: ['From: '] + საკუთარი from-name + [' <'] + ( საკუთარი from ) + ['>']) + brk.
	str ბოლოში-დამატება: (თავად header: ['To: '] + ( საკუთარი recipients გაერთიანება: [','] )) + brk.
	საკუთარი cc რაოდენობა ჭეშმარიტი: {
		str ბოლოში-დამატება: (თავად header: ['Cc: '] + ( საკუთარი cc გაერთიანება: [','] )) + brk.
	}.
	საკუთარი bcc რაოდენობა ჭეშმარიტი: {
		str ბოლოში-დამატება: (თავად header: ['Bcc: '] + ( საკუთარი bcc გაერთიანება: [','] )) + brk.
	}.
	str ბოლოში-დამატება: (თავად header: ['Subject: '] + საკუთარი subject) + brk.
	str ბოლოში-დამატება: ['MIME-Version: 1.0'] + brk.
	str ბოლოში-დამატება: ['Content-Type: multipart/related; boundary="'] + საკუთარი boundary + ['"; type=text/html'] + brk.
	str ბოლოში-დამატება: brk.
	str ბოლოში-დამატება: ['--'] + საკუთარი boundary + brk.
	str ბოლოში-დამატება: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str ბოლოში-დამატება: ['Content-Transfer-Encoding: 7bit'] + brk.
	str ბოლოში-დამატება: brk.
	str ბოლოში-დამატება: საკუთარი body.
	str ბოლოში-დამატება: brk.
	საკუთარი attachments თითოეული: { :id :info
		>> blob := info data.
		str ბოლოში-დამატება: ['--'] + საკუთარი boundary + brk.
		str ბოლოში-დამატება: ['Content-Type: '] + info mime + brk.
		str ბოლოში-დამატება: ['Content-Transfer-Encoding: base64'] + brk.
		str ბოლოში-დამატება: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str ბოლოში-დამატება: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str ბოლოში-დამატება: brk.
		>> max := 76.
		>> len := blob სიგრძე.
		>> chunks := (len / max) დამრგვალება-ზემოთ.
		{ :i
			>> chunk := blob კოპირება საიდან: i * max სიგრძე: max.
			str ბოლოში-დამატება: chunk + brk.
		} * chunks.
		str ბოლოში-დამატება: brk.
		str ბოლოში-დამატება: brk.
	}.
	str ბოლოში-დამატება: ['--'] + საკუთარი boundary + ['--'] + brk. <- str.
}.
