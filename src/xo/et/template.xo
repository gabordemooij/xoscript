
# ~ Simple template engine ~

>> Mall := Objekt uus.

Mall kui: ['uus'] tee: { <- ise uus sisu: [''].
}.

Mall kui: ['sisu:'] tee: { :sisu
	oma sisu := sisu. 
}.

Mall kui: ['uus:'] tee: { :sisu <- ise uus sisu: sisu.
}.

Mall kui: ['lõika:'] tee: { :märk
	>> algusmärk := (['<!-- cut:%id% -->'] %id%: märk).
	>> lõpumärk := (['<!-- /cut:%id% -->'] %id%: märk).
	>> osad := oma sisu tükelda: algusmärk.
	>> eesliide := osad esimene.
	>> osad2 := osad viimane tükelda: lõpumärk.
	>> järelliide := osad2 viimane.
	>> osa := osad2 esimene.
	>> ülejääk := eesliide + järelliide.
	oma sisu := ülejääk. <- Mall uus: osa.
	
}.

Mall kui: ['kopeeri'] tee: { <- ise uus: ise tekst kopeeri.
}.
	
Mall kui: ['kleebi:kohale:'] tee: { :katkend :id
	>> kleepimismärk := (['<!-- paste:%id% -->'] %id%: id).
	oma sisu asenda: kleepimismärk väärtusega: ( katkend tekst + kleepimismärk ).
}.

Mall kui: ['sea:väärtus:'] tee: { :pesa :väärtus
	oma sisu asenda: ['<!-- slot:'] + pesa + [' -->'] väärtusega: ( Server html-kodeeri: väärtus ).
}.

Mall kui: ['sea:html:'] tee: { :pesa :html
	oma sisu asenda: ['<!-- slot:'] + pesa + [' -->'] väärtusega: html.
}.

Mall kui: ['vasta:ja:'] tee: { :pesa :väärtus
	ise sea: (pesa alates: 0 pikkus: (pesa pikkus - 1)) väärtus: väärtus.
}.

Mall kui: ['nl2br'] tee: {
	oma sisu asenda: ['\n'] väärtusega: ['<br>'].
}.

Mall kui: ['korrasta'] tee: {
	oma sisu :=
		Muster
		uus: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		vaste: oma sisu
		tee: { <- ['']. }.
}.

Mall kui: ['korrasta-lõiked'] tee: {
	>> elemendid := Loend uus.
	Muster
	uus: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	vaste: oma sisu
	tee: { :_ :osa
		elemendid lisa-lõppu: osa ? 1.
	}.
	elemendid iga: { :_ :id
		oma sisu :=
			Muster uus: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			vaste: oma sisu
			tee: { <- ['']. }.
	 }.
}.

Mall kui: ['korrasta-tühikud'] tee: {
	oma sisu :=
		Muster
		uus: ['\\s*\\n'],
		vaste: oma sisu
		tee: { <- ['\n']. }.
	oma sisu :=
		Muster
		uus: ['\\n[\\s\\t]+'],
		vaste: oma sisu
		tee: { <- ['\n']. }.
}.

Mall kui: ['korrasta-kõik'] tee: {
	ise korrasta.
	ise korrasta-lõiked.
	ise korrasta-tühikud.
}.

Mall kui: ['tekst'] tee: { <- oma sisu.
}.
