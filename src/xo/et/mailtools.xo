>> E-kiri := Objekt uus.

E-kiri kui: ['lähtesta'] tee: {
	oma saajad := Loend uus.
	oma cc := Loend uus.
	oma bcc := Loend uus.
	oma saatja := Tühi.
	oma saatja-nimi := Tühi.
	oma teema := Tühi.
	oma kirja-sisu := Tühi.
}.

E-kiri kui: ['uus'] tee: { <- ise uus lähtesta.
}.

E-kiri kui: ['kellele:'] tee: { :loetelu
	oma saajad := loetelu.
}.
 
E-kiri kui: ['cc:'] tee: { :loetelu
	oma cc := loetelu.
}.

E-kiri kui: ['bcc:'] tee: { :loetelu
	oma bcc := loetelu.
}.

E-kiri kui: ['teema:'] tee: { :teema
	oma teema := teema.
}.

E-kiri kui: ['saatja:nimi:'] tee: { :saatja :nimi
	oma saatja := saatja.
	oma saatja-nimi := nimi.
}.

E-kiri kui: ['kirja-sisu:'] tee: { :kirja-sisu
	oma kirja-sisu := kirja-sisu.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-kiri kui: ['päis:'] tee: { :rida <- rida asenda: ['\r'] väärtusega: [''], asenda: ['\n'] väärtusega: [''].
}.

E-kiri kui: ['saada'] tee: {
	>> f := Fail tempwrite: ise genereeri.
	Programm süsteem: ['sendmail -t < '] + f rada, reavahetus.
}.

E-kiri kui: ['genereeri'] tee: {
	>> crlf := ['\r\n'].
	>> sõne := [''].
	sõne lisa-lõppu: (ise päis: ['From: '] + oma saatja-nimi + [' <'] + ( oma saatja ) + ['>']) + crlf.
	sõne lisa-lõppu: (ise päis: ['To: '] + ( oma saajad ühenda: [','] )) + crlf.
	oma cc arvuta tõsi: {
		sõne lisa-lõppu: (ise päis: ['Cc: '] + ( oma cc ühenda: [','] )) + crlf.
	}.
	oma bcc arvuta tõsi: {
		sõne lisa-lõppu: (ise päis: ['Bcc: '] + ( oma bcc ühenda: [','] )) + crlf.
	}.
	sõne lisa-lõppu: (ise päis: ['Subject: '] + oma teema) + crlf.
	sõne lisa-lõppu: crlf.
	sõne lisa-lõppu: oma kirja-sisu.
	sõne lisa-lõppu: crlf. <- sõne.
}.

>> HTML-E-kiri := E-kiri uus.

HTML-E-kiri kui: ['lähtesta'] tee: {
	ise lähtesta.
	oma manused := Loend uus.
	oma piir := Seif tunnus: 40.
}.

HTML-E-kiri kui: ['manusta:'] tee: { :fail
	>> id := oma manused arvuta.
	>> blob := fail blob.
	oma manused lisa-lõppu: (
		Sõnastik uus
			fail: fail rada,
			mime: ['image/'] + (Server mimetype: fail rada),
			andmed: blob base64-kodeeri
	).
	blob vabasta. <- ['cid:attachment'] + id.
}.

HTML-E-kiri kui: ['genereeri'] tee: {
	>> crlf := ['\r\n'].
	>> sõne := [''].
	sõne lisa-lõppu: (ise päis: ['From: '] + oma saatja-nimi + [' <'] + ( oma saatja ) + ['>']) + crlf.
	sõne lisa-lõppu: (ise päis: ['To: '] + ( oma saajad ühenda: [','] )) + crlf.
	oma cc arvuta tõsi: {
		sõne lisa-lõppu: (ise päis: ['Cc: '] + ( oma cc ühenda: [','] )) + crlf.
	}.
	oma bcc arvuta tõsi: {
		sõne lisa-lõppu: (ise päis: ['Bcc: '] + ( oma bcc ühenda: [','] )) + crlf.
	}.
	sõne lisa-lõppu: (ise päis: ['Subject: '] + oma teema) + crlf.
	sõne lisa-lõppu: ['MIME-Version: 1.0'] + crlf.
	sõne lisa-lõppu: ['Content-Type: multipart/related; boundary="'] + oma piir + ['"; type=text/html'] + crlf.
	sõne lisa-lõppu: crlf.
	sõne lisa-lõppu: ['--'] + oma piir + crlf.
	sõne lisa-lõppu: ['Content-Type: text/html; charset=UTF-8'] + crlf.
	sõne lisa-lõppu: ['Content-Transfer-Encoding: 7bit'] + crlf.
	sõne lisa-lõppu: crlf.
	sõne lisa-lõppu: oma kirja-sisu.
	sõne lisa-lõppu: crlf.
	oma manused iga: { :id :info
		>> blob := info andmed.
		sõne lisa-lõppu: ['--'] + oma piir + crlf.
		sõne lisa-lõppu: ['Content-Type: '] + info mime + crlf.
		sõne lisa-lõppu: ['Content-Transfer-Encoding: base64'] + crlf.
		sõne lisa-lõppu: ['Content-ID: <attachment'] + id + ['>'] + crlf.
		sõne lisa-lõppu: ['Content-Disposition: inline; filename="'] + info fail + ['"'] + crlf.
		sõne lisa-lõppu: crlf.
		>> suurim := 76.
		>> teksti-pikkus := blob pikkus.
		>> tükid := (teksti-pikkus / suurim) ümarda-üles.
		{ :i
			>> tükk := blob kopeeri alates: i * suurim pikkus: suurim.
			sõne lisa-lõppu: tükk + crlf.
		} * tükid.
		sõne lisa-lõppu: crlf.
		sõne lisa-lõppu: crlf.
	}.
	sõne lisa-lõppu: ['--'] + oma piir + ['--'] + crlf. <- sõne.
}.
