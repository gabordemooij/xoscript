HTTP-Päring kui: ['HTTP-päis:'] tee: { :võti <- Programm seade: võti.
}.

>> HTTP-Päis := Objekt uus.

HTTP-Päis kui: ['uus'] tee: { <- ise uus lähtesta.
}.

HTTP-Päis kui: ['lähtesta'] tee: {
	oma võti := Tühi.
	oma väärtus := Tühi.
}.

HTTP-Päis kui: ['võti:väärtus:'] tee: { :võti :väärtus
	oma võti := võti.
	oma väärtus := väärtus.
}.

HTTP-Päis kui: ['võti'] tee: { <- oma võti.
}.

HTTP-Päis kui: ['väärtus'] tee: { <- oma väärtus.
}.


HTTP-Päis kui: ['tekst'] tee: {
	>> rida := oma võti + [': '] + oma väärtus.
	rida asenda: ['\r'] väärtusega: [''], asenda: ['\n'] väärtusega: ['']. <- rida + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Veebidokument := Objekt uus.

Veebidokument kui: ['uus'] tee: { <- ise uus lähtesta.
}.

Veebidokument kui: ['lähtesta'] tee: {
	oma päised := Loend uus.
	oma seansi-id := Tühi.
	oma seansihaldur := Ajutise-faili-seanss uus.
	oma seansiandmed := Tühi.
	oma turvaline := Tõsi.
	oma sama-sait := ['Strict'].
	oma päised-saadetud := Vale.
	oma http-päring := HTTP-Päring uus.
}.

Veebidokument kui: ['http-päring:'] tee: { :http-päring
	oma http-päring := http-päring.
}. 

Veebidokument kui: ['turvaline-seansiküpsis:'] tee: { :turvaline
	ise kontrolli-päiseid.
	oma turvaline := turvaline.
}.

Veebidokument kui: ['sama-saidi-seansiküpsis:'] tee: { :väärtus
	ise kontrolli-päiseid.
	>> valikud := Loend uus 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	valikud sisaldab: väärtus, vale: {
		see-ülesanne viga: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	oma sama-sait := väärtus.
}.

Veebidokument kui: ['päis:'] tee: { :päis
	ise kontrolli-päiseid.
	oma päised lisa-lõppu: päis.
}.

Veebidokument kui: ['tühjenda-päised'] tee: {
	ise kontrolli-päiseid.
	oma päised := Loend uus.
}.

Veebidokument kui: ['seansihaldur:'] tee: { :haldur
	ise kontrolli-päiseid.
	oma seansihaldur := haldur.
}.

Veebidokument kui: ['seansihaldur'] tee: { <- oma seansihaldur.
}.

Veebidokument kui: ['kontrolli-päiseid'] tee: {
	oma päised-saadetud tõsi: {
		see-ülesanne viga: ['Headers already sent to client.'].
	}.
}.

Veebidokument kui: ['alusta-seanssi'] tee: {
	ise kontrolli-päiseid.
	>> http-päring := oma http-päring.
	>> seansi-id := http-päring cookie: ['xsid'].
	seansi-id Tühi? vale: {
		(( Muster uus: ['^[A-Za-z0-9]+\\z'], vaste: seansi-id ) = 0) tõsi: {
			seansi-id := Tühi.
		}.
	}.
	seansi-id Tühi? tõsi: {
		seansi-id := Seif tunnus: 30.
		>> seansipäis := HTTP-Päis uus
		võti: ['Set-Cookie'] väärtus: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (oma turvaline kas: ['Secure'] või: ['']),
		SSITE: (oma sama-sait),
		XSID: seansi-id
		).
		oma päised lisa-lõppu: seansipäis.
	}.
	oma seansiandmed := oma seansihaldur jaoks: seansi-id, laadi. <- oma seansiandmed. # reference
}.

Veebidokument kui: ['mine:'] tee: { :aadress
	ise kontrolli-päiseid.
	ise tühjenda-päised.
	oma päised
	lisa-lõppu: (
		HTTP-Päis uus
		võti: ['Status'] väärtus: ['303 See Other']
	),
	lisa-lõppu: (
		HTTP-Päis uus
		võti: ['Location'] väärtus: aadress
	).
	ise väljasta: ['Redirect'].
}.

Veebidokument kui: ['hävita-seanss'] tee: {
	ise kontrolli-päiseid.
	>> http-päring := oma http-päring.
	>> seansi-id := http-päring cookie: ['xsid'].
	seansi-id Tühi? vale: {
		>> seansipäis := HTTP-Päis uus.
		>> hetk := Hetk uus aasta: 1970, vorming: ['%a, %d %b %Y %H:%M:%S GMT'].
		seansipäis võti: ['Set-Cookie'] väärtus: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: hetk,
			SEC: (oma turvaline kas: ['Secure'] või: ['']),
			SSITE: (oma sama-sait),
			XSID: seansi-id
		).
		oma seansihaldur hävita.
		oma päised lisa-lõppu: seansipäis.
	}.
}.


Veebidokument kui: ['mall:'] tee: { :rada <- Mall uus: (Fail uus: rada, loe).
}.

Veebidokument kui: ['väljasta:tüüp:'] tee: { :väljund :tüüp
	oma päised-saadetud vale: {
		oma seansiandmed Tühi? vale: {
			oma seansihaldur salvesta: oma seansiandmed.
		}.
		oma päised lisa-lõppu: (
			HTTP-Päis uus
			võti: ['Content-type'] väärtus: tüüp
		).
		oma päised iga: { :_ :päis
			Väljund kirjuta: päis.
		}.
		oma päised-saadetud := Tõsi.
		Väljund kirjuta: ['\r\n'].
	}.
	Väljund kirjuta: väljund.
}.

Veebidokument kui: ['lõpeta:tüüp:'] tee: { :väljund :tüüp
	oma päised-saadetud vale: {
		oma seansiandmed Tühi? vale: {
			oma seansihaldur salvesta: oma seansiandmed.
		}.
		oma päised lisa-lõppu: (
			HTTP-Päis uus
			võti: ['Content-type'] väärtus: tüüp
		).
		oma päised lisa-lõppu: (
			HTTP-Päis uus
			võti: ['Content-Length'] väärtus: väljund tekst bytes
		).
		oma päised iga: { :_ :päis
			Väljund kirjuta: päis.
		}.
		oma päised-saadetud := Tõsi.
		Väljund kirjuta: ['\r\n'].
	}.
	Väljund kirjuta: väljund.
}.

Veebidokument kui: ['väljasta:'] tee: { :väljund
	ise väljasta: väljund tüüp: ['text/html; charset=utf-8'].
}.

Veebidokument kui: ['lõpeta:'] tee: { :väljund
	ise lõpeta: väljund tüüp: ['text/html; charset=utf-8'].
}.

Veebidokument kui: ['json:'] tee: { :väljund
	ise väljasta: ( JSON jsonify: väljund ) tüüp: ['application/json'].
}.

Veebidokument kui: ['ei-leitud:'] tee: { :väljund
	ise tühjenda-päised päis: (
		HTTP-Päis uus võti: ['Status'] väärtus: ['404 Not Found']
	).
	ise väljasta: väljund.
}.


# Interface

>> Seanss := Objekt uus.

Seanss kui: ['uus'] tee: { <- ise uus lähtesta jaoks: Tühi.
}.

Seanss kui: ['jaoks:'] tee: { :id
	oma id := id.
}.

Seanss kui: ['laadi'] tee: {
	see-ülesanne viga: ['Not implemented.'].
}.

Seanss kui: ['salvesta:'] tee: {
	see-ülesanne viga: ['Not implemented.'].
}.

Seanss kui: ['hävita'] tee: {
	see-ülesanne viga: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Ajutise-faili-seanss := Seanss uus.

Ajutise-faili-seanss kui: ['lähtesta'] tee: {
	oma tee-algus := ['/tmp/sess-'].
}.

Ajutise-faili-seanss kui: ['tee-eesliide:'] tee: { :sõne
	oma tee-algus := sõne.
}.

Ajutise-faili-seanss kui: ['fail'] tee: { <- ( Fail uus: ( oma tee-algus + oma id + ['.txt'] ) ).
}.

Ajutise-faili-seanss kui: ['laadi'] tee: {
	>> fail := ise fail.
	fail olemas vale: {
		fail kirjuta: (Sõnastik uus kood).
	}. <- fail loe objekt.
}.

Ajutise-faili-seanss kui: ['salvesta:'] tee: { :andmed
	>> fail := ise fail.
	fail olemas tõsi: {
		fail kirjuta: andmed kood.
	}.
}.

Ajutise-faili-seanss kui: ['hävita'] tee: {
	>> fail := ise fail.
	fail olemas tõsi: {
		fail kustuta.
	}.
}.


>> URL := Objekt uus.

URL kui: ['lähtesta'] tee: {
	oma protokoll := ['https://'].
	oma host := ['localhost'].
	oma rada := [''].
	oma url-parameetrid := [''].
	oma hash := [''].
}.

URL kui: ['uus'] tee: { <- ise uus lähtesta.
}.

URL kui: ['tekst'] tee: { <- (
	oma protokoll +
	oma host +
	oma rada +
	oma url-parameetrid +
	oma hash ).
}.

URL kui: ['protokoll:'] tee: { :protokoll
	((Loend uus ; ['http'] ; ['https']) sisaldab: protokoll) tõsi: {
		oma protokoll := protokoll + ['://'].
	}, vale: {
		see-ülesanne viga: ['Invalid protocol'].
	}.
}.

URL kui: ['host:'] tee: { :host
	#todo validate according to rfc
	oma host := host.
}.

URL kui: ['rada:'] tee: { :rada
	oma rada := ['/'] + rada url-kodeeri.
}.

URL kui: ['url-parameetrid:'] tee: { :vastendus
	>> url-parameetrid := Loend uus.
	vastendus iga: { :võti :väärtus
		url-parameetrid lisa-lõppu: võti tekst url-kodeeri + ['='] + väärtus tekst url-kodeeri.
	}.
	oma url-parameetrid := ['?'] + ( url-parameetrid ühenda: ['&'] ).
}.

URL kui: ['räsi:'] tee: { :hash
	oma hash := ['#'] + hash url-kodeeri.
}.

