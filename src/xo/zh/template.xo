
# ~ Simple template engine ~

>> 模板 := 对象 新建.

模板 在: ['新建'] 执行: { <- 自身 新建 内容: [''].
}.

模板 在: ['内容:'] 执行: { :内容
	拥有 内容 := 内容. 
}.

模板 在: ['新建:'] 执行: { :内容 <- 自身 新建 内容: 内容.
}.

模板 在: ['剪切:'] 执行: { :标记
	>> 开始标记 := (['<!-- cut:%id% -->'] %id%: 标记).
	>> 结束标记 := (['<!-- /cut:%id% -->'] %id%: 标记).
	>> 部分列表 := 拥有 内容 拆分: 开始标记.
	>> 前缀 := 部分列表 第一个.
	>> 部分列表2 := 部分列表 最后 拆分: 结束标记.
	>> 后缀 := 部分列表2 最后.
	>> 部分 := 部分列表2 第一个.
	>> 剩余 := 前缀 + 后缀.
	拥有 内容 := 剩余. <- 模板 新建: 部分.
	
}.

模板 在: ['复制'] 执行: { <- 自身 新建: 自身 转文本 复制.
}.
	
模板 在: ['粘贴:在:'] 执行: { :片段文本 :id
	>> 粘贴标记 := (['<!-- paste:%id% -->'] %id%: id).
	拥有 内容 替换: 粘贴标记 为: ( 片段文本 转文本 + 粘贴标记 ).
}.

模板 在: ['设:值:'] 执行: { :插槽 :取值
	拥有 内容 替换: ['<!-- slot:'] + 插槽 + [' -->'] 为: ( Server 互联网文档编码: 取值 ).
}.

模板 在: ['设:互联网文档:'] 执行: { :插槽 :互联网文档
	拥有 内容 替换: ['<!-- slot:'] + 插槽 + [' -->'] 为: 互联网文档.
}.

模板 在: ['响应:参数:'] 执行: { :插槽 :取值
	自身 设: (插槽 从: 0 长度: (插槽 长度 - 1)) 值: 取值.
}.

模板 在: ['nl2br'] 执行: {
	拥有 内容 替换: ['\n'] 为: ['<br>'].
}.

模板 在: ['清理标记'] 执行: {
	拥有 内容 :=
		模式
		新建: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		匹配: 拥有 内容
		执行: { <- ['']. }.
}.

模板 在: ['清理剪切'] 执行: {
	>> 条目 := 数组对象 新建.
	模式
	新建: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	匹配: 拥有 内容
	执行: { :_ :部分
		条目 追加: 部分 ? 1.
	}.
	条目 每个: { :_ :id
		拥有 内容 :=
			模式 新建: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			匹配: 拥有 内容
			执行: { <- ['']. }.
	 }.
}.

模板 在: ['清理空白'] 执行: {
	拥有 内容 :=
		模式
		新建: ['\\s*\\n'],
		匹配: 拥有 内容
		执行: { <- ['\n']. }.
	拥有 内容 :=
		模式
		新建: ['\\n[\\s\\t]+'],
		匹配: 拥有 内容
		执行: { <- ['\n']. }.
}.

模板 在: ['全部清理'] 执行: {
	自身 清理标记.
	自身 清理剪切.
	自身 清理空白.
}.

模板 在: ['转文本'] 执行: { <- 拥有 内容.
}.
