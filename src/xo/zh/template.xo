
# ~ Simple template engine ~

>> Template := 对象 新建.

Template 在: ['新建'] 执行: { <- 自身 新建 content: [''].
}.

Template 在: ['content:'] 执行: { :content
	拥有 content := content. 
}.

Template 在: ['新建:'] 执行: { :content <- 自身 新建 content: content.
}.

Template 在: ['cut:'] 执行: { :marker
	>> startmarker := (['<!-- cut:%id% -->'] %id%: marker).
	>> endmarker := (['<!-- /cut:%id% -->'] %id%: marker).
	>> parts := 拥有 content 拆分: startmarker.
	>> prefix := parts 第一个.
	>> parts2 := parts 最后 拆分: endmarker.
	>> suffix := parts2 最后.
	>> part := parts2 第一个.
	>> rest := prefix + suffix.
	拥有 content := rest. <- Template 新建: part.
	
}.

Template 在: ['复制'] 执行: { <- 自身 新建: 自身 转文本 复制.
}.
	
Template 在: ['paste:at:'] 执行: { :snippet :id
	>> pastemarker := (['<!-- paste:%id% -->'] %id%: id).
	拥有 content 替换: pastemarker 为: ( snippet 转文本 + pastemarker ).
}.

Template 在: ['设:值:'] 执行: { :slot :value
	拥有 content 替换: ['<!-- slot:'] + slot + [' -->'] 为: ( Server 互联网文档编码: value ).
}.

Template 在: ['set:html:'] 执行: { :slot :互联网文档
	拥有 content 替换: ['<!-- slot:'] + slot + [' -->'] 为: 互联网文档.
}.

Template 在: ['响应:参数:'] 执行: { :slot :value
	自身 设: (slot 从: 0 长度: (slot 长度 - 1)) 值: value.
}.

Template 在: ['nl2br'] 执行: {
	拥有 content 替换: ['\n'] 为: ['<br>'].
}.

Template 在: ['clean'] 执行: {
	拥有 content :=
		模式
		新建: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		匹配: 拥有 content
		执行: { <- ['']. }.
}.

Template 在: ['clean-cuts'] 执行: {
	>> items := 数组对象 新建.
	模式
	新建: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	匹配: 拥有 content
	执行: { :_ :part
		items 追加: part ? 1.
	}.
	items 每个: { :_ :id
		拥有 content :=
			模式 新建: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			匹配: 拥有 content
			执行: { <- ['']. }.
	 }.
}.

Template 在: ['clean-space'] 执行: {
	拥有 content :=
		模式
		新建: ['\\s*\\n'],
		匹配: 拥有 content
		执行: { <- ['\n']. }.
	拥有 content :=
		模式
		新建: ['\\n[\\s\\t]+'],
		匹配: 拥有 content
		执行: { <- ['\n']. }.
}.

Template 在: ['clean-all'] 执行: {
	自身 clean.
	自身 clean-cuts.
	自身 clean-space.
}.

Template 在: ['转文本'] 执行: { <- 拥有 content.
}.
