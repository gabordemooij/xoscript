互联网请求 在: ['HTTP-头部:'] 执行: { :键名 <- 程序 环境变量: 键名.
}.

>> HTTP头 := 对象 新建.

HTTP头 在: ['新建'] 执行: { <- 自身 新建 初始化.
}.

HTTP头 在: ['初始化'] 执行: {
	拥有 键名 := 空.
	拥有 取值 := 空.
}.

HTTP头 在: ['键名:取值:'] 执行: { :键名 :取值
	拥有 键名 := 键名.
	拥有 取值 := 取值.
}.

HTTP头 在: ['键名'] 执行: { <- 拥有 键名.
}.

HTTP头 在: ['取值'] 执行: { <- 拥有 取值.
}.


HTTP头 在: ['转文本'] 执行: {
	>> 行文本 := 拥有 键名 + [': '] + 拥有 取值.
	行文本 替换: ['\r'] 为: [''], 替换: ['\n'] 为: ['']. <- 行文本 + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> 网页文档 := 对象 新建.

网页文档 在: ['新建'] 执行: { <- 自身 新建 初始化.
}.

网页文档 在: ['初始化'] 执行: {
	拥有 头部列表 := 数组对象 新建.
	拥有 会话标识 := 空.
	拥有 会话管理器 := 临时文件会话 新建.
	拥有 会话数据 := 空.
	拥有 安全的 := 是.
	拥有 同站 := ['Strict'].
	拥有 头部已发送 := 否.
	拥有 http请求 := 互联网请求 新建.
}.

网页文档 在: ['http请求:'] 执行: { :http请求
	拥有 http请求 := http请求.
}. 

网页文档 在: ['安全会话cookie:'] 执行: { :安全的
	自身 检查头部.
	拥有 安全的 := 安全的.
}.

网页文档 在: ['同站会话cookie:'] 执行: { :取值
	自身 检查头部.
	>> 选项 := 数组对象 新建 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	选项 _包含: 取值, 否: {
		当前任务 错误: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	拥有 同站 := 取值.
}.

网页文档 在: ['头部:'] 执行: { :头部
	自身 检查头部.
	拥有 头部列表 追加: 头部.
}.

网页文档 在: ['清空头部'] 执行: {
	自身 检查头部.
	拥有 头部列表 := 数组对象 新建.
}.

网页文档 在: ['会话管理器:'] 执行: { :管理器
	自身 检查头部.
	拥有 会话管理器 := 管理器.
}.

网页文档 在: ['会话管理器'] 执行: { <- 拥有 会话管理器.
}.

网页文档 在: ['检查头部'] 执行: {
	拥有 头部已发送 是: {
		当前任务 错误: ['Headers already sent to client.'].
	}.
}.

网页文档 在: ['开始会话'] 执行: {
	自身 检查头部.
	>> http请求 := 拥有 http请求.
	>> 会话标识 := http请求 曲奇饼: ['xsid'].
	会话标识 为空? 否: {
		(( 模式 新建: ['^[A-Za-z0-9]+\\z'], 匹配: 会话标识 ) = 0) 是: {
			会话标识 := 空.
		}.
	}.
	会话标识 为空? 是: {
		会话标识 := 保险库 令牌: 30.
		>> 会话头部 := HTTP头 新建
		键名: ['Set-Cookie'] 取值: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (拥有 安全的 或: ['Secure'] 或: ['']),
		SSITE: (拥有 同站),
		XSID: 会话标识
		).
		拥有 头部列表 追加: 会话头部.
	}.
	拥有 会话数据 := 拥有 会话管理器 针对: 会话标识, 加载. <- 拥有 会话数据. # reference
}.

网页文档 在: ['跳转:'] 执行: { :网址
	自身 检查头部.
	自身 清空头部.
	拥有 头部列表
	追加: (
		HTTP头 新建
		键名: ['Status'] 取值: ['303 See Other']
	),
	追加: (
		HTTP头 新建
		键名: ['Location'] 取值: 网址
	).
	自身 输出: ['Redirect'].
}.

网页文档 在: ['销毁会话'] 执行: {
	自身 检查头部.
	>> http请求 := 拥有 http请求.
	>> 会话标识 := http请求 曲奇饼: ['xsid'].
	会话标识 为空? 否: {
		>> 会话头部 := HTTP头 新建.
		>> 时刻 := 时间对象 新建 年: 1970, 格式: ['%a, %d %b %Y %H:%M:%S GMT'].
		会话头部 键名: ['Set-Cookie'] 取值: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: 时刻,
			SEC: (拥有 安全的 或: ['Secure'] 或: ['']),
			SSITE: (拥有 同站),
			XSID: 会话标识
		).
		拥有 会话管理器 销毁.
		拥有 头部列表 追加: 会话头部.
	}.
}.


网页文档 在: ['模板:'] 执行: { :路径 <- 模板 新建: (文件 新建: 路径, 读取).
}.

网页文档 在: ['输出:类型:'] 执行: { :输出结果 :类型
	拥有 头部已发送 否: {
		拥有 会话数据 为空? 否: {
			拥有 会话管理器 保存: 拥有 会话数据.
		}.
		拥有 头部列表 追加: (
			HTTP头 新建
			键名: ['Content-type'] 取值: 类型
		).
		拥有 头部列表 每个: { :_ :头部
			输出 写入: 头部.
		}.
		拥有 头部已发送 := 是.
		输出 写入: ['\r\n'].
	}.
	输出 写入: 输出结果.
}.

网页文档 在: ['完成:类型:'] 执行: { :输出结果 :类型
	拥有 头部已发送 否: {
		拥有 会话数据 为空? 否: {
			拥有 会话管理器 保存: 拥有 会话数据.
		}.
		拥有 头部列表 追加: (
			HTTP头 新建
			键名: ['Content-type'] 取值: 类型
		).
		拥有 头部列表 追加: (
			HTTP头 新建
			键名: ['Content-Length'] 取值: 输出结果 转文本 字节范围
		).
		拥有 头部列表 每个: { :_ :头部
			输出 写入: 头部.
		}.
		拥有 头部已发送 := 是.
		输出 写入: ['\r\n'].
	}.
	输出 写入: 输出结果.
}.

网页文档 在: ['输出:'] 执行: { :输出结果
	自身 输出: 输出结果 类型: ['text/html; charset=utf-8'].
}.

网页文档 在: ['完成:'] 执行: { :输出结果
	自身 完成: 输出结果 类型: ['text/html; charset=utf-8'].
}.

网页文档 在: ['json:'] 执行: { :输出结果
	自身 输出: ( 杰森 杰森风格: 输出结果 ) 类型: ['application/json'].
}.

网页文档 在: ['未找到:'] 执行: { :输出结果
	自身 清空头部 头部: (
		HTTP头 新建 键名: ['Status'] 取值: ['404 Not Found']
	).
	自身 输出: 输出结果.
}.


# Interface

>> 会话 := 对象 新建.

会话 在: ['新建'] 执行: { <- 自身 新建 初始化 针对: 空.
}.

会话 在: ['针对:'] 执行: { :id
	拥有 id := id.
}.

会话 在: ['加载'] 执行: {
	当前任务 错误: ['Not implemented.'].
}.

会话 在: ['保存:'] 执行: {
	当前任务 错误: ['Not implemented.'].
}.

会话 在: ['销毁'] 执行: {
	当前任务 错误: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> 临时文件会话 := 会话 新建.

临时文件会话 在: ['初始化'] 执行: {
	拥有 路径开头 := ['/tmp/sess-'].
}.

临时文件会话 在: ['路径前缀:'] 执行: { :字符串文本
	拥有 路径开头 := 字符串文本.
}.

临时文件会话 在: ['会话文件'] 执行: { <- ( 文件 新建: ( 拥有 路径开头 + 拥有 id + ['.txt'] ) ).
}.

临时文件会话 在: ['加载'] 执行: {
	>> 会话文件 := 自身 会话文件.
	会话文件 存在 否: {
		会话文件 写入: (映射对象 新建 代码).
	}. <- 会话文件 读取 转对象.
}.

临时文件会话 在: ['保存:'] 执行: { :数据
	>> 会话文件 := 自身 会话文件.
	会话文件 存在 是: {
		会话文件 写入: 数据 代码.
	}.
}.

临时文件会话 在: ['销毁'] 执行: {
	>> 会话文件 := 自身 会话文件.
	会话文件 存在 是: {
		会话文件 删除.
	}.
}.


>> URL := 对象 新建.

URL 在: ['初始化'] 执行: {
	拥有 协议名 := ['https://'].
	拥有 主机 := ['localhost'].
	拥有 路径 := [''].
	拥有 url参数 := [''].
	拥有 hash := [''].
}.

URL 在: ['新建'] 执行: { <- 自身 新建 初始化.
}.

URL 在: ['转文本'] 执行: { <- (
	拥有 协议名 +
	拥有 主机 +
	拥有 路径 +
	拥有 url参数 +
	拥有 hash ).
}.

URL 在: ['协议名:'] 执行: { :协议名
	((数组对象 新建 ; ['http'] ; ['https']) _包含: 协议名) 是: {
		拥有 协议名 := 协议名 + ['://'].
	}, 否: {
		当前任务 错误: ['Invalid protocol'].
	}.
}.

URL 在: ['主机:'] 执行: { :主机
	#todo validate according to rfc
	拥有 主机 := 主机.
}.

URL 在: ['路径:'] 执行: { :路径
	拥有 路径 := ['/'] + 路径 互联网地址编码.
}.

URL 在: ['url参数:'] 执行: { :映射表
	>> url参数 := 数组对象 新建.
	映射表 每个: { :键名 :取值
		url参数 追加: 键名 转文本 互联网地址编码 + ['='] + 取值 转文本 互联网地址编码.
	}.
	拥有 url参数 := ['?'] + ( url参数 连接: ['&'] ).
}.

URL 在: ['哈希:'] 执行: { :hash
	拥有 hash := ['#'] + hash 互联网地址编码.
}.

