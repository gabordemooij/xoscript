>> 电子邮件 := 对象 新建.

电子邮件 在: ['初始化'] 执行: {
	拥有 收件人列表 := 数组对象 新建.
	拥有 cc := 数组对象 新建.
	拥有 bcc := 数组对象 新建.
	拥有 发件人 := 空.
	拥有 发件人名称 := 空.
	拥有 主题 := 空.
	拥有 正文 := 空.
}.

电子邮件 在: ['新建'] 执行: { <- 自身 新建 初始化.
}.

电子邮件 在: ['收件人:'] 执行: { :枚举
	拥有 收件人列表 := 枚举.
}.
 
电子邮件 在: ['cc:'] 执行: { :枚举
	拥有 cc := 枚举.
}.

电子邮件 在: ['bcc:'] 执行: { :枚举
	拥有 bcc := 枚举.
}.

电子邮件 在: ['主题:'] 执行: { :主题
	拥有 主题 := 主题.
}.

电子邮件 在: ['发件人:名称:'] 执行: { :发件人 :名称
	拥有 发件人 := 发件人.
	拥有 发件人名称 := 名称.
}.

电子邮件 在: ['正文:'] 执行: { :正文
	拥有 正文 := 正文.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
电子邮件 在: ['头部:'] 执行: { :行文本 <- 行文本 替换: ['\r'] 为: [''], 替换: ['\n'] 为: [''].
}.

电子邮件 在: ['发送'] 执行: {
	>> f := 文件 临时写: 自身 生成.
	程序 系统命令: ['sendmail -t < '] + f 路径, 停止.
}.

电子邮件 在: ['生成'] 执行: {
	>> 换行符 := ['\r\n'].
	>> 字符串文本 := [''].
	字符串文本 追加: (自身 头部: ['From: '] + 拥有 发件人名称 + [' <'] + ( 拥有 发件人 ) + ['>']) + 换行符.
	字符串文本 追加: (自身 头部: ['To: '] + ( 拥有 收件人列表 连接: [','] )) + 换行符.
	拥有 cc 计数 是: {
		字符串文本 追加: (自身 头部: ['Cc: '] + ( 拥有 cc 连接: [','] )) + 换行符.
	}.
	拥有 bcc 计数 是: {
		字符串文本 追加: (自身 头部: ['Bcc: '] + ( 拥有 bcc 连接: [','] )) + 换行符.
	}.
	字符串文本 追加: (自身 头部: ['Subject: '] + 拥有 主题) + 换行符.
	字符串文本 追加: 换行符.
	字符串文本 追加: 拥有 正文.
	字符串文本 追加: 换行符. <- 字符串文本.
}.

>> HTML电子邮件 := 电子邮件 新建.

HTML电子邮件 在: ['初始化'] 执行: {
	自身 初始化.
	拥有 附件列表 := 数组对象 新建.
	拥有 边界 := 保险库 令牌: 40.
}.

HTML电子邮件 在: ['附加:'] 执行: { :会话文件
	>> id := 拥有 附件列表 计数.
	>> 二进制对象 := 会话文件 二进制对象.
	拥有 附件列表 追加: (
		映射对象 新建
			会话文件: 会话文件 路径,
			mime: ['image/'] + (Server 内容类型: 会话文件 路径),
			数据: 二进制对象 互联网编码
	).
	二进制对象 释放. <- ['cid:attachment'] + id.
}.

HTML电子邮件 在: ['生成'] 执行: {
	>> 换行符 := ['\r\n'].
	>> 字符串文本 := [''].
	字符串文本 追加: (自身 头部: ['From: '] + 拥有 发件人名称 + [' <'] + ( 拥有 发件人 ) + ['>']) + 换行符.
	字符串文本 追加: (自身 头部: ['To: '] + ( 拥有 收件人列表 连接: [','] )) + 换行符.
	拥有 cc 计数 是: {
		字符串文本 追加: (自身 头部: ['Cc: '] + ( 拥有 cc 连接: [','] )) + 换行符.
	}.
	拥有 bcc 计数 是: {
		字符串文本 追加: (自身 头部: ['Bcc: '] + ( 拥有 bcc 连接: [','] )) + 换行符.
	}.
	字符串文本 追加: (自身 头部: ['Subject: '] + 拥有 主题) + 换行符.
	字符串文本 追加: ['MIME-Version: 1.0'] + 换行符.
	字符串文本 追加: ['Content-Type: multipart/related; boundary="'] + 拥有 边界 + ['"; type=text/html'] + 换行符.
	字符串文本 追加: 换行符.
	字符串文本 追加: ['--'] + 拥有 边界 + 换行符.
	字符串文本 追加: ['Content-Type: text/html; charset=UTF-8'] + 换行符.
	字符串文本 追加: ['Content-Transfer-Encoding: 7bit'] + 换行符.
	字符串文本 追加: 换行符.
	字符串文本 追加: 拥有 正文.
	字符串文本 追加: 换行符.
	拥有 附件列表 每个: { :id :信息
		>> 二进制对象 := 信息 数据.
		字符串文本 追加: ['--'] + 拥有 边界 + 换行符.
		字符串文本 追加: ['Content-Type: '] + 信息 mime + 换行符.
		字符串文本 追加: ['Content-Transfer-Encoding: base64'] + 换行符.
		字符串文本 追加: ['Content-ID: <attachment'] + id + ['>'] + 换行符.
		字符串文本 追加: ['Content-Disposition: inline; filename="'] + 信息 会话文件 + ['"'] + 换行符.
		字符串文本 追加: 换行符.
		>> 上限 := 76.
		>> 文本长度 := 二进制对象 长度.
		>> 数据块组 := (文本长度 / 上限) 上取整.
		{ :i
			>> 数据块 := 二进制对象 复制 从: i * 上限 长度: 上限.
			字符串文本 追加: 数据块 + 换行符.
		} * 数据块组.
		字符串文本 追加: 换行符.
		字符串文本 追加: 换行符.
	}.
	字符串文本 追加: ['--'] + 拥有 边界 + ['--'] + 换行符. <- 字符串文本.
}.
