>> Email := பொருள் புதிய.

Email பெறும்போது: ['init'] செய்: {
	தனது recipients := வரிசை புதிய.
	தனது cc := வரிசை புதிய.
	தனது bcc := வரிசை புதிய.
	தனது from := வெற்று.
	தனது from-name := வெற்று.
	தனது subject := வெற்று.
	தனது body := வெற்று.
}.

Email பெறும்போது: ['புதிய'] செய்: { <- தான் புதிய init.
}.

Email பெறும்போது: ['to:'] செய்: { :list
	தனது recipients := list.
}.
 
Email பெறும்போது: ['cc:'] செய்: { :list
	தனது cc := list.
}.

Email பெறும்போது: ['bcc:'] செய்: { :list
	தனது bcc := list.
}.

Email பெறும்போது: ['subject:'] செய்: { :subject
	தனது subject := subject.
}.

Email பெறும்போது: ['from:name:'] செய்: { :from :பெயர்
	தனது from := from.
	தனது from-name := பெயர்.
}.

Email பெறும்போது: ['body:'] செய்: { :body
	தனது body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email பெறும்போது: ['header:'] செய்: { :line <- line மாற்று: ['\r'] கொண்டு: [''], மாற்று: ['\n'] கொண்டு: [''].
}.

Email பெறும்போது: ['send'] செய்: {
	>> f := கோப்பு tempwrite: தான் generate.
	நிரல் அமைப்பு: ['sendmail -t < '] + f கோப்பு-பாதை, புதிய-வரி.
}.

Email பெறும்போது: ['generate'] செய்: {
	>> brk := ['\r\n'].
	>> str := [''].
	str இறுதியில்-சேர்: (தான் header: ['From: '] + தனது from-name + [' <'] + ( தனது from ) + ['>']) + brk.
	str இறுதியில்-சேர்: (தான் header: ['To: '] + ( தனது recipients இணை: [','] )) + brk.
	தனது cc எண்ணிக்கை உண்மையெனில்: {
		str இறுதியில்-சேர்: (தான் header: ['Cc: '] + ( தனது cc இணை: [','] )) + brk.
	}.
	தனது bcc எண்ணிக்கை உண்மையெனில்: {
		str இறுதியில்-சேர்: (தான் header: ['Bcc: '] + ( தனது bcc இணை: [','] )) + brk.
	}.
	str இறுதியில்-சேர்: (தான் header: ['Subject: '] + தனது subject) + brk.
	str இறுதியில்-சேர்: brk.
	str இறுதியில்-சேர்: தனது body.
	str இறுதியில்-சேர்: brk. <- str.
}.

>> HTML-Email := Email புதிய.

HTML-Email பெறும்போது: ['init'] செய்: {
	தான் init.
	தனது attachments := வரிசை புதிய.
	தனது boundary := பெட்டகம் டோக்கன்: 40.
}.

HTML-Email பெறும்போது: ['attach:'] செய்: { :file
	>> id := தனது attachments எண்ணிக்கை.
	>> blob := file blob.
	தனது attachments இறுதியில்-சேர்: (
		அகராதி புதிய
			file: file கோப்பு-பாதை,
			mime: ['image/'] + (Server mimetype: file கோப்பு-பாதை),
			data: blob base64-குறியாக்கு
	).
	blob விடுவி. <- ['cid:attachment'] + id.
}.

HTML-Email பெறும்போது: ['generate'] செய்: {
	>> brk := ['\r\n'].
	>> str := [''].
	str இறுதியில்-சேர்: (தான் header: ['From: '] + தனது from-name + [' <'] + ( தனது from ) + ['>']) + brk.
	str இறுதியில்-சேர்: (தான் header: ['To: '] + ( தனது recipients இணை: [','] )) + brk.
	தனது cc எண்ணிக்கை உண்மையெனில்: {
		str இறுதியில்-சேர்: (தான் header: ['Cc: '] + ( தனது cc இணை: [','] )) + brk.
	}.
	தனது bcc எண்ணிக்கை உண்மையெனில்: {
		str இறுதியில்-சேர்: (தான் header: ['Bcc: '] + ( தனது bcc இணை: [','] )) + brk.
	}.
	str இறுதியில்-சேர்: (தான் header: ['Subject: '] + தனது subject) + brk.
	str இறுதியில்-சேர்: ['MIME-Version: 1.0'] + brk.
	str இறுதியில்-சேர்: ['Content-Type: multipart/related; boundary="'] + தனது boundary + ['"; type=text/html'] + brk.
	str இறுதியில்-சேர்: brk.
	str இறுதியில்-சேர்: ['--'] + தனது boundary + brk.
	str இறுதியில்-சேர்: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str இறுதியில்-சேர்: ['Content-Transfer-Encoding: 7bit'] + brk.
	str இறுதியில்-சேர்: brk.
	str இறுதியில்-சேர்: தனது body.
	str இறுதியில்-சேர்: brk.
	தனது attachments ஒவ்வொன்றும்: { :id :info
		>> blob := info data.
		str இறுதியில்-சேர்: ['--'] + தனது boundary + brk.
		str இறுதியில்-சேர்: ['Content-Type: '] + info mime + brk.
		str இறுதியில்-சேர்: ['Content-Transfer-Encoding: base64'] + brk.
		str இறுதியில்-சேர்: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str இறுதியில்-சேர்: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str இறுதியில்-சேர்: brk.
		>> max := 76.
		>> len := blob நீளம்.
		>> chunks := (len / max) மேல்-முழுமை.
		{ :i
			>> chunk := blob நகல் தொடக்கம்: i * max நீளம்: max.
			str இறுதியில்-சேர்: chunk + brk.
		} * chunks.
		str இறுதியில்-சேர்: brk.
		str இறுதியில்-சேர்: brk.
	}.
	str இறுதியில்-சேர்: ['--'] + தனது boundary + ['--'] + brk. <- str.
}.
