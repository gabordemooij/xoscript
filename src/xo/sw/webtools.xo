Ombi-la-HTTP ikija: ['HTTP-kichwa:'] fanya: { :ufunguo <- Programu mpangilio: ufunguo.
}.

>> Kichwa-HTTP := Kipengee mpya.

Kichwa-HTTP ikija: ['mpya'] fanya: { <- binafsi mpya andaa.
}.

Kichwa-HTTP ikija: ['andaa'] fanya: {
	yangu ufunguo := Tupu.
	yangu thamani := Tupu.
}.

Kichwa-HTTP ikija: ['ufunguo:thamani:'] fanya: { :ufunguo :thamani
	yangu ufunguo := ufunguo.
	yangu thamani := thamani.
}.

Kichwa-HTTP ikija: ['ufunguo'] fanya: { <- yangu ufunguo.
}.

Kichwa-HTTP ikija: ['thamani'] fanya: { <- yangu thamani.
}.


Kichwa-HTTP ikija: ['maandishi'] fanya: {
	>> mstari := yangu ufunguo + [': '] + yangu thamani.
	mstari badilisha: ['\r'] kwa: [''], badilisha: ['\n'] kwa: ['']. <- mstari + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Hati-ya-Wavuti := Kipengee mpya.

Hati-ya-Wavuti ikija: ['mpya'] fanya: { <- binafsi mpya andaa.
}.

Hati-ya-Wavuti ikija: ['andaa'] fanya: {
	yangu vichwa := Orodha mpya.
	yangu kitambulisho-cha-kipindi := Tupu.
	yangu msimamizi-wa-vipindi := Kipindi-faili-la-muda mpya.
	yangu data-ya-kipindi := Tupu.
	yangu salama := Kweli.
	yangu tovuti-moja := ['Strict'].
	yangu vichwa-vimetumwa := Uongo.
	yangu ombi-http := Ombi-la-HTTP mpya.
}.

Hati-ya-Wavuti ikija: ['ombi-http:'] fanya: { :ombi-http
	yangu ombi-http := ombi-http.
}. 

Hati-ya-Wavuti ikija: ['kidakuzi-kipindi-salama:'] fanya: { :salama
	binafsi kagua-vichwa.
	yangu salama := salama.
}.

Hati-ya-Wavuti ikija: ['kidakuzi-kipindi-tovuti-moja:'] fanya: { :thamani
	binafsi kagua-vichwa.
	>> chaguo := Orodha mpya 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	chaguo ina: thamani, uongo: {
		jukumu-hili kosa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	yangu tovuti-moja := thamani.
}.

Hati-ya-Wavuti ikija: ['kichwa:'] fanya: { :kichwa
	binafsi kagua-vichwa.
	yangu vichwa ongeza-mwishoni: kichwa.
}.

Hati-ya-Wavuti ikija: ['futa-vichwa'] fanya: {
	binafsi kagua-vichwa.
	yangu vichwa := Orodha mpya.
}.

Hati-ya-Wavuti ikija: ['msimamizi-wa-vipindi:'] fanya: { :msimamizi
	binafsi kagua-vichwa.
	yangu msimamizi-wa-vipindi := msimamizi.
}.

Hati-ya-Wavuti ikija: ['msimamizi-wa-vipindi'] fanya: { <- yangu msimamizi-wa-vipindi.
}.

Hati-ya-Wavuti ikija: ['kagua-vichwa'] fanya: {
	yangu vichwa-vimetumwa kweli: {
		jukumu-hili kosa: ['Headers already sent to client.'].
	}.
}.

Hati-ya-Wavuti ikija: ['anza-kipindi'] fanya: {
	binafsi kagua-vichwa.
	>> ombi-http := yangu ombi-http.
	>> kitambulisho-cha-kipindi := ombi-http cookie: ['xsid'].
	kitambulisho-cha-kipindi Tupu? uongo: {
		(( Ruwaza mpya: ['^[A-Za-z0-9]+\\z'], linganifu: kitambulisho-cha-kipindi ) = 0) kweli: {
			kitambulisho-cha-kipindi := Tupu.
		}.
	}.
	kitambulisho-cha-kipindi Tupu? kweli: {
		kitambulisho-cha-kipindi := Kasha tokeni: 30.
		>> kichwa-cha-kipindi := Kichwa-HTTP mpya
		ufunguo: ['Set-Cookie'] thamani: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (yangu salama ama: ['Secure'] au: ['']),
		SSITE: (yangu tovuti-moja),
		XSID: kitambulisho-cha-kipindi
		).
		yangu vichwa ongeza-mwishoni: kichwa-cha-kipindi.
	}.
	yangu data-ya-kipindi := yangu msimamizi-wa-vipindi kwa-ajili-ya: kitambulisho-cha-kipindi, pakia. <- yangu data-ya-kipindi. # reference
}.

Hati-ya-Wavuti ikija: ['nenda-kwa:'] fanya: { :anwani
	binafsi kagua-vichwa.
	binafsi futa-vichwa.
	yangu vichwa
	ongeza-mwishoni: (
		Kichwa-HTTP mpya
		ufunguo: ['Status'] thamani: ['303 See Other']
	),
	ongeza-mwishoni: (
		Kichwa-HTTP mpya
		ufunguo: ['Location'] thamani: anwani
	).
	binafsi onyesha: ['Redirect'].
}.

Hati-ya-Wavuti ikija: ['haribu-kipindi'] fanya: {
	binafsi kagua-vichwa.
	>> ombi-http := yangu ombi-http.
	>> kitambulisho-cha-kipindi := ombi-http cookie: ['xsid'].
	kitambulisho-cha-kipindi Tupu? uongo: {
		>> kichwa-cha-kipindi := Kichwa-HTTP mpya.
		>> muda-wa-kuisha := Muda mpya mwaka: 1970, umbizo: ['%a, %d %b %Y %H:%M:%S GMT'].
		kichwa-cha-kipindi ufunguo: ['Set-Cookie'] thamani: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: muda-wa-kuisha,
			SEC: (yangu salama ama: ['Secure'] au: ['']),
			SSITE: (yangu tovuti-moja),
			XSID: kitambulisho-cha-kipindi
		).
		yangu msimamizi-wa-vipindi haribu.
		yangu vichwa ongeza-mwishoni: kichwa-cha-kipindi.
	}.
}.


Hati-ya-Wavuti ikija: ['kiolezo:'] fanya: { :njia-ya-faili <- Kiolezo mpya: (Faili mpya: njia-ya-faili, soma).
}.

Hati-ya-Wavuti ikija: ['onyesha:aina:'] fanya: { :tokeo :aina
	yangu vichwa-vimetumwa uongo: {
		yangu data-ya-kipindi Tupu? uongo: {
			yangu msimamizi-wa-vipindi hifadhi: yangu data-ya-kipindi.
		}.
		yangu vichwa ongeza-mwishoni: (
			Kichwa-HTTP mpya
			ufunguo: ['Content-type'] thamani: aina
		).
		yangu vichwa kila: { :_ :kichwa
			Towe andika: kichwa.
		}.
		yangu vichwa-vimetumwa := Kweli.
		Towe andika: ['\r\n'].
	}.
	Towe andika: tokeo.
}.

Hati-ya-Wavuti ikija: ['maliza:aina:'] fanya: { :tokeo :aina
	yangu vichwa-vimetumwa uongo: {
		yangu data-ya-kipindi Tupu? uongo: {
			yangu msimamizi-wa-vipindi hifadhi: yangu data-ya-kipindi.
		}.
		yangu vichwa ongeza-mwishoni: (
			Kichwa-HTTP mpya
			ufunguo: ['Content-type'] thamani: aina
		).
		yangu vichwa ongeza-mwishoni: (
			Kichwa-HTTP mpya
			ufunguo: ['Content-Length'] thamani: tokeo maandishi bytes
		).
		yangu vichwa kila: { :_ :kichwa
			Towe andika: kichwa.
		}.
		yangu vichwa-vimetumwa := Kweli.
		Towe andika: ['\r\n'].
	}.
	Towe andika: tokeo.
}.

Hati-ya-Wavuti ikija: ['onyesha:'] fanya: { :tokeo
	binafsi onyesha: tokeo aina: ['text/html; charset=utf-8'].
}.

Hati-ya-Wavuti ikija: ['maliza:'] fanya: { :tokeo
	binafsi maliza: tokeo aina: ['text/html; charset=utf-8'].
}.

Hati-ya-Wavuti ikija: ['json:'] fanya: { :tokeo
	binafsi onyesha: ( JSON jsonify: tokeo ) aina: ['application/json'].
}.

Hati-ya-Wavuti ikija: ['haikupatikana:'] fanya: { :tokeo
	binafsi futa-vichwa kichwa: (
		Kichwa-HTTP mpya ufunguo: ['Status'] thamani: ['404 Not Found']
	).
	binafsi onyesha: tokeo.
}.


# Interface

>> Kipindi := Kipengee mpya.

Kipindi ikija: ['mpya'] fanya: { <- binafsi mpya andaa kwa-ajili-ya: Tupu.
}.

Kipindi ikija: ['kwa-ajili-ya:'] fanya: { :id
	yangu id := id.
}.

Kipindi ikija: ['pakia'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

Kipindi ikija: ['hifadhi:'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

Kipindi ikija: ['haribu'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Kipindi-faili-la-muda := Kipindi mpya.

Kipindi-faili-la-muda ikija: ['andaa'] fanya: {
	yangu mwanzo-wa-njia := ['/tmp/sess-'].
}.

Kipindi-faili-la-muda ikija: ['kiambishi-njia:'] fanya: { :mfuatano
	yangu mwanzo-wa-njia := mfuatano.
}.

Kipindi-faili-la-muda ikija: ['faili-la-kipindi'] fanya: { <- ( Faili mpya: ( yangu mwanzo-wa-njia + yangu id + ['.txt'] ) ).
}.

Kipindi-faili-la-muda ikija: ['pakia'] fanya: {
	>> faili-la-kipindi := binafsi faili-la-kipindi.
	faili-la-kipindi ipo uongo: {
		faili-la-kipindi andika: (Kamusi mpya msimbo).
	}. <- faili-la-kipindi soma kipengee.
}.

Kipindi-faili-la-muda ikija: ['hifadhi:'] fanya: { :data
	>> faili-la-kipindi := binafsi faili-la-kipindi.
	faili-la-kipindi ipo kweli: {
		faili-la-kipindi andika: data msimbo.
	}.
}.

Kipindi-faili-la-muda ikija: ['haribu'] fanya: {
	>> faili-la-kipindi := binafsi faili-la-kipindi.
	faili-la-kipindi ipo kweli: {
		faili-la-kipindi futa.
	}.
}.


>> URL := Kipengee mpya.

URL ikija: ['andaa'] fanya: {
	yangu itifaki := ['https://'].
	yangu mwenyeji := ['localhost'].
	yangu njia-ya-faili := [''].
	yangu vigezo-vya-url := [''].
	yangu hash := [''].
}.

URL ikija: ['mpya'] fanya: { <- binafsi mpya andaa.
}.

URL ikija: ['maandishi'] fanya: { <- (
	yangu itifaki +
	yangu mwenyeji +
	yangu njia-ya-faili +
	yangu vigezo-vya-url +
	yangu hash ).
}.

URL ikija: ['itifaki:'] fanya: { :itifaki
	((Orodha mpya ; ['http'] ; ['https']) ina: itifaki) kweli: {
		yangu itifaki := itifaki + ['://'].
	}, uongo: {
		jukumu-hili kosa: ['Invalid protocol'].
	}.
}.

URL ikija: ['mwenyeji:'] fanya: { :mwenyeji
	#todo validate according to rfc
	yangu mwenyeji := mwenyeji.
}.

URL ikija: ['njia-ya-faili:'] fanya: { :njia-ya-faili
	yangu njia-ya-faili := ['/'] + njia-ya-faili url-simba.
}.

URL ikija: ['vigezo-vya-url:'] fanya: { :ramani
	>> vigezo-vya-url := Orodha mpya.
	ramani kila: { :ufunguo :thamani
		vigezo-vya-url ongeza-mwishoni: ufunguo maandishi url-simba + ['='] + thamani maandishi url-simba.
	}.
	yangu vigezo-vya-url := ['?'] + ( vigezo-vya-url unganisha: ['&'] ).
}.

URL ikija: ['hashi:'] fanya: { :hash
	yangu hash := ['#'] + hash url-simba.
}.

