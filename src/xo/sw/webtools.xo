Ombi-la-HTTP ikija: ['HTTP-header:'] fanya: { :key <- Programu mpangilio: key.
}.

>> HTTP-Header := Kipengee mpya.

HTTP-Header ikija: ['mpya'] fanya: { <- binafsi mpya init.
}.

HTTP-Header ikija: ['init'] fanya: {
	yangu key := Tupu.
	yangu value := Tupu.
}.

HTTP-Header ikija: ['key:value:'] fanya: { :key :value
	yangu key := key.
	yangu value := value.
}.

HTTP-Header ikija: ['key'] fanya: { <- yangu key.
}.

HTTP-Header ikija: ['value'] fanya: { <- yangu value.
}.


HTTP-Header ikija: ['maandishi'] fanya: {
	>> line := yangu key + [': '] + yangu value.
	line badilisha: ['\r'] kwa: [''], badilisha: ['\n'] kwa: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Kipengee mpya.

Web-Document ikija: ['mpya'] fanya: { <- binafsi mpya init.
}.

Web-Document ikija: ['init'] fanya: {
	yangu headers := Orodha mpya.
	yangu sess-id := Tupu.
	yangu session-manager := Tempfile-Session mpya.
	yangu sessdata := Tupu.
	yangu secure := Kweli.
	yangu same-site := ['Strict'].
	yangu headers-out := Uongo.
	yangu request := Ombi-la-HTTP mpya.
}.

Web-Document ikija: ['request:'] fanya: { :request
	yangu request := request.
}. 

Web-Document ikija: ['secure-session-cookie:'] fanya: { :secure
	binafsi check-headers.
	yangu secure := secure.
}.

Web-Document ikija: ['same-site-session-cookie:'] fanya: { :value
	binafsi check-headers.
	>> options := Orodha mpya 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options inajumuisha: value, uongo: {
		jukumu-hili kosa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	yangu same-site := value.
}.

Web-Document ikija: ['header:'] fanya: { :header
	binafsi check-headers.
	yangu headers ongeza-mwishoni: header.
}.

Web-Document ikija: ['clear-headers'] fanya: {
	binafsi check-headers.
	yangu headers := Orodha mpya.
}.

Web-Document ikija: ['session-manager:'] fanya: { :manager
	binafsi check-headers.
	yangu session-manager := manager.
}.

Web-Document ikija: ['session-manager'] fanya: { <- yangu session-manager.
}.

Web-Document ikija: ['check-headers'] fanya: {
	yangu headers-out kweli: {
		jukumu-hili kosa: ['Headers already sent to client.'].
	}.
}.

Web-Document ikija: ['session-start'] fanya: {
	binafsi check-headers.
	>> request := yangu request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Tupu? uongo: {
		(( Ruwaza mpya: ['^[A-Za-z0-9]+\\z'], linganifu: sess-id ) = 0) kweli: {
			sess-id := Tupu.
		}.
	}.
	sess-id Tupu? kweli: {
		sess-id := Kasha tokeni: 30.
		>> session-header := HTTP-Header mpya
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (yangu secure ama: ['Secure'] au: ['']),
		SSITE: (yangu same-site),
		XSID: sess-id
		).
		yangu headers ongeza-mwishoni: session-header.
	}.
	yangu sessdata := yangu session-manager for: sess-id, load. <- yangu sessdata. # reference
}.

Web-Document ikija: ['goto:'] fanya: { :url
	binafsi check-headers.
	binafsi clear-headers.
	yangu headers
	ongeza-mwishoni: (
		HTTP-Header mpya
		key: ['Status'] value: ['303 See Other']
	),
	ongeza-mwishoni: (
		HTTP-Header mpya
		key: ['Location'] value: url
	).
	binafsi out: ['Redirect'].
}.

Web-Document ikija: ['session-destroy'] fanya: {
	binafsi check-headers.
	>> request := yangu request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Tupu? uongo: {
		>> session-header := HTTP-Header mpya.
		>> when := Muda mpya mwaka: 1970, umbizo: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (yangu secure ama: ['Secure'] au: ['']),
			SSITE: (yangu same-site),
			XSID: sess-id
		).
		yangu session-manager destroy.
		yangu headers ongeza-mwishoni: session-header.
	}.
}.


Web-Document ikija: ['template:'] fanya: { :njia-ya-faili <- Template mpya: (Faili mpya: njia-ya-faili, soma).
}.

Web-Document ikija: ['out:type:'] fanya: { :output :aina
	yangu headers-out uongo: {
		yangu sessdata Tupu? uongo: {
			yangu session-manager save: yangu sessdata.
		}.
		yangu headers ongeza-mwishoni: (
			HTTP-Header mpya
			key: ['Content-type'] value: aina
		).
		yangu headers kila: { :_ :header
			Towe andika: header.
		}.
		yangu headers-out := Kweli.
		Towe andika: ['\r\n'].
	}.
	Towe andika: output.
}.

Web-Document ikija: ['finish:type:'] fanya: { :output :aina
	yangu headers-out uongo: {
		yangu sessdata Tupu? uongo: {
			yangu session-manager save: yangu sessdata.
		}.
		yangu headers ongeza-mwishoni: (
			HTTP-Header mpya
			key: ['Content-type'] value: aina
		).
		yangu headers ongeza-mwishoni: (
			HTTP-Header mpya
			key: ['Content-Length'] value: output maandishi bytes
		).
		yangu headers kila: { :_ :header
			Towe andika: header.
		}.
		yangu headers-out := Kweli.
		Towe andika: ['\r\n'].
	}.
	Towe andika: output.
}.

Web-Document ikija: ['out:'] fanya: { :output
	binafsi out: output type: ['text/html; charset=utf-8'].
}.

Web-Document ikija: ['finish:'] fanya: { :output
	binafsi finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document ikija: ['json:'] fanya: { :output
	binafsi out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document ikija: ['not-found:'] fanya: { :output
	binafsi clear-headers header: (
		HTTP-Header mpya key: ['Status'] value: ['404 Not Found']
	).
	binafsi out: output.
}.


# Interface

>> Session := Kipengee mpya.

Session ikija: ['mpya'] fanya: { <- binafsi mpya init for: Tupu.
}.

Session ikija: ['for:'] fanya: { :id
	yangu id := id.
}.

Session ikija: ['load'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

Session ikija: ['save:'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

Session ikija: ['destroy'] fanya: {
	jukumu-hili kosa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session mpya.

Tempfile-Session ikija: ['init'] fanya: {
	yangu pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session ikija: ['path-prefix:'] fanya: { :str
	yangu pathprefix := str.
}.

Tempfile-Session ikija: ['file'] fanya: { <- ( Faili mpya: ( yangu pathprefix + yangu id + ['.txt'] ) ).
}.

Tempfile-Session ikija: ['load'] fanya: {
	>> file := binafsi file.
	file ipo uongo: {
		file andika: (Kamusi mpya msimbo).
	}. <- file soma kipengee.
}.

Tempfile-Session ikija: ['save:'] fanya: { :data
	>> file := binafsi file.
	file ipo kweli: {
		file andika: data msimbo.
	}.
}.

Tempfile-Session ikija: ['destroy'] fanya: {
	>> file := binafsi file.
	file ipo kweli: {
		file futa.
	}.
}.


>> URL := Kipengee mpya.

URL ikija: ['init'] fanya: {
	yangu protocol := ['https://'].
	yangu mwenyeji := ['localhost'].
	yangu njia-ya-faili := [''].
	yangu params := [''].
	yangu hash := [''].
}.

URL ikija: ['mpya'] fanya: { <- binafsi mpya init.
}.

URL ikija: ['maandishi'] fanya: { <- (
	yangu protocol +
	yangu mwenyeji +
	yangu njia-ya-faili +
	yangu params +
	yangu hash ).
}.

URL ikija: ['protocol:'] fanya: { :protocol
	((Orodha mpya: ['http'] ; ['https']) inajumuisha: protocol) kweli: {
		yangu protocol := protocol + ['://'].
	}, uongo: {
		jukumu-hili kosa: ['Invalid protocol'].
	}.
}.

URL ikija: ['mwenyeji:'] fanya: { :mwenyeji
	#todo validate according to rfc
	yangu mwenyeji := mwenyeji.
}.

URL ikija: ['path:'] fanya: { :njia-ya-faili
	yangu njia-ya-faili := ['/'] + njia-ya-faili url-simba.
}.

URL ikija: ['params:'] fanya: { :map
	>> params := Orodha mpya.
	map kila: { :key :value
		params ongeza-mwishoni: key maandishi url-simba + ['='] + value maandishi url-simba.
	}.
	yangu params := ['?'] + ( params unganisha: ['&'] ).
}.

URL ikija: ['hashi:'] fanya: { :hash
	yangu hash := ['#'] + hash url-simba.
}.

