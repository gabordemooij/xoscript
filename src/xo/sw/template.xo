
# ~ Simple template engine ~

>> Kiolezo := Kipengee mpya.

Kiolezo ikija: ['mpya'] fanya: { <- binafsi mpya maudhui: [''].
}.

Kiolezo ikija: ['maudhui:'] fanya: { :maudhui
	yangu maudhui := maudhui. 
}.

Kiolezo ikija: ['mpya:'] fanya: { :maudhui <- binafsi mpya maudhui: maudhui.
}.

Kiolezo ikija: ['kata:'] fanya: { :alama
	>> alama-ya-mwanzo := (['<!-- cut:%id% -->'] %id%: alama).
	>> alama-ya-mwisho := (['<!-- /cut:%id% -->'] %id%: alama).
	>> sehemu-sehemu := yangu maudhui gawa: alama-ya-mwanzo.
	>> kiambishi := sehemu-sehemu wa-kwanza.
	>> sehemu-sehemu2 := sehemu-sehemu wa-mwisho gawa: alama-ya-mwisho.
	>> kiambishi-tamati := sehemu-sehemu2 wa-mwisho.
	>> sehemu := sehemu-sehemu2 wa-kwanza.
	>> salio := kiambishi + kiambishi-tamati.
	yangu maudhui := salio. <- Kiolezo mpya: sehemu.
	
}.

Kiolezo ikija: ['nakala'] fanya: { <- binafsi mpya: binafsi maandishi nakala.
}.
	
Kiolezo ikija: ['bandika:kwenye:'] fanya: { :dondoo :id
	>> alama-ya-kubandika := (['<!-- paste:%id% -->'] %id%: id).
	yangu maudhui badilisha: alama-ya-kubandika kwa: ( dondoo maandishi + alama-ya-kubandika ).
}.

Kiolezo ikija: ['weka:thamani:'] fanya: { :nafasi-ya-kuingiza :thamani
	yangu maudhui badilisha: ['<!-- slot:'] + nafasi-ya-kuingiza + [' -->'] kwa: ( Server html-simba: thamani ).
}.

Kiolezo ikija: ['weka:html:'] fanya: { :nafasi-ya-kuingiza :html
	yangu maudhui badilisha: ['<!-- slot:'] + nafasi-ya-kuingiza + [' -->'] kwa: html.
}.

Kiolezo ikija: ['jibu:na:'] fanya: { :nafasi-ya-kuingiza :thamani
	binafsi weka: (nafasi-ya-kuingiza kutoka: 0 urefu: (nafasi-ya-kuingiza urefu - 1)) thamani: thamani.
}.

Kiolezo ikija: ['nl2br'] fanya: {
	yangu maudhui badilisha: ['\n'] kwa: ['<br>'].
}.

Kiolezo ikija: ['nadhifisha'] fanya: {
	yangu maudhui :=
		Ruwaza
		mpya: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		linganifu: yangu maudhui
		fanya: { <- ['']. }.
}.

Kiolezo ikija: ['nadhifisha-vipande-vilivyokatwa'] fanya: {
	>> vitu := Orodha mpya.
	Ruwaza
	mpya: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	linganifu: yangu maudhui
	fanya: { :_ :sehemu
		vitu ongeza-mwishoni: sehemu ? 1.
	}.
	vitu kila: { :_ :id
		yangu maudhui :=
			Ruwaza mpya: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			linganifu: yangu maudhui
			fanya: { <- ['']. }.
	 }.
}.

Kiolezo ikija: ['nadhifisha-nafasi'] fanya: {
	yangu maudhui :=
		Ruwaza
		mpya: ['\\s*\\n'],
		linganifu: yangu maudhui
		fanya: { <- ['\n']. }.
	yangu maudhui :=
		Ruwaza
		mpya: ['\\n[\\s\\t]+'],
		linganifu: yangu maudhui
		fanya: { <- ['\n']. }.
}.

Kiolezo ikija: ['nadhifisha-yote'] fanya: {
	binafsi nadhifisha.
	binafsi nadhifisha-vipande-vilivyokatwa.
	binafsi nadhifisha-nafasi.
}.

Kiolezo ikija: ['maandishi'] fanya: { <- yangu maudhui.
}.
