>> Email := Kipengee mpya.

Email ikija: ['init'] fanya: {
	yangu recipients := Orodha mpya.
	yangu cc := Orodha mpya.
	yangu bcc := Orodha mpya.
	yangu from := Tupu.
	yangu from-name := Tupu.
	yangu subject := Tupu.
	yangu body := Tupu.
}.

Email ikija: ['mpya'] fanya: { <- binafsi mpya init.
}.

Email ikija: ['to:'] fanya: { :list
	yangu recipients := list.
}.
 
Email ikija: ['cc:'] fanya: { :list
	yangu cc := list.
}.

Email ikija: ['bcc:'] fanya: { :list
	yangu bcc := list.
}.

Email ikija: ['subject:'] fanya: { :subject
	yangu subject := subject.
}.

Email ikija: ['from:name:'] fanya: { :from :jina
	yangu from := from.
	yangu from-name := jina.
}.

Email ikija: ['body:'] fanya: { :body
	yangu body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email ikija: ['header:'] fanya: { :line <- line badilisha: ['\r'] kwa: [''], badilisha: ['\n'] kwa: [''].
}.

Email ikija: ['send'] fanya: {
	>> f := Faili tempwrite: binafsi generate.
	Programu mfumo: ['sendmail -t < '] + f njia-ya-faili, mstari-mpya.
}.

Email ikija: ['generate'] fanya: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ongeza-mwishoni: (binafsi header: ['From: '] + yangu from-name + [' <'] + ( yangu from ) + ['>']) + brk.
	str ongeza-mwishoni: (binafsi header: ['To: '] + ( yangu recipients unganisha: [','] )) + brk.
	yangu cc hesabu kweli: {
		str ongeza-mwishoni: (binafsi header: ['Cc: '] + ( yangu cc unganisha: [','] )) + brk.
	}.
	yangu bcc hesabu kweli: {
		str ongeza-mwishoni: (binafsi header: ['Bcc: '] + ( yangu bcc unganisha: [','] )) + brk.
	}.
	str ongeza-mwishoni: (binafsi header: ['Subject: '] + yangu subject) + brk.
	str ongeza-mwishoni: brk.
	str ongeza-mwishoni: yangu body.
	str ongeza-mwishoni: brk. <- str.
}.

>> HTML-Email := Email mpya.

HTML-Email ikija: ['init'] fanya: {
	binafsi init.
	yangu attachments := Orodha mpya.
	yangu boundary := Kasha tokeni: 40.
}.

HTML-Email ikija: ['attach:'] fanya: { :file
	>> id := yangu attachments hesabu.
	>> blob := file blob.
	yangu attachments ongeza-mwishoni: (
		Kamusi mpya
			file: file njia-ya-faili,
			mime: ['image/'] + (Server mimetype: file njia-ya-faili),
			data: blob base64-simba
	).
	blob achilia. <- ['cid:attachment'] + id.
}.

HTML-Email ikija: ['generate'] fanya: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ongeza-mwishoni: (binafsi header: ['From: '] + yangu from-name + [' <'] + ( yangu from ) + ['>']) + brk.
	str ongeza-mwishoni: (binafsi header: ['To: '] + ( yangu recipients unganisha: [','] )) + brk.
	yangu cc hesabu kweli: {
		str ongeza-mwishoni: (binafsi header: ['Cc: '] + ( yangu cc unganisha: [','] )) + brk.
	}.
	yangu bcc hesabu kweli: {
		str ongeza-mwishoni: (binafsi header: ['Bcc: '] + ( yangu bcc unganisha: [','] )) + brk.
	}.
	str ongeza-mwishoni: (binafsi header: ['Subject: '] + yangu subject) + brk.
	str ongeza-mwishoni: ['MIME-Version: 1.0'] + brk.
	str ongeza-mwishoni: ['Content-Type: multipart/related; boundary="'] + yangu boundary + ['"; type=text/html'] + brk.
	str ongeza-mwishoni: brk.
	str ongeza-mwishoni: ['--'] + yangu boundary + brk.
	str ongeza-mwishoni: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str ongeza-mwishoni: ['Content-Transfer-Encoding: 7bit'] + brk.
	str ongeza-mwishoni: brk.
	str ongeza-mwishoni: yangu body.
	str ongeza-mwishoni: brk.
	yangu attachments kila: { :id :info
		>> blob := info data.
		str ongeza-mwishoni: ['--'] + yangu boundary + brk.
		str ongeza-mwishoni: ['Content-Type: '] + info mime + brk.
		str ongeza-mwishoni: ['Content-Transfer-Encoding: base64'] + brk.
		str ongeza-mwishoni: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str ongeza-mwishoni: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str ongeza-mwishoni: brk.
		>> max := 76.
		>> len := blob urefu.
		>> chunks := (len / max) kadiria-juu.
		{ :i
			>> chunk := blob nakala kutoka: i * max urefu: max.
			str ongeza-mwishoni: chunk + brk.
		} * chunks.
		str ongeza-mwishoni: brk.
		str ongeza-mwishoni: brk.
	}.
	str ongeza-mwishoni: ['--'] + yangu boundary + ['--'] + brk. <- str.
}.
