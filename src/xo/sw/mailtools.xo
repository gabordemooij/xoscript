>> Barua-pepe := Kipengee mpya.

Barua-pepe ikija: ['andaa'] fanya: {
	yangu wapokeaji := Orodha mpya.
	yangu cc := Orodha mpya.
	yangu bcc := Orodha mpya.
	yangu mtumaji := Tupu.
	yangu jina-la-mtumaji := Tupu.
	yangu mada := Tupu.
	yangu mwili := Tupu.
}.

Barua-pepe ikija: ['mpya'] fanya: { <- binafsi mpya andaa.
}.

Barua-pepe ikija: ['kwa-mpokeaji:'] fanya: { :orodha-ya-vitu
	yangu wapokeaji := orodha-ya-vitu.
}.
 
Barua-pepe ikija: ['cc:'] fanya: { :orodha-ya-vitu
	yangu cc := orodha-ya-vitu.
}.

Barua-pepe ikija: ['bcc:'] fanya: { :orodha-ya-vitu
	yangu bcc := orodha-ya-vitu.
}.

Barua-pepe ikija: ['mada:'] fanya: { :mada
	yangu mada := mada.
}.

Barua-pepe ikija: ['mtumaji:jina:'] fanya: { :mtumaji :jina
	yangu mtumaji := mtumaji.
	yangu jina-la-mtumaji := jina.
}.

Barua-pepe ikija: ['mwili:'] fanya: { :mwili
	yangu mwili := mwili.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Barua-pepe ikija: ['kichwa:'] fanya: { :mstari <- mstari badilisha: ['\r'] kwa: [''], badilisha: ['\n'] kwa: [''].
}.

Barua-pepe ikija: ['tuma'] fanya: {
	>> f := Faili tempwrite: binafsi zalisha.
	Programu mfumo: ['sendmail -t < '] + f njia-ya-faili, mstari-mpya.
}.

Barua-pepe ikija: ['zalisha'] fanya: {
	>> kuvunja-mstari := ['\r\n'].
	>> mfuatano := [''].
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['From: '] + yangu jina-la-mtumaji + [' <'] + ( yangu mtumaji ) + ['>']) + kuvunja-mstari.
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['To: '] + ( yangu wapokeaji unganisha: [','] )) + kuvunja-mstari.
	yangu cc hesabu kweli: {
		mfuatano ongeza-mwishoni: (binafsi kichwa: ['Cc: '] + ( yangu cc unganisha: [','] )) + kuvunja-mstari.
	}.
	yangu bcc hesabu kweli: {
		mfuatano ongeza-mwishoni: (binafsi kichwa: ['Bcc: '] + ( yangu bcc unganisha: [','] )) + kuvunja-mstari.
	}.
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['Subject: '] + yangu mada) + kuvunja-mstari.
	mfuatano ongeza-mwishoni: kuvunja-mstari.
	mfuatano ongeza-mwishoni: yangu mwili.
	mfuatano ongeza-mwishoni: kuvunja-mstari. <- mfuatano.
}.

>> Barua-pepe-HTML := Barua-pepe mpya.

Barua-pepe-HTML ikija: ['andaa'] fanya: {
	binafsi andaa.
	yangu viambatisho := Orodha mpya.
	yangu mpaka := Kasha tokeni: 40.
}.

Barua-pepe-HTML ikija: ['ambatisha:'] fanya: { :faili-la-kipindi
	>> id := yangu viambatisho hesabu.
	>> blob := faili-la-kipindi blob.
	yangu viambatisho ongeza-mwishoni: (
		Kamusi mpya
			faili-la-kipindi: faili-la-kipindi njia-ya-faili,
			mime: ['image/'] + (Server mimetype: faili-la-kipindi njia-ya-faili),
			data: blob base64-simba
	).
	blob achilia. <- ['cid:attachment'] + id.
}.

Barua-pepe-HTML ikija: ['zalisha'] fanya: {
	>> kuvunja-mstari := ['\r\n'].
	>> mfuatano := [''].
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['From: '] + yangu jina-la-mtumaji + [' <'] + ( yangu mtumaji ) + ['>']) + kuvunja-mstari.
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['To: '] + ( yangu wapokeaji unganisha: [','] )) + kuvunja-mstari.
	yangu cc hesabu kweli: {
		mfuatano ongeza-mwishoni: (binafsi kichwa: ['Cc: '] + ( yangu cc unganisha: [','] )) + kuvunja-mstari.
	}.
	yangu bcc hesabu kweli: {
		mfuatano ongeza-mwishoni: (binafsi kichwa: ['Bcc: '] + ( yangu bcc unganisha: [','] )) + kuvunja-mstari.
	}.
	mfuatano ongeza-mwishoni: (binafsi kichwa: ['Subject: '] + yangu mada) + kuvunja-mstari.
	mfuatano ongeza-mwishoni: ['MIME-Version: 1.0'] + kuvunja-mstari.
	mfuatano ongeza-mwishoni: ['Content-Type: multipart/related; boundary="'] + yangu mpaka + ['"; type=text/html'] + kuvunja-mstari.
	mfuatano ongeza-mwishoni: kuvunja-mstari.
	mfuatano ongeza-mwishoni: ['--'] + yangu mpaka + kuvunja-mstari.
	mfuatano ongeza-mwishoni: ['Content-Type: text/html; charset=UTF-8'] + kuvunja-mstari.
	mfuatano ongeza-mwishoni: ['Content-Transfer-Encoding: 7bit'] + kuvunja-mstari.
	mfuatano ongeza-mwishoni: kuvunja-mstari.
	mfuatano ongeza-mwishoni: yangu mwili.
	mfuatano ongeza-mwishoni: kuvunja-mstari.
	yangu viambatisho kila: { :id :taarifa
		>> blob := taarifa data.
		mfuatano ongeza-mwishoni: ['--'] + yangu mpaka + kuvunja-mstari.
		mfuatano ongeza-mwishoni: ['Content-Type: '] + taarifa mime + kuvunja-mstari.
		mfuatano ongeza-mwishoni: ['Content-Transfer-Encoding: base64'] + kuvunja-mstari.
		mfuatano ongeza-mwishoni: ['Content-ID: <attachment'] + id + ['>'] + kuvunja-mstari.
		mfuatano ongeza-mwishoni: ['Content-Disposition: inline; filename="'] + taarifa faili-la-kipindi + ['"'] + kuvunja-mstari.
		mfuatano ongeza-mwishoni: kuvunja-mstari.
		>> upeo := 76.
		>> urefu-wa-maandishi := blob urefu.
		>> vipisi := (urefu-wa-maandishi / upeo) kadiria-juu.
		{ :i
			>> kipisi := blob nakala kutoka: i * upeo urefu: upeo.
			mfuatano ongeza-mwishoni: kipisi + kuvunja-mstari.
		} * vipisi.
		mfuatano ongeza-mwishoni: kuvunja-mstari.
		mfuatano ongeza-mwishoni: kuvunja-mstari.
	}.
	mfuatano ongeza-mwishoni: ['--'] + yangu mpaka + ['--'] + kuvunja-mstari. <- mfuatano.
}.
