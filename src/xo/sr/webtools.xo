HTTP-Захтев на: ['HTTP-заглавље:'] уради: { :кључ <- Програм подешавање: кључ.
}.

>> HTTP-Заглавље := Објекат нови.

HTTP-Заглавље на: ['нови'] уради: { <- себе нови иницијализуј.
}.

HTTP-Заглавље на: ['иницијализуј'] уради: {
	свој кључ := Ништа.
	свој вредност := Ништа.
}.

HTTP-Заглавље на: ['кључ:вредност:'] уради: { :кључ :вредност
	свој кључ := кључ.
	свој вредност := вредност.
}.

HTTP-Заглавље на: ['кључ'] уради: { <- свој кључ.
}.

HTTP-Заглавље на: ['вредност'] уради: { <- свој вредност.
}.


HTTP-Заглавље на: ['текст'] уради: {
	>> ред := свој кључ + [': '] + свој вредност.
	ред замени: ['\r'] са: [''], замени: ['\n'] са: ['']. <- ред + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Објекат нови.

Веб-документ на: ['нови'] уради: { <- себе нови иницијализуј.
}.

Веб-документ на: ['иницијализуј'] уради: {
	свој заглавља := Листа нови.
	свој ид-сесије := Ништа.
	свој управљач-сесија := Сесија-привремена-датотека нови.
	свој подаци-сесије := Ништа.
	свој безбедно := Тачно.
	свој исти-сајт := ['Strict'].
	свој заглавља-послата := Нетачно.
	свој захтев := HTTP-Захтев нови.
}.

Веб-документ на: ['захтев:'] уради: { :захтев
	свој захтев := захтев.
}. 

Веб-документ на: ['безбедни-колачић-сесије:'] уради: { :безбедно
	себе провери-заглавља.
	свој безбедно := безбедно.
}.

Веб-документ на: ['колачић-сесије-исти-сајт:'] уради: { :вредност
	себе провери-заглавља.
	>> опције := Листа нови 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опције има: вредност, нетачно: {
		овај-задатак грешка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	свој исти-сајт := вредност.
}.

Веб-документ на: ['заглавље:'] уради: { :заглавље
	себе провери-заглавља.
	свој заглавља додај-на-крај: заглавље.
}.

Веб-документ на: ['испразни-заглавља'] уради: {
	себе провери-заглавља.
	свој заглавља := Листа нови.
}.

Веб-документ на: ['управљач-сесија:'] уради: { :управљач
	себе провери-заглавља.
	свој управљач-сесија := управљач.
}.

Веб-документ на: ['управљач-сесија'] уради: { <- свој управљач-сесија.
}.

Веб-документ на: ['провери-заглавља'] уради: {
	свој заглавља-послата тачно: {
		овај-задатак грешка: ['Headers already sent to client.'].
	}.
}.

Веб-документ на: ['покрени-сесију'] уради: {
	себе провери-заглавља.
	>> захтев := свој захтев.
	>> ид-сесије := захтев cookie: ['xsid'].
	ид-сесије Ништа? нетачно: {
		(( Образац нови: ['^[A-Za-z0-9]+\\z'], подударање: ид-сесије ) = 0) тачно: {
			ид-сесије := Ништа.
		}.
	}.
	ид-сесије Ништа? тачно: {
		ид-сесије := Сеф токен: 30.
		>> заглавље-сесије := HTTP-Заглавље нови
		кључ: ['Set-Cookie'] вредност: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (свој безбедно или: ['Secure'] или: ['']),
		SSITE: (свој исти-сајт),
		XSID: ид-сесије
		).
		свој заглавља додај-на-крај: заглавље-сесије.
	}.
	свој подаци-сесије := свој управљач-сесија за: ид-сесије, учитај. <- свој подаци-сесије. # reference
}.

Веб-документ на: ['иди-на:'] уради: { :адреса
	себе провери-заглавља.
	себе испразни-заглавља.
	свој заглавља
	додај-на-крај: (
		HTTP-Заглавље нови
		кључ: ['Status'] вредност: ['303 See Other']
	),
	додај-на-крај: (
		HTTP-Заглавље нови
		кључ: ['Location'] вредност: адреса
	).
	себе испиши: ['Redirect'].
}.

Веб-документ на: ['уништи-сесију'] уради: {
	себе провери-заглавља.
	>> захтев := свој захтев.
	>> ид-сесије := захтев cookie: ['xsid'].
	ид-сесије Ништа? нетачно: {
		>> заглавље-сесије := HTTP-Заглавље нови.
		>> тренутак := Тренутак нови година: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		заглавље-сесије кључ: ['Set-Cookie'] вредност: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: тренутак,
			SEC: (свој безбедно или: ['Secure'] или: ['']),
			SSITE: (свој исти-сајт),
			XSID: ид-сесије
		).
		свој управљач-сесија уништи.
		свој заглавља додај-на-крај: заглавље-сесије.
	}.
}.


Веб-документ на: ['шаблон:'] уради: { :путања <- Шаблон нови: (Датотека нови: путања, читај).
}.

Веб-документ на: ['испиши:тип:'] уради: { :излаз :тип
	свој заглавља-послата нетачно: {
		свој подаци-сесије Ништа? нетачно: {
			свој управљач-сесија сачувај: свој подаци-сесије.
		}.
		свој заглавља додај-на-крај: (
			HTTP-Заглавље нови
			кључ: ['Content-type'] вредност: тип
		).
		свој заглавља сваки: { :_ :заглавље
			Излаз пиши: заглавље.
		}.
		свој заглавља-послата := Тачно.
		Излаз пиши: ['\r\n'].
	}.
	Излаз пиши: излаз.
}.

Веб-документ на: ['заврши:тип:'] уради: { :излаз :тип
	свој заглавља-послата нетачно: {
		свој подаци-сесије Ништа? нетачно: {
			свој управљач-сесија сачувај: свој подаци-сесије.
		}.
		свој заглавља додај-на-крај: (
			HTTP-Заглавље нови
			кључ: ['Content-type'] вредност: тип
		).
		свој заглавља додај-на-крај: (
			HTTP-Заглавље нови
			кључ: ['Content-Length'] вредност: излаз текст bytes
		).
		свој заглавља сваки: { :_ :заглавље
			Излаз пиши: заглавље.
		}.
		свој заглавља-послата := Тачно.
		Излаз пиши: ['\r\n'].
	}.
	Излаз пиши: излаз.
}.

Веб-документ на: ['испиши:'] уради: { :излаз
	себе испиши: излаз тип: ['text/html; charset=utf-8'].
}.

Веб-документ на: ['заврши:'] уради: { :излаз
	себе заврши: излаз тип: ['text/html; charset=utf-8'].
}.

Веб-документ на: ['json:'] уради: { :излаз
	себе испиши: ( JSON jsonify: излаз ) тип: ['application/json'].
}.

Веб-документ на: ['није-пронађено:'] уради: { :излаз
	себе испразни-заглавља заглавље: (
		HTTP-Заглавље нови кључ: ['Status'] вредност: ['404 Not Found']
	).
	себе испиши: излаз.
}.


# Interface

>> Сесија := Објекат нови.

Сесија на: ['нови'] уради: { <- себе нови иницијализуј за: Ништа.
}.

Сесија на: ['за:'] уради: { :id
	свој id := id.
}.

Сесија на: ['учитај'] уради: {
	овај-задатак грешка: ['Not implemented.'].
}.

Сесија на: ['сачувај:'] уради: {
	овај-задатак грешка: ['Not implemented.'].
}.

Сесија на: ['уништи'] уради: {
	овај-задатак грешка: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сесија-привремена-датотека := Сесија нови.

Сесија-привремена-датотека на: ['иницијализуј'] уради: {
	свој почетак-путање := ['/tmp/sess-'].
}.

Сесија-привремена-датотека на: ['префикс-путање:'] уради: { :низ
	свој почетак-путање := низ.
}.

Сесија-привремена-датотека на: ['датотека'] уради: { <- ( Датотека нови: ( свој почетак-путање + свој id + ['.txt'] ) ).
}.

Сесија-привремена-датотека на: ['учитај'] уради: {
	>> датотека := себе датотека.
	датотека постоји нетачно: {
		датотека пиши: (Речник нови код).
	}. <- датотека читај објекат.
}.

Сесија-привремена-датотека на: ['сачувај:'] уради: { :подаци
	>> датотека := себе датотека.
	датотека постоји тачно: {
		датотека пиши: подаци код.
	}.
}.

Сесија-привремена-датотека на: ['уништи'] уради: {
	>> датотека := себе датотека.
	датотека постоји тачно: {
		датотека избриши.
	}.
}.


>> URL := Објекат нови.

URL на: ['иницијализуј'] уради: {
	свој протокол := ['https://'].
	свој домаћин := ['localhost'].
	свој путања := [''].
	свој параметри-url := [''].
	свој hash := [''].
}.

URL на: ['нови'] уради: { <- себе нови иницијализуј.
}.

URL на: ['текст'] уради: { <- (
	свој протокол +
	свој домаћин +
	свој путања +
	свој параметри-url +
	свој hash ).
}.

URL на: ['протокол:'] уради: { :протокол
	((Листа нови ; ['http'] ; ['https']) има: протокол) тачно: {
		свој протокол := протокол + ['://'].
	}, нетачно: {
		овај-задатак грешка: ['Invalid protocol'].
	}.
}.

URL на: ['домаћин:'] уради: { :домаћин
	#todo validate according to rfc
	свој домаћин := домаћин.
}.

URL на: ['путања:'] уради: { :путања
	свој путања := ['/'] + путања url-кодирај.
}.

URL на: ['параметри-url:'] уради: { :мапирање
	>> параметри-url := Листа нови.
	мапирање сваки: { :кључ :вредност
		параметри-url додај-на-крај: кључ текст url-кодирај + ['='] + вредност текст url-кодирај.
	}.
	свој параметри-url := ['?'] + ( параметри-url споји: ['&'] ).
}.

URL на: ['хеш:'] уради: { :hash
	свој hash := ['#'] + hash url-кодирај.
}.

