
# ~ Simple template engine ~

>> Шаблон := Објекат нови.

Шаблон на: ['нови'] уради: { <- себе нови садржај: [''].
}.

Шаблон на: ['садржај:'] уради: { :садржај
	свој садржај := садржај. 
}.

Шаблон на: ['нови:'] уради: { :садржај <- себе нови садржај: садржај.
}.

Шаблон на: ['исеци:'] уради: { :ознака
	>> почетна-ознака := (['<!-- cut:%id% -->'] %id%: ознака).
	>> завршна-ознака := (['<!-- /cut:%id% -->'] %id%: ознака).
	>> делови := свој садржај подели: почетна-ознака.
	>> префикс := делови први.
	>> делови2 := делови последњи подели: завршна-ознака.
	>> суфикс := делови2 последњи.
	>> део := делови2 први.
	>> остатак := префикс + суфикс.
	свој садржај := остатак. <- Шаблон нови: део.
	
}.

Шаблон на: ['копирај'] уради: { <- себе нови: себе текст копирај.
}.
	
Шаблон на: ['налепи:на:'] уради: { :исечак :id
	>> ознака-лепљења := (['<!-- paste:%id% -->'] %id%: id).
	свој садржај замени: ознака-лепљења са: ( исечак текст + ознака-лепљења ).
}.

Шаблон на: ['постави:вредност:'] уради: { :утор :вредност
	свој садржај замени: ['<!-- slot:'] + утор + [' -->'] са: ( Server html-кодирај: вредност ).
}.

Шаблон на: ['постави:html:'] уради: { :утор :html
	свој садржај замени: ['<!-- slot:'] + утор + [' -->'] са: html.
}.

Шаблон на: ['одговори:и:'] уради: { :утор :вредност
	себе постави: (утор од: 0 дужина: (утор дужина - 1)) вредност: вредност.
}.

Шаблон на: ['nl2br'] уради: {
	свој садржај замени: ['\n'] са: ['<br>'].
}.

Шаблон на: ['почисти'] уради: {
	свој садржај :=
		Образац
		нови: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		подударање: свој садржај
		уради: { <- ['']. }.
}.

Шаблон на: ['почисти-исечке'] уради: {
	>> ставке := Листа нови.
	Образац
	нови: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	подударање: свој садржај
	уради: { :_ :део
		ставке додај-на-крај: део ? 1.
	}.
	ставке сваки: { :_ :id
		свој садржај :=
			Образац нови: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			подударање: свој садржај
			уради: { <- ['']. }.
	 }.
}.

Шаблон на: ['почисти-размаке'] уради: {
	свој садржај :=
		Образац
		нови: ['\\s*\\n'],
		подударање: свој садржај
		уради: { <- ['\n']. }.
	свој садржај :=
		Образац
		нови: ['\\n[\\s\\t]+'],
		подударање: свој садржај
		уради: { <- ['\n']. }.
}.

Шаблон на: ['почисти-све'] уради: {
	себе почисти.
	себе почисти-исечке.
	себе почисти-размаке.
}.

Шаблон на: ['текст'] уради: { <- свој садржај.
}.
