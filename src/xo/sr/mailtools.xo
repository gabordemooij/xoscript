>> Имејл := Објекат нови.

Имејл на: ['иницијализуј'] уради: {
	свој примаоци := Листа нови.
	свој cc := Листа нови.
	свој bcc := Листа нови.
	свој пошиљалац := Ништа.
	свој име-пошиљаоца := Ништа.
	свој предмет := Ништа.
	свој тело := Ништа.
}.

Имејл на: ['нови'] уради: { <- себе нови иницијализуј.
}.

Имејл на: ['прима:'] уради: { :набрајање
	свој примаоци := набрајање.
}.
 
Имејл на: ['cc:'] уради: { :набрајање
	свој cc := набрајање.
}.

Имејл на: ['bcc:'] уради: { :набрајање
	свој bcc := набрајање.
}.

Имејл на: ['предмет:'] уради: { :предмет
	свој предмет := предмет.
}.

Имејл на: ['пошиљалац:назив:'] уради: { :пошиљалац :назив
	свој пошиљалац := пошиљалац.
	свој име-пошиљаоца := назив.
}.

Имејл на: ['тело:'] уради: { :тело
	свој тело := тело.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Имејл на: ['заглавље:'] уради: { :ред <- ред замени: ['\r'] са: [''], замени: ['\n'] са: [''].
}.

Имејл на: ['пошаљи'] уради: {
	>> f := Датотека tempwrite: себе генериши.
	Програм систем: ['sendmail -t < '] + f путања, нови-ред.
}.

Имејл на: ['генериши'] уради: {
	>> прелом := ['\r\n'].
	>> низ := [''].
	низ додај-на-крај: (себе заглавље: ['From: '] + свој име-пошиљаоца + [' <'] + ( свој пошиљалац ) + ['>']) + прелом.
	низ додај-на-крај: (себе заглавље: ['To: '] + ( свој примаоци споји: [','] )) + прелом.
	свој cc број-елемената тачно: {
		низ додај-на-крај: (себе заглавље: ['Cc: '] + ( свој cc споји: [','] )) + прелом.
	}.
	свој bcc број-елемената тачно: {
		низ додај-на-крај: (себе заглавље: ['Bcc: '] + ( свој bcc споји: [','] )) + прелом.
	}.
	низ додај-на-крај: (себе заглавље: ['Subject: '] + свој предмет) + прелом.
	низ додај-на-крај: прелом.
	низ додај-на-крај: свој тело.
	низ додај-на-крај: прелом. <- низ.
}.

>> HTML-Имејл := Имејл нови.

HTML-Имејл на: ['иницијализуј'] уради: {
	себе иницијализуј.
	свој прилози := Листа нови.
	свој граница := Сеф токен: 40.
}.

HTML-Имејл на: ['приложи:'] уради: { :датотека
	>> id := свој прилози број-елемената.
	>> blob := датотека blob.
	свој прилози додај-на-крај: (
		Речник нови
			датотека: датотека путања,
			mime: ['image/'] + (Server mimetype: датотека путања),
			подаци: blob base64-кодирај
	).
	blob ослободи. <- ['cid:attachment'] + id.
}.

HTML-Имејл на: ['генериши'] уради: {
	>> прелом := ['\r\n'].
	>> низ := [''].
	низ додај-на-крај: (себе заглавље: ['From: '] + свој име-пошиљаоца + [' <'] + ( свој пошиљалац ) + ['>']) + прелом.
	низ додај-на-крај: (себе заглавље: ['To: '] + ( свој примаоци споји: [','] )) + прелом.
	свој cc број-елемената тачно: {
		низ додај-на-крај: (себе заглавље: ['Cc: '] + ( свој cc споји: [','] )) + прелом.
	}.
	свој bcc број-елемената тачно: {
		низ додај-на-крај: (себе заглавље: ['Bcc: '] + ( свој bcc споји: [','] )) + прелом.
	}.
	низ додај-на-крај: (себе заглавље: ['Subject: '] + свој предмет) + прелом.
	низ додај-на-крај: ['MIME-Version: 1.0'] + прелом.
	низ додај-на-крај: ['Content-Type: multipart/related; boundary="'] + свој граница + ['"; type=text/html'] + прелом.
	низ додај-на-крај: прелом.
	низ додај-на-крај: ['--'] + свој граница + прелом.
	низ додај-на-крај: ['Content-Type: text/html; charset=UTF-8'] + прелом.
	низ додај-на-крај: ['Content-Transfer-Encoding: 7bit'] + прелом.
	низ додај-на-крај: прелом.
	низ додај-на-крај: свој тело.
	низ додај-на-крај: прелом.
	свој прилози сваки: { :id :инфо
		>> blob := инфо подаци.
		низ додај-на-крај: ['--'] + свој граница + прелом.
		низ додај-на-крај: ['Content-Type: '] + инфо mime + прелом.
		низ додај-на-крај: ['Content-Transfer-Encoding: base64'] + прелом.
		низ додај-на-крај: ['Content-ID: <attachment'] + id + ['>'] + прелом.
		низ додај-на-крај: ['Content-Disposition: inline; filename="'] + инфо датотека + ['"'] + прелом.
		низ додај-на-крај: прелом.
		>> највише := 76.
		>> дужина-текста := blob дужина.
		>> комади := (дужина-текста / највише) заокружи-нагоре.
		{ :i
			>> комад := blob копирај од: i * највише дужина: највише.
			низ додај-на-крај: комад + прелом.
		} * комади.
		низ додај-на-крај: прелом.
		низ додај-на-крај: прелом.
	}.
	низ додај-на-крај: ['--'] + свој граница + ['--'] + прелом. <- низ.
}.
