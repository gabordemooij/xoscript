>> Imeli := Mea fou.

Imeli pe-a-oo-mai: ['sauni'] fai: {
	lana-lava tagata-mauaina := Lisi fou.
	lana-lava cc := Lisi fou.
	lana-lava bcc := Lisi fou.
	lana-lava tagata-auina := Leai-se-mea.
	lana-lava igoa-auina := Leai-se-mea.
	lana-lava mataupu := Leai-se-mea.
	lana-lava tino := Leai-se-mea.
}.

Imeli pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou sauni.
}.

Imeli pe-a-oo-mai: ['ia-te:'] fai: { :lisi-mea
	lana-lava tagata-mauaina := lisi-mea.
}.
 
Imeli pe-a-oo-mai: ['cc:'] fai: { :lisi-mea
	lana-lava cc := lisi-mea.
}.

Imeli pe-a-oo-mai: ['bcc:'] fai: { :lisi-mea
	lana-lava bcc := lisi-mea.
}.

Imeli pe-a-oo-mai: ['mataupu:'] fai: { :mataupu
	lana-lava mataupu := mataupu.
}.

Imeli pe-a-oo-mai: ['tagata-auina:igoa:'] fai: { :tagata-auina :igoa
	lana-lava tagata-auina := tagata-auina.
	lana-lava igoa-auina := igoa.
}.

Imeli pe-a-oo-mai: ['tino:'] fai: { :tino
	lana-lava tino := tino.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeli pe-a-oo-mai: ['ulutala:'] fai: { :laina <- laina sui: ['\r'] i-le: [''], sui: ['\n'] i-le: [''].
}.

Imeli pe-a-oo-mai: ['auina'] fai: {
	>> f := Faila tempwrite: ia-lava fatu.
	Polokalama faiga-masini: ['sendmail -t < '] + f ala-faila, laina-fou.
}.

Imeli pe-a-oo-mai: ['fatu'] fai: {
	>> motu-laina := ['\r\n'].
	>> manoa-tusitusiga := [''].
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['From: '] + lana-lava igoa-auina + [' <'] + ( lana-lava tagata-auina ) + ['>']) + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['To: '] + ( lana-lava tagata-mauaina tuufaatasi: [','] )) + motu-laina.
	lana-lava cc aofaiga moni: {
		manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Cc: '] + ( lana-lava cc tuufaatasi: [','] )) + motu-laina.
	}.
	lana-lava bcc aofaiga moni: {
		manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Bcc: '] + ( lana-lava bcc tuufaatasi: [','] )) + motu-laina.
	}.
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Subject: '] + lana-lava mataupu) + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: lana-lava tino.
	manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina. <- manoa-tusitusiga.
}.

>> Imeli-HTML := Imeli fou.

Imeli-HTML pe-a-oo-mai: ['sauni'] fai: {
	ia-lava sauni.
	lana-lava mea-faapipii := Lisi fou.
	lana-lava tuaoi := Pusa-malu token: 40.
}.

Imeli-HTML pe-a-oo-mai: ['faapipii:'] fai: { :faila-sauniga
	>> id := lana-lava mea-faapipii aofaiga.
	>> blob := faila-sauniga blob.
	lana-lava mea-faapipii faaopoopo-i-le-iuga: (
		Lomifefiloi fou
			faila-sauniga: faila-sauniga ala-faila,
			mime: ['image/'] + (Server mimetype: faila-sauniga ala-faila),
			faamatalaga: blob base64-faʻailoga-numera
	).
	blob faasaoloto. <- ['cid:attachment'] + id.
}.

Imeli-HTML pe-a-oo-mai: ['fatu'] fai: {
	>> motu-laina := ['\r\n'].
	>> manoa-tusitusiga := [''].
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['From: '] + lana-lava igoa-auina + [' <'] + ( lana-lava tagata-auina ) + ['>']) + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['To: '] + ( lana-lava tagata-mauaina tuufaatasi: [','] )) + motu-laina.
	lana-lava cc aofaiga moni: {
		manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Cc: '] + ( lana-lava cc tuufaatasi: [','] )) + motu-laina.
	}.
	lana-lava bcc aofaiga moni: {
		manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Bcc: '] + ( lana-lava bcc tuufaatasi: [','] )) + motu-laina.
	}.
	manoa-tusitusiga faaopoopo-i-le-iuga: (ia-lava ulutala: ['Subject: '] + lana-lava mataupu) + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['MIME-Version: 1.0'] + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Type: multipart/related; boundary="'] + lana-lava tuaoi + ['"; type=text/html'] + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['--'] + lana-lava tuaoi + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Type: text/html; charset=UTF-8'] + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Transfer-Encoding: 7bit'] + motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
	manoa-tusitusiga faaopoopo-i-le-iuga: lana-lava tino.
	manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
	lana-lava mea-faapipii taʻitasi: { :id :faamatalaga-puupuu
		>> blob := faamatalaga-puupuu faamatalaga.
		manoa-tusitusiga faaopoopo-i-le-iuga: ['--'] + lana-lava tuaoi + motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Type: '] + faamatalaga-puupuu mime + motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Transfer-Encoding: base64'] + motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-ID: <attachment'] + id + ['>'] + motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: ['Content-Disposition: inline; filename="'] + faamatalaga-puupuu faila-sauniga + ['"'] + motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
		>> aupito-tele := 76.
		>> umi-tusitusiga := blob umi.
		>> fasi-fasi := (umi-tusitusiga / aupito-tele) faʻasili-numera.
		{ :i
			>> fasi := blob kopi-mea amata: i * aupito-tele umi: aupito-tele.
			manoa-tusitusiga faaopoopo-i-le-iuga: fasi + motu-laina.
		} * fasi-fasi.
		manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
		manoa-tusitusiga faaopoopo-i-le-iuga: motu-laina.
	}.
	manoa-tusitusiga faaopoopo-i-le-iuga: ['--'] + lana-lava tuaoi + ['--'] + motu-laina. <- manoa-tusitusiga.
}.
