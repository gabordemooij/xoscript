
# ~ Simple template engine ~

>> Mamanu-itulau := Mea fou.

Mamanu-itulau pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou anotusi: [''].
}.

Mamanu-itulau pe-a-oo-mai: ['anotusi:'] fai: { :anotusi
	lana-lava anotusi := anotusi. 
}.

Mamanu-itulau pe-a-oo-mai: ['fou:'] fai: { :anotusi <- ia-lava fou anotusi: anotusi.
}.

Mamanu-itulau pe-a-oo-mai: ['tipi:'] fai: { :faailoga
	>> faailoga-amata := (['<!-- cut:%id% -->'] %id%: faailoga).
	>> faailoga-faaiu := (['<!-- /cut:%id% -->'] %id%: faailoga).
	>> vaega-uma := lana-lava anotusi vaevae: faailoga-amata.
	>> muai := vaega-uma tulaga-tasi.
	>> vaega-uma2 := vaega-uma mulimuli vaevae: faailoga-faaiu.
	>> muli := vaega-uma2 mulimuli.
	>> vaega := vaega-uma2 tulaga-tasi.
	>> totoe := muai + muli.
	lana-lava anotusi := totoe. <- Mamanu-itulau fou: vaega.
	
}.

Mamanu-itulau pe-a-oo-mai: ['kopi-mea'] fai: { <- ia-lava fou: ia-lava manoa kopi-mea.
}.
	
Mamanu-itulau pe-a-oo-mai: ['faapipii-i:i:'] fai: { :vaega-laitiiti :id
	>> faailoga-faapipii := (['<!-- paste:%id% -->'] %id%: id).
	lana-lava anotusi sui: faailoga-faapipii i-le: ( vaega-laitiiti manoa + faailoga-faapipii ).
}.

Mamanu-itulau pe-a-oo-mai: ['seti:tau:'] fai: { :nofoaga :tau
	lana-lava anotusi sui: ['<!-- slot:'] + nofoaga + [' -->'] i-le: ( Server html-faʻailoga-numera: tau ).
}.

Mamanu-itulau pe-a-oo-mai: ['seti:html:'] fai: { :nofoaga :html
	lana-lava anotusi sui: ['<!-- slot:'] + nofoaga + [' -->'] i-le: html.
}.

Mamanu-itulau pe-a-oo-mai: ['tali-atu:ma:'] fai: { :nofoaga :tau
	ia-lava seti: (nofoaga amata: 0 umi: (nofoaga umi - 1)) tau: tau.
}.

Mamanu-itulau pe-a-oo-mai: ['nl2br'] fai: {
	lana-lava anotusi sui: ['\n'] i-le: ['<br>'].
}.

Mamanu-itulau pe-a-oo-mai: ['faamaopoopo'] fai: {
	lana-lava anotusi :=
		Mamanu
		fou: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		fetaui: lana-lava anotusi
		fai: { <- ['']. }.
}.

Mamanu-itulau pe-a-oo-mai: ['faamaopoopo-tipi'] fai: {
	>> mea-eseese := Lisi fou.
	Mamanu
	fou: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	fetaui: lana-lava anotusi
	fai: { :_ :vaega
		mea-eseese faaopoopo-i-le-iuga: vaega ? 1.
	}.
	mea-eseese taʻitasi: { :_ :id
		lana-lava anotusi :=
			Mamanu fou: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			fetaui: lana-lava anotusi
			fai: { <- ['']. }.
	 }.
}.

Mamanu-itulau pe-a-oo-mai: ['faamaopoopo-avanoa'] fai: {
	lana-lava anotusi :=
		Mamanu
		fou: ['\\s*\\n'],
		fetaui: lana-lava anotusi
		fai: { <- ['\n']. }.
	lana-lava anotusi :=
		Mamanu
		fou: ['\\n[\\s\\t]+'],
		fetaui: lana-lava anotusi
		fai: { <- ['\n']. }.
}.

Mamanu-itulau pe-a-oo-mai: ['faamaopoopo-uma'] fai: {
	ia-lava faamaopoopo.
	ia-lava faamaopoopo-tipi.
	ia-lava faamaopoopo-avanoa.
}.

Mamanu-itulau pe-a-oo-mai: ['manoa'] fai: { <- lana-lava anotusi.
}.
