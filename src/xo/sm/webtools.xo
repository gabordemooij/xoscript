Talosaga-HTTP pe-a-oo-mai: ['HTTP-ulutala:'] fai: { :ki-tatala <- Polokalama faatulagaga-masini: ki-tatala.
}.

>> Ulutala-HTTP := Mea fou.

Ulutala-HTTP pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou sauni.
}.

Ulutala-HTTP pe-a-oo-mai: ['sauni'] fai: {
	lana-lava ki-tatala := Leai-se-mea.
	lana-lava tau := Leai-se-mea.
}.

Ulutala-HTTP pe-a-oo-mai: ['ki-tatala:tau:'] fai: { :ki-tatala :tau
	lana-lava ki-tatala := ki-tatala.
	lana-lava tau := tau.
}.

Ulutala-HTTP pe-a-oo-mai: ['ki-tatala'] fai: { <- lana-lava ki-tatala.
}.

Ulutala-HTTP pe-a-oo-mai: ['tau'] fai: { <- lana-lava tau.
}.


Ulutala-HTTP pe-a-oo-mai: ['manoa'] fai: {
	>> laina := lana-lava ki-tatala + [': '] + lana-lava tau.
	laina sui: ['\r'] i-le: [''], sui: ['\n'] i-le: ['']. <- laina + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Pepa-Upega := Mea fou.

Pepa-Upega pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou sauni.
}.

Pepa-Upega pe-a-oo-mai: ['sauni'] fai: {
	lana-lava ulutala-uma := Lisi fou.
	lana-lava id-sauniga := Leai-se-mea.
	lana-lava pule-sauniga := Sauniga-faila-le-tumau fou.
	lana-lava faamatalaga-sauniga := Leai-se-mea.
	lana-lava saogalemu := Moni.
	lana-lava lea-lava-saite := ['Strict'].
	lana-lava ulutala-ua-auina := Sese.
	lana-lava talosaga-http := Talosaga-HTTP fou.
}.

Pepa-Upega pe-a-oo-mai: ['talosaga-http:'] fai: { :talosaga-http
	lana-lava talosaga-http := talosaga-http.
}. 

Pepa-Upega pe-a-oo-mai: ['kuki-sauniga-saogalemu:'] fai: { :saogalemu
	ia-lava siaki-ulutala.
	lana-lava saogalemu := saogalemu.
}.

Pepa-Upega pe-a-oo-mai: ['kuki-sauniga-lea-lava-saite:'] fai: { :tau
	ia-lava siaki-ulutala.
	>> filifiliga := Lisi fou 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	filifiliga o-i-ai: tau, sese: {
		lenei-galuega mea-sese: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	lana-lava lea-lava-saite := tau.
}.

Pepa-Upega pe-a-oo-mai: ['ulutala:'] fai: { :ulutala
	ia-lava siaki-ulutala.
	lana-lava ulutala-uma faaopoopo-i-le-iuga: ulutala.
}.

Pepa-Upega pe-a-oo-mai: ['faagaogao-ulutala'] fai: {
	ia-lava siaki-ulutala.
	lana-lava ulutala-uma := Lisi fou.
}.

Pepa-Upega pe-a-oo-mai: ['pule-sauniga:'] fai: { :pule
	ia-lava siaki-ulutala.
	lana-lava pule-sauniga := pule.
}.

Pepa-Upega pe-a-oo-mai: ['pule-sauniga'] fai: { <- lana-lava pule-sauniga.
}.

Pepa-Upega pe-a-oo-mai: ['siaki-ulutala'] fai: {
	lana-lava ulutala-ua-auina moni: {
		lenei-galuega mea-sese: ['Headers already sent to client.'].
	}.
}.

Pepa-Upega pe-a-oo-mai: ['amata-sauniga'] fai: {
	ia-lava siaki-ulutala.
	>> talosaga-http := lana-lava talosaga-http.
	>> id-sauniga := talosaga-http cookie: ['xsid'].
	id-sauniga Leai-se-mea? sese: {
		(( Mamanu fou: ['^[A-Za-z0-9]+\\z'], fetaui: id-sauniga ) = 0) moni: {
			id-sauniga := Leai-se-mea.
		}.
	}.
	id-sauniga Leai-se-mea? moni: {
		id-sauniga := Pusa-malu token: 30.
		>> ulutala-sauniga := Ulutala-HTTP fou
		ki-tatala: ['Set-Cookie'] tau: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (lana-lava saogalemu lenei: ['Secure'] po-o-lena: ['']),
		SSITE: (lana-lava lea-lava-saite),
		XSID: id-sauniga
		).
		lana-lava ulutala-uma faaopoopo-i-le-iuga: ulutala-sauniga.
	}.
	lana-lava faamatalaga-sauniga := lana-lava pule-sauniga mo: id-sauniga, utaina. <- lana-lava faamatalaga-sauniga. # reference
}.

Pepa-Upega pe-a-oo-mai: ['alu-i:'] fai: { :tuatusi
	ia-lava siaki-ulutala.
	ia-lava faagaogao-ulutala.
	lana-lava ulutala-uma
	faaopoopo-i-le-iuga: (
		Ulutala-HTTP fou
		ki-tatala: ['Status'] tau: ['303 See Other']
	),
	faaopoopo-i-le-iuga: (
		Ulutala-HTTP fou
		ki-tatala: ['Location'] tau: tuatusi
	).
	ia-lava faaali: ['Redirect'].
}.

Pepa-Upega pe-a-oo-mai: ['faaumatia-sauniga'] fai: {
	ia-lava siaki-ulutala.
	>> talosaga-http := lana-lava talosaga-http.
	>> id-sauniga := talosaga-http cookie: ['xsid'].
	id-sauniga Leai-se-mea? sese: {
		>> ulutala-sauniga := Ulutala-HTTP fou.
		>> taimi-uma := Taimi fou tausaga: 1970, faatulagaga: ['%a, %d %b %Y %H:%M:%S GMT'].
		ulutala-sauniga ki-tatala: ['Set-Cookie'] tau: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: taimi-uma,
			SEC: (lana-lava saogalemu lenei: ['Secure'] po-o-lena: ['']),
			SSITE: (lana-lava lea-lava-saite),
			XSID: id-sauniga
		).
		lana-lava pule-sauniga faaumatia.
		lana-lava ulutala-uma faaopoopo-i-le-iuga: ulutala-sauniga.
	}.
}.


Pepa-Upega pe-a-oo-mai: ['mamanu-itulau:'] fai: { :ala-faila <- Mamanu-itulau fou: (Faila fou: ala-faila, faitau).
}.

Pepa-Upega pe-a-oo-mai: ['faaali:ituaiga:'] fai: { :taunuuga :ituaiga
	lana-lava ulutala-ua-auina sese: {
		lana-lava faamatalaga-sauniga Leai-se-mea? sese: {
			lana-lava pule-sauniga teu: lana-lava faamatalaga-sauniga.
		}.
		lana-lava ulutala-uma faaopoopo-i-le-iuga: (
			Ulutala-HTTP fou
			ki-tatala: ['Content-type'] tau: ituaiga
		).
		lana-lava ulutala-uma taʻitasi: { :_ :ulutala
			Tuuina-atu tusi: ulutala.
		}.
		lana-lava ulutala-ua-auina := Moni.
		Tuuina-atu tusi: ['\r\n'].
	}.
	Tuuina-atu tusi: taunuuga.
}.

Pepa-Upega pe-a-oo-mai: ['faauma:ituaiga:'] fai: { :taunuuga :ituaiga
	lana-lava ulutala-ua-auina sese: {
		lana-lava faamatalaga-sauniga Leai-se-mea? sese: {
			lana-lava pule-sauniga teu: lana-lava faamatalaga-sauniga.
		}.
		lana-lava ulutala-uma faaopoopo-i-le-iuga: (
			Ulutala-HTTP fou
			ki-tatala: ['Content-type'] tau: ituaiga
		).
		lana-lava ulutala-uma faaopoopo-i-le-iuga: (
			Ulutala-HTTP fou
			ki-tatala: ['Content-Length'] tau: taunuuga manoa bytes
		).
		lana-lava ulutala-uma taʻitasi: { :_ :ulutala
			Tuuina-atu tusi: ulutala.
		}.
		lana-lava ulutala-ua-auina := Moni.
		Tuuina-atu tusi: ['\r\n'].
	}.
	Tuuina-atu tusi: taunuuga.
}.

Pepa-Upega pe-a-oo-mai: ['faaali:'] fai: { :taunuuga
	ia-lava faaali: taunuuga ituaiga: ['text/html; charset=utf-8'].
}.

Pepa-Upega pe-a-oo-mai: ['faauma:'] fai: { :taunuuga
	ia-lava faauma: taunuuga ituaiga: ['text/html; charset=utf-8'].
}.

Pepa-Upega pe-a-oo-mai: ['json:'] fai: { :taunuuga
	ia-lava faaali: ( JSON jsonify: taunuuga ) ituaiga: ['application/json'].
}.

Pepa-Upega pe-a-oo-mai: ['le-maua:'] fai: { :taunuuga
	ia-lava faagaogao-ulutala ulutala: (
		Ulutala-HTTP fou ki-tatala: ['Status'] tau: ['404 Not Found']
	).
	ia-lava faaali: taunuuga.
}.


# Interface

>> Sauniga := Mea fou.

Sauniga pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou sauni mo: Leai-se-mea.
}.

Sauniga pe-a-oo-mai: ['mo:'] fai: { :id
	lana-lava id := id.
}.

Sauniga pe-a-oo-mai: ['utaina'] fai: {
	lenei-galuega mea-sese: ['Not implemented.'].
}.

Sauniga pe-a-oo-mai: ['teu:'] fai: {
	lenei-galuega mea-sese: ['Not implemented.'].
}.

Sauniga pe-a-oo-mai: ['faaumatia'] fai: {
	lenei-galuega mea-sese: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sauniga-faila-le-tumau := Sauniga fou.

Sauniga-faila-le-tumau pe-a-oo-mai: ['sauni'] fai: {
	lana-lava amataga-ala := ['/tmp/sess-'].
}.

Sauniga-faila-le-tumau pe-a-oo-mai: ['muai-ala:'] fai: { :manoa-tusitusiga
	lana-lava amataga-ala := manoa-tusitusiga.
}.

Sauniga-faila-le-tumau pe-a-oo-mai: ['faila-sauniga'] fai: { <- ( Faila fou: ( lana-lava amataga-ala + lana-lava id + ['.txt'] ) ).
}.

Sauniga-faila-le-tumau pe-a-oo-mai: ['utaina'] fai: {
	>> faila-sauniga := ia-lava faila-sauniga.
	faila-sauniga o-loʻo-i-ai sese: {
		faila-sauniga tusi: (Lomifefiloi fou faʻailoga).
	}. <- faila-sauniga faitau mea.
}.

Sauniga-faila-le-tumau pe-a-oo-mai: ['teu:'] fai: { :faamatalaga
	>> faila-sauniga := ia-lava faila-sauniga.
	faila-sauniga o-loʻo-i-ai moni: {
		faila-sauniga tusi: faamatalaga faʻailoga.
	}.
}.

Sauniga-faila-le-tumau pe-a-oo-mai: ['faaumatia'] fai: {
	>> faila-sauniga := ia-lava faila-sauniga.
	faila-sauniga o-loʻo-i-ai moni: {
		faila-sauniga tape.
	}.
}.


>> URL := Mea fou.

URL pe-a-oo-mai: ['sauni'] fai: {
	lana-lava tulafono-fesootai := ['https://'].
	lana-lava talimalo := ['localhost'].
	lana-lava ala-faila := [''].
	lana-lava tapulaa-url := [''].
	lana-lava hash := [''].
}.

URL pe-a-oo-mai: ['fou'] fai: { <- ia-lava fou sauni.
}.

URL pe-a-oo-mai: ['manoa'] fai: { <- (
	lana-lava tulafono-fesootai +
	lana-lava talimalo +
	lana-lava ala-faila +
	lana-lava tapulaa-url +
	lana-lava hash ).
}.

URL pe-a-oo-mai: ['tulafono-fesootai:'] fai: { :tulafono-fesootai
	((Lisi fou ; ['http'] ; ['https']) o-i-ai: tulafono-fesootai) moni: {
		lana-lava tulafono-fesootai := tulafono-fesootai + ['://'].
	}, sese: {
		lenei-galuega mea-sese: ['Invalid protocol'].
	}.
}.

URL pe-a-oo-mai: ['talimalo:'] fai: { :talimalo
	#todo validate according to rfc
	lana-lava talimalo := talimalo.
}.

URL pe-a-oo-mai: ['ala-faila:'] fai: { :ala-faila
	lana-lava ala-faila := ['/'] + ala-faila url-faʻailoga-numera.
}.

URL pe-a-oo-mai: ['tapulaa-url:'] fai: { :faafanua
	>> tapulaa-url := Lisi fou.
	faafanua taʻitasi: { :ki-tatala :tau
		tapulaa-url faaopoopo-i-le-iuga: ki-tatala manoa url-faʻailoga-numera + ['='] + tau manoa url-faʻailoga-numera.
	}.
	lana-lava tapulaa-url := ['?'] + ( tapulaa-url tuufaatasi: ['&'] ).
}.

URL pe-a-oo-mai: ['hash:'] fai: { :hash
	lana-lava hash := ['#'] + hash url-faʻailoga-numera.
}.

