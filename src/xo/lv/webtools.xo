HTTP-Pieprasījums kad: ['HTTP-galvene:'] darīt: { :atslēga <- Programma iestatījums: atslēga.
}.

>> HTTP-Galvene := Objekts jauns.

HTTP-Galvene kad: ['jauns'] darīt: { <- pats jauns inicializēt.
}.

HTTP-Galvene kad: ['inicializēt'] darīt: {
	savs atslēga := Nekas.
	savs vērtība := Nekas.
}.

HTTP-Galvene kad: ['atslēga:vērtība:'] darīt: { :atslēga :vērtība
	savs atslēga := atslēga.
	savs vērtība := vērtība.
}.

HTTP-Galvene kad: ['atslēga'] darīt: { <- savs atslēga.
}.

HTTP-Galvene kad: ['vērtība'] darīt: { <- savs vērtība.
}.


HTTP-Galvene kad: ['teksts'] darīt: {
	>> rinda := savs atslēga + [': '] + savs vērtība.
	rinda aizstāt: ['\r'] ar: [''], aizstāt: ['\n'] ar: ['']. <- rinda + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Tīmekļa-dokuments := Objekts jauns.

Tīmekļa-dokuments kad: ['jauns'] darīt: { <- pats jauns inicializēt.
}.

Tīmekļa-dokuments kad: ['inicializēt'] darīt: {
	savs galvenes := Saraksts jauns.
	savs sesijas-id := Nekas.
	savs sesiju-pārvaldnieks := Pagaidu-faila-sesija jauns.
	savs sesijas-dati := Nekas.
	savs droša := Patiess.
	savs tā-pati-vietne := ['Strict'].
	savs galvenes-nosūtītas := Aplams.
	savs pieprasījums := HTTP-Pieprasījums jauns.
}.

Tīmekļa-dokuments kad: ['pieprasījums:'] darīt: { :pieprasījums
	savs pieprasījums := pieprasījums.
}. 

Tīmekļa-dokuments kad: ['droša-sesijas-sīkdatne:'] darīt: { :droša
	pats pārbaudīt-galvenes.
	savs droša := droša.
}.

Tīmekļa-dokuments kad: ['sesijas-sīkdatne-tā-pati-vietne:'] darīt: { :vērtība
	pats pārbaudīt-galvenes.
	>> opcijas := Saraksts jauns 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcijas ietver: vērtība, aplams: {
		šis-uzdevums kļūda: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	savs tā-pati-vietne := vērtība.
}.

Tīmekļa-dokuments kad: ['galvene:'] darīt: { :galvene
	pats pārbaudīt-galvenes.
	savs galvenes pievienot-beigās: galvene.
}.

Tīmekļa-dokuments kad: ['notīrīt-galvenes'] darīt: {
	pats pārbaudīt-galvenes.
	savs galvenes := Saraksts jauns.
}.

Tīmekļa-dokuments kad: ['sesiju-pārvaldnieks:'] darīt: { :pārvaldnieks
	pats pārbaudīt-galvenes.
	savs sesiju-pārvaldnieks := pārvaldnieks.
}.

Tīmekļa-dokuments kad: ['sesiju-pārvaldnieks'] darīt: { <- savs sesiju-pārvaldnieks.
}.

Tīmekļa-dokuments kad: ['pārbaudīt-galvenes'] darīt: {
	savs galvenes-nosūtītas patiess: {
		šis-uzdevums kļūda: ['Headers already sent to client.'].
	}.
}.

Tīmekļa-dokuments kad: ['sākt-sesiju'] darīt: {
	pats pārbaudīt-galvenes.
	>> pieprasījums := savs pieprasījums.
	>> sesijas-id := pieprasījums cookie: ['xsid'].
	sesijas-id Nekas? aplams: {
		(( Šablons jauns: ['^[A-Za-z0-9]+\\z'], atbilstība: sesijas-id ) = 0) patiess: {
			sesijas-id := Nekas.
		}.
	}.
	sesijas-id Nekas? patiess: {
		sesijas-id := Seifs marķieris: 30.
		>> sesijas-galvene := HTTP-Galvene jauns
		atslēga: ['Set-Cookie'] vērtība: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (savs droša vai: ['Secure'] vai: ['']),
		SSITE: (savs tā-pati-vietne),
		XSID: sesijas-id
		).
		savs galvenes pievienot-beigās: sesijas-galvene.
	}.
	savs sesijas-dati := savs sesiju-pārvaldnieks priekš: sesijas-id, ielādēt. <- savs sesijas-dati. # reference
}.

Tīmekļa-dokuments kad: ['doties-uz:'] darīt: { :adrese
	pats pārbaudīt-galvenes.
	pats notīrīt-galvenes.
	savs galvenes
	pievienot-beigās: (
		HTTP-Galvene jauns
		atslēga: ['Status'] vērtība: ['303 See Other']
	),
	pievienot-beigās: (
		HTTP-Galvene jauns
		atslēga: ['Location'] vērtība: adrese
	).
	pats izvadīt: ['Redirect'].
}.

Tīmekļa-dokuments kad: ['iznīcināt-sesiju'] darīt: {
	pats pārbaudīt-galvenes.
	>> pieprasījums := savs pieprasījums.
	>> sesijas-id := pieprasījums cookie: ['xsid'].
	sesijas-id Nekas? aplams: {
		>> sesijas-galvene := HTTP-Galvene jauns.
		>> brīdis := Brīdis jauns gads: 1970, formāts: ['%a, %d %b %Y %H:%M:%S GMT'].
		sesijas-galvene atslēga: ['Set-Cookie'] vērtība: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: brīdis,
			SEC: (savs droša vai: ['Secure'] vai: ['']),
			SSITE: (savs tā-pati-vietne),
			XSID: sesijas-id
		).
		savs sesiju-pārvaldnieks iznīcināt.
		savs galvenes pievienot-beigās: sesijas-galvene.
	}.
}.


Tīmekļa-dokuments kad: ['veidne:'] darīt: { :ceļš <- Veidne jauns: (Fails jauns: ceļš, lasīt).
}.

Tīmekļa-dokuments kad: ['izvadīt:tips:'] darīt: { :izvade :tips
	savs galvenes-nosūtītas aplams: {
		savs sesijas-dati Nekas? aplams: {
			savs sesiju-pārvaldnieks saglabāt: savs sesijas-dati.
		}.
		savs galvenes pievienot-beigās: (
			HTTP-Galvene jauns
			atslēga: ['Content-type'] vērtība: tips
		).
		savs galvenes katrs: { :_ :galvene
			Izvade rakstīt: galvene.
		}.
		savs galvenes-nosūtītas := Patiess.
		Izvade rakstīt: ['\r\n'].
	}.
	Izvade rakstīt: izvade.
}.

Tīmekļa-dokuments kad: ['pabeigt:tips:'] darīt: { :izvade :tips
	savs galvenes-nosūtītas aplams: {
		savs sesijas-dati Nekas? aplams: {
			savs sesiju-pārvaldnieks saglabāt: savs sesijas-dati.
		}.
		savs galvenes pievienot-beigās: (
			HTTP-Galvene jauns
			atslēga: ['Content-type'] vērtība: tips
		).
		savs galvenes pievienot-beigās: (
			HTTP-Galvene jauns
			atslēga: ['Content-Length'] vērtība: izvade teksts bytes
		).
		savs galvenes katrs: { :_ :galvene
			Izvade rakstīt: galvene.
		}.
		savs galvenes-nosūtītas := Patiess.
		Izvade rakstīt: ['\r\n'].
	}.
	Izvade rakstīt: izvade.
}.

Tīmekļa-dokuments kad: ['izvadīt:'] darīt: { :izvade
	pats izvadīt: izvade tips: ['text/html; charset=utf-8'].
}.

Tīmekļa-dokuments kad: ['pabeigt:'] darīt: { :izvade
	pats pabeigt: izvade tips: ['text/html; charset=utf-8'].
}.

Tīmekļa-dokuments kad: ['json:'] darīt: { :izvade
	pats izvadīt: ( JSON jsonify: izvade ) tips: ['application/json'].
}.

Tīmekļa-dokuments kad: ['nav-atrasts:'] darīt: { :izvade
	pats notīrīt-galvenes galvene: (
		HTTP-Galvene jauns atslēga: ['Status'] vērtība: ['404 Not Found']
	).
	pats izvadīt: izvade.
}.


# Interface

>> Sesija := Objekts jauns.

Sesija kad: ['jauns'] darīt: { <- pats jauns inicializēt priekš: Nekas.
}.

Sesija kad: ['priekš:'] darīt: { :id
	savs id := id.
}.

Sesija kad: ['ielādēt'] darīt: {
	šis-uzdevums kļūda: ['Not implemented.'].
}.

Sesija kad: ['saglabāt:'] darīt: {
	šis-uzdevums kļūda: ['Not implemented.'].
}.

Sesija kad: ['iznīcināt'] darīt: {
	šis-uzdevums kļūda: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Pagaidu-faila-sesija := Sesija jauns.

Pagaidu-faila-sesija kad: ['inicializēt'] darīt: {
	savs ceļa-sākums := ['/tmp/sess-'].
}.

Pagaidu-faila-sesija kad: ['ceļa-prefikss:'] darīt: { :virkne
	savs ceļa-sākums := virkne.
}.

Pagaidu-faila-sesija kad: ['fails'] darīt: { <- ( Fails jauns: ( savs ceļa-sākums + savs id + ['.txt'] ) ).
}.

Pagaidu-faila-sesija kad: ['ielādēt'] darīt: {
	>> fails := pats fails.
	fails pastāv aplams: {
		fails rakstīt: (Vārdnīca jauns kods).
	}. <- fails lasīt objekts.
}.

Pagaidu-faila-sesija kad: ['saglabāt:'] darīt: { :dati
	>> fails := pats fails.
	fails pastāv patiess: {
		fails rakstīt: dati kods.
	}.
}.

Pagaidu-faila-sesija kad: ['iznīcināt'] darīt: {
	>> fails := pats fails.
	fails pastāv patiess: {
		fails dzēst.
	}.
}.


>> URL := Objekts jauns.

URL kad: ['inicializēt'] darīt: {
	savs protokols := ['https://'].
	savs resursdators := ['localhost'].
	savs ceļš := [''].
	savs url-parametri := [''].
	savs hash := [''].
}.

URL kad: ['jauns'] darīt: { <- pats jauns inicializēt.
}.

URL kad: ['teksts'] darīt: { <- (
	savs protokols +
	savs resursdators +
	savs ceļš +
	savs url-parametri +
	savs hash ).
}.

URL kad: ['protokols:'] darīt: { :protokols
	((Saraksts jauns ; ['http'] ; ['https']) ietver: protokols) patiess: {
		savs protokols := protokols + ['://'].
	}, aplams: {
		šis-uzdevums kļūda: ['Invalid protocol'].
	}.
}.

URL kad: ['resursdators:'] darīt: { :resursdators
	#todo validate according to rfc
	savs resursdators := resursdators.
}.

URL kad: ['ceļš:'] darīt: { :ceļš
	savs ceļš := ['/'] + ceļš url-kodēt.
}.

URL kad: ['url-parametri:'] darīt: { :kartējums
	>> url-parametri := Saraksts jauns.
	kartējums katrs: { :atslēga :vērtība
		url-parametri pievienot-beigās: atslēga teksts url-kodēt + ['='] + vērtība teksts url-kodēt.
	}.
	savs url-parametri := ['?'] + ( url-parametri apvienot: ['&'] ).
}.

URL kad: ['jaucējvērtība:'] darīt: { :hash
	savs hash := ['#'] + hash url-kodēt.
}.

