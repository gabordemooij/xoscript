
# ~ Simple template engine ~

>> Veidne := Objekts jauns.

Veidne kad: ['jauns'] darīt: { <- pats jauns saturs: [''].
}.

Veidne kad: ['saturs:'] darīt: { :saturs
	savs saturs := saturs. 
}.

Veidne kad: ['jauns:'] darīt: { :saturs <- pats jauns saturs: saturs.
}.

Veidne kad: ['izgriezt:'] darīt: { :marķieris
	>> sākuma-marķieris := (['<!-- cut:%id% -->'] %id%: marķieris).
	>> beigu-marķieris := (['<!-- /cut:%id% -->'] %id%: marķieris).
	>> daļas := savs saturs sadalīt: sākuma-marķieris.
	>> prefikss := daļas pirmais.
	>> daļas2 := daļas pēdējais sadalīt: beigu-marķieris.
	>> sufikss := daļas2 pēdējais.
	>> daļa := daļas2 pirmais.
	>> atlikums := prefikss + sufikss.
	savs saturs := atlikums. <- Veidne jauns: daļa.
	
}.

Veidne kad: ['kopēt'] darīt: { <- pats jauns: pats teksts kopēt.
}.
	
Veidne kad: ['ielīmēt:pie:'] darīt: { :fragments-html :id
	>> ielīmēšanas-marķieris := (['<!-- paste:%id% -->'] %id%: id).
	savs saturs aizstāt: ielīmēšanas-marķieris ar: ( fragments-html teksts + ielīmēšanas-marķieris ).
}.

Veidne kad: ['iestatīt:vērtība:'] darīt: { :vieta :vērtība
	savs saturs aizstāt: ['<!-- slot:'] + vieta + [' -->'] ar: ( Server html-kodēt: vērtība ).
}.

Veidne kad: ['iestatīt:html:'] darīt: { :vieta :html
	savs saturs aizstāt: ['<!-- slot:'] + vieta + [' -->'] ar: html.
}.

Veidne kad: ['atbildēt:un:'] darīt: { :vieta :vērtība
	pats iestatīt: (vieta no: 0 garums: (vieta garums - 1)) vērtība: vērtība.
}.

Veidne kad: ['nl2br'] darīt: {
	savs saturs aizstāt: ['\n'] ar: ['<br>'].
}.

Veidne kad: ['sakopt'] darīt: {
	savs saturs :=
		Šablons
		jauns: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		atbilstība: savs saturs
		darīt: { <- ['']. }.
}.

Veidne kad: ['sakopt-izgriezumus'] darīt: {
	>> vienumi := Saraksts jauns.
	Šablons
	jauns: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	atbilstība: savs saturs
	darīt: { :_ :daļa
		vienumi pievienot-beigās: daļa ? 1.
	}.
	vienumi katrs: { :_ :id
		savs saturs :=
			Šablons jauns: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			atbilstība: savs saturs
			darīt: { <- ['']. }.
	 }.
}.

Veidne kad: ['sakopt-atstarpes'] darīt: {
	savs saturs :=
		Šablons
		jauns: ['\\s*\\n'],
		atbilstība: savs saturs
		darīt: { <- ['\n']. }.
	savs saturs :=
		Šablons
		jauns: ['\\n[\\s\\t]+'],
		atbilstība: savs saturs
		darīt: { <- ['\n']. }.
}.

Veidne kad: ['sakopt-visu'] darīt: {
	pats sakopt.
	pats sakopt-izgriezumus.
	pats sakopt-atstarpes.
}.

Veidne kad: ['teksts'] darīt: { <- savs saturs.
}.
