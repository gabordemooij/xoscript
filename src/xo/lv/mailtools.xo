>> E-pasts := Objekts jauns.

E-pasts kad: ['inicializēt'] darīt: {
	savs saņēmēji := Saraksts jauns.
	savs cc := Saraksts jauns.
	savs bcc := Saraksts jauns.
	savs sūtītājs := Nekas.
	savs sūtītāja-vārds := Nekas.
	savs temats := Nekas.
	savs vēstules-teksts := Nekas.
}.

E-pasts kad: ['jauns'] darīt: { <- pats jauns inicializēt.
}.

E-pasts kad: ['kam:'] darīt: { :uzskaitījums
	savs saņēmēji := uzskaitījums.
}.
 
E-pasts kad: ['cc:'] darīt: { :uzskaitījums
	savs cc := uzskaitījums.
}.

E-pasts kad: ['bcc:'] darīt: { :uzskaitījums
	savs bcc := uzskaitījums.
}.

E-pasts kad: ['temats:'] darīt: { :temats
	savs temats := temats.
}.

E-pasts kad: ['sūtītājs:nosaukums:'] darīt: { :sūtītājs :nosaukums
	savs sūtītājs := sūtītājs.
	savs sūtītāja-vārds := nosaukums.
}.

E-pasts kad: ['vēstules-teksts:'] darīt: { :vēstules-teksts
	savs vēstules-teksts := vēstules-teksts.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-pasts kad: ['galvene:'] darīt: { :rinda <- rinda aizstāt: ['\r'] ar: [''], aizstāt: ['\n'] ar: [''].
}.

E-pasts kad: ['sūtīt'] darīt: {
	>> f := Fails tempwrite: pats ģenerēt.
	Programma sistēma: ['sendmail -t < '] + f ceļš, jauna-rinda.
}.

E-pasts kad: ['ģenerēt'] darīt: {
	>> rindas-pārtraukums := ['\r\n'].
	>> virkne := [''].
	virkne pievienot-beigās: (pats galvene: ['From: '] + savs sūtītāja-vārds + [' <'] + ( savs sūtītājs ) + ['>']) + rindas-pārtraukums.
	virkne pievienot-beigās: (pats galvene: ['To: '] + ( savs saņēmēji apvienot: [','] )) + rindas-pārtraukums.
	savs cc skaits patiess: {
		virkne pievienot-beigās: (pats galvene: ['Cc: '] + ( savs cc apvienot: [','] )) + rindas-pārtraukums.
	}.
	savs bcc skaits patiess: {
		virkne pievienot-beigās: (pats galvene: ['Bcc: '] + ( savs bcc apvienot: [','] )) + rindas-pārtraukums.
	}.
	virkne pievienot-beigās: (pats galvene: ['Subject: '] + savs temats) + rindas-pārtraukums.
	virkne pievienot-beigās: rindas-pārtraukums.
	virkne pievienot-beigās: savs vēstules-teksts.
	virkne pievienot-beigās: rindas-pārtraukums. <- virkne.
}.

>> HTML-E-pasts := E-pasts jauns.

HTML-E-pasts kad: ['inicializēt'] darīt: {
	pats inicializēt.
	savs pielikumi := Saraksts jauns.
	savs robeža := Seifs marķieris: 40.
}.

HTML-E-pasts kad: ['pievienot-pielikumu:'] darīt: { :fails
	>> id := savs pielikumi skaits.
	>> blob := fails blob.
	savs pielikumi pievienot-beigās: (
		Vārdnīca jauns
			fails: fails ceļš,
			mime: ['image/'] + (Server mimetype: fails ceļš),
			dati: blob base64-kodēt
	).
	blob atbrīvot. <- ['cid:attachment'] + id.
}.

HTML-E-pasts kad: ['ģenerēt'] darīt: {
	>> rindas-pārtraukums := ['\r\n'].
	>> virkne := [''].
	virkne pievienot-beigās: (pats galvene: ['From: '] + savs sūtītāja-vārds + [' <'] + ( savs sūtītājs ) + ['>']) + rindas-pārtraukums.
	virkne pievienot-beigās: (pats galvene: ['To: '] + ( savs saņēmēji apvienot: [','] )) + rindas-pārtraukums.
	savs cc skaits patiess: {
		virkne pievienot-beigās: (pats galvene: ['Cc: '] + ( savs cc apvienot: [','] )) + rindas-pārtraukums.
	}.
	savs bcc skaits patiess: {
		virkne pievienot-beigās: (pats galvene: ['Bcc: '] + ( savs bcc apvienot: [','] )) + rindas-pārtraukums.
	}.
	virkne pievienot-beigās: (pats galvene: ['Subject: '] + savs temats) + rindas-pārtraukums.
	virkne pievienot-beigās: ['MIME-Version: 1.0'] + rindas-pārtraukums.
	virkne pievienot-beigās: ['Content-Type: multipart/related; boundary="'] + savs robeža + ['"; type=text/html'] + rindas-pārtraukums.
	virkne pievienot-beigās: rindas-pārtraukums.
	virkne pievienot-beigās: ['--'] + savs robeža + rindas-pārtraukums.
	virkne pievienot-beigās: ['Content-Type: text/html; charset=UTF-8'] + rindas-pārtraukums.
	virkne pievienot-beigās: ['Content-Transfer-Encoding: 7bit'] + rindas-pārtraukums.
	virkne pievienot-beigās: rindas-pārtraukums.
	virkne pievienot-beigās: savs vēstules-teksts.
	virkne pievienot-beigās: rindas-pārtraukums.
	savs pielikumi katrs: { :id :info
		>> blob := info dati.
		virkne pievienot-beigās: ['--'] + savs robeža + rindas-pārtraukums.
		virkne pievienot-beigās: ['Content-Type: '] + info mime + rindas-pārtraukums.
		virkne pievienot-beigās: ['Content-Transfer-Encoding: base64'] + rindas-pārtraukums.
		virkne pievienot-beigās: ['Content-ID: <attachment'] + id + ['>'] + rindas-pārtraukums.
		virkne pievienot-beigās: ['Content-Disposition: inline; filename="'] + info fails + ['"'] + rindas-pārtraukums.
		virkne pievienot-beigās: rindas-pārtraukums.
		>> augstākais := 76.
		>> teksta-garums := blob garums.
		>> gabali := (teksta-garums / augstākais) noapaļot-uz-augšu.
		{ :i
			>> gabals := blob kopēt no: i * augstākais garums: augstākais.
			virkne pievienot-beigās: gabals + rindas-pārtraukums.
		} * gabali.
		virkne pievienot-beigās: rindas-pārtraukums.
		virkne pievienot-beigās: rindas-pārtraukums.
	}.
	virkne pievienot-beigās: ['--'] + savs robeža + ['--'] + rindas-pārtraukums. <- virkne.
}.
