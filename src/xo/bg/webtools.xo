HTTP-Заявка при: ['HTTP-заглавка:'] изпълни: { :ключ <- Програма настройка: ключ.
}.

>> HTTP-Заглавка := Обект нов.

HTTP-Заглавка при: ['нов'] изпълни: { <- себе нов инициализирай.
}.

HTTP-Заглавка при: ['инициализирай'] изпълни: {
	свой ключ := Нищо.
	свой стойност := Нищо.
}.

HTTP-Заглавка при: ['ключ:стойност:'] изпълни: { :ключ :стойност
	свой ключ := ключ.
	свой стойност := стойност.
}.

HTTP-Заглавка при: ['ключ'] изпълни: { <- свой ключ.
}.

HTTP-Заглавка при: ['стойност'] изпълни: { <- свой стойност.
}.


HTTP-Заглавка при: ['текст'] изпълни: {
	>> ред := свой ключ + [': '] + свой стойност.
	ред замени: ['\r'] с: [''], замени: ['\n'] с: ['']. <- ред + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Уеб-документ := Обект нов.

Уеб-документ при: ['нов'] изпълни: { <- себе нов инициализирай.
}.

Уеб-документ при: ['инициализирай'] изпълни: {
	свой заглавки := Списък нов.
	свой ид-сесия := Нищо.
	свой управител-сесии := Сесия-временен-файл нов.
	свой данни-сесия := Нищо.
	свой сигурно := Вярно.
	свой същия-сайт := ['Strict'].
	свой заглавки-изпратени := Невярно.
	свой http-заявка := HTTP-Заявка нов.
}.

Уеб-документ при: ['http-заявка:'] изпълни: { :http-заявка
	свой http-заявка := http-заявка.
}. 

Уеб-документ при: ['сигурна-бисквитка-сесия:'] изпълни: { :сигурно
	себе провери-заглавки.
	свой сигурно := сигурно.
}.

Уеб-документ при: ['бисквитка-сесия-същия-сайт:'] изпълни: { :стойност
	себе провери-заглавки.
	>> опции := Списък нов 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опции има: стойност, невярно: {
		тази-задача грешка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	свой същия-сайт := стойност.
}.

Уеб-документ при: ['заглавка:'] изпълни: { :заглавка
	себе провери-заглавки.
	свой заглавки добави-в-края: заглавка.
}.

Уеб-документ при: ['изпразни-заглавки'] изпълни: {
	себе провери-заглавки.
	свой заглавки := Списък нов.
}.

Уеб-документ при: ['управител-сесии:'] изпълни: { :управител
	себе провери-заглавки.
	свой управител-сесии := управител.
}.

Уеб-документ при: ['управител-сесии'] изпълни: { <- свой управител-сесии.
}.

Уеб-документ при: ['провери-заглавки'] изпълни: {
	свой заглавки-изпратени вярно: {
		тази-задача грешка: ['Headers already sent to client.'].
	}.
}.

Уеб-документ при: ['започни-сесия'] изпълни: {
	себе провери-заглавки.
	>> http-заявка := свой http-заявка.
	>> ид-сесия := http-заявка cookie: ['xsid'].
	ид-сесия Нищо? невярно: {
		(( Шаблон нов: ['^[A-Za-z0-9]+\\z'], съвпадение: ид-сесия ) = 0) вярно: {
			ид-сесия := Нищо.
		}.
	}.
	ид-сесия Нищо? вярно: {
		ид-сесия := Трезор токен: 30.
		>> заглавка-сесия := HTTP-Заглавка нов
		ключ: ['Set-Cookie'] стойност: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (свой сигурно или: ['Secure'] или: ['']),
		SSITE: (свой същия-сайт),
		XSID: ид-сесия
		).
		свой заглавки добави-в-края: заглавка-сесия.
	}.
	свой данни-сесия := свой управител-сесии за: ид-сесия, зареди. <- свой данни-сесия. # reference
}.

Уеб-документ при: ['отиди-на:'] изпълни: { :адрес
	себе провери-заглавки.
	себе изпразни-заглавки.
	свой заглавки
	добави-в-края: (
		HTTP-Заглавка нов
		ключ: ['Status'] стойност: ['303 See Other']
	),
	добави-в-края: (
		HTTP-Заглавка нов
		ключ: ['Location'] стойност: адрес
	).
	себе изведи: ['Redirect'].
}.

Уеб-документ при: ['унищожи-сесия'] изпълни: {
	себе провери-заглавки.
	>> http-заявка := свой http-заявка.
	>> ид-сесия := http-заявка cookie: ['xsid'].
	ид-сесия Нищо? невярно: {
		>> заглавка-сесия := HTTP-Заглавка нов.
		>> момент := Момент нов година: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		заглавка-сесия ключ: ['Set-Cookie'] стойност: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: момент,
			SEC: (свой сигурно или: ['Secure'] или: ['']),
			SSITE: (свой същия-сайт),
			XSID: ид-сесия
		).
		свой управител-сесии унищожи.
		свой заглавки добави-в-края: заглавка-сесия.
	}.
}.


Уеб-документ при: ['образец:'] изпълни: { :път <- Образец нов: (Файл нов: път, чети).
}.

Уеб-документ при: ['изведи:тип:'] изпълни: { :изход :тип
	свой заглавки-изпратени невярно: {
		свой данни-сесия Нищо? невярно: {
			свой управител-сесии запази: свой данни-сесия.
		}.
		свой заглавки добави-в-края: (
			HTTP-Заглавка нов
			ключ: ['Content-type'] стойност: тип
		).
		свой заглавки всеки: { :_ :заглавка
			Изход пиши: заглавка.
		}.
		свой заглавки-изпратени := Вярно.
		Изход пиши: ['\r\n'].
	}.
	Изход пиши: изход.
}.

Уеб-документ при: ['завърши:тип:'] изпълни: { :изход :тип
	свой заглавки-изпратени невярно: {
		свой данни-сесия Нищо? невярно: {
			свой управител-сесии запази: свой данни-сесия.
		}.
		свой заглавки добави-в-края: (
			HTTP-Заглавка нов
			ключ: ['Content-type'] стойност: тип
		).
		свой заглавки добави-в-края: (
			HTTP-Заглавка нов
			ключ: ['Content-Length'] стойност: изход текст bytes
		).
		свой заглавки всеки: { :_ :заглавка
			Изход пиши: заглавка.
		}.
		свой заглавки-изпратени := Вярно.
		Изход пиши: ['\r\n'].
	}.
	Изход пиши: изход.
}.

Уеб-документ при: ['изведи:'] изпълни: { :изход
	себе изведи: изход тип: ['text/html; charset=utf-8'].
}.

Уеб-документ при: ['завърши:'] изпълни: { :изход
	себе завърши: изход тип: ['text/html; charset=utf-8'].
}.

Уеб-документ при: ['json:'] изпълни: { :изход
	себе изведи: ( JSON jsonify: изход ) тип: ['application/json'].
}.

Уеб-документ при: ['не-е-намерено:'] изпълни: { :изход
	себе изпразни-заглавки заглавка: (
		HTTP-Заглавка нов ключ: ['Status'] стойност: ['404 Not Found']
	).
	себе изведи: изход.
}.


# Interface

>> Сесия := Обект нов.

Сесия при: ['нов'] изпълни: { <- себе нов инициализирай за: Нищо.
}.

Сесия при: ['за:'] изпълни: { :id
	свой id := id.
}.

Сесия при: ['зареди'] изпълни: {
	тази-задача грешка: ['Not implemented.'].
}.

Сесия при: ['запази:'] изпълни: {
	тази-задача грешка: ['Not implemented.'].
}.

Сесия при: ['унищожи'] изпълни: {
	тази-задача грешка: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сесия-временен-файл := Сесия нов.

Сесия-временен-файл при: ['инициализирай'] изпълни: {
	свой начало-път := ['/tmp/sess-'].
}.

Сесия-временен-файл при: ['префикс-път:'] изпълни: { :низ
	свой начало-път := низ.
}.

Сесия-временен-файл при: ['файл'] изпълни: { <- ( Файл нов: ( свой начало-път + свой id + ['.txt'] ) ).
}.

Сесия-временен-файл при: ['зареди'] изпълни: {
	>> файл := себе файл.
	файл съществува невярно: {
		файл пиши: (Речник нов код).
	}. <- файл чети обект.
}.

Сесия-временен-файл при: ['запази:'] изпълни: { :данни
	>> файл := себе файл.
	файл съществува вярно: {
		файл пиши: данни код.
	}.
}.

Сесия-временен-файл при: ['унищожи'] изпълни: {
	>> файл := себе файл.
	файл съществува вярно: {
		файл изтрий.
	}.
}.


>> URL := Обект нов.

URL при: ['инициализирай'] изпълни: {
	свой протокол := ['https://'].
	свой хост := ['localhost'].
	свой път := [''].
	свой параметри-url := [''].
	свой hash := [''].
}.

URL при: ['нов'] изпълни: { <- себе нов инициализирай.
}.

URL при: ['текст'] изпълни: { <- (
	свой протокол +
	свой хост +
	свой път +
	свой параметри-url +
	свой hash ).
}.

URL при: ['протокол:'] изпълни: { :протокол
	((Списък нов ; ['http'] ; ['https']) има: протокол) вярно: {
		свой протокол := протокол + ['://'].
	}, невярно: {
		тази-задача грешка: ['Invalid protocol'].
	}.
}.

URL при: ['хост:'] изпълни: { :хост
	#todo validate according to rfc
	свой хост := хост.
}.

URL при: ['път:'] изпълни: { :път
	свой път := ['/'] + път url-кодирай.
}.

URL при: ['параметри-url:'] изпълни: { :съответствие
	>> параметри-url := Списък нов.
	съответствие всеки: { :ключ :стойност
		параметри-url добави-в-края: ключ текст url-кодирай + ['='] + стойност текст url-кодирай.
	}.
	свой параметри-url := ['?'] + ( параметри-url съедини: ['&'] ).
}.

URL при: ['хеш:'] изпълни: { :hash
	свой hash := ['#'] + hash url-кодирай.
}.

