
# ~ Simple template engine ~

>> Образец := Обект нов.

Образец при: ['нов'] изпълни: { <- себе нов съдържание: [''].
}.

Образец при: ['съдържание:'] изпълни: { :съдържание
	свой съдържание := съдържание. 
}.

Образец при: ['нов:'] изпълни: { :съдържание <- себе нов съдържание: съдържание.
}.

Образец при: ['изрежи:'] изпълни: { :маркер
	>> начален-маркер := (['<!-- cut:%id% -->'] %id%: маркер).
	>> краен-маркер := (['<!-- /cut:%id% -->'] %id%: маркер).
	>> части := свой съдържание раздели: начален-маркер.
	>> префикс := части първи.
	>> части2 := части последен раздели: краен-маркер.
	>> суфикс := части2 последен.
	>> част := части2 първи.
	>> остатък := префикс + суфикс.
	свой съдържание := остатък. <- Образец нов: част.
	
}.

Образец при: ['копирай'] изпълни: { <- себе нов: себе текст копирай.
}.
	
Образец при: ['вмъкни:на:'] изпълни: { :откъс :id
	>> маркер-поставяне := (['<!-- paste:%id% -->'] %id%: id).
	свой съдържание замени: маркер-поставяне с: ( откъс текст + маркер-поставяне ).
}.

Образец при: ['задай:стойност:'] изпълни: { :място :стойност
	свой съдържание замени: ['<!-- slot:'] + място + [' -->'] с: ( Server html-кодирай: стойност ).
}.

Образец при: ['задай:html:'] изпълни: { :място :html
	свой съдържание замени: ['<!-- slot:'] + място + [' -->'] с: html.
}.

Образец при: ['отговори:и:'] изпълни: { :място :стойност
	себе задай: (място от: 0 дължина: (място дължина - 1)) стойност: стойност.
}.

Образец при: ['nl2br'] изпълни: {
	свой съдържание замени: ['\n'] с: ['<br>'].
}.

Образец при: ['прочисти'] изпълни: {
	свой съдържание :=
		Шаблон
		нов: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		съвпадение: свой съдържание
		изпълни: { <- ['']. }.
}.

Образец при: ['прочисти-изрязвания'] изпълни: {
	>> елементи := Списък нов.
	Шаблон
	нов: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	съвпадение: свой съдържание
	изпълни: { :_ :част
		елементи добави-в-края: част ? 1.
	}.
	елементи всеки: { :_ :id
		свой съдържание :=
			Шаблон нов: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			съвпадение: свой съдържание
			изпълни: { <- ['']. }.
	 }.
}.

Образец при: ['прочисти-интервали'] изпълни: {
	свой съдържание :=
		Шаблон
		нов: ['\\s*\\n'],
		съвпадение: свой съдържание
		изпълни: { <- ['\n']. }.
	свой съдържание :=
		Шаблон
		нов: ['\\n[\\s\\t]+'],
		съвпадение: свой съдържание
		изпълни: { <- ['\n']. }.
}.

Образец при: ['прочисти-всичко'] изпълни: {
	себе прочисти.
	себе прочисти-изрязвания.
	себе прочисти-интервали.
}.

Образец при: ['текст'] изпълни: { <- свой съдържание.
}.
