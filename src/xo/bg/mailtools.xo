>> Имейл := Обект нов.

Имейл при: ['инициализирай'] изпълни: {
	свой получатели := Списък нов.
	свой cc := Списък нов.
	свой bcc := Списък нов.
	свой подател := Нищо.
	свой име-подател := Нищо.
	свой тема := Нищо.
	свой тяло := Нищо.
}.

Имейл при: ['нов'] изпълни: { <- себе нов инициализирай.
}.

Имейл при: ['получател:'] изпълни: { :изброяване
	свой получатели := изброяване.
}.
 
Имейл при: ['cc:'] изпълни: { :изброяване
	свой cc := изброяване.
}.

Имейл при: ['bcc:'] изпълни: { :изброяване
	свой bcc := изброяване.
}.

Имейл при: ['тема:'] изпълни: { :тема
	свой тема := тема.
}.

Имейл при: ['подател:име:'] изпълни: { :подател :име
	свой подател := подател.
	свой име-подател := име.
}.

Имейл при: ['тяло:'] изпълни: { :тяло
	свой тяло := тяло.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Имейл при: ['заглавка:'] изпълни: { :ред <- ред замени: ['\r'] с: [''], замени: ['\n'] с: [''].
}.

Имейл при: ['изпрати'] изпълни: {
	>> f := Файл tempwrite: себе генерирай.
	Програма система: ['sendmail -t < '] + f път, нов-ред.
}.

Имейл при: ['генерирай'] изпълни: {
	>> прекъсване-ред := ['\r\n'].
	>> низ := [''].
	низ добави-в-края: (себе заглавка: ['From: '] + свой име-подател + [' <'] + ( свой подател ) + ['>']) + прекъсване-ред.
	низ добави-в-края: (себе заглавка: ['To: '] + ( свой получатели съедини: [','] )) + прекъсване-ред.
	свой cc брой вярно: {
		низ добави-в-края: (себе заглавка: ['Cc: '] + ( свой cc съедини: [','] )) + прекъсване-ред.
	}.
	свой bcc брой вярно: {
		низ добави-в-края: (себе заглавка: ['Bcc: '] + ( свой bcc съедини: [','] )) + прекъсване-ред.
	}.
	низ добави-в-края: (себе заглавка: ['Subject: '] + свой тема) + прекъсване-ред.
	низ добави-в-края: прекъсване-ред.
	низ добави-в-края: свой тяло.
	низ добави-в-края: прекъсване-ред. <- низ.
}.

>> HTML-Имейл := Имейл нов.

HTML-Имейл при: ['инициализирай'] изпълни: {
	себе инициализирай.
	свой прикачени := Списък нов.
	свой граница := Трезор токен: 40.
}.

HTML-Имейл при: ['прикачи:'] изпълни: { :файл
	>> id := свой прикачени брой.
	>> blob := файл blob.
	свой прикачени добави-в-края: (
		Речник нов
			файл: файл път,
			mime: ['image/'] + (Server mimetype: файл път),
			данни: blob base64-кодирай
	).
	blob освободи. <- ['cid:attachment'] + id.
}.

HTML-Имейл при: ['генерирай'] изпълни: {
	>> прекъсване-ред := ['\r\n'].
	>> низ := [''].
	низ добави-в-края: (себе заглавка: ['From: '] + свой име-подател + [' <'] + ( свой подател ) + ['>']) + прекъсване-ред.
	низ добави-в-края: (себе заглавка: ['To: '] + ( свой получатели съедини: [','] )) + прекъсване-ред.
	свой cc брой вярно: {
		низ добави-в-края: (себе заглавка: ['Cc: '] + ( свой cc съедини: [','] )) + прекъсване-ред.
	}.
	свой bcc брой вярно: {
		низ добави-в-края: (себе заглавка: ['Bcc: '] + ( свой bcc съедини: [','] )) + прекъсване-ред.
	}.
	низ добави-в-края: (себе заглавка: ['Subject: '] + свой тема) + прекъсване-ред.
	низ добави-в-края: ['MIME-Version: 1.0'] + прекъсване-ред.
	низ добави-в-края: ['Content-Type: multipart/related; boundary="'] + свой граница + ['"; type=text/html'] + прекъсване-ред.
	низ добави-в-края: прекъсване-ред.
	низ добави-в-края: ['--'] + свой граница + прекъсване-ред.
	низ добави-в-края: ['Content-Type: text/html; charset=UTF-8'] + прекъсване-ред.
	низ добави-в-края: ['Content-Transfer-Encoding: 7bit'] + прекъсване-ред.
	низ добави-в-края: прекъсване-ред.
	низ добави-в-края: свой тяло.
	низ добави-в-края: прекъсване-ред.
	свой прикачени всеки: { :id :инфо
		>> blob := инфо данни.
		низ добави-в-края: ['--'] + свой граница + прекъсване-ред.
		низ добави-в-края: ['Content-Type: '] + инфо mime + прекъсване-ред.
		низ добави-в-края: ['Content-Transfer-Encoding: base64'] + прекъсване-ред.
		низ добави-в-края: ['Content-ID: <attachment'] + id + ['>'] + прекъсване-ред.
		низ добави-в-края: ['Content-Disposition: inline; filename="'] + инфо файл + ['"'] + прекъсване-ред.
		низ добави-в-края: прекъсване-ред.
		>> най-много := 76.
		>> дължина-текст := blob дължина.
		>> парчета := (дължина-текст / най-много) закръгли-нагоре.
		{ :i
			>> парче := blob копирай от: i * най-много дължина: най-много.
			низ добави-в-края: парче + прекъсване-ред.
		} * парчета.
		низ добави-в-края: прекъсване-ред.
		низ добави-в-края: прекъсване-ред.
	}.
	низ добави-в-края: ['--'] + свой граница + ['--'] + прекъсване-ред. <- низ.
}.
