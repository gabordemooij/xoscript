
# ~ Simple template engine ~

>> แม่แบบ := ออบเจกต์ สร้างใหม่.

แม่แบบ เมื่อ: ['สร้างใหม่'] ทำ: { <- ตัวเอง สร้างใหม่ เนื้อหา: [''].
}.

แม่แบบ เมื่อ: ['เนื้อหา:'] ทำ: { :เนื้อหา
	ของตน เนื้อหา := เนื้อหา. 
}.

แม่แบบ เมื่อ: ['สร้างใหม่:'] ทำ: { :เนื้อหา <- ตัวเอง สร้างใหม่ เนื้อหา: เนื้อหา.
}.

แม่แบบ เมื่อ: ['ตัดออก:'] ทำ: { :เครื่องหมาย
	>> เครื่องหมายเริ่ม := (['<!-- cut:%id% -->'] %id%: เครื่องหมาย).
	>> เครื่องหมายจบ := (['<!-- /cut:%id% -->'] %id%: เครื่องหมาย).
	>> ส่วนต่างๆ := ของตน เนื้อหา แยก: เครื่องหมายเริ่ม.
	>> คำนำหน้า := ส่วนต่างๆ ตัวแรก.
	>> ส่วนต่างๆ2 := ส่วนต่างๆ ตัวสุดท้าย แยก: เครื่องหมายจบ.
	>> คำต่อท้าย := ส่วนต่างๆ2 ตัวสุดท้าย.
	>> ส่วน := ส่วนต่างๆ2 ตัวแรก.
	>> ส่วนที่เหลือ := คำนำหน้า + คำต่อท้าย.
	ของตน เนื้อหา := ส่วนที่เหลือ. <- แม่แบบ สร้างใหม่: ส่วน.
	
}.

แม่แบบ เมื่อ: ['คัดลอก'] ทำ: { <- ตัวเอง สร้างใหม่: ตัวเอง เป็นข้อความ คัดลอก.
}.
	
แม่แบบ เมื่อ: ['วาง:ที่:'] ทำ: { :ข้อความย่อ :id
	>> เครื่องหมายวาง := (['<!-- paste:%id% -->'] %id%: id).
	ของตน เนื้อหา แทนที่: เครื่องหมายวาง ด้วย: ( ข้อความย่อ เป็นข้อความ + เครื่องหมายวาง ).
}.

แม่แบบ เมื่อ: ['กำหนด:ค่า:'] ทำ: { :ช่อง :ค่า
	ของตน เนื้อหา แทนที่: ['<!-- slot:'] + ช่อง + [' -->'] ด้วย: ( Server html-เข้ารหัส: ค่า ).
}.

แม่แบบ เมื่อ: ['กำหนด:html:'] ทำ: { :ช่อง :html
	ของตน เนื้อหา แทนที่: ['<!-- slot:'] + ช่อง + [' -->'] ด้วย: html.
}.

แม่แบบ เมื่อ: ['ตอบ:และ:'] ทำ: { :ช่อง :ค่า
	ตัวเอง กำหนด: (ช่อง เริ่มที่: 0 ความยาว: (ช่อง ความยาว - 1)) ค่า: ค่า.
}.

แม่แบบ เมื่อ: ['nl2br'] ทำ: {
	ของตน เนื้อหา แทนที่: ['\n'] ด้วย: ['<br>'].
}.

แม่แบบ เมื่อ: ['ลบเครื่องหมาย'] ทำ: {
	ของตน เนื้อหา :=
		แพตเทิร์น
		สร้างใหม่: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ตรงกับ: ของตน เนื้อหา
		ทำ: { <- ['']. }.
}.

แม่แบบ เมื่อ: ['ลบส่วนตัด'] ทำ: {
	>> รายการ := ลิสต์ สร้างใหม่.
	แพตเทิร์น
	สร้างใหม่: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ตรงกับ: ของตน เนื้อหา
	ทำ: { :_ :ส่วน
		รายการ ต่อท้าย: ส่วน ? 1.
	}.
	รายการ แต่ละตัว: { :_ :id
		ของตน เนื้อหา :=
			แพตเทิร์น สร้างใหม่: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ตรงกับ: ของตน เนื้อหา
			ทำ: { <- ['']. }.
	 }.
}.

แม่แบบ เมื่อ: ['ลบช่องว่าง'] ทำ: {
	ของตน เนื้อหา :=
		แพตเทิร์น
		สร้างใหม่: ['\\s*\\n'],
		ตรงกับ: ของตน เนื้อหา
		ทำ: { <- ['\n']. }.
	ของตน เนื้อหา :=
		แพตเทิร์น
		สร้างใหม่: ['\\n[\\s\\t]+'],
		ตรงกับ: ของตน เนื้อหา
		ทำ: { <- ['\n']. }.
}.

แม่แบบ เมื่อ: ['ลบทั้งหมด'] ทำ: {
	ตัวเอง ลบเครื่องหมาย.
	ตัวเอง ลบส่วนตัด.
	ตัวเอง ลบช่องว่าง.
}.

แม่แบบ เมื่อ: ['เป็นข้อความ'] ทำ: { <- ของตน เนื้อหา.
}.
