>> อีเมล := ออบเจกต์ สร้างใหม่.

อีเมล เมื่อ: ['เตรียม'] ทำ: {
	ของตน ผู้รับ := ลิสต์ สร้างใหม่.
	ของตน cc := ลิสต์ สร้างใหม่.
	ของตน bcc := ลิสต์ สร้างใหม่.
	ของตน ผู้ส่ง := ว่าง.
	ของตน ชื่อผู้ส่ง := ว่าง.
	ของตน หัวเรื่อง := ว่าง.
	ของตน เนื้อความ := ว่าง.
}.

อีเมล เมื่อ: ['สร้างใหม่'] ทำ: { <- ตัวเอง สร้างใหม่ เตรียม.
}.

อีเมล เมื่อ: ['ถึง:'] ทำ: { :การแจกแจง
	ของตน ผู้รับ := การแจกแจง.
}.
 
อีเมล เมื่อ: ['cc:'] ทำ: { :การแจกแจง
	ของตน cc := การแจกแจง.
}.

อีเมล เมื่อ: ['bcc:'] ทำ: { :การแจกแจง
	ของตน bcc := การแจกแจง.
}.

อีเมล เมื่อ: ['หัวเรื่อง:'] ทำ: { :หัวเรื่อง
	ของตน หัวเรื่อง := หัวเรื่อง.
}.

อีเมล เมื่อ: ['ผู้ส่ง:ชื่อ:'] ทำ: { :ผู้ส่ง :ชื่อ
	ของตน ผู้ส่ง := ผู้ส่ง.
	ของตน ชื่อผู้ส่ง := ชื่อ.
}.

อีเมล เมื่อ: ['เนื้อความ:'] ทำ: { :เนื้อความ
	ของตน เนื้อความ := เนื้อความ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
อีเมล เมื่อ: ['ส่วนหัว:'] ทำ: { :บรรทัด <- บรรทัด แทนที่: ['\r'] ด้วย: [''], แทนที่: ['\n'] ด้วย: [''].
}.

อีเมล เมื่อ: ['ส่ง'] ทำ: {
	>> f := ไฟล์ tempwrite: ตัวเอง สร้างขึ้น.
	โปรแกรม ระบบ: ['sendmail -t < '] + f เส้นทาง, ขึ้นบรรทัดใหม่.
}.

อีเมล เมื่อ: ['สร้างขึ้น'] ทำ: {
	>> ขึ้นบรรทัด := ['\r\n'].
	>> สายอักขระ := [''].
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['From: '] + ของตน ชื่อผู้ส่ง + [' <'] + ( ของตน ผู้ส่ง ) + ['>']) + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['To: '] + ( ของตน ผู้รับ รวม: [','] )) + ขึ้นบรรทัด.
	ของตน cc จำนวน ถ้าจริง: {
		สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Cc: '] + ( ของตน cc รวม: [','] )) + ขึ้นบรรทัด.
	}.
	ของตน bcc จำนวน ถ้าจริง: {
		สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Bcc: '] + ( ของตน bcc รวม: [','] )) + ขึ้นบรรทัด.
	}.
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Subject: '] + ของตน หัวเรื่อง) + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ของตน เนื้อความ.
	สายอักขระ ต่อท้าย: ขึ้นบรรทัด. <- สายอักขระ.
}.

>> อีเมล-HTML := อีเมล สร้างใหม่.

อีเมล-HTML เมื่อ: ['เตรียม'] ทำ: {
	ตัวเอง เตรียม.
	ของตน ไฟล์แนบ := ลิสต์ สร้างใหม่.
	ของตน ขอบเขต := ตู้นิรภัย โทเค็น: 40.
}.

อีเมล-HTML เมื่อ: ['แนบ:'] ทำ: { :ไฟล์เซสชัน
	>> id := ของตน ไฟล์แนบ จำนวน.
	>> blob := ไฟล์เซสชัน blob.
	ของตน ไฟล์แนบ ต่อท้าย: (
		พจนานุกรม สร้างใหม่
			ไฟล์เซสชัน: ไฟล์เซสชัน เส้นทาง,
			mime: ['image/'] + (Server mimetype: ไฟล์เซสชัน เส้นทาง),
			ข้อมูล: blob base64-เข้ารหัส
	).
	blob คืนหน่วยความจำ. <- ['cid:attachment'] + id.
}.

อีเมล-HTML เมื่อ: ['สร้างขึ้น'] ทำ: {
	>> ขึ้นบรรทัด := ['\r\n'].
	>> สายอักขระ := [''].
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['From: '] + ของตน ชื่อผู้ส่ง + [' <'] + ( ของตน ผู้ส่ง ) + ['>']) + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['To: '] + ( ของตน ผู้รับ รวม: [','] )) + ขึ้นบรรทัด.
	ของตน cc จำนวน ถ้าจริง: {
		สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Cc: '] + ( ของตน cc รวม: [','] )) + ขึ้นบรรทัด.
	}.
	ของตน bcc จำนวน ถ้าจริง: {
		สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Bcc: '] + ( ของตน bcc รวม: [','] )) + ขึ้นบรรทัด.
	}.
	สายอักขระ ต่อท้าย: (ตัวเอง ส่วนหัว: ['Subject: '] + ของตน หัวเรื่อง) + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ['MIME-Version: 1.0'] + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ['Content-Type: multipart/related; boundary="'] + ของตน ขอบเขต + ['"; type=text/html'] + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ['--'] + ของตน ขอบเขต + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ['Content-Type: text/html; charset=UTF-8'] + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ['Content-Transfer-Encoding: 7bit'] + ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
	สายอักขระ ต่อท้าย: ของตน เนื้อความ.
	สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
	ของตน ไฟล์แนบ แต่ละตัว: { :id :รายละเอียด
		>> blob := รายละเอียด ข้อมูล.
		สายอักขระ ต่อท้าย: ['--'] + ของตน ขอบเขต + ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ['Content-Type: '] + รายละเอียด mime + ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ['Content-Transfer-Encoding: base64'] + ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ['Content-ID: <attachment'] + id + ['>'] + ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ['Content-Disposition: inline; filename="'] + รายละเอียด ไฟล์เซสชัน + ['"'] + ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
		>> สูงสุด := 76.
		>> ความยาวข้อความ := blob ความยาว.
		>> ก้อนต่างๆ := (ความยาวข้อความ / สูงสุด) ปัดขึ้น.
		{ :i
			>> ก้อน := blob คัดลอก เริ่มที่: i * สูงสุด ความยาว: สูงสุด.
			สายอักขระ ต่อท้าย: ก้อน + ขึ้นบรรทัด.
		} * ก้อนต่างๆ.
		สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
		สายอักขระ ต่อท้าย: ขึ้นบรรทัด.
	}.
	สายอักขระ ต่อท้าย: ['--'] + ของตน ขอบเขต + ['--'] + ขึ้นบรรทัด. <- สายอักขระ.
}.
