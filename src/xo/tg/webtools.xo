HTTP-Дархост ҳангоми: ['HTTP-сарлавҳа:'] иҷро: { :калид <- Барнома танзим: калид.
}.

>> HTTP-Сарлавҳа := Объект нав.

HTTP-Сарлавҳа ҳангоми: ['нав'] иҷро: { <- худ нав оғоз-кун.
}.

HTTP-Сарлавҳа ҳангоми: ['оғоз-кун'] иҷро: {
	худӣ калид := Ҳеҷ.
	худӣ қимат := Ҳеҷ.
}.

HTTP-Сарлавҳа ҳангоми: ['калид:қимат:'] иҷро: { :калид :қимат
	худӣ калид := калид.
	худӣ қимат := қимат.
}.

HTTP-Сарлавҳа ҳангоми: ['калид'] иҷро: { <- худӣ калид.
}.

HTTP-Сарлавҳа ҳангоми: ['қимат'] иҷро: { <- худӣ қимат.
}.


HTTP-Сарлавҳа ҳангоми: ['матн'] иҷро: {
	>> сатр := худӣ калид + [': '] + худӣ қимат.
	сатр иваз: ['\r'] бо: [''], иваз: ['\n'] бо: ['']. <- сатр + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Ҳуҷҷати-веб := Объект нав.

Ҳуҷҷати-веб ҳангоми: ['нав'] иҷро: { <- худ нав оғоз-кун.
}.

Ҳуҷҷати-веб ҳангоми: ['оғоз-кун'] иҷро: {
	худӣ сарлавҳаҳо := Феҳрист нав.
	худӣ id-сеанс := Ҳеҷ.
	худӣ мудири-сеансҳо := Сеанси-файли-муваққатӣ нав.
	худӣ маълумоти-сеанс := Ҳеҷ.
	худӣ бехатар := Рост.
	худӣ ҳамон-сайт := ['Strict'].
	худӣ сарлавҳаҳо-фиристода := Дурӯғ.
	худӣ http-дархост := HTTP-Дархост нав.
}.

Ҳуҷҷати-веб ҳангоми: ['http-дархост:'] иҷро: { :http-дархост
	худӣ http-дархост := http-дархост.
}. 

Ҳуҷҷати-веб ҳангоми: ['cookie-сеанси-бехатар:'] иҷро: { :бехатар
	худ сарлавҳаҳоро-санҷ.
	худӣ бехатар := бехатар.
}.

Ҳуҷҷати-веб ҳангоми: ['cookie-сеанси-ҳамон-сайт:'] иҷро: { :қимат
	худ сарлавҳаҳоро-санҷ.
	>> интихобҳо := Феҳрист нав 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	интихобҳо дорад: қимат, агар-дурӯғ: {
		ин-вазифа хато: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	худӣ ҳамон-сайт := қимат.
}.

Ҳуҷҷати-веб ҳангоми: ['сарлавҳа:'] иҷро: { :сарлавҳа
	худ сарлавҳаҳоро-санҷ.
	худӣ сарлавҳаҳо ба-охир-илова: сарлавҳа.
}.

Ҳуҷҷати-веб ҳангоми: ['сарлавҳаҳоро-холӣ-кун'] иҷро: {
	худ сарлавҳаҳоро-санҷ.
	худӣ сарлавҳаҳо := Феҳрист нав.
}.

Ҳуҷҷати-веб ҳангоми: ['мудири-сеансҳо:'] иҷро: { :мудир
	худ сарлавҳаҳоро-санҷ.
	худӣ мудири-сеансҳо := мудир.
}.

Ҳуҷҷати-веб ҳангоми: ['мудири-сеансҳо'] иҷро: { <- худӣ мудири-сеансҳо.
}.

Ҳуҷҷати-веб ҳангоми: ['сарлавҳаҳоро-санҷ'] иҷро: {
	худӣ сарлавҳаҳо-фиристода агар-рост: {
		ин-вазифа хато: ['Headers already sent to client.'].
	}.
}.

Ҳуҷҷати-веб ҳангоми: ['сеансро-оғоз-кун'] иҷро: {
	худ сарлавҳаҳоро-санҷ.
	>> http-дархост := худӣ http-дархост.
	>> id-сеанс := http-дархост cookie: ['xsid'].
	id-сеанс Ҳеҷ? агар-дурӯғ: {
		(( Қолаб нав: ['^[A-Za-z0-9]+\\z'], мувофиқат: id-сеанс ) = 0) агар-рост: {
			id-сеанс := Ҳеҷ.
		}.
	}.
	id-сеанс Ҳеҷ? агар-рост: {
		id-сеанс := Сейф токен: 30.
		>> сарлавҳаи-сеанс := HTTP-Сарлавҳа нав
		калид: ['Set-Cookie'] қимат: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (худӣ бехатар ин: ['Secure'] ё-он: ['']),
		SSITE: (худӣ ҳамон-сайт),
		XSID: id-сеанс
		).
		худӣ сарлавҳаҳо ба-охир-илова: сарлавҳаи-сеанс.
	}.
	худӣ маълумоти-сеанс := худӣ мудири-сеансҳо барои: id-сеанс, бор-кун. <- худӣ маълумоти-сеанс. # reference
}.

Ҳуҷҷати-веб ҳангоми: ['гузар:'] иҷро: { :суроға
	худ сарлавҳаҳоро-санҷ.
	худ сарлавҳаҳоро-холӣ-кун.
	худӣ сарлавҳаҳо
	ба-охир-илова: (
		HTTP-Сарлавҳа нав
		калид: ['Status'] қимат: ['303 See Other']
	),
	ба-охир-илова: (
		HTTP-Сарлавҳа нав
		калид: ['Location'] қимат: суроға
	).
	худ барор: ['Redirect'].
}.

Ҳуҷҷати-веб ҳангоми: ['сеансро-нобуд-кун'] иҷро: {
	худ сарлавҳаҳоро-санҷ.
	>> http-дархост := худӣ http-дархост.
	>> id-сеанс := http-дархост cookie: ['xsid'].
	id-сеанс Ҳеҷ? агар-дурӯғ: {
		>> сарлавҳаи-сеанс := HTTP-Сарлавҳа нав.
		>> лаҳза := Лаҳза нав сол: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		сарлавҳаи-сеанс калид: ['Set-Cookie'] қимат: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: лаҳза,
			SEC: (худӣ бехатар ин: ['Secure'] ё-он: ['']),
			SSITE: (худӣ ҳамон-сайт),
			XSID: id-сеанс
		).
		худӣ мудири-сеансҳо нобуд-кун.
		худӣ сарлавҳаҳо ба-охир-илова: сарлавҳаи-сеанс.
	}.
}.


Ҳуҷҷати-веб ҳангоми: ['қолиб:'] иҷро: { :роҳ <- Қолиб нав: (Файл нав: роҳ, хон).
}.

Ҳуҷҷати-веб ҳангоми: ['барор:навъ:'] иҷро: { :натиҷа :навъ
	худӣ сарлавҳаҳо-фиристода агар-дурӯғ: {
		худӣ маълумоти-сеанс Ҳеҷ? агар-дурӯғ: {
			худӣ мудири-сеансҳо нигоҳ-дор: худӣ маълумоти-сеанс.
		}.
		худӣ сарлавҳаҳо ба-охир-илова: (
			HTTP-Сарлавҳа нав
			калид: ['Content-type'] қимат: навъ
		).
		худӣ сарлавҳаҳо ҳар-як: { :_ :сарлавҳа
			Баромад навис: сарлавҳа.
		}.
		худӣ сарлавҳаҳо-фиристода := Рост.
		Баромад навис: ['\r\n'].
	}.
	Баромад навис: натиҷа.
}.

Ҳуҷҷати-веб ҳангоми: ['анҷом-деҳ:навъ:'] иҷро: { :натиҷа :навъ
	худӣ сарлавҳаҳо-фиристода агар-дурӯғ: {
		худӣ маълумоти-сеанс Ҳеҷ? агар-дурӯғ: {
			худӣ мудири-сеансҳо нигоҳ-дор: худӣ маълумоти-сеанс.
		}.
		худӣ сарлавҳаҳо ба-охир-илова: (
			HTTP-Сарлавҳа нав
			калид: ['Content-type'] қимат: навъ
		).
		худӣ сарлавҳаҳо ба-охир-илова: (
			HTTP-Сарлавҳа нав
			калид: ['Content-Length'] қимат: натиҷа матн bytes
		).
		худӣ сарлавҳаҳо ҳар-як: { :_ :сарлавҳа
			Баромад навис: сарлавҳа.
		}.
		худӣ сарлавҳаҳо-фиристода := Рост.
		Баромад навис: ['\r\n'].
	}.
	Баромад навис: натиҷа.
}.

Ҳуҷҷати-веб ҳангоми: ['барор:'] иҷро: { :натиҷа
	худ барор: натиҷа навъ: ['text/html; charset=utf-8'].
}.

Ҳуҷҷати-веб ҳангоми: ['анҷом-деҳ:'] иҷро: { :натиҷа
	худ анҷом-деҳ: натиҷа навъ: ['text/html; charset=utf-8'].
}.

Ҳуҷҷати-веб ҳангоми: ['json:'] иҷро: { :натиҷа
	худ барор: ( JSON jsonify: натиҷа ) навъ: ['application/json'].
}.

Ҳуҷҷати-веб ҳангоми: ['ёфт-нашуд:'] иҷро: { :натиҷа
	худ сарлавҳаҳоро-холӣ-кун сарлавҳа: (
		HTTP-Сарлавҳа нав калид: ['Status'] қимат: ['404 Not Found']
	).
	худ барор: натиҷа.
}.


# Interface

>> Сеанс := Объект нав.

Сеанс ҳангоми: ['нав'] иҷро: { <- худ нав оғоз-кун барои: Ҳеҷ.
}.

Сеанс ҳангоми: ['барои:'] иҷро: { :id
	худӣ id := id.
}.

Сеанс ҳангоми: ['бор-кун'] иҷро: {
	ин-вазифа хато: ['Not implemented.'].
}.

Сеанс ҳангоми: ['нигоҳ-дор:'] иҷро: {
	ин-вазифа хато: ['Not implemented.'].
}.

Сеанс ҳангоми: ['нобуд-кун'] иҷро: {
	ин-вазифа хато: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сеанси-файли-муваққатӣ := Сеанс нав.

Сеанси-файли-муваққатӣ ҳангоми: ['оғоз-кун'] иҷро: {
	худӣ ибтидои-роҳ := ['/tmp/sess-'].
}.

Сеанси-файли-муваққатӣ ҳангоми: ['пешванди-роҳ:'] иҷро: { :сатр-занҷира
	худӣ ибтидои-роҳ := сатр-занҷира.
}.

Сеанси-файли-муваққатӣ ҳангоми: ['файл'] иҷро: { <- ( Файл нав: ( худӣ ибтидои-роҳ + худӣ id + ['.txt'] ) ).
}.

Сеанси-файли-муваққатӣ ҳангоми: ['бор-кун'] иҷро: {
	>> файл := худ файл.
	файл мавҷуд агар-дурӯғ: {
		файл навис: (Луғат нав код).
	}. <- файл хон объект.
}.

Сеанси-файли-муваққатӣ ҳангоми: ['нигоҳ-дор:'] иҷро: { :маълумот
	>> файл := худ файл.
	файл мавҷуд агар-рост: {
		файл навис: маълумот код.
	}.
}.

Сеанси-файли-муваққатӣ ҳангоми: ['нобуд-кун'] иҷро: {
	>> файл := худ файл.
	файл мавҷуд агар-рост: {
		файл ҳазф.
	}.
}.


>> URL := Объект нав.

URL ҳангоми: ['оғоз-кун'] иҷро: {
	худӣ протокол := ['https://'].
	худӣ мизбон := ['localhost'].
	худӣ роҳ := [''].
	худӣ параметрҳои-url := [''].
	худӣ hash := [''].
}.

URL ҳангоми: ['нав'] иҷро: { <- худ нав оғоз-кун.
}.

URL ҳангоми: ['матн'] иҷро: { <- (
	худӣ протокол +
	худӣ мизбон +
	худӣ роҳ +
	худӣ параметрҳои-url +
	худӣ hash ).
}.

URL ҳангоми: ['протокол:'] иҷро: { :протокол
	((Феҳрист нав ; ['http'] ; ['https']) дорад: протокол) агар-рост: {
		худӣ протокол := протокол + ['://'].
	}, агар-дурӯғ: {
		ин-вазифа хато: ['Invalid protocol'].
	}.
}.

URL ҳангоми: ['мизбон:'] иҷро: { :мизбон
	#todo validate according to rfc
	худӣ мизбон := мизбон.
}.

URL ҳангоми: ['роҳ:'] иҷро: { :роҳ
	худӣ роҳ := ['/'] + роҳ url-рамзгузорӣ.
}.

URL ҳангоми: ['параметрҳои-url:'] иҷро: { :мувофиқат
	>> параметрҳои-url := Феҳрист нав.
	мувофиқат ҳар-як: { :калид :қимат
		параметрҳои-url ба-охир-илова: калид матн url-рамзгузорӣ + ['='] + қимат матн url-рамзгузорӣ.
	}.
	худӣ параметрҳои-url := ['?'] + ( параметрҳои-url пайваст: ['&'] ).
}.

URL ҳангоми: ['ҳеш:'] иҷро: { :hash
	худӣ hash := ['#'] + hash url-рамзгузорӣ.
}.

