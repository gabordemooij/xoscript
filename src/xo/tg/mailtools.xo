>> Email := Объект нав.

Email ҳангоми: ['init'] иҷро: {
	худӣ recipients := Феҳрист нав.
	худӣ cc := Феҳрист нав.
	худӣ bcc := Феҳрист нав.
	худӣ from := Ҳеҷ.
	худӣ from-name := Ҳеҷ.
	худӣ subject := Ҳеҷ.
	худӣ body := Ҳеҷ.
}.

Email ҳангоми: ['нав'] иҷро: { <- худ нав init.
}.

Email ҳангоми: ['to:'] иҷро: { :list
	худӣ recipients := list.
}.
 
Email ҳангоми: ['cc:'] иҷро: { :list
	худӣ cc := list.
}.

Email ҳангоми: ['bcc:'] иҷро: { :list
	худӣ bcc := list.
}.

Email ҳангоми: ['subject:'] иҷро: { :subject
	худӣ subject := subject.
}.

Email ҳангоми: ['from:name:'] иҷро: { :from :ном
	худӣ from := from.
	худӣ from-name := ном.
}.

Email ҳангоми: ['body:'] иҷро: { :body
	худӣ body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email ҳангоми: ['header:'] иҷро: { :line <- line иваз: ['\r'] бо: [''], иваз: ['\n'] бо: [''].
}.

Email ҳангоми: ['send'] иҷро: {
	>> f := Файл tempwrite: худ generate.
	Барнома система: ['sendmail -t < '] + f роҳ, сатри-нав.
}.

Email ҳангоми: ['generate'] иҷро: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ба-охир-илова: (худ header: ['From: '] + худӣ from-name + [' <'] + ( худӣ from ) + ['>']) + brk.
	str ба-охир-илова: (худ header: ['To: '] + ( худӣ recipients пайваст: [','] )) + brk.
	худӣ cc шумора агар-рост: {
		str ба-охир-илова: (худ header: ['Cc: '] + ( худӣ cc пайваст: [','] )) + brk.
	}.
	худӣ bcc шумора агар-рост: {
		str ба-охир-илова: (худ header: ['Bcc: '] + ( худӣ bcc пайваст: [','] )) + brk.
	}.
	str ба-охир-илова: (худ header: ['Subject: '] + худӣ subject) + brk.
	str ба-охир-илова: brk.
	str ба-охир-илова: худӣ body.
	str ба-охир-илова: brk. <- str.
}.

>> HTML-Email := Email нав.

HTML-Email ҳангоми: ['init'] иҷро: {
	худ init.
	худӣ attachments := Феҳрист нав.
	худӣ boundary := Сейф токен: 40.
}.

HTML-Email ҳангоми: ['attach:'] иҷро: { :file
	>> id := худӣ attachments шумора.
	>> blob := file blob.
	худӣ attachments ба-охир-илова: (
		Луғат нав
			file: file роҳ,
			mime: ['image/'] + (Server mimetype: file роҳ),
			data: blob base64-рамзгузорӣ
	).
	blob озод. <- ['cid:attachment'] + id.
}.

HTML-Email ҳангоми: ['generate'] иҷро: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ба-охир-илова: (худ header: ['From: '] + худӣ from-name + [' <'] + ( худӣ from ) + ['>']) + brk.
	str ба-охир-илова: (худ header: ['To: '] + ( худӣ recipients пайваст: [','] )) + brk.
	худӣ cc шумора агар-рост: {
		str ба-охир-илова: (худ header: ['Cc: '] + ( худӣ cc пайваст: [','] )) + brk.
	}.
	худӣ bcc шумора агар-рост: {
		str ба-охир-илова: (худ header: ['Bcc: '] + ( худӣ bcc пайваст: [','] )) + brk.
	}.
	str ба-охир-илова: (худ header: ['Subject: '] + худӣ subject) + brk.
	str ба-охир-илова: ['MIME-Version: 1.0'] + brk.
	str ба-охир-илова: ['Content-Type: multipart/related; boundary="'] + худӣ boundary + ['"; type=text/html'] + brk.
	str ба-охир-илова: brk.
	str ба-охир-илова: ['--'] + худӣ boundary + brk.
	str ба-охир-илова: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str ба-охир-илова: ['Content-Transfer-Encoding: 7bit'] + brk.
	str ба-охир-илова: brk.
	str ба-охир-илова: худӣ body.
	str ба-охир-илова: brk.
	худӣ attachments ҳар-як: { :id :info
		>> blob := info data.
		str ба-охир-илова: ['--'] + худӣ boundary + brk.
		str ба-охир-илова: ['Content-Type: '] + info mime + brk.
		str ба-охир-илова: ['Content-Transfer-Encoding: base64'] + brk.
		str ба-охир-илова: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str ба-охир-илова: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str ба-охир-илова: brk.
		>> max := 76.
		>> len := blob дарозӣ.
		>> chunks := (len / max) ба-боло-яклухт.
		{ :i
			>> chunk := blob нусха оғоз: i * max дарозӣ: max.
			str ба-охир-илова: chunk + brk.
		} * chunks.
		str ба-охир-илова: brk.
		str ба-охир-илова: brk.
	}.
	str ба-охир-илова: ['--'] + худӣ boundary + ['--'] + brk. <- str.
}.
