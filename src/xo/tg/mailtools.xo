>> Почтаи-электронӣ := Объект нав.

Почтаи-электронӣ ҳангоми: ['оғоз-кун'] иҷро: {
	худӣ гирандагон := Феҳрист нав.
	худӣ cc := Феҳрист нав.
	худӣ bcc := Феҳрист нав.
	худӣ фиристанда := Ҳеҷ.
	худӣ номи-фиристанда := Ҳеҷ.
	худӣ мавзӯъ := Ҳеҷ.
	худӣ матни-асосӣ := Ҳеҷ.
}.

Почтаи-электронӣ ҳангоми: ['нав'] иҷро: { <- худ нав оғоз-кун.
}.

Почтаи-электронӣ ҳангоми: ['ба-гиранда:'] иҷро: { :номбар
	худӣ гирандагон := номбар.
}.
 
Почтаи-электронӣ ҳангоми: ['cc:'] иҷро: { :номбар
	худӣ cc := номбар.
}.

Почтаи-электронӣ ҳангоми: ['bcc:'] иҷро: { :номбар
	худӣ bcc := номбар.
}.

Почтаи-электронӣ ҳангоми: ['мавзӯъ:'] иҷро: { :мавзӯъ
	худӣ мавзӯъ := мавзӯъ.
}.

Почтаи-электронӣ ҳангоми: ['фиристанда:ном:'] иҷро: { :фиристанда :ном
	худӣ фиристанда := фиристанда.
	худӣ номи-фиристанда := ном.
}.

Почтаи-электронӣ ҳангоми: ['матни-асосӣ:'] иҷро: { :матни-асосӣ
	худӣ матни-асосӣ := матни-асосӣ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Почтаи-электронӣ ҳангоми: ['сарлавҳа:'] иҷро: { :сатр <- сатр иваз: ['\r'] бо: [''], иваз: ['\n'] бо: [''].
}.

Почтаи-электронӣ ҳангоми: ['фирист'] иҷро: {
	>> f := Файл tempwrite: худ эҷод-кун.
	Барнома система: ['sendmail -t < '] + f роҳ, сатри-нав.
}.

Почтаи-электронӣ ҳангоми: ['эҷод-кун'] иҷро: {
	>> шикасти-сатр := ['\r\n'].
	>> сатр-занҷира := [''].
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['From: '] + худӣ номи-фиристанда + [' <'] + ( худӣ фиристанда ) + ['>']) + шикасти-сатр.
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['To: '] + ( худӣ гирандагон пайваст: [','] )) + шикасти-сатр.
	худӣ cc шумора агар-рост: {
		сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Cc: '] + ( худӣ cc пайваст: [','] )) + шикасти-сатр.
	}.
	худӣ bcc шумора агар-рост: {
		сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Bcc: '] + ( худӣ bcc пайваст: [','] )) + шикасти-сатр.
	}.
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Subject: '] + худӣ мавзӯъ) + шикасти-сатр.
	сатр-занҷира ба-охир-илова: шикасти-сатр.
	сатр-занҷира ба-охир-илова: худӣ матни-асосӣ.
	сатр-занҷира ба-охир-илова: шикасти-сатр. <- сатр-занҷира.
}.

>> HTML-Почтаи-электронӣ := Почтаи-электронӣ нав.

HTML-Почтаи-электронӣ ҳангоми: ['оғоз-кун'] иҷро: {
	худ оғоз-кун.
	худӣ замимаҳо := Феҳрист нав.
	худӣ сарҳад := Сейф токен: 40.
}.

HTML-Почтаи-электронӣ ҳангоми: ['замима-кун:'] иҷро: { :файл
	>> id := худӣ замимаҳо шумора.
	>> blob := файл blob.
	худӣ замимаҳо ба-охир-илова: (
		Луғат нав
			файл: файл роҳ,
			mime: ['image/'] + (Server mimetype: файл роҳ),
			маълумот: blob base64-рамзгузорӣ
	).
	blob озод. <- ['cid:attachment'] + id.
}.

HTML-Почтаи-электронӣ ҳангоми: ['эҷод-кун'] иҷро: {
	>> шикасти-сатр := ['\r\n'].
	>> сатр-занҷира := [''].
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['From: '] + худӣ номи-фиристанда + [' <'] + ( худӣ фиристанда ) + ['>']) + шикасти-сатр.
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['To: '] + ( худӣ гирандагон пайваст: [','] )) + шикасти-сатр.
	худӣ cc шумора агар-рост: {
		сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Cc: '] + ( худӣ cc пайваст: [','] )) + шикасти-сатр.
	}.
	худӣ bcc шумора агар-рост: {
		сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Bcc: '] + ( худӣ bcc пайваст: [','] )) + шикасти-сатр.
	}.
	сатр-занҷира ба-охир-илова: (худ сарлавҳа: ['Subject: '] + худӣ мавзӯъ) + шикасти-сатр.
	сатр-занҷира ба-охир-илова: ['MIME-Version: 1.0'] + шикасти-сатр.
	сатр-занҷира ба-охир-илова: ['Content-Type: multipart/related; boundary="'] + худӣ сарҳад + ['"; type=text/html'] + шикасти-сатр.
	сатр-занҷира ба-охир-илова: шикасти-сатр.
	сатр-занҷира ба-охир-илова: ['--'] + худӣ сарҳад + шикасти-сатр.
	сатр-занҷира ба-охир-илова: ['Content-Type: text/html; charset=UTF-8'] + шикасти-сатр.
	сатр-занҷира ба-охир-илова: ['Content-Transfer-Encoding: 7bit'] + шикасти-сатр.
	сатр-занҷира ба-охир-илова: шикасти-сатр.
	сатр-занҷира ба-охир-илова: худӣ матни-асосӣ.
	сатр-занҷира ба-охир-илова: шикасти-сатр.
	худӣ замимаҳо ҳар-як: { :id :иттилоот
		>> blob := иттилоот маълумот.
		сатр-занҷира ба-охир-илова: ['--'] + худӣ сарҳад + шикасти-сатр.
		сатр-занҷира ба-охир-илова: ['Content-Type: '] + иттилоот mime + шикасти-сатр.
		сатр-занҷира ба-охир-илова: ['Content-Transfer-Encoding: base64'] + шикасти-сатр.
		сатр-занҷира ба-охир-илова: ['Content-ID: <attachment'] + id + ['>'] + шикасти-сатр.
		сатр-занҷира ба-охир-илова: ['Content-Disposition: inline; filename="'] + иттилоот файл + ['"'] + шикасти-сатр.
		сатр-занҷира ба-охир-илова: шикасти-сатр.
		>> ҳадди-аксар := 76.
		>> дарозии-матн := blob дарозӣ.
		>> пораҳо := (дарозии-матн / ҳадди-аксар) ба-боло-яклухт.
		{ :i
			>> пора := blob нусха оғоз: i * ҳадди-аксар дарозӣ: ҳадди-аксар.
			сатр-занҷира ба-охир-илова: пора + шикасти-сатр.
		} * пораҳо.
		сатр-занҷира ба-охир-илова: шикасти-сатр.
		сатр-занҷира ба-охир-илова: шикасти-сатр.
	}.
	сатр-занҷира ба-охир-илова: ['--'] + худӣ сарҳад + ['--'] + шикасти-сатр. <- сатр-занҷира.
}.
