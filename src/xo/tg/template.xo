
# ~ Simple template engine ~

>> Қолиб := Объект нав.

Қолиб ҳангоми: ['нав'] иҷро: { <- худ нав мундариҷа: [''].
}.

Қолиб ҳангоми: ['мундариҷа:'] иҷро: { :мундариҷа
	худӣ мундариҷа := мундариҷа. 
}.

Қолиб ҳангоми: ['нав:'] иҷро: { :мундариҷа <- худ нав мундариҷа: мундариҷа.
}.

Қолиб ҳангоми: ['бур:'] иҷро: { :аломат
	>> аломати-оғоз := (['<!-- cut:%id% -->'] %id%: аломат).
	>> аломати-охир := (['<!-- /cut:%id% -->'] %id%: аломат).
	>> қисмҳо := худӣ мундариҷа тақсим: аломати-оғоз.
	>> пешванд := қисмҳо якум.
	>> қисмҳо2 := қисмҳо охирин тақсим: аломати-охир.
	>> пасванд := қисмҳо2 охирин.
	>> қисм := қисмҳо2 якум.
	>> боқимонда := пешванд + пасванд.
	худӣ мундариҷа := боқимонда. <- Қолиб нав: қисм.
	
}.

Қолиб ҳангоми: ['нусха'] иҷро: { <- худ нав: худ матн нусха.
}.
	
Қолиб ҳангоми: ['часпон:калид:'] иҷро: { :иқтибос :id
	>> аломати-часпон := (['<!-- paste:%id% -->'] %id%: id).
	худӣ мундариҷа иваз: аломати-часпон бо: ( иқтибос матн + аломати-часпон ).
}.

Қолиб ҳангоми: ['муқаррар:қимат:'] иҷро: { :ҷой :қимат
	худӣ мундариҷа иваз: ['<!-- slot:'] + ҷой + [' -->'] бо: ( Server html-рамзгузорӣ: қимат ).
}.

Қолиб ҳангоми: ['муқаррар:html:'] иҷро: { :ҷой :html
	худӣ мундариҷа иваз: ['<!-- slot:'] + ҷой + [' -->'] бо: html.
}.

Қолиб ҳангоми: ['ҷавоб:ва:'] иҷро: { :ҷой :қимат
	худ муқаррар: (ҷой оғоз: 0 дарозӣ: (ҷой дарозӣ - 1)) қимат: қимат.
}.

Қолиб ҳангоми: ['nl2br'] иҷро: {
	худӣ мундариҷа иваз: ['\n'] бо: ['<br>'].
}.

Қолиб ҳангоми: ['ба-тартиб-овар'] иҷро: {
	худӣ мундариҷа :=
		Қолаб
		нав: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		мувофиқат: худӣ мундариҷа
		иҷро: { <- ['']. }.
}.

Қолиб ҳангоми: ['буришҳоро-ба-тартиб-овар'] иҷро: {
	>> унсурҳо := Феҳрист нав.
	Қолаб
	нав: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	мувофиқат: худӣ мундариҷа
	иҷро: { :_ :қисм
		унсурҳо ба-охир-илова: қисм ? 1.
	}.
	унсурҳо ҳар-як: { :_ :id
		худӣ мундариҷа :=
			Қолаб нав: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			мувофиқат: худӣ мундариҷа
			иҷро: { <- ['']. }.
	 }.
}.

Қолиб ҳангоми: ['фосилаҳоро-ба-тартиб-овар'] иҷро: {
	худӣ мундариҷа :=
		Қолаб
		нав: ['\\s*\\n'],
		мувофиқат: худӣ мундариҷа
		иҷро: { <- ['\n']. }.
	худӣ мундариҷа :=
		Қолаб
		нав: ['\\n[\\s\\t]+'],
		мувофиқат: худӣ мундариҷа
		иҷро: { <- ['\n']. }.
}.

Қолиб ҳангоми: ['ҳамаро-ба-тартиб-овар'] иҷро: {
	худ ба-тартиб-овар.
	худ буришҳоро-ба-тартиб-овар.
	худ фосилаҳоро-ба-тартиб-овар.
}.

Қолиб ҳангоми: ['матн'] иҷро: { <- худӣ мундариҷа.
}.
