Noi-HTTP i: ['HTTP-poʻo:'] hana: { :kī <- Polokalamu hoʻonohonoho: kī.
}.

>> Poʻo-HTTP := Mea hou.

Poʻo-HTTP i: ['hou'] hana: { <- iho hou hoʻomākaukau.
}.

Poʻo-HTTP i: ['hoʻomākaukau'] hana: {
	ponoʻī kī := ʻOle.
	ponoʻī waiwai := ʻOle.
}.

Poʻo-HTTP i: ['kī:waiwai:'] hana: { :kī :waiwai
	ponoʻī kī := kī.
	ponoʻī waiwai := waiwai.
}.

Poʻo-HTTP i: ['kī'] hana: { <- ponoʻī kī.
}.

Poʻo-HTTP i: ['waiwai'] hana: { <- ponoʻī waiwai.
}.


Poʻo-HTTP i: ['kaula'] hana: {
	>> lālani := ponoʻī kī + [': '] + ponoʻī waiwai.
	lālani pani: ['\r'] me: [''], pani: ['\n'] me: ['']. <- lālani + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Palapala-Pūnaewele := Mea hou.

Palapala-Pūnaewele i: ['hou'] hana: { <- iho hou hoʻomākaukau.
}.

Palapala-Pūnaewele i: ['hoʻomākaukau'] hana: {
	ponoʻī nā-poʻo := Papa hou.
	ponoʻī id-kau := ʻOle.
	ponoʻī luna-kau := Kau-waihona-manawa hou.
	ponoʻī ʻikepili-kau := ʻOle.
	ponoʻī palekana := ʻOiaʻiʻo.
	ponoʻī pūnaewele-like := ['Strict'].
	ponoʻī ua-hoʻouna-nā-poʻo := Wahaheʻe.
	ponoʻī noi-http := Noi-HTTP hou.
}.

Palapala-Pūnaewele i: ['noi-http:'] hana: { :noi-http
	ponoʻī noi-http := noi-http.
}. 

Palapala-Pūnaewele i: ['kuki-kau-palekana:'] hana: { :palekana
	iho nānā-i-nā-poʻo.
	ponoʻī palekana := palekana.
}.

Palapala-Pūnaewele i: ['kuki-kau-pūnaewele-like:'] hana: { :waiwai
	iho nānā-i-nā-poʻo.
	>> nā-koho := Papa hou 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	nā-koho loaʻa: waiwai, wahaheʻe: {
		kēia-hana kuhi-hewa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ponoʻī pūnaewele-like := waiwai.
}.

Palapala-Pūnaewele i: ['poʻo:'] hana: { :poʻo
	iho nānā-i-nā-poʻo.
	ponoʻī nā-poʻo pākuʻi-hope: poʻo.
}.

Palapala-Pūnaewele i: ['hoʻokaʻawale-poʻo'] hana: {
	iho nānā-i-nā-poʻo.
	ponoʻī nā-poʻo := Papa hou.
}.

Palapala-Pūnaewele i: ['luna-kau:'] hana: { :luna
	iho nānā-i-nā-poʻo.
	ponoʻī luna-kau := luna.
}.

Palapala-Pūnaewele i: ['luna-kau'] hana: { <- ponoʻī luna-kau.
}.

Palapala-Pūnaewele i: ['nānā-i-nā-poʻo'] hana: {
	ponoʻī ua-hoʻouna-nā-poʻo ʻoiaʻiʻo: {
		kēia-hana kuhi-hewa: ['Headers already sent to client.'].
	}.
}.

Palapala-Pūnaewele i: ['hoʻomaka-kau'] hana: {
	iho nānā-i-nā-poʻo.
	>> noi-http := ponoʻī noi-http.
	>> id-kau := noi-http cookie: ['xsid'].
	id-kau ʻOle? wahaheʻe: {
		(( Lauana hou: ['^[A-Za-z0-9]+\\z'], kūlike: id-kau ) = 0) ʻoiaʻiʻo: {
			id-kau := ʻOle.
		}.
	}.
	id-kau ʻOle? ʻoiaʻiʻo: {
		id-kau := Pahu-kūʻono token: 30.
		>> poʻo-kau := Poʻo-HTTP hou
		kī: ['Set-Cookie'] waiwai: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ponoʻī palekana a-i-ʻole: ['Secure'] a-i: ['']),
		SSITE: (ponoʻī pūnaewele-like),
		XSID: id-kau
		).
		ponoʻī nā-poʻo pākuʻi-hope: poʻo-kau.
	}.
	ponoʻī ʻikepili-kau := ponoʻī luna-kau no: id-kau, hoʻouka. <- ponoʻī ʻikepili-kau. # reference
}.

Palapala-Pūnaewele i: ['hele-i:'] hana: { :helu-wahi
	iho nānā-i-nā-poʻo.
	iho hoʻokaʻawale-poʻo.
	ponoʻī nā-poʻo
	pākuʻi-hope: (
		Poʻo-HTTP hou
		kī: ['Status'] waiwai: ['303 See Other']
	),
	pākuʻi-hope: (
		Poʻo-HTTP hou
		kī: ['Location'] waiwai: helu-wahi
	).
	iho hoʻopuka: ['Redirect'].
}.

Palapala-Pūnaewele i: ['luku-kau'] hana: {
	iho nānā-i-nā-poʻo.
	>> noi-http := ponoʻī noi-http.
	>> id-kau := noi-http cookie: ['xsid'].
	id-kau ʻOle? wahaheʻe: {
		>> poʻo-kau := Poʻo-HTTP hou.
		>> manawa-pau := Manawa hou makahiki: 1970, hōʻano: ['%a, %d %b %Y %H:%M:%S GMT'].
		poʻo-kau kī: ['Set-Cookie'] waiwai: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: manawa-pau,
			SEC: (ponoʻī palekana a-i-ʻole: ['Secure'] a-i: ['']),
			SSITE: (ponoʻī pūnaewele-like),
			XSID: id-kau
		).
		ponoʻī luna-kau luku.
		ponoʻī nā-poʻo pākuʻi-hope: poʻo-kau.
	}.
}.


Palapala-Pūnaewele i: ['kumu-hoʻohālike:'] hana: { :ala-waihona <- Kumu-hoʻohālike hou: (Waihona hou: ala-waihona, heluhelu).
}.

Palapala-Pūnaewele i: ['hoʻopuka:ʻano:'] hana: { :hopena :ʻano
	ponoʻī ua-hoʻouna-nā-poʻo wahaheʻe: {
		ponoʻī ʻikepili-kau ʻOle? wahaheʻe: {
			ponoʻī luna-kau mālama: ponoʻī ʻikepili-kau.
		}.
		ponoʻī nā-poʻo pākuʻi-hope: (
			Poʻo-HTTP hou
			kī: ['Content-type'] waiwai: ʻano
		).
		ponoʻī nā-poʻo pākahi: { :_ :poʻo
			Huapuka kākau: poʻo.
		}.
		ponoʻī ua-hoʻouna-nā-poʻo := ʻOiaʻiʻo.
		Huapuka kākau: ['\r\n'].
	}.
	Huapuka kākau: hopena.
}.

Palapala-Pūnaewele i: ['hoʻopau:ʻano:'] hana: { :hopena :ʻano
	ponoʻī ua-hoʻouna-nā-poʻo wahaheʻe: {
		ponoʻī ʻikepili-kau ʻOle? wahaheʻe: {
			ponoʻī luna-kau mālama: ponoʻī ʻikepili-kau.
		}.
		ponoʻī nā-poʻo pākuʻi-hope: (
			Poʻo-HTTP hou
			kī: ['Content-type'] waiwai: ʻano
		).
		ponoʻī nā-poʻo pākuʻi-hope: (
			Poʻo-HTTP hou
			kī: ['Content-Length'] waiwai: hopena kaula bytes
		).
		ponoʻī nā-poʻo pākahi: { :_ :poʻo
			Huapuka kākau: poʻo.
		}.
		ponoʻī ua-hoʻouna-nā-poʻo := ʻOiaʻiʻo.
		Huapuka kākau: ['\r\n'].
	}.
	Huapuka kākau: hopena.
}.

Palapala-Pūnaewele i: ['hoʻopuka:'] hana: { :hopena
	iho hoʻopuka: hopena ʻano: ['text/html; charset=utf-8'].
}.

Palapala-Pūnaewele i: ['hoʻopau:'] hana: { :hopena
	iho hoʻopau: hopena ʻano: ['text/html; charset=utf-8'].
}.

Palapala-Pūnaewele i: ['json:'] hana: { :hopena
	iho hoʻopuka: ( JSON jsonify: hopena ) ʻano: ['application/json'].
}.

Palapala-Pūnaewele i: ['ʻaʻole-loaʻa:'] hana: { :hopena
	iho hoʻokaʻawale-poʻo poʻo: (
		Poʻo-HTTP hou kī: ['Status'] waiwai: ['404 Not Found']
	).
	iho hoʻopuka: hopena.
}.


# Interface

>> Kau := Mea hou.

Kau i: ['hou'] hana: { <- iho hou hoʻomākaukau no: ʻOle.
}.

Kau i: ['no:'] hana: { :id
	ponoʻī id := id.
}.

Kau i: ['hoʻouka'] hana: {
	kēia-hana kuhi-hewa: ['Not implemented.'].
}.

Kau i: ['mālama:'] hana: {
	kēia-hana kuhi-hewa: ['Not implemented.'].
}.

Kau i: ['luku'] hana: {
	kēia-hana kuhi-hewa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Kau-waihona-manawa := Kau hou.

Kau-waihona-manawa i: ['hoʻomākaukau'] hana: {
	ponoʻī hoʻomaka-ala := ['/tmp/sess-'].
}.

Kau-waihona-manawa i: ['poʻo-ala:'] hana: { :kaula-hua
	ponoʻī hoʻomaka-ala := kaula-hua.
}.

Kau-waihona-manawa i: ['waihona-kau'] hana: { <- ( Waihona hou: ( ponoʻī hoʻomaka-ala + ponoʻī id + ['.txt'] ) ).
}.

Kau-waihona-manawa i: ['hoʻouka'] hana: {
	>> waihona-kau := iho waihona-kau.
	waihona-kau aia wahaheʻe: {
		waihona-kau kākau: (Puke-wehewehe hou pāʻālua).
	}. <- waihona-kau heluhelu mea.
}.

Kau-waihona-manawa i: ['mālama:'] hana: { :ʻikepili
	>> waihona-kau := iho waihona-kau.
	waihona-kau aia ʻoiaʻiʻo: {
		waihona-kau kākau: ʻikepili pāʻālua.
	}.
}.

Kau-waihona-manawa i: ['luku'] hana: {
	>> waihona-kau := iho waihona-kau.
	waihona-kau aia ʻoiaʻiʻo: {
		waihona-kau hoʻopau.
	}.
}.


>> URL := Mea hou.

URL i: ['hoʻomākaukau'] hana: {
	ponoʻī kaʻina-kamaʻilio := ['https://'].
	ponoʻī hoʻokipa := ['localhost'].
	ponoʻī ala-waihona := [''].
	ponoʻī nā-palena-url := [''].
	ponoʻī hash := [''].
}.

URL i: ['hou'] hana: { <- iho hou hoʻomākaukau.
}.

URL i: ['kaula'] hana: { <- (
	ponoʻī kaʻina-kamaʻilio +
	ponoʻī hoʻokipa +
	ponoʻī ala-waihona +
	ponoʻī nā-palena-url +
	ponoʻī hash ).
}.

URL i: ['kaʻina-kamaʻilio:'] hana: { :kaʻina-kamaʻilio
	((Papa hou ; ['http'] ; ['https']) loaʻa: kaʻina-kamaʻilio) ʻoiaʻiʻo: {
		ponoʻī kaʻina-kamaʻilio := kaʻina-kamaʻilio + ['://'].
	}, wahaheʻe: {
		kēia-hana kuhi-hewa: ['Invalid protocol'].
	}.
}.

URL i: ['hoʻokipa:'] hana: { :hoʻokipa
	#todo validate according to rfc
	ponoʻī hoʻokipa := hoʻokipa.
}.

URL i: ['ala-waihona:'] hana: { :ala-waihona
	ponoʻī ala-waihona := ['/'] + ala-waihona url-hoʻopāʻālua.
}.

URL i: ['nā-palena-url:'] hana: { :palapala-ʻāina
	>> nā-palena-url := Papa hou.
	palapala-ʻāina pākahi: { :kī :waiwai
		nā-palena-url pākuʻi-hope: kī kaula url-hoʻopāʻālua + ['='] + waiwai kaula url-hoʻopāʻālua.
	}.
	ponoʻī nā-palena-url := ['?'] + ( nā-palena-url hoʻohui: ['&'] ).
}.

URL i: ['hash:'] hana: { :hash
	ponoʻī hash := ['#'] + hash url-hoʻopāʻālua.
}.

