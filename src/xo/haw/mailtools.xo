>> Leka-uila := Mea hou.

Leka-uila i: ['hoʻomākaukau'] hana: {
	ponoʻī nā-mea-loaʻa := Papa hou.
	ponoʻī cc := Papa hou.
	ponoʻī bcc := Papa hou.
	ponoʻī mea-hoʻouna := ʻOle.
	ponoʻī inoa-mea-hoʻouna := ʻOle.
	ponoʻī kumuhana := ʻOle.
	ponoʻī kino := ʻOle.
}.

Leka-uila i: ['hou'] hana: { <- iho hou hoʻomākaukau.
}.

Leka-uila i: ['iā:'] hana: { :helu-papa
	ponoʻī nā-mea-loaʻa := helu-papa.
}.
 
Leka-uila i: ['cc:'] hana: { :helu-papa
	ponoʻī cc := helu-papa.
}.

Leka-uila i: ['bcc:'] hana: { :helu-papa
	ponoʻī bcc := helu-papa.
}.

Leka-uila i: ['kumuhana:'] hana: { :kumuhana
	ponoʻī kumuhana := kumuhana.
}.

Leka-uila i: ['mea-hoʻouna:inoa:'] hana: { :mea-hoʻouna :inoa
	ponoʻī mea-hoʻouna := mea-hoʻouna.
	ponoʻī inoa-mea-hoʻouna := inoa.
}.

Leka-uila i: ['kino:'] hana: { :kino
	ponoʻī kino := kino.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Leka-uila i: ['poʻo:'] hana: { :lālani <- lālani pani: ['\r'] me: [''], pani: ['\n'] me: [''].
}.

Leka-uila i: ['hoʻouna'] hana: {
	>> f := Waihona tempwrite: iho hoʻopuka-hou.
	Polokalamu ʻōnaehana: ['sendmail -t < '] + f ala-waihona, laina-hou.
}.

Leka-uila i: ['hoʻopuka-hou'] hana: {
	>> hoʻokaʻawale-lālani := ['\r\n'].
	>> kaula-hua := [''].
	kaula-hua pākuʻi-hope: (iho poʻo: ['From: '] + ponoʻī inoa-mea-hoʻouna + [' <'] + ( ponoʻī mea-hoʻouna ) + ['>']) + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: (iho poʻo: ['To: '] + ( ponoʻī nā-mea-loaʻa hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	ponoʻī cc heluna ʻoiaʻiʻo: {
		kaula-hua pākuʻi-hope: (iho poʻo: ['Cc: '] + ( ponoʻī cc hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	}.
	ponoʻī bcc heluna ʻoiaʻiʻo: {
		kaula-hua pākuʻi-hope: (iho poʻo: ['Bcc: '] + ( ponoʻī bcc hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	}.
	kaula-hua pākuʻi-hope: (iho poʻo: ['Subject: '] + ponoʻī kumuhana) + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ponoʻī kino.
	kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani. <- kaula-hua.
}.

>> Leka-uila-HTML := Leka-uila hou.

Leka-uila-HTML i: ['hoʻomākaukau'] hana: {
	iho hoʻomākaukau.
	ponoʻī nā-pili := Papa hou.
	ponoʻī palena := Pahu-kūʻono token: 40.
}.

Leka-uila-HTML i: ['hoʻopili-waihona:'] hana: { :waihona-kau
	>> id := ponoʻī nā-pili heluna.
	>> blob := waihona-kau blob.
	ponoʻī nā-pili pākuʻi-hope: (
		Puke-wehewehe hou
			waihona-kau: waihona-kau ala-waihona,
			mime: ['image/'] + (Server mimetype: waihona-kau ala-waihona),
			ʻikepili: blob base64-hoʻopāʻālua
	).
	blob hoʻokuʻu. <- ['cid:attachment'] + id.
}.

Leka-uila-HTML i: ['hoʻopuka-hou'] hana: {
	>> hoʻokaʻawale-lālani := ['\r\n'].
	>> kaula-hua := [''].
	kaula-hua pākuʻi-hope: (iho poʻo: ['From: '] + ponoʻī inoa-mea-hoʻouna + [' <'] + ( ponoʻī mea-hoʻouna ) + ['>']) + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: (iho poʻo: ['To: '] + ( ponoʻī nā-mea-loaʻa hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	ponoʻī cc heluna ʻoiaʻiʻo: {
		kaula-hua pākuʻi-hope: (iho poʻo: ['Cc: '] + ( ponoʻī cc hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	}.
	ponoʻī bcc heluna ʻoiaʻiʻo: {
		kaula-hua pākuʻi-hope: (iho poʻo: ['Bcc: '] + ( ponoʻī bcc hoʻohui: [','] )) + hoʻokaʻawale-lālani.
	}.
	kaula-hua pākuʻi-hope: (iho poʻo: ['Subject: '] + ponoʻī kumuhana) + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ['MIME-Version: 1.0'] + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ['Content-Type: multipart/related; boundary="'] + ponoʻī palena + ['"; type=text/html'] + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ['--'] + ponoʻī palena + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ['Content-Type: text/html; charset=UTF-8'] + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ['Content-Transfer-Encoding: 7bit'] + hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
	kaula-hua pākuʻi-hope: ponoʻī kino.
	kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
	ponoʻī nā-pili pākahi: { :id :ʻike
		>> blob := ʻike ʻikepili.
		kaula-hua pākuʻi-hope: ['--'] + ponoʻī palena + hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: ['Content-Type: '] + ʻike mime + hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: ['Content-Transfer-Encoding: base64'] + hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: ['Content-ID: <attachment'] + id + ['>'] + hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: ['Content-Disposition: inline; filename="'] + ʻike waihona-kau + ['"'] + hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
		>> ka-nui-loa := 76.
		>> lōʻihi-kikokikona := blob lōʻihi.
		>> nā-ʻāpana-ʻikepili := (lōʻihi-kikokikona / ka-nui-loa) hoʻopiʻi-helu.
		{ :i
			>> ʻāpana-ʻikepili := blob kope mai: i * ka-nui-loa lōʻihi: ka-nui-loa.
			kaula-hua pākuʻi-hope: ʻāpana-ʻikepili + hoʻokaʻawale-lālani.
		} * nā-ʻāpana-ʻikepili.
		kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
		kaula-hua pākuʻi-hope: hoʻokaʻawale-lālani.
	}.
	kaula-hua pākuʻi-hope: ['--'] + ponoʻī palena + ['--'] + hoʻokaʻawale-lālani. <- kaula-hua.
}.
