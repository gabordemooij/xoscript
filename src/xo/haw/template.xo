
# ~ Simple template engine ~

>> Kumu-hoʻohālike := Mea hou.

Kumu-hoʻohālike i: ['hou'] hana: { <- iho hou ʻike-loko: [''].
}.

Kumu-hoʻohālike i: ['ʻike-loko:'] hana: { :ʻike-loko
	ponoʻī ʻike-loko := ʻike-loko. 
}.

Kumu-hoʻohālike i: ['hou:'] hana: { :ʻike-loko <- iho hou ʻike-loko: ʻike-loko.
}.

Kumu-hoʻohālike i: ['ʻoki:'] hana: { :kaha
	>> kaha-mua := (['<!-- cut:%id% -->'] %id%: kaha).
	>> kaha-hope := (['<!-- /cut:%id% -->'] %id%: kaha).
	>> nā-hapa := ponoʻī ʻike-loko hoʻokaʻawale: kaha-mua.
	>> poʻo-mua := nā-hapa mua.
	>> nā-hapa2 := nā-hapa hope hoʻokaʻawale: kaha-hope.
	>> hope-pili := nā-hapa2 hope.
	>> hapa := nā-hapa2 mua.
	>> koena := poʻo-mua + hope-pili.
	ponoʻī ʻike-loko := koena. <- Kumu-hoʻohālike hou: hapa.
	
}.

Kumu-hoʻohālike i: ['kope'] hana: { <- iho hou: iho kaula kope.
}.
	
Kumu-hoʻohālike i: ['kāpili:ma:'] hana: { :ʻāpana-ʻōlelo :id
	>> kaha-kāpili := (['<!-- paste:%id% -->'] %id%: id).
	ponoʻī ʻike-loko pani: kaha-kāpili me: ( ʻāpana-ʻōlelo kaula + kaha-kāpili ).
}.

Kumu-hoʻohālike i: ['kau:waiwai:'] hana: { :wahi :waiwai
	ponoʻī ʻike-loko pani: ['<!-- slot:'] + wahi + [' -->'] me: ( Server html-hoʻopāʻālua: waiwai ).
}.

Kumu-hoʻohālike i: ['kau:html:'] hana: { :wahi :html
	ponoʻī ʻike-loko pani: ['<!-- slot:'] + wahi + [' -->'] me: html.
}.

Kumu-hoʻohālike i: ['pane:a:'] hana: { :wahi :waiwai
	iho kau: (wahi mai: 0 lōʻihi: (wahi lōʻihi - 1)) waiwai: waiwai.
}.

Kumu-hoʻohālike i: ['nl2br'] hana: {
	ponoʻī ʻike-loko pani: ['\n'] me: ['<br>'].
}.

Kumu-hoʻohālike i: ['hoʻonani'] hana: {
	ponoʻī ʻike-loko :=
		Lauana
		hou: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		kūlike: ponoʻī ʻike-loko
		hana: { <- ['']. }.
}.

Kumu-hoʻohālike i: ['hoʻonani-ʻokina'] hana: {
	>> nā-mea := Papa hou.
	Lauana
	hou: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	kūlike: ponoʻī ʻike-loko
	hana: { :_ :hapa
		nā-mea pākuʻi-hope: hapa ? 1.
	}.
	nā-mea pākahi: { :_ :id
		ponoʻī ʻike-loko :=
			Lauana hou: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			kūlike: ponoʻī ʻike-loko
			hana: { <- ['']. }.
	 }.
}.

Kumu-hoʻohālike i: ['hoʻonani-hakahaka'] hana: {
	ponoʻī ʻike-loko :=
		Lauana
		hou: ['\\s*\\n'],
		kūlike: ponoʻī ʻike-loko
		hana: { <- ['\n']. }.
	ponoʻī ʻike-loko :=
		Lauana
		hou: ['\\n[\\s\\t]+'],
		kūlike: ponoʻī ʻike-loko
		hana: { <- ['\n']. }.
}.

Kumu-hoʻohālike i: ['hoʻonani-a-pau'] hana: {
	iho hoʻonani.
	iho hoʻonani-ʻokina.
	iho hoʻonani-hakahaka.
}.

Kumu-hoʻohālike i: ['kaula'] hana: { <- ponoʻī ʻike-loko.
}.
