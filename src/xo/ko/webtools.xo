HTTP-요청 받으면: ['HTTP-header:'] 실행: { :key <- 프로그램 설정값: key.
}.

>> HTTP-Header := 객체 새로.

HTTP-Header 받으면: ['새로'] 실행: { <- 자신 새로 init.
}.

HTTP-Header 받으면: ['init'] 실행: {
	자기 key := 없음.
	자기 value := 없음.
}.

HTTP-Header 받으면: ['key:value:'] 실행: { :key :value
	자기 key := key.
	자기 value := value.
}.

HTTP-Header 받으면: ['key'] 실행: { <- 자기 key.
}.

HTTP-Header 받으면: ['value'] 실행: { <- 자기 value.
}.


HTTP-Header 받으면: ['문자열로'] 실행: {
	>> line := 자기 key + [': '] + 자기 value.
	line 바꾸기: ['\r'] 새값: [''], 바꾸기: ['\n'] 새값: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := 객체 새로.

Web-Document 받으면: ['새로'] 실행: { <- 자신 새로 init.
}.

Web-Document 받으면: ['init'] 실행: {
	자기 headers := 리스트 새로.
	자기 sess-id := 없음.
	자기 session-manager := Tempfile-Session 새로.
	자기 sessdata := 없음.
	자기 secure := 참.
	자기 same-site := ['Strict'].
	자기 headers-out := 거짓.
	자기 request := HTTP-요청 새로.
}.

Web-Document 받으면: ['request:'] 실행: { :request
	자기 request := request.
}. 

Web-Document 받으면: ['secure-session-cookie:'] 실행: { :secure
	자신 check-headers.
	자기 secure := secure.
}.

Web-Document 받으면: ['same-site-session-cookie:'] 실행: { :value
	자신 check-headers.
	>> options := 리스트 새로 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options 포함: value, 거짓이면: {
		이작업 오류: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	자기 same-site := value.
}.

Web-Document 받으면: ['header:'] 실행: { :header
	자신 check-headers.
	자기 headers 뒤에추가: header.
}.

Web-Document 받으면: ['clear-headers'] 실행: {
	자신 check-headers.
	자기 headers := 리스트 새로.
}.

Web-Document 받으면: ['session-manager:'] 실행: { :manager
	자신 check-headers.
	자기 session-manager := manager.
}.

Web-Document 받으면: ['session-manager'] 실행: { <- 자기 session-manager.
}.

Web-Document 받으면: ['check-headers'] 실행: {
	자기 headers-out 참이면: {
		이작업 오류: ['Headers already sent to client.'].
	}.
}.

Web-Document 받으면: ['session-start'] 실행: {
	자신 check-headers.
	>> request := 자기 request.
	>> sess-id := request cookie: ['xsid'].
	sess-id 없음? 거짓이면: {
		(( 패턴 새로: ['^[A-Za-z0-9]+\\z'], 일치: sess-id ) = 0) 참이면: {
			sess-id := 없음.
		}.
	}.
	sess-id 없음? 참이면: {
		sess-id := 금고 토큰: 30.
		>> session-header := HTTP-Header 새로
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (자기 secure 둘중하나: ['Secure'] 또는: ['']),
		SSITE: (자기 same-site),
		XSID: sess-id
		).
		자기 headers 뒤에추가: session-header.
	}.
	자기 sessdata := 자기 session-manager for: sess-id, load. <- 자기 sessdata. # reference
}.

Web-Document 받으면: ['goto:'] 실행: { :url
	자신 check-headers.
	자신 clear-headers.
	자기 headers
	뒤에추가: (
		HTTP-Header 새로
		key: ['Status'] value: ['303 See Other']
	),
	뒤에추가: (
		HTTP-Header 새로
		key: ['Location'] value: url
	).
	자신 out: ['Redirect'].
}.

Web-Document 받으면: ['session-destroy'] 실행: {
	자신 check-headers.
	>> request := 자기 request.
	>> sess-id := request cookie: ['xsid'].
	sess-id 없음? 거짓이면: {
		>> session-header := HTTP-Header 새로.
		>> when := 시점 새로 연도: 1970, 형식: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (자기 secure 둘중하나: ['Secure'] 또는: ['']),
			SSITE: (자기 same-site),
			XSID: sess-id
		).
		자기 session-manager destroy.
		자기 headers 뒤에추가: session-header.
	}.
}.


Web-Document 받으면: ['template:'] 실행: { :파일경로 <- Template 새로: (파일 새로: 파일경로, 읽기).
}.

Web-Document 받으면: ['out:type:'] 실행: { :output :유형
	자기 headers-out 거짓이면: {
		자기 sessdata 없음? 거짓이면: {
			자기 session-manager save: 자기 sessdata.
		}.
		자기 headers 뒤에추가: (
			HTTP-Header 새로
			key: ['Content-type'] value: 유형
		).
		자기 headers 각각: { :_ :header
			출력 쓰기: header.
		}.
		자기 headers-out := 참.
		출력 쓰기: ['\r\n'].
	}.
	출력 쓰기: output.
}.

Web-Document 받으면: ['finish:type:'] 실행: { :output :유형
	자기 headers-out 거짓이면: {
		자기 sessdata 없음? 거짓이면: {
			자기 session-manager save: 자기 sessdata.
		}.
		자기 headers 뒤에추가: (
			HTTP-Header 새로
			key: ['Content-type'] value: 유형
		).
		자기 headers 뒤에추가: (
			HTTP-Header 새로
			key: ['Content-Length'] value: output 문자열로 bytes
		).
		자기 headers 각각: { :_ :header
			출력 쓰기: header.
		}.
		자기 headers-out := 참.
		출력 쓰기: ['\r\n'].
	}.
	출력 쓰기: output.
}.

Web-Document 받으면: ['out:'] 실행: { :output
	자신 out: output type: ['text/html; charset=utf-8'].
}.

Web-Document 받으면: ['finish:'] 실행: { :output
	자신 finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document 받으면: ['json:'] 실행: { :output
	자신 out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document 받으면: ['not-found:'] 실행: { :output
	자신 clear-headers header: (
		HTTP-Header 새로 key: ['Status'] value: ['404 Not Found']
	).
	자신 out: output.
}.


# Interface

>> Session := 객체 새로.

Session 받으면: ['새로'] 실행: { <- 자신 새로 init for: 없음.
}.

Session 받으면: ['for:'] 실행: { :id
	자기 id := id.
}.

Session 받으면: ['load'] 실행: {
	이작업 오류: ['Not implemented.'].
}.

Session 받으면: ['save:'] 실행: {
	이작업 오류: ['Not implemented.'].
}.

Session 받으면: ['destroy'] 실행: {
	이작업 오류: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session 새로.

Tempfile-Session 받으면: ['init'] 실행: {
	자기 pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session 받으면: ['path-prefix:'] 실행: { :str
	자기 pathprefix := str.
}.

Tempfile-Session 받으면: ['file'] 실행: { <- ( 파일 새로: ( 자기 pathprefix + 자기 id + ['.txt'] ) ).
}.

Tempfile-Session 받으면: ['load'] 실행: {
	>> file := 자신 file.
	file 존재함 거짓이면: {
		file 쓰기: (사전 새로 코드).
	}. <- file 읽기 객체로.
}.

Tempfile-Session 받으면: ['save:'] 실행: { :data
	>> file := 자신 file.
	file 존재함 참이면: {
		file 쓰기: data 코드.
	}.
}.

Tempfile-Session 받으면: ['destroy'] 실행: {
	>> file := 자신 file.
	file 존재함 참이면: {
		file 삭제.
	}.
}.


>> URL := 객체 새로.

URL 받으면: ['init'] 실행: {
	자기 protocol := ['https://'].
	자기 호스트 := ['localhost'].
	자기 파일경로 := [''].
	자기 params := [''].
	자기 hash := [''].
}.

URL 받으면: ['새로'] 실행: { <- 자신 새로 init.
}.

URL 받으면: ['문자열로'] 실행: { <- (
	자기 protocol +
	자기 호스트 +
	자기 파일경로 +
	자기 params +
	자기 hash ).
}.

URL 받으면: ['protocol:'] 실행: { :protocol
	((리스트 새로: ['http'] ; ['https']) 포함: protocol) 참이면: {
		자기 protocol := protocol + ['://'].
	}, 거짓이면: {
		이작업 오류: ['Invalid protocol'].
	}.
}.

URL 받으면: ['호스트:'] 실행: { :호스트
	#todo validate according to rfc
	자기 호스트 := 호스트.
}.

URL 받으면: ['path:'] 실행: { :파일경로
	자기 파일경로 := ['/'] + 파일경로 url-인코딩.
}.

URL 받으면: ['params:'] 실행: { :map
	>> params := 리스트 새로.
	map 각각: { :key :value
		params 뒤에추가: key 문자열로 url-인코딩 + ['='] + value 문자열로 url-인코딩.
	}.
	자기 params := ['?'] + ( params 합치기: ['&'] ).
}.

URL 받으면: ['해시:'] 실행: { :hash
	자기 hash := ['#'] + hash url-인코딩.
}.

