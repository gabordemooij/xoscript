
# ~ Simple template engine ~

>> 템플릿 := 객체 새로.

템플릿 받으면: ['새로'] 실행: { <- 자신 새로 내용: [''].
}.

템플릿 받으면: ['내용:'] 실행: { :내용
	자기 내용 := 내용. 
}.

템플릿 받으면: ['새로:'] 실행: { :내용 <- 자신 새로 내용: 내용.
}.

템플릿 받으면: ['잘라내기:'] 실행: { :표시
	>> 시작표시 := (['<!-- cut:%id% -->'] %id%: 표시).
	>> 끝표시 := (['<!-- /cut:%id% -->'] %id%: 표시).
	>> 부분들 := 자기 내용 나누기: 시작표시.
	>> 접두사 := 부분들 첫번째.
	>> 부분들2 := 부분들 마지막 나누기: 끝표시.
	>> 접미사 := 부분들2 마지막.
	>> 부분 := 부분들2 첫번째.
	>> 나머지 := 접두사 + 접미사.
	자기 내용 := 나머지. <- 템플릿 새로: 부분.
	
}.

템플릿 받으면: ['복사'] 실행: { <- 자신 새로: 자신 문자열로 복사.
}.
	
템플릿 받으면: ['붙여넣기:위치:'] 실행: { :발췌 :id
	>> 붙여넣기표시 := (['<!-- paste:%id% -->'] %id%: id).
	자기 내용 바꾸기: 붙여넣기표시 새값: ( 발췌 문자열로 + 붙여넣기표시 ).
}.

템플릿 받으면: ['설정:값:'] 실행: { :자리 :설정값
	자기 내용 바꾸기: ['<!-- slot:'] + 자리 + [' -->'] 새값: ( Server html-인코딩: 설정값 ).
}.

템플릿 받으면: ['설정:html:'] 실행: { :자리 :html
	자기 내용 바꾸기: ['<!-- slot:'] + 자리 + [' -->'] 새값: html.
}.

템플릿 받으면: ['응답:그리고:'] 실행: { :자리 :설정값
	자신 설정: (자리 시작: 0 길이: (자리 길이 - 1)) 값: 설정값.
}.

템플릿 받으면: ['nl2br'] 실행: {
	자기 내용 바꾸기: ['\n'] 새값: ['<br>'].
}.

템플릿 받으면: ['표시제거'] 실행: {
	자기 내용 :=
		패턴
		새로: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		일치: 자기 내용
		실행: { <- ['']. }.
}.

템플릿 받으면: ['잘라낸부분제거'] 실행: {
	>> 항목들 := 리스트 새로.
	패턴
	새로: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	일치: 자기 내용
	실행: { :_ :부분
		항목들 뒤에추가: 부분 ? 1.
	}.
	항목들 각각: { :_ :id
		자기 내용 :=
			패턴 새로: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			일치: 자기 내용
			실행: { <- ['']. }.
	 }.
}.

템플릿 받으면: ['여백제거'] 실행: {
	자기 내용 :=
		패턴
		새로: ['\\s*\\n'],
		일치: 자기 내용
		실행: { <- ['\n']. }.
	자기 내용 :=
		패턴
		새로: ['\\n[\\s\\t]+'],
		일치: 자기 내용
		실행: { <- ['\n']. }.
}.

템플릿 받으면: ['모두제거'] 실행: {
	자신 표시제거.
	자신 잘라낸부분제거.
	자신 여백제거.
}.

템플릿 받으면: ['문자열로'] 실행: { <- 자기 내용.
}.
