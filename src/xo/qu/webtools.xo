Mañakuy-HTTP patapi: ['HTTP-uma:'] ruway: { :llave <- Programa wakichina: llave.
}.

>> HTTP-Uma := Ima musuq.

HTTP-Uma patapi: ['musuq'] ruway: { <- kikin musuq wakichiy.
}.

HTTP-Uma patapi: ['wakichiy'] ruway: {
	ñuqap llave := Mana.
	ñuqap chani := Mana.
}.

HTTP-Uma patapi: ['llave:chani:'] ruway: { :llave :chani
	ñuqap llave := llave.
	ñuqap chani := chani.
}.

HTTP-Uma patapi: ['llave'] ruway: { <- ñuqap llave.
}.

HTTP-Uma patapi: ['chani'] ruway: { <- ñuqap chani.
}.


HTTP-Uma patapi: ['qillqaman'] ruway: {
	>> siqi := ñuqap llave + [': '] + ñuqap chani.
	siqi rantinpay: ['\r'] kayta: [''], rantinpay: ['\n'] kayta: ['']. <- siqi + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Llika-qillqa := Ima musuq.

Llika-qillqa patapi: ['musuq'] ruway: { <- kikin musuq wakichiy.
}.

Llika-qillqa patapi: ['wakichiy'] ruway: {
	ñuqap umakuna := Katiray musuq.
	ñuqap tantanakuy-id := Mana.
	ñuqap tantanakuy-kamachiq := Pachallapaq-willañiqi-tantanakuy musuq.
	ñuqap tantanakuy-willakuy := Mana.
	ñuqap takyasqa := Chiqap.
	ñuqap kikin-llika := ['Strict'].
	ñuqap umakuna-kachasqa := Llulla.
	ñuqap mañakuy-http := Mañakuy-HTTP musuq.
}.

Llika-qillqa patapi: ['mañakuy-http:'] ruway: { :mañakuy-http
	ñuqap mañakuy-http := mañakuy-http.
}. 

Llika-qillqa patapi: ['takyasqa-tantanakuy-cookie:'] ruway: { :takyasqa
	kikin umakunata-qawariy.
	ñuqap takyasqa := takyasqa.
}.

Llika-qillqa patapi: ['kikin-llika-tantanakuy-cookie:'] ruway: { :chani
	kikin umakunata-qawariy.
	>> akllanakuna := Katiray musuq 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	akllanakuna kanmi: chani, llullaqtin: {
		kay-ruway pantay: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ñuqap kikin-llika := chani.
}.

Llika-qillqa patapi: ['uma:'] ruway: { :uma
	kikin umakunata-qawariy.
	ñuqap umakuna yapay-qhepaman: uma.
}.

Llika-qillqa patapi: ['umakunata-qichuy'] ruway: {
	kikin umakunata-qawariy.
	ñuqap umakuna := Katiray musuq.
}.

Llika-qillqa patapi: ['tantanakuy-kamachiq:'] ruway: { :kamachiq
	kikin umakunata-qawariy.
	ñuqap tantanakuy-kamachiq := kamachiq.
}.

Llika-qillqa patapi: ['tantanakuy-kamachiq'] ruway: { <- ñuqap tantanakuy-kamachiq.
}.

Llika-qillqa patapi: ['umakunata-qawariy'] ruway: {
	ñuqap umakuna-kachasqa chiqapqtin: {
		kay-ruway pantay: ['Headers already sent to client.'].
	}.
}.

Llika-qillqa patapi: ['tantanakuyta-qallariy'] ruway: {
	kikin umakunata-qawariy.
	>> mañakuy-http := ñuqap mañakuy-http.
	>> tantanakuy-id := mañakuy-http cookie: ['xsid'].
	tantanakuy-id Manachu? llullaqtin: {
		(( Rikchʼaq musuq: ['^[A-Za-z0-9]+\\z'], tinkuy: tantanakuy-id ) = 0) chiqapqtin: {
			tantanakuy-id := Mana.
		}.
	}.
	tantanakuy-id Manachu? chiqapqtin: {
		tantanakuy-id := Waqaychana token: 30.
		>> tantanakuy-uma := HTTP-Uma musuq
		llave: ['Set-Cookie'] chani: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ñuqap takyasqa kaypas: ['Secure'] chaypas: ['']),
		SSITE: (ñuqap kikin-llika),
		XSID: tantanakuy-id
		).
		ñuqap umakuna yapay-qhepaman: tantanakuy-uma.
	}.
	ñuqap tantanakuy-willakuy := ñuqap tantanakuy-kamachiq kaqpaq: tantanakuy-id, apamuy. <- ñuqap tantanakuy-willakuy. # reference
}.

Llika-qillqa patapi: ['riy:'] ruway: { :maypi
	kikin umakunata-qawariy.
	kikin umakunata-qichuy.
	ñuqap umakuna
	yapay-qhepaman: (
		HTTP-Uma musuq
		llave: ['Status'] chani: ['303 See Other']
	),
	yapay-qhepaman: (
		HTTP-Uma musuq
		llave: ['Location'] chani: maypi
	).
	kikin hurquy: ['Redirect'].
}.

Llika-qillqa patapi: ['tantanakuyta-chinkachiy'] ruway: {
	kikin umakunata-qawariy.
	>> mañakuy-http := ñuqap mañakuy-http.
	>> tantanakuy-id := mañakuy-http cookie: ['xsid'].
	tantanakuy-id Manachu? llullaqtin: {
		>> tantanakuy-uma := HTTP-Uma musuq.
		>> tukuy-pacha := Pacha musuq wata: 1970, formatopi: ['%a, %d %b %Y %H:%M:%S GMT'].
		tantanakuy-uma llave: ['Set-Cookie'] chani: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tukuy-pacha,
			SEC: (ñuqap takyasqa kaypas: ['Secure'] chaypas: ['']),
			SSITE: (ñuqap kikin-llika),
			XSID: tantanakuy-id
		).
		ñuqap tantanakuy-kamachiq chinkachiy.
		ñuqap umakuna yapay-qhepaman: tantanakuy-uma.
	}.
}.


Llika-qillqa patapi: ['rikchana:'] ruway: { :ñan <- Rikchana musuq: (Khipu musuq: ñan, ñawiy).
}.

Llika-qillqa patapi: ['hurquy:laya:'] ruway: { :lluqsiy :laya
	ñuqap umakuna-kachasqa llullaqtin: {
		ñuqap tantanakuy-willakuy Manachu? llullaqtin: {
			ñuqap tantanakuy-kamachiq waqaychay: ñuqap tantanakuy-willakuy.
		}.
		ñuqap umakuna yapay-qhepaman: (
			HTTP-Uma musuq
			llave: ['Content-type'] chani: laya
		).
		ñuqap umakuna sapallanpaq: { :_ :uma
			Lluqsiy qillqay: uma.
		}.
		ñuqap umakuna-kachasqa := Chiqap.
		Lluqsiy qillqay: ['\r\n'].
	}.
	Lluqsiy qillqay: lluqsiy.
}.

Llika-qillqa patapi: ['tukuchiy:laya:'] ruway: { :lluqsiy :laya
	ñuqap umakuna-kachasqa llullaqtin: {
		ñuqap tantanakuy-willakuy Manachu? llullaqtin: {
			ñuqap tantanakuy-kamachiq waqaychay: ñuqap tantanakuy-willakuy.
		}.
		ñuqap umakuna yapay-qhepaman: (
			HTTP-Uma musuq
			llave: ['Content-type'] chani: laya
		).
		ñuqap umakuna yapay-qhepaman: (
			HTTP-Uma musuq
			llave: ['Content-Length'] chani: lluqsiy qillqaman bytes
		).
		ñuqap umakuna sapallanpaq: { :_ :uma
			Lluqsiy qillqay: uma.
		}.
		ñuqap umakuna-kachasqa := Chiqap.
		Lluqsiy qillqay: ['\r\n'].
	}.
	Lluqsiy qillqay: lluqsiy.
}.

Llika-qillqa patapi: ['hurquy:'] ruway: { :lluqsiy
	kikin hurquy: lluqsiy laya: ['text/html; charset=utf-8'].
}.

Llika-qillqa patapi: ['tukuchiy:'] ruway: { :lluqsiy
	kikin tukuchiy: lluqsiy laya: ['text/html; charset=utf-8'].
}.

Llika-qillqa patapi: ['json:'] ruway: { :lluqsiy
	kikin hurquy: ( JSON jsonify: lluqsiy ) laya: ['application/json'].
}.

Llika-qillqa patapi: ['mana-tarisqachu:'] ruway: { :lluqsiy
	kikin umakunata-qichuy uma: (
		HTTP-Uma musuq llave: ['Status'] chani: ['404 Not Found']
	).
	kikin hurquy: lluqsiy.
}.


# Interface

>> Tantanakuy := Ima musuq.

Tantanakuy patapi: ['musuq'] ruway: { <- kikin musuq wakichiy kaqpaq: Mana.
}.

Tantanakuy patapi: ['kaqpaq:'] ruway: { :id
	ñuqap id := id.
}.

Tantanakuy patapi: ['apamuy'] ruway: {
	kay-ruway pantay: ['Not implemented.'].
}.

Tantanakuy patapi: ['waqaychay:'] ruway: {
	kay-ruway pantay: ['Not implemented.'].
}.

Tantanakuy patapi: ['chinkachiy'] ruway: {
	kay-ruway pantay: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Pachallapaq-willañiqi-tantanakuy := Tantanakuy musuq.

Pachallapaq-willañiqi-tantanakuy patapi: ['wakichiy'] ruway: {
	ñuqap ñan-qallariy := ['/tmp/sess-'].
}.

Pachallapaq-willañiqi-tantanakuy patapi: ['ñan-ñawpaqnin:'] ruway: { :qillqa-watu
	ñuqap ñan-qallariy := qillqa-watu.
}.

Pachallapaq-willañiqi-tantanakuy patapi: ['tantanakuy-willañiqi'] ruway: { <- ( Khipu musuq: ( ñuqap ñan-qallariy + ñuqap id + ['.txt'] ) ).
}.

Pachallapaq-willañiqi-tantanakuy patapi: ['apamuy'] ruway: {
	>> tantanakuy-willañiqi := kikin tantanakuy-willañiqi.
	tantanakuy-willañiqi kan llullaqtin: {
		tantanakuy-willañiqi qillqay: (Simi-taqi musuq codigo).
	}. <- tantanakuy-willañiqi ñawiy imaman.
}.

Pachallapaq-willañiqi-tantanakuy patapi: ['waqaychay:'] ruway: { :willakuy
	>> tantanakuy-willañiqi := kikin tantanakuy-willañiqi.
	tantanakuy-willañiqi kan chiqapqtin: {
		tantanakuy-willañiqi qillqay: willakuy codigo.
	}.
}.

Pachallapaq-willañiqi-tantanakuy patapi: ['chinkachiy'] ruway: {
	>> tantanakuy-willañiqi := kikin tantanakuy-willañiqi.
	tantanakuy-willañiqi kan chiqapqtin: {
		tantanakuy-willañiqi pichay.
	}.
}.


>> URL := Ima musuq.

URL patapi: ['wakichiy'] ruway: {
	ñuqap kamachiy-ñan := ['https://'].
	ñuqap samachiq := ['localhost'].
	ñuqap ñan := [''].
	ñuqap url-tupuykuna := [''].
	ñuqap hash := [''].
}.

URL patapi: ['musuq'] ruway: { <- kikin musuq wakichiy.
}.

URL patapi: ['qillqaman'] ruway: { <- (
	ñuqap kamachiy-ñan +
	ñuqap samachiq +
	ñuqap ñan +
	ñuqap url-tupuykuna +
	ñuqap hash ).
}.

URL patapi: ['kamachiy-ñan:'] ruway: { :kamachiy-ñan
	((Katiray musuq ; ['http'] ; ['https']) kanmi: kamachiy-ñan) chiqapqtin: {
		ñuqap kamachiy-ñan := kamachiy-ñan + ['://'].
	}, llullaqtin: {
		kay-ruway pantay: ['Invalid protocol'].
	}.
}.

URL patapi: ['samachiq:'] ruway: { :samachiq
	#todo validate according to rfc
	ñuqap samachiq := samachiq.
}.

URL patapi: ['ñan:'] ruway: { :ñan
	ñuqap ñan := ['/'] + ñan url-kodificay.
}.

URL patapi: ['url-tupuykuna:'] ruway: { :mapa
	>> url-tupuykuna := Katiray musuq.
	mapa sapallanpaq: { :llave :chani
		url-tupuykuna yapay-qhepaman: llave qillqaman url-kodificay + ['='] + chani qillqaman url-kodificay.
	}.
	ñuqap url-tupuykuna := ['?'] + ( url-tupuykuna huñuy: ['&'] ).
}.

URL patapi: ['chaqruy:'] ruway: { :hash
	ñuqap hash := ['#'] + hash url-kodificay.
}.

