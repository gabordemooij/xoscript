>> Email := Ima musuq.

Email patapi: ['init'] ruway: {
	ñuqap recipients := Katiray musuq.
	ñuqap cc := Katiray musuq.
	ñuqap bcc := Katiray musuq.
	ñuqap from := Mana.
	ñuqap from-name := Mana.
	ñuqap subject := Mana.
	ñuqap body := Mana.
}.

Email patapi: ['musuq'] ruway: { <- kikin musuq init.
}.

Email patapi: ['to:'] ruway: { :list
	ñuqap recipients := list.
}.
 
Email patapi: ['cc:'] ruway: { :list
	ñuqap cc := list.
}.

Email patapi: ['bcc:'] ruway: { :list
	ñuqap bcc := list.
}.

Email patapi: ['subject:'] ruway: { :subject
	ñuqap subject := subject.
}.

Email patapi: ['from:name:'] ruway: { :from :suti
	ñuqap from := from.
	ñuqap from-name := suti.
}.

Email patapi: ['body:'] ruway: { :body
	ñuqap body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email patapi: ['header:'] ruway: { :line <- line rantinpay: ['\r'] kayta: [''], rantinpay: ['\n'] kayta: [''].
}.

Email patapi: ['send'] ruway: {
	>> f := Khipu tempwrite: kikin generate.
	Programa karacha: ['sendmail -t < '] + f ñan, sayay.
}.

Email patapi: ['generate'] ruway: {
	>> brk := ['\r\n'].
	>> str := [''].
	str yapay-qhepaman: (kikin header: ['From: '] + ñuqap from-name + [' <'] + ( ñuqap from ) + ['>']) + brk.
	str yapay-qhepaman: (kikin header: ['To: '] + ( ñuqap recipients huñuy: [','] )) + brk.
	ñuqap cc hayka? chiqapqtin: {
		str yapay-qhepaman: (kikin header: ['Cc: '] + ( ñuqap cc huñuy: [','] )) + brk.
	}.
	ñuqap bcc hayka? chiqapqtin: {
		str yapay-qhepaman: (kikin header: ['Bcc: '] + ( ñuqap bcc huñuy: [','] )) + brk.
	}.
	str yapay-qhepaman: (kikin header: ['Subject: '] + ñuqap subject) + brk.
	str yapay-qhepaman: brk.
	str yapay-qhepaman: ñuqap body.
	str yapay-qhepaman: brk. <- str.
}.

>> HTML-Email := Email musuq.

HTML-Email patapi: ['init'] ruway: {
	kikin init.
	ñuqap attachments := Katiray musuq.
	ñuqap boundary := Waqaychana token: 40.
}.

HTML-Email patapi: ['attach:'] ruway: { :file
	>> id := ñuqap attachments hayka?.
	>> blob := file blob.
	ñuqap attachments yapay-qhepaman: (
		Simi-taqi musuq
			file: file ñan,
			mime: ['image/'] + (Server mimetype: file ñan),
			data: blob base64-kodificay
	).
	blob kacharichiy. <- ['cid:attachment'] + id.
}.

HTML-Email patapi: ['generate'] ruway: {
	>> brk := ['\r\n'].
	>> str := [''].
	str yapay-qhepaman: (kikin header: ['From: '] + ñuqap from-name + [' <'] + ( ñuqap from ) + ['>']) + brk.
	str yapay-qhepaman: (kikin header: ['To: '] + ( ñuqap recipients huñuy: [','] )) + brk.
	ñuqap cc hayka? chiqapqtin: {
		str yapay-qhepaman: (kikin header: ['Cc: '] + ( ñuqap cc huñuy: [','] )) + brk.
	}.
	ñuqap bcc hayka? chiqapqtin: {
		str yapay-qhepaman: (kikin header: ['Bcc: '] + ( ñuqap bcc huñuy: [','] )) + brk.
	}.
	str yapay-qhepaman: (kikin header: ['Subject: '] + ñuqap subject) + brk.
	str yapay-qhepaman: ['MIME-Version: 1.0'] + brk.
	str yapay-qhepaman: ['Content-Type: multipart/related; boundary="'] + ñuqap boundary + ['"; type=text/html'] + brk.
	str yapay-qhepaman: brk.
	str yapay-qhepaman: ['--'] + ñuqap boundary + brk.
	str yapay-qhepaman: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str yapay-qhepaman: ['Content-Transfer-Encoding: 7bit'] + brk.
	str yapay-qhepaman: brk.
	str yapay-qhepaman: ñuqap body.
	str yapay-qhepaman: brk.
	ñuqap attachments sapallanpaq: { :id :info
		>> blob := info data.
		str yapay-qhepaman: ['--'] + ñuqap boundary + brk.
		str yapay-qhepaman: ['Content-Type: '] + info mime + brk.
		str yapay-qhepaman: ['Content-Transfer-Encoding: base64'] + brk.
		str yapay-qhepaman: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str yapay-qhepaman: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str yapay-qhepaman: brk.
		>> max := 76.
		>> len := blob suni.
		>> chunks := (len / max) hana.
		{ :i
			>> chunk := blob kikinchasqa manta: i * max suni: max.
			str yapay-qhepaman: chunk + brk.
		} * chunks.
		str yapay-qhepaman: brk.
		str yapay-qhepaman: brk.
	}.
	str yapay-qhepaman: ['--'] + ñuqap boundary + ['--'] + brk. <- str.
}.
