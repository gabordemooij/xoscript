>> Antañiqiq-chaski := Ima musuq.

Antañiqiq-chaski patapi: ['wakichiy'] ruway: {
	ñuqap chaskiqkuna := Katiray musuq.
	ñuqap cc := Katiray musuq.
	ñuqap bcc := Katiray musuq.
	ñuqap kachaq := Mana.
	ñuqap kachaqpa-sutin := Mana.
	ñuqap ima-nisqa := Mana.
	ñuqap ukhu := Mana.
}.

Antañiqiq-chaski patapi: ['musuq'] ruway: { <- kikin musuq wakichiy.
}.

Antañiqiq-chaski patapi: ['man:'] ruway: { :yupay
	ñuqap chaskiqkuna := yupay.
}.
 
Antañiqiq-chaski patapi: ['cc:'] ruway: { :yupay
	ñuqap cc := yupay.
}.

Antañiqiq-chaski patapi: ['bcc:'] ruway: { :yupay
	ñuqap bcc := yupay.
}.

Antañiqiq-chaski patapi: ['ima-nisqa:'] ruway: { :ima-nisqa
	ñuqap ima-nisqa := ima-nisqa.
}.

Antañiqiq-chaski patapi: ['kachaq:suti:'] ruway: { :kachaq :suti
	ñuqap kachaq := kachaq.
	ñuqap kachaqpa-sutin := suti.
}.

Antañiqiq-chaski patapi: ['ukhu:'] ruway: { :ukhu
	ñuqap ukhu := ukhu.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Antañiqiq-chaski patapi: ['uma:'] ruway: { :siqi <- siqi rantinpay: ['\r'] kayta: [''], rantinpay: ['\n'] kayta: [''].
}.

Antañiqiq-chaski patapi: ['kachay'] ruway: {
	>> f := Khipu tempwrite: kikin paqarichiy.
	Programa karacha: ['sendmail -t < '] + f ñan, sayay.
}.

Antañiqiq-chaski patapi: ['paqarichiy'] ruway: {
	>> siqi-pakiy := ['\r\n'].
	>> qillqa-watu := [''].
	qillqa-watu yapay-qhepaman: (kikin uma: ['From: '] + ñuqap kachaqpa-sutin + [' <'] + ( ñuqap kachaq ) + ['>']) + siqi-pakiy.
	qillqa-watu yapay-qhepaman: (kikin uma: ['To: '] + ( ñuqap chaskiqkuna huñuy: [','] )) + siqi-pakiy.
	ñuqap cc hayka? chiqapqtin: {
		qillqa-watu yapay-qhepaman: (kikin uma: ['Cc: '] + ( ñuqap cc huñuy: [','] )) + siqi-pakiy.
	}.
	ñuqap bcc hayka? chiqapqtin: {
		qillqa-watu yapay-qhepaman: (kikin uma: ['Bcc: '] + ( ñuqap bcc huñuy: [','] )) + siqi-pakiy.
	}.
	qillqa-watu yapay-qhepaman: (kikin uma: ['Subject: '] + ñuqap ima-nisqa) + siqi-pakiy.
	qillqa-watu yapay-qhepaman: siqi-pakiy.
	qillqa-watu yapay-qhepaman: ñuqap ukhu.
	qillqa-watu yapay-qhepaman: siqi-pakiy. <- qillqa-watu.
}.

>> Antañiqiq-chaski-HTML := Antañiqiq-chaski musuq.

Antañiqiq-chaski-HTML patapi: ['wakichiy'] ruway: {
	kikin wakichiy.
	ñuqap kaskachisqakuna := Katiray musuq.
	ñuqap saywa := Waqaychana token: 40.
}.

Antañiqiq-chaski-HTML patapi: ['kaskachiy:'] ruway: { :tantanakuy-willañiqi
	>> id := ñuqap kaskachisqakuna hayka?.
	>> blob := tantanakuy-willañiqi blob.
	ñuqap kaskachisqakuna yapay-qhepaman: (
		Simi-taqi musuq
			tantanakuy-willañiqi: tantanakuy-willañiqi ñan,
			mime: ['image/'] + (Server mimetype: tantanakuy-willañiqi ñan),
			willakuy: blob base64-kodificay
	).
	blob kacharichiy. <- ['cid:attachment'] + id.
}.

Antañiqiq-chaski-HTML patapi: ['paqarichiy'] ruway: {
	>> siqi-pakiy := ['\r\n'].
	>> qillqa-watu := [''].
	qillqa-watu yapay-qhepaman: (kikin uma: ['From: '] + ñuqap kachaqpa-sutin + [' <'] + ( ñuqap kachaq ) + ['>']) + siqi-pakiy.
	qillqa-watu yapay-qhepaman: (kikin uma: ['To: '] + ( ñuqap chaskiqkuna huñuy: [','] )) + siqi-pakiy.
	ñuqap cc hayka? chiqapqtin: {
		qillqa-watu yapay-qhepaman: (kikin uma: ['Cc: '] + ( ñuqap cc huñuy: [','] )) + siqi-pakiy.
	}.
	ñuqap bcc hayka? chiqapqtin: {
		qillqa-watu yapay-qhepaman: (kikin uma: ['Bcc: '] + ( ñuqap bcc huñuy: [','] )) + siqi-pakiy.
	}.
	qillqa-watu yapay-qhepaman: (kikin uma: ['Subject: '] + ñuqap ima-nisqa) + siqi-pakiy.
	qillqa-watu yapay-qhepaman: ['MIME-Version: 1.0'] + siqi-pakiy.
	qillqa-watu yapay-qhepaman: ['Content-Type: multipart/related; boundary="'] + ñuqap saywa + ['"; type=text/html'] + siqi-pakiy.
	qillqa-watu yapay-qhepaman: siqi-pakiy.
	qillqa-watu yapay-qhepaman: ['--'] + ñuqap saywa + siqi-pakiy.
	qillqa-watu yapay-qhepaman: ['Content-Type: text/html; charset=UTF-8'] + siqi-pakiy.
	qillqa-watu yapay-qhepaman: ['Content-Transfer-Encoding: 7bit'] + siqi-pakiy.
	qillqa-watu yapay-qhepaman: siqi-pakiy.
	qillqa-watu yapay-qhepaman: ñuqap ukhu.
	qillqa-watu yapay-qhepaman: siqi-pakiy.
	ñuqap kaskachisqakuna sapallanpaq: { :id :willay
		>> blob := willay willakuy.
		qillqa-watu yapay-qhepaman: ['--'] + ñuqap saywa + siqi-pakiy.
		qillqa-watu yapay-qhepaman: ['Content-Type: '] + willay mime + siqi-pakiy.
		qillqa-watu yapay-qhepaman: ['Content-Transfer-Encoding: base64'] + siqi-pakiy.
		qillqa-watu yapay-qhepaman: ['Content-ID: <attachment'] + id + ['>'] + siqi-pakiy.
		qillqa-watu yapay-qhepaman: ['Content-Disposition: inline; filename="'] + willay tantanakuy-willañiqi + ['"'] + siqi-pakiy.
		qillqa-watu yapay-qhepaman: siqi-pakiy.
		>> aswan-hatun := 76.
		>> qillqa-suni := blob suni.
		>> raqikuna := (qillqa-suni / aswan-hatun) hana.
		{ :i
			>> raqi := blob kikinchasqa manta: i * aswan-hatun suni: aswan-hatun.
			qillqa-watu yapay-qhepaman: raqi + siqi-pakiy.
		} * raqikuna.
		qillqa-watu yapay-qhepaman: siqi-pakiy.
		qillqa-watu yapay-qhepaman: siqi-pakiy.
	}.
	qillqa-watu yapay-qhepaman: ['--'] + ñuqap saywa + ['--'] + siqi-pakiy. <- qillqa-watu.
}.
