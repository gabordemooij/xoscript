
# ~ Simple template engine ~

>> Rikchana := Ima musuq.

Rikchana patapi: ['musuq'] ruway: { <- kikin musuq ukhunpi-kaq: [''].
}.

Rikchana patapi: ['ukhunpi-kaq:'] ruway: { :ukhunpi-kaq
	ñuqap ukhunpi-kaq := ukhunpi-kaq. 
}.

Rikchana patapi: ['musuq:'] ruway: { :ukhunpi-kaq <- kikin musuq ukhunpi-kaq: ukhunpi-kaq.
}.

Rikchana patapi: ['kuchuy:'] ruway: { :unanchay
	>> qallariy-unanchay := (['<!-- cut:%id% -->'] %id%: unanchay).
	>> tukukuy-unanchay := (['<!-- /cut:%id% -->'] %id%: unanchay).
	>> rakikuna := ñuqap ukhunpi-kaq rakiy: qallariy-unanchay.
	>> ñawpaqnin := rakikuna ñawpaq.
	>> rakikuna2 := rakikuna qhepa rakiy: tukukuy-unanchay.
	>> qhipan := rakikuna2 qhepa.
	>> rakiy := rakikuna2 ñawpaq.
	>> puchu := ñawpaqnin + qhipan.
	ñuqap ukhunpi-kaq := puchu. <- Rikchana musuq: rakiy.
	
}.

Rikchana patapi: ['kikinchasqa'] ruway: { <- kikin musuq: kikin qillqaman kikinchasqa.
}.
	
Rikchana patapi: ['satiy:maypi:'] ruway: { :pisi-qillqa :id
	>> satiy-unanchay := (['<!-- paste:%id% -->'] %id%: id).
	ñuqap ukhunpi-kaq rantinpay: satiy-unanchay kayta: ( pisi-qillqa qillqaman + satiy-unanchay ).
}.

Rikchana patapi: ['churay:chanin:'] ruway: { :tiyana :chani
	ñuqap ukhunpi-kaq rantinpay: ['<!-- slot:'] + tiyana + [' -->'] kayta: ( Server html-kodificay: chani ).
}.

Rikchana patapi: ['churay:html:'] ruway: { :tiyana :html
	ñuqap ukhunpi-kaq rantinpay: ['<!-- slot:'] + tiyana + [' -->'] kayta: html.
}.

Rikchana patapi: ['kutichiy:wan:'] ruway: { :tiyana :chani
	kikin churay: (tiyana manta: 0 suni: (tiyana suni - 1)) chanin: chani.
}.

Rikchana patapi: ['nl2br'] ruway: {
	ñuqap ukhunpi-kaq rantinpay: ['\n'] kayta: ['<br>'].
}.

Rikchana patapi: ['allinchay'] ruway: {
	ñuqap ukhunpi-kaq :=
		Rikchʼaq
		musuq: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		tinkuy: ñuqap ukhunpi-kaq
		ruway: { <- ['']. }.
}.

Rikchana patapi: ['kuchusqakunata-allinchay'] ruway: {
	>> imakuna := Katiray musuq.
	Rikchʼaq
	musuq: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	tinkuy: ñuqap ukhunpi-kaq
	ruway: { :_ :rakiy
		imakuna yapay-qhepaman: rakiy ? 1.
	}.
	imakuna sapallanpaq: { :_ :id
		ñuqap ukhunpi-kaq :=
			Rikchʼaq musuq: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			tinkuy: ñuqap ukhunpi-kaq
			ruway: { <- ['']. }.
	 }.
}.

Rikchana patapi: ['chusaqkunata-allinchay'] ruway: {
	ñuqap ukhunpi-kaq :=
		Rikchʼaq
		musuq: ['\\s*\\n'],
		tinkuy: ñuqap ukhunpi-kaq
		ruway: { <- ['\n']. }.
	ñuqap ukhunpi-kaq :=
		Rikchʼaq
		musuq: ['\\n[\\s\\t]+'],
		tinkuy: ñuqap ukhunpi-kaq
		ruway: { <- ['\n']. }.
}.

Rikchana patapi: ['llapanta-allinchay'] ruway: {
	kikin allinchay.
	kikin kuchusqakunata-allinchay.
	kikin chusaqkunata-allinchay.
}.

Rikchana patapi: ['qillqaman'] ruway: { <- ñuqap ukhunpi-kaq.
}.
