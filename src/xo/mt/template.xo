
# ~ Simple template engine ~

>> Forma := Oġġett ġdid.

Forma meta: ['ġdid'] agħmel: { <- innifsu ġdid kontenut: [''].
}.

Forma meta: ['kontenut:'] agħmel: { :kontenut
	proprju kontenut := kontenut. 
}.

Forma meta: ['ġdid:'] agħmel: { :kontenut <- innifsu ġdid kontenut: kontenut.
}.

Forma meta: ['aqta:'] agħmel: { :marka
	>> marka-tal-bidu := (['<!-- cut:%id% -->'] %id%: marka).
	>> marka-tat-tmiem := (['<!-- /cut:%id% -->'] %id%: marka).
	>> partijiet := proprju kontenut aqsam: marka-tal-bidu.
	>> prefiss := partijiet ewwel.
	>> partijiet2 := partijiet aħħar aqsam: marka-tat-tmiem.
	>> suffiss := partijiet2 aħħar.
	>> parti := partijiet2 ewwel.
	>> bqija := prefiss + suffiss.
	proprju kontenut := bqija. <- Forma ġdid: parti.
	
}.

Forma meta: ['ikkopja'] agħmel: { <- innifsu ġdid: innifsu test ikkopja.
}.
	
Forma meta: ['waħħal:fi:'] agħmel: { :silta :id
	>> marka-tal-waħħal := (['<!-- paste:%id% -->'] %id%: id).
	proprju kontenut ibdel: marka-tal-waħħal bi: ( silta test + marka-tal-waħħal ).
}.

Forma meta: ['issettja:valur:'] agħmel: { :post :valur
	proprju kontenut ibdel: ['<!-- slot:'] + post + [' -->'] bi: ( Server html-ikkodifika: valur ).
}.

Forma meta: ['issettja:html:'] agħmel: { :post :html
	proprju kontenut ibdel: ['<!-- slot:'] + post + [' -->'] bi: html.
}.

Forma meta: ['wieġeb:u:'] agħmel: { :post :valur
	innifsu issettja: (post minn: 0 tul: (post tul - 1)) valur: valur.
}.

Forma meta: ['nl2br'] agħmel: {
	proprju kontenut ibdel: ['\n'] bi: ['<br>'].
}.

Forma meta: ['irranġa'] agħmel: {
	proprju kontenut :=
		Mudell
		ġdid: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		taqbila: proprju kontenut
		agħmel: { <- ['']. }.
}.

Forma meta: ['irranġa-qtugħ'] agħmel: {
	>> oġġetti := Lista ġdid.
	Mudell
	ġdid: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	taqbila: proprju kontenut
	agħmel: { :_ :parti
		oġġetti żid-fit-tmiem: parti ? 1.
	}.
	oġġetti kull: { :_ :id
		proprju kontenut :=
			Mudell ġdid: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			taqbila: proprju kontenut
			agħmel: { <- ['']. }.
	 }.
}.

Forma meta: ['irranġa-spazji'] agħmel: {
	proprju kontenut :=
		Mudell
		ġdid: ['\\s*\\n'],
		taqbila: proprju kontenut
		agħmel: { <- ['\n']. }.
	proprju kontenut :=
		Mudell
		ġdid: ['\\n[\\s\\t]+'],
		taqbila: proprju kontenut
		agħmel: { <- ['\n']. }.
}.

Forma meta: ['irranġa-kollox'] agħmel: {
	innifsu irranġa.
	innifsu irranġa-qtugħ.
	innifsu irranġa-spazji.
}.

Forma meta: ['test'] agħmel: { <- proprju kontenut.
}.
