HTTP-Talba meta: ['HTTP-intestatura:'] agħmel: { :ċavetta <- Programm issettjar: ċavetta.
}.

>> Intestatura-HTTP := Oġġett ġdid.

Intestatura-HTTP meta: ['ġdid'] agħmel: { <- innifsu ġdid inizjalizza.
}.

Intestatura-HTTP meta: ['inizjalizza'] agħmel: {
	proprju ċavetta := Xejn.
	proprju valur := Xejn.
}.

Intestatura-HTTP meta: ['ċavetta:valur:'] agħmel: { :ċavetta :valur
	proprju ċavetta := ċavetta.
	proprju valur := valur.
}.

Intestatura-HTTP meta: ['ċavetta'] agħmel: { <- proprju ċavetta.
}.

Intestatura-HTTP meta: ['valur'] agħmel: { <- proprju valur.
}.


Intestatura-HTTP meta: ['test'] agħmel: {
	>> linja := proprju ċavetta + [': '] + proprju valur.
	linja ibdel: ['\r'] bi: [''], ibdel: ['\n'] bi: ['']. <- linja + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokument-Web := Oġġett ġdid.

Dokument-Web meta: ['ġdid'] agħmel: { <- innifsu ġdid inizjalizza.
}.

Dokument-Web meta: ['inizjalizza'] agħmel: {
	proprju intestaturi := Lista ġdid.
	proprju id-sessjoni := Xejn.
	proprju maniġer-sessjonijiet := Sessjoni-fajl-temporanju ġdid.
	proprju data-sessjoni := Xejn.
	proprju sigur := Veru.
	proprju l-istess-sit := ['Strict'].
	proprju intestaturi-mibgħuta := Falz.
	proprju talba := HTTP-Talba ġdid.
}.

Dokument-Web meta: ['talba:'] agħmel: { :talba
	proprju talba := talba.
}. 

Dokument-Web meta: ['cookie-sessjoni-sigur:'] agħmel: { :sigur
	innifsu iċċekkja-intestaturi.
	proprju sigur := sigur.
}.

Dokument-Web meta: ['cookie-sessjoni-l-istess-sit:'] agħmel: { :valur
	innifsu iċċekkja-intestaturi.
	>> għażliet := Lista ġdid 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	għażliet għandu: valur, falz: {
		dan-il-kompitu żball: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	proprju l-istess-sit := valur.
}.

Dokument-Web meta: ['intestatura:'] agħmel: { :intestatura
	innifsu iċċekkja-intestaturi.
	proprju intestaturi żid-fit-tmiem: intestatura.
}.

Dokument-Web meta: ['ħassar-intestaturi'] agħmel: {
	innifsu iċċekkja-intestaturi.
	proprju intestaturi := Lista ġdid.
}.

Dokument-Web meta: ['maniġer-sessjonijiet:'] agħmel: { :maniġer
	innifsu iċċekkja-intestaturi.
	proprju maniġer-sessjonijiet := maniġer.
}.

Dokument-Web meta: ['maniġer-sessjonijiet'] agħmel: { <- proprju maniġer-sessjonijiet.
}.

Dokument-Web meta: ['iċċekkja-intestaturi'] agħmel: {
	proprju intestaturi-mibgħuta veru: {
		dan-il-kompitu żball: ['Headers already sent to client.'].
	}.
}.

Dokument-Web meta: ['ibda-sessjoni'] agħmel: {
	innifsu iċċekkja-intestaturi.
	>> talba := proprju talba.
	>> id-sessjoni := talba cookie: ['xsid'].
	id-sessjoni Xejn? falz: {
		(( Mudell ġdid: ['^[A-Za-z0-9]+\\z'], taqbila: id-sessjoni ) = 0) veru: {
			id-sessjoni := Xejn.
		}.
	}.
	id-sessjoni Xejn? veru: {
		id-sessjoni := Kaxxaforti token: 30.
		>> intestatura-sessjoni := Intestatura-HTTP ġdid
		ċavetta: ['Set-Cookie'] valur: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (proprju sigur jew: ['Secure'] jew: ['']),
		SSITE: (proprju l-istess-sit),
		XSID: id-sessjoni
		).
		proprju intestaturi żid-fit-tmiem: intestatura-sessjoni.
	}.
	proprju data-sessjoni := proprju maniġer-sessjonijiet għal: id-sessjoni, tella. <- proprju data-sessjoni. # reference
}.

Dokument-Web meta: ['mur-għand:'] agħmel: { :indirizz
	innifsu iċċekkja-intestaturi.
	innifsu ħassar-intestaturi.
	proprju intestaturi
	żid-fit-tmiem: (
		Intestatura-HTTP ġdid
		ċavetta: ['Status'] valur: ['303 See Other']
	),
	żid-fit-tmiem: (
		Intestatura-HTTP ġdid
		ċavetta: ['Location'] valur: indirizz
	).
	innifsu oħroġ: ['Redirect'].
}.

Dokument-Web meta: ['eqred-sessjoni'] agħmel: {
	innifsu iċċekkja-intestaturi.
	>> talba := proprju talba.
	>> id-sessjoni := talba cookie: ['xsid'].
	id-sessjoni Xejn? falz: {
		>> intestatura-sessjoni := Intestatura-HTTP ġdid.
		>> mument := Mument ġdid sena: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		intestatura-sessjoni ċavetta: ['Set-Cookie'] valur: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: mument,
			SEC: (proprju sigur jew: ['Secure'] jew: ['']),
			SSITE: (proprju l-istess-sit),
			XSID: id-sessjoni
		).
		proprju maniġer-sessjonijiet eqred.
		proprju intestaturi żid-fit-tmiem: intestatura-sessjoni.
	}.
}.


Dokument-Web meta: ['forma:'] agħmel: { :mogħdija <- Forma ġdid: (Fajl ġdid: mogħdija, aqra).
}.

Dokument-Web meta: ['oħroġ:tip:'] agħmel: { :output :tip
	proprju intestaturi-mibgħuta falz: {
		proprju data-sessjoni Xejn? falz: {
			proprju maniġer-sessjonijiet issejvja: proprju data-sessjoni.
		}.
		proprju intestaturi żid-fit-tmiem: (
			Intestatura-HTTP ġdid
			ċavetta: ['Content-type'] valur: tip
		).
		proprju intestaturi kull: { :_ :intestatura
			Ħruġ ikteb: intestatura.
		}.
		proprju intestaturi-mibgħuta := Veru.
		Ħruġ ikteb: ['\r\n'].
	}.
	Ħruġ ikteb: output.
}.

Dokument-Web meta: ['lesti:tip:'] agħmel: { :output :tip
	proprju intestaturi-mibgħuta falz: {
		proprju data-sessjoni Xejn? falz: {
			proprju maniġer-sessjonijiet issejvja: proprju data-sessjoni.
		}.
		proprju intestaturi żid-fit-tmiem: (
			Intestatura-HTTP ġdid
			ċavetta: ['Content-type'] valur: tip
		).
		proprju intestaturi żid-fit-tmiem: (
			Intestatura-HTTP ġdid
			ċavetta: ['Content-Length'] valur: output test bytes
		).
		proprju intestaturi kull: { :_ :intestatura
			Ħruġ ikteb: intestatura.
		}.
		proprju intestaturi-mibgħuta := Veru.
		Ħruġ ikteb: ['\r\n'].
	}.
	Ħruġ ikteb: output.
}.

Dokument-Web meta: ['oħroġ:'] agħmel: { :output
	innifsu oħroġ: output tip: ['text/html; charset=utf-8'].
}.

Dokument-Web meta: ['lesti:'] agħmel: { :output
	innifsu lesti: output tip: ['text/html; charset=utf-8'].
}.

Dokument-Web meta: ['json:'] agħmel: { :output
	innifsu oħroġ: ( JSON jsonify: output ) tip: ['application/json'].
}.

Dokument-Web meta: ['ma-nstabx:'] agħmel: { :output
	innifsu ħassar-intestaturi intestatura: (
		Intestatura-HTTP ġdid ċavetta: ['Status'] valur: ['404 Not Found']
	).
	innifsu oħroġ: output.
}.


# Interface

>> Sessjoni := Oġġett ġdid.

Sessjoni meta: ['ġdid'] agħmel: { <- innifsu ġdid inizjalizza għal: Xejn.
}.

Sessjoni meta: ['għal:'] agħmel: { :id
	proprju id := id.
}.

Sessjoni meta: ['tella'] agħmel: {
	dan-il-kompitu żball: ['Not implemented.'].
}.

Sessjoni meta: ['issejvja:'] agħmel: {
	dan-il-kompitu żball: ['Not implemented.'].
}.

Sessjoni meta: ['eqred'] agħmel: {
	dan-il-kompitu żball: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sessjoni-fajl-temporanju := Sessjoni ġdid.

Sessjoni-fajl-temporanju meta: ['inizjalizza'] agħmel: {
	proprju bidu-mogħdija := ['/tmp/sess-'].
}.

Sessjoni-fajl-temporanju meta: ['prefiss-tal-mogħdija:'] agħmel: { :sekwenza
	proprju bidu-mogħdija := sekwenza.
}.

Sessjoni-fajl-temporanju meta: ['fajl'] agħmel: { <- ( Fajl ġdid: ( proprju bidu-mogħdija + proprju id + ['.txt'] ) ).
}.

Sessjoni-fajl-temporanju meta: ['tella'] agħmel: {
	>> fajl := innifsu fajl.
	fajl jeżisti falz: {
		fajl ikteb: (Dizzjunarju ġdid kodiċi).
	}. <- fajl aqra oġġett.
}.

Sessjoni-fajl-temporanju meta: ['issejvja:'] agħmel: { :data
	>> fajl := innifsu fajl.
	fajl jeżisti veru: {
		fajl ikteb: data kodiċi.
	}.
}.

Sessjoni-fajl-temporanju meta: ['eqred'] agħmel: {
	>> fajl := innifsu fajl.
	fajl jeżisti veru: {
		fajl ħassar.
	}.
}.


>> URL := Oġġett ġdid.

URL meta: ['inizjalizza'] agħmel: {
	proprju protokoll := ['https://'].
	proprju host := ['localhost'].
	proprju mogħdija := [''].
	proprju parametri-url := [''].
	proprju hash := [''].
}.

URL meta: ['ġdid'] agħmel: { <- innifsu ġdid inizjalizza.
}.

URL meta: ['test'] agħmel: { <- (
	proprju protokoll +
	proprju host +
	proprju mogħdija +
	proprju parametri-url +
	proprju hash ).
}.

URL meta: ['protokoll:'] agħmel: { :protokoll
	((Lista ġdid ; ['http'] ; ['https']) għandu: protokoll) veru: {
		proprju protokoll := protokoll + ['://'].
	}, falz: {
		dan-il-kompitu żball: ['Invalid protocol'].
	}.
}.

URL meta: ['host:'] agħmel: { :host
	#todo validate according to rfc
	proprju host := host.
}.

URL meta: ['mogħdija:'] agħmel: { :mogħdija
	proprju mogħdija := ['/'] + mogħdija url-ikkodifika.
}.

URL meta: ['parametri-url:'] agħmel: { :mappa
	>> parametri-url := Lista ġdid.
	mappa kull: { :ċavetta :valur
		parametri-url żid-fit-tmiem: ċavetta test url-ikkodifika + ['='] + valur test url-ikkodifika.
	}.
	proprju parametri-url := ['?'] + ( parametri-url għaqqad: ['&'] ).
}.

URL meta: ['hash:'] agħmel: { :hash
	proprju hash := ['#'] + hash url-ikkodifika.
}.

