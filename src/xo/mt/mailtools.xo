>> Email := Oġġett ġdid.

Email meta: ['inizjalizza'] agħmel: {
	proprju riċevituri := Lista ġdid.
	proprju cc := Lista ġdid.
	proprju bcc := Lista ġdid.
	proprju mittent := Xejn.
	proprju isem-mittent := Xejn.
	proprju suġġett := Xejn.
	proprju korp := Xejn.
}.

Email meta: ['ġdid'] agħmel: { <- innifsu ġdid inizjalizza.
}.

Email meta: ['lil:'] agħmel: { :elenku
	proprju riċevituri := elenku.
}.
 
Email meta: ['cc:'] agħmel: { :elenku
	proprju cc := elenku.
}.

Email meta: ['bcc:'] agħmel: { :elenku
	proprju bcc := elenku.
}.

Email meta: ['suġġett:'] agħmel: { :suġġett
	proprju suġġett := suġġett.
}.

Email meta: ['mittent:isem:'] agħmel: { :mittent :isem
	proprju mittent := mittent.
	proprju isem-mittent := isem.
}.

Email meta: ['korp:'] agħmel: { :korp
	proprju korp := korp.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email meta: ['intestatura:'] agħmel: { :linja <- linja ibdel: ['\r'] bi: [''], ibdel: ['\n'] bi: [''].
}.

Email meta: ['ibgħat'] agħmel: {
	>> f := Fajl tempwrite: innifsu iġġenera.
	Programm sistema: ['sendmail -t < '] + f mogħdija, linja-ġdida.
}.

Email meta: ['iġġenera'] agħmel: {
	>> qsim-linja := ['\r\n'].
	>> sekwenza := [''].
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['From: '] + proprju isem-mittent + [' <'] + ( proprju mittent ) + ['>']) + qsim-linja.
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['To: '] + ( proprju riċevituri għaqqad: [','] )) + qsim-linja.
	proprju cc għodd veru: {
		sekwenza żid-fit-tmiem: (innifsu intestatura: ['Cc: '] + ( proprju cc għaqqad: [','] )) + qsim-linja.
	}.
	proprju bcc għodd veru: {
		sekwenza żid-fit-tmiem: (innifsu intestatura: ['Bcc: '] + ( proprju bcc għaqqad: [','] )) + qsim-linja.
	}.
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['Subject: '] + proprju suġġett) + qsim-linja.
	sekwenza żid-fit-tmiem: qsim-linja.
	sekwenza żid-fit-tmiem: proprju korp.
	sekwenza żid-fit-tmiem: qsim-linja. <- sekwenza.
}.

>> HTML-Email := Email ġdid.

HTML-Email meta: ['inizjalizza'] agħmel: {
	innifsu inizjalizza.
	proprju annessi := Lista ġdid.
	proprju konfini := Kaxxaforti token: 40.
}.

HTML-Email meta: ['annetti:'] agħmel: { :fajl
	>> id := proprju annessi għodd.
	>> blob := fajl blob.
	proprju annessi żid-fit-tmiem: (
		Dizzjunarju ġdid
			fajl: fajl mogħdija,
			mime: ['image/'] + (Server mimetype: fajl mogħdija),
			data: blob base64-ikkodifika
	).
	blob eħles. <- ['cid:attachment'] + id.
}.

HTML-Email meta: ['iġġenera'] agħmel: {
	>> qsim-linja := ['\r\n'].
	>> sekwenza := [''].
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['From: '] + proprju isem-mittent + [' <'] + ( proprju mittent ) + ['>']) + qsim-linja.
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['To: '] + ( proprju riċevituri għaqqad: [','] )) + qsim-linja.
	proprju cc għodd veru: {
		sekwenza żid-fit-tmiem: (innifsu intestatura: ['Cc: '] + ( proprju cc għaqqad: [','] )) + qsim-linja.
	}.
	proprju bcc għodd veru: {
		sekwenza żid-fit-tmiem: (innifsu intestatura: ['Bcc: '] + ( proprju bcc għaqqad: [','] )) + qsim-linja.
	}.
	sekwenza żid-fit-tmiem: (innifsu intestatura: ['Subject: '] + proprju suġġett) + qsim-linja.
	sekwenza żid-fit-tmiem: ['MIME-Version: 1.0'] + qsim-linja.
	sekwenza żid-fit-tmiem: ['Content-Type: multipart/related; boundary="'] + proprju konfini + ['"; type=text/html'] + qsim-linja.
	sekwenza żid-fit-tmiem: qsim-linja.
	sekwenza żid-fit-tmiem: ['--'] + proprju konfini + qsim-linja.
	sekwenza żid-fit-tmiem: ['Content-Type: text/html; charset=UTF-8'] + qsim-linja.
	sekwenza żid-fit-tmiem: ['Content-Transfer-Encoding: 7bit'] + qsim-linja.
	sekwenza żid-fit-tmiem: qsim-linja.
	sekwenza żid-fit-tmiem: proprju korp.
	sekwenza żid-fit-tmiem: qsim-linja.
	proprju annessi kull: { :id :info
		>> blob := info data.
		sekwenza żid-fit-tmiem: ['--'] + proprju konfini + qsim-linja.
		sekwenza żid-fit-tmiem: ['Content-Type: '] + info mime + qsim-linja.
		sekwenza żid-fit-tmiem: ['Content-Transfer-Encoding: base64'] + qsim-linja.
		sekwenza żid-fit-tmiem: ['Content-ID: <attachment'] + id + ['>'] + qsim-linja.
		sekwenza żid-fit-tmiem: ['Content-Disposition: inline; filename="'] + info fajl + ['"'] + qsim-linja.
		sekwenza żid-fit-tmiem: qsim-linja.
		>> l-ogħla := 76.
		>> tul-test := blob tul.
		>> biċċiet := (tul-test / l-ogħla) arrotonda-fuq.
		{ :i
			>> biċċa := blob ikkopja minn: i * l-ogħla tul: l-ogħla.
			sekwenza żid-fit-tmiem: biċċa + qsim-linja.
		} * biċċiet.
		sekwenza żid-fit-tmiem: qsim-linja.
		sekwenza żid-fit-tmiem: qsim-linja.
	}.
	sekwenza żid-fit-tmiem: ['--'] + proprju konfini + ['--'] + qsim-linja. <- sekwenza.
}.
