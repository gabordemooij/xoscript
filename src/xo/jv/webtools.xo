Panjaluk-HTTP nalika: ['HTTP-sesirah:'] tindakna: { :kunci-sesirah <- Program setelan: kunci-sesirah.
}.

>> Sesirah-HTTP := Obyek anyar.

Sesirah-HTTP nalika: ['anyar'] tindakna: { <- dhiri anyar siapake.
}.

Sesirah-HTTP nalika: ['siapake'] tindakna: {
	duweke kunci-sesirah := Kosong.
	duweke nilai := Kosong.
}.

Sesirah-HTTP nalika: ['kunci-sesirah:nilai:'] tindakna: { :kunci-sesirah :nilai
	duweke kunci-sesirah := kunci-sesirah.
	duweke nilai := nilai.
}.

Sesirah-HTTP nalika: ['kunci-sesirah'] tindakna: { <- duweke kunci-sesirah.
}.

Sesirah-HTTP nalika: ['nilai'] tindakna: { <- duweke nilai.
}.


Sesirah-HTTP nalika: ['tèks'] tindakna: {
	>> baris := duweke kunci-sesirah + [': '] + duweke nilai.
	baris ganti: ['\r'] nganggo: [''], ganti: ['\n'] nganggo: ['']. <- baris + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumen-Web := Obyek anyar.

Dokumen-Web nalika: ['anyar'] tindakna: { <- dhiri anyar siapake.
}.

Dokumen-Web nalika: ['siapake'] tindakna: {
	duweke dhaptar-sesirah := Dhaptar anyar.
	duweke id-sesi := Kosong.
	duweke pangatur-sesi := Sesi-berkas-sementara anyar.
	duweke data-sesi := Kosong.
	duweke aman := Bener.
	duweke situs-padha := ['Strict'].
	duweke sesirah-dikirim := Salah.
	duweke panjaluk-http := Panjaluk-HTTP anyar.
}.

Dokumen-Web nalika: ['panjaluk-http:'] tindakna: { :panjaluk-http
	duweke panjaluk-http := panjaluk-http.
}. 

Dokumen-Web nalika: ['kuki-sesi-aman:'] tindakna: { :aman
	dhiri priksa-sesirah.
	duweke aman := aman.
}.

Dokumen-Web nalika: ['kuki-sesi-situs-padha:'] tindakna: { :nilai
	dhiri priksa-sesirah.
	>> pilihan := Dhaptar anyar 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	pilihan nduweni: nilai, salah: {
		tugas-iki kesalahan: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	duweke situs-padha := nilai.
}.

Dokumen-Web nalika: ['sesirah:'] tindakna: { :sesirah
	dhiri priksa-sesirah.
	duweke dhaptar-sesirah tambah-ing-mburi: sesirah.
}.

Dokumen-Web nalika: ['kosongake-sesirah'] tindakna: {
	dhiri priksa-sesirah.
	duweke dhaptar-sesirah := Dhaptar anyar.
}.

Dokumen-Web nalika: ['pangatur-sesi:'] tindakna: { :pangatur
	dhiri priksa-sesirah.
	duweke pangatur-sesi := pangatur.
}.

Dokumen-Web nalika: ['pangatur-sesi'] tindakna: { <- duweke pangatur-sesi.
}.

Dokumen-Web nalika: ['priksa-sesirah'] tindakna: {
	duweke sesirah-dikirim bener: {
		tugas-iki kesalahan: ['Headers already sent to client.'].
	}.
}.

Dokumen-Web nalika: ['wiwiti-sesi'] tindakna: {
	dhiri priksa-sesirah.
	>> panjaluk-http := duweke panjaluk-http.
	>> id-sesi := panjaluk-http cookie: ['xsid'].
	id-sesi Kosong? salah: {
		(( Pola anyar: ['^[A-Za-z0-9]+\\z'], cocog: id-sesi ) = 0) bener: {
			id-sesi := Kosong.
		}.
	}.
	id-sesi Kosong? bener: {
		id-sesi := Brankas token: 30.
		>> sesirah-sesi := Sesirah-HTTP anyar
		kunci-sesirah: ['Set-Cookie'] nilai: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (duweke aman pilih: ['Secure'] utawa: ['']),
		SSITE: (duweke situs-padha),
		XSID: id-sesi
		).
		duweke dhaptar-sesirah tambah-ing-mburi: sesirah-sesi.
	}.
	duweke data-sesi := duweke pangatur-sesi kanggo: id-sesi, muat. <- duweke data-sesi. # reference
}.

Dokumen-Web nalika: ['menyang:'] tindakna: { :alamat
	dhiri priksa-sesirah.
	dhiri kosongake-sesirah.
	duweke dhaptar-sesirah
	tambah-ing-mburi: (
		Sesirah-HTTP anyar
		kunci-sesirah: ['Status'] nilai: ['303 See Other']
	),
	tambah-ing-mburi: (
		Sesirah-HTTP anyar
		kunci-sesirah: ['Location'] nilai: alamat
	).
	dhiri wetokake: ['Redirect'].
}.

Dokumen-Web nalika: ['rusak-sesi'] tindakna: {
	dhiri priksa-sesirah.
	>> panjaluk-http := duweke panjaluk-http.
	>> id-sesi := panjaluk-http cookie: ['xsid'].
	id-sesi Kosong? salah: {
		>> sesirah-sesi := Sesirah-HTTP anyar.
		>> wektu-entek := Wektu anyar taun: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sesirah-sesi kunci-sesirah: ['Set-Cookie'] nilai: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: wektu-entek,
			SEC: (duweke aman pilih: ['Secure'] utawa: ['']),
			SSITE: (duweke situs-padha),
			XSID: id-sesi
		).
		duweke pangatur-sesi rusak.
		duweke dhaptar-sesirah tambah-ing-mburi: sesirah-sesi.
	}.
}.


Dokumen-Web nalika: ['cithakan:'] tindakna: { :dalan <- Cithakan anyar: (Berkas anyar: dalan, waca).
}.

Dokumen-Web nalika: ['wetokake:jinis:'] tindakna: { :asil :jinis
	duweke sesirah-dikirim salah: {
		duweke data-sesi Kosong? salah: {
			duweke pangatur-sesi simpen: duweke data-sesi.
		}.
		duweke dhaptar-sesirah tambah-ing-mburi: (
			Sesirah-HTTP anyar
			kunci-sesirah: ['Content-type'] nilai: jinis
		).
		duweke dhaptar-sesirah saben: { :_ :sesirah
			Wetonan tulis: sesirah.
		}.
		duweke sesirah-dikirim := Bener.
		Wetonan tulis: ['\r\n'].
	}.
	Wetonan tulis: asil.
}.

Dokumen-Web nalika: ['rampungake:jinis:'] tindakna: { :asil :jinis
	duweke sesirah-dikirim salah: {
		duweke data-sesi Kosong? salah: {
			duweke pangatur-sesi simpen: duweke data-sesi.
		}.
		duweke dhaptar-sesirah tambah-ing-mburi: (
			Sesirah-HTTP anyar
			kunci-sesirah: ['Content-type'] nilai: jinis
		).
		duweke dhaptar-sesirah tambah-ing-mburi: (
			Sesirah-HTTP anyar
			kunci-sesirah: ['Content-Length'] nilai: asil tèks bytes
		).
		duweke dhaptar-sesirah saben: { :_ :sesirah
			Wetonan tulis: sesirah.
		}.
		duweke sesirah-dikirim := Bener.
		Wetonan tulis: ['\r\n'].
	}.
	Wetonan tulis: asil.
}.

Dokumen-Web nalika: ['wetokake:'] tindakna: { :asil
	dhiri wetokake: asil jinis: ['text/html; charset=utf-8'].
}.

Dokumen-Web nalika: ['rampungake:'] tindakna: { :asil
	dhiri rampungake: asil jinis: ['text/html; charset=utf-8'].
}.

Dokumen-Web nalika: ['json:'] tindakna: { :asil
	dhiri wetokake: ( JSON jsonify: asil ) jinis: ['application/json'].
}.

Dokumen-Web nalika: ['ora-ketemu:'] tindakna: { :asil
	dhiri kosongake-sesirah sesirah: (
		Sesirah-HTTP anyar kunci-sesirah: ['Status'] nilai: ['404 Not Found']
	).
	dhiri wetokake: asil.
}.


# Interface

>> Sesi := Obyek anyar.

Sesi nalika: ['anyar'] tindakna: { <- dhiri anyar siapake kanggo: Kosong.
}.

Sesi nalika: ['kanggo:'] tindakna: { :id
	duweke id := id.
}.

Sesi nalika: ['muat'] tindakna: {
	tugas-iki kesalahan: ['Not implemented.'].
}.

Sesi nalika: ['simpen:'] tindakna: {
	tugas-iki kesalahan: ['Not implemented.'].
}.

Sesi nalika: ['rusak'] tindakna: {
	tugas-iki kesalahan: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesi-berkas-sementara := Sesi anyar.

Sesi-berkas-sementara nalika: ['siapake'] tindakna: {
	duweke wiwitan-dalan := ['/tmp/sess-'].
}.

Sesi-berkas-sementara nalika: ['awalan-dalan:'] tindakna: { :untaian
	duweke wiwitan-dalan := untaian.
}.

Sesi-berkas-sementara nalika: ['berkas-sesi'] tindakna: { <- ( Berkas anyar: ( duweke wiwitan-dalan + duweke id + ['.txt'] ) ).
}.

Sesi-berkas-sementara nalika: ['muat'] tindakna: {
	>> berkas-sesi := dhiri berkas-sesi.
	berkas-sesi ana salah: {
		berkas-sesi tulis: (Kamus anyar kode).
	}. <- berkas-sesi waca obyek.
}.

Sesi-berkas-sementara nalika: ['simpen:'] tindakna: { :data
	>> berkas-sesi := dhiri berkas-sesi.
	berkas-sesi ana bener: {
		berkas-sesi tulis: data kode.
	}.
}.

Sesi-berkas-sementara nalika: ['rusak'] tindakna: {
	>> berkas-sesi := dhiri berkas-sesi.
	berkas-sesi ana bener: {
		berkas-sesi busak.
	}.
}.


>> URL := Obyek anyar.

URL nalika: ['siapake'] tindakna: {
	duweke protokol := ['https://'].
	duweke hos := ['localhost'].
	duweke dalan := [''].
	duweke parameter-url := [''].
	duweke hash := [''].
}.

URL nalika: ['anyar'] tindakna: { <- dhiri anyar siapake.
}.

URL nalika: ['tèks'] tindakna: { <- (
	duweke protokol +
	duweke hos +
	duweke dalan +
	duweke parameter-url +
	duweke hash ).
}.

URL nalika: ['protokol:'] tindakna: { :protokol
	((Dhaptar anyar ; ['http'] ; ['https']) nduweni: protokol) bener: {
		duweke protokol := protokol + ['://'].
	}, salah: {
		tugas-iki kesalahan: ['Invalid protocol'].
	}.
}.

URL nalika: ['hos:'] tindakna: { :hos
	#todo validate according to rfc
	duweke hos := hos.
}.

URL nalika: ['dalan:'] tindakna: { :dalan
	duweke dalan := ['/'] + dalan url-enkode.
}.

URL nalika: ['parameter-url:'] tindakna: { :pemetaan
	>> parameter-url := Dhaptar anyar.
	pemetaan saben: { :kunci-sesirah :nilai
		parameter-url tambah-ing-mburi: kunci-sesirah tèks url-enkode + ['='] + nilai tèks url-enkode.
	}.
	duweke parameter-url := ['?'] + ( parameter-url gabung: ['&'] ).
}.

URL nalika: ['hash:'] tindakna: { :hash
	duweke hash := ['#'] + hash url-enkode.
}.

