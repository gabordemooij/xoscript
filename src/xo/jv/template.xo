
# ~ Simple template engine ~

>> Cithakan := Obyek anyar.

Cithakan nalika: ['anyar'] tindakna: { <- dhiri anyar isi: [''].
}.

Cithakan nalika: ['isi:'] tindakna: { :isi
	duweke isi := isi. 
}.

Cithakan nalika: ['anyar:'] tindakna: { :isi <- dhiri anyar isi: isi.
}.

Cithakan nalika: ['potong:'] tindakna: { :tandha
	>> tandha-wiwitan := (['<!-- cut:%id% -->'] %id%: tandha).
	>> tandha-pungkasan := (['<!-- /cut:%id% -->'] %id%: tandha).
	>> perangan-perangan := duweke isi pisah: tandha-wiwitan.
	>> awalan := perangan-perangan pisanan.
	>> perangan-perangan2 := perangan-perangan pungkasan pisah: tandha-pungkasan.
	>> akhiran := perangan-perangan2 pungkasan.
	>> perangan := perangan-perangan2 pisanan.
	>> turahan := awalan + akhiran.
	duweke isi := turahan. <- Cithakan anyar: perangan.
	
}.

Cithakan nalika: ['salin'] tindakna: { <- dhiri anyar: dhiri tèks salin.
}.
	
Cithakan nalika: ['tempel:ing:'] tindakna: { :cuplikan :id
	>> tandha-tempel := (['<!-- paste:%id% -->'] %id%: id).
	duweke isi ganti: tandha-tempel nganggo: ( cuplikan tèks + tandha-tempel ).
}.

Cithakan nalika: ['atur:nilai:'] tindakna: { :slot :nilai
	duweke isi ganti: ['<!-- slot:'] + slot + [' -->'] nganggo: ( Server html-enkode: nilai ).
}.

Cithakan nalika: ['atur:html:'] tindakna: { :slot :html
	duweke isi ganti: ['<!-- slot:'] + slot + [' -->'] nganggo: html.
}.

Cithakan nalika: ['wangsuli:lan:'] tindakna: { :slot :nilai
	dhiri atur: (slot saka: 0 dawa: (slot dawa - 1)) nilai: nilai.
}.

Cithakan nalika: ['nl2br'] tindakna: {
	duweke isi ganti: ['\n'] nganggo: ['<br>'].
}.

Cithakan nalika: ['tata'] tindakna: {
	duweke isi :=
		Pola
		anyar: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		cocog: duweke isi
		tindakna: { <- ['']. }.
}.

Cithakan nalika: ['tata-potongan'] tindakna: {
	>> butir := Dhaptar anyar.
	Pola
	anyar: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	cocog: duweke isi
	tindakna: { :_ :perangan
		butir tambah-ing-mburi: perangan ? 1.
	}.
	butir saben: { :_ :id
		duweke isi :=
			Pola anyar: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			cocog: duweke isi
			tindakna: { <- ['']. }.
	 }.
}.

Cithakan nalika: ['tata-spasi'] tindakna: {
	duweke isi :=
		Pola
		anyar: ['\\s*\\n'],
		cocog: duweke isi
		tindakna: { <- ['\n']. }.
	duweke isi :=
		Pola
		anyar: ['\\n[\\s\\t]+'],
		cocog: duweke isi
		tindakna: { <- ['\n']. }.
}.

Cithakan nalika: ['tata-kabeh'] tindakna: {
	dhiri tata.
	dhiri tata-potongan.
	dhiri tata-spasi.
}.

Cithakan nalika: ['tèks'] tindakna: { <- duweke isi.
}.
