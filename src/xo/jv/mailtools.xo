>> Layang-e := Obyek anyar.

Layang-e nalika: ['siapake'] tindakna: {
	duweke panampa := Dhaptar anyar.
	duweke cc := Dhaptar anyar.
	duweke bcc := Dhaptar anyar.
	duweke pangirim := Kosong.
	duweke jeneng-pangirim := Kosong.
	duweke subyek := Kosong.
	duweke awak := Kosong.
}.

Layang-e nalika: ['anyar'] tindakna: { <- dhiri anyar siapake.
}.

Layang-e nalika: ['marang:'] tindakna: { :panyebutan
	duweke panampa := panyebutan.
}.
 
Layang-e nalika: ['cc:'] tindakna: { :panyebutan
	duweke cc := panyebutan.
}.

Layang-e nalika: ['bcc:'] tindakna: { :panyebutan
	duweke bcc := panyebutan.
}.

Layang-e nalika: ['subyek:'] tindakna: { :subyek
	duweke subyek := subyek.
}.

Layang-e nalika: ['pangirim:jeneng:'] tindakna: { :pangirim :jeneng
	duweke pangirim := pangirim.
	duweke jeneng-pangirim := jeneng.
}.

Layang-e nalika: ['awak:'] tindakna: { :awak
	duweke awak := awak.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Layang-e nalika: ['sesirah:'] tindakna: { :baris <- baris ganti: ['\r'] nganggo: [''], ganti: ['\n'] nganggo: [''].
}.

Layang-e nalika: ['kirim'] tindakna: {
	>> f := Berkas tempwrite: dhiri gawe.
	Program sistem: ['sendmail -t < '] + f dalan, baris-anyar.
}.

Layang-e nalika: ['gawe'] tindakna: {
	>> pamisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-ing-mburi: (dhiri sesirah: ['From: '] + duweke jeneng-pangirim + [' <'] + ( duweke pangirim ) + ['>']) + pamisah-baris.
	untaian tambah-ing-mburi: (dhiri sesirah: ['To: '] + ( duweke panampa gabung: [','] )) + pamisah-baris.
	duweke cc cacah bener: {
		untaian tambah-ing-mburi: (dhiri sesirah: ['Cc: '] + ( duweke cc gabung: [','] )) + pamisah-baris.
	}.
	duweke bcc cacah bener: {
		untaian tambah-ing-mburi: (dhiri sesirah: ['Bcc: '] + ( duweke bcc gabung: [','] )) + pamisah-baris.
	}.
	untaian tambah-ing-mburi: (dhiri sesirah: ['Subject: '] + duweke subyek) + pamisah-baris.
	untaian tambah-ing-mburi: pamisah-baris.
	untaian tambah-ing-mburi: duweke awak.
	untaian tambah-ing-mburi: pamisah-baris. <- untaian.
}.

>> Layang-e-HTML := Layang-e anyar.

Layang-e-HTML nalika: ['siapake'] tindakna: {
	dhiri siapake.
	duweke lampiran := Dhaptar anyar.
	duweke wates := Brankas token: 40.
}.

Layang-e-HTML nalika: ['lampirake:'] tindakna: { :berkas-sesi
	>> id := duweke lampiran cacah.
	>> blob := berkas-sesi blob.
	duweke lampiran tambah-ing-mburi: (
		Kamus anyar
			berkas-sesi: berkas-sesi dalan,
			mime: ['image/'] + (Server mimetype: berkas-sesi dalan),
			data: blob base64-enkode
	).
	blob bebasna. <- ['cid:attachment'] + id.
}.

Layang-e-HTML nalika: ['gawe'] tindakna: {
	>> pamisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-ing-mburi: (dhiri sesirah: ['From: '] + duweke jeneng-pangirim + [' <'] + ( duweke pangirim ) + ['>']) + pamisah-baris.
	untaian tambah-ing-mburi: (dhiri sesirah: ['To: '] + ( duweke panampa gabung: [','] )) + pamisah-baris.
	duweke cc cacah bener: {
		untaian tambah-ing-mburi: (dhiri sesirah: ['Cc: '] + ( duweke cc gabung: [','] )) + pamisah-baris.
	}.
	duweke bcc cacah bener: {
		untaian tambah-ing-mburi: (dhiri sesirah: ['Bcc: '] + ( duweke bcc gabung: [','] )) + pamisah-baris.
	}.
	untaian tambah-ing-mburi: (dhiri sesirah: ['Subject: '] + duweke subyek) + pamisah-baris.
	untaian tambah-ing-mburi: ['MIME-Version: 1.0'] + pamisah-baris.
	untaian tambah-ing-mburi: ['Content-Type: multipart/related; boundary="'] + duweke wates + ['"; type=text/html'] + pamisah-baris.
	untaian tambah-ing-mburi: pamisah-baris.
	untaian tambah-ing-mburi: ['--'] + duweke wates + pamisah-baris.
	untaian tambah-ing-mburi: ['Content-Type: text/html; charset=UTF-8'] + pamisah-baris.
	untaian tambah-ing-mburi: ['Content-Transfer-Encoding: 7bit'] + pamisah-baris.
	untaian tambah-ing-mburi: pamisah-baris.
	untaian tambah-ing-mburi: duweke awak.
	untaian tambah-ing-mburi: pamisah-baris.
	duweke lampiran saben: { :id :info
		>> blob := info data.
		untaian tambah-ing-mburi: ['--'] + duweke wates + pamisah-baris.
		untaian tambah-ing-mburi: ['Content-Type: '] + info mime + pamisah-baris.
		untaian tambah-ing-mburi: ['Content-Transfer-Encoding: base64'] + pamisah-baris.
		untaian tambah-ing-mburi: ['Content-ID: <attachment'] + id + ['>'] + pamisah-baris.
		untaian tambah-ing-mburi: ['Content-Disposition: inline; filename="'] + info berkas-sesi + ['"'] + pamisah-baris.
		untaian tambah-ing-mburi: pamisah-baris.
		>> paling-akeh := 76.
		>> dawa-teks := blob dawa.
		>> gumpalan-gumpalan := (dawa-teks / paling-akeh) bunderake-munggah.
		{ :i
			>> gumpalan := blob salin saka: i * paling-akeh dawa: paling-akeh.
			untaian tambah-ing-mburi: gumpalan + pamisah-baris.
		} * gumpalan-gumpalan.
		untaian tambah-ing-mburi: pamisah-baris.
		untaian tambah-ing-mburi: pamisah-baris.
	}.
	untaian tambah-ing-mburi: ['--'] + duweke wates + ['--'] + pamisah-baris. <- untaian.
}.
