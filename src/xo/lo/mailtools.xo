>> Email := ວັດຖຸ ໃໝ່.

Email ເມື່ອ: ['init'] ເຮັດ: {
	ຂອງຕົນ recipients := ລິສ ໃໝ່.
	ຂອງຕົນ cc := ລິສ ໃໝ່.
	ຂອງຕົນ bcc := ລິສ ໃໝ່.
	ຂອງຕົນ from := ວ່າງ.
	ຂອງຕົນ from-name := ວ່າງ.
	ຂອງຕົນ subject := ວ່າງ.
	ຂອງຕົນ body := ວ່າງ.
}.

Email ເມື່ອ: ['ໃໝ່'] ເຮັດ: { <- ຕົນເອງ ໃໝ່ init.
}.

Email ເມື່ອ: ['to:'] ເຮັດ: { :list
	ຂອງຕົນ recipients := list.
}.
 
Email ເມື່ອ: ['cc:'] ເຮັດ: { :list
	ຂອງຕົນ cc := list.
}.

Email ເມື່ອ: ['bcc:'] ເຮັດ: { :list
	ຂອງຕົນ bcc := list.
}.

Email ເມື່ອ: ['subject:'] ເຮັດ: { :subject
	ຂອງຕົນ subject := subject.
}.

Email ເມື່ອ: ['from:name:'] ເຮັດ: { :from :ຊື່
	ຂອງຕົນ from := from.
	ຂອງຕົນ from-name := ຊື່.
}.

Email ເມື່ອ: ['body:'] ເຮັດ: { :body
	ຂອງຕົນ body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email ເມື່ອ: ['header:'] ເຮັດ: { :line <- line ແທນທີ່: ['\r'] ດ້ວຍ: [''], ແທນທີ່: ['\n'] ດ້ວຍ: [''].
}.

Email ເມື່ອ: ['send'] ເຮັດ: {
	>> f := ໄຟລ໌ tempwrite: ຕົນເອງ generate.
	ໂປຣແກຣມ ລະບົບ: ['sendmail -t < '] + f ເສັ້ນທາງ, ຂຶ້ນແຖວໃໝ່.
}.

Email ເມື່ອ: ['generate'] ເຮັດ: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['From: '] + ຂອງຕົນ from-name + [' <'] + ( ຂອງຕົນ from ) + ['>']) + brk.
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['To: '] + ( ຂອງຕົນ recipients ລວມ: [','] )) + brk.
	ຂອງຕົນ cc ຈຳນວນ ຖ້າຈິງ: {
		str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Cc: '] + ( ຂອງຕົນ cc ລວມ: [','] )) + brk.
	}.
	ຂອງຕົນ bcc ຈຳນວນ ຖ້າຈິງ: {
		str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Bcc: '] + ( ຂອງຕົນ bcc ລວມ: [','] )) + brk.
	}.
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Subject: '] + ຂອງຕົນ subject) + brk.
	str ຕໍ່ທ້າຍ: brk.
	str ຕໍ່ທ້າຍ: ຂອງຕົນ body.
	str ຕໍ່ທ້າຍ: brk. <- str.
}.

>> HTML-Email := Email ໃໝ່.

HTML-Email ເມື່ອ: ['init'] ເຮັດ: {
	ຕົນເອງ init.
	ຂອງຕົນ attachments := ລິສ ໃໝ່.
	ຂອງຕົນ boundary := ຕູ້ນິລະໄພ ໂທເຄັນ: 40.
}.

HTML-Email ເມື່ອ: ['attach:'] ເຮັດ: { :file
	>> id := ຂອງຕົນ attachments ຈຳນວນ.
	>> blob := file blob.
	ຂອງຕົນ attachments ຕໍ່ທ້າຍ: (
		ວັດຈະນານຸກົມ ໃໝ່
			file: file ເສັ້ນທາງ,
			mime: ['image/'] + (Server mimetype: file ເສັ້ນທາງ),
			data: blob base64-ເຂົ້າລະຫັດ
	).
	blob ປ່ອຍໜ່ວຍຄວາມຈຳ. <- ['cid:attachment'] + id.
}.

HTML-Email ເມື່ອ: ['generate'] ເຮັດ: {
	>> brk := ['\r\n'].
	>> str := [''].
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['From: '] + ຂອງຕົນ from-name + [' <'] + ( ຂອງຕົນ from ) + ['>']) + brk.
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['To: '] + ( ຂອງຕົນ recipients ລວມ: [','] )) + brk.
	ຂອງຕົນ cc ຈຳນວນ ຖ້າຈິງ: {
		str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Cc: '] + ( ຂອງຕົນ cc ລວມ: [','] )) + brk.
	}.
	ຂອງຕົນ bcc ຈຳນວນ ຖ້າຈິງ: {
		str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Bcc: '] + ( ຂອງຕົນ bcc ລວມ: [','] )) + brk.
	}.
	str ຕໍ່ທ້າຍ: (ຕົນເອງ header: ['Subject: '] + ຂອງຕົນ subject) + brk.
	str ຕໍ່ທ້າຍ: ['MIME-Version: 1.0'] + brk.
	str ຕໍ່ທ້າຍ: ['Content-Type: multipart/related; boundary="'] + ຂອງຕົນ boundary + ['"; type=text/html'] + brk.
	str ຕໍ່ທ້າຍ: brk.
	str ຕໍ່ທ້າຍ: ['--'] + ຂອງຕົນ boundary + brk.
	str ຕໍ່ທ້າຍ: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str ຕໍ່ທ້າຍ: ['Content-Transfer-Encoding: 7bit'] + brk.
	str ຕໍ່ທ້າຍ: brk.
	str ຕໍ່ທ້າຍ: ຂອງຕົນ body.
	str ຕໍ່ທ້າຍ: brk.
	ຂອງຕົນ attachments ແຕ່ລະຕົວ: { :id :info
		>> blob := info data.
		str ຕໍ່ທ້າຍ: ['--'] + ຂອງຕົນ boundary + brk.
		str ຕໍ່ທ້າຍ: ['Content-Type: '] + info mime + brk.
		str ຕໍ່ທ້າຍ: ['Content-Transfer-Encoding: base64'] + brk.
		str ຕໍ່ທ້າຍ: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str ຕໍ່ທ້າຍ: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str ຕໍ່ທ້າຍ: brk.
		>> max := 76.
		>> len := blob ຄວາມຍາວ.
		>> chunks := (len / max) ປັດຂຶ້ນ.
		{ :i
			>> chunk := blob ສຳເນົາ ເລີ່ມທີ່: i * max ຄວາມຍາວ: max.
			str ຕໍ່ທ້າຍ: chunk + brk.
		} * chunks.
		str ຕໍ່ທ້າຍ: brk.
		str ຕໍ່ທ້າຍ: brk.
	}.
	str ຕໍ່ທ້າຍ: ['--'] + ຂອງຕົນ boundary + ['--'] + brk. <- str.
}.
