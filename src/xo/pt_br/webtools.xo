Requisição-HTTP em: ['HTTP-cabeçalho:'] fazer: { :chave <- Programa configurar: chave.
}.

>> Cabeçalho-HTTP := Objeto novo.

Cabeçalho-HTTP em: ['novo'] fazer: { <- isto novo inicializar.
}.

Cabeçalho-HTTP em: ['inicializar'] fazer: {
	prop chave := Nulo.
	prop valor := Nulo.
}.

Cabeçalho-HTTP em: ['chave:valor:'] fazer: { :chave :valor
	prop chave := chave.
	prop valor := valor.
}.

Cabeçalho-HTTP em: ['chave'] fazer: { <- prop chave.
}.

Cabeçalho-HTTP em: ['valor'] fazer: { <- prop valor.
}.


Cabeçalho-HTTP em: ['string'] fazer: {
	>> linha := prop chave + [': '] + prop valor.
	linha substituir: ['\r'] com: [''], substituir: ['\n'] com: ['']. <- linha + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Documento-Web := Objeto novo.

Documento-Web em: ['novo'] fazer: { <- isto novo inicializar.
}.

Documento-Web em: ['inicializar'] fazer: {
	prop cabeçalhos := Listar novo.
	prop id-sessão := Nulo.
	prop gerenciador-sessão := Sessão-arquivo-temporário novo.
	prop dados-sessão := Nulo.
	prop seguro := Sim.
	prop mesmo-site := ['Strict'].
	prop cabeçalhos-enviados := Não.
	prop requisição := Requisição-HTTP novo.
}.

Documento-Web em: ['requisição:'] fazer: { :requisição
	prop requisição := requisição.
}. 

Documento-Web em: ['cookie-sessão-seguro:'] fazer: { :seguro
	isto verificar-cabeçalhos.
	prop seguro := seguro.
}.

Documento-Web em: ['cookie-sessão-mesmo-site:'] fazer: { :valor
	isto verificar-cabeçalhos.
	>> opções := Listar novo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opções tem: valor, não: {
		este-bloco-de-código erro: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	prop mesmo-site := valor.
}.

Documento-Web em: ['cabeçalho:'] fazer: { :cabeçalho
	isto verificar-cabeçalhos.
	prop cabeçalhos acrescentar: cabeçalho.
}.

Documento-Web em: ['apagar-cabeçalhos'] fazer: {
	isto verificar-cabeçalhos.
	prop cabeçalhos := Listar novo.
}.

Documento-Web em: ['gerenciador-sessão:'] fazer: { :gerenciador
	isto verificar-cabeçalhos.
	prop gerenciador-sessão := gerenciador.
}.

Documento-Web em: ['gerenciador-sessão'] fazer: { <- prop gerenciador-sessão.
}.

Documento-Web em: ['verificar-cabeçalhos'] fazer: {
	prop cabeçalhos-enviados sim: {
		este-bloco-de-código erro: ['Headers already sent to client.'].
	}.
}.

Documento-Web em: ['iniciar-sessão'] fazer: {
	isto verificar-cabeçalhos.
	>> requisição := prop requisição.
	>> id-sessão := requisição cookie: ['xsid'].
	id-sessão Nulo? não: {
		(( Padrão novo: ['^[A-Za-z0-9]+\\z'], corresponder: id-sessão ) = 0) sim: {
			id-sessão := Nulo.
		}.
	}.
	id-sessão Nulo? sim: {
		id-sessão := Cofre token: 30.
		>> cabeçalho-sessão := Cabeçalho-HTTP novo
		chave: ['Set-Cookie'] valor: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (prop seguro outro: ['Secure'] ou: ['']),
		SSITE: (prop mesmo-site),
		XSID: id-sessão
		).
		prop cabeçalhos acrescentar: cabeçalho-sessão.
	}.
	prop dados-sessão := prop gerenciador-sessão para: id-sessão, carregar. <- prop dados-sessão. # reference
}.

Documento-Web em: ['ir-para:'] fazer: { :endereço
	isto verificar-cabeçalhos.
	isto apagar-cabeçalhos.
	prop cabeçalhos
	acrescentar: (
		Cabeçalho-HTTP novo
		chave: ['Status'] valor: ['303 See Other']
	),
	acrescentar: (
		Cabeçalho-HTTP novo
		chave: ['Location'] valor: endereço
	).
	isto emitir: ['Redirect'].
}.

Documento-Web em: ['destruir-sessão'] fazer: {
	isto verificar-cabeçalhos.
	>> requisição := prop requisição.
	>> id-sessão := requisição cookie: ['xsid'].
	id-sessão Nulo? não: {
		>> cabeçalho-sessão := Cabeçalho-HTTP novo.
		>> momento := Momento novo ano: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		cabeçalho-sessão chave: ['Set-Cookie'] valor: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: momento,
			SEC: (prop seguro outro: ['Secure'] ou: ['']),
			SSITE: (prop mesmo-site),
			XSID: id-sessão
		).
		prop gerenciador-sessão destruir.
		prop cabeçalhos acrescentar: cabeçalho-sessão.
	}.
}.


Documento-Web em: ['modelo:'] fazer: { :caminho <- Modelo novo: (Arquivo novo: caminho, ler).
}.

Documento-Web em: ['emitir:tipo:'] fazer: { :saída :tipo
	prop cabeçalhos-enviados não: {
		prop dados-sessão Nulo? não: {
			prop gerenciador-sessão salvar: prop dados-sessão.
		}.
		prop cabeçalhos acrescentar: (
			Cabeçalho-HTTP novo
			chave: ['Content-type'] valor: tipo
		).
		prop cabeçalhos cada-um: { :_ :cabeçalho
			Saída escrever: cabeçalho.
		}.
		prop cabeçalhos-enviados := Sim.
		Saída escrever: ['\r\n'].
	}.
	Saída escrever: saída.
}.

Documento-Web em: ['finalizar:tipo:'] fazer: { :saída :tipo
	prop cabeçalhos-enviados não: {
		prop dados-sessão Nulo? não: {
			prop gerenciador-sessão salvar: prop dados-sessão.
		}.
		prop cabeçalhos acrescentar: (
			Cabeçalho-HTTP novo
			chave: ['Content-type'] valor: tipo
		).
		prop cabeçalhos acrescentar: (
			Cabeçalho-HTTP novo
			chave: ['Content-Length'] valor: saída string bytes
		).
		prop cabeçalhos cada-um: { :_ :cabeçalho
			Saída escrever: cabeçalho.
		}.
		prop cabeçalhos-enviados := Sim.
		Saída escrever: ['\r\n'].
	}.
	Saída escrever: saída.
}.

Documento-Web em: ['emitir:'] fazer: { :saída
	isto emitir: saída tipo: ['text/html; charset=utf-8'].
}.

Documento-Web em: ['finalizar:'] fazer: { :saída
	isto finalizar: saída tipo: ['text/html; charset=utf-8'].
}.

Documento-Web em: ['json:'] fazer: { :saída
	isto emitir: ( JSON jsonificar: saída ) tipo: ['application/json'].
}.

Documento-Web em: ['não-encontrado:'] fazer: { :saída
	isto apagar-cabeçalhos cabeçalho: (
		Cabeçalho-HTTP novo chave: ['Status'] valor: ['404 Not Found']
	).
	isto emitir: saída.
}.


# Interface

>> Sessão := Objeto novo.

Sessão em: ['novo'] fazer: { <- isto novo inicializar para: Nulo.
}.

Sessão em: ['para:'] fazer: { :id
	prop id := id.
}.

Sessão em: ['carregar'] fazer: {
	este-bloco-de-código erro: ['Not implemented.'].
}.

Sessão em: ['salvar:'] fazer: {
	este-bloco-de-código erro: ['Not implemented.'].
}.

Sessão em: ['destruir'] fazer: {
	este-bloco-de-código erro: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sessão-arquivo-temporário := Sessão novo.

Sessão-arquivo-temporário em: ['inicializar'] fazer: {
	prop prefixocaminho := ['/tmp/sess-'].
}.

Sessão-arquivo-temporário em: ['prefixo-caminho:'] fazer: { :cadeia
	prop prefixocaminho := cadeia.
}.

Sessão-arquivo-temporário em: ['arquivo'] fazer: { <- ( Arquivo novo: ( prop prefixocaminho + prop id + ['.txt'] ) ).
}.

Sessão-arquivo-temporário em: ['carregar'] fazer: {
	>> arquivo := isto arquivo.
	arquivo existe não: {
		arquivo escrever: (Mapa novo code).
	}. <- arquivo ler objeto.
}.

Sessão-arquivo-temporário em: ['salvar:'] fazer: { :dados
	>> arquivo := isto arquivo.
	arquivo existe sim: {
		arquivo escrever: dados code.
	}.
}.

Sessão-arquivo-temporário em: ['destruir'] fazer: {
	>> arquivo := isto arquivo.
	arquivo existe sim: {
		arquivo apagar.
	}.
}.


>> URL := Objeto novo.

URL em: ['inicializar'] fazer: {
	prop protocolo := ['https://'].
	prop host := ['localhost'].
	prop caminho := [''].
	prop parâmetros := [''].
	prop hash := [''].
}.

URL em: ['novo'] fazer: { <- isto novo inicializar.
}.

URL em: ['string'] fazer: { <- (
	prop protocolo +
	prop host +
	prop caminho +
	prop parâmetros +
	prop hash ).
}.

URL em: ['protocolo:'] fazer: { :protocolo
	((Listar novo ; ['http'] ; ['https']) tem: protocolo) sim: {
		prop protocolo := protocolo + ['://'].
	}, não: {
		este-bloco-de-código erro: ['Invalid protocol'].
	}.
}.

URL em: ['host:'] fazer: { :host
	#todo validate according to rfc
	prop host := host.
}.

URL em: ['caminho:'] fazer: { :caminho
	prop caminho := ['/'] + caminho url-codificar.
}.

URL em: ['parâmetros:'] fazer: { :mapa
	>> parâmetros := Listar novo.
	mapa cada-um: { :chave :valor
		parâmetros acrescentar: chave string url-codificar + ['='] + valor string url-codificar.
	}.
	prop parâmetros := ['?'] + ( parâmetros juntar: ['&'] ).
}.

URL em: ['hash:'] fazer: { :hash
	prop hash := ['#'] + hash url-codificar.
}.

