
# ~ Simple template engine ~

>> Modelo := Objeto novo.

Modelo em: ['novo'] fazer: { <- isto novo conteúdo: [''].
}.

Modelo em: ['conteúdo:'] fazer: { :conteúdo
	prop conteúdo := conteúdo. 
}.

Modelo em: ['novo:'] fazer: { :conteúdo <- isto novo conteúdo: conteúdo.
}.

Modelo em: ['cortar:'] fazer: { :marcador
	>> marcador-início := (['<!-- cut:%id% -->'] %id%: marcador).
	>> marcador-fim := (['<!-- /cut:%id% -->'] %id%: marcador).
	>> partes := prop conteúdo dividir: marcador-início.
	>> prefixo := partes primeiro.
	>> partes2 := partes último dividir: marcador-fim.
	>> sufixo := partes2 último.
	>> parte := partes2 primeiro.
	>> resto := prefixo + sufixo.
	prop conteúdo := resto. <- Modelo novo: parte.
	
}.

Modelo em: ['copiar'] fazer: { <- isto novo: isto string copiar.
}.
	
Modelo em: ['colar:em:'] fazer: { :trecho :id
	>> marcador-colar := (['<!-- paste:%id% -->'] %id%: id).
	prop conteúdo substituir: marcador-colar com: ( trecho string + marcador-colar ).
}.

Modelo em: ['setar:valor:'] fazer: { :espaço :valor
	prop conteúdo substituir: ['<!-- slot:'] + espaço + [' -->'] com: ( Server html-codificar: valor ).
}.

Modelo em: ['setar:html:'] fazer: { :espaço :html
	prop conteúdo substituir: ['<!-- slot:'] + espaço + [' -->'] com: html.
}.

Modelo em: ['responder:e:'] fazer: { :espaço :valor
	isto setar: (espaço de: 0 comprimento: (espaço comprimento - 1)) valor: valor.
}.

Modelo em: ['nl2br'] fazer: {
	prop conteúdo substituir: ['\n'] com: ['<br>'].
}.

Modelo em: ['depurar'] fazer: {
	prop conteúdo :=
		Padrão
		novo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		corresponder: prop conteúdo
		fazer: { <- ['']. }.
}.

Modelo em: ['depurar-cortes'] fazer: {
	>> itens := Listar novo.
	Padrão
	novo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	corresponder: prop conteúdo
	fazer: { :_ :parte
		itens acrescentar: parte ? 1.
	}.
	itens cada-um: { :_ :id
		prop conteúdo :=
			Padrão novo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			corresponder: prop conteúdo
			fazer: { <- ['']. }.
	 }.
}.

Modelo em: ['depurar-espaços'] fazer: {
	prop conteúdo :=
		Padrão
		novo: ['\\s*\\n'],
		corresponder: prop conteúdo
		fazer: { <- ['\n']. }.
	prop conteúdo :=
		Padrão
		novo: ['\\n[\\s\\t]+'],
		corresponder: prop conteúdo
		fazer: { <- ['\n']. }.
}.

Modelo em: ['depurar-tudo'] fazer: {
	isto depurar.
	isto depurar-cortes.
	isto depurar-espaços.
}.

Modelo em: ['string'] fazer: { <- prop conteúdo.
}.
