
# ~ Simple template engine ~

>> Qəlib := Obyekt yeni.

Qəlib olanda: ['yeni'] et: { <- özü yeni məzmun: [''].
}.

Qəlib olanda: ['məzmun:'] et: { :məzmun
	öz məzmun := məzmun. 
}.

Qəlib olanda: ['yeni:'] et: { :məzmun <- özü yeni məzmun: məzmun.
}.

Qəlib olanda: ['kəs:'] et: { :işarə
	>> başlanğıc-işarəsi := (['<!-- cut:%id% -->'] %id%: işarə).
	>> son-işarə := (['<!-- /cut:%id% -->'] %id%: işarə).
	>> parçalar := öz məzmun böl: başlanğıc-işarəsi.
	>> prefiks := parçalar birinci.
	>> parçalar2 := parçalar sonuncu böl: son-işarə.
	>> suffiks := parçalar2 sonuncu.
	>> parça := parçalar2 birinci.
	>> qalıq := prefiks + suffiks.
	öz məzmun := qalıq. <- Qəlib yeni: parça.
	
}.

Qəlib olanda: ['surət'] et: { <- özü yeni: özü mətn surət.
}.
	
Qəlib olanda: ['yapışdır:yerə:'] et: { :fraqment-html :id
	>> yapışdırma-işarəsi := (['<!-- paste:%id% -->'] %id%: id).
	öz məzmun əvəzlə: yapışdırma-işarəsi ilə: ( fraqment-html mətn + yapışdırma-işarəsi ).
}.

Qəlib olanda: ['təyin-et:dəyər:'] et: { :yer :dəyər
	öz məzmun əvəzlə: ['<!-- slot:'] + yer + [' -->'] ilə: ( Server html-kodla: dəyər ).
}.

Qəlib olanda: ['təyin-et:html:'] et: { :yer :html
	öz məzmun əvəzlə: ['<!-- slot:'] + yer + [' -->'] ilə: html.
}.

Qəlib olanda: ['cavab-ver:və:'] et: { :yer :dəyər
	özü təyin-et: (yer başlanğıc: 0 uzunluq: (yer uzunluq - 1)) dəyər: dəyər.
}.

Qəlib olanda: ['nl2br'] et: {
	öz məzmun əvəzlə: ['\n'] ilə: ['<br>'].
}.

Qəlib olanda: ['səliqələ'] et: {
	öz məzmun :=
		Şablon
		yeni: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		uyğunluq: öz məzmun
		et: { <- ['']. }.
}.

Qəlib olanda: ['kəsikləri-səliqələ'] et: {
	>> elementlər := Siyahı yeni.
	Şablon
	yeni: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	uyğunluq: öz məzmun
	et: { :_ :parça
		elementlər sona-əlavə-et: parça ? 1.
	}.
	elementlər hər: { :_ :id
		öz məzmun :=
			Şablon yeni: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			uyğunluq: öz məzmun
			et: { <- ['']. }.
	 }.
}.

Qəlib olanda: ['boşluqları-səliqələ'] et: {
	öz məzmun :=
		Şablon
		yeni: ['\\s*\\n'],
		uyğunluq: öz məzmun
		et: { <- ['\n']. }.
	öz məzmun :=
		Şablon
		yeni: ['\\n[\\s\\t]+'],
		uyğunluq: öz məzmun
		et: { <- ['\n']. }.
}.

Qəlib olanda: ['hamısını-səliqələ'] et: {
	özü səliqələ.
	özü kəsikləri-səliqələ.
	özü boşluqları-səliqələ.
}.

Qəlib olanda: ['mətn'] et: { <- öz məzmun.
}.
