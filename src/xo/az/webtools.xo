HTTP-Sorğu olanda: ['HTTP-başlıq:'] et: { :açar <- Proqram parametr: açar.
}.

>> HTTP-Başlığı := Obyekt yeni.

HTTP-Başlığı olanda: ['yeni'] et: { <- özü yeni hazırla.
}.

HTTP-Başlığı olanda: ['hazırla'] et: {
	öz açar := Heç.
	öz dəyər := Heç.
}.

HTTP-Başlığı olanda: ['açar:dəyər:'] et: { :açar :dəyər
	öz açar := açar.
	öz dəyər := dəyər.
}.

HTTP-Başlığı olanda: ['açar'] et: { <- öz açar.
}.

HTTP-Başlığı olanda: ['dəyər'] et: { <- öz dəyər.
}.


HTTP-Başlığı olanda: ['mətn'] et: {
	>> sətir := öz açar + [': '] + öz dəyər.
	sətir əvəzlə: ['\r'] ilə: [''], əvəzlə: ['\n'] ilə: ['']. <- sətir + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Veb-sənəd := Obyekt yeni.

Veb-sənəd olanda: ['yeni'] et: { <- özü yeni hazırla.
}.

Veb-sənəd olanda: ['hazırla'] et: {
	öz başlıqlar := Siyahı yeni.
	öz sessiya-id := Heç.
	öz sessiya-meneceri := Müvəqqəti-fayl-sessiyası yeni.
	öz sessiya-verilənləri := Heç.
	öz təhlükəsiz := Doğru.
	öz eyni-sayt := ['Strict'].
	öz başlıqlar-göndərildi := Yalan.
	öz http-sorğu := HTTP-Sorğu yeni.
}.

Veb-sənəd olanda: ['http-sorğu:'] et: { :http-sorğu
	öz http-sorğu := http-sorğu.
}. 

Veb-sənəd olanda: ['təhlükəsiz-sessiya-kukisi:'] et: { :təhlükəsiz
	özü başlıqları-yoxla.
	öz təhlükəsiz := təhlükəsiz.
}.

Veb-sənəd olanda: ['eyni-sayt-sessiya-kukisi:'] et: { :dəyər
	özü başlıqları-yoxla.
	>> seçimlər := Siyahı yeni 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	seçimlər var: dəyər, yalan: {
		bu-tapşırıq səhv: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	öz eyni-sayt := dəyər.
}.

Veb-sənəd olanda: ['başlıq:'] et: { :başlıq
	özü başlıqları-yoxla.
	öz başlıqlar sona-əlavə-et: başlıq.
}.

Veb-sənəd olanda: ['başlıqları-boşalt'] et: {
	özü başlıqları-yoxla.
	öz başlıqlar := Siyahı yeni.
}.

Veb-sənəd olanda: ['sessiya-meneceri:'] et: { :menecer
	özü başlıqları-yoxla.
	öz sessiya-meneceri := menecer.
}.

Veb-sənəd olanda: ['sessiya-meneceri'] et: { <- öz sessiya-meneceri.
}.

Veb-sənəd olanda: ['başlıqları-yoxla'] et: {
	öz başlıqlar-göndərildi doğru: {
		bu-tapşırıq səhv: ['Headers already sent to client.'].
	}.
}.

Veb-sənəd olanda: ['sessiyanı-başlat'] et: {
	özü başlıqları-yoxla.
	>> http-sorğu := öz http-sorğu.
	>> sessiya-id := http-sorğu cookie: ['xsid'].
	sessiya-id Heç? yalan: {
		(( Şablon yeni: ['^[A-Za-z0-9]+\\z'], uyğunluq: sessiya-id ) = 0) doğru: {
			sessiya-id := Heç.
		}.
	}.
	sessiya-id Heç? doğru: {
		sessiya-id := Seyf token: 30.
		>> sessiya-başlığı := HTTP-Başlığı yeni
		açar: ['Set-Cookie'] dəyər: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (öz təhlükəsiz ya: ['Secure'] ya: ['']),
		SSITE: (öz eyni-sayt),
		XSID: sessiya-id
		).
		öz başlıqlar sona-əlavə-et: sessiya-başlığı.
	}.
	öz sessiya-verilənləri := öz sessiya-meneceri üçün: sessiya-id, yüklə. <- öz sessiya-verilənləri. # reference
}.

Veb-sənəd olanda: ['keç:'] et: { :ünvan
	özü başlıqları-yoxla.
	özü başlıqları-boşalt.
	öz başlıqlar
	sona-əlavə-et: (
		HTTP-Başlığı yeni
		açar: ['Status'] dəyər: ['303 See Other']
	),
	sona-əlavə-et: (
		HTTP-Başlığı yeni
		açar: ['Location'] dəyər: ünvan
	).
	özü çıxar: ['Redirect'].
}.

Veb-sənəd olanda: ['sessiyanı-məhv-et'] et: {
	özü başlıqları-yoxla.
	>> http-sorğu := öz http-sorğu.
	>> sessiya-id := http-sorğu cookie: ['xsid'].
	sessiya-id Heç? yalan: {
		>> sessiya-başlığı := HTTP-Başlığı yeni.
		>> an := An yeni il: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessiya-başlığı açar: ['Set-Cookie'] dəyər: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: an,
			SEC: (öz təhlükəsiz ya: ['Secure'] ya: ['']),
			SSITE: (öz eyni-sayt),
			XSID: sessiya-id
		).
		öz sessiya-meneceri məhv-et.
		öz başlıqlar sona-əlavə-et: sessiya-başlığı.
	}.
}.


Veb-sənəd olanda: ['qəlib:'] et: { :yol <- Qəlib yeni: (Fayl yeni: yol, oxu).
}.

Veb-sənəd olanda: ['çıxar:növ:'] et: { :nəticə :növ
	öz başlıqlar-göndərildi yalan: {
		öz sessiya-verilənləri Heç? yalan: {
			öz sessiya-meneceri saxla: öz sessiya-verilənləri.
		}.
		öz başlıqlar sona-əlavə-et: (
			HTTP-Başlığı yeni
			açar: ['Content-type'] dəyər: növ
		).
		öz başlıqlar hər: { :_ :başlıq
			Çıxış yaz: başlıq.
		}.
		öz başlıqlar-göndərildi := Doğru.
		Çıxış yaz: ['\r\n'].
	}.
	Çıxış yaz: nəticə.
}.

Veb-sənəd olanda: ['tamamla:növ:'] et: { :nəticə :növ
	öz başlıqlar-göndərildi yalan: {
		öz sessiya-verilənləri Heç? yalan: {
			öz sessiya-meneceri saxla: öz sessiya-verilənləri.
		}.
		öz başlıqlar sona-əlavə-et: (
			HTTP-Başlığı yeni
			açar: ['Content-type'] dəyər: növ
		).
		öz başlıqlar sona-əlavə-et: (
			HTTP-Başlığı yeni
			açar: ['Content-Length'] dəyər: nəticə mətn bytes
		).
		öz başlıqlar hər: { :_ :başlıq
			Çıxış yaz: başlıq.
		}.
		öz başlıqlar-göndərildi := Doğru.
		Çıxış yaz: ['\r\n'].
	}.
	Çıxış yaz: nəticə.
}.

Veb-sənəd olanda: ['çıxar:'] et: { :nəticə
	özü çıxar: nəticə növ: ['text/html; charset=utf-8'].
}.

Veb-sənəd olanda: ['tamamla:'] et: { :nəticə
	özü tamamla: nəticə növ: ['text/html; charset=utf-8'].
}.

Veb-sənəd olanda: ['json:'] et: { :nəticə
	özü çıxar: ( JSON jsonify: nəticə ) növ: ['application/json'].
}.

Veb-sənəd olanda: ['tapılmadı:'] et: { :nəticə
	özü başlıqları-boşalt başlıq: (
		HTTP-Başlığı yeni açar: ['Status'] dəyər: ['404 Not Found']
	).
	özü çıxar: nəticə.
}.


# Interface

>> Sessiya := Obyekt yeni.

Sessiya olanda: ['yeni'] et: { <- özü yeni hazırla üçün: Heç.
}.

Sessiya olanda: ['üçün:'] et: { :id
	öz id := id.
}.

Sessiya olanda: ['yüklə'] et: {
	bu-tapşırıq səhv: ['Not implemented.'].
}.

Sessiya olanda: ['saxla:'] et: {
	bu-tapşırıq səhv: ['Not implemented.'].
}.

Sessiya olanda: ['məhv-et'] et: {
	bu-tapşırıq səhv: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Müvəqqəti-fayl-sessiyası := Sessiya yeni.

Müvəqqəti-fayl-sessiyası olanda: ['hazırla'] et: {
	öz yol-başı := ['/tmp/sess-'].
}.

Müvəqqəti-fayl-sessiyası olanda: ['yol-prefiksi:'] et: { :sətir-zənciri
	öz yol-başı := sətir-zənciri.
}.

Müvəqqəti-fayl-sessiyası olanda: ['fayl'] et: { <- ( Fayl yeni: ( öz yol-başı + öz id + ['.txt'] ) ).
}.

Müvəqqəti-fayl-sessiyası olanda: ['yüklə'] et: {
	>> fayl := özü fayl.
	fayl mövcuddur yalan: {
		fayl yaz: (Lüğət yeni kod).
	}. <- fayl oxu obyekt.
}.

Müvəqqəti-fayl-sessiyası olanda: ['saxla:'] et: { :verilənlər
	>> fayl := özü fayl.
	fayl mövcuddur doğru: {
		fayl yaz: verilənlər kod.
	}.
}.

Müvəqqəti-fayl-sessiyası olanda: ['məhv-et'] et: {
	>> fayl := özü fayl.
	fayl mövcuddur doğru: {
		fayl sil.
	}.
}.


>> URL := Obyekt yeni.

URL olanda: ['hazırla'] et: {
	öz protokol := ['https://'].
	öz host := ['localhost'].
	öz yol := [''].
	öz url-parametrləri := [''].
	öz hash := [''].
}.

URL olanda: ['yeni'] et: { <- özü yeni hazırla.
}.

URL olanda: ['mətn'] et: { <- (
	öz protokol +
	öz host +
	öz yol +
	öz url-parametrləri +
	öz hash ).
}.

URL olanda: ['protokol:'] et: { :protokol
	((Siyahı yeni ; ['http'] ; ['https']) var: protokol) doğru: {
		öz protokol := protokol + ['://'].
	}, yalan: {
		bu-tapşırıq səhv: ['Invalid protocol'].
	}.
}.

URL olanda: ['host:'] et: { :host
	#todo validate according to rfc
	öz host := host.
}.

URL olanda: ['yol:'] et: { :yol
	öz yol := ['/'] + yol url-kodla.
}.

URL olanda: ['url-parametrləri:'] et: { :uyğunlaşdırma
	>> url-parametrləri := Siyahı yeni.
	uyğunlaşdırma hər: { :açar :dəyər
		url-parametrləri sona-əlavə-et: açar mətn url-kodla + ['='] + dəyər mətn url-kodla.
	}.
	öz url-parametrləri := ['?'] + ( url-parametrləri birləşdir: ['&'] ).
}.

URL olanda: ['heş:'] et: { :hash
	öz hash := ['#'] + hash url-kodla.
}.

