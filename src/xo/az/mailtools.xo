>> E-poçt := Obyekt yeni.

E-poçt olanda: ['hazırla'] et: {
	öz alanlar := Siyahı yeni.
	öz cc := Siyahı yeni.
	öz bcc := Siyahı yeni.
	öz göndərən := Heç.
	öz göndərən-adı := Heç.
	öz mövzu := Heç.
	öz gövdə := Heç.
}.

E-poçt olanda: ['yeni'] et: { <- özü yeni hazırla.
}.

E-poçt olanda: ['alana:'] et: { :sadalama
	öz alanlar := sadalama.
}.
 
E-poçt olanda: ['cc:'] et: { :sadalama
	öz cc := sadalama.
}.

E-poçt olanda: ['bcc:'] et: { :sadalama
	öz bcc := sadalama.
}.

E-poçt olanda: ['mövzu:'] et: { :mövzu
	öz mövzu := mövzu.
}.

E-poçt olanda: ['göndərən:ad:'] et: { :göndərən :ad
	öz göndərən := göndərən.
	öz göndərən-adı := ad.
}.

E-poçt olanda: ['gövdə:'] et: { :gövdə
	öz gövdə := gövdə.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-poçt olanda: ['başlıq:'] et: { :sətir <- sətir əvəzlə: ['\r'] ilə: [''], əvəzlə: ['\n'] ilə: [''].
}.

E-poçt olanda: ['göndər'] et: {
	>> f := Fayl tempwrite: özü yarat.
	Proqram sistem: ['sendmail -t < '] + f yol, yeni-sətir.
}.

E-poçt olanda: ['yarat'] et: {
	>> sətir-sonu := ['\r\n'].
	>> sətir-zənciri := [''].
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['From: '] + öz göndərən-adı + [' <'] + ( öz göndərən ) + ['>']) + sətir-sonu.
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['To: '] + ( öz alanlar birləşdir: [','] )) + sətir-sonu.
	öz cc say doğru: {
		sətir-zənciri sona-əlavə-et: (özü başlıq: ['Cc: '] + ( öz cc birləşdir: [','] )) + sətir-sonu.
	}.
	öz bcc say doğru: {
		sətir-zənciri sona-əlavə-et: (özü başlıq: ['Bcc: '] + ( öz bcc birləşdir: [','] )) + sətir-sonu.
	}.
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['Subject: '] + öz mövzu) + sətir-sonu.
	sətir-zənciri sona-əlavə-et: sətir-sonu.
	sətir-zənciri sona-əlavə-et: öz gövdə.
	sətir-zənciri sona-əlavə-et: sətir-sonu. <- sətir-zənciri.
}.

>> HTML-E-poçt := E-poçt yeni.

HTML-E-poçt olanda: ['hazırla'] et: {
	özü hazırla.
	öz qoşmalar := Siyahı yeni.
	öz sərhəd := Seyf token: 40.
}.

HTML-E-poçt olanda: ['qoş:'] et: { :fayl
	>> id := öz qoşmalar say.
	>> blob := fayl blob.
	öz qoşmalar sona-əlavə-et: (
		Lüğət yeni
			fayl: fayl yol,
			mime: ['image/'] + (Server mimetype: fayl yol),
			verilənlər: blob base64-kodla
	).
	blob azad-et. <- ['cid:attachment'] + id.
}.

HTML-E-poçt olanda: ['yarat'] et: {
	>> sətir-sonu := ['\r\n'].
	>> sətir-zənciri := [''].
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['From: '] + öz göndərən-adı + [' <'] + ( öz göndərən ) + ['>']) + sətir-sonu.
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['To: '] + ( öz alanlar birləşdir: [','] )) + sətir-sonu.
	öz cc say doğru: {
		sətir-zənciri sona-əlavə-et: (özü başlıq: ['Cc: '] + ( öz cc birləşdir: [','] )) + sətir-sonu.
	}.
	öz bcc say doğru: {
		sətir-zənciri sona-əlavə-et: (özü başlıq: ['Bcc: '] + ( öz bcc birləşdir: [','] )) + sətir-sonu.
	}.
	sətir-zənciri sona-əlavə-et: (özü başlıq: ['Subject: '] + öz mövzu) + sətir-sonu.
	sətir-zənciri sona-əlavə-et: ['MIME-Version: 1.0'] + sətir-sonu.
	sətir-zənciri sona-əlavə-et: ['Content-Type: multipart/related; boundary="'] + öz sərhəd + ['"; type=text/html'] + sətir-sonu.
	sətir-zənciri sona-əlavə-et: sətir-sonu.
	sətir-zənciri sona-əlavə-et: ['--'] + öz sərhəd + sətir-sonu.
	sətir-zənciri sona-əlavə-et: ['Content-Type: text/html; charset=UTF-8'] + sətir-sonu.
	sətir-zənciri sona-əlavə-et: ['Content-Transfer-Encoding: 7bit'] + sətir-sonu.
	sətir-zənciri sona-əlavə-et: sətir-sonu.
	sətir-zənciri sona-əlavə-et: öz gövdə.
	sətir-zənciri sona-əlavə-et: sətir-sonu.
	öz qoşmalar hər: { :id :məlumat
		>> blob := məlumat verilənlər.
		sətir-zənciri sona-əlavə-et: ['--'] + öz sərhəd + sətir-sonu.
		sətir-zənciri sona-əlavə-et: ['Content-Type: '] + məlumat mime + sətir-sonu.
		sətir-zənciri sona-əlavə-et: ['Content-Transfer-Encoding: base64'] + sətir-sonu.
		sətir-zənciri sona-əlavə-et: ['Content-ID: <attachment'] + id + ['>'] + sətir-sonu.
		sətir-zənciri sona-əlavə-et: ['Content-Disposition: inline; filename="'] + məlumat fayl + ['"'] + sətir-sonu.
		sətir-zənciri sona-əlavə-et: sətir-sonu.
		>> ən-çox := 76.
		>> mətn-uzunluğu := blob uzunluq.
		>> hissələr := (mətn-uzunluğu / ən-çox) yuxarı-yuvarlaqlaşdır.
		{ :i
			>> hissə := blob surət başlanğıc: i * ən-çox uzunluq: ən-çox.
			sətir-zənciri sona-əlavə-et: hissə + sətir-sonu.
		} * hissələr.
		sətir-zənciri sona-əlavə-et: sətir-sonu.
		sətir-zənciri sona-əlavə-et: sətir-sonu.
	}.
	sətir-zənciri sona-əlavə-et: ['--'] + öz sərhəd + ['--'] + sətir-sonu. <- sətir-zənciri.
}.
