>> Correo := Obxecto novo.

Correo en: ['inicializar'] facer: {
	propio destinatarios := Lista novo.
	propio cc := Lista novo.
	propio bcc := Lista novo.
	propio remitente := Nada.
	propio nome-remitente := Nada.
	propio asunto := Nada.
	propio corpo := Nada.
}.

Correo en: ['novo'] facer: { <- eu novo inicializar.
}.

Correo en: ['destinatario:'] facer: { :lista
	propio destinatarios := lista.
}.
 
Correo en: ['cc:'] facer: { :lista
	propio cc := lista.
}.

Correo en: ['bcc:'] facer: { :lista
	propio bcc := lista.
}.

Correo en: ['asunto:'] facer: { :asunto
	propio asunto := asunto.
}.

Correo en: ['remitente:nome:'] facer: { :remitente :nome
	propio remitente := remitente.
	propio nome-remitente := nome.
}.

Correo en: ['corpo:'] facer: { :corpo
	propio corpo := corpo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Correo en: ['cabeceira:'] facer: { :liña <- liña substituír: ['\r'] por: [''], substituír: ['\n'] por: [''].
}.

Correo en: ['enviar'] facer: {
	>> f := Ficheiro tempwrite: eu xerar.
	Programa sistema: ['sendmail -t < '] + f camiño, salto-de-liña.
}.

Correo en: ['xerar'] facer: {
	>> salto := ['\r\n'].
	>> cadea := [''].
	cadea engadir-ao-final: (eu cabeceira: ['From: '] + propio nome-remitente + [' <'] + ( propio remitente ) + ['>']) + salto.
	cadea engadir-ao-final: (eu cabeceira: ['To: '] + ( propio destinatarios unir: [','] )) + salto.
	propio cc contar certo: {
		cadea engadir-ao-final: (eu cabeceira: ['Cc: '] + ( propio cc unir: [','] )) + salto.
	}.
	propio bcc contar certo: {
		cadea engadir-ao-final: (eu cabeceira: ['Bcc: '] + ( propio bcc unir: [','] )) + salto.
	}.
	cadea engadir-ao-final: (eu cabeceira: ['Subject: '] + propio asunto) + salto.
	cadea engadir-ao-final: salto.
	cadea engadir-ao-final: propio corpo.
	cadea engadir-ao-final: salto. <- cadea.
}.

>> Correo-HTML := Correo novo.

Correo-HTML en: ['inicializar'] facer: {
	eu inicializar.
	propio anexos := Lista novo.
	propio fronteira := Caixa-forte token: 40.
}.

Correo-HTML en: ['anexar:'] facer: { :ficheiro
	>> id := propio anexos contar.
	>> blob := ficheiro blob.
	propio anexos engadir-ao-final: (
		Dicionario novo
			ficheiro: ficheiro camiño,
			mime: ['image/'] + (Server mimetype: ficheiro camiño),
			datos: blob base64-codificar
	).
	blob liberar. <- ['cid:attachment'] + id.
}.

Correo-HTML en: ['xerar'] facer: {
	>> salto := ['\r\n'].
	>> cadea := [''].
	cadea engadir-ao-final: (eu cabeceira: ['From: '] + propio nome-remitente + [' <'] + ( propio remitente ) + ['>']) + salto.
	cadea engadir-ao-final: (eu cabeceira: ['To: '] + ( propio destinatarios unir: [','] )) + salto.
	propio cc contar certo: {
		cadea engadir-ao-final: (eu cabeceira: ['Cc: '] + ( propio cc unir: [','] )) + salto.
	}.
	propio bcc contar certo: {
		cadea engadir-ao-final: (eu cabeceira: ['Bcc: '] + ( propio bcc unir: [','] )) + salto.
	}.
	cadea engadir-ao-final: (eu cabeceira: ['Subject: '] + propio asunto) + salto.
	cadea engadir-ao-final: ['MIME-Version: 1.0'] + salto.
	cadea engadir-ao-final: ['Content-Type: multipart/related; boundary="'] + propio fronteira + ['"; type=text/html'] + salto.
	cadea engadir-ao-final: salto.
	cadea engadir-ao-final: ['--'] + propio fronteira + salto.
	cadea engadir-ao-final: ['Content-Type: text/html; charset=UTF-8'] + salto.
	cadea engadir-ao-final: ['Content-Transfer-Encoding: 7bit'] + salto.
	cadea engadir-ao-final: salto.
	cadea engadir-ao-final: propio corpo.
	cadea engadir-ao-final: salto.
	propio anexos cada: { :id :info
		>> blob := info datos.
		cadea engadir-ao-final: ['--'] + propio fronteira + salto.
		cadea engadir-ao-final: ['Content-Type: '] + info mime + salto.
		cadea engadir-ao-final: ['Content-Transfer-Encoding: base64'] + salto.
		cadea engadir-ao-final: ['Content-ID: <attachment'] + id + ['>'] + salto.
		cadea engadir-ao-final: ['Content-Disposition: inline; filename="'] + info ficheiro + ['"'] + salto.
		cadea engadir-ao-final: salto.
		>> teito := 76.
		>> lonxitude-texto := blob lonxitude.
		>> anacos := (lonxitude-texto / teito) arredondar-arriba.
		{ :i
			>> anaco := blob copiar de: i * teito lonxitude: teito.
			cadea engadir-ao-final: anaco + salto.
		} * anacos.
		cadea engadir-ao-final: salto.
		cadea engadir-ao-final: salto.
	}.
	cadea engadir-ao-final: ['--'] + propio fronteira + ['--'] + salto. <- cadea.
}.
