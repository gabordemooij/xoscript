
# ~ Simple template engine ~

>> Modelo := Obxecto novo.

Modelo en: ['novo'] facer: { <- eu novo contido: [''].
}.

Modelo en: ['contido:'] facer: { :contido
	propio contido := contido. 
}.

Modelo en: ['novo:'] facer: { :contido <- eu novo contido: contido.
}.

Modelo en: ['cortar:'] facer: { :marcador
	>> marcador-inicio := (['<!-- cut:%id% -->'] %id%: marcador).
	>> marcador-fin := (['<!-- /cut:%id% -->'] %id%: marcador).
	>> partes := propio contido partir: marcador-inicio.
	>> prefixo := partes primeiro.
	>> partes2 := partes último partir: marcador-fin.
	>> sufixo := partes2 último.
	>> parte := partes2 primeiro.
	>> resto := prefixo + sufixo.
	propio contido := resto. <- Modelo novo: parte.
	
}.

Modelo en: ['copiar'] facer: { <- eu novo: eu texto copiar.
}.
	
Modelo en: ['pegar:en:'] facer: { :retallo :id
	>> marcador-pegar := (['<!-- paste:%id% -->'] %id%: id).
	propio contido substituír: marcador-pegar por: ( retallo texto + marcador-pegar ).
}.

Modelo en: ['establecer:valor:'] facer: { :oco :valor
	propio contido substituír: ['<!-- slot:'] + oco + [' -->'] por: ( Server html-codificar: valor ).
}.

Modelo en: ['establecer:html:'] facer: { :oco :html
	propio contido substituír: ['<!-- slot:'] + oco + [' -->'] por: html.
}.

Modelo en: ['responder:e:'] facer: { :oco :valor
	eu establecer: (oco de: 0 lonxitude: (oco lonxitude - 1)) valor: valor.
}.

Modelo en: ['nl2br'] facer: {
	propio contido substituír: ['\n'] por: ['<br>'].
}.

Modelo en: ['depurar'] facer: {
	propio contido :=
		Patrón
		novo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		coincidencia: propio contido
		facer: { <- ['']. }.
}.

Modelo en: ['depurar-cortes'] facer: {
	>> elementos := Lista novo.
	Patrón
	novo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	coincidencia: propio contido
	facer: { :_ :parte
		elementos engadir-ao-final: parte ? 1.
	}.
	elementos cada: { :_ :id
		propio contido :=
			Patrón novo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			coincidencia: propio contido
			facer: { <- ['']. }.
	 }.
}.

Modelo en: ['depurar-espazos'] facer: {
	propio contido :=
		Patrón
		novo: ['\\s*\\n'],
		coincidencia: propio contido
		facer: { <- ['\n']. }.
	propio contido :=
		Patrón
		novo: ['\\n[\\s\\t]+'],
		coincidencia: propio contido
		facer: { <- ['\n']. }.
}.

Modelo en: ['depurar-todo'] facer: {
	eu depurar.
	eu depurar-cortes.
	eu depurar-espazos.
}.

Modelo en: ['texto'] facer: { <- propio contido.
}.
