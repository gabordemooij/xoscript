Petición-HTTP en: ['HTTP-cabeceira:'] facer: { :chave <- Programa configuración: chave.
}.

>> Cabeceira-HTTP := Obxecto novo.

Cabeceira-HTTP en: ['novo'] facer: { <- eu novo inicializar.
}.

Cabeceira-HTTP en: ['inicializar'] facer: {
	propio chave := Nada.
	propio valor := Nada.
}.

Cabeceira-HTTP en: ['chave:valor:'] facer: { :chave :valor
	propio chave := chave.
	propio valor := valor.
}.

Cabeceira-HTTP en: ['chave'] facer: { <- propio chave.
}.

Cabeceira-HTTP en: ['valor'] facer: { <- propio valor.
}.


Cabeceira-HTTP en: ['texto'] facer: {
	>> liña := propio chave + [': '] + propio valor.
	liña substituír: ['\r'] por: [''], substituír: ['\n'] por: ['']. <- liña + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Documento-Web := Obxecto novo.

Documento-Web en: ['novo'] facer: { <- eu novo inicializar.
}.

Documento-Web en: ['inicializar'] facer: {
	propio cabeceiras := Lista novo.
	propio id-sesión := Nada.
	propio xestor-sesión := Sesión-ficheiro-temporal novo.
	propio datos-sesión := Nada.
	propio seguro := Certo.
	propio mesmo-sitio := ['Strict'].
	propio cabeceiras-enviadas := Falso.
	propio petición := Petición-HTTP novo.
}.

Documento-Web en: ['petición:'] facer: { :petición
	propio petición := petición.
}. 

Documento-Web en: ['cookie-sesión-segura:'] facer: { :seguro
	eu comprobar-cabeceiras.
	propio seguro := seguro.
}.

Documento-Web en: ['cookie-sesión-mesmo-sitio:'] facer: { :valor
	eu comprobar-cabeceiras.
	>> opcións := Lista novo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcións ten: valor, falso: {
		esta-tarefa erro: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propio mesmo-sitio := valor.
}.

Documento-Web en: ['cabeceira:'] facer: { :cabeceira
	eu comprobar-cabeceiras.
	propio cabeceiras engadir-ao-final: cabeceira.
}.

Documento-Web en: ['baleirar-cabeceiras'] facer: {
	eu comprobar-cabeceiras.
	propio cabeceiras := Lista novo.
}.

Documento-Web en: ['xestor-sesión:'] facer: { :xestor
	eu comprobar-cabeceiras.
	propio xestor-sesión := xestor.
}.

Documento-Web en: ['xestor-sesión'] facer: { <- propio xestor-sesión.
}.

Documento-Web en: ['comprobar-cabeceiras'] facer: {
	propio cabeceiras-enviadas certo: {
		esta-tarefa erro: ['Headers already sent to client.'].
	}.
}.

Documento-Web en: ['iniciar-sesión'] facer: {
	eu comprobar-cabeceiras.
	>> petición := propio petición.
	>> id-sesión := petición cookie: ['xsid'].
	id-sesión Nada? falso: {
		(( Patrón novo: ['^[A-Za-z0-9]+\\z'], coincidencia: id-sesión ) = 0) certo: {
			id-sesión := Nada.
		}.
	}.
	id-sesión Nada? certo: {
		id-sesión := Caixa-forte token: 30.
		>> cabeceira-sesión := Cabeceira-HTTP novo
		chave: ['Set-Cookie'] valor: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propio seguro ou: ['Secure'] ou: ['']),
		SSITE: (propio mesmo-sitio),
		XSID: id-sesión
		).
		propio cabeceiras engadir-ao-final: cabeceira-sesión.
	}.
	propio datos-sesión := propio xestor-sesión para: id-sesión, cargar. <- propio datos-sesión. # reference
}.

Documento-Web en: ['ir-a:'] facer: { :enderezo
	eu comprobar-cabeceiras.
	eu baleirar-cabeceiras.
	propio cabeceiras
	engadir-ao-final: (
		Cabeceira-HTTP novo
		chave: ['Status'] valor: ['303 See Other']
	),
	engadir-ao-final: (
		Cabeceira-HTTP novo
		chave: ['Location'] valor: enderezo
	).
	eu emitir: ['Redirect'].
}.

Documento-Web en: ['destruír-sesión'] facer: {
	eu comprobar-cabeceiras.
	>> petición := propio petición.
	>> id-sesión := petición cookie: ['xsid'].
	id-sesión Nada? falso: {
		>> cabeceira-sesión := Cabeceira-HTTP novo.
		>> momento := Momento novo ano: 1970, formato: ['%a, %d %b %Y %H:%M:%S GMT'].
		cabeceira-sesión chave: ['Set-Cookie'] valor: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: momento,
			SEC: (propio seguro ou: ['Secure'] ou: ['']),
			SSITE: (propio mesmo-sitio),
			XSID: id-sesión
		).
		propio xestor-sesión destruír.
		propio cabeceiras engadir-ao-final: cabeceira-sesión.
	}.
}.


Documento-Web en: ['modelo:'] facer: { :camiño <- Modelo novo: (Ficheiro novo: camiño, ler).
}.

Documento-Web en: ['emitir:tipo:'] facer: { :saída :tipo
	propio cabeceiras-enviadas falso: {
		propio datos-sesión Nada? falso: {
			propio xestor-sesión gardar: propio datos-sesión.
		}.
		propio cabeceiras engadir-ao-final: (
			Cabeceira-HTTP novo
			chave: ['Content-type'] valor: tipo
		).
		propio cabeceiras cada: { :_ :cabeceira
			Saída escribir: cabeceira.
		}.
		propio cabeceiras-enviadas := Certo.
		Saída escribir: ['\r\n'].
	}.
	Saída escribir: saída.
}.

Documento-Web en: ['rematar:tipo:'] facer: { :saída :tipo
	propio cabeceiras-enviadas falso: {
		propio datos-sesión Nada? falso: {
			propio xestor-sesión gardar: propio datos-sesión.
		}.
		propio cabeceiras engadir-ao-final: (
			Cabeceira-HTTP novo
			chave: ['Content-type'] valor: tipo
		).
		propio cabeceiras engadir-ao-final: (
			Cabeceira-HTTP novo
			chave: ['Content-Length'] valor: saída texto bytes
		).
		propio cabeceiras cada: { :_ :cabeceira
			Saída escribir: cabeceira.
		}.
		propio cabeceiras-enviadas := Certo.
		Saída escribir: ['\r\n'].
	}.
	Saída escribir: saída.
}.

Documento-Web en: ['emitir:'] facer: { :saída
	eu emitir: saída tipo: ['text/html; charset=utf-8'].
}.

Documento-Web en: ['rematar:'] facer: { :saída
	eu rematar: saída tipo: ['text/html; charset=utf-8'].
}.

Documento-Web en: ['json:'] facer: { :saída
	eu emitir: ( JSON jsonify: saída ) tipo: ['application/json'].
}.

Documento-Web en: ['non-atopado:'] facer: { :saída
	eu baleirar-cabeceiras cabeceira: (
		Cabeceira-HTTP novo chave: ['Status'] valor: ['404 Not Found']
	).
	eu emitir: saída.
}.


# Interface

>> Sesión := Obxecto novo.

Sesión en: ['novo'] facer: { <- eu novo inicializar para: Nada.
}.

Sesión en: ['para:'] facer: { :id
	propio id := id.
}.

Sesión en: ['cargar'] facer: {
	esta-tarefa erro: ['Not implemented.'].
}.

Sesión en: ['gardar:'] facer: {
	esta-tarefa erro: ['Not implemented.'].
}.

Sesión en: ['destruír'] facer: {
	esta-tarefa erro: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesión-ficheiro-temporal := Sesión novo.

Sesión-ficheiro-temporal en: ['inicializar'] facer: {
	propio prefixoruta := ['/tmp/sess-'].
}.

Sesión-ficheiro-temporal en: ['prefixo-ruta:'] facer: { :cadea
	propio prefixoruta := cadea.
}.

Sesión-ficheiro-temporal en: ['ficheiro'] facer: { <- ( Ficheiro novo: ( propio prefixoruta + propio id + ['.txt'] ) ).
}.

Sesión-ficheiro-temporal en: ['cargar'] facer: {
	>> ficheiro := eu ficheiro.
	ficheiro existe falso: {
		ficheiro escribir: (Dicionario novo código).
	}. <- ficheiro ler obxecto.
}.

Sesión-ficheiro-temporal en: ['gardar:'] facer: { :datos
	>> ficheiro := eu ficheiro.
	ficheiro existe certo: {
		ficheiro escribir: datos código.
	}.
}.

Sesión-ficheiro-temporal en: ['destruír'] facer: {
	>> ficheiro := eu ficheiro.
	ficheiro existe certo: {
		ficheiro eliminar.
	}.
}.


>> URL := Obxecto novo.

URL en: ['inicializar'] facer: {
	propio protocolo := ['https://'].
	propio anfitrión := ['localhost'].
	propio camiño := [''].
	propio parámetros-url := [''].
	propio hash := [''].
}.

URL en: ['novo'] facer: { <- eu novo inicializar.
}.

URL en: ['texto'] facer: { <- (
	propio protocolo +
	propio anfitrión +
	propio camiño +
	propio parámetros-url +
	propio hash ).
}.

URL en: ['protocolo:'] facer: { :protocolo
	((Lista novo ; ['http'] ; ['https']) ten: protocolo) certo: {
		propio protocolo := protocolo + ['://'].
	}, falso: {
		esta-tarefa erro: ['Invalid protocol'].
	}.
}.

URL en: ['anfitrión:'] facer: { :anfitrión
	#todo validate according to rfc
	propio anfitrión := anfitrión.
}.

URL en: ['camiño:'] facer: { :camiño
	propio camiño := ['/'] + camiño url-codificar.
}.

URL en: ['parámetros-url:'] facer: { :mapa
	>> parámetros-url := Lista novo.
	mapa cada: { :chave :valor
		parámetros-url engadir-ao-final: chave texto url-codificar + ['='] + valor texto url-codificar.
	}.
	propio parámetros-url := ['?'] + ( parámetros-url unir: ['&'] ).
}.

URL en: ['resumo:'] facer: { :hash
	propio hash := ['#'] + hash url-codificar.
}.

