>> Email := Objekat novi.

Email na: ['inicijaliziraj'] uradi: {
	svoj primaoci := Lista novi.
	svoj cc := Lista novi.
	svoj bcc := Lista novi.
	svoj pošiljalac := Ništa.
	svoj ime-pošiljaoca := Ništa.
	svoj predmet := Ništa.
	svoj tijelo := Ništa.
}.

Email na: ['novi'] uradi: { <- sebe novi inicijaliziraj.
}.

Email na: ['prima:'] uradi: { :nabrajanje
	svoj primaoci := nabrajanje.
}.
 
Email na: ['cc:'] uradi: { :nabrajanje
	svoj cc := nabrajanje.
}.

Email na: ['bcc:'] uradi: { :nabrajanje
	svoj bcc := nabrajanje.
}.

Email na: ['predmet:'] uradi: { :predmet
	svoj predmet := predmet.
}.

Email na: ['pošiljalac:naziv:'] uradi: { :pošiljalac :naziv
	svoj pošiljalac := pošiljalac.
	svoj ime-pošiljaoca := naziv.
}.

Email na: ['tijelo:'] uradi: { :tijelo
	svoj tijelo := tijelo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email na: ['zaglavlje:'] uradi: { :red <- red zamijeni: ['\r'] sa: [''], zamijeni: ['\n'] sa: [''].
}.

Email na: ['pošalji'] uradi: {
	>> f := Datoteka tempwrite: sebe generiši.
	Program sistem: ['sendmail -t < '] + f putanja, novi-red.
}.

Email na: ['generiši'] uradi: {
	>> prelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-kraj: (sebe zaglavlje: ['From: '] + svoj ime-pošiljaoca + [' <'] + ( svoj pošiljalac ) + ['>']) + prelom.
	niz dodaj-na-kraj: (sebe zaglavlje: ['To: '] + ( svoj primaoci spoji: [','] )) + prelom.
	svoj cc broj-elemenata tačno: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Cc: '] + ( svoj cc spoji: [','] )) + prelom.
	}.
	svoj bcc broj-elemenata tačno: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Bcc: '] + ( svoj bcc spoji: [','] )) + prelom.
	}.
	niz dodaj-na-kraj: (sebe zaglavlje: ['Subject: '] + svoj predmet) + prelom.
	niz dodaj-na-kraj: prelom.
	niz dodaj-na-kraj: svoj tijelo.
	niz dodaj-na-kraj: prelom. <- niz.
}.

>> HTML-Email := Email novi.

HTML-Email na: ['inicijaliziraj'] uradi: {
	sebe inicijaliziraj.
	svoj prilozi := Lista novi.
	svoj granica := Sef token: 40.
}.

HTML-Email na: ['priloži:'] uradi: { :datoteka
	>> id := svoj prilozi broj-elemenata.
	>> blob := datoteka blob.
	svoj prilozi dodaj-na-kraj: (
		Rječnik novi
			datoteka: datoteka putanja,
			mime: ['image/'] + (Server mimetype: datoteka putanja),
			podaci: blob base64-kodiraj
	).
	blob oslobodi. <- ['cid:attachment'] + id.
}.

HTML-Email na: ['generiši'] uradi: {
	>> prelom := ['\r\n'].
	>> niz := [''].
	niz dodaj-na-kraj: (sebe zaglavlje: ['From: '] + svoj ime-pošiljaoca + [' <'] + ( svoj pošiljalac ) + ['>']) + prelom.
	niz dodaj-na-kraj: (sebe zaglavlje: ['To: '] + ( svoj primaoci spoji: [','] )) + prelom.
	svoj cc broj-elemenata tačno: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Cc: '] + ( svoj cc spoji: [','] )) + prelom.
	}.
	svoj bcc broj-elemenata tačno: {
		niz dodaj-na-kraj: (sebe zaglavlje: ['Bcc: '] + ( svoj bcc spoji: [','] )) + prelom.
	}.
	niz dodaj-na-kraj: (sebe zaglavlje: ['Subject: '] + svoj predmet) + prelom.
	niz dodaj-na-kraj: ['MIME-Version: 1.0'] + prelom.
	niz dodaj-na-kraj: ['Content-Type: multipart/related; boundary="'] + svoj granica + ['"; type=text/html'] + prelom.
	niz dodaj-na-kraj: prelom.
	niz dodaj-na-kraj: ['--'] + svoj granica + prelom.
	niz dodaj-na-kraj: ['Content-Type: text/html; charset=UTF-8'] + prelom.
	niz dodaj-na-kraj: ['Content-Transfer-Encoding: 7bit'] + prelom.
	niz dodaj-na-kraj: prelom.
	niz dodaj-na-kraj: svoj tijelo.
	niz dodaj-na-kraj: prelom.
	svoj prilozi svaki: { :id :info
		>> blob := info podaci.
		niz dodaj-na-kraj: ['--'] + svoj granica + prelom.
		niz dodaj-na-kraj: ['Content-Type: '] + info mime + prelom.
		niz dodaj-na-kraj: ['Content-Transfer-Encoding: base64'] + prelom.
		niz dodaj-na-kraj: ['Content-ID: <attachment'] + id + ['>'] + prelom.
		niz dodaj-na-kraj: ['Content-Disposition: inline; filename="'] + info datoteka + ['"'] + prelom.
		niz dodaj-na-kraj: prelom.
		>> najviše := 76.
		>> dužina-teksta := blob dužina.
		>> komadi := (dužina-teksta / najviše) zaokruži-gore.
		{ :i
			>> komad := blob kopiraj od: i * najviše dužina: najviše.
			niz dodaj-na-kraj: komad + prelom.
		} * komadi.
		niz dodaj-na-kraj: prelom.
		niz dodaj-na-kraj: prelom.
	}.
	niz dodaj-na-kraj: ['--'] + svoj granica + ['--'] + prelom. <- niz.
}.
