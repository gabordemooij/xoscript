HTTP-Zahtjev na: ['HTTP-zaglavlje:'] uradi: { :ključ <- Program postavka: ključ.
}.

>> HTTP-Zaglavlje := Objekat novi.

HTTP-Zaglavlje na: ['novi'] uradi: { <- sebe novi inicijaliziraj.
}.

HTTP-Zaglavlje na: ['inicijaliziraj'] uradi: {
	svoj ključ := Ništa.
	svoj vrijednost := Ništa.
}.

HTTP-Zaglavlje na: ['ključ:vrijednost:'] uradi: { :ključ :vrijednost
	svoj ključ := ključ.
	svoj vrijednost := vrijednost.
}.

HTTP-Zaglavlje na: ['ključ'] uradi: { <- svoj ključ.
}.

HTTP-Zaglavlje na: ['vrijednost'] uradi: { <- svoj vrijednost.
}.


HTTP-Zaglavlje na: ['tekst'] uradi: {
	>> red := svoj ključ + [': '] + svoj vrijednost.
	red zamijeni: ['\r'] sa: [''], zamijeni: ['\n'] sa: ['']. <- red + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-dokument := Objekat novi.

Web-dokument na: ['novi'] uradi: { <- sebe novi inicijaliziraj.
}.

Web-dokument na: ['inicijaliziraj'] uradi: {
	svoj zaglavlja := Lista novi.
	svoj id-sesije := Ništa.
	svoj upravitelj-sesija := Sesija-privremena-datoteka novi.
	svoj podaci-sesije := Ništa.
	svoj sigurno := Tačno.
	svoj ista-stranica := ['Strict'].
	svoj zaglavlja-poslana := Netačno.
	svoj zahtjev := HTTP-Zahtjev novi.
}.

Web-dokument na: ['zahtjev:'] uradi: { :zahtjev
	svoj zahtjev := zahtjev.
}. 

Web-dokument na: ['sigurni-kolačić-sesije:'] uradi: { :sigurno
	sebe provjeri-zaglavlja.
	svoj sigurno := sigurno.
}.

Web-dokument na: ['kolačić-sesije-ista-stranica:'] uradi: { :vrijednost
	sebe provjeri-zaglavlja.
	>> opcije := Lista novi 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opcije ima: vrijednost, netačno: {
		ovaj-zadatak greška: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	svoj ista-stranica := vrijednost.
}.

Web-dokument na: ['zaglavlje:'] uradi: { :zaglavlje
	sebe provjeri-zaglavlja.
	svoj zaglavlja dodaj-na-kraj: zaglavlje.
}.

Web-dokument na: ['isprazni-zaglavlja'] uradi: {
	sebe provjeri-zaglavlja.
	svoj zaglavlja := Lista novi.
}.

Web-dokument na: ['upravitelj-sesija:'] uradi: { :upravitelj
	sebe provjeri-zaglavlja.
	svoj upravitelj-sesija := upravitelj.
}.

Web-dokument na: ['upravitelj-sesija'] uradi: { <- svoj upravitelj-sesija.
}.

Web-dokument na: ['provjeri-zaglavlja'] uradi: {
	svoj zaglavlja-poslana tačno: {
		ovaj-zadatak greška: ['Headers already sent to client.'].
	}.
}.

Web-dokument na: ['pokreni-sesiju'] uradi: {
	sebe provjeri-zaglavlja.
	>> zahtjev := svoj zahtjev.
	>> id-sesije := zahtjev cookie: ['xsid'].
	id-sesije Ništa? netačno: {
		(( Uzorak novi: ['^[A-Za-z0-9]+\\z'], podudaranje: id-sesije ) = 0) tačno: {
			id-sesije := Ništa.
		}.
	}.
	id-sesije Ništa? tačno: {
		id-sesije := Sef token: 30.
		>> zaglavlje-sesije := HTTP-Zaglavlje novi
		ključ: ['Set-Cookie'] vrijednost: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (svoj sigurno ili: ['Secure'] ili: ['']),
		SSITE: (svoj ista-stranica),
		XSID: id-sesije
		).
		svoj zaglavlja dodaj-na-kraj: zaglavlje-sesije.
	}.
	svoj podaci-sesije := svoj upravitelj-sesija za: id-sesije, učitaj. <- svoj podaci-sesije. # reference
}.

Web-dokument na: ['idi-na:'] uradi: { :adresa
	sebe provjeri-zaglavlja.
	sebe isprazni-zaglavlja.
	svoj zaglavlja
	dodaj-na-kraj: (
		HTTP-Zaglavlje novi
		ključ: ['Status'] vrijednost: ['303 See Other']
	),
	dodaj-na-kraj: (
		HTTP-Zaglavlje novi
		ključ: ['Location'] vrijednost: adresa
	).
	sebe ispiši: ['Redirect'].
}.

Web-dokument na: ['uništi-sesiju'] uradi: {
	sebe provjeri-zaglavlja.
	>> zahtjev := svoj zahtjev.
	>> id-sesije := zahtjev cookie: ['xsid'].
	id-sesije Ništa? netačno: {
		>> zaglavlje-sesije := HTTP-Zaglavlje novi.
		>> trenutak := Trenutak novi godina: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		zaglavlje-sesije ključ: ['Set-Cookie'] vrijednost: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: trenutak,
			SEC: (svoj sigurno ili: ['Secure'] ili: ['']),
			SSITE: (svoj ista-stranica),
			XSID: id-sesije
		).
		svoj upravitelj-sesija uništi.
		svoj zaglavlja dodaj-na-kraj: zaglavlje-sesije.
	}.
}.


Web-dokument na: ['šablon:'] uradi: { :putanja <- Šablon novi: (Datoteka novi: putanja, čitaj).
}.

Web-dokument na: ['ispiši:tip:'] uradi: { :izlaz :tip
	svoj zaglavlja-poslana netačno: {
		svoj podaci-sesije Ništa? netačno: {
			svoj upravitelj-sesija sačuvaj: svoj podaci-sesije.
		}.
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-type'] vrijednost: tip
		).
		svoj zaglavlja svaki: { :_ :zaglavlje
			Izlaz piši: zaglavlje.
		}.
		svoj zaglavlja-poslana := Tačno.
		Izlaz piši: ['\r\n'].
	}.
	Izlaz piši: izlaz.
}.

Web-dokument na: ['završi:tip:'] uradi: { :izlaz :tip
	svoj zaglavlja-poslana netačno: {
		svoj podaci-sesije Ništa? netačno: {
			svoj upravitelj-sesija sačuvaj: svoj podaci-sesije.
		}.
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-type'] vrijednost: tip
		).
		svoj zaglavlja dodaj-na-kraj: (
			HTTP-Zaglavlje novi
			ključ: ['Content-Length'] vrijednost: izlaz tekst bytes
		).
		svoj zaglavlja svaki: { :_ :zaglavlje
			Izlaz piši: zaglavlje.
		}.
		svoj zaglavlja-poslana := Tačno.
		Izlaz piši: ['\r\n'].
	}.
	Izlaz piši: izlaz.
}.

Web-dokument na: ['ispiši:'] uradi: { :izlaz
	sebe ispiši: izlaz tip: ['text/html; charset=utf-8'].
}.

Web-dokument na: ['završi:'] uradi: { :izlaz
	sebe završi: izlaz tip: ['text/html; charset=utf-8'].
}.

Web-dokument na: ['json:'] uradi: { :izlaz
	sebe ispiši: ( JSON jsonify: izlaz ) tip: ['application/json'].
}.

Web-dokument na: ['nije-pronađeno:'] uradi: { :izlaz
	sebe isprazni-zaglavlja zaglavlje: (
		HTTP-Zaglavlje novi ključ: ['Status'] vrijednost: ['404 Not Found']
	).
	sebe ispiši: izlaz.
}.


# Interface

>> Sesija := Objekat novi.

Sesija na: ['novi'] uradi: { <- sebe novi inicijaliziraj za: Ništa.
}.

Sesija na: ['za:'] uradi: { :id
	svoj id := id.
}.

Sesija na: ['učitaj'] uradi: {
	ovaj-zadatak greška: ['Not implemented.'].
}.

Sesija na: ['sačuvaj:'] uradi: {
	ovaj-zadatak greška: ['Not implemented.'].
}.

Sesija na: ['uništi'] uradi: {
	ovaj-zadatak greška: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesija-privremena-datoteka := Sesija novi.

Sesija-privremena-datoteka na: ['inicijaliziraj'] uradi: {
	svoj početak-putanje := ['/tmp/sess-'].
}.

Sesija-privremena-datoteka na: ['prefiks-putanje:'] uradi: { :niz
	svoj početak-putanje := niz.
}.

Sesija-privremena-datoteka na: ['datoteka'] uradi: { <- ( Datoteka novi: ( svoj početak-putanje + svoj id + ['.txt'] ) ).
}.

Sesija-privremena-datoteka na: ['učitaj'] uradi: {
	>> datoteka := sebe datoteka.
	datoteka postoji netačno: {
		datoteka piši: (Rječnik novi kod).
	}. <- datoteka čitaj objekat.
}.

Sesija-privremena-datoteka na: ['sačuvaj:'] uradi: { :podaci
	>> datoteka := sebe datoteka.
	datoteka postoji tačno: {
		datoteka piši: podaci kod.
	}.
}.

Sesija-privremena-datoteka na: ['uništi'] uradi: {
	>> datoteka := sebe datoteka.
	datoteka postoji tačno: {
		datoteka izbriši.
	}.
}.


>> URL := Objekat novi.

URL na: ['inicijaliziraj'] uradi: {
	svoj protokol := ['https://'].
	svoj domaćin := ['localhost'].
	svoj putanja := [''].
	svoj parametri-url := [''].
	svoj hash := [''].
}.

URL na: ['novi'] uradi: { <- sebe novi inicijaliziraj.
}.

URL na: ['tekst'] uradi: { <- (
	svoj protokol +
	svoj domaćin +
	svoj putanja +
	svoj parametri-url +
	svoj hash ).
}.

URL na: ['protokol:'] uradi: { :protokol
	((Lista novi ; ['http'] ; ['https']) ima: protokol) tačno: {
		svoj protokol := protokol + ['://'].
	}, netačno: {
		ovaj-zadatak greška: ['Invalid protocol'].
	}.
}.

URL na: ['domaćin:'] uradi: { :domaćin
	#todo validate according to rfc
	svoj domaćin := domaćin.
}.

URL na: ['putanja:'] uradi: { :putanja
	svoj putanja := ['/'] + putanja url-kodiraj.
}.

URL na: ['parametri-url:'] uradi: { :mapiranje
	>> parametri-url := Lista novi.
	mapiranje svaki: { :ključ :vrijednost
		parametri-url dodaj-na-kraj: ključ tekst url-kodiraj + ['='] + vrijednost tekst url-kodiraj.
	}.
	svoj parametri-url := ['?'] + ( parametri-url spoji: ['&'] ).
}.

URL na: ['heš:'] uradi: { :hash
	svoj hash := ['#'] + hash url-kodiraj.
}.

