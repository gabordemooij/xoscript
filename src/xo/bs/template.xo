
# ~ Simple template engine ~

>> Šablon := Objekat novi.

Šablon na: ['novi'] uradi: { <- sebe novi sadržaj: [''].
}.

Šablon na: ['sadržaj:'] uradi: { :sadržaj
	svoj sadržaj := sadržaj. 
}.

Šablon na: ['novi:'] uradi: { :sadržaj <- sebe novi sadržaj: sadržaj.
}.

Šablon na: ['izreži:'] uradi: { :oznaka
	>> početna-oznaka := (['<!-- cut:%id% -->'] %id%: oznaka).
	>> završna-oznaka := (['<!-- /cut:%id% -->'] %id%: oznaka).
	>> dijelovi := svoj sadržaj podijeli: početna-oznaka.
	>> prefiks := dijelovi prvi.
	>> dijelovi2 := dijelovi zadnji podijeli: završna-oznaka.
	>> sufiks := dijelovi2 zadnji.
	>> dio := dijelovi2 prvi.
	>> ostatak := prefiks + sufiks.
	svoj sadržaj := ostatak. <- Šablon novi: dio.
	
}.

Šablon na: ['kopiraj'] uradi: { <- sebe novi: sebe tekst kopiraj.
}.
	
Šablon na: ['zalijepi:na:'] uradi: { :isječak :id
	>> oznaka-lijepljenja := (['<!-- paste:%id% -->'] %id%: id).
	svoj sadržaj zamijeni: oznaka-lijepljenja sa: ( isječak tekst + oznaka-lijepljenja ).
}.

Šablon na: ['postavi:vrijednost:'] uradi: { :utor :vrijednost
	svoj sadržaj zamijeni: ['<!-- slot:'] + utor + [' -->'] sa: ( Server html-kodiraj: vrijednost ).
}.

Šablon na: ['postavi:html:'] uradi: { :utor :html
	svoj sadržaj zamijeni: ['<!-- slot:'] + utor + [' -->'] sa: html.
}.

Šablon na: ['odgovori:i:'] uradi: { :utor :vrijednost
	sebe postavi: (utor od: 0 dužina: (utor dužina - 1)) vrijednost: vrijednost.
}.

Šablon na: ['nl2br'] uradi: {
	svoj sadržaj zamijeni: ['\n'] sa: ['<br>'].
}.

Šablon na: ['očisti'] uradi: {
	svoj sadržaj :=
		Uzorak
		novi: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		podudaranje: svoj sadržaj
		uradi: { <- ['']. }.
}.

Šablon na: ['očisti-izreze'] uradi: {
	>> stavke := Lista novi.
	Uzorak
	novi: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	podudaranje: svoj sadržaj
	uradi: { :_ :dio
		stavke dodaj-na-kraj: dio ? 1.
	}.
	stavke svaki: { :_ :id
		svoj sadržaj :=
			Uzorak novi: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			podudaranje: svoj sadržaj
			uradi: { <- ['']. }.
	 }.
}.

Šablon na: ['očisti-razmake'] uradi: {
	svoj sadržaj :=
		Uzorak
		novi: ['\\s*\\n'],
		podudaranje: svoj sadržaj
		uradi: { <- ['\n']. }.
	svoj sadržaj :=
		Uzorak
		novi: ['\\n[\\s\\t]+'],
		podudaranje: svoj sadržaj
		uradi: { <- ['\n']. }.
}.

Šablon na: ['očisti-sve'] uradi: {
	sebe očisti.
	sebe očisti-izreze.
	sebe očisti-razmake.
}.

Šablon na: ['tekst'] uradi: { <- svoj sadržaj.
}.
