>> Email := Obiect nou.

Email la: ['inițializează'] execută: {
	propriu destinatari := Listă nou.
	propriu cc := Listă nou.
	propriu bcc := Listă nou.
	propriu expeditor := Nimic.
	propriu nume-expeditor := Nimic.
	propriu subiect := Nimic.
	propriu corp := Nimic.
}.

Email la: ['nou'] execută: { <- sine nou inițializează.
}.

Email la: ['către:'] execută: { :enumerare
	propriu destinatari := enumerare.
}.
 
Email la: ['cc:'] execută: { :enumerare
	propriu cc := enumerare.
}.

Email la: ['bcc:'] execută: { :enumerare
	propriu bcc := enumerare.
}.

Email la: ['subiect:'] execută: { :subiect
	propriu subiect := subiect.
}.

Email la: ['expeditor:nume:'] execută: { :expeditor :nume
	propriu expeditor := expeditor.
	propriu nume-expeditor := nume.
}.

Email la: ['corp:'] execută: { :corp
	propriu corp := corp.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email la: ['antet:'] execută: { :linie <- linie înlocuiește: ['\r'] cu: [''], înlocuiește: ['\n'] cu: [''].
}.

Email la: ['trimite'] execută: {
	>> f := Fișier tempwrite: sine generează.
	Program sistem: ['sendmail -t < '] + f cale, rând-nou.
}.

Email la: ['generează'] execută: {
	>> salt := ['\r\n'].
	>> șir := [''].
	șir adaugă-la-sfârșit: (sine antet: ['From: '] + propriu nume-expeditor + [' <'] + ( propriu expeditor ) + ['>']) + salt.
	șir adaugă-la-sfârșit: (sine antet: ['To: '] + ( propriu destinatari unește: [','] )) + salt.
	propriu cc numără adevărat: {
		șir adaugă-la-sfârșit: (sine antet: ['Cc: '] + ( propriu cc unește: [','] )) + salt.
	}.
	propriu bcc numără adevărat: {
		șir adaugă-la-sfârșit: (sine antet: ['Bcc: '] + ( propriu bcc unește: [','] )) + salt.
	}.
	șir adaugă-la-sfârșit: (sine antet: ['Subject: '] + propriu subiect) + salt.
	șir adaugă-la-sfârșit: salt.
	șir adaugă-la-sfârșit: propriu corp.
	șir adaugă-la-sfârșit: salt. <- șir.
}.

>> Email-HTML := Email nou.

Email-HTML la: ['inițializează'] execută: {
	sine inițializează.
	propriu atașamente := Listă nou.
	propriu delimitator := Seif jeton: 40.
}.

Email-HTML la: ['atașează:'] execută: { :fișier
	>> id := propriu atașamente numără.
	>> blob := fișier blob.
	propriu atașamente adaugă-la-sfârșit: (
		Dicționar nou
			fișier: fișier cale,
			mime: ['image/'] + (Server mimetype: fișier cale),
			date: blob base64-codifică
	).
	blob eliberează. <- ['cid:attachment'] + id.
}.

Email-HTML la: ['generează'] execută: {
	>> salt := ['\r\n'].
	>> șir := [''].
	șir adaugă-la-sfârșit: (sine antet: ['From: '] + propriu nume-expeditor + [' <'] + ( propriu expeditor ) + ['>']) + salt.
	șir adaugă-la-sfârșit: (sine antet: ['To: '] + ( propriu destinatari unește: [','] )) + salt.
	propriu cc numără adevărat: {
		șir adaugă-la-sfârșit: (sine antet: ['Cc: '] + ( propriu cc unește: [','] )) + salt.
	}.
	propriu bcc numără adevărat: {
		șir adaugă-la-sfârșit: (sine antet: ['Bcc: '] + ( propriu bcc unește: [','] )) + salt.
	}.
	șir adaugă-la-sfârșit: (sine antet: ['Subject: '] + propriu subiect) + salt.
	șir adaugă-la-sfârșit: ['MIME-Version: 1.0'] + salt.
	șir adaugă-la-sfârșit: ['Content-Type: multipart/related; boundary="'] + propriu delimitator + ['"; type=text/html'] + salt.
	șir adaugă-la-sfârșit: salt.
	șir adaugă-la-sfârșit: ['--'] + propriu delimitator + salt.
	șir adaugă-la-sfârșit: ['Content-Type: text/html; charset=UTF-8'] + salt.
	șir adaugă-la-sfârșit: ['Content-Transfer-Encoding: 7bit'] + salt.
	șir adaugă-la-sfârșit: salt.
	șir adaugă-la-sfârșit: propriu corp.
	șir adaugă-la-sfârșit: salt.
	propriu atașamente fiecare: { :id :info
		>> blob := info date.
		șir adaugă-la-sfârșit: ['--'] + propriu delimitator + salt.
		șir adaugă-la-sfârșit: ['Content-Type: '] + info mime + salt.
		șir adaugă-la-sfârșit: ['Content-Transfer-Encoding: base64'] + salt.
		șir adaugă-la-sfârșit: ['Content-ID: <attachment'] + id + ['>'] + salt.
		șir adaugă-la-sfârșit: ['Content-Disposition: inline; filename="'] + info fișier + ['"'] + salt.
		șir adaugă-la-sfârșit: salt.
		>> plafon := 76.
		>> lungime-text := blob lungime.
		>> bucăți := (lungime-text / plafon) rotunjește-în-sus.
		{ :i
			>> bucată := blob copiază de-la: i * plafon lungime: plafon.
			șir adaugă-la-sfârșit: bucată + salt.
		} * bucăți.
		șir adaugă-la-sfârșit: salt.
		șir adaugă-la-sfârșit: salt.
	}.
	șir adaugă-la-sfârșit: ['--'] + propriu delimitator + ['--'] + salt. <- șir.
}.
