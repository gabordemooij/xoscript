
# ~ Simple template engine ~

>> Template := Olio uusi.

Template kun: ['uusi'] tee: { <- itse uusi content: [''].
}.

Template kun: ['content:'] tee: { :content
	oma content := content. 
}.

Template kun: ['uusi:'] tee: { :content <- itse uusi content: content.
}.

Template kun: ['cut:'] tee: { :marker
	>> startmarker := (['<!-- cut:%id% -->'] %id%: marker).
	>> endmarker := (['<!-- /cut:%id% -->'] %id%: marker).
	>> parts := oma content jaa: startmarker.
	>> prefix := parts ensimmäinen.
	>> parts2 := parts viimeinen jaa: endmarker.
	>> suffix := parts2 viimeinen.
	>> part := parts2 ensimmäinen.
	>> rest := prefix + suffix.
	oma content := rest. <- Template uusi: part.
	
}.

Template kun: ['kopioi'] tee: { <- itse uusi: itse teksti kopioi.
}.
	
Template kun: ['paste:at:'] tee: { :snippet :id
	>> pastemarker := (['<!-- paste:%id% -->'] %id%: id).
	oma content korvaa: pastemarker arvolla: ( snippet teksti + pastemarker ).
}.

Template kun: ['aseta:arvo:'] tee: { :slot :value
	oma content korvaa: ['<!-- slot:'] + slot + [' -->'] arvolla: ( Server html-koodaa: value ).
}.

Template kun: ['set:html:'] tee: { :slot :html
	oma content korvaa: ['<!-- slot:'] + slot + [' -->'] arvolla: html.
}.

Template kun: ['vastaa:ja:'] tee: { :slot :value
	itse aseta: (slot alkaen: 0 pituus: (slot pituus - 1)) arvo: value.
}.

Template kun: ['nl2br'] tee: {
	oma content korvaa: ['\n'] arvolla: ['<br>'].
}.

Template kun: ['clean'] tee: {
	oma content :=
		Malli
		uusi: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		täsmää: oma content
		tee: { <- ['']. }.
}.

Template kun: ['clean-cuts'] tee: {
	>> items := Lista uusi.
	Malli
	uusi: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	täsmää: oma content
	tee: { :_ :part
		items lisää-loppuun: part ? 1.
	}.
	items jokainen: { :_ :id
		oma content :=
			Malli uusi: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			täsmää: oma content
			tee: { <- ['']. }.
	 }.
}.

Template kun: ['clean-space'] tee: {
	oma content :=
		Malli
		uusi: ['\\s*\\n'],
		täsmää: oma content
		tee: { <- ['\n']. }.
	oma content :=
		Malli
		uusi: ['\\n[\\s\\t]+'],
		täsmää: oma content
		tee: { <- ['\n']. }.
}.

Template kun: ['clean-all'] tee: {
	itse clean.
	itse clean-cuts.
	itse clean-space.
}.

Template kun: ['teksti'] tee: { <- oma content.
}.
