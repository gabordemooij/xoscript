
# ~ Simple template engine ~

>> Mallipohja := Olio uusi.

Mallipohja kun: ['uusi'] tee: { <- itse uusi sisältö: [''].
}.

Mallipohja kun: ['sisältö:'] tee: { :sisältö
	oma sisältö := sisältö. 
}.

Mallipohja kun: ['uusi:'] tee: { :sisältö <- itse uusi sisältö: sisältö.
}.

Mallipohja kun: ['leikkaa:'] tee: { :merkki
	>> alkumerkki := (['<!-- cut:%id% -->'] %id%: merkki).
	>> loppumerkki := (['<!-- /cut:%id% -->'] %id%: merkki).
	>> osat := oma sisältö jaa: alkumerkki.
	>> etuliite := osat ensimmäinen.
	>> osat2 := osat viimeinen jaa: loppumerkki.
	>> jälkiliite := osat2 viimeinen.
	>> osa := osat2 ensimmäinen.
	>> loput := etuliite + jälkiliite.
	oma sisältö := loput. <- Mallipohja uusi: osa.
	
}.

Mallipohja kun: ['kopioi'] tee: { <- itse uusi: itse teksti kopioi.
}.
	
Mallipohja kun: ['liimaa:kohtaan:'] tee: { :katkelma :id
	>> liimausmerkki := (['<!-- paste:%id% -->'] %id%: id).
	oma sisältö korvaa: liimausmerkki arvolla: ( katkelma teksti + liimausmerkki ).
}.

Mallipohja kun: ['aseta:arvo:'] tee: { :paikka :arvo
	oma sisältö korvaa: ['<!-- slot:'] + paikka + [' -->'] arvolla: ( Server html-koodaa: arvo ).
}.

Mallipohja kun: ['aseta:html:'] tee: { :paikka :html
	oma sisältö korvaa: ['<!-- slot:'] + paikka + [' -->'] arvolla: html.
}.

Mallipohja kun: ['vastaa:ja:'] tee: { :paikka :arvo
	itse aseta: (paikka alkaen: 0 pituus: (paikka pituus - 1)) arvo: arvo.
}.

Mallipohja kun: ['nl2br'] tee: {
	oma sisältö korvaa: ['\n'] arvolla: ['<br>'].
}.

Mallipohja kun: ['puhdista'] tee: {
	oma sisältö :=
		Malli
		uusi: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		täsmää: oma sisältö
		tee: { <- ['']. }.
}.

Mallipohja kun: ['puhdista-leikkeet'] tee: {
	>> kohteet := Lista uusi.
	Malli
	uusi: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	täsmää: oma sisältö
	tee: { :_ :osa
		kohteet lisää-loppuun: osa ? 1.
	}.
	kohteet jokainen: { :_ :id
		oma sisältö :=
			Malli uusi: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			täsmää: oma sisältö
			tee: { <- ['']. }.
	 }.
}.

Mallipohja kun: ['puhdista-välilyönnit'] tee: {
	oma sisältö :=
		Malli
		uusi: ['\\s*\\n'],
		täsmää: oma sisältö
		tee: { <- ['\n']. }.
	oma sisältö :=
		Malli
		uusi: ['\\n[\\s\\t]+'],
		täsmää: oma sisältö
		tee: { <- ['\n']. }.
}.

Mallipohja kun: ['puhdista-kaikki'] tee: {
	itse puhdista.
	itse puhdista-leikkeet.
	itse puhdista-välilyönnit.
}.

Mallipohja kun: ['teksti'] tee: { <- oma sisältö.
}.
