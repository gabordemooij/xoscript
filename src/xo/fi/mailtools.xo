>> Sähköposti := Olio uusi.

Sähköposti kun: ['valmistele'] tee: {
	oma vastaanottajat := Lista uusi.
	oma cc := Lista uusi.
	oma bcc := Lista uusi.
	oma lähettäjä := Tyhjä.
	oma lähettäjän-nimi := Tyhjä.
	oma aihe := Tyhjä.
	oma viestiteksti := Tyhjä.
}.

Sähköposti kun: ['uusi'] tee: { <- itse uusi valmistele.
}.

Sähköposti kun: ['vastaanottaja:'] tee: { :luettelo
	oma vastaanottajat := luettelo.
}.
 
Sähköposti kun: ['cc:'] tee: { :luettelo
	oma cc := luettelo.
}.

Sähköposti kun: ['bcc:'] tee: { :luettelo
	oma bcc := luettelo.
}.

Sähköposti kun: ['aihe:'] tee: { :aihe
	oma aihe := aihe.
}.

Sähköposti kun: ['lähettäjä:nimi:'] tee: { :lähettäjä :nimi
	oma lähettäjä := lähettäjä.
	oma lähettäjän-nimi := nimi.
}.

Sähköposti kun: ['viestiteksti:'] tee: { :viestiteksti
	oma viestiteksti := viestiteksti.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Sähköposti kun: ['otsake:'] tee: { :rivi <- rivi korvaa: ['\r'] arvolla: [''], korvaa: ['\n'] arvolla: [''].
}.

Sähköposti kun: ['lähetä'] tee: {
	>> f := Tiedosto tempwrite: itse luo.
	Ohjelma järjestelmä: ['sendmail -t < '] + f polku, rivinvaihto.
}.

Sähköposti kun: ['luo'] tee: {
	>> crlf := ['\r\n'].
	>> merkkijono := [''].
	merkkijono lisää-loppuun: (itse otsake: ['From: '] + oma lähettäjän-nimi + [' <'] + ( oma lähettäjä ) + ['>']) + crlf.
	merkkijono lisää-loppuun: (itse otsake: ['To: '] + ( oma vastaanottajat yhdistä: [','] )) + crlf.
	oma cc lukumäärä tosi: {
		merkkijono lisää-loppuun: (itse otsake: ['Cc: '] + ( oma cc yhdistä: [','] )) + crlf.
	}.
	oma bcc lukumäärä tosi: {
		merkkijono lisää-loppuun: (itse otsake: ['Bcc: '] + ( oma bcc yhdistä: [','] )) + crlf.
	}.
	merkkijono lisää-loppuun: (itse otsake: ['Subject: '] + oma aihe) + crlf.
	merkkijono lisää-loppuun: crlf.
	merkkijono lisää-loppuun: oma viestiteksti.
	merkkijono lisää-loppuun: crlf. <- merkkijono.
}.

>> HTML-Sähköposti := Sähköposti uusi.

HTML-Sähköposti kun: ['valmistele'] tee: {
	itse valmistele.
	oma liitteet := Lista uusi.
	oma raja := Holvi tunniste: 40.
}.

HTML-Sähköposti kun: ['liitä:'] tee: { :tiedosto
	>> id := oma liitteet lukumäärä.
	>> blob := tiedosto blob.
	oma liitteet lisää-loppuun: (
		Sanakirja uusi
			tiedosto: tiedosto polku,
			mime: ['image/'] + (Server mimetype: tiedosto polku),
			data: blob base64-koodaa
	).
	blob vapauta. <- ['cid:attachment'] + id.
}.

HTML-Sähköposti kun: ['luo'] tee: {
	>> crlf := ['\r\n'].
	>> merkkijono := [''].
	merkkijono lisää-loppuun: (itse otsake: ['From: '] + oma lähettäjän-nimi + [' <'] + ( oma lähettäjä ) + ['>']) + crlf.
	merkkijono lisää-loppuun: (itse otsake: ['To: '] + ( oma vastaanottajat yhdistä: [','] )) + crlf.
	oma cc lukumäärä tosi: {
		merkkijono lisää-loppuun: (itse otsake: ['Cc: '] + ( oma cc yhdistä: [','] )) + crlf.
	}.
	oma bcc lukumäärä tosi: {
		merkkijono lisää-loppuun: (itse otsake: ['Bcc: '] + ( oma bcc yhdistä: [','] )) + crlf.
	}.
	merkkijono lisää-loppuun: (itse otsake: ['Subject: '] + oma aihe) + crlf.
	merkkijono lisää-loppuun: ['MIME-Version: 1.0'] + crlf.
	merkkijono lisää-loppuun: ['Content-Type: multipart/related; boundary="'] + oma raja + ['"; type=text/html'] + crlf.
	merkkijono lisää-loppuun: crlf.
	merkkijono lisää-loppuun: ['--'] + oma raja + crlf.
	merkkijono lisää-loppuun: ['Content-Type: text/html; charset=UTF-8'] + crlf.
	merkkijono lisää-loppuun: ['Content-Transfer-Encoding: 7bit'] + crlf.
	merkkijono lisää-loppuun: crlf.
	merkkijono lisää-loppuun: oma viestiteksti.
	merkkijono lisää-loppuun: crlf.
	oma liitteet jokainen: { :id :info
		>> blob := info data.
		merkkijono lisää-loppuun: ['--'] + oma raja + crlf.
		merkkijono lisää-loppuun: ['Content-Type: '] + info mime + crlf.
		merkkijono lisää-loppuun: ['Content-Transfer-Encoding: base64'] + crlf.
		merkkijono lisää-loppuun: ['Content-ID: <attachment'] + id + ['>'] + crlf.
		merkkijono lisää-loppuun: ['Content-Disposition: inline; filename="'] + info tiedosto + ['"'] + crlf.
		merkkijono lisää-loppuun: crlf.
		>> enimmäis := 76.
		>> tekstin-pituus := blob pituus.
		>> palat := (tekstin-pituus / enimmäis) pyöristä-ylös.
		{ :i
			>> pala := blob kopioi alkaen: i * enimmäis pituus: enimmäis.
			merkkijono lisää-loppuun: pala + crlf.
		} * palat.
		merkkijono lisää-loppuun: crlf.
		merkkijono lisää-loppuun: crlf.
	}.
	merkkijono lisää-loppuun: ['--'] + oma raja + ['--'] + crlf. <- merkkijono.
}.
