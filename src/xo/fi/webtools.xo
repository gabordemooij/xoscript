HTTP-Pyyntö kun: ['HTTP-otsake:'] tee: { :avain <- Ohjelma asetus: avain.
}.

>> HTTP-Otsake := Olio uusi.

HTTP-Otsake kun: ['uusi'] tee: { <- itse uusi valmistele.
}.

HTTP-Otsake kun: ['valmistele'] tee: {
	oma avain := Tyhjä.
	oma arvo := Tyhjä.
}.

HTTP-Otsake kun: ['avain:arvo:'] tee: { :avain :arvo
	oma avain := avain.
	oma arvo := arvo.
}.

HTTP-Otsake kun: ['avain'] tee: { <- oma avain.
}.

HTTP-Otsake kun: ['arvo'] tee: { <- oma arvo.
}.


HTTP-Otsake kun: ['teksti'] tee: {
	>> rivi := oma avain + [': '] + oma arvo.
	rivi korvaa: ['\r'] arvolla: [''], korvaa: ['\n'] arvolla: ['']. <- rivi + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Verkkodokumentti := Olio uusi.

Verkkodokumentti kun: ['uusi'] tee: { <- itse uusi valmistele.
}.

Verkkodokumentti kun: ['valmistele'] tee: {
	oma otsakkeet := Lista uusi.
	oma istunto-id := Tyhjä.
	oma istunnonhallinta := Väliaikaistiedosto-istunto uusi.
	oma istuntodata := Tyhjä.
	oma turvallinen := Tosi.
	oma sama-sivusto := ['Strict'].
	oma otsakkeet-lähetetty := Epätosi.
	oma pyyntö := HTTP-Pyyntö uusi.
}.

Verkkodokumentti kun: ['pyyntö:'] tee: { :pyyntö
	oma pyyntö := pyyntö.
}. 

Verkkodokumentti kun: ['turvallinen-istuntoeväste:'] tee: { :turvallinen
	itse tarkista-otsakkeet.
	oma turvallinen := turvallinen.
}.

Verkkodokumentti kun: ['sama-sivusto-istuntoeväste:'] tee: { :arvo
	itse tarkista-otsakkeet.
	>> valinnat := Lista uusi 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	valinnat sisältää: arvo, epätosi: {
		tämä-tehtävä virhe: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	oma sama-sivusto := arvo.
}.

Verkkodokumentti kun: ['otsake:'] tee: { :otsake
	itse tarkista-otsakkeet.
	oma otsakkeet lisää-loppuun: otsake.
}.

Verkkodokumentti kun: ['tyhjennä-otsakkeet'] tee: {
	itse tarkista-otsakkeet.
	oma otsakkeet := Lista uusi.
}.

Verkkodokumentti kun: ['istunnonhallinta:'] tee: { :hallinta
	itse tarkista-otsakkeet.
	oma istunnonhallinta := hallinta.
}.

Verkkodokumentti kun: ['istunnonhallinta'] tee: { <- oma istunnonhallinta.
}.

Verkkodokumentti kun: ['tarkista-otsakkeet'] tee: {
	oma otsakkeet-lähetetty tosi: {
		tämä-tehtävä virhe: ['Headers already sent to client.'].
	}.
}.

Verkkodokumentti kun: ['aloita-istunto'] tee: {
	itse tarkista-otsakkeet.
	>> pyyntö := oma pyyntö.
	>> istunto-id := pyyntö cookie: ['xsid'].
	istunto-id Tyhjä? epätosi: {
		(( Malli uusi: ['^[A-Za-z0-9]+\\z'], täsmää: istunto-id ) = 0) tosi: {
			istunto-id := Tyhjä.
		}.
	}.
	istunto-id Tyhjä? tosi: {
		istunto-id := Holvi tunniste: 30.
		>> istunto-otsake := HTTP-Otsake uusi
		avain: ['Set-Cookie'] arvo: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (oma turvallinen joko: ['Secure'] tai: ['']),
		SSITE: (oma sama-sivusto),
		XSID: istunto-id
		).
		oma otsakkeet lisää-loppuun: istunto-otsake.
	}.
	oma istuntodata := oma istunnonhallinta kohteelle: istunto-id, lataa. <- oma istuntodata. # reference
}.

Verkkodokumentti kun: ['siirry:'] tee: { :osoite
	itse tarkista-otsakkeet.
	itse tyhjennä-otsakkeet.
	oma otsakkeet
	lisää-loppuun: (
		HTTP-Otsake uusi
		avain: ['Status'] arvo: ['303 See Other']
	),
	lisää-loppuun: (
		HTTP-Otsake uusi
		avain: ['Location'] arvo: osoite
	).
	itse tulosta: ['Redirect'].
}.

Verkkodokumentti kun: ['tuhoa-istunto'] tee: {
	itse tarkista-otsakkeet.
	>> pyyntö := oma pyyntö.
	>> istunto-id := pyyntö cookie: ['xsid'].
	istunto-id Tyhjä? epätosi: {
		>> istunto-otsake := HTTP-Otsake uusi.
		>> hetki := Hetki uusi vuosi: 1970, muoto: ['%a, %d %b %Y %H:%M:%S GMT'].
		istunto-otsake avain: ['Set-Cookie'] arvo: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: hetki,
			SEC: (oma turvallinen joko: ['Secure'] tai: ['']),
			SSITE: (oma sama-sivusto),
			XSID: istunto-id
		).
		oma istunnonhallinta tuhoa.
		oma otsakkeet lisää-loppuun: istunto-otsake.
	}.
}.


Verkkodokumentti kun: ['mallipohja:'] tee: { :polku <- Mallipohja uusi: (Tiedosto uusi: polku, lue).
}.

Verkkodokumentti kun: ['tulosta:tyyppi:'] tee: { :tuloste :tyyppi
	oma otsakkeet-lähetetty epätosi: {
		oma istuntodata Tyhjä? epätosi: {
			oma istunnonhallinta tallenna: oma istuntodata.
		}.
		oma otsakkeet lisää-loppuun: (
			HTTP-Otsake uusi
			avain: ['Content-type'] arvo: tyyppi
		).
		oma otsakkeet jokainen: { :_ :otsake
			Tuloste kirjoita: otsake.
		}.
		oma otsakkeet-lähetetty := Tosi.
		Tuloste kirjoita: ['\r\n'].
	}.
	Tuloste kirjoita: tuloste.
}.

Verkkodokumentti kun: ['viimeistele:tyyppi:'] tee: { :tuloste :tyyppi
	oma otsakkeet-lähetetty epätosi: {
		oma istuntodata Tyhjä? epätosi: {
			oma istunnonhallinta tallenna: oma istuntodata.
		}.
		oma otsakkeet lisää-loppuun: (
			HTTP-Otsake uusi
			avain: ['Content-type'] arvo: tyyppi
		).
		oma otsakkeet lisää-loppuun: (
			HTTP-Otsake uusi
			avain: ['Content-Length'] arvo: tuloste teksti bytes
		).
		oma otsakkeet jokainen: { :_ :otsake
			Tuloste kirjoita: otsake.
		}.
		oma otsakkeet-lähetetty := Tosi.
		Tuloste kirjoita: ['\r\n'].
	}.
	Tuloste kirjoita: tuloste.
}.

Verkkodokumentti kun: ['tulosta:'] tee: { :tuloste
	itse tulosta: tuloste tyyppi: ['text/html; charset=utf-8'].
}.

Verkkodokumentti kun: ['viimeistele:'] tee: { :tuloste
	itse viimeistele: tuloste tyyppi: ['text/html; charset=utf-8'].
}.

Verkkodokumentti kun: ['json:'] tee: { :tuloste
	itse tulosta: ( JSON jsonify: tuloste ) tyyppi: ['application/json'].
}.

Verkkodokumentti kun: ['ei-löydy:'] tee: { :tuloste
	itse tyhjennä-otsakkeet otsake: (
		HTTP-Otsake uusi avain: ['Status'] arvo: ['404 Not Found']
	).
	itse tulosta: tuloste.
}.


# Interface

>> Istunto := Olio uusi.

Istunto kun: ['uusi'] tee: { <- itse uusi valmistele kohteelle: Tyhjä.
}.

Istunto kun: ['kohteelle:'] tee: { :id
	oma id := id.
}.

Istunto kun: ['lataa'] tee: {
	tämä-tehtävä virhe: ['Not implemented.'].
}.

Istunto kun: ['tallenna:'] tee: {
	tämä-tehtävä virhe: ['Not implemented.'].
}.

Istunto kun: ['tuhoa'] tee: {
	tämä-tehtävä virhe: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Väliaikaistiedosto-istunto := Istunto uusi.

Väliaikaistiedosto-istunto kun: ['valmistele'] tee: {
	oma polun-alku := ['/tmp/sess-'].
}.

Väliaikaistiedosto-istunto kun: ['polun-etuliite:'] tee: { :merkkijono
	oma polun-alku := merkkijono.
}.

Väliaikaistiedosto-istunto kun: ['tiedosto'] tee: { <- ( Tiedosto uusi: ( oma polun-alku + oma id + ['.txt'] ) ).
}.

Väliaikaistiedosto-istunto kun: ['lataa'] tee: {
	>> tiedosto := itse tiedosto.
	tiedosto on-olemassa epätosi: {
		tiedosto kirjoita: (Sanakirja uusi koodi).
	}. <- tiedosto lue olio.
}.

Väliaikaistiedosto-istunto kun: ['tallenna:'] tee: { :data
	>> tiedosto := itse tiedosto.
	tiedosto on-olemassa tosi: {
		tiedosto kirjoita: data koodi.
	}.
}.

Väliaikaistiedosto-istunto kun: ['tuhoa'] tee: {
	>> tiedosto := itse tiedosto.
	tiedosto on-olemassa tosi: {
		tiedosto poista.
	}.
}.


>> URL := Olio uusi.

URL kun: ['valmistele'] tee: {
	oma protokolla := ['https://'].
	oma isäntä := ['localhost'].
	oma polku := [''].
	oma url-parametrit := [''].
	oma hash := [''].
}.

URL kun: ['uusi'] tee: { <- itse uusi valmistele.
}.

URL kun: ['teksti'] tee: { <- (
	oma protokolla +
	oma isäntä +
	oma polku +
	oma url-parametrit +
	oma hash ).
}.

URL kun: ['protokolla:'] tee: { :protokolla
	((Lista uusi ; ['http'] ; ['https']) sisältää: protokolla) tosi: {
		oma protokolla := protokolla + ['://'].
	}, epätosi: {
		tämä-tehtävä virhe: ['Invalid protocol'].
	}.
}.

URL kun: ['isäntä:'] tee: { :isäntä
	#todo validate according to rfc
	oma isäntä := isäntä.
}.

URL kun: ['polku:'] tee: { :polku
	oma polku := ['/'] + polku url-koodaa.
}.

URL kun: ['url-parametrit:'] tee: { :kuvaus
	>> url-parametrit := Lista uusi.
	kuvaus jokainen: { :avain :arvo
		url-parametrit lisää-loppuun: avain teksti url-koodaa + ['='] + arvo teksti url-koodaa.
	}.
	oma url-parametrit := ['?'] + ( url-parametrit yhdistä: ['&'] ).
}.

URL kun: ['tiiviste:'] tee: { :hash
	oma hash := ['#'] + hash url-koodaa.
}.

