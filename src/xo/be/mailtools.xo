>> Імэйл := Абʼект новы.

Імэйл пры: ['ініцыялізаваць'] выканаць: {
	свой атрымальнікі := Спіс новы.
	свой cc := Спіс новы.
	свой bcc := Спіс новы.
	свой адпраўнік := Нішто.
	свой імя-адпраўніка := Нішто.
	свой тэма := Нішто.
	свой цела := Нішто.
}.

Імэйл пры: ['новы'] выканаць: { <- сам новы ініцыялізаваць.
}.

Імэйл пры: ['каму:'] выканаць: { :пералік
	свой атрымальнікі := пералік.
}.
 
Імэйл пры: ['cc:'] выканаць: { :пералік
	свой cc := пералік.
}.

Імэйл пры: ['bcc:'] выканаць: { :пералік
	свой bcc := пералік.
}.

Імэйл пры: ['тэма:'] выканаць: { :тэма
	свой тэма := тэма.
}.

Імэйл пры: ['адпраўнік:імя:'] выканаць: { :адпраўнік :імя
	свой адпраўнік := адпраўнік.
	свой імя-адпраўніка := імя.
}.

Імэйл пры: ['цела:'] выканаць: { :цела
	свой цела := цела.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Імэйл пры: ['загаловак:'] выканаць: { :лінія <- лінія замяніць: ['\r'] на: [''], замяніць: ['\n'] на: [''].
}.

Імэйл пры: ['адправіць'] выканаць: {
	>> f := Файл tempwrite: сам згенераваць.
	Праграма сістэма: ['sendmail -t < '] + f шлях, новы-радок.
}.

Імэйл пры: ['згенераваць'] выканаць: {
	>> перанос := ['\r\n'].
	>> радок := [''].
	радок дадаць-у-канец: (сам загаловак: ['From: '] + свой імя-адпраўніка + [' <'] + ( свой адпраўнік ) + ['>']) + перанос.
	радок дадаць-у-канец: (сам загаловак: ['To: '] + ( свой атрымальнікі злучыць: [','] )) + перанос.
	свой cc колькасць праўда: {
		радок дадаць-у-канец: (сам загаловак: ['Cc: '] + ( свой cc злучыць: [','] )) + перанос.
	}.
	свой bcc колькасць праўда: {
		радок дадаць-у-канец: (сам загаловак: ['Bcc: '] + ( свой bcc злучыць: [','] )) + перанос.
	}.
	радок дадаць-у-канец: (сам загаловак: ['Subject: '] + свой тэма) + перанос.
	радок дадаць-у-канец: перанос.
	радок дадаць-у-канец: свой цела.
	радок дадаць-у-канец: перанос. <- радок.
}.

>> HTML-Імэйл := Імэйл новы.

HTML-Імэйл пры: ['ініцыялізаваць'] выканаць: {
	сам ініцыялізаваць.
	свой укладанні := Спіс новы.
	свой мяжа := Сховішча токен: 40.
}.

HTML-Імэйл пры: ['прымацаваць:'] выканаць: { :файл
	>> id := свой укладанні колькасць.
	>> blob := файл blob.
	свой укладанні дадаць-у-канец: (
		Слоўнік новы
			файл: файл шлях,
			mime: ['image/'] + (Server mimetype: файл шлях),
			даныя: blob base64-кадаваць
	).
	blob вызваліць. <- ['cid:attachment'] + id.
}.

HTML-Імэйл пры: ['згенераваць'] выканаць: {
	>> перанос := ['\r\n'].
	>> радок := [''].
	радок дадаць-у-канец: (сам загаловак: ['From: '] + свой імя-адпраўніка + [' <'] + ( свой адпраўнік ) + ['>']) + перанос.
	радок дадаць-у-канец: (сам загаловак: ['To: '] + ( свой атрымальнікі злучыць: [','] )) + перанос.
	свой cc колькасць праўда: {
		радок дадаць-у-канец: (сам загаловак: ['Cc: '] + ( свой cc злучыць: [','] )) + перанос.
	}.
	свой bcc колькасць праўда: {
		радок дадаць-у-канец: (сам загаловак: ['Bcc: '] + ( свой bcc злучыць: [','] )) + перанос.
	}.
	радок дадаць-у-канец: (сам загаловак: ['Subject: '] + свой тэма) + перанос.
	радок дадаць-у-канец: ['MIME-Version: 1.0'] + перанос.
	радок дадаць-у-канец: ['Content-Type: multipart/related; boundary="'] + свой мяжа + ['"; type=text/html'] + перанос.
	радок дадаць-у-канец: перанос.
	радок дадаць-у-канец: ['--'] + свой мяжа + перанос.
	радок дадаць-у-канец: ['Content-Type: text/html; charset=UTF-8'] + перанос.
	радок дадаць-у-канец: ['Content-Transfer-Encoding: 7bit'] + перанос.
	радок дадаць-у-канец: перанос.
	радок дадаць-у-канец: свой цела.
	радок дадаць-у-канец: перанос.
	свой укладанні кожны: { :id :інфа
		>> blob := інфа даныя.
		радок дадаць-у-канец: ['--'] + свой мяжа + перанос.
		радок дадаць-у-канец: ['Content-Type: '] + інфа mime + перанос.
		радок дадаць-у-канец: ['Content-Transfer-Encoding: base64'] + перанос.
		радок дадаць-у-канец: ['Content-ID: <attachment'] + id + ['>'] + перанос.
		радок дадаць-у-канец: ['Content-Disposition: inline; filename="'] + інфа файл + ['"'] + перанос.
		радок дадаць-у-канец: перанос.
		>> найбольш := 76.
		>> даўжыня-тэксту := blob даўжыня.
		>> кавалкі := (даўжыня-тэксту / найбольш) акругліць-уверх.
		{ :i
			>> кавалак := blob капіяваць ад: i * найбольш даўжыня: найбольш.
			радок дадаць-у-канец: кавалак + перанос.
		} * кавалкі.
		радок дадаць-у-канец: перанос.
		радок дадаць-у-канец: перанос.
	}.
	радок дадаць-у-канец: ['--'] + свой мяжа + ['--'] + перанос. <- радок.
}.
