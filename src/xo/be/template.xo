
# ~ Simple template engine ~

>> Нарыхтоўка := Абʼект новы.

Нарыхтоўка пры: ['новы'] выканаць: { <- сам новы змесціва: [''].
}.

Нарыхтоўка пры: ['змесціва:'] выканаць: { :змесціва
	свой змесціва := змесціва. 
}.

Нарыхтоўка пры: ['новы:'] выканаць: { :змесціва <- сам новы змесціва: змесціва.
}.

Нарыхтоўка пры: ['выразаць:'] выканаць: { :маркер
	>> пачатковы-маркер := (['<!-- cut:%id% -->'] %id%: маркер).
	>> канцавы-маркер := (['<!-- /cut:%id% -->'] %id%: маркер).
	>> часткі := свой змесціва падзяліць: пачатковы-маркер.
	>> прэфікс := часткі першы.
	>> часткі2 := часткі апошні падзяліць: канцавы-маркер.
	>> суфікс := часткі2 апошні.
	>> частка := часткі2 першы.
	>> рэшта := прэфікс + суфікс.
	свой змесціва := рэшта. <- Нарыхтоўка новы: частка.
	
}.

Нарыхтоўка пры: ['капіяваць'] выканаць: { <- сам новы: сам тэкст капіяваць.
}.
	
Нарыхтоўка пры: ['уставіць:на:'] выканаць: { :фрагмент-html :id
	>> маркер-устаўкі := (['<!-- paste:%id% -->'] %id%: id).
	свой змесціва замяніць: маркер-устаўкі на: ( фрагмент-html тэкст + маркер-устаўкі ).
}.

Нарыхтоўка пры: ['задаць:значэнне:'] выканаць: { :слот :значэнне
	свой змесціва замяніць: ['<!-- slot:'] + слот + [' -->'] на: ( Server html-кадаваць: значэнне ).
}.

Нарыхтоўка пры: ['задаць:html:'] выканаць: { :слот :html
	свой змесціва замяніць: ['<!-- slot:'] + слот + [' -->'] на: html.
}.

Нарыхтоўка пры: ['адказаць:і:'] выканаць: { :слот :значэнне
	сам задаць: (слот ад: 0 даўжыня: (слот даўжыня - 1)) значэнне: значэнне.
}.

Нарыхтоўка пры: ['nl2br'] выканаць: {
	свой змесціва замяніць: ['\n'] на: ['<br>'].
}.

Нарыхтоўка пры: ['падчысціць'] выканаць: {
	свой змесціва :=
		Шаблон
		новы: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		супадзенне: свой змесціва
		выканаць: { <- ['']. }.
}.

Нарыхтоўка пры: ['падчысціць-выразкі'] выканаць: {
	>> элементы := Спіс новы.
	Шаблон
	новы: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	супадзенне: свой змесціва
	выканаць: { :_ :частка
		элементы дадаць-у-канец: частка ? 1.
	}.
	элементы кожны: { :_ :id
		свой змесціва :=
			Шаблон новы: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			супадзенне: свой змесціва
			выканаць: { <- ['']. }.
	 }.
}.

Нарыхтоўка пры: ['падчысціць-прабелы'] выканаць: {
	свой змесціва :=
		Шаблон
		новы: ['\\s*\\n'],
		супадзенне: свой змесціва
		выканаць: { <- ['\n']. }.
	свой змесціва :=
		Шаблон
		новы: ['\\n[\\s\\t]+'],
		супадзенне: свой змесціва
		выканаць: { <- ['\n']. }.
}.

Нарыхтоўка пры: ['падчысціць-усё'] выканаць: {
	сам падчысціць.
	сам падчысціць-выразкі.
	сам падчысціць-прабелы.
}.

Нарыхтоўка пры: ['тэкст'] выканаць: { <- свой змесціва.
}.
