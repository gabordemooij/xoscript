# Default Session implementation, uses tempfile

>> Tempfile-Session := Session новы.

Tempfile-Session пры: ['init'] выканаць: {
	свой pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session пры: ['path-prefix:'] выканаць: { :str
	свой pathprefix := str.
}.

Tempfile-Session пры: ['file'] выканаць: { <- ( Файл новы: ( свой pathprefix + свой id + ['.txt'] ) ).
}.

Tempfile-Session пры: ['load'] выканаць: {
	>> file := сам file.
	file існуе хлусня: {
		file пісаць: (Слоўнік новы код).
	}. <- file чытаць абʼект.
}.

Tempfile-Session пры: ['save:'] выканаць: { :data
	>> file := сам file.
	file існуе праўда: {
		file пісаць: data код.
	}.
}.

Tempfile-Session пры: ['destroy'] выканаць: {
	>> file := сам file.
	file існуе праўда: {
		file выдаліць.
	}.
}.


>> URL := Абʼект новы.

URL пры: ['init'] выканаць: {
	свой protocol := ['https://'].
	свой хост := ['localhost'].
	свой шлях := [''].
	свой params := [''].
	свой hash := [''].
}.

URL пры: ['новы'] выканаць: { <- сам новы init.
}.

URL пры: ['тэкст'] выканаць: { <- (
	свой protocol +
	свой хост +
	свой шлях +
	свой params +
	свой hash ).
}.

URL пры: ['protocol:'] выканаць: { :protocol
	((Спіс новы: ['http'] ; ['https']) змяшчае: protocol) праўда: {
		свой protocol := protocol + ['://'].
	}, хлусня: {
		гэта-задача памылка: ['Invalid protocol'].
	}.
}.

URL пры: ['хост:'] выканаць: { :хост
	#todo validate according to rfc
	свой хост := хост.
}.

URL пры: ['path:'] выканаць: { :шлях
	свой шлях := ['/'] + шлях url-кадаваць.
}.

URL пры: ['params:'] выканаць: { :map
	>> params := Спіс новы.
	map кожны: { :key :value
		params дадаць-у-канец: key тэкст url-кадаваць + ['='] + value тэкст url-кадаваць.
	}.
	свой params := ['?'] + ( params злучыць: ['&'] ).
}.

URL пры: ['хэш:'] выканаць: { :hash
	свой hash := ['#'] + hash url-кадаваць.
}.

