# Default Session implementation, uses tempfile

>> Сесія-часовы-файл := Сесія новы.

Сесія-часовы-файл пры: ['ініцыялізаваць'] выканаць: {
	свой пачатак-шляху := ['/tmp/sess-'].
}.

Сесія-часовы-файл пры: ['прэфікс-шляху:'] выканаць: { :радок
	свой пачатак-шляху := радок.
}.

Сесія-часовы-файл пры: ['файл'] выканаць: { <- ( Файл новы: ( свой пачатак-шляху + свой id + ['.txt'] ) ).
}.

Сесія-часовы-файл пры: ['загрузіць'] выканаць: {
	>> файл := сам файл.
	файл існуе хлусня: {
		файл пісаць: (Слоўнік новы код).
	}. <- файл чытаць абʼект.
}.

Сесія-часовы-файл пры: ['захаваць:'] выканаць: { :даныя
	>> файл := сам файл.
	файл існуе праўда: {
		файл пісаць: даныя код.
	}.
}.

Сесія-часовы-файл пры: ['знішчыць'] выканаць: {
	>> файл := сам файл.
	файл існуе праўда: {
		файл выдаліць.
	}.
}.


>> URL := Абʼект новы.

URL пры: ['ініцыялізаваць'] выканаць: {
	свой пратакол := ['https://'].
	свой хост := ['localhost'].
	свой шлях := [''].
	свой параметры-url := [''].
	свой hash := [''].
}.

URL пры: ['новы'] выканаць: { <- сам новы ініцыялізаваць.
}.

URL пры: ['тэкст'] выканаць: { <- (
	свой пратакол +
	свой хост +
	свой шлях +
	свой параметры-url +
	свой hash ).
}.

URL пры: ['пратакол:'] выканаць: { :пратакол
	((Спіс новы ; ['http'] ; ['https']) мае: пратакол) праўда: {
		свой пратакол := пратакол + ['://'].
	}, хлусня: {
		гэта-задача памылка: ['Invalid protocol'].
	}.
}.

URL пры: ['хост:'] выканаць: { :хост
	#todo validate according to rfc
	свой хост := хост.
}.

URL пры: ['шлях:'] выканаць: { :шлях
	свой шлях := ['/'] + шлях url-кадаваць.
}.

URL пры: ['параметры-url:'] выканаць: { :адпаведнасць
	>> параметры-url := Спіс новы.
	адпаведнасць кожны: { :ключ :значэнне
		параметры-url дадаць-у-канец: ключ тэкст url-кадаваць + ['='] + значэнне тэкст url-кадаваць.
	}.
	свой параметры-url := ['?'] + ( параметры-url злучыць: ['&'] ).
}.

URL пры: ['хэш:'] выканаць: { :hash
	свой hash := ['#'] + hash url-кадаваць.
}.

