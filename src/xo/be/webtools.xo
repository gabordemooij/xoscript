HTTP-Запыт пры: ['HTTP-загаловак:'] выканаць: { :ключ <- Праграма налада: ключ.
}.

>> HTTP-Загаловак := Абʼект новы.

HTTP-Загаловак пры: ['новы'] выканаць: { <- сам новы ініцыялізаваць.
}.

HTTP-Загаловак пры: ['ініцыялізаваць'] выканаць: {
	свой ключ := Нішто.
	свой значэнне := Нішто.
}.

HTTP-Загаловак пры: ['ключ:значэнне:'] выканаць: { :ключ :значэнне
	свой ключ := ключ.
	свой значэнне := значэнне.
}.

HTTP-Загаловак пры: ['ключ'] выканаць: { <- свой ключ.
}.

HTTP-Загаловак пры: ['значэнне'] выканаць: { <- свой значэнне.
}.


HTTP-Загаловак пры: ['тэкст'] выканаць: {
	>> лінія := свой ключ + [': '] + свой значэнне.
	лінія замяніць: ['\r'] на: [''], замяніць: ['\n'] на: ['']. <- лінія + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Вэб-дакумент := Абʼект новы.

Вэб-дакумент пры: ['новы'] выканаць: { <- сам новы ініцыялізаваць.
}.

Вэб-дакумент пры: ['ініцыялізаваць'] выканаць: {
	свой загалоўкі := Спіс новы.
	свой ід-сесіі := Нішто.
	свой менеджар-сесій := Сесія-часовы-файл новы.
	свой даныя-сесіі := Нішто.
	свой абаронена := Праўда.
	свой той-жа-сайт := ['Strict'].
	свой загалоўкі-адпраўлены := Хлусня.
	свой http-запыт := HTTP-Запыт новы.
}.

Вэб-дакумент пры: ['http-запыт:'] выканаць: { :http-запыт
	свой http-запыт := http-запыт.
}. 

Вэб-дакумент пры: ['абаронены-cookie-сесіі:'] выканаць: { :абаронена
	сам праверыць-загалоўкі.
	свой абаронена := абаронена.
}.

Вэб-дакумент пры: ['cookie-сесіі-same-site:'] выканаць: { :значэнне
	сам праверыць-загалоўкі.
	>> опцыі := Спіс новы 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опцыі мае: значэнне, хлусня: {
		гэта-задача памылка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	свой той-жа-сайт := значэнне.
}.

Вэб-дакумент пры: ['загаловак:'] выканаць: { :загаловак
	сам праверыць-загалоўкі.
	свой загалоўкі дадаць-у-канец: загаловак.
}.

Вэб-дакумент пры: ['скінуць-загалоўкі'] выканаць: {
	сам праверыць-загалоўкі.
	свой загалоўкі := Спіс новы.
}.

Вэб-дакумент пры: ['менеджар-сесій:'] выканаць: { :менеджар
	сам праверыць-загалоўкі.
	свой менеджар-сесій := менеджар.
}.

Вэб-дакумент пры: ['менеджар-сесій'] выканаць: { <- свой менеджар-сесій.
}.

Вэб-дакумент пры: ['праверыць-загалоўкі'] выканаць: {
	свой загалоўкі-адпраўлены праўда: {
		гэта-задача памылка: ['Headers already sent to client.'].
	}.
}.

Вэб-дакумент пры: ['пачаць-сесію'] выканаць: {
	сам праверыць-загалоўкі.
	>> http-запыт := свой http-запыт.
	>> ід-сесіі := http-запыт cookie: ['xsid'].
	ід-сесіі Нішто? хлусня: {
		(( Шаблон новы: ['^[A-Za-z0-9]+\\z'], супадзенне: ід-сесіі ) = 0) праўда: {
			ід-сесіі := Нішто.
		}.
	}.
	ід-сесіі Нішто? праўда: {
		ід-сесіі := Сховішча токен: 30.
		>> загаловак-сесіі := HTTP-Загаловак новы
		ключ: ['Set-Cookie'] значэнне: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (свой абаронена альбо: ['Secure'] альбо: ['']),
		SSITE: (свой той-жа-сайт),
		XSID: ід-сесіі
		).
		свой загалоўкі дадаць-у-канец: загаловак-сесіі.
	}.
	свой даныя-сесіі := свой менеджар-сесій для: ід-сесіі, загрузіць. <- свой даныя-сесіі. # reference
}.

Вэб-дакумент пры: ['перайсці-да:'] выканаць: { :адрас
	сам праверыць-загалоўкі.
	сам скінуць-загалоўкі.
	свой загалоўкі
	дадаць-у-канец: (
		HTTP-Загаловак новы
		ключ: ['Status'] значэнне: ['303 See Other']
	),
	дадаць-у-канец: (
		HTTP-Загаловак новы
		ключ: ['Location'] значэнне: адрас
	).
	сам вывесці: ['Redirect'].
}.

Вэб-дакумент пры: ['знішчыць-сесію'] выканаць: {
	сам праверыць-загалоўкі.
	>> http-запыт := свой http-запыт.
	>> ід-сесіі := http-запыт cookie: ['xsid'].
	ід-сесіі Нішто? хлусня: {
		>> загаловак-сесіі := HTTP-Загаловак новы.
		>> момант := Момант новы год: 1970, фармат: ['%a, %d %b %Y %H:%M:%S GMT'].
		загаловак-сесіі ключ: ['Set-Cookie'] значэнне: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: момант,
			SEC: (свой абаронена альбо: ['Secure'] альбо: ['']),
			SSITE: (свой той-жа-сайт),
			XSID: ід-сесіі
		).
		свой менеджар-сесій знішчыць.
		свой загалоўкі дадаць-у-канец: загаловак-сесіі.
	}.
}.


Вэб-дакумент пры: ['нарыхтоўка:'] выканаць: { :шлях <- Нарыхтоўка новы: (Файл новы: шлях, чытаць).
}.

Вэб-дакумент пры: ['вывесці:тып:'] выканаць: { :вывад :тып
	свой загалоўкі-адпраўлены хлусня: {
		свой даныя-сесіі Нішто? хлусня: {
			свой менеджар-сесій захаваць: свой даныя-сесіі.
		}.
		свой загалоўкі дадаць-у-канец: (
			HTTP-Загаловак новы
			ключ: ['Content-type'] значэнне: тып
		).
		свой загалоўкі кожны: { :_ :загаловак
			Вывад пісаць: загаловак.
		}.
		свой загалоўкі-адпраўлены := Праўда.
		Вывад пісаць: ['\r\n'].
	}.
	Вывад пісаць: вывад.
}.

Вэб-дакумент пры: ['завяршыць:тып:'] выканаць: { :вывад :тып
	свой загалоўкі-адпраўлены хлусня: {
		свой даныя-сесіі Нішто? хлусня: {
			свой менеджар-сесій захаваць: свой даныя-сесіі.
		}.
		свой загалоўкі дадаць-у-канец: (
			HTTP-Загаловак новы
			ключ: ['Content-type'] значэнне: тып
		).
		свой загалоўкі дадаць-у-канец: (
			HTTP-Загаловак новы
			ключ: ['Content-Length'] значэнне: вывад тэкст bytes
		).
		свой загалоўкі кожны: { :_ :загаловак
			Вывад пісаць: загаловак.
		}.
		свой загалоўкі-адпраўлены := Праўда.
		Вывад пісаць: ['\r\n'].
	}.
	Вывад пісаць: вывад.
}.

Вэб-дакумент пры: ['вывесці:'] выканаць: { :вывад
	сам вывесці: вывад тып: ['text/html; charset=utf-8'].
}.

Вэб-дакумент пры: ['завяршыць:'] выканаць: { :вывад
	сам завяршыць: вывад тып: ['text/html; charset=utf-8'].
}.

Вэб-дакумент пры: ['json:'] выканаць: { :вывад
	сам вывесці: ( JSON jsonify: вывад ) тып: ['application/json'].
}.

Вэб-дакумент пры: ['не-знойдзена:'] выканаць: { :вывад
	сам скінуць-загалоўкі загаловак: (
		HTTP-Загаловак новы ключ: ['Status'] значэнне: ['404 Not Found']
	).
	сам вывесці: вывад.
}.


