Tono-HTTP ina-tae: ['HTTP-pane:'] mahia: { :kī <- Papatono tautuhinga: kī.
}.

>> Pane-HTTP := Ahanoa hou.

Pane-HTTP ina-tae: ['hou'] mahia: { <- whaiaro hou whakarite.
}.

Pane-HTTP ina-tae: ['whakarite'] mahia: {
	ake kī := Kore.
	ake uara := Kore.
}.

Pane-HTTP ina-tae: ['kī:uara:'] mahia: { :kī :uara
	ake kī := kī.
	ake uara := uara.
}.

Pane-HTTP ina-tae: ['kī'] mahia: { <- ake kī.
}.

Pane-HTTP ina-tae: ['uara'] mahia: { <- ake uara.
}.


Pane-HTTP ina-tae: ['aho'] mahia: {
	>> rārangi := ake kī + [': '] + ake uara.
	rārangi whakakapihia: ['\r'] me: [''], whakakapihia: ['\n'] me: ['']. <- rārangi + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Tuhinga-Ipurangi := Ahanoa hou.

Tuhinga-Ipurangi ina-tae: ['hou'] mahia: { <- whaiaro hou whakarite.
}.

Tuhinga-Ipurangi ina-tae: ['whakarite'] mahia: {
	ake ngā-pane := Rārangi hou.
	ake id-wāhanga := Kore.
	ake kaiwhakahaere-wāhanga := Wāhanga-kōnae-poto hou.
	ake raraunga-wāhanga := Kore.
	ake haumaru := Pono.
	ake pae-ōrite := ['Strict'].
	ake kua-tukuna-ngā-pane := Teka.
	ake tono-http := Tono-HTTP hou.
}.

Tuhinga-Ipurangi ina-tae: ['tono-http:'] mahia: { :tono-http
	ake tono-http := tono-http.
}. 

Tuhinga-Ipurangi ina-tae: ['pihikete-wāhanga-haumaru:'] mahia: { :haumaru
	whaiaro tirohia-ngā-pane.
	ake haumaru := haumaru.
}.

Tuhinga-Ipurangi ina-tae: ['pihikete-wāhanga-pae-ōrite:'] mahia: { :uara
	whaiaro tirohia-ngā-pane.
	>> ngā-kōwhiringa := Rārangi hou 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	ngā-kōwhiringa kei-a-ia: uara, teka: {
		tēnei-mahi hapa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ake pae-ōrite := uara.
}.

Tuhinga-Ipurangi ina-tae: ['pane:'] mahia: { :pane
	whaiaro tirohia-ngā-pane.
	ake ngā-pane tāpiri-muri: pane.
}.

Tuhinga-Ipurangi ina-tae: ['whakawātea-pane'] mahia: {
	whaiaro tirohia-ngā-pane.
	ake ngā-pane := Rārangi hou.
}.

Tuhinga-Ipurangi ina-tae: ['kaiwhakahaere-wāhanga:'] mahia: { :kaiwhakahaere
	whaiaro tirohia-ngā-pane.
	ake kaiwhakahaere-wāhanga := kaiwhakahaere.
}.

Tuhinga-Ipurangi ina-tae: ['kaiwhakahaere-wāhanga'] mahia: { <- ake kaiwhakahaere-wāhanga.
}.

Tuhinga-Ipurangi ina-tae: ['tirohia-ngā-pane'] mahia: {
	ake kua-tukuna-ngā-pane pono: {
		tēnei-mahi hapa: ['Headers already sent to client.'].
	}.
}.

Tuhinga-Ipurangi ina-tae: ['tīmata-wāhanga'] mahia: {
	whaiaro tirohia-ngā-pane.
	>> tono-http := ake tono-http.
	>> id-wāhanga := tono-http cookie: ['xsid'].
	id-wāhanga Kore? teka: {
		(( Tauira-rapu hou: ['^[A-Za-z0-9]+\\z'], ōritenga: id-wāhanga ) = 0) pono: {
			id-wāhanga := Kore.
		}.
	}.
	id-wāhanga Kore? pono: {
		id-wāhanga := Pākoro token: 30.
		>> pane-wāhanga := Pane-HTTP hou
		kī: ['Set-Cookie'] uara: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ake haumaru tēnei: ['Secure'] tērā-rānei: ['']),
		SSITE: (ake pae-ōrite),
		XSID: id-wāhanga
		).
		ake ngā-pane tāpiri-muri: pane-wāhanga.
	}.
	ake raraunga-wāhanga := ake kaiwhakahaere-wāhanga mō: id-wāhanga, uta. <- ake raraunga-wāhanga. # reference
}.

Tuhinga-Ipurangi ina-tae: ['haere-ki:'] mahia: { :wāhitau
	whaiaro tirohia-ngā-pane.
	whaiaro whakawātea-pane.
	ake ngā-pane
	tāpiri-muri: (
		Pane-HTTP hou
		kī: ['Status'] uara: ['303 See Other']
	),
	tāpiri-muri: (
		Pane-HTTP hou
		kī: ['Location'] uara: wāhitau
	).
	whaiaro whakaputa: ['Redirect'].
}.

Tuhinga-Ipurangi ina-tae: ['whakangaro-wāhanga'] mahia: {
	whaiaro tirohia-ngā-pane.
	>> tono-http := ake tono-http.
	>> id-wāhanga := tono-http cookie: ['xsid'].
	id-wāhanga Kore? teka: {
		>> pane-wāhanga := Pane-HTTP hou.
		>> wā-pau := Wā hou tau-maramataka: 1970, hōputu: ['%a, %d %b %Y %H:%M:%S GMT'].
		pane-wāhanga kī: ['Set-Cookie'] uara: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: wā-pau,
			SEC: (ake haumaru tēnei: ['Secure'] tērā-rānei: ['']),
			SSITE: (ake pae-ōrite),
			XSID: id-wāhanga
		).
		ake kaiwhakahaere-wāhanga whakangaro.
		ake ngā-pane tāpiri-muri: pane-wāhanga.
	}.
}.


Tuhinga-Ipurangi ina-tae: ['tauira-whārangi:'] mahia: { :ara-kōnae <- Tauira-whārangi hou: (Kōnae hou: ara-kōnae, pānui).
}.

Tuhinga-Ipurangi ina-tae: ['whakaputa:momo:'] mahia: { :hua :momo
	ake kua-tukuna-ngā-pane teka: {
		ake raraunga-wāhanga Kore? teka: {
			ake kaiwhakahaere-wāhanga tiakina: ake raraunga-wāhanga.
		}.
		ake ngā-pane tāpiri-muri: (
			Pane-HTTP hou
			kī: ['Content-type'] uara: momo
		).
		ake ngā-pane ia: { :_ :pane
			Huaputa tuhi: pane.
		}.
		ake kua-tukuna-ngā-pane := Pono.
		Huaputa tuhi: ['\r\n'].
	}.
	Huaputa tuhi: hua.
}.

Tuhinga-Ipurangi ina-tae: ['whakaotia:momo:'] mahia: { :hua :momo
	ake kua-tukuna-ngā-pane teka: {
		ake raraunga-wāhanga Kore? teka: {
			ake kaiwhakahaere-wāhanga tiakina: ake raraunga-wāhanga.
		}.
		ake ngā-pane tāpiri-muri: (
			Pane-HTTP hou
			kī: ['Content-type'] uara: momo
		).
		ake ngā-pane tāpiri-muri: (
			Pane-HTTP hou
			kī: ['Content-Length'] uara: hua aho bytes
		).
		ake ngā-pane ia: { :_ :pane
			Huaputa tuhi: pane.
		}.
		ake kua-tukuna-ngā-pane := Pono.
		Huaputa tuhi: ['\r\n'].
	}.
	Huaputa tuhi: hua.
}.

Tuhinga-Ipurangi ina-tae: ['whakaputa:'] mahia: { :hua
	whaiaro whakaputa: hua momo: ['text/html; charset=utf-8'].
}.

Tuhinga-Ipurangi ina-tae: ['whakaotia:'] mahia: { :hua
	whaiaro whakaotia: hua momo: ['text/html; charset=utf-8'].
}.

Tuhinga-Ipurangi ina-tae: ['json:'] mahia: { :hua
	whaiaro whakaputa: ( JSON jsonify: hua ) momo: ['application/json'].
}.

Tuhinga-Ipurangi ina-tae: ['kāore-i-kitea:'] mahia: { :hua
	whaiaro whakawātea-pane pane: (
		Pane-HTTP hou kī: ['Status'] uara: ['404 Not Found']
	).
	whaiaro whakaputa: hua.
}.


# Interface

>> Wāhanga-tūhono := Ahanoa hou.

Wāhanga-tūhono ina-tae: ['hou'] mahia: { <- whaiaro hou whakarite mō: Kore.
}.

Wāhanga-tūhono ina-tae: ['mō:'] mahia: { :id
	ake id := id.
}.

Wāhanga-tūhono ina-tae: ['uta'] mahia: {
	tēnei-mahi hapa: ['Not implemented.'].
}.

Wāhanga-tūhono ina-tae: ['tiakina:'] mahia: {
	tēnei-mahi hapa: ['Not implemented.'].
}.

Wāhanga-tūhono ina-tae: ['whakangaro'] mahia: {
	tēnei-mahi hapa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Wāhanga-kōnae-poto := Wāhanga-tūhono hou.

Wāhanga-kōnae-poto ina-tae: ['whakarite'] mahia: {
	ake tīmatanga-ara := ['/tmp/sess-'].
}.

Wāhanga-kōnae-poto ina-tae: ['kuhimua-ara:'] mahia: { :aho-kuputuhi
	ake tīmatanga-ara := aho-kuputuhi.
}.

Wāhanga-kōnae-poto ina-tae: ['kōnae-wāhanga'] mahia: { <- ( Kōnae hou: ( ake tīmatanga-ara + ake id + ['.txt'] ) ).
}.

Wāhanga-kōnae-poto ina-tae: ['uta'] mahia: {
	>> kōnae-wāhanga := whaiaro kōnae-wāhanga.
	kōnae-wāhanga kei-te-noho teka: {
		kōnae-wāhanga tuhi: (Papakupu hou waehere).
	}. <- kōnae-wāhanga pānui ahanoa.
}.

Wāhanga-kōnae-poto ina-tae: ['tiakina:'] mahia: { :raraunga
	>> kōnae-wāhanga := whaiaro kōnae-wāhanga.
	kōnae-wāhanga kei-te-noho pono: {
		kōnae-wāhanga tuhi: raraunga waehere.
	}.
}.

Wāhanga-kōnae-poto ina-tae: ['whakangaro'] mahia: {
	>> kōnae-wāhanga := whaiaro kōnae-wāhanga.
	kōnae-wāhanga kei-te-noho pono: {
		kōnae-wāhanga muku.
	}.
}.


>> URL := Ahanoa hou.

URL ina-tae: ['whakarite'] mahia: {
	ake kawa := ['https://'].
	ake manaaki := ['localhost'].
	ake ara-kōnae := [''].
	ake ngā-tawhā-url := [''].
	ake hash := [''].
}.

URL ina-tae: ['hou'] mahia: { <- whaiaro hou whakarite.
}.

URL ina-tae: ['aho'] mahia: { <- (
	ake kawa +
	ake manaaki +
	ake ara-kōnae +
	ake ngā-tawhā-url +
	ake hash ).
}.

URL ina-tae: ['kawa:'] mahia: { :kawa
	((Rārangi hou ; ['http'] ; ['https']) kei-a-ia: kawa) pono: {
		ake kawa := kawa + ['://'].
	}, teka: {
		tēnei-mahi hapa: ['Invalid protocol'].
	}.
}.

URL ina-tae: ['manaaki:'] mahia: { :manaaki
	#todo validate according to rfc
	ake manaaki := manaaki.
}.

URL ina-tae: ['ara-kōnae:'] mahia: { :ara-kōnae
	ake ara-kōnae := ['/'] + ara-kōnae url-whakawaehere.
}.

URL ina-tae: ['ngā-tawhā-url:'] mahia: { :mahere
	>> ngā-tawhā-url := Rārangi hou.
	mahere ia: { :kī :uara
		ngā-tawhā-url tāpiri-muri: kī aho url-whakawaehere + ['='] + uara aho url-whakawaehere.
	}.
	ake ngā-tawhā-url := ['?'] + ( ngā-tawhā-url honoa: ['&'] ).
}.

URL ina-tae: ['tāmi:'] mahia: { :hash
	ake hash := ['#'] + hash url-whakawaehere.
}.

