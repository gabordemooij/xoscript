>> Īmēra := Ahanoa hou.

Īmēra ina-tae: ['whakarite'] mahia: {
	ake ngā-kaiwhiwhi := Rārangi hou.
	ake cc := Rārangi hou.
	ake bcc := Rārangi hou.
	ake kaituku := Kore.
	ake ingoa-kaituku := Kore.
	ake kaupapa := Kore.
	ake tinana := Kore.
}.

Īmēra ina-tae: ['hou'] mahia: { <- whaiaro hou whakarite.
}.

Īmēra ina-tae: ['ki:'] mahia: { :whakarārangi
	ake ngā-kaiwhiwhi := whakarārangi.
}.
 
Īmēra ina-tae: ['cc:'] mahia: { :whakarārangi
	ake cc := whakarārangi.
}.

Īmēra ina-tae: ['bcc:'] mahia: { :whakarārangi
	ake bcc := whakarārangi.
}.

Īmēra ina-tae: ['kaupapa:'] mahia: { :kaupapa
	ake kaupapa := kaupapa.
}.

Īmēra ina-tae: ['kaituku:ingoa:'] mahia: { :kaituku :ingoa
	ake kaituku := kaituku.
	ake ingoa-kaituku := ingoa.
}.

Īmēra ina-tae: ['tinana:'] mahia: { :tinana
	ake tinana := tinana.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Īmēra ina-tae: ['pane:'] mahia: { :rārangi <- rārangi whakakapihia: ['\r'] me: [''], whakakapihia: ['\n'] me: [''].
}.

Īmēra ina-tae: ['tukuna'] mahia: {
	>> f := Kōnae tempwrite: whaiaro waihangatia.
	Papatono pūnaha: ['sendmail -t < '] + f ara-kōnae, rārangi-hou.
}.

Īmēra ina-tae: ['waihangatia'] mahia: {
	>> wehenga-rārangi := ['\r\n'].
	>> aho-kuputuhi := [''].
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['From: '] + ake ingoa-kaituku + [' <'] + ( ake kaituku ) + ['>']) + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['To: '] + ( ake ngā-kaiwhiwhi honoa: [','] )) + wehenga-rārangi.
	ake cc tatau pono: {
		aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Cc: '] + ( ake cc honoa: [','] )) + wehenga-rārangi.
	}.
	ake bcc tatau pono: {
		aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Bcc: '] + ( ake bcc honoa: [','] )) + wehenga-rārangi.
	}.
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Subject: '] + ake kaupapa) + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ake tinana.
	aho-kuputuhi tāpiri-muri: wehenga-rārangi. <- aho-kuputuhi.
}.

>> Īmēra-HTML := Īmēra hou.

Īmēra-HTML ina-tae: ['whakarite'] mahia: {
	whaiaro whakarite.
	ake ngā-tāpiri := Rārangi hou.
	ake paenga := Pākoro token: 40.
}.

Īmēra-HTML ina-tae: ['tāpiri-kōnae:'] mahia: { :kōnae-wāhanga
	>> id := ake ngā-tāpiri tatau.
	>> blob := kōnae-wāhanga blob.
	ake ngā-tāpiri tāpiri-muri: (
		Papakupu hou
			kōnae-wāhanga: kōnae-wāhanga ara-kōnae,
			mime: ['image/'] + (Server mimetype: kōnae-wāhanga ara-kōnae),
			raraunga: blob base64-whakawaehere
	).
	blob wewete. <- ['cid:attachment'] + id.
}.

Īmēra-HTML ina-tae: ['waihangatia'] mahia: {
	>> wehenga-rārangi := ['\r\n'].
	>> aho-kuputuhi := [''].
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['From: '] + ake ingoa-kaituku + [' <'] + ( ake kaituku ) + ['>']) + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['To: '] + ( ake ngā-kaiwhiwhi honoa: [','] )) + wehenga-rārangi.
	ake cc tatau pono: {
		aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Cc: '] + ( ake cc honoa: [','] )) + wehenga-rārangi.
	}.
	ake bcc tatau pono: {
		aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Bcc: '] + ( ake bcc honoa: [','] )) + wehenga-rārangi.
	}.
	aho-kuputuhi tāpiri-muri: (whaiaro pane: ['Subject: '] + ake kaupapa) + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ['MIME-Version: 1.0'] + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ['Content-Type: multipart/related; boundary="'] + ake paenga + ['"; type=text/html'] + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ['--'] + ake paenga + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ['Content-Type: text/html; charset=UTF-8'] + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ['Content-Transfer-Encoding: 7bit'] + wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: wehenga-rārangi.
	aho-kuputuhi tāpiri-muri: ake tinana.
	aho-kuputuhi tāpiri-muri: wehenga-rārangi.
	ake ngā-tāpiri ia: { :id :mōhiohio
		>> blob := mōhiohio raraunga.
		aho-kuputuhi tāpiri-muri: ['--'] + ake paenga + wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: ['Content-Type: '] + mōhiohio mime + wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: ['Content-Transfer-Encoding: base64'] + wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: ['Content-ID: <attachment'] + id + ['>'] + wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: ['Content-Disposition: inline; filename="'] + mōhiohio kōnae-wāhanga + ['"'] + wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: wehenga-rārangi.
		>> te-mōrahi := 76.
		>> roa-kuputuhi := blob roa.
		>> ngā-wāhi-iti := (roa-kuputuhi / te-mōrahi) whakaawhiwhi-ake.
		{ :i
			>> wāhi-iti := blob tārua mai: i * te-mōrahi roa: te-mōrahi.
			aho-kuputuhi tāpiri-muri: wāhi-iti + wehenga-rārangi.
		} * ngā-wāhi-iti.
		aho-kuputuhi tāpiri-muri: wehenga-rārangi.
		aho-kuputuhi tāpiri-muri: wehenga-rārangi.
	}.
	aho-kuputuhi tāpiri-muri: ['--'] + ake paenga + ['--'] + wehenga-rārangi. <- aho-kuputuhi.
}.
