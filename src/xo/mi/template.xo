
# ~ Simple template engine ~

>> Tauira-whārangi := Ahanoa hou.

Tauira-whārangi ina-tae: ['hou'] mahia: { <- whaiaro hou ihirangi: [''].
}.

Tauira-whārangi ina-tae: ['ihirangi:'] mahia: { :ihirangi
	ake ihirangi := ihirangi. 
}.

Tauira-whārangi ina-tae: ['hou:'] mahia: { :ihirangi <- whaiaro hou ihirangi: ihirangi.
}.

Tauira-whārangi ina-tae: ['tapahia:'] mahia: { :tohu
	>> tohu-tīmatanga := (['<!-- cut:%id% -->'] %id%: tohu).
	>> tohu-mutunga := (['<!-- /cut:%id% -->'] %id%: tohu).
	>> ngā-wāhanga-iti := ake ihirangi wehewehe: tohu-tīmatanga.
	>> kuhimua := ngā-wāhanga-iti tuatahi.
	>> ngā-wāhanga-iti2 := ngā-wāhanga-iti whakamutunga wehewehe: tohu-mutunga.
	>> kumuri := ngā-wāhanga-iti2 whakamutunga.
	>> wāhanga-iti := ngā-wāhanga-iti2 tuatahi.
	>> toenga := kuhimua + kumuri.
	ake ihirangi := toenga. <- Tauira-whārangi hou: wāhanga-iti.
	
}.

Tauira-whārangi ina-tae: ['tārua'] mahia: { <- whaiaro hou: whaiaro aho tārua.
}.
	
Tauira-whārangi ina-tae: ['whakapiri:kei:'] mahia: { :kongakonga :id
	>> tohu-whakapiri := (['<!-- paste:%id% -->'] %id%: id).
	ake ihirangi whakakapihia: tohu-whakapiri me: ( kongakonga aho + tohu-whakapiri ).
}.

Tauira-whārangi ina-tae: ['tautuhi:uara:'] mahia: { :tūranga :uara
	ake ihirangi whakakapihia: ['<!-- slot:'] + tūranga + [' -->'] me: ( Server html-whakawaehere: uara ).
}.

Tauira-whārangi ina-tae: ['tautuhi:html:'] mahia: { :tūranga :html
	ake ihirangi whakakapihia: ['<!-- slot:'] + tūranga + [' -->'] me: html.
}.

Tauira-whārangi ina-tae: ['whakautu:a:'] mahia: { :tūranga :uara
	whaiaro tautuhi: (tūranga mai: 0 roa: (tūranga roa - 1)) uara: uara.
}.

Tauira-whārangi ina-tae: ['nl2br'] mahia: {
	ake ihirangi whakakapihia: ['\n'] me: ['<br>'].
}.

Tauira-whārangi ina-tae: ['whakanikoniko'] mahia: {
	ake ihirangi :=
		Tauira-rapu
		hou: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ōritenga: ake ihirangi
		mahia: { <- ['']. }.
}.

Tauira-whārangi ina-tae: ['whakanikoniko-tapahi'] mahia: {
	>> ngā-tūemi := Rārangi hou.
	Tauira-rapu
	hou: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ōritenga: ake ihirangi
	mahia: { :_ :wāhanga-iti
		ngā-tūemi tāpiri-muri: wāhanga-iti ? 1.
	}.
	ngā-tūemi ia: { :_ :id
		ake ihirangi :=
			Tauira-rapu hou: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ōritenga: ake ihirangi
			mahia: { <- ['']. }.
	 }.
}.

Tauira-whārangi ina-tae: ['whakanikoniko-mokowā'] mahia: {
	ake ihirangi :=
		Tauira-rapu
		hou: ['\\s*\\n'],
		ōritenga: ake ihirangi
		mahia: { <- ['\n']. }.
	ake ihirangi :=
		Tauira-rapu
		hou: ['\\n[\\s\\t]+'],
		ōritenga: ake ihirangi
		mahia: { <- ['\n']. }.
}.

Tauira-whārangi ina-tae: ['whakanikoniko-katoa'] mahia: {
	whaiaro whakanikoniko.
	whaiaro whakanikoniko-tapahi.
	whaiaro whakanikoniko-mokowā.
}.

Tauira-whārangi ina-tae: ['aho'] mahia: { <- ake ihirangi.
}.
