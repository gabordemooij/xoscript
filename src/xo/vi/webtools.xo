Yêu-cầu-HTTP khi: ['HTTP-tiêu-đề:'] làm: { :khóa-tiêu-đề <- Chương-trình thiết-lập: khóa-tiêu-đề.
}.

>> Tiêu-đề-HTTP := Đối-tượng mới.

Tiêu-đề-HTTP khi: ['mới'] làm: { <- bản-thân mới khởi-tạo.
}.

Tiêu-đề-HTTP khi: ['khởi-tạo'] làm: {
	riêng khóa-tiêu-đề := Rỗng.
	riêng giá-trị := Rỗng.
}.

Tiêu-đề-HTTP khi: ['khóa-tiêu-đề:giá-trị:'] làm: { :khóa-tiêu-đề :giá-trị
	riêng khóa-tiêu-đề := khóa-tiêu-đề.
	riêng giá-trị := giá-trị.
}.

Tiêu-đề-HTTP khi: ['khóa-tiêu-đề'] làm: { <- riêng khóa-tiêu-đề.
}.

Tiêu-đề-HTTP khi: ['giá-trị'] làm: { <- riêng giá-trị.
}.


Tiêu-đề-HTTP khi: ['chuỗi'] làm: {
	>> dòng := riêng khóa-tiêu-đề + [': '] + riêng giá-trị.
	dòng thay: ['\r'] bằng: [''], thay: ['\n'] bằng: ['']. <- dòng + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Tài-liệu-Web := Đối-tượng mới.

Tài-liệu-Web khi: ['mới'] làm: { <- bản-thân mới khởi-tạo.
}.

Tài-liệu-Web khi: ['khởi-tạo'] làm: {
	riêng các-tiêu-đề := Danh-sách mới.
	riêng mã-phiên := Rỗng.
	riêng trình-quản-lý-phiên := Phiên-tệp-tạm mới.
	riêng dữ-liệu-phiên := Rỗng.
	riêng an-toàn := Đúng.
	riêng cùng-trang := ['Strict'].
	riêng đã-gửi-tiêu-đề := Sai.
	riêng yêu-cầu-http := Yêu-cầu-HTTP mới.
}.

Tài-liệu-Web khi: ['yêu-cầu-http:'] làm: { :yêu-cầu-http
	riêng yêu-cầu-http := yêu-cầu-http.
}. 

Tài-liệu-Web khi: ['cookie-phiên-an-toàn:'] làm: { :an-toàn
	bản-thân kiểm-tra-tiêu-đề.
	riêng an-toàn := an-toàn.
}.

Tài-liệu-Web khi: ['cookie-phiên-cùng-trang:'] làm: { :giá-trị
	bản-thân kiểm-tra-tiêu-đề.
	>> tùy-chọn := Danh-sách mới 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	tùy-chọn có: giá-trị, sai: {
		tác-vụ-này lỗi: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	riêng cùng-trang := giá-trị.
}.

Tài-liệu-Web khi: ['tiêu-đề:'] làm: { :tiêu-đề
	bản-thân kiểm-tra-tiêu-đề.
	riêng các-tiêu-đề thêm-cuối: tiêu-đề.
}.

Tài-liệu-Web khi: ['xóa-tiêu-đề'] làm: {
	bản-thân kiểm-tra-tiêu-đề.
	riêng các-tiêu-đề := Danh-sách mới.
}.

Tài-liệu-Web khi: ['trình-quản-lý-phiên:'] làm: { :trình-quản-lý
	bản-thân kiểm-tra-tiêu-đề.
	riêng trình-quản-lý-phiên := trình-quản-lý.
}.

Tài-liệu-Web khi: ['trình-quản-lý-phiên'] làm: { <- riêng trình-quản-lý-phiên.
}.

Tài-liệu-Web khi: ['kiểm-tra-tiêu-đề'] làm: {
	riêng đã-gửi-tiêu-đề đúng: {
		tác-vụ-này lỗi: ['Headers already sent to client.'].
	}.
}.

Tài-liệu-Web khi: ['bắt-đầu-phiên'] làm: {
	bản-thân kiểm-tra-tiêu-đề.
	>> yêu-cầu-http := riêng yêu-cầu-http.
	>> mã-phiên := yêu-cầu-http cookie: ['xsid'].
	mã-phiên Rỗng? sai: {
		(( Mẫu mới: ['^[A-Za-z0-9]+\\z'], khớp: mã-phiên ) = 0) đúng: {
			mã-phiên := Rỗng.
		}.
	}.
	mã-phiên Rỗng? đúng: {
		mã-phiên := Két mã-thông-báo: 30.
		>> tiêu-đề-phiên := Tiêu-đề-HTTP mới
		khóa-tiêu-đề: ['Set-Cookie'] giá-trị: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (riêng an-toàn hoặc-là: ['Secure'] hay: ['']),
		SSITE: (riêng cùng-trang),
		XSID: mã-phiên
		).
		riêng các-tiêu-đề thêm-cuối: tiêu-đề-phiên.
	}.
	riêng dữ-liệu-phiên := riêng trình-quản-lý-phiên cho: mã-phiên, tải. <- riêng dữ-liệu-phiên. # reference
}.

Tài-liệu-Web khi: ['đi-đến:'] làm: { :địa-chỉ
	bản-thân kiểm-tra-tiêu-đề.
	bản-thân xóa-tiêu-đề.
	riêng các-tiêu-đề
	thêm-cuối: (
		Tiêu-đề-HTTP mới
		khóa-tiêu-đề: ['Status'] giá-trị: ['303 See Other']
	),
	thêm-cuối: (
		Tiêu-đề-HTTP mới
		khóa-tiêu-đề: ['Location'] giá-trị: địa-chỉ
	).
	bản-thân xuất: ['Redirect'].
}.

Tài-liệu-Web khi: ['hủy-phiên'] làm: {
	bản-thân kiểm-tra-tiêu-đề.
	>> yêu-cầu-http := riêng yêu-cầu-http.
	>> mã-phiên := yêu-cầu-http cookie: ['xsid'].
	mã-phiên Rỗng? sai: {
		>> tiêu-đề-phiên := Tiêu-đề-HTTP mới.
		>> thời-điểm := Thời-điểm mới năm: 1970, định-dạng: ['%a, %d %b %Y %H:%M:%S GMT'].
		tiêu-đề-phiên khóa-tiêu-đề: ['Set-Cookie'] giá-trị: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: thời-điểm,
			SEC: (riêng an-toàn hoặc-là: ['Secure'] hay: ['']),
			SSITE: (riêng cùng-trang),
			XSID: mã-phiên
		).
		riêng trình-quản-lý-phiên hủy.
		riêng các-tiêu-đề thêm-cuối: tiêu-đề-phiên.
	}.
}.


Tài-liệu-Web khi: ['mẫu-trang:'] làm: { :đường-dẫn <- Mẫu-trang mới: (Tệp mới: đường-dẫn, đọc).
}.

Tài-liệu-Web khi: ['xuất:kiểu:'] làm: { :kết-quả :kiểu
	riêng đã-gửi-tiêu-đề sai: {
		riêng dữ-liệu-phiên Rỗng? sai: {
			riêng trình-quản-lý-phiên lưu: riêng dữ-liệu-phiên.
		}.
		riêng các-tiêu-đề thêm-cuối: (
			Tiêu-đề-HTTP mới
			khóa-tiêu-đề: ['Content-type'] giá-trị: kiểu
		).
		riêng các-tiêu-đề mỗi: { :_ :tiêu-đề
			Xuất ghi: tiêu-đề.
		}.
		riêng đã-gửi-tiêu-đề := Đúng.
		Xuất ghi: ['\r\n'].
	}.
	Xuất ghi: kết-quả.
}.

Tài-liệu-Web khi: ['hoàn-tất:kiểu:'] làm: { :kết-quả :kiểu
	riêng đã-gửi-tiêu-đề sai: {
		riêng dữ-liệu-phiên Rỗng? sai: {
			riêng trình-quản-lý-phiên lưu: riêng dữ-liệu-phiên.
		}.
		riêng các-tiêu-đề thêm-cuối: (
			Tiêu-đề-HTTP mới
			khóa-tiêu-đề: ['Content-type'] giá-trị: kiểu
		).
		riêng các-tiêu-đề thêm-cuối: (
			Tiêu-đề-HTTP mới
			khóa-tiêu-đề: ['Content-Length'] giá-trị: kết-quả chuỗi bytes
		).
		riêng các-tiêu-đề mỗi: { :_ :tiêu-đề
			Xuất ghi: tiêu-đề.
		}.
		riêng đã-gửi-tiêu-đề := Đúng.
		Xuất ghi: ['\r\n'].
	}.
	Xuất ghi: kết-quả.
}.

Tài-liệu-Web khi: ['xuất:'] làm: { :kết-quả
	bản-thân xuất: kết-quả kiểu: ['text/html; charset=utf-8'].
}.

Tài-liệu-Web khi: ['hoàn-tất:'] làm: { :kết-quả
	bản-thân hoàn-tất: kết-quả kiểu: ['text/html; charset=utf-8'].
}.

Tài-liệu-Web khi: ['json:'] làm: { :kết-quả
	bản-thân xuất: ( JSON jsonify: kết-quả ) kiểu: ['application/json'].
}.

Tài-liệu-Web khi: ['không-tìm-thấy:'] làm: { :kết-quả
	bản-thân xóa-tiêu-đề tiêu-đề: (
		Tiêu-đề-HTTP mới khóa-tiêu-đề: ['Status'] giá-trị: ['404 Not Found']
	).
	bản-thân xuất: kết-quả.
}.


# Interface

>> Phiên := Đối-tượng mới.

Phiên khi: ['mới'] làm: { <- bản-thân mới khởi-tạo cho: Rỗng.
}.

Phiên khi: ['cho:'] làm: { :id
	riêng id := id.
}.

Phiên khi: ['tải'] làm: {
	tác-vụ-này lỗi: ['Not implemented.'].
}.

Phiên khi: ['lưu:'] làm: {
	tác-vụ-này lỗi: ['Not implemented.'].
}.

Phiên khi: ['hủy'] làm: {
	tác-vụ-này lỗi: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Phiên-tệp-tạm := Phiên mới.

Phiên-tệp-tạm khi: ['khởi-tạo'] làm: {
	riêng đầu-đường-dẫn := ['/tmp/sess-'].
}.

Phiên-tệp-tạm khi: ['tiền-tố-đường-dẫn:'] làm: { :chuỗi-văn-bản
	riêng đầu-đường-dẫn := chuỗi-văn-bản.
}.

Phiên-tệp-tạm khi: ['tệp-phiên'] làm: { <- ( Tệp mới: ( riêng đầu-đường-dẫn + riêng id + ['.txt'] ) ).
}.

Phiên-tệp-tạm khi: ['tải'] làm: {
	>> tệp-phiên := bản-thân tệp-phiên.
	tệp-phiên tồn-tại sai: {
		tệp-phiên ghi: (Từ-điển mới mã).
	}. <- tệp-phiên đọc đối-tượng.
}.

Phiên-tệp-tạm khi: ['lưu:'] làm: { :dữ-liệu
	>> tệp-phiên := bản-thân tệp-phiên.
	tệp-phiên tồn-tại đúng: {
		tệp-phiên ghi: dữ-liệu mã.
	}.
}.

Phiên-tệp-tạm khi: ['hủy'] làm: {
	>> tệp-phiên := bản-thân tệp-phiên.
	tệp-phiên tồn-tại đúng: {
		tệp-phiên xóa.
	}.
}.


>> URL := Đối-tượng mới.

URL khi: ['khởi-tạo'] làm: {
	riêng tên-giao-thức := ['https://'].
	riêng máy-trạm := ['localhost'].
	riêng đường-dẫn := [''].
	riêng tham-số-url := [''].
	riêng hash := [''].
}.

URL khi: ['mới'] làm: { <- bản-thân mới khởi-tạo.
}.

URL khi: ['chuỗi'] làm: { <- (
	riêng tên-giao-thức +
	riêng máy-trạm +
	riêng đường-dẫn +
	riêng tham-số-url +
	riêng hash ).
}.

URL khi: ['tên-giao-thức:'] làm: { :tên-giao-thức
	((Danh-sách mới ; ['http'] ; ['https']) có: tên-giao-thức) đúng: {
		riêng tên-giao-thức := tên-giao-thức + ['://'].
	}, sai: {
		tác-vụ-này lỗi: ['Invalid protocol'].
	}.
}.

URL khi: ['máy-trạm:'] làm: { :máy-trạm
	#todo validate according to rfc
	riêng máy-trạm := máy-trạm.
}.

URL khi: ['đường-dẫn:'] làm: { :đường-dẫn
	riêng đường-dẫn := ['/'] + đường-dẫn url-mã-hóa.
}.

URL khi: ['tham-số-url:'] làm: { :ánh-xạ
	>> tham-số-url := Danh-sách mới.
	ánh-xạ mỗi: { :khóa-tiêu-đề :giá-trị
		tham-số-url thêm-cuối: khóa-tiêu-đề chuỗi url-mã-hóa + ['='] + giá-trị chuỗi url-mã-hóa.
	}.
	riêng tham-số-url := ['?'] + ( tham-số-url nối: ['&'] ).
}.

URL khi: ['băm:'] làm: { :hash
	riêng hash := ['#'] + hash url-mã-hóa.
}.

