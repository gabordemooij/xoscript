
# ~ Simple template engine ~

>> Mẫu-trang := Đối-tượng mới.

Mẫu-trang khi: ['mới'] làm: { <- bản-thân mới nội-dung: [''].
}.

Mẫu-trang khi: ['nội-dung:'] làm: { :nội-dung
	riêng nội-dung := nội-dung. 
}.

Mẫu-trang khi: ['mới:'] làm: { :nội-dung <- bản-thân mới nội-dung: nội-dung.
}.

Mẫu-trang khi: ['cắt:'] làm: { :dấu
	>> dấu-bắt-đầu := (['<!-- cut:%id% -->'] %id%: dấu).
	>> dấu-kết-thúc := (['<!-- /cut:%id% -->'] %id%: dấu).
	>> các-phần := riêng nội-dung tách: dấu-bắt-đầu.
	>> tiền-tố := các-phần đầu.
	>> các-phần2 := các-phần cuối tách: dấu-kết-thúc.
	>> hậu-tố := các-phần2 cuối.
	>> phần := các-phần2 đầu.
	>> phần-còn-lại := tiền-tố + hậu-tố.
	riêng nội-dung := phần-còn-lại. <- Mẫu-trang mới: phần.
	
}.

Mẫu-trang khi: ['sao-chép'] làm: { <- bản-thân mới: bản-thân chuỗi sao-chép.
}.
	
Mẫu-trang khi: ['dán:tại:'] làm: { :trích-đoạn :id
	>> dấu-dán := (['<!-- paste:%id% -->'] %id%: id).
	riêng nội-dung thay: dấu-dán bằng: ( trích-đoạn chuỗi + dấu-dán ).
}.

Mẫu-trang khi: ['đặt:giá-trị:'] làm: { :khe :giá-trị
	riêng nội-dung thay: ['<!-- slot:'] + khe + [' -->'] bằng: ( Server html-mã-hóa: giá-trị ).
}.

Mẫu-trang khi: ['đặt:html:'] làm: { :khe :html
	riêng nội-dung thay: ['<!-- slot:'] + khe + [' -->'] bằng: html.
}.

Mẫu-trang khi: ['đáp:và:'] làm: { :khe :giá-trị
	bản-thân đặt: (khe từ: 0 độ-dài: (khe độ-dài - 1)) giá-trị: giá-trị.
}.

Mẫu-trang khi: ['nl2br'] làm: {
	riêng nội-dung thay: ['\n'] bằng: ['<br>'].
}.

Mẫu-trang khi: ['tinh-chỉnh'] làm: {
	riêng nội-dung :=
		Mẫu
		mới: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		khớp: riêng nội-dung
		làm: { <- ['']. }.
}.

Mẫu-trang khi: ['tinh-chỉnh-đoạn-cắt'] làm: {
	>> các-mục := Danh-sách mới.
	Mẫu
	mới: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	khớp: riêng nội-dung
	làm: { :_ :phần
		các-mục thêm-cuối: phần ? 1.
	}.
	các-mục mỗi: { :_ :id
		riêng nội-dung :=
			Mẫu mới: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			khớp: riêng nội-dung
			làm: { <- ['']. }.
	 }.
}.

Mẫu-trang khi: ['tinh-chỉnh-khoảng-trắng'] làm: {
	riêng nội-dung :=
		Mẫu
		mới: ['\\s*\\n'],
		khớp: riêng nội-dung
		làm: { <- ['\n']. }.
	riêng nội-dung :=
		Mẫu
		mới: ['\\n[\\s\\t]+'],
		khớp: riêng nội-dung
		làm: { <- ['\n']. }.
}.

Mẫu-trang khi: ['tinh-chỉnh-tất-cả'] làm: {
	bản-thân tinh-chỉnh.
	bản-thân tinh-chỉnh-đoạn-cắt.
	bản-thân tinh-chỉnh-khoảng-trắng.
}.

Mẫu-trang khi: ['chuỗi'] làm: { <- riêng nội-dung.
}.
