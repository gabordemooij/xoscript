
# ~ Simple template engine ~

>> Template := Đối-tượng mới.

Template khi: ['mới'] làm: { <- bản-thân mới content: [''].
}.

Template khi: ['content:'] làm: { :content
	riêng content := content. 
}.

Template khi: ['mới:'] làm: { :content <- bản-thân mới content: content.
}.

Template khi: ['cut:'] làm: { :marker
	>> startmarker := (['<!-- cut:%id% -->'] %id%: marker).
	>> endmarker := (['<!-- /cut:%id% -->'] %id%: marker).
	>> parts := riêng content tách: startmarker.
	>> prefix := parts đầu.
	>> parts2 := parts cuối tách: endmarker.
	>> suffix := parts2 cuối.
	>> part := parts2 đầu.
	>> rest := prefix + suffix.
	riêng content := rest. <- Template mới: part.
	
}.

Template khi: ['sao-chép'] làm: { <- bản-thân mới: bản-thân chuỗi sao-chép.
}.
	
Template khi: ['paste:at:'] làm: { :snippet :id
	>> pastemarker := (['<!-- paste:%id% -->'] %id%: id).
	riêng content thay: pastemarker bằng: ( snippet chuỗi + pastemarker ).
}.

Template khi: ['đặt:giá-trị:'] làm: { :slot :value
	riêng content thay: ['<!-- slot:'] + slot + [' -->'] bằng: ( Server html-mã-hóa: value ).
}.

Template khi: ['set:html:'] làm: { :slot :html
	riêng content thay: ['<!-- slot:'] + slot + [' -->'] bằng: html.
}.

Template khi: ['đáp:và:'] làm: { :slot :value
	bản-thân đặt: (slot từ: 0 độ-dài: (slot độ-dài - 1)) giá-trị: value.
}.

Template khi: ['nl2br'] làm: {
	riêng content thay: ['\n'] bằng: ['<br>'].
}.

Template khi: ['clean'] làm: {
	riêng content :=
		Mẫu
		mới: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		khớp: riêng content
		làm: { <- ['']. }.
}.

Template khi: ['clean-cuts'] làm: {
	>> items := Danh-sách mới.
	Mẫu
	mới: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	khớp: riêng content
	làm: { :_ :part
		items thêm-cuối: part ? 1.
	}.
	items mỗi: { :_ :id
		riêng content :=
			Mẫu mới: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			khớp: riêng content
			làm: { <- ['']. }.
	 }.
}.

Template khi: ['clean-space'] làm: {
	riêng content :=
		Mẫu
		mới: ['\\s*\\n'],
		khớp: riêng content
		làm: { <- ['\n']. }.
	riêng content :=
		Mẫu
		mới: ['\\n[\\s\\t]+'],
		khớp: riêng content
		làm: { <- ['\n']. }.
}.

Template khi: ['clean-all'] làm: {
	bản-thân clean.
	bản-thân clean-cuts.
	bản-thân clean-space.
}.

Template khi: ['chuỗi'] làm: { <- riêng content.
}.
