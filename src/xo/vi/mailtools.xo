>> Thư-điện-tử := Đối-tượng mới.

Thư-điện-tử khi: ['khởi-tạo'] làm: {
	riêng người-nhận := Danh-sách mới.
	riêng cc := Danh-sách mới.
	riêng bcc := Danh-sách mới.
	riêng người-gửi := Rỗng.
	riêng tên-người-gửi := Rỗng.
	riêng chủ-đề := Rỗng.
	riêng thân-thư := Rỗng.
}.

Thư-điện-tử khi: ['mới'] làm: { <- bản-thân mới khởi-tạo.
}.

Thư-điện-tử khi: ['đến:'] làm: { :liệt-kê
	riêng người-nhận := liệt-kê.
}.
 
Thư-điện-tử khi: ['cc:'] làm: { :liệt-kê
	riêng cc := liệt-kê.
}.

Thư-điện-tử khi: ['bcc:'] làm: { :liệt-kê
	riêng bcc := liệt-kê.
}.

Thư-điện-tử khi: ['chủ-đề:'] làm: { :chủ-đề
	riêng chủ-đề := chủ-đề.
}.

Thư-điện-tử khi: ['người-gửi:tên:'] làm: { :người-gửi :tên
	riêng người-gửi := người-gửi.
	riêng tên-người-gửi := tên.
}.

Thư-điện-tử khi: ['thân-thư:'] làm: { :thân-thư
	riêng thân-thư := thân-thư.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Thư-điện-tử khi: ['tiêu-đề:'] làm: { :dòng <- dòng thay: ['\r'] bằng: [''], thay: ['\n'] bằng: [''].
}.

Thư-điện-tử khi: ['gửi'] làm: {
	>> f := Tệp tempwrite: bản-thân tạo-ra.
	Chương-trình hệ-thống: ['sendmail -t < '] + f đường-dẫn, xuống-dòng.
}.

Thư-điện-tử khi: ['tạo-ra'] làm: {
	>> ngắt-dòng := ['\r\n'].
	>> chuỗi-văn-bản := [''].
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['From: '] + riêng tên-người-gửi + [' <'] + ( riêng người-gửi ) + ['>']) + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['To: '] + ( riêng người-nhận nối: [','] )) + ngắt-dòng.
	riêng cc đếm đúng: {
		chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Cc: '] + ( riêng cc nối: [','] )) + ngắt-dòng.
	}.
	riêng bcc đếm đúng: {
		chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Bcc: '] + ( riêng bcc nối: [','] )) + ngắt-dòng.
	}.
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Subject: '] + riêng chủ-đề) + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: riêng thân-thư.
	chuỗi-văn-bản thêm-cuối: ngắt-dòng. <- chuỗi-văn-bản.
}.

>> Thư-HTML := Thư-điện-tử mới.

Thư-HTML khi: ['khởi-tạo'] làm: {
	bản-thân khởi-tạo.
	riêng tệp-đính-kèm := Danh-sách mới.
	riêng ranh-giới := Két mã-thông-báo: 40.
}.

Thư-HTML khi: ['đính-kèm:'] làm: { :tệp-phiên
	>> id := riêng tệp-đính-kèm đếm.
	>> blob := tệp-phiên blob.
	riêng tệp-đính-kèm thêm-cuối: (
		Từ-điển mới
			tệp-phiên: tệp-phiên đường-dẫn,
			mime: ['image/'] + (Server mimetype: tệp-phiên đường-dẫn),
			dữ-liệu: blob base64-mã-hóa
	).
	blob giải-phóng. <- ['cid:attachment'] + id.
}.

Thư-HTML khi: ['tạo-ra'] làm: {
	>> ngắt-dòng := ['\r\n'].
	>> chuỗi-văn-bản := [''].
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['From: '] + riêng tên-người-gửi + [' <'] + ( riêng người-gửi ) + ['>']) + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['To: '] + ( riêng người-nhận nối: [','] )) + ngắt-dòng.
	riêng cc đếm đúng: {
		chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Cc: '] + ( riêng cc nối: [','] )) + ngắt-dòng.
	}.
	riêng bcc đếm đúng: {
		chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Bcc: '] + ( riêng bcc nối: [','] )) + ngắt-dòng.
	}.
	chuỗi-văn-bản thêm-cuối: (bản-thân tiêu-đề: ['Subject: '] + riêng chủ-đề) + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ['MIME-Version: 1.0'] + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ['Content-Type: multipart/related; boundary="'] + riêng ranh-giới + ['"; type=text/html'] + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ['--'] + riêng ranh-giới + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ['Content-Type: text/html; charset=UTF-8'] + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ['Content-Transfer-Encoding: 7bit'] + ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: ngắt-dòng.
	chuỗi-văn-bản thêm-cuối: riêng thân-thư.
	chuỗi-văn-bản thêm-cuối: ngắt-dòng.
	riêng tệp-đính-kèm mỗi: { :id :thông-tin
		>> blob := thông-tin dữ-liệu.
		chuỗi-văn-bản thêm-cuối: ['--'] + riêng ranh-giới + ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ['Content-Type: '] + thông-tin mime + ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ['Content-Transfer-Encoding: base64'] + ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ['Content-ID: <attachment'] + id + ['>'] + ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ['Content-Disposition: inline; filename="'] + thông-tin tệp-phiên + ['"'] + ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ngắt-dòng.
		>> tối-đa := 76.
		>> độ-dài-văn-bản := blob độ-dài.
		>> các-khúc := (độ-dài-văn-bản / tối-đa) làm-tròn-lên.
		{ :i
			>> khúc := blob sao-chép từ: i * tối-đa độ-dài: tối-đa.
			chuỗi-văn-bản thêm-cuối: khúc + ngắt-dòng.
		} * các-khúc.
		chuỗi-văn-bản thêm-cuối: ngắt-dòng.
		chuỗi-văn-bản thêm-cuối: ngắt-dòng.
	}.
	chuỗi-văn-bản thêm-cuối: ['--'] + riêng ranh-giới + ['--'] + ngắt-dòng. <- chuỗi-văn-bản.
}.
