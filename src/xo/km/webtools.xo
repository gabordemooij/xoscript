HTTP-សំណើ ពេលទទួល: ['HTTP-ក្បាល:'] ធ្វើ: { :កូនសោ <- កម្មវិធី ការកំណត់: កូនសោ.
}.

>> ក្បាល-HTTP := វត្ថុ ថ្មី.

ក្បាល-HTTP ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី រៀបចំ.
}.

ក្បាល-HTTP ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ផ្ទាល់ កូនសោ := ទទេ.
	ផ្ទាល់ តម្លៃ := ទទេ.
}.

ក្បាល-HTTP ពេលទទួល: ['កូនសោ:តម្លៃ:'] ធ្វើ: { :កូនសោ :តម្លៃ
	ផ្ទាល់ កូនសោ := កូនសោ.
	ផ្ទាល់ តម្លៃ := តម្លៃ.
}.

ក្បាល-HTTP ពេលទទួល: ['កូនសោ'] ធ្វើ: { <- ផ្ទាល់ កូនសោ.
}.

ក្បាល-HTTP ពេលទទួល: ['តម្លៃ'] ធ្វើ: { <- ផ្ទាល់ តម្លៃ.
}.


ក្បាល-HTTP ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: {
	>> បន្ទាត់ := ផ្ទាល់ កូនសោ + [': '] + ផ្ទាល់ តម្លៃ.
	បន្ទាត់ ជំនួស: ['\r'] ដោយ: [''], ជំនួស: ['\n'] ដោយ: ['']. <- បន្ទាត់ + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> ឯកសារបណ្ដាញ := វត្ថុ ថ្មី.

ឯកសារបណ្ដាញ ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី រៀបចំ.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ផ្ទាល់ ក្បាលទាំងអស់ := ស៊េរី ថ្មី.
	ផ្ទាល់ លេខសម្គាល់សម័យ := ទទេ.
	ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ := សម័យឯកសារបណ្ដោះអាសន្ន ថ្មី.
	ផ្ទាល់ ទិន្នន័យសម័យ := ទទេ.
	ផ្ទាល់ សុវត្ថិភាព := ពិត.
	ផ្ទាល់ គេហទំព័រដដែល := ['Strict'].
	ផ្ទាល់ ក្បាលបានផ្ញើ := មិនពិត.
	ផ្ទាល់ សំណើ-http := HTTP-សំណើ ថ្មី.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['សំណើ-http:'] ធ្វើ: { :សំណើ-http
	ផ្ទាល់ សំណើ-http := សំណើ-http.
}. 

ឯកសារបណ្ដាញ ពេលទទួល: ['ខុកឃីសម័យសុវត្ថិភាព:'] ធ្វើ: { :សុវត្ថិភាព
	ខ្លួន ពិនិត្យក្បាល.
	ផ្ទាល់ សុវត្ថិភាព := សុវត្ថិភាព.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['ខុកឃីសម័យគេហទំព័រដដែល:'] ធ្វើ: { :តម្លៃ
	ខ្លួន ពិនិត្យក្បាល.
	>> ជម្រើស := ស៊េរី ថ្មី 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	ជម្រើស មាន: តម្លៃ, បើមិនពិត: {
		កិច្ចការនេះ កំហុស: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ផ្ទាល់ គេហទំព័រដដែល := តម្លៃ.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['ក្បាល:'] ធ្វើ: { :ក្បាល
	ខ្លួន ពិនិត្យក្បាល.
	ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: ក្បាល.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['សម្អាតក្បាល'] ធ្វើ: {
	ខ្លួន ពិនិត្យក្បាល.
	ផ្ទាល់ ក្បាលទាំងអស់ := ស៊េរី ថ្មី.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['អ្នកគ្រប់គ្រងសម័យ:'] ធ្វើ: { :អ្នកគ្រប់គ្រង
	ខ្លួន ពិនិត្យក្បាល.
	ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ := អ្នកគ្រប់គ្រង.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['អ្នកគ្រប់គ្រងសម័យ'] ធ្វើ: { <- ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['ពិនិត្យក្បាល'] ធ្វើ: {
	ផ្ទាល់ ក្បាលបានផ្ញើ បើពិត: {
		កិច្ចការនេះ កំហុស: ['Headers already sent to client.'].
	}.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['ចាប់ផ្ដើមសម័យ'] ធ្វើ: {
	ខ្លួន ពិនិត្យក្បាល.
	>> សំណើ-http := ផ្ទាល់ សំណើ-http.
	>> លេខសម្គាល់សម័យ := សំណើ-http cookie: ['xsid'].
	លេខសម្គាល់សម័យ ទទេឬ? បើមិនពិត: {
		(( លំនាំ ថ្មី: ['^[A-Za-z0-9]+\\z'], ផ្គូផ្គង: លេខសម្គាល់សម័យ ) = 0) បើពិត: {
			លេខសម្គាល់សម័យ := ទទេ.
		}.
	}.
	លេខសម្គាល់សម័យ ទទេឬ? បើពិត: {
		លេខសម្គាល់សម័យ := ទូដែក ថូខឹន: 30.
		>> ក្បាលសម័យ := ក្បាល-HTTP ថ្មី
		កូនសោ: ['Set-Cookie'] តម្លៃ: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ផ្ទាល់ សុវត្ថិភាព មួយនេះ: ['Secure'] ឬមួយនោះ: ['']),
		SSITE: (ផ្ទាល់ គេហទំព័រដដែល),
		XSID: លេខសម្គាល់សម័យ
		).
		ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: ក្បាលសម័យ.
	}.
	ផ្ទាល់ ទិន្នន័យសម័យ := ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ សម្រាប់: លេខសម្គាល់សម័យ, ផ្ទុក. <- ផ្ទាល់ ទិន្នន័យសម័យ. # reference
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['ទៅកាន់:'] ធ្វើ: { :អាសយដ្ឋាន
	ខ្លួន ពិនិត្យក្បាល.
	ខ្លួន សម្អាតក្បាល.
	ផ្ទាល់ ក្បាលទាំងអស់
	បន្ថែមខាងចុង: (
		ក្បាល-HTTP ថ្មី
		កូនសោ: ['Status'] តម្លៃ: ['303 See Other']
	),
	បន្ថែមខាងចុង: (
		ក្បាល-HTTP ថ្មី
		កូនសោ: ['Location'] តម្លៃ: អាសយដ្ឋាន
	).
	ខ្លួន បញ្ចេញ: ['Redirect'].
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['បំផ្លាញសម័យ'] ធ្វើ: {
	ខ្លួន ពិនិត្យក្បាល.
	>> សំណើ-http := ផ្ទាល់ សំណើ-http.
	>> លេខសម្គាល់សម័យ := សំណើ-http cookie: ['xsid'].
	លេខសម្គាល់សម័យ ទទេឬ? បើមិនពិត: {
		>> ក្បាលសម័យ := ក្បាល-HTTP ថ្មី.
		>> ពេលផុតកំណត់ := ខណៈ ថ្មី ឆ្នាំ: 1970, តាមទម្រង់: ['%a, %d %b %Y %H:%M:%S GMT'].
		ក្បាលសម័យ កូនសោ: ['Set-Cookie'] តម្លៃ: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: ពេលផុតកំណត់,
			SEC: (ផ្ទាល់ សុវត្ថិភាព មួយនេះ: ['Secure'] ឬមួយនោះ: ['']),
			SSITE: (ផ្ទាល់ គេហទំព័រដដែល),
			XSID: លេខសម្គាល់សម័យ
		).
		ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ បំផ្លាញ.
		ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: ក្បាលសម័យ.
	}.
}.


ឯកសារបណ្ដាញ ពេលទទួល: ['គំរូ:'] ធ្វើ: { :ផ្លូវឯកសារ <- គំរូ ថ្មី: (ឯកសារ ថ្មី: ផ្លូវឯកសារ, អាន).
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['បញ្ចេញ:ប្រភេទ:'] ធ្វើ: { :លទ្ធផលចេញ :ប្រភេទ
	ផ្ទាល់ ក្បាលបានផ្ញើ បើមិនពិត: {
		ផ្ទាល់ ទិន្នន័យសម័យ ទទេឬ? បើមិនពិត: {
			ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ រក្សាទុក: ផ្ទាល់ ទិន្នន័យសម័យ.
		}.
		ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: (
			ក្បាល-HTTP ថ្មី
			កូនសោ: ['Content-type'] តម្លៃ: ប្រភេទ
		).
		ផ្ទាល់ ក្បាលទាំងអស់ នីមួយៗ: { :_ :ក្បាល
			លទ្ធផល សរសេរ: ក្បាល.
		}.
		ផ្ទាល់ ក្បាលបានផ្ញើ := ពិត.
		លទ្ធផល សរសេរ: ['\r\n'].
	}.
	លទ្ធផល សរសេរ: លទ្ធផលចេញ.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['បញ្ចប់:ប្រភេទ:'] ធ្វើ: { :លទ្ធផលចេញ :ប្រភេទ
	ផ្ទាល់ ក្បាលបានផ្ញើ បើមិនពិត: {
		ផ្ទាល់ ទិន្នន័យសម័យ ទទេឬ? បើមិនពិត: {
			ផ្ទាល់ អ្នកគ្រប់គ្រងសម័យ រក្សាទុក: ផ្ទាល់ ទិន្នន័យសម័យ.
		}.
		ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: (
			ក្បាល-HTTP ថ្មី
			កូនសោ: ['Content-type'] តម្លៃ: ប្រភេទ
		).
		ផ្ទាល់ ក្បាលទាំងអស់ បន្ថែមខាងចុង: (
			ក្បាល-HTTP ថ្មី
			កូនសោ: ['Content-Length'] តម្លៃ: លទ្ធផលចេញ ជាអត្ថបទ bytes
		).
		ផ្ទាល់ ក្បាលទាំងអស់ នីមួយៗ: { :_ :ក្បាល
			លទ្ធផល សរសេរ: ក្បាល.
		}.
		ផ្ទាល់ ក្បាលបានផ្ញើ := ពិត.
		លទ្ធផល សរសេរ: ['\r\n'].
	}.
	លទ្ធផល សរសេរ: លទ្ធផលចេញ.
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['បញ្ចេញ:'] ធ្វើ: { :លទ្ធផលចេញ
	ខ្លួន បញ្ចេញ: លទ្ធផលចេញ ប្រភេទ: ['text/html; charset=utf-8'].
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['បញ្ចប់:'] ធ្វើ: { :លទ្ធផលចេញ
	ខ្លួន បញ្ចប់: លទ្ធផលចេញ ប្រភេទ: ['text/html; charset=utf-8'].
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['json:'] ធ្វើ: { :លទ្ធផលចេញ
	ខ្លួន បញ្ចេញ: ( JSON jsonify: លទ្ធផលចេញ ) ប្រភេទ: ['application/json'].
}.

ឯកសារបណ្ដាញ ពេលទទួល: ['រកមិនឃើញ:'] ធ្វើ: { :លទ្ធផលចេញ
	ខ្លួន សម្អាតក្បាល ក្បាល: (
		ក្បាល-HTTP ថ្មី កូនសោ: ['Status'] តម្លៃ: ['404 Not Found']
	).
	ខ្លួន បញ្ចេញ: លទ្ធផលចេញ.
}.


# Interface

>> សម័យ := វត្ថុ ថ្មី.

សម័យ ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី រៀបចំ សម្រាប់: ទទេ.
}.

សម័យ ពេលទទួល: ['សម្រាប់:'] ធ្វើ: { :id
	ផ្ទាល់ id := id.
}.

សម័យ ពេលទទួល: ['ផ្ទុក'] ធ្វើ: {
	កិច្ចការនេះ កំហុស: ['Not implemented.'].
}.

សម័យ ពេលទទួល: ['រក្សាទុក:'] ធ្វើ: {
	កិច្ចការនេះ កំហុស: ['Not implemented.'].
}.

សម័យ ពេលទទួល: ['បំផ្លាញ'] ធ្វើ: {
	កិច្ចការនេះ កំហុស: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> សម័យឯកសារបណ្ដោះអាសន្ន := សម័យ ថ្មី.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ផ្ទាល់ ដើមផ្លូវ := ['/tmp/sess-'].
}.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['បុព្វបទផ្លូវ:'] ធ្វើ: { :ខ្សែអក្សរ
	ផ្ទាល់ ដើមផ្លូវ := ខ្សែអក្សរ.
}.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['ឯកសារសម័យ'] ធ្វើ: { <- ( ឯកសារ ថ្មី: ( ផ្ទាល់ ដើមផ្លូវ + ផ្ទាល់ id + ['.txt'] ) ).
}.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['ផ្ទុក'] ធ្វើ: {
	>> ឯកសារសម័យ := ខ្លួន ឯកសារសម័យ.
	ឯកសារសម័យ មាន បើមិនពិត: {
		ឯកសារសម័យ សរសេរ: (វចនានុក្រម ថ្មី កូដ).
	}. <- ឯកសារសម័យ អាន ជាវត្ថុ.
}.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['រក្សាទុក:'] ធ្វើ: { :ទិន្នន័យ
	>> ឯកសារសម័យ := ខ្លួន ឯកសារសម័យ.
	ឯកសារសម័យ មាន បើពិត: {
		ឯកសារសម័យ សរសេរ: ទិន្នន័យ កូដ.
	}.
}.

សម័យឯកសារបណ្ដោះអាសន្ន ពេលទទួល: ['បំផ្លាញ'] ធ្វើ: {
	>> ឯកសារសម័យ := ខ្លួន ឯកសារសម័យ.
	ឯកសារសម័យ មាន បើពិត: {
		ឯកសារសម័យ លុប.
	}.
}.


>> URL := វត្ថុ ថ្មី.

URL ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ផ្ទាល់ ពិធីការ := ['https://'].
	ផ្ទាល់ ម៉ាស៊ីនបង្ហោះ := ['localhost'].
	ផ្ទាល់ ផ្លូវឯកសារ := [''].
	ផ្ទាល់ ប៉ារ៉ាម៉ែត្រ-url := [''].
	ផ្ទាល់ hash := [''].
}.

URL ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី រៀបចំ.
}.

URL ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: { <- (
	ផ្ទាល់ ពិធីការ +
	ផ្ទាល់ ម៉ាស៊ីនបង្ហោះ +
	ផ្ទាល់ ផ្លូវឯកសារ +
	ផ្ទាល់ ប៉ារ៉ាម៉ែត្រ-url +
	ផ្ទាល់ hash ).
}.

URL ពេលទទួល: ['ពិធីការ:'] ធ្វើ: { :ពិធីការ
	((ស៊េរី ថ្មី ; ['http'] ; ['https']) មាន: ពិធីការ) បើពិត: {
		ផ្ទាល់ ពិធីការ := ពិធីការ + ['://'].
	}, បើមិនពិត: {
		កិច្ចការនេះ កំហុស: ['Invalid protocol'].
	}.
}.

URL ពេលទទួល: ['ម៉ាស៊ីនបង្ហោះ:'] ធ្វើ: { :ម៉ាស៊ីនបង្ហោះ
	#todo validate according to rfc
	ផ្ទាល់ ម៉ាស៊ីនបង្ហោះ := ម៉ាស៊ីនបង្ហោះ.
}.

URL ពេលទទួល: ['ផ្លូវឯកសារ:'] ធ្វើ: { :ផ្លូវឯកសារ
	ផ្ទាល់ ផ្លូវឯកសារ := ['/'] + ផ្លូវឯកសារ url-អ៊ិនកូដ.
}.

URL ពេលទទួល: ['ប៉ារ៉ាម៉ែត្រ-url:'] ធ្វើ: { :ការផ្គូផ្គង
	>> ប៉ារ៉ាម៉ែត្រ-url := ស៊េរី ថ្មី.
	ការផ្គូផ្គង នីមួយៗ: { :កូនសោ :តម្លៃ
		ប៉ារ៉ាម៉ែត្រ-url បន្ថែមខាងចុង: កូនសោ ជាអត្ថបទ url-អ៊ិនកូដ + ['='] + តម្លៃ ជាអត្ថបទ url-អ៊ិនកូដ.
	}.
	ផ្ទាល់ ប៉ារ៉ាម៉ែត្រ-url := ['?'] + ( ប៉ារ៉ាម៉ែត្រ-url ភ្ជាប់: ['&'] ).
}.

URL ពេលទទួល: ['ហាស:'] ធ្វើ: { :hash
	ផ្ទាល់ hash := ['#'] + hash url-អ៊ិនកូដ.
}.

