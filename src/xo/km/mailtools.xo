>> អ៊ីមែល := វត្ថុ ថ្មី.

អ៊ីមែល ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ផ្ទាល់ អ្នកទទួល := ស៊េរី ថ្មី.
	ផ្ទាល់ cc := ស៊េរី ថ្មី.
	ផ្ទាល់ bcc := ស៊េរី ថ្មី.
	ផ្ទាល់ អ្នកផ្ញើ := ទទេ.
	ផ្ទាល់ ឈ្មោះអ្នកផ្ញើ := ទទេ.
	ផ្ទាល់ ប្រធានបទ := ទទេ.
	ផ្ទាល់ តួអត្ថបទ := ទទេ.
}.

អ៊ីមែល ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី រៀបចំ.
}.

អ៊ីមែល ពេលទទួល: ['ទៅ:'] ធ្វើ: { :ការរាប់បញ្ជី
	ផ្ទាល់ អ្នកទទួល := ការរាប់បញ្ជី.
}.
 
អ៊ីមែល ពេលទទួល: ['cc:'] ធ្វើ: { :ការរាប់បញ្ជី
	ផ្ទាល់ cc := ការរាប់បញ្ជី.
}.

អ៊ីមែល ពេលទទួល: ['bcc:'] ធ្វើ: { :ការរាប់បញ្ជី
	ផ្ទាល់ bcc := ការរាប់បញ្ជី.
}.

អ៊ីមែល ពេលទទួល: ['ប្រធានបទ:'] ធ្វើ: { :ប្រធានបទ
	ផ្ទាល់ ប្រធានបទ := ប្រធានបទ.
}.

អ៊ីមែល ពេលទទួល: ['អ្នកផ្ញើ:ឈ្មោះ:'] ធ្វើ: { :អ្នកផ្ញើ :ឈ្មោះ
	ផ្ទាល់ អ្នកផ្ញើ := អ្នកផ្ញើ.
	ផ្ទាល់ ឈ្មោះអ្នកផ្ញើ := ឈ្មោះ.
}.

អ៊ីមែល ពេលទទួល: ['តួអត្ថបទ:'] ធ្វើ: { :តួអត្ថបទ
	ផ្ទាល់ តួអត្ថបទ := តួអត្ថបទ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
អ៊ីមែល ពេលទទួល: ['ក្បាល:'] ធ្វើ: { :បន្ទាត់ <- បន្ទាត់ ជំនួស: ['\r'] ដោយ: [''], ជំនួស: ['\n'] ដោយ: [''].
}.

អ៊ីមែល ពេលទទួល: ['ផ្ញើ'] ធ្វើ: {
	>> f := ឯកសារ tempwrite: ខ្លួន បង្កើត.
	កម្មវិធី ប្រព័ន្ធ: ['sendmail -t < '] + f ផ្លូវឯកសារ, បន្ទាត់ថ្មី.
}.

អ៊ីមែល ពេលទទួល: ['បង្កើត'] ធ្វើ: {
	>> ចុះបន្ទាត់ := ['\r\n'].
	>> ខ្សែអក្សរ := [''].
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['From: '] + ផ្ទាល់ ឈ្មោះអ្នកផ្ញើ + [' <'] + ( ផ្ទាល់ អ្នកផ្ញើ ) + ['>']) + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['To: '] + ( ផ្ទាល់ អ្នកទទួល ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	ផ្ទាល់ cc ចំនួនធាតុ បើពិត: {
		ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Cc: '] + ( ផ្ទាល់ cc ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	}.
	ផ្ទាល់ bcc ចំនួនធាតុ បើពិត: {
		ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Bcc: '] + ( ផ្ទាល់ bcc ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	}.
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Subject: '] + ផ្ទាល់ ប្រធានបទ) + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ផ្ទាល់ តួអត្ថបទ.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់. <- ខ្សែអក្សរ.
}.

>> អ៊ីមែល-HTML := អ៊ីមែល ថ្មី.

អ៊ីមែល-HTML ពេលទទួល: ['រៀបចំ'] ធ្វើ: {
	ខ្លួន រៀបចំ.
	ផ្ទាល់ ឯកសារភ្ជាប់ := ស៊េរី ថ្មី.
	ផ្ទាល់ ព្រំដែន := ទូដែក ថូខឹន: 40.
}.

អ៊ីមែល-HTML ពេលទទួល: ['ភ្ជាប់ឯកសារ:'] ធ្វើ: { :ឯកសារសម័យ
	>> id := ផ្ទាល់ ឯកសារភ្ជាប់ ចំនួនធាតុ.
	>> blob := ឯកសារសម័យ blob.
	ផ្ទាល់ ឯកសារភ្ជាប់ បន្ថែមខាងចុង: (
		វចនានុក្រម ថ្មី
			ឯកសារសម័យ: ឯកសារសម័យ ផ្លូវឯកសារ,
			mime: ['image/'] + (Server mimetype: ឯកសារសម័យ ផ្លូវឯកសារ),
			ទិន្នន័យ: blob base64-អ៊ិនកូដ
	).
	blob ដោះលែង. <- ['cid:attachment'] + id.
}.

អ៊ីមែល-HTML ពេលទទួល: ['បង្កើត'] ធ្វើ: {
	>> ចុះបន្ទាត់ := ['\r\n'].
	>> ខ្សែអក្សរ := [''].
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['From: '] + ផ្ទាល់ ឈ្មោះអ្នកផ្ញើ + [' <'] + ( ផ្ទាល់ អ្នកផ្ញើ ) + ['>']) + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['To: '] + ( ផ្ទាល់ អ្នកទទួល ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	ផ្ទាល់ cc ចំនួនធាតុ បើពិត: {
		ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Cc: '] + ( ផ្ទាល់ cc ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	}.
	ផ្ទាល់ bcc ចំនួនធាតុ បើពិត: {
		ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Bcc: '] + ( ផ្ទាល់ bcc ភ្ជាប់: [','] )) + ចុះបន្ទាត់.
	}.
	ខ្សែអក្សរ បន្ថែមខាងចុង: (ខ្លួន ក្បាល: ['Subject: '] + ផ្ទាល់ ប្រធានបទ) + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['MIME-Version: 1.0'] + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Type: multipart/related; boundary="'] + ផ្ទាល់ ព្រំដែន + ['"; type=text/html'] + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['--'] + ផ្ទាល់ ព្រំដែន + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Type: text/html; charset=UTF-8'] + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Transfer-Encoding: 7bit'] + ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ផ្ទាល់ តួអត្ថបទ.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
	ផ្ទាល់ ឯកសារភ្ជាប់ នីមួយៗ: { :id :ព័ត៌មាន
		>> blob := ព័ត៌មាន ទិន្នន័យ.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ['--'] + ផ្ទាល់ ព្រំដែន + ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Type: '] + ព័ត៌មាន mime + ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Transfer-Encoding: base64'] + ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-ID: <attachment'] + id + ['>'] + ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ['Content-Disposition: inline; filename="'] + ព័ត៌មាន ឯកសារសម័យ + ['"'] + ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
		>> កម្រិតខ្ពស់បំផុត := 76.
		>> ប្រវែងអត្ថបទ := blob ប្រវែង.
		>> ដុំៗ := (ប្រវែងអត្ថបទ / កម្រិតខ្ពស់បំផុត) បង្គត់ឡើង.
		{ :i
			>> ដុំ := blob ចម្លង ចាប់ពី: i * កម្រិតខ្ពស់បំផុត ប្រវែង: កម្រិតខ្ពស់បំផុត.
			ខ្សែអក្សរ បន្ថែមខាងចុង: ដុំ + ចុះបន្ទាត់.
		} * ដុំៗ.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
		ខ្សែអក្សរ បន្ថែមខាងចុង: ចុះបន្ទាត់.
	}.
	ខ្សែអក្សរ បន្ថែមខាងចុង: ['--'] + ផ្ទាល់ ព្រំដែន + ['--'] + ចុះបន្ទាត់. <- ខ្សែអក្សរ.
}.
