
# ~ Simple template engine ~

>> គំរូ := វត្ថុ ថ្មី.

គំរូ ពេលទទួល: ['ថ្មី'] ធ្វើ: { <- ខ្លួន ថ្មី ខ្លឹមសារ: [''].
}.

គំរូ ពេលទទួល: ['ខ្លឹមសារ:'] ធ្វើ: { :ខ្លឹមសារ
	ផ្ទាល់ ខ្លឹមសារ := ខ្លឹមសារ. 
}.

គំរូ ពេលទទួល: ['ថ្មី:'] ធ្វើ: { :ខ្លឹមសារ <- ខ្លួន ថ្មី ខ្លឹមសារ: ខ្លឹមសារ.
}.

គំរូ ពេលទទួល: ['កាត់ចេញ:'] ធ្វើ: { :សញ្ញា
	>> សញ្ញាចាប់ផ្ដើម := (['<!-- cut:%id% -->'] %id%: សញ្ញា).
	>> សញ្ញាបញ្ចប់ := (['<!-- /cut:%id% -->'] %id%: សញ្ញា).
	>> ផ្នែកៗ := ផ្ទាល់ ខ្លឹមសារ បំបែកជា: សញ្ញាចាប់ផ្ដើម.
	>> បុព្វបទ := ផ្នែកៗ ដំបូង.
	>> ផ្នែកៗ2 := ផ្នែកៗ ចុងក្រោយ បំបែកជា: សញ្ញាបញ្ចប់.
	>> បច្ច័យ := ផ្នែកៗ2 ចុងក្រោយ.
	>> ផ្នែក := ផ្នែកៗ2 ដំបូង.
	>> នៅសល់ := បុព្វបទ + បច្ច័យ.
	ផ្ទាល់ ខ្លឹមសារ := នៅសល់. <- គំរូ ថ្មី: ផ្នែក.
	
}.

គំរូ ពេលទទួល: ['ចម្លង'] ធ្វើ: { <- ខ្លួន ថ្មី: ខ្លួន ជាអត្ថបទ ចម្លង.
}.
	
គំរូ ពេលទទួល: ['បិទភ្ជាប់:សោ:'] ធ្វើ: { :ដកស្រង់ :id
	>> សញ្ញាបិទភ្ជាប់ := (['<!-- paste:%id% -->'] %id%: id).
	ផ្ទាល់ ខ្លឹមសារ ជំនួស: សញ្ញាបិទភ្ជាប់ ដោយ: ( ដកស្រង់ ជាអត្ថបទ + សញ្ញាបិទភ្ជាប់ ).
}.

គំរូ ពេលទទួល: ['កំណត់:តម្លៃ:'] ធ្វើ: { :រន្ធ :តម្លៃ
	ផ្ទាល់ ខ្លឹមសារ ជំនួស: ['<!-- slot:'] + រន្ធ + [' -->'] ដោយ: ( Server html-អ៊ិនកូដ: តម្លៃ ).
}.

គំរូ ពេលទទួល: ['កំណត់:html:'] ធ្វើ: { :រន្ធ :html
	ផ្ទាល់ ខ្លឹមសារ ជំនួស: ['<!-- slot:'] + រន្ធ + [' -->'] ដោយ: html.
}.

គំរូ ពេលទទួល: ['ឆ្លើយតប:និង:'] ធ្វើ: { :រន្ធ :តម្លៃ
	ខ្លួន កំណត់: (រន្ធ ចាប់ពី: 0 ប្រវែង: (រន្ធ ប្រវែង - 1)) តម្លៃ: តម្លៃ.
}.

គំរូ ពេលទទួល: ['nl2br'] ធ្វើ: {
	ផ្ទាល់ ខ្លឹមសារ ជំនួស: ['\n'] ដោយ: ['<br>'].
}.

គំរូ ពេលទទួល: ['លុបសញ្ញា'] ធ្វើ: {
	ផ្ទាល់ ខ្លឹមសារ :=
		លំនាំ
		ថ្មី: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ផ្គូផ្គង: ផ្ទាល់ ខ្លឹមសារ
		ធ្វើ: { <- ['']. }.
}.

គំរូ ពេលទទួល: ['លុបផ្នែកកាត់'] ធ្វើ: {
	>> ធាតុ := ស៊េរី ថ្មី.
	លំនាំ
	ថ្មី: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ផ្គូផ្គង: ផ្ទាល់ ខ្លឹមសារ
	ធ្វើ: { :_ :ផ្នែក
		ធាតុ បន្ថែមខាងចុង: ផ្នែក ? 1.
	}.
	ធាតុ នីមួយៗ: { :_ :id
		ផ្ទាល់ ខ្លឹមសារ :=
			លំនាំ ថ្មី: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ផ្គូផ្គង: ផ្ទាល់ ខ្លឹមសារ
			ធ្វើ: { <- ['']. }.
	 }.
}.

គំរូ ពេលទទួល: ['លុបចន្លោះ'] ធ្វើ: {
	ផ្ទាល់ ខ្លឹមសារ :=
		លំនាំ
		ថ្មី: ['\\s*\\n'],
		ផ្គូផ្គង: ផ្ទាល់ ខ្លឹមសារ
		ធ្វើ: { <- ['\n']. }.
	ផ្ទាល់ ខ្លឹមសារ :=
		លំនាំ
		ថ្មី: ['\\n[\\s\\t]+'],
		ផ្គូផ្គង: ផ្ទាល់ ខ្លឹមសារ
		ធ្វើ: { <- ['\n']. }.
}.

គំរូ ពេលទទួល: ['លុបទាំងអស់'] ធ្វើ: {
	ខ្លួន លុបសញ្ញា.
	ខ្លួន លុបផ្នែកកាត់.
	ខ្លួន លុបចន្លោះ.
}.

គំរូ ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: { <- ផ្ទាល់ ខ្លឹមសារ.
}.
