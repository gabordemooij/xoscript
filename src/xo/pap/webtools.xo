Petishon-HTTP ora: ['HTTP-encabesamentu:'] hasi: { :yabi <- Programa konfigurashon: yabi.
}.

>> Encabesamentu-HTTP := Opheto nobo.

Encabesamentu-HTTP ora: ['nobo'] hasi: { <- mes nobo prepará.
}.

Encabesamentu-HTTP ora: ['prepará'] hasi: {
	propio yabi := Nada.
	propio balor := Nada.
}.

Encabesamentu-HTTP ora: ['yabi:balor:'] hasi: { :yabi :balor
	propio yabi := yabi.
	propio balor := balor.
}.

Encabesamentu-HTTP ora: ['yabi'] hasi: { <- propio yabi.
}.

Encabesamentu-HTTP ora: ['balor'] hasi: { <- propio balor.
}.


Encabesamentu-HTTP ora: ['teksto'] hasi: {
	>> liña := propio yabi + [': '] + propio balor.
	liña remplasá: ['\r'] ku: [''], remplasá: ['\n'] ku: ['']. <- liña + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumento-Web := Opheto nobo.

Dokumento-Web ora: ['nobo'] hasi: { <- mes nobo prepará.
}.

Dokumento-Web ora: ['prepará'] hasi: {
	propio encabesamentunan := Lista nobo.
	propio id-di-seshon := Nada.
	propio maneho-di-seshon := Seshon-di-archivo-temporal nobo.
	propio dato-di-seshon := Nada.
	propio sigur := Bèrdat.
	propio mesun-sitio := ['Strict'].
	propio encabesamentunan-mandá := Falsu.
	propio petishon-http := Petishon-HTTP nobo.
}.

Dokumento-Web ora: ['petishon-http:'] hasi: { :petishon-http
	propio petishon-http := petishon-http.
}. 

Dokumento-Web ora: ['cookie-di-seshon-sigur:'] hasi: { :sigur
	mes chek-encabesamentunan.
	propio sigur := sigur.
}.

Dokumento-Web ora: ['cookie-di-seshon-mesun-sitio:'] hasi: { :balor
	mes chek-encabesamentunan.
	>> opshon := Lista nobo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opshon tin: balor, falsu: {
		e-tarea-aki eror: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propio mesun-sitio := balor.
}.

Dokumento-Web ora: ['encabesamentu:'] hasi: { :encabesamentu
	mes chek-encabesamentunan.
	propio encabesamentunan agregá-na-fin: encabesamentu.
}.

Dokumento-Web ora: ['kita-encabesamentunan'] hasi: {
	mes chek-encabesamentunan.
	propio encabesamentunan := Lista nobo.
}.

Dokumento-Web ora: ['maneho-di-seshon:'] hasi: { :manehadó
	mes chek-encabesamentunan.
	propio maneho-di-seshon := manehadó.
}.

Dokumento-Web ora: ['maneho-di-seshon'] hasi: { <- propio maneho-di-seshon.
}.

Dokumento-Web ora: ['chek-encabesamentunan'] hasi: {
	propio encabesamentunan-mandá bèrdat: {
		e-tarea-aki eror: ['Headers already sent to client.'].
	}.
}.

Dokumento-Web ora: ['kuminsá-seshon'] hasi: {
	mes chek-encabesamentunan.
	>> petishon-http := propio petishon-http.
	>> id-di-seshon := petishon-http cookie: ['xsid'].
	id-di-seshon Nada? falsu: {
		(( Patronchi nobo: ['^[A-Za-z0-9]+\\z'], kuadra: id-di-seshon ) = 0) bèrdat: {
			id-di-seshon := Nada.
		}.
	}.
	id-di-seshon Nada? bèrdat: {
		id-di-seshon := Kaha-fuerte token: 30.
		>> encabesamentu-di-seshon := Encabesamentu-HTTP nobo
		yabi: ['Set-Cookie'] balor: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propio sigur esaki: ['Secure'] òf-esei: ['']),
		SSITE: (propio mesun-sitio),
		XSID: id-di-seshon
		).
		propio encabesamentunan agregá-na-fin: encabesamentu-di-seshon.
	}.
	propio dato-di-seshon := propio maneho-di-seshon pa: id-di-seshon, karga. <- propio dato-di-seshon. # reference
}.

Dokumento-Web ora: ['bai-na:'] hasi: { :adrès
	mes chek-encabesamentunan.
	mes kita-encabesamentunan.
	propio encabesamentunan
	agregá-na-fin: (
		Encabesamentu-HTTP nobo
		yabi: ['Status'] balor: ['303 See Other']
	),
	agregá-na-fin: (
		Encabesamentu-HTTP nobo
		yabi: ['Location'] balor: adrès
	).
	mes saka: ['Redirect'].
}.

Dokumento-Web ora: ['destrui-seshon'] hasi: {
	mes chek-encabesamentunan.
	>> petishon-http := propio petishon-http.
	>> id-di-seshon := petishon-http cookie: ['xsid'].
	id-di-seshon Nada? falsu: {
		>> encabesamentu-di-seshon := Encabesamentu-HTTP nobo.
		>> tempu-di-fin := Momento nobo aña: 1970, formato: ['%a, %d %b %Y %H:%M:%S GMT'].
		encabesamentu-di-seshon yabi: ['Set-Cookie'] balor: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tempu-di-fin,
			SEC: (propio sigur esaki: ['Secure'] òf-esei: ['']),
			SSITE: (propio mesun-sitio),
			XSID: id-di-seshon
		).
		propio maneho-di-seshon destrui.
		propio encabesamentunan agregá-na-fin: encabesamentu-di-seshon.
	}.
}.


Dokumento-Web ora: ['plantia:'] hasi: { :ruta <- Plantia nobo: (Archivo nobo: ruta, lesa).
}.

Dokumento-Web ora: ['saka:tipo:'] hasi: { :resultado :tipo
	propio encabesamentunan-mandá falsu: {
		propio dato-di-seshon Nada? falsu: {
			propio maneho-di-seshon guarda: propio dato-di-seshon.
		}.
		propio encabesamentunan agregá-na-fin: (
			Encabesamentu-HTTP nobo
			yabi: ['Content-type'] balor: tipo
		).
		propio encabesamentunan kada: { :_ :encabesamentu
			Salida skirbi: encabesamentu.
		}.
		propio encabesamentunan-mandá := Bèrdat.
		Salida skirbi: ['\r\n'].
	}.
	Salida skirbi: resultado.
}.

Dokumento-Web ora: ['kaba:tipo:'] hasi: { :resultado :tipo
	propio encabesamentunan-mandá falsu: {
		propio dato-di-seshon Nada? falsu: {
			propio maneho-di-seshon guarda: propio dato-di-seshon.
		}.
		propio encabesamentunan agregá-na-fin: (
			Encabesamentu-HTTP nobo
			yabi: ['Content-type'] balor: tipo
		).
		propio encabesamentunan agregá-na-fin: (
			Encabesamentu-HTTP nobo
			yabi: ['Content-Length'] balor: resultado teksto bytes
		).
		propio encabesamentunan kada: { :_ :encabesamentu
			Salida skirbi: encabesamentu.
		}.
		propio encabesamentunan-mandá := Bèrdat.
		Salida skirbi: ['\r\n'].
	}.
	Salida skirbi: resultado.
}.

Dokumento-Web ora: ['saka:'] hasi: { :resultado
	mes saka: resultado tipo: ['text/html; charset=utf-8'].
}.

Dokumento-Web ora: ['kaba:'] hasi: { :resultado
	mes kaba: resultado tipo: ['text/html; charset=utf-8'].
}.

Dokumento-Web ora: ['json:'] hasi: { :resultado
	mes saka: ( JSON jsonify: resultado ) tipo: ['application/json'].
}.

Dokumento-Web ora: ['no-a-haña:'] hasi: { :resultado
	mes kita-encabesamentunan encabesamentu: (
		Encabesamentu-HTTP nobo yabi: ['Status'] balor: ['404 Not Found']
	).
	mes saka: resultado.
}.


# Interface

>> Seshon := Opheto nobo.

Seshon ora: ['nobo'] hasi: { <- mes nobo prepará pa: Nada.
}.

Seshon ora: ['pa:'] hasi: { :id
	propio id := id.
}.

Seshon ora: ['karga'] hasi: {
	e-tarea-aki eror: ['Not implemented.'].
}.

Seshon ora: ['guarda:'] hasi: {
	e-tarea-aki eror: ['Not implemented.'].
}.

Seshon ora: ['destrui'] hasi: {
	e-tarea-aki eror: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seshon-di-archivo-temporal := Seshon nobo.

Seshon-di-archivo-temporal ora: ['prepará'] hasi: {
	propio kuminsamentu-di-kaminda := ['/tmp/sess-'].
}.

Seshon-di-archivo-temporal ora: ['prefiho-di-kaminda:'] hasi: { :kadena-di-teksto
	propio kuminsamentu-di-kaminda := kadena-di-teksto.
}.

Seshon-di-archivo-temporal ora: ['archivo-di-seshon'] hasi: { <- ( Archivo nobo: ( propio kuminsamentu-di-kaminda + propio id + ['.txt'] ) ).
}.

Seshon-di-archivo-temporal ora: ['karga'] hasi: {
	>> archivo-di-seshon := mes archivo-di-seshon.
	archivo-di-seshon ta-eksistí falsu: {
		archivo-di-seshon skirbi: (Dikshonario nobo kódigo).
	}. <- archivo-di-seshon lesa opheto.
}.

Seshon-di-archivo-temporal ora: ['guarda:'] hasi: { :dato
	>> archivo-di-seshon := mes archivo-di-seshon.
	archivo-di-seshon ta-eksistí bèrdat: {
		archivo-di-seshon skirbi: dato kódigo.
	}.
}.

Seshon-di-archivo-temporal ora: ['destrui'] hasi: {
	>> archivo-di-seshon := mes archivo-di-seshon.
	archivo-di-seshon ta-eksistí bèrdat: {
		archivo-di-seshon kita-for-di-disko.
	}.
}.


>> URL := Opheto nobo.

URL ora: ['prepará'] hasi: {
	propio protokòl := ['https://'].
	propio anfitrion := ['localhost'].
	propio ruta := [''].
	propio parameter-url := [''].
	propio hash := [''].
}.

URL ora: ['nobo'] hasi: { <- mes nobo prepará.
}.

URL ora: ['teksto'] hasi: { <- (
	propio protokòl +
	propio anfitrion +
	propio ruta +
	propio parameter-url +
	propio hash ).
}.

URL ora: ['protokòl:'] hasi: { :protokòl
	((Lista nobo ; ['http'] ; ['https']) tin: protokòl) bèrdat: {
		propio protokòl := protokòl + ['://'].
	}, falsu: {
		e-tarea-aki eror: ['Invalid protocol'].
	}.
}.

URL ora: ['anfitrion:'] hasi: { :anfitrion
	#todo validate according to rfc
	propio anfitrion := anfitrion.
}.

URL ora: ['ruta:'] hasi: { :ruta
	propio ruta := ['/'] + ruta url-kodifiká.
}.

URL ora: ['parameter-url:'] hasi: { :mapa
	>> parameter-url := Lista nobo.
	mapa kada: { :yabi :balor
		parameter-url agregá-na-fin: yabi teksto url-kodifiká + ['='] + balor teksto url-kodifiká.
	}.
	propio parameter-url := ['?'] + ( parameter-url uni: ['&'] ).
}.

URL ora: ['hash:'] hasi: { :hash
	propio hash := ['#'] + hash url-kodifiká.
}.

