
# ~ Simple template engine ~

>> Plantia := Opheto nobo.

Plantia ora: ['nobo'] hasi: { <- mes nobo kontenido: [''].
}.

Plantia ora: ['kontenido:'] hasi: { :kontenido
	propio kontenido := kontenido. 
}.

Plantia ora: ['nobo:'] hasi: { :kontenido <- mes nobo kontenido: kontenido.
}.

Plantia ora: ['korta:'] hasi: { :marka
	>> marka-di-kuminsamentu := (['<!-- cut:%id% -->'] %id%: marka).
	>> marka-di-fin := (['<!-- /cut:%id% -->'] %id%: marka).
	>> partinan := propio kontenido parti: marka-di-kuminsamentu.
	>> prefiho := partinan promé.
	>> partinan2 := partinan último parti: marka-di-fin.
	>> sufiho := partinan2 último.
	>> parti := partinan2 promé.
	>> resto := prefiho + sufiho.
	propio kontenido := resto. <- Plantia nobo: parti.
	
}.

Plantia ora: ['kopia'] hasi: { <- mes nobo: mes teksto kopia.
}.
	
Plantia ora: ['pega:na:'] hasi: { :fragmento-chiki :id
	>> marka-di-pega := (['<!-- paste:%id% -->'] %id%: id).
	propio kontenido remplasá: marka-di-pega ku: ( fragmento-chiki teksto + marka-di-pega ).
}.

Plantia ora: ['pone:balor:'] hasi: { :lugá :balor
	propio kontenido remplasá: ['<!-- slot:'] + lugá + [' -->'] ku: ( Server html-kodifiká: balor ).
}.

Plantia ora: ['pone:html:'] hasi: { :lugá :html
	propio kontenido remplasá: ['<!-- slot:'] + lugá + [' -->'] ku: html.
}.

Plantia ora: ['kontestá:i:'] hasi: { :lugá :balor
	mes pone: (lugá kuminsá: 0 largura: (lugá largura - 1)) balor: balor.
}.

Plantia ora: ['nl2br'] hasi: {
	propio kontenido remplasá: ['\n'] ku: ['<br>'].
}.

Plantia ora: ['drecha'] hasi: {
	propio kontenido :=
		Patronchi
		nobo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		kuadra: propio kontenido
		hasi: { <- ['']. }.
}.

Plantia ora: ['drecha-kortenan'] hasi: {
	>> artíkulo := Lista nobo.
	Patronchi
	nobo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	kuadra: propio kontenido
	hasi: { :_ :parti
		artíkulo agregá-na-fin: parti ? 1.
	}.
	artíkulo kada: { :_ :id
		propio kontenido :=
			Patronchi nobo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			kuadra: propio kontenido
			hasi: { <- ['']. }.
	 }.
}.

Plantia ora: ['drecha-espasionan'] hasi: {
	propio kontenido :=
		Patronchi
		nobo: ['\\s*\\n'],
		kuadra: propio kontenido
		hasi: { <- ['\n']. }.
	propio kontenido :=
		Patronchi
		nobo: ['\\n[\\s\\t]+'],
		kuadra: propio kontenido
		hasi: { <- ['\n']. }.
}.

Plantia ora: ['drecha-tur'] hasi: {
	mes drecha.
	mes drecha-kortenan.
	mes drecha-espasionan.
}.

Plantia ora: ['teksto'] hasi: { <- propio kontenido.
}.
