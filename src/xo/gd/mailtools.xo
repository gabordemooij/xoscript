>> Post-d := Oibseact ùr.

Post-d air: ['tòisich-suas'] dèan: {
	leis faightearan := Liosta ùr.
	leis cc := Liosta ùr.
	leis bcc := Liosta ùr.
	leis neach-cuiridh := Neoni.
	leis ainm-neach-cuiridh := Neoni.
	leis cuspair := Neoni.
	leis bodhaig := Neoni.
}.

Post-d air: ['ùr'] dèan: { <- fhèin ùr tòisich-suas.
}.

Post-d air: ['gu:'] dèan: { :liosta-nithean
	leis faightearan := liosta-nithean.
}.
 
Post-d air: ['cc:'] dèan: { :liosta-nithean
	leis cc := liosta-nithean.
}.

Post-d air: ['bcc:'] dèan: { :liosta-nithean
	leis bcc := liosta-nithean.
}.

Post-d air: ['cuspair:'] dèan: { :cuspair
	leis cuspair := cuspair.
}.

Post-d air: ['neach-cuiridh:ainm:'] dèan: { :neach-cuiridh :ainm
	leis neach-cuiridh := neach-cuiridh.
	leis ainm-neach-cuiridh := ainm.
}.

Post-d air: ['bodhaig:'] dèan: { :bodhaig
	leis bodhaig := bodhaig.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Post-d air: ['bann-cinn:'] dèan: { :loidhne <- loidhne cuir-an-àite: ['\r'] le: [''], cuir-an-àite: ['\n'] le: [''].
}.

Post-d air: ['cuir'] dèan: {
	>> f := Faidhle tempwrite: fhèin gin.
	Prògram siostam: ['sendmail -t < '] + f slighe, loidhne-ùr.
}.

Post-d air: ['gin'] dèan: {
	>> briseadh-loidhne := ['\r\n'].
	>> sreang-teacsa := [''].
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['From: '] + leis ainm-neach-cuiridh + [' <'] + ( leis neach-cuiridh ) + ['>']) + briseadh-loidhne.
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['To: '] + ( leis faightearan ceangail: [','] )) + briseadh-loidhne.
	leis cc cunnt fìor: {
		sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Cc: '] + ( leis cc ceangail: [','] )) + briseadh-loidhne.
	}.
	leis bcc cunnt fìor: {
		sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Bcc: '] + ( leis bcc ceangail: [','] )) + briseadh-loidhne.
	}.
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Subject: '] + leis cuspair) + briseadh-loidhne.
	sreang-teacsa cuir-ris: briseadh-loidhne.
	sreang-teacsa cuir-ris: leis bodhaig.
	sreang-teacsa cuir-ris: briseadh-loidhne. <- sreang-teacsa.
}.

>> Post-d-HTML := Post-d ùr.

Post-d-HTML air: ['tòisich-suas'] dèan: {
	fhèin tòisich-suas.
	leis ceanglachain := Liosta ùr.
	leis crìoch := Tasgaidh tòcan: 40.
}.

Post-d-HTML air: ['cuir-ri:'] dèan: { :faidhle
	>> id := leis ceanglachain cunnt.
	>> blob := faidhle blob.
	leis ceanglachain cuir-ris: (
		Faclair ùr
			faidhle: faidhle slighe,
			mime: ['image/'] + (Server mimetype: faidhle slighe),
			dàta: blob base64-còdaich
	).
	blob saor. <- ['cid:attachment'] + id.
}.

Post-d-HTML air: ['gin'] dèan: {
	>> briseadh-loidhne := ['\r\n'].
	>> sreang-teacsa := [''].
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['From: '] + leis ainm-neach-cuiridh + [' <'] + ( leis neach-cuiridh ) + ['>']) + briseadh-loidhne.
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['To: '] + ( leis faightearan ceangail: [','] )) + briseadh-loidhne.
	leis cc cunnt fìor: {
		sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Cc: '] + ( leis cc ceangail: [','] )) + briseadh-loidhne.
	}.
	leis bcc cunnt fìor: {
		sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Bcc: '] + ( leis bcc ceangail: [','] )) + briseadh-loidhne.
	}.
	sreang-teacsa cuir-ris: (fhèin bann-cinn: ['Subject: '] + leis cuspair) + briseadh-loidhne.
	sreang-teacsa cuir-ris: ['MIME-Version: 1.0'] + briseadh-loidhne.
	sreang-teacsa cuir-ris: ['Content-Type: multipart/related; boundary="'] + leis crìoch + ['"; type=text/html'] + briseadh-loidhne.
	sreang-teacsa cuir-ris: briseadh-loidhne.
	sreang-teacsa cuir-ris: ['--'] + leis crìoch + briseadh-loidhne.
	sreang-teacsa cuir-ris: ['Content-Type: text/html; charset=UTF-8'] + briseadh-loidhne.
	sreang-teacsa cuir-ris: ['Content-Transfer-Encoding: 7bit'] + briseadh-loidhne.
	sreang-teacsa cuir-ris: briseadh-loidhne.
	sreang-teacsa cuir-ris: leis bodhaig.
	sreang-teacsa cuir-ris: briseadh-loidhne.
	leis ceanglachain gach: { :id :fiosrachadh
		>> blob := fiosrachadh dàta.
		sreang-teacsa cuir-ris: ['--'] + leis crìoch + briseadh-loidhne.
		sreang-teacsa cuir-ris: ['Content-Type: '] + fiosrachadh mime + briseadh-loidhne.
		sreang-teacsa cuir-ris: ['Content-Transfer-Encoding: base64'] + briseadh-loidhne.
		sreang-teacsa cuir-ris: ['Content-ID: <attachment'] + id + ['>'] + briseadh-loidhne.
		sreang-teacsa cuir-ris: ['Content-Disposition: inline; filename="'] + fiosrachadh faidhle + ['"'] + briseadh-loidhne.
		sreang-teacsa cuir-ris: briseadh-loidhne.
		>> as-motha := 76.
		>> faid-teacsa := blob faid.
		>> pìosan := (faid-teacsa / as-motha) cruinnich-suas.
		{ :i
			>> pìos := blob dèan-lethbhreac bho: i * as-motha faid: as-motha.
			sreang-teacsa cuir-ris: pìos + briseadh-loidhne.
		} * pìosan.
		sreang-teacsa cuir-ris: briseadh-loidhne.
		sreang-teacsa cuir-ris: briseadh-loidhne.
	}.
	sreang-teacsa cuir-ris: ['--'] + leis crìoch + ['--'] + briseadh-loidhne. <- sreang-teacsa.
}.
