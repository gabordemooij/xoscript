
# ~ Simple template engine ~

>> Teamplaid := Oibseact ùr.

Teamplaid air: ['ùr'] dèan: { <- fhèin ùr susbaint: [''].
}.

Teamplaid air: ['susbaint:'] dèan: { :susbaint
	leis susbaint := susbaint. 
}.

Teamplaid air: ['ùr:'] dèan: { :susbaint <- fhèin ùr susbaint: susbaint.
}.

Teamplaid air: ['gearr:'] dèan: { :comharra
	>> comharra-tòiseachaidh := (['<!-- cut:%id% -->'] %id%: comharra).
	>> comharra-crìche := (['<!-- /cut:%id% -->'] %id%: comharra).
	>> pàirtean := leis susbaint sgoilt: comharra-tòiseachaidh.
	>> ro-leasachan := pàirtean ciad.
	>> pàirtean2 := pàirtean deireannach sgoilt: comharra-crìche.
	>> iar-leasachan := pàirtean2 deireannach.
	>> pàirt := pàirtean2 ciad.
	>> an-còrr := ro-leasachan + iar-leasachan.
	leis susbaint := an-còrr. <- Teamplaid ùr: pàirt.
	
}.

Teamplaid air: ['dèan-lethbhreac'] dèan: { <- fhèin ùr: fhèin sreang dèan-lethbhreac.
}.
	
Teamplaid air: ['cuir-ann:aig:'] dèan: { :criomag :id
	>> comharra-cuir-ann := (['<!-- paste:%id% -->'] %id%: id).
	leis susbaint cuir-an-àite: comharra-cuir-ann le: ( criomag sreang + comharra-cuir-ann ).
}.

Teamplaid air: ['suidhich:luach:'] dèan: { :slot :luach
	leis susbaint cuir-an-àite: ['<!-- slot:'] + slot + [' -->'] le: ( Server html-còdaich: luach ).
}.

Teamplaid air: ['suidhich:html:'] dèan: { :slot :html
	leis susbaint cuir-an-àite: ['<!-- slot:'] + slot + [' -->'] le: html.
}.

Teamplaid air: ['freagair:agus:'] dèan: { :slot :luach
	fhèin suidhich: (slot bho: 0 faid: (slot faid - 1)) luach: luach.
}.

Teamplaid air: ['nl2br'] dèan: {
	leis susbaint cuir-an-àite: ['\n'] le: ['<br>'].
}.

Teamplaid air: ['glan'] dèan: {
	leis susbaint :=
		Pàtran
		ùr: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		maids: leis susbaint
		dèan: { <- ['']. }.
}.

Teamplaid air: ['glan-gearraidhean'] dèan: {
	>> nithean := Liosta ùr.
	Pàtran
	ùr: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	maids: leis susbaint
	dèan: { :_ :pàirt
		nithean cuir-ris: pàirt ? 1.
	}.
	nithean gach: { :_ :id
		leis susbaint :=
			Pàtran ùr: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			maids: leis susbaint
			dèan: { <- ['']. }.
	 }.
}.

Teamplaid air: ['glan-beàrnan'] dèan: {
	leis susbaint :=
		Pàtran
		ùr: ['\\s*\\n'],
		maids: leis susbaint
		dèan: { <- ['\n']. }.
	leis susbaint :=
		Pàtran
		ùr: ['\\n[\\s\\t]+'],
		maids: leis susbaint
		dèan: { <- ['\n']. }.
}.

Teamplaid air: ['glan-uile'] dèan: {
	fhèin glan.
	fhèin glan-gearraidhean.
	fhèin glan-beàrnan.
}.

Teamplaid air: ['sreang'] dèan: { <- leis susbaint.
}.
