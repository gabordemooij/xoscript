HTTP-Iarrtas air: ['HTTP-bann-cinn:'] dèan: { :iuchair <- Prògram suidheachadh: iuchair.
}.

>> Bann-cinn-HTTP := Oibseact ùr.

Bann-cinn-HTTP air: ['ùr'] dèan: { <- fhèin ùr tòisich-suas.
}.

Bann-cinn-HTTP air: ['tòisich-suas'] dèan: {
	leis iuchair := Neoni.
	leis luach := Neoni.
}.

Bann-cinn-HTTP air: ['iuchair:luach:'] dèan: { :iuchair :luach
	leis iuchair := iuchair.
	leis luach := luach.
}.

Bann-cinn-HTTP air: ['iuchair'] dèan: { <- leis iuchair.
}.

Bann-cinn-HTTP air: ['luach'] dèan: { <- leis luach.
}.


Bann-cinn-HTTP air: ['sreang'] dèan: {
	>> loidhne := leis iuchair + [': '] + leis luach.
	loidhne cuir-an-àite: ['\r'] le: [''], cuir-an-àite: ['\n'] le: ['']. <- loidhne + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Sgrìobhainn-lìn := Oibseact ùr.

Sgrìobhainn-lìn air: ['ùr'] dèan: { <- fhèin ùr tòisich-suas.
}.

Sgrìobhainn-lìn air: ['tòisich-suas'] dèan: {
	leis bannan-cinn := Liosta ùr.
	leis id-seisein := Neoni.
	leis manaidsear-sheiseanan := Seisean-faidhle-sealach ùr.
	leis dàta-seisein := Neoni.
	leis tèarainte := Fìor.
	leis an-aon-làrach := ['Strict'].
	leis bannan-cinn-air-chur := Breugach.
	leis iarrtas := HTTP-Iarrtas ùr.
}.

Sgrìobhainn-lìn air: ['iarrtas:'] dèan: { :iarrtas
	leis iarrtas := iarrtas.
}. 

Sgrìobhainn-lìn air: ['briosgaid-seisein-thèarainte:'] dèan: { :tèarainte
	fhèin dearbh-bannan-cinn.
	leis tèarainte := tèarainte.
}.

Sgrìobhainn-lìn air: ['briosgaid-seisein-an-aon-làrach:'] dèan: { :luach
	fhèin dearbh-bannan-cinn.
	>> roghainnean := Liosta ùr 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	roghainnean tha-aige: luach, breugach: {
		an-obair-seo mearachd: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	leis an-aon-làrach := luach.
}.

Sgrìobhainn-lìn air: ['bann-cinn:'] dèan: { :bann-cinn
	fhèin dearbh-bannan-cinn.
	leis bannan-cinn cuir-ris: bann-cinn.
}.

Sgrìobhainn-lìn air: ['falamhaich-bannan-cinn'] dèan: {
	fhèin dearbh-bannan-cinn.
	leis bannan-cinn := Liosta ùr.
}.

Sgrìobhainn-lìn air: ['manaidsear-sheiseanan:'] dèan: { :manaidsear
	fhèin dearbh-bannan-cinn.
	leis manaidsear-sheiseanan := manaidsear.
}.

Sgrìobhainn-lìn air: ['manaidsear-sheiseanan'] dèan: { <- leis manaidsear-sheiseanan.
}.

Sgrìobhainn-lìn air: ['dearbh-bannan-cinn'] dèan: {
	leis bannan-cinn-air-chur fìor: {
		an-obair-seo mearachd: ['Headers already sent to client.'].
	}.
}.

Sgrìobhainn-lìn air: ['tòisich-seisean'] dèan: {
	fhèin dearbh-bannan-cinn.
	>> iarrtas := leis iarrtas.
	>> id-seisein := iarrtas cookie: ['xsid'].
	id-seisein Neoni? breugach: {
		(( Pàtran ùr: ['^[A-Za-z0-9]+\\z'], maids: id-seisein ) = 0) fìor: {
			id-seisein := Neoni.
		}.
	}.
	id-seisein Neoni? fìor: {
		id-seisein := Tasgaidh tòcan: 30.
		>> bann-cinn-seisein := Bann-cinn-HTTP ùr
		iuchair: ['Set-Cookie'] luach: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (leis tèarainte an-dàrna-cuid: ['Secure'] no: ['']),
		SSITE: (leis an-aon-làrach),
		XSID: id-seisein
		).
		leis bannan-cinn cuir-ris: bann-cinn-seisein.
	}.
	leis dàta-seisein := leis manaidsear-sheiseanan airson: id-seisein, luchdaich. <- leis dàta-seisein. # reference
}.

Sgrìobhainn-lìn air: ['rach-gu:'] dèan: { :seòladh
	fhèin dearbh-bannan-cinn.
	fhèin falamhaich-bannan-cinn.
	leis bannan-cinn
	cuir-ris: (
		Bann-cinn-HTTP ùr
		iuchair: ['Status'] luach: ['303 See Other']
	),
	cuir-ris: (
		Bann-cinn-HTTP ùr
		iuchair: ['Location'] luach: seòladh
	).
	fhèin cuir-a-mach: ['Redirect'].
}.

Sgrìobhainn-lìn air: ['sgrios-seisean'] dèan: {
	fhèin dearbh-bannan-cinn.
	>> iarrtas := leis iarrtas.
	>> id-seisein := iarrtas cookie: ['xsid'].
	id-seisein Neoni? breugach: {
		>> bann-cinn-seisein := Bann-cinn-HTTP ùr.
		>> àm := Àm ùr bliadhna: 1970, fòrmat: ['%a, %d %b %Y %H:%M:%S GMT'].
		bann-cinn-seisein iuchair: ['Set-Cookie'] luach: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: àm,
			SEC: (leis tèarainte an-dàrna-cuid: ['Secure'] no: ['']),
			SSITE: (leis an-aon-làrach),
			XSID: id-seisein
		).
		leis manaidsear-sheiseanan sgrios.
		leis bannan-cinn cuir-ris: bann-cinn-seisein.
	}.
}.


Sgrìobhainn-lìn air: ['teamplaid:'] dèan: { :slighe <- Teamplaid ùr: (Faidhle ùr: slighe, leugh).
}.

Sgrìobhainn-lìn air: ['cuir-a-mach:seòrsa:'] dèan: { :toradh :seòrsa
	leis bannan-cinn-air-chur breugach: {
		leis dàta-seisein Neoni? breugach: {
			leis manaidsear-sheiseanan sàbhail: leis dàta-seisein.
		}.
		leis bannan-cinn cuir-ris: (
			Bann-cinn-HTTP ùr
			iuchair: ['Content-type'] luach: seòrsa
		).
		leis bannan-cinn gach: { :_ :bann-cinn
			Às-chur sgrìobh: bann-cinn.
		}.
		leis bannan-cinn-air-chur := Fìor.
		Às-chur sgrìobh: ['\r\n'].
	}.
	Às-chur sgrìobh: toradh.
}.

Sgrìobhainn-lìn air: ['crìochnaich:seòrsa:'] dèan: { :toradh :seòrsa
	leis bannan-cinn-air-chur breugach: {
		leis dàta-seisein Neoni? breugach: {
			leis manaidsear-sheiseanan sàbhail: leis dàta-seisein.
		}.
		leis bannan-cinn cuir-ris: (
			Bann-cinn-HTTP ùr
			iuchair: ['Content-type'] luach: seòrsa
		).
		leis bannan-cinn cuir-ris: (
			Bann-cinn-HTTP ùr
			iuchair: ['Content-Length'] luach: toradh sreang bytes
		).
		leis bannan-cinn gach: { :_ :bann-cinn
			Às-chur sgrìobh: bann-cinn.
		}.
		leis bannan-cinn-air-chur := Fìor.
		Às-chur sgrìobh: ['\r\n'].
	}.
	Às-chur sgrìobh: toradh.
}.

Sgrìobhainn-lìn air: ['cuir-a-mach:'] dèan: { :toradh
	fhèin cuir-a-mach: toradh seòrsa: ['text/html; charset=utf-8'].
}.

Sgrìobhainn-lìn air: ['crìochnaich:'] dèan: { :toradh
	fhèin crìochnaich: toradh seòrsa: ['text/html; charset=utf-8'].
}.

Sgrìobhainn-lìn air: ['json:'] dèan: { :toradh
	fhèin cuir-a-mach: ( JSON jsonify: toradh ) seòrsa: ['application/json'].
}.

Sgrìobhainn-lìn air: ['cha-deach-a-lorg:'] dèan: { :toradh
	fhèin falamhaich-bannan-cinn bann-cinn: (
		Bann-cinn-HTTP ùr iuchair: ['Status'] luach: ['404 Not Found']
	).
	fhèin cuir-a-mach: toradh.
}.


# Interface

>> Seisean := Oibseact ùr.

Seisean air: ['ùr'] dèan: { <- fhèin ùr tòisich-suas airson: Neoni.
}.

Seisean air: ['airson:'] dèan: { :id
	leis id := id.
}.

Seisean air: ['luchdaich'] dèan: {
	an-obair-seo mearachd: ['Not implemented.'].
}.

Seisean air: ['sàbhail:'] dèan: {
	an-obair-seo mearachd: ['Not implemented.'].
}.

Seisean air: ['sgrios'] dèan: {
	an-obair-seo mearachd: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seisean-faidhle-sealach := Seisean ùr.

Seisean-faidhle-sealach air: ['tòisich-suas'] dèan: {
	leis toiseach-slighe := ['/tmp/sess-'].
}.

Seisean-faidhle-sealach air: ['ro-leasachan-slighe:'] dèan: { :sreang-teacsa
	leis toiseach-slighe := sreang-teacsa.
}.

Seisean-faidhle-sealach air: ['faidhle'] dèan: { <- ( Faidhle ùr: ( leis toiseach-slighe + leis id + ['.txt'] ) ).
}.

Seisean-faidhle-sealach air: ['luchdaich'] dèan: {
	>> faidhle := fhèin faidhle.
	faidhle ann breugach: {
		faidhle sgrìobh: (Faclair ùr còd).
	}. <- faidhle leugh oibseact.
}.

Seisean-faidhle-sealach air: ['sàbhail:'] dèan: { :dàta
	>> faidhle := fhèin faidhle.
	faidhle ann fìor: {
		faidhle sgrìobh: dàta còd.
	}.
}.

Seisean-faidhle-sealach air: ['sgrios'] dèan: {
	>> faidhle := fhèin faidhle.
	faidhle ann fìor: {
		faidhle cuir-às.
	}.
}.


>> URL := Oibseact ùr.

URL air: ['tòisich-suas'] dèan: {
	leis pròtacal := ['https://'].
	leis òstair := ['localhost'].
	leis slighe := [''].
	leis paramadairean-url := [''].
	leis hash := [''].
}.

URL air: ['ùr'] dèan: { <- fhèin ùr tòisich-suas.
}.

URL air: ['sreang'] dèan: { <- (
	leis pròtacal +
	leis òstair +
	leis slighe +
	leis paramadairean-url +
	leis hash ).
}.

URL air: ['pròtacal:'] dèan: { :pròtacal
	((Liosta ùr ; ['http'] ; ['https']) tha-aige: pròtacal) fìor: {
		leis pròtacal := pròtacal + ['://'].
	}, breugach: {
		an-obair-seo mearachd: ['Invalid protocol'].
	}.
}.

URL air: ['òstair:'] dèan: { :òstair
	#todo validate according to rfc
	leis òstair := òstair.
}.

URL air: ['slighe:'] dèan: { :slighe
	leis slighe := ['/'] + slighe url-còdaich.
}.

URL air: ['paramadairean-url:'] dèan: { :mapadh
	>> paramadairean-url := Liosta ùr.
	mapadh gach: { :iuchair :luach
		paramadairean-url cuir-ris: iuchair sreang url-còdaich + ['='] + luach sreang url-còdaich.
	}.
	leis paramadairean-url := ['?'] + ( paramadairean-url ceangail: ['&'] ).
}.

URL air: ['hais:'] dèan: { :hash
	leis hash := ['#'] + hash url-còdaich.
}.

