HTTP-Eskaera noiz: ['HTTP-goiburua:'] egin: { :gakoa <- Programa ezarpena: gakoa.
}.

>> HTTP-Goiburua := Objektua berria.

HTTP-Goiburua noiz: ['berria'] egin: { <- norbera berria hasieratu.
}.

HTTP-Goiburua noiz: ['hasieratu'] egin: {
	berezko gakoa := Ezer.
	berezko balioa := Ezer.
}.

HTTP-Goiburua noiz: ['gakoa:balioa:'] egin: { :gakoa :balioa
	berezko gakoa := gakoa.
	berezko balioa := balioa.
}.

HTTP-Goiburua noiz: ['gakoa'] egin: { <- berezko gakoa.
}.

HTTP-Goiburua noiz: ['balioa'] egin: { <- berezko balioa.
}.


HTTP-Goiburua noiz: ['testua'] egin: {
	>> lerroa := berezko gakoa + [': '] + berezko balioa.
	lerroa ordeztu: ['\r'] honekin: [''], ordeztu: ['\n'] honekin: ['']. <- lerroa + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-dokumentua := Objektua berria.

Web-dokumentua noiz: ['berria'] egin: { <- norbera berria hasieratu.
}.

Web-dokumentua noiz: ['hasieratu'] egin: {
	berezko goiburuak := Zerrenda berria.
	berezko saio-id := Ezer.
	berezko saio-kudeatzailea := Behin-behineko-fitxategi-saioa berria.
	berezko saio-datuak := Ezer.
	berezko segurua := Egia.
	berezko gune-bera := ['Strict'].
	berezko goiburuak-bidalita := Faltsua.
	berezko eskaera := HTTP-Eskaera berria.
}.

Web-dokumentua noiz: ['eskaera:'] egin: { :eskaera
	berezko eskaera := eskaera.
}. 

Web-dokumentua noiz: ['saio-cookie-segurua:'] egin: { :segurua
	norbera egiaztatu-goiburuak.
	berezko segurua := segurua.
}.

Web-dokumentua noiz: ['gune-bereko-saio-cookiea:'] egin: { :balioa
	norbera egiaztatu-goiburuak.
	>> aukerak := Zerrenda berria 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	aukerak dauka: balioa, faltsua: {
		ataza-hau errorea: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	berezko gune-bera := balioa.
}.

Web-dokumentua noiz: ['goiburua:'] egin: { :goiburua
	norbera egiaztatu-goiburuak.
	berezko goiburuak erantsi: goiburua.
}.

Web-dokumentua noiz: ['hustu-goiburuak'] egin: {
	norbera egiaztatu-goiburuak.
	berezko goiburuak := Zerrenda berria.
}.

Web-dokumentua noiz: ['saio-kudeatzailea:'] egin: { :kudeatzailea
	norbera egiaztatu-goiburuak.
	berezko saio-kudeatzailea := kudeatzailea.
}.

Web-dokumentua noiz: ['saio-kudeatzailea'] egin: { <- berezko saio-kudeatzailea.
}.

Web-dokumentua noiz: ['egiaztatu-goiburuak'] egin: {
	berezko goiburuak-bidalita egia: {
		ataza-hau errorea: ['Headers already sent to client.'].
	}.
}.

Web-dokumentua noiz: ['hasi-saioa'] egin: {
	norbera egiaztatu-goiburuak.
	>> eskaera := berezko eskaera.
	>> saio-id := eskaera cookie: ['xsid'].
	saio-id Ezer? faltsua: {
		(( Eredua berria: ['^[A-Za-z0-9]+\\z'], bat-etortzea: saio-id ) = 0) egia: {
			saio-id := Ezer.
		}.
	}.
	saio-id Ezer? egia: {
		saio-id := Kutxa-gotorra token: 30.
		>> saio-goiburua := HTTP-Goiburua berria
		gakoa: ['Set-Cookie'] balioa: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (berezko segurua edo: ['Secure'] edo: ['']),
		SSITE: (berezko gune-bera),
		XSID: saio-id
		).
		berezko goiburuak erantsi: saio-goiburua.
	}.
	berezko saio-datuak := berezko saio-kudeatzailea honentzat: saio-id, kargatu. <- berezko saio-datuak. # reference
}.

Web-dokumentua noiz: ['joan:'] egin: { :helbidea
	norbera egiaztatu-goiburuak.
	norbera hustu-goiburuak.
	berezko goiburuak
	erantsi: (
		HTTP-Goiburua berria
		gakoa: ['Status'] balioa: ['303 See Other']
	),
	erantsi: (
		HTTP-Goiburua berria
		gakoa: ['Location'] balioa: helbidea
	).
	norbera irteera-eman: ['Redirect'].
}.

Web-dokumentua noiz: ['suntsitu-saioa'] egin: {
	norbera egiaztatu-goiburuak.
	>> eskaera := berezko eskaera.
	>> saio-id := eskaera cookie: ['xsid'].
	saio-id Ezer? faltsua: {
		>> saio-goiburua := HTTP-Goiburua berria.
		>> unea := Unea berria urtea: 1970, formatua: ['%a, %d %b %Y %H:%M:%S GMT'].
		saio-goiburua gakoa: ['Set-Cookie'] balioa: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: unea,
			SEC: (berezko segurua edo: ['Secure'] edo: ['']),
			SSITE: (berezko gune-bera),
			XSID: saio-id
		).
		berezko saio-kudeatzailea suntsitu.
		berezko goiburuak erantsi: saio-goiburua.
	}.
}.


Web-dokumentua noiz: ['txantiloia:'] egin: { :bidea <- Txantiloia berria: (Fitxategia berria: bidea, irakurri).
}.

Web-dokumentua noiz: ['irteera-eman:mota:'] egin: { :irteera :mota
	berezko goiburuak-bidalita faltsua: {
		berezko saio-datuak Ezer? faltsua: {
			berezko saio-kudeatzailea gorde: berezko saio-datuak.
		}.
		berezko goiburuak erantsi: (
			HTTP-Goiburua berria
			gakoa: ['Content-type'] balioa: mota
		).
		berezko goiburuak bakoitza: { :_ :goiburua
			Irteera idatzi: goiburua.
		}.
		berezko goiburuak-bidalita := Egia.
		Irteera idatzi: ['\r\n'].
	}.
	Irteera idatzi: irteera.
}.

Web-dokumentua noiz: ['amaitu:mota:'] egin: { :irteera :mota
	berezko goiburuak-bidalita faltsua: {
		berezko saio-datuak Ezer? faltsua: {
			berezko saio-kudeatzailea gorde: berezko saio-datuak.
		}.
		berezko goiburuak erantsi: (
			HTTP-Goiburua berria
			gakoa: ['Content-type'] balioa: mota
		).
		berezko goiburuak erantsi: (
			HTTP-Goiburua berria
			gakoa: ['Content-Length'] balioa: irteera testua bytes
		).
		berezko goiburuak bakoitza: { :_ :goiburua
			Irteera idatzi: goiburua.
		}.
		berezko goiburuak-bidalita := Egia.
		Irteera idatzi: ['\r\n'].
	}.
	Irteera idatzi: irteera.
}.

Web-dokumentua noiz: ['irteera-eman:'] egin: { :irteera
	norbera irteera-eman: irteera mota: ['text/html; charset=utf-8'].
}.

Web-dokumentua noiz: ['amaitu:'] egin: { :irteera
	norbera amaitu: irteera mota: ['text/html; charset=utf-8'].
}.

Web-dokumentua noiz: ['json:'] egin: { :irteera
	norbera irteera-eman: ( JSON jsonify: irteera ) mota: ['application/json'].
}.

Web-dokumentua noiz: ['ez-da-aurkitu:'] egin: { :irteera
	norbera hustu-goiburuak goiburua: (
		HTTP-Goiburua berria gakoa: ['Status'] balioa: ['404 Not Found']
	).
	norbera irteera-eman: irteera.
}.


# Interface

>> Saioa := Objektua berria.

Saioa noiz: ['berria'] egin: { <- norbera berria hasieratu honentzat: Ezer.
}.

Saioa noiz: ['honentzat:'] egin: { :id
	berezko id := id.
}.

Saioa noiz: ['kargatu'] egin: {
	ataza-hau errorea: ['Not implemented.'].
}.

Saioa noiz: ['gorde:'] egin: {
	ataza-hau errorea: ['Not implemented.'].
}.

Saioa noiz: ['suntsitu'] egin: {
	ataza-hau errorea: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Behin-behineko-fitxategi-saioa := Saioa berria.

Behin-behineko-fitxategi-saioa noiz: ['hasieratu'] egin: {
	berezko bide-hasiera := ['/tmp/sess-'].
}.

Behin-behineko-fitxategi-saioa noiz: ['bide-aurrizkia:'] egin: { :katea
	berezko bide-hasiera := katea.
}.

Behin-behineko-fitxategi-saioa noiz: ['fitxategia'] egin: { <- ( Fitxategia berria: ( berezko bide-hasiera + berezko id + ['.txt'] ) ).
}.

Behin-behineko-fitxategi-saioa noiz: ['kargatu'] egin: {
	>> fitxategia := norbera fitxategia.
	fitxategia badago faltsua: {
		fitxategia idatzi: (Hiztegia berria kodea).
	}. <- fitxategia irakurri objektua.
}.

Behin-behineko-fitxategi-saioa noiz: ['gorde:'] egin: { :datuak
	>> fitxategia := norbera fitxategia.
	fitxategia badago egia: {
		fitxategia idatzi: datuak kodea.
	}.
}.

Behin-behineko-fitxategi-saioa noiz: ['suntsitu'] egin: {
	>> fitxategia := norbera fitxategia.
	fitxategia badago egia: {
		fitxategia ezabatu.
	}.
}.


>> URL := Objektua berria.

URL noiz: ['hasieratu'] egin: {
	berezko protokoloa := ['https://'].
	berezko ostalaria := ['localhost'].
	berezko bidea := [''].
	berezko url-parametroak := [''].
	berezko hash := [''].
}.

URL noiz: ['berria'] egin: { <- norbera berria hasieratu.
}.

URL noiz: ['testua'] egin: { <- (
	berezko protokoloa +
	berezko ostalaria +
	berezko bidea +
	berezko url-parametroak +
	berezko hash ).
}.

URL noiz: ['protokoloa:'] egin: { :protokoloa
	((Zerrenda berria ; ['http'] ; ['https']) dauka: protokoloa) egia: {
		berezko protokoloa := protokoloa + ['://'].
	}, faltsua: {
		ataza-hau errorea: ['Invalid protocol'].
	}.
}.

URL noiz: ['ostalaria:'] egin: { :ostalaria
	#todo validate according to rfc
	berezko ostalaria := ostalaria.
}.

URL noiz: ['bidea:'] egin: { :bidea
	berezko bidea := ['/'] + bidea url-kodetu.
}.

URL noiz: ['url-parametroak:'] egin: { :mapaketa
	>> url-parametroak := Zerrenda berria.
	mapaketa bakoitza: { :gakoa :balioa
		url-parametroak erantsi: gakoa testua url-kodetu + ['='] + balioa testua url-kodetu.
	}.
	berezko url-parametroak := ['?'] + ( url-parametroak batu: ['&'] ).
}.

URL noiz: ['laburpena:'] egin: { :hash
	berezko hash := ['#'] + hash url-kodetu.
}.

