>> Posta := Objektua berria.

Posta noiz: ['hasieratu'] egin: {
	berezko hartzaileak := Zerrenda berria.
	berezko cc := Zerrenda berria.
	berezko bcc := Zerrenda berria.
	berezko igorlea := Ezer.
	berezko igorlearen-izena := Ezer.
	berezko gaia := Ezer.
	berezko gorputza := Ezer.
}.

Posta noiz: ['berria'] egin: { <- norbera berria hasieratu.
}.

Posta noiz: ['hartzailea:'] egin: { :zerrendatzea
	berezko hartzaileak := zerrendatzea.
}.
 
Posta noiz: ['cc:'] egin: { :zerrendatzea
	berezko cc := zerrendatzea.
}.

Posta noiz: ['bcc:'] egin: { :zerrendatzea
	berezko bcc := zerrendatzea.
}.

Posta noiz: ['gaia:'] egin: { :gaia
	berezko gaia := gaia.
}.

Posta noiz: ['igorlea:izena:'] egin: { :igorlea :izena
	berezko igorlea := igorlea.
	berezko igorlearen-izena := izena.
}.

Posta noiz: ['gorputza:'] egin: { :gorputza
	berezko gorputza := gorputza.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Posta noiz: ['goiburua:'] egin: { :lerroa <- lerroa ordeztu: ['\r'] honekin: [''], ordeztu: ['\n'] honekin: [''].
}.

Posta noiz: ['bidali'] egin: {
	>> f := Fitxategia tempwrite: norbera sortu.
	Programa sistema: ['sendmail -t < '] + f bidea, lerro-jauzia.
}.

Posta noiz: ['sortu'] egin: {
	>> crlf := ['\r\n'].
	>> katea := [''].
	katea erantsi: (norbera goiburua: ['From: '] + berezko igorlearen-izena + [' <'] + ( berezko igorlea ) + ['>']) + crlf.
	katea erantsi: (norbera goiburua: ['To: '] + ( berezko hartzaileak batu: [','] )) + crlf.
	berezko cc zenbatu egia: {
		katea erantsi: (norbera goiburua: ['Cc: '] + ( berezko cc batu: [','] )) + crlf.
	}.
	berezko bcc zenbatu egia: {
		katea erantsi: (norbera goiburua: ['Bcc: '] + ( berezko bcc batu: [','] )) + crlf.
	}.
	katea erantsi: (norbera goiburua: ['Subject: '] + berezko gaia) + crlf.
	katea erantsi: crlf.
	katea erantsi: berezko gorputza.
	katea erantsi: crlf. <- katea.
}.

>> HTML-Posta := Posta berria.

HTML-Posta noiz: ['hasieratu'] egin: {
	norbera hasieratu.
	berezko eranskinak := Zerrenda berria.
	berezko muga := Kutxa-gotorra token: 40.
}.

HTML-Posta noiz: ['erantsi-fitxategia:'] egin: { :fitxategia
	>> id := berezko eranskinak zenbatu.
	>> blob := fitxategia blob.
	berezko eranskinak erantsi: (
		Hiztegia berria
			fitxategia: fitxategia bidea,
			mime: ['image/'] + (Server mimetype: fitxategia bidea),
			datuak: blob base64-kodetu
	).
	blob askatu. <- ['cid:attachment'] + id.
}.

HTML-Posta noiz: ['sortu'] egin: {
	>> crlf := ['\r\n'].
	>> katea := [''].
	katea erantsi: (norbera goiburua: ['From: '] + berezko igorlearen-izena + [' <'] + ( berezko igorlea ) + ['>']) + crlf.
	katea erantsi: (norbera goiburua: ['To: '] + ( berezko hartzaileak batu: [','] )) + crlf.
	berezko cc zenbatu egia: {
		katea erantsi: (norbera goiburua: ['Cc: '] + ( berezko cc batu: [','] )) + crlf.
	}.
	berezko bcc zenbatu egia: {
		katea erantsi: (norbera goiburua: ['Bcc: '] + ( berezko bcc batu: [','] )) + crlf.
	}.
	katea erantsi: (norbera goiburua: ['Subject: '] + berezko gaia) + crlf.
	katea erantsi: ['MIME-Version: 1.0'] + crlf.
	katea erantsi: ['Content-Type: multipart/related; boundary="'] + berezko muga + ['"; type=text/html'] + crlf.
	katea erantsi: crlf.
	katea erantsi: ['--'] + berezko muga + crlf.
	katea erantsi: ['Content-Type: text/html; charset=UTF-8'] + crlf.
	katea erantsi: ['Content-Transfer-Encoding: 7bit'] + crlf.
	katea erantsi: crlf.
	katea erantsi: berezko gorputza.
	katea erantsi: crlf.
	berezko eranskinak bakoitza: { :id :info
		>> blob := info datuak.
		katea erantsi: ['--'] + berezko muga + crlf.
		katea erantsi: ['Content-Type: '] + info mime + crlf.
		katea erantsi: ['Content-Transfer-Encoding: base64'] + crlf.
		katea erantsi: ['Content-ID: <attachment'] + id + ['>'] + crlf.
		katea erantsi: ['Content-Disposition: inline; filename="'] + info fitxategia + ['"'] + crlf.
		katea erantsi: crlf.
		>> gehienez := 76.
		>> testu-luzera := blob luzera.
		>> puskak := (testu-luzera / gehienez) gora-biribildu.
		{ :i
			>> puska := blob kopiatu nondik: i * gehienez luzera: gehienez.
			katea erantsi: puska + crlf.
		} * puskak.
		katea erantsi: crlf.
		katea erantsi: crlf.
	}.
	katea erantsi: ['--'] + berezko muga + ['--'] + crlf. <- katea.
}.
