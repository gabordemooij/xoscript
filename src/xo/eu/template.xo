
# ~ Simple template engine ~

>> Txantiloia := Objektua berria.

Txantiloia noiz: ['berria'] egin: { <- norbera berria edukia: [''].
}.

Txantiloia noiz: ['edukia:'] egin: { :edukia
	berezko edukia := edukia. 
}.

Txantiloia noiz: ['berria:'] egin: { :edukia <- norbera berria edukia: edukia.
}.

Txantiloia noiz: ['ebaki:'] egin: { :marka
	>> hasiera-marka := (['<!-- cut:%id% -->'] %id%: marka).
	>> amaiera-marka := (['<!-- /cut:%id% -->'] %id%: marka).
	>> zatitxoak := berezko edukia zatitu: hasiera-marka.
	>> aurrizkia := zatitxoak lehena.
	>> zatitxoak2 := zatitxoak azkena zatitu: amaiera-marka.
	>> atzizkia := zatitxoak2 azkena.
	>> zatitxoa := zatitxoak2 lehena.
	>> gainerakoa := aurrizkia + atzizkia.
	berezko edukia := gainerakoa. <- Txantiloia berria: zatitxoa.
	
}.

Txantiloia noiz: ['kopiatu'] egin: { <- norbera berria: norbera testua kopiatu.
}.
	
Txantiloia noiz: ['itsatsi:non:'] egin: { :pasartea :id
	>> itsaste-marka := (['<!-- paste:%id% -->'] %id%: id).
	berezko edukia ordeztu: itsaste-marka honekin: ( pasartea testua + itsaste-marka ).
}.

Txantiloia noiz: ['ezarri:balioa:'] egin: { :tartea :balioa
	berezko edukia ordeztu: ['<!-- slot:'] + tartea + [' -->'] honekin: ( Server html-kodetu: balioa ).
}.

Txantiloia noiz: ['ezarri:html:'] egin: { :tartea :html
	berezko edukia ordeztu: ['<!-- slot:'] + tartea + [' -->'] honekin: html.
}.

Txantiloia noiz: ['erantzun:eta:'] egin: { :tartea :balioa
	norbera ezarri: (tartea nondik: 0 luzera: (tartea luzera - 1)) balioa: balioa.
}.

Txantiloia noiz: ['nl2br'] egin: {
	berezko edukia ordeztu: ['\n'] honekin: ['<br>'].
}.

Txantiloia noiz: ['txukundu'] egin: {
	berezko edukia :=
		Eredua
		berria: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		bat-etortzea: berezko edukia
		egin: { <- ['']. }.
}.

Txantiloia noiz: ['txukundu-ebakiak'] egin: {
	>> elementuak := Zerrenda berria.
	Eredua
	berria: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	bat-etortzea: berezko edukia
	egin: { :_ :zatitxoa
		elementuak erantsi: zatitxoa ? 1.
	}.
	elementuak bakoitza: { :_ :id
		berezko edukia :=
			Eredua berria: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			bat-etortzea: berezko edukia
			egin: { <- ['']. }.
	 }.
}.

Txantiloia noiz: ['txukundu-zuriuneak'] egin: {
	berezko edukia :=
		Eredua
		berria: ['\\s*\\n'],
		bat-etortzea: berezko edukia
		egin: { <- ['\n']. }.
	berezko edukia :=
		Eredua
		berria: ['\\n[\\s\\t]+'],
		bat-etortzea: berezko edukia
		egin: { <- ['\n']. }.
}.

Txantiloia noiz: ['txukundu-dena'] egin: {
	norbera txukundu.
	norbera txukundu-ebakiak.
	norbera txukundu-zuriuneak.
}.

Txantiloia noiz: ['testua'] egin: { <- berezko edukia.
}.
