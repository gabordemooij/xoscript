
# ~ Simple template engine ~

>> قېلىپ := ئوبيېكت يېڭى.

قېلىپ كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى مەزمۇن: [''].
}.

قېلىپ كەلگەندە: ['مەزمۇن:'] قىل: { :مەزمۇن
	ئۆزىنىڭ مەزمۇن := مەزمۇن. 
}.

قېلىپ كەلگەندە: ['يېڭى:'] قىل: { :مەزمۇن <- ئۆزى يېڭى مەزمۇن: مەزمۇن.
}.

قېلىپ كەلگەندە: ['كەس:'] قىل: { :بەلگە
	>> باشلىنىش-بەلگىسى := (['<!-- cut:%id% -->'] %id%: بەلگە).
	>> ئاخىرلىشىش-بەلگىسى := (['<!-- /cut:%id% -->'] %id%: بەلگە).
	>> قىسىملار := ئۆزىنىڭ مەزمۇن پارچىلا: باشلىنىش-بەلگىسى.
	>> ئالدى-قوشۇلغۇچى := قىسىملار بىرىنچى.
	>> قىسىملار2 := قىسىملار ئاخىرقى پارچىلا: ئاخىرلىشىش-بەلگىسى.
	>> ئارقا-قوشۇلغۇچى := قىسىملار2 ئاخىرقى.
	>> قىسىم := قىسىملار2 بىرىنچى.
	>> قالدۇق := ئالدى-قوشۇلغۇچى + ئارقا-قوشۇلغۇچى.
	ئۆزىنىڭ مەزمۇن := قالدۇق. <- قېلىپ يېڭى: قىسىم.
	
}.

قېلىپ كەلگەندە: ['كۆچۈر'] قىل: { <- ئۆزى يېڭى: ئۆزى تېكىستكە كۆچۈر.
}.
	
قېلىپ كەلگەندە: ['چاپلا:ئاچقۇچ:'] قىل: { :ئۈزۈندە :id
	>> چاپلاش-بەلگىسى := (['<!-- paste:%id% -->'] %id%: id).
	ئۆزىنىڭ مەزمۇن ئالماشتۇر: چاپلاش-بەلگىسى بىلەن: ( ئۈزۈندە تېكىستكە + چاپلاش-بەلگىسى ).
}.

قېلىپ كەلگەندە: ['بەلگىلە:قىممەت:'] قىل: { :ئورۇن :قىممەت
	ئۆزىنىڭ مەزمۇن ئالماشتۇر: ['<!-- slot:'] + ئورۇن + [' -->'] بىلەن: ( Server html-كودلاش: قىممەت ).
}.

قېلىپ كەلگەندە: ['بەلگىلە:html:'] قىل: { :ئورۇن :html
	ئۆزىنىڭ مەزمۇن ئالماشتۇر: ['<!-- slot:'] + ئورۇن + [' -->'] بىلەن: html.
}.

قېلىپ كەلگەندە: ['جاۋاب:ۋە:'] قىل: { :ئورۇن :قىممەت
	ئۆزى بەلگىلە: (ئورۇن باشلىنىش: 0 ئۇزۇنلۇق: (ئورۇن ئۇزۇنلۇق - 1)) قىممەت: قىممەت.
}.

قېلىپ كەلگەندە: ['nl2br'] قىل: {
	ئۆزىنىڭ مەزمۇن ئالماشتۇر: ['\n'] بىلەن: ['<br>'].
}.

قېلىپ كەلگەندە: ['رەتلە'] قىل: {
	ئۆزىنىڭ مەزمۇن :=
		ئەندىزە
		يېڭى: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ماسلىق: ئۆزىنىڭ مەزمۇن
		قىل: { <- ['']. }.
}.

قېلىپ كەلگەندە: ['كېسىمىلەرنى-رەتلە'] قىل: {
	>> تۈرلەر := تىزىم يېڭى.
	ئەندىزە
	يېڭى: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ماسلىق: ئۆزىنىڭ مەزمۇن
	قىل: { :_ :قىسىم
		تۈرلەر ئاخىرىغا-قوش: قىسىم ? 1.
	}.
	تۈرلەر ھەربىر: { :_ :id
		ئۆزىنىڭ مەزمۇن :=
			ئەندىزە يېڭى: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ماسلىق: ئۆزىنىڭ مەزمۇن
			قىل: { <- ['']. }.
	 }.
}.

قېلىپ كەلگەندە: ['بوشلۇقلارنى-رەتلە'] قىل: {
	ئۆزىنىڭ مەزمۇن :=
		ئەندىزە
		يېڭى: ['\\s*\\n'],
		ماسلىق: ئۆزىنىڭ مەزمۇن
		قىل: { <- ['\n']. }.
	ئۆزىنىڭ مەزمۇن :=
		ئەندىزە
		يېڭى: ['\\n[\\s\\t]+'],
		ماسلىق: ئۆزىنىڭ مەزمۇن
		قىل: { <- ['\n']. }.
}.

قېلىپ كەلگەندە: ['ھەممىنى-رەتلە'] قىل: {
	ئۆزى رەتلە.
	ئۆزى كېسىمىلەرنى-رەتلە.
	ئۆزى بوشلۇقلارنى-رەتلە.
}.

قېلىپ كەلگەندە: ['تېكىستكە'] قىل: { <- ئۆزىنىڭ مەزمۇن.
}.
