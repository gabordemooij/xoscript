>> ئېلخەت := ئوبيېكت يېڭى.

ئېلخەت كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزىنىڭ تاپشۇرۇۋالغۇچىلار := تىزىم يېڭى.
	ئۆزىنىڭ cc := تىزىم يېڭى.
	ئۆزىنىڭ bcc := تىزىم يېڭى.
	ئۆزىنىڭ يوللىغۇچى := قۇرۇق.
	ئۆزىنىڭ يوللىغۇچى-ئىسمى := قۇرۇق.
	ئۆزىنىڭ تېما := قۇرۇق.
	ئۆزىنىڭ ئاساسىي-تېكىست := قۇرۇق.
}.

ئېلخەت كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى دەسلەپلەشتۈر.
}.

ئېلخەت كەلگەندە: ['تاپشۇرۇۋالغۇچىغا:'] قىل: { :تىزىملاش
	ئۆزىنىڭ تاپشۇرۇۋالغۇچىلار := تىزىملاش.
}.
 
ئېلخەت كەلگەندە: ['cc:'] قىل: { :تىزىملاش
	ئۆزىنىڭ cc := تىزىملاش.
}.

ئېلخەت كەلگەندە: ['bcc:'] قىل: { :تىزىملاش
	ئۆزىنىڭ bcc := تىزىملاش.
}.

ئېلخەت كەلگەندە: ['تېما:'] قىل: { :تېما
	ئۆزىنىڭ تېما := تېما.
}.

ئېلخەت كەلگەندە: ['يوللىغۇچى:ئات:'] قىل: { :يوللىغۇچى :ئات
	ئۆزىنىڭ يوللىغۇچى := يوللىغۇچى.
	ئۆزىنىڭ يوللىغۇچى-ئىسمى := ئات.
}.

ئېلخەت كەلگەندە: ['ئاساسىي-تېكىست:'] قىل: { :ئاساسىي-تېكىست
	ئۆزىنىڭ ئاساسىي-تېكىست := ئاساسىي-تېكىست.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
ئېلخەت كەلگەندە: ['باش:'] قىل: { :قۇر <- قۇر ئالماشتۇر: ['\r'] بىلەن: [''], ئالماشتۇر: ['\n'] بىلەن: [''].
}.

ئېلخەت كەلگەندە: ['يوللا'] قىل: {
	>> f := ھۆججەت ۋاقىتلىق-يېزىش: ئۆزى ھاسىل-قىل.
	پروگرامما سىستېما: ['sendmail -t < '] + f ھۆججەت-يولى, يېڭى-قۇر.
}.

ئېلخەت كەلگەندە: ['ھاسىل-قىل'] قىل: {
	>> قۇر-ئۈزۈش := ['\r\n'].
	>> ھەرپ-تىزمىسى := [''].
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['From: '] + ئۆزىنىڭ يوللىغۇچى-ئىسمى + [' <'] + ( ئۆزىنىڭ يوللىغۇچى ) + ['>']) + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['To: '] + ( ئۆزىنىڭ تاپشۇرۇۋالغۇچىلار بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	ئۆزىنىڭ cc سانى راست-بولسا: {
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Cc: '] + ( ئۆزىنىڭ cc بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	}.
	ئۆزىنىڭ bcc سانى راست-بولسا: {
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Bcc: '] + ( ئۆزىنىڭ bcc بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	}.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Subject: '] + ئۆزىنىڭ تېما) + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ئۆزىنىڭ ئاساسىي-تېكىست.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش. <- ھەرپ-تىزمىسى.
}.

>> ئېلخەت-HTML := ئېلخەت يېڭى.

ئېلخەت-HTML كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزى دەسلەپلەشتۈر.
	ئۆزىنىڭ قوشۇمچىلار := تىزىم يېڭى.
	ئۆزىنىڭ چېگرا := ساندۇق بەلگە: 40.
}.

ئېلخەت-HTML كەلگەندە: ['قوشۇمچە-قوش:'] قىل: { :سۆھبەت-ھۆججىتى
	>> id := ئۆزىنىڭ قوشۇمچىلار سانى.
	>> blob := سۆھبەت-ھۆججىتى blob.
	ئۆزىنىڭ قوشۇمچىلار ئاخىرىغا-قوش: (
		لۇغەت يېڭى
			سۆھبەت-ھۆججىتى: سۆھبەت-ھۆججىتى ھۆججەت-يولى,
			mime: ['image/'] + (Server mimetype: سۆھبەت-ھۆججىتى ھۆججەت-يولى),
			سانلىق-مەلۇمات: blob base64-كودلاش
	).
	blob بوشات. <- ['cid:attachment'] + id.
}.

ئېلخەت-HTML كەلگەندە: ['ھاسىل-قىل'] قىل: {
	>> قۇر-ئۈزۈش := ['\r\n'].
	>> ھەرپ-تىزمىسى := [''].
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['From: '] + ئۆزىنىڭ يوللىغۇچى-ئىسمى + [' <'] + ( ئۆزىنىڭ يوللىغۇچى ) + ['>']) + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['To: '] + ( ئۆزىنىڭ تاپشۇرۇۋالغۇچىلار بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	ئۆزىنىڭ cc سانى راست-بولسا: {
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Cc: '] + ( ئۆزىنىڭ cc بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	}.
	ئۆزىنىڭ bcc سانى راست-بولسا: {
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Bcc: '] + ( ئۆزىنىڭ bcc بىرلەشتۈر: [','] )) + قۇر-ئۈزۈش.
	}.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: (ئۆزى باش: ['Subject: '] + ئۆزىنىڭ تېما) + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['MIME-Version: 1.0'] + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Type: multipart/related; boundary="'] + ئۆزىنىڭ چېگرا + ['"; type=text/html'] + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['--'] + ئۆزىنىڭ چېگرا + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Type: text/html; charset=UTF-8'] + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Transfer-Encoding: 7bit'] + قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ئۆزىنىڭ ئاساسىي-تېكىست.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
	ئۆزىنىڭ قوشۇمچىلار ھەربىر: { :id :ئۇچۇر
		>> blob := ئۇچۇر سانلىق-مەلۇمات.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['--'] + ئۆزىنىڭ چېگرا + قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Type: '] + ئۇچۇر mime + قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Transfer-Encoding: base64'] + قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-ID: <attachment'] + id + ['>'] + قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['Content-Disposition: inline; filename="'] + ئۇچۇر سۆھبەت-ھۆججىتى + ['"'] + قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
		>> ئەڭ-كۆپ := 76.
		>> تېكىست-ئۇزۇنلۇقى := blob ئۇزۇنلۇق.
		>> پارچىلار := (تېكىست-ئۇزۇنلۇقى / ئەڭ-كۆپ) يۇقىرىغا-پۈتۈنلە.
		{ :i
			>> پارچە := blob كۆچۈر باشلىنىش: i * ئەڭ-كۆپ ئۇزۇنلۇق: ئەڭ-كۆپ.
			ھەرپ-تىزمىسى ئاخىرىغا-قوش: پارچە + قۇر-ئۈزۈش.
		} * پارچىلار.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
		ھەرپ-تىزمىسى ئاخىرىغا-قوش: قۇر-ئۈزۈش.
	}.
	ھەرپ-تىزمىسى ئاخىرىغا-قوش: ['--'] + ئۆزىنىڭ چېگرا + ['--'] + قۇر-ئۈزۈش. <- ھەرپ-تىزمىسى.
}.
