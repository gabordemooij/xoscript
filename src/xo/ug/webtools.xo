ئىلتىماس-HTTP كەلگەندە: ['HTTP-باش:'] قىل: { :ئاچقۇچ <- پروگرامما تەڭشەك: ئاچقۇچ.
}.

>> HTTP-باش := ئوبيېكت يېڭى.

HTTP-باش كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى دەسلەپلەشتۈر.
}.

HTTP-باش كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزىنىڭ ئاچقۇچ := قۇرۇق.
	ئۆزىنىڭ قىممەت := قۇرۇق.
}.

HTTP-باش كەلگەندە: ['ئاچقۇچ:قىممەت:'] قىل: { :ئاچقۇچ :قىممەت
	ئۆزىنىڭ ئاچقۇچ := ئاچقۇچ.
	ئۆزىنىڭ قىممەت := قىممەت.
}.

HTTP-باش كەلگەندە: ['ئاچقۇچ'] قىل: { <- ئۆزىنىڭ ئاچقۇچ.
}.

HTTP-باش كەلگەندە: ['قىممەت'] قىل: { <- ئۆزىنىڭ قىممەت.
}.


HTTP-باش كەلگەندە: ['تېكىستكە'] قىل: {
	>> قۇر := ئۆزىنىڭ ئاچقۇچ + [': '] + ئۆزىنىڭ قىممەت.
	قۇر ئالماشتۇر: ['\r'] بىلەن: [''], ئالماشتۇر: ['\n'] بىلەن: ['']. <- قۇر + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> تور-ھۆججىتى := ئوبيېكت يېڭى.

تور-ھۆججىتى كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى دەسلەپلەشتۈر.
}.

تور-ھۆججىتى كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزىنىڭ باشلار := تىزىم يېڭى.
	ئۆزىنىڭ سۆھبەت-id := قۇرۇق.
	ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى := ۋاقىتلىق-ھۆججەت-سۆھبىتى يېڭى.
	ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى := قۇرۇق.
	ئۆزىنىڭ بىخەتەر := راست.
	ئۆزىنىڭ ئوخشاش-تور-بېكەت := ['Strict'].
	ئۆزىنىڭ باشلار-يوللاندى := يالغان.
	ئۆزىنىڭ تەلەپ-http := ئىلتىماس-HTTP يېڭى.
}.

تور-ھۆججىتى كەلگەندە: ['تەلەپ-http:'] قىل: { :تەلەپ-http
	ئۆزىنىڭ تەلەپ-http := تەلەپ-http.
}. 

تور-ھۆججىتى كەلگەندە: ['بىخەتەر-سۆھبەت-cookie:'] قىل: { :بىخەتەر
	ئۆزى باشلارنى-تەكشۈر.
	ئۆزىنىڭ بىخەتەر := بىخەتەر.
}.

تور-ھۆججىتى كەلگەندە: ['ئوخشاش-تور-بېكەت-سۆھبەت-cookie:'] قىل: { :قىممەت
	ئۆزى باشلارنى-تەكشۈر.
	>> تاللانمىلار := تىزىم يېڭى 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	تاللانمىلار بار: قىممەت, يالغان-بولسا: {
		بۇ-ۋەزىپە خاتالىق: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ئۆزىنىڭ ئوخشاش-تور-بېكەت := قىممەت.
}.

تور-ھۆججىتى كەلگەندە: ['باش:'] قىل: { :باش
	ئۆزى باشلارنى-تەكشۈر.
	ئۆزىنىڭ باشلار ئاخىرىغا-قوش: باش.
}.

تور-ھۆججىتى كەلگەندە: ['باشلارنى-قۇرۇقدا'] قىل: {
	ئۆزى باشلارنى-تەكشۈر.
	ئۆزىنىڭ باشلار := تىزىم يېڭى.
}.

تور-ھۆججىتى كەلگەندە: ['سۆھبەت-باشقۇرغۇچى:'] قىل: { :باشقۇرغۇچى
	ئۆزى باشلارنى-تەكشۈر.
	ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى := باشقۇرغۇچى.
}.

تور-ھۆججىتى كەلگەندە: ['سۆھبەت-باشقۇرغۇچى'] قىل: { <- ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى.
}.

تور-ھۆججىتى كەلگەندە: ['باشلارنى-تەكشۈر'] قىل: {
	ئۆزىنىڭ باشلار-يوللاندى راست-بولسا: {
		بۇ-ۋەزىپە خاتالىق: ['Headers already sent to client.'].
	}.
}.

تور-ھۆججىتى كەلگەندە: ['سۆھبەتنى-باشلا'] قىل: {
	ئۆزى باشلارنى-تەكشۈر.
	>> تەلەپ-http := ئۆزىنىڭ تەلەپ-http.
	>> سۆھبەت-id := تەلەپ-http cookie: ['xsid'].
	سۆھبەت-id قۇرۇق? يالغان-بولسا: {
		(( ئەندىزە يېڭى: ['^[A-Za-z0-9]+\\z'], ماسلىق: سۆھبەت-id ) = 0) راست-بولسا: {
			سۆھبەت-id := قۇرۇق.
		}.
	}.
	سۆھبەت-id قۇرۇق? راست-بولسا: {
		سۆھبەت-id := ساندۇق بەلگە: 30.
		>> سۆھبەت-بېشى := HTTP-باش يېڭى
		ئاچقۇچ: ['Set-Cookie'] قىممەت: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ئۆزىنىڭ بىخەتەر بۇ: ['Secure'] ياكى-ئۇ: ['']),
		SSITE: (ئۆزىنىڭ ئوخشاش-تور-بېكەت),
		XSID: سۆھبەت-id
		).
		ئۆزىنىڭ باشلار ئاخىرىغا-قوش: سۆھبەت-بېشى.
	}.
	ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى := ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى ئۈچۈن: سۆھبەت-id, يۈكلە. <- ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى. # reference
}.

تور-ھۆججىتى كەلگەندە: ['ئاتلا:'] قىل: { :ئادرېس
	ئۆزى باشلارنى-تەكشۈر.
	ئۆزى باشلارنى-قۇرۇقدا.
	ئۆزىنىڭ باشلار
	ئاخىرىغا-قوش: (
		HTTP-باش يېڭى
		ئاچقۇچ: ['Status'] قىممەت: ['303 See Other']
	),
	ئاخىرىغا-قوش: (
		HTTP-باش يېڭى
		ئاچقۇچ: ['Location'] قىممەت: ئادرېس
	).
	ئۆزى چىقار: ['Redirect'].
}.

تور-ھۆججىتى كەلگەندە: ['سۆھبەتنى-يوقات'] قىل: {
	ئۆزى باشلارنى-تەكشۈر.
	>> تەلەپ-http := ئۆزىنىڭ تەلەپ-http.
	>> سۆھبەت-id := تەلەپ-http cookie: ['xsid'].
	سۆھبەت-id قۇرۇق? يالغان-بولسا: {
		>> سۆھبەت-بېشى := HTTP-باش يېڭى.
		>> ۋاقىت-چېكى := پەيت يېڭى يىل: 1970, فورماتتا: ['%a, %d %b %Y %H:%M:%S GMT'].
		سۆھبەت-بېشى ئاچقۇچ: ['Set-Cookie'] قىممەت: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: ۋاقىت-چېكى,
			SEC: (ئۆزىنىڭ بىخەتەر بۇ: ['Secure'] ياكى-ئۇ: ['']),
			SSITE: (ئۆزىنىڭ ئوخشاش-تور-بېكەت),
			XSID: سۆھبەت-id
		).
		ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى يوقات.
		ئۆزىنىڭ باشلار ئاخىرىغا-قوش: سۆھبەت-بېشى.
	}.
}.


تور-ھۆججىتى كەلگەندە: ['قېلىپ:'] قىل: { :ھۆججەت-يولى <- قېلىپ يېڭى: (ھۆججەت يېڭى: ھۆججەت-يولى, ئوقۇ).
}.

تور-ھۆججىتى كەلگەندە: ['چىقار:تىپ:'] قىل: { :نەتىجە :تىپ
	ئۆزىنىڭ باشلار-يوللاندى يالغان-بولسا: {
		ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى قۇرۇق? يالغان-بولسا: {
			ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى ساقلا: ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى.
		}.
		ئۆزىنىڭ باشلار ئاخىرىغا-قوش: (
			HTTP-باش يېڭى
			ئاچقۇچ: ['Content-type'] قىممەت: تىپ
		).
		ئۆزىنىڭ باشلار ھەربىر: { :_ :باش
			چىقىرىش ياز: باش.
		}.
		ئۆزىنىڭ باشلار-يوللاندى := راست.
		چىقىرىش ياز: ['\r\n'].
	}.
	چىقىرىش ياز: نەتىجە.
}.

تور-ھۆججىتى كەلگەندە: ['تاماملا:تىپ:'] قىل: { :نەتىجە :تىپ
	ئۆزىنىڭ باشلار-يوللاندى يالغان-بولسا: {
		ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى قۇرۇق? يالغان-بولسا: {
			ئۆزىنىڭ سۆھبەت-باشقۇرغۇچى ساقلا: ئۆزىنىڭ سۆھبەت-سانلىق-مەلۇماتى.
		}.
		ئۆزىنىڭ باشلار ئاخىرىغا-قوش: (
			HTTP-باش يېڭى
			ئاچقۇچ: ['Content-type'] قىممەت: تىپ
		).
		ئۆزىنىڭ باشلار ئاخىرىغا-قوش: (
			HTTP-باش يېڭى
			ئاچقۇچ: ['Content-Length'] قىممەت: نەتىجە تېكىستكە بايتلار
		).
		ئۆزىنىڭ باشلار ھەربىر: { :_ :باش
			چىقىرىش ياز: باش.
		}.
		ئۆزىنىڭ باشلار-يوللاندى := راست.
		چىقىرىش ياز: ['\r\n'].
	}.
	چىقىرىش ياز: نەتىجە.
}.

تور-ھۆججىتى كەلگەندە: ['چىقار:'] قىل: { :نەتىجە
	ئۆزى چىقار: نەتىجە تىپ: ['text/html; charset=utf-8'].
}.

تور-ھۆججىتى كەلگەندە: ['تاماملا:'] قىل: { :نەتىجە
	ئۆزى تاماملا: نەتىجە تىپ: ['text/html; charset=utf-8'].
}.

تور-ھۆججىتى كەلگەندە: ['json:'] قىل: { :نەتىجە
	ئۆزى چىقار: ( JSON jsonify: نەتىجە ) تىپ: ['application/json'].
}.

تور-ھۆججىتى كەلگەندە: ['تېپىلمىدى:'] قىل: { :نەتىجە
	ئۆزى باشلارنى-قۇرۇقدا باش: (
		HTTP-باش يېڭى ئاچقۇچ: ['Status'] قىممەت: ['404 Not Found']
	).
	ئۆزى چىقار: نەتىجە.
}.


# Interface

>> سۆھبەت := ئوبيېكت يېڭى.

سۆھبەت كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى دەسلەپلەشتۈر ئۈچۈن: قۇرۇق.
}.

سۆھبەت كەلگەندە: ['ئۈچۈن:'] قىل: { :id
	ئۆزىنىڭ id := id.
}.

سۆھبەت كەلگەندە: ['يۈكلە'] قىل: {
	بۇ-ۋەزىپە خاتالىق: ['Not implemented.'].
}.

سۆھبەت كەلگەندە: ['ساقلا:'] قىل: {
	بۇ-ۋەزىپە خاتالىق: ['Not implemented.'].
}.

سۆھبەت كەلگەندە: ['يوقات'] قىل: {
	بۇ-ۋەزىپە خاتالىق: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> ۋاقىتلىق-ھۆججەت-سۆھبىتى := سۆھبەت يېڭى.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزىنىڭ يول-بېشى := ['/tmp/sess-'].
}.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['يول-ئالدى-قوشۇلغۇچى:'] قىل: { :ھەرپ-تىزمىسى
	ئۆزىنىڭ يول-بېشى := ھەرپ-تىزمىسى.
}.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['سۆھبەت-ھۆججىتى'] قىل: { <- ( ھۆججەت يېڭى: ( ئۆزىنىڭ يول-بېشى + ئۆزىنىڭ id + ['.txt'] ) ).
}.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['يۈكلە'] قىل: {
	>> سۆھبەت-ھۆججىتى := ئۆزى سۆھبەت-ھۆججىتى.
	سۆھبەت-ھۆججىتى مەۋجۇت يالغان-بولسا: {
		سۆھبەت-ھۆججىتى ياز: (لۇغەت يېڭى كود).
	}. <- سۆھبەت-ھۆججىتى ئوقۇ ئوبيېكتقا.
}.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['ساقلا:'] قىل: { :سانلىق-مەلۇمات
	>> سۆھبەت-ھۆججىتى := ئۆزى سۆھبەت-ھۆججىتى.
	سۆھبەت-ھۆججىتى مەۋجۇت راست-بولسا: {
		سۆھبەت-ھۆججىتى ياز: سانلىق-مەلۇمات كود.
	}.
}.

ۋاقىتلىق-ھۆججەت-سۆھبىتى كەلگەندە: ['يوقات'] قىل: {
	>> سۆھبەت-ھۆججىتى := ئۆزى سۆھبەت-ھۆججىتى.
	سۆھبەت-ھۆججىتى مەۋجۇت راست-بولسا: {
		سۆھبەت-ھۆججىتى ئۆچۈر.
	}.
}.


>> URL := ئوبيېكت يېڭى.

URL كەلگەندە: ['دەسلەپلەشتۈر'] قىل: {
	ئۆزىنىڭ كېلىشىم := ['https://'].
	ئۆزىنىڭ باش-ماشىنا := ['localhost'].
	ئۆزىنىڭ ھۆججەت-يولى := [''].
	ئۆزىنىڭ url-پارامېتىرلىرى := [''].
	ئۆزىنىڭ hash := [''].
}.

URL كەلگەندە: ['يېڭى'] قىل: { <- ئۆزى يېڭى دەسلەپلەشتۈر.
}.

URL كەلگەندە: ['تېكىستكە'] قىل: { <- (
	ئۆزىنىڭ كېلىشىم +
	ئۆزىنىڭ باش-ماشىنا +
	ئۆزىنىڭ ھۆججەت-يولى +
	ئۆزىنىڭ url-پارامېتىرلىرى +
	ئۆزىنىڭ hash ).
}.

URL كەلگەندە: ['كېلىشىم:'] قىل: { :كېلىشىم
	((تىزىم يېڭى ; ['http'] ; ['https']) بار: كېلىشىم) راست-بولسا: {
		ئۆزىنىڭ كېلىشىم := كېلىشىم + ['://'].
	}, يالغان-بولسا: {
		بۇ-ۋەزىپە خاتالىق: ['Invalid protocol'].
	}.
}.

URL كەلگەندە: ['باش-ماشىنا:'] قىل: { :باش-ماشىنا
	#todo validate according to rfc
	ئۆزىنىڭ باش-ماشىنا := باش-ماشىنا.
}.

URL كەلگەندە: ['ھۆججەت-يولى:'] قىل: { :ھۆججەت-يولى
	ئۆزىنىڭ ھۆججەت-يولى := ['/'] + ھۆججەت-يولى url-كودلاش.
}.

URL كەلگەندە: ['url-پارامېتىرلىرى:'] قىل: { :ماسلاشتۇرۇش
	>> url-پارامېتىرلىرى := تىزىم يېڭى.
	ماسلاشتۇرۇش ھەربىر: { :ئاچقۇچ :قىممەت
		url-پارامېتىرلىرى ئاخىرىغا-قوش: ئاچقۇچ تېكىستكە url-كودلاش + ['='] + قىممەت تېكىستكە url-كودلاش.
	}.
	ئۆزىنىڭ url-پارامېتىرلىرى := ['?'] + ( url-پارامېتىرلىرى بىرلەشتۈر: ['&'] ).
}.

URL كەلگەندە: ['خەش:'] قىل: { :hash
	ئۆزىنىڭ hash := ['#'] + hash url-كودلاش.
}.

