>> ईमेल := वस्तु नया.

ईमेल जब: ['आरंभ-करें'] करो: {
	अपना प्राप्तकर्ता := सूची नया.
	अपना cc := सूची नया.
	अपना bcc := सूची नया.
	अपना प्रेषक := शून्य.
	अपना प्रेषक-नाम := शून्य.
	अपना विषय := शून्य.
	अपना मुख्य-पाठ := शून्य.
}.

ईमेल जब: ['नया'] करो: { <- स्वयं नया आरंभ-करें.
}.

ईमेल जब: ['प्रति:'] करो: { :गणना-सूची
	अपना प्राप्तकर्ता := गणना-सूची.
}.
 
ईमेल जब: ['cc:'] करो: { :गणना-सूची
	अपना cc := गणना-सूची.
}.

ईमेल जब: ['bcc:'] करो: { :गणना-सूची
	अपना bcc := गणना-सूची.
}.

ईमेल जब: ['विषय:'] करो: { :विषय
	अपना विषय := विषय.
}.

ईमेल जब: ['प्रेषक:नाम:'] करो: { :प्रेषक :नाम
	अपना प्रेषक := प्रेषक.
	अपना प्रेषक-नाम := नाम.
}.

ईमेल जब: ['मुख्य-पाठ:'] करो: { :मुख्य-पाठ
	अपना मुख्य-पाठ := मुख्य-पाठ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
ईमेल जब: ['हेडर:'] करो: { :पंक्ति <- पंक्ति बदलो: ['\r'] से: [''], बदलो: ['\n'] से: [''].
}.

ईमेल जब: ['भेजें'] करो: {
	>> f := फ़ाइल tempwrite: स्वयं उत्पन्न-करें.
	प्रोग्राम सिस्टम: ['sendmail -t < '] + f फ़ाइल-पथ, नई-पंक्ति.
}.

ईमेल जब: ['उत्पन्न-करें'] करो: {
	>> पंक्ति-विराम := ['\r\n'].
	>> पाठ-शृंखला := [''].
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['From: '] + अपना प्रेषक-नाम + [' <'] + ( अपना प्रेषक ) + ['>']) + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['To: '] + ( अपना प्राप्तकर्ता जोड़ो: [','] )) + पंक्ति-विराम.
	अपना cc गिनती सत्य-हो-तो: {
		पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Cc: '] + ( अपना cc जोड़ो: [','] )) + पंक्ति-विराम.
	}.
	अपना bcc गिनती सत्य-हो-तो: {
		पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Bcc: '] + ( अपना bcc जोड़ो: [','] )) + पंक्ति-विराम.
	}.
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Subject: '] + अपना विषय) + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: अपना मुख्य-पाठ.
	पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम. <- पाठ-शृंखला.
}.

>> HTML-ईमेल := ईमेल नया.

HTML-ईमेल जब: ['आरंभ-करें'] करो: {
	स्वयं आरंभ-करें.
	अपना संलग्नक := सूची नया.
	अपना सीमा := तिजोरी टोकन: 40.
}.

HTML-ईमेल जब: ['संलग्न-करें:'] करो: { :सत्र-फ़ाइल
	>> id := अपना संलग्नक गिनती.
	>> blob := सत्र-फ़ाइल blob.
	अपना संलग्नक अंत-में-जोड़ो: (
		शब्दकोश नया
			सत्र-फ़ाइल: सत्र-फ़ाइल फ़ाइल-पथ,
			mime: ['image/'] + (Server mimetype: सत्र-फ़ाइल फ़ाइल-पथ),
			आँकड़े: blob base64-एनकोड
	).
	blob मुक्त. <- ['cid:attachment'] + id.
}.

HTML-ईमेल जब: ['उत्पन्न-करें'] करो: {
	>> पंक्ति-विराम := ['\r\n'].
	>> पाठ-शृंखला := [''].
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['From: '] + अपना प्रेषक-नाम + [' <'] + ( अपना प्रेषक ) + ['>']) + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['To: '] + ( अपना प्राप्तकर्ता जोड़ो: [','] )) + पंक्ति-विराम.
	अपना cc गिनती सत्य-हो-तो: {
		पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Cc: '] + ( अपना cc जोड़ो: [','] )) + पंक्ति-विराम.
	}.
	अपना bcc गिनती सत्य-हो-तो: {
		पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Bcc: '] + ( अपना bcc जोड़ो: [','] )) + पंक्ति-विराम.
	}.
	पाठ-शृंखला अंत-में-जोड़ो: (स्वयं हेडर: ['Subject: '] + अपना विषय) + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: ['MIME-Version: 1.0'] + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: ['Content-Type: multipart/related; boundary="'] + अपना सीमा + ['"; type=text/html'] + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: ['--'] + अपना सीमा + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: ['Content-Type: text/html; charset=UTF-8'] + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: ['Content-Transfer-Encoding: 7bit'] + पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
	पाठ-शृंखला अंत-में-जोड़ो: अपना मुख्य-पाठ.
	पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
	अपना संलग्नक प्रत्येक: { :id :जानकारी
		>> blob := जानकारी आँकड़े.
		पाठ-शृंखला अंत-में-जोड़ो: ['--'] + अपना सीमा + पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: ['Content-Type: '] + जानकारी mime + पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: ['Content-Transfer-Encoding: base64'] + पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: ['Content-ID: <attachment'] + id + ['>'] + पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: ['Content-Disposition: inline; filename="'] + जानकारी सत्र-फ़ाइल + ['"'] + पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
		>> ऊपरी-सीमा := 76.
		>> पाठ-लंबाई := blob लंबाई.
		>> टुकड़े := (पाठ-लंबाई / ऊपरी-सीमा) ऊपर-पूर्णांक.
		{ :i
			>> टुकड़ा := blob प्रतिलिपि आरंभ: i * ऊपरी-सीमा लंबाई: ऊपरी-सीमा.
			पाठ-शृंखला अंत-में-जोड़ो: टुकड़ा + पंक्ति-विराम.
		} * टुकड़े.
		पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
		पाठ-शृंखला अंत-में-जोड़ो: पंक्ति-विराम.
	}.
	पाठ-शृंखला अंत-में-जोड़ो: ['--'] + अपना सीमा + ['--'] + पंक्ति-विराम. <- पाठ-शृंखला.
}.
