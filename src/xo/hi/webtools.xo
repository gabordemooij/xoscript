HTTP-अनुरोध जब: ['HTTP-हेडर:'] करो: { :कुंजी <- प्रोग्राम सेटिंग: कुंजी.
}.

>> HTTP-हेडर := वस्तु नया.

HTTP-हेडर जब: ['नया'] करो: { <- स्वयं नया आरंभ-करें.
}.

HTTP-हेडर जब: ['आरंभ-करें'] करो: {
	अपना कुंजी := शून्य.
	अपना मूल्य := शून्य.
}.

HTTP-हेडर जब: ['कुंजी:मूल्य:'] करो: { :कुंजी :मूल्य
	अपना कुंजी := कुंजी.
	अपना मूल्य := मूल्य.
}.

HTTP-हेडर जब: ['कुंजी'] करो: { <- अपना कुंजी.
}.

HTTP-हेडर जब: ['मूल्य'] करो: { <- अपना मूल्य.
}.


HTTP-हेडर जब: ['पाठ-में'] करो: {
	>> पंक्ति := अपना कुंजी + [': '] + अपना मूल्य.
	पंक्ति बदलो: ['\r'] से: [''], बदलो: ['\n'] से: ['']. <- पंक्ति + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> वेब-दस्तावेज़ := वस्तु नया.

वेब-दस्तावेज़ जब: ['नया'] करो: { <- स्वयं नया आरंभ-करें.
}.

वेब-दस्तावेज़ जब: ['आरंभ-करें'] करो: {
	अपना हेडर-सूची := सूची नया.
	अपना सत्र-आईडी := शून्य.
	अपना सत्र-प्रबंधक := अस्थायी-फ़ाइल-सत्र नया.
	अपना सत्र-डेटा := शून्य.
	अपना सुरक्षित := सत्य.
	अपना समान-साइट := ['Strict'].
	अपना हेडर-भेजे-गए := असत्य.
	अपना अनुरोध-http := HTTP-अनुरोध नया.
}.

वेब-दस्तावेज़ जब: ['अनुरोध-http:'] करो: { :अनुरोध-http
	अपना अनुरोध-http := अनुरोध-http.
}. 

वेब-दस्तावेज़ जब: ['सुरक्षित-सत्र-कुकी:'] करो: { :सुरक्षित
	स्वयं हेडर-जाँचें.
	अपना सुरक्षित := सुरक्षित.
}.

वेब-दस्तावेज़ जब: ['समान-साइट-सत्र-कुकी:'] करो: { :मूल्य
	स्वयं हेडर-जाँचें.
	>> विकल्प := सूची नया 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	विकल्प रखता-है: मूल्य, असत्य-हो-तो: {
		यह-कार्य त्रुटि: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	अपना समान-साइट := मूल्य.
}.

वेब-दस्तावेज़ जब: ['हेडर:'] करो: { :हेडर
	स्वयं हेडर-जाँचें.
	अपना हेडर-सूची अंत-में-जोड़ो: हेडर.
}.

वेब-दस्तावेज़ जब: ['हेडर-खाली-करें'] करो: {
	स्वयं हेडर-जाँचें.
	अपना हेडर-सूची := सूची नया.
}.

वेब-दस्तावेज़ जब: ['सत्र-प्रबंधक:'] करो: { :प्रबंधक
	स्वयं हेडर-जाँचें.
	अपना सत्र-प्रबंधक := प्रबंधक.
}.

वेब-दस्तावेज़ जब: ['सत्र-प्रबंधक'] करो: { <- अपना सत्र-प्रबंधक.
}.

वेब-दस्तावेज़ जब: ['हेडर-जाँचें'] करो: {
	अपना हेडर-भेजे-गए सत्य-हो-तो: {
		यह-कार्य त्रुटि: ['Headers already sent to client.'].
	}.
}.

वेब-दस्तावेज़ जब: ['सत्र-आरंभ-करें'] करो: {
	स्वयं हेडर-जाँचें.
	>> अनुरोध-http := अपना अनुरोध-http.
	>> सत्र-आईडी := अनुरोध-http cookie: ['xsid'].
	सत्र-आईडी शून्य? असत्य-हो-तो: {
		(( पैटर्न नया: ['^[A-Za-z0-9]+\\z'], मिलान: सत्र-आईडी ) = 0) सत्य-हो-तो: {
			सत्र-आईडी := शून्य.
		}.
	}.
	सत्र-आईडी शून्य? सत्य-हो-तो: {
		सत्र-आईडी := तिजोरी टोकन: 30.
		>> सत्र-हेडर := HTTP-हेडर नया
		कुंजी: ['Set-Cookie'] मूल्य: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (अपना सुरक्षित यह: ['Secure'] या-वह: ['']),
		SSITE: (अपना समान-साइट),
		XSID: सत्र-आईडी
		).
		अपना हेडर-सूची अंत-में-जोड़ो: सत्र-हेडर.
	}.
	अपना सत्र-डेटा := अपना सत्र-प्रबंधक के-लिए: सत्र-आईडी, लोड-करें. <- अपना सत्र-डेटा. # reference
}.

वेब-दस्तावेज़ जब: ['जाएँ:'] करो: { :पता
	स्वयं हेडर-जाँचें.
	स्वयं हेडर-खाली-करें.
	अपना हेडर-सूची
	अंत-में-जोड़ो: (
		HTTP-हेडर नया
		कुंजी: ['Status'] मूल्य: ['303 See Other']
	),
	अंत-में-जोड़ो: (
		HTTP-हेडर नया
		कुंजी: ['Location'] मूल्य: पता
	).
	स्वयं आउटपुट-करें: ['Redirect'].
}.

वेब-दस्तावेज़ जब: ['सत्र-नष्ट-करें'] करो: {
	स्वयं हेडर-जाँचें.
	>> अनुरोध-http := अपना अनुरोध-http.
	>> सत्र-आईडी := अनुरोध-http cookie: ['xsid'].
	सत्र-आईडी शून्य? असत्य-हो-तो: {
		>> सत्र-हेडर := HTTP-हेडर नया.
		>> समाप्ति-समय := क्षण नया वर्ष: 1970, प्रारूप-में: ['%a, %d %b %Y %H:%M:%S GMT'].
		सत्र-हेडर कुंजी: ['Set-Cookie'] मूल्य: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: समाप्ति-समय,
			SEC: (अपना सुरक्षित यह: ['Secure'] या-वह: ['']),
			SSITE: (अपना समान-साइट),
			XSID: सत्र-आईडी
		).
		अपना सत्र-प्रबंधक नष्ट-करें.
		अपना हेडर-सूची अंत-में-जोड़ो: सत्र-हेडर.
	}.
}.


वेब-दस्तावेज़ जब: ['साँचा:'] करो: { :फ़ाइल-पथ <- साँचा नया: (फ़ाइल नया: फ़ाइल-पथ, पढ़ो).
}.

वेब-दस्तावेज़ जब: ['आउटपुट-करें:प्रकार:'] करो: { :परिणाम :प्रकार
	अपना हेडर-भेजे-गए असत्य-हो-तो: {
		अपना सत्र-डेटा शून्य? असत्य-हो-तो: {
			अपना सत्र-प्रबंधक सहेजें: अपना सत्र-डेटा.
		}.
		अपना हेडर-सूची अंत-में-जोड़ो: (
			HTTP-हेडर नया
			कुंजी: ['Content-type'] मूल्य: प्रकार
		).
		अपना हेडर-सूची प्रत्येक: { :_ :हेडर
			निर्गम लिखो: हेडर.
		}.
		अपना हेडर-भेजे-गए := सत्य.
		निर्गम लिखो: ['\r\n'].
	}.
	निर्गम लिखो: परिणाम.
}.

वेब-दस्तावेज़ जब: ['पूरा-करें:प्रकार:'] करो: { :परिणाम :प्रकार
	अपना हेडर-भेजे-गए असत्य-हो-तो: {
		अपना सत्र-डेटा शून्य? असत्य-हो-तो: {
			अपना सत्र-प्रबंधक सहेजें: अपना सत्र-डेटा.
		}.
		अपना हेडर-सूची अंत-में-जोड़ो: (
			HTTP-हेडर नया
			कुंजी: ['Content-type'] मूल्य: प्रकार
		).
		अपना हेडर-सूची अंत-में-जोड़ो: (
			HTTP-हेडर नया
			कुंजी: ['Content-Length'] मूल्य: परिणाम पाठ-में bytes
		).
		अपना हेडर-सूची प्रत्येक: { :_ :हेडर
			निर्गम लिखो: हेडर.
		}.
		अपना हेडर-भेजे-गए := सत्य.
		निर्गम लिखो: ['\r\n'].
	}.
	निर्गम लिखो: परिणाम.
}.

वेब-दस्तावेज़ जब: ['आउटपुट-करें:'] करो: { :परिणाम
	स्वयं आउटपुट-करें: परिणाम प्रकार: ['text/html; charset=utf-8'].
}.

वेब-दस्तावेज़ जब: ['पूरा-करें:'] करो: { :परिणाम
	स्वयं पूरा-करें: परिणाम प्रकार: ['text/html; charset=utf-8'].
}.

वेब-दस्तावेज़ जब: ['json:'] करो: { :परिणाम
	स्वयं आउटपुट-करें: ( JSON jsonify: परिणाम ) प्रकार: ['application/json'].
}.

वेब-दस्तावेज़ जब: ['नहीं-मिला:'] करो: { :परिणाम
	स्वयं हेडर-खाली-करें हेडर: (
		HTTP-हेडर नया कुंजी: ['Status'] मूल्य: ['404 Not Found']
	).
	स्वयं आउटपुट-करें: परिणाम.
}.


# Interface

>> सत्र := वस्तु नया.

सत्र जब: ['नया'] करो: { <- स्वयं नया आरंभ-करें के-लिए: शून्य.
}.

सत्र जब: ['के-लिए:'] करो: { :id
	अपना id := id.
}.

सत्र जब: ['लोड-करें'] करो: {
	यह-कार्य त्रुटि: ['Not implemented.'].
}.

सत्र जब: ['सहेजें:'] करो: {
	यह-कार्य त्रुटि: ['Not implemented.'].
}.

सत्र जब: ['नष्ट-करें'] करो: {
	यह-कार्य त्रुटि: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> अस्थायी-फ़ाइल-सत्र := सत्र नया.

अस्थायी-फ़ाइल-सत्र जब: ['आरंभ-करें'] करो: {
	अपना पथ-आरंभ := ['/tmp/sess-'].
}.

अस्थायी-फ़ाइल-सत्र जब: ['पथ-उपसर्ग:'] करो: { :पाठ-शृंखला
	अपना पथ-आरंभ := पाठ-शृंखला.
}.

अस्थायी-फ़ाइल-सत्र जब: ['सत्र-फ़ाइल'] करो: { <- ( फ़ाइल नया: ( अपना पथ-आरंभ + अपना id + ['.txt'] ) ).
}.

अस्थायी-फ़ाइल-सत्र जब: ['लोड-करें'] करो: {
	>> सत्र-फ़ाइल := स्वयं सत्र-फ़ाइल.
	सत्र-फ़ाइल मौजूद असत्य-हो-तो: {
		सत्र-फ़ाइल लिखो: (शब्दकोश नया कोड).
	}. <- सत्र-फ़ाइल पढ़ो वस्तु-में.
}.

अस्थायी-फ़ाइल-सत्र जब: ['सहेजें:'] करो: { :आँकड़े
	>> सत्र-फ़ाइल := स्वयं सत्र-फ़ाइल.
	सत्र-फ़ाइल मौजूद सत्य-हो-तो: {
		सत्र-फ़ाइल लिखो: आँकड़े कोड.
	}.
}.

अस्थायी-फ़ाइल-सत्र जब: ['नष्ट-करें'] करो: {
	>> सत्र-फ़ाइल := स्वयं सत्र-फ़ाइल.
	सत्र-फ़ाइल मौजूद सत्य-हो-तो: {
		सत्र-फ़ाइल मिटाओ.
	}.
}.


>> URL := वस्तु नया.

URL जब: ['आरंभ-करें'] करो: {
	अपना प्रोटोकॉल := ['https://'].
	अपना होस्ट := ['localhost'].
	अपना फ़ाइल-पथ := [''].
	अपना url-पैरामीटर := [''].
	अपना hash := [''].
}.

URL जब: ['नया'] करो: { <- स्वयं नया आरंभ-करें.
}.

URL जब: ['पाठ-में'] करो: { <- (
	अपना प्रोटोकॉल +
	अपना होस्ट +
	अपना फ़ाइल-पथ +
	अपना url-पैरामीटर +
	अपना hash ).
}.

URL जब: ['प्रोटोकॉल:'] करो: { :प्रोटोकॉल
	((सूची नया ; ['http'] ; ['https']) रखता-है: प्रोटोकॉल) सत्य-हो-तो: {
		अपना प्रोटोकॉल := प्रोटोकॉल + ['://'].
	}, असत्य-हो-तो: {
		यह-कार्य त्रुटि: ['Invalid protocol'].
	}.
}.

URL जब: ['होस्ट:'] करो: { :होस्ट
	#todo validate according to rfc
	अपना होस्ट := होस्ट.
}.

URL जब: ['फ़ाइल-पथ:'] करो: { :फ़ाइल-पथ
	अपना फ़ाइल-पथ := ['/'] + फ़ाइल-पथ url-एनकोड.
}.

URL जब: ['url-पैरामीटर:'] करो: { :मानचित्रण
	>> url-पैरामीटर := सूची नया.
	मानचित्रण प्रत्येक: { :कुंजी :मूल्य
		url-पैरामीटर अंत-में-जोड़ो: कुंजी पाठ-में url-एनकोड + ['='] + मूल्य पाठ-में url-एनकोड.
	}.
	अपना url-पैरामीटर := ['?'] + ( url-पैरामीटर जोड़ो: ['&'] ).
}.

URL जब: ['हैश:'] करो: { :hash
	अपना hash := ['#'] + hash url-एनकोड.
}.

