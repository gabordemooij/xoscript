
# ~ Simple template engine ~

>> साँचा := वस्तु नया.

साँचा जब: ['नया'] करो: { <- स्वयं नया विषयवस्तु: [''].
}.

साँचा जब: ['विषयवस्तु:'] करो: { :विषयवस्तु
	अपना विषयवस्तु := विषयवस्तु. 
}.

साँचा जब: ['नया:'] करो: { :विषयवस्तु <- स्वयं नया विषयवस्तु: विषयवस्तु.
}.

साँचा जब: ['काटें:'] करो: { :चिह्न
	>> आरंभ-चिह्न := (['<!-- cut:%id% -->'] %id%: चिह्न).
	>> अंत-चिह्न := (['<!-- /cut:%id% -->'] %id%: चिह्न).
	>> भागों := अपना विषयवस्तु विभाजित: आरंभ-चिह्न.
	>> उपसर्ग := भागों पहला.
	>> भागों2 := भागों अंतिम विभाजित: अंत-चिह्न.
	>> प्रत्यय := भागों2 अंतिम.
	>> भाग := भागों2 पहला.
	>> शेष := उपसर्ग + प्रत्यय.
	अपना विषयवस्तु := शेष. <- साँचा नया: भाग.
	
}.

साँचा जब: ['प्रतिलिपि'] करो: { <- स्वयं नया: स्वयं पाठ-में प्रतिलिपि.
}.
	
साँचा जब: ['चिपकाएँ:कुंजी:'] करो: { :अंश :id
	>> चिपकाने-का-चिह्न := (['<!-- paste:%id% -->'] %id%: id).
	अपना विषयवस्तु बदलो: चिपकाने-का-चिह्न से: ( अंश पाठ-में + चिपकाने-का-चिह्न ).
}.

साँचा जब: ['निर्धारित:मान:'] करो: { :स्थान :मूल्य
	अपना विषयवस्तु बदलो: ['<!-- slot:'] + स्थान + [' -->'] से: ( Server html-एनकोड: मूल्य ).
}.

साँचा जब: ['निर्धारित:html:'] करो: { :स्थान :html
	अपना विषयवस्तु बदलो: ['<!-- slot:'] + स्थान + [' -->'] से: html.
}.

साँचा जब: ['उत्तर:और:'] करो: { :स्थान :मूल्य
	स्वयं निर्धारित: (स्थान आरंभ: 0 लंबाई: (स्थान लंबाई - 1)) मान: मूल्य.
}.

साँचा जब: ['nl2br'] करो: {
	अपना विषयवस्तु बदलो: ['\n'] से: ['<br>'].
}.

साँचा जब: ['चिह्न-हटाएँ'] करो: {
	अपना विषयवस्तु :=
		पैटर्न
		नया: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		मिलान: अपना विषयवस्तु
		करो: { <- ['']. }.
}.

साँचा जब: ['कट-हटाएँ'] करो: {
	>> मदें := सूची नया.
	पैटर्न
	नया: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	मिलान: अपना विषयवस्तु
	करो: { :_ :भाग
		मदें अंत-में-जोड़ो: भाग ? 1.
	}.
	मदें प्रत्येक: { :_ :id
		अपना विषयवस्तु :=
			पैटर्न नया: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			मिलान: अपना विषयवस्तु
			करो: { <- ['']. }.
	 }.
}.

साँचा जब: ['रिक्तियाँ-हटाएँ'] करो: {
	अपना विषयवस्तु :=
		पैटर्न
		नया: ['\\s*\\n'],
		मिलान: अपना विषयवस्तु
		करो: { <- ['\n']. }.
	अपना विषयवस्तु :=
		पैटर्न
		नया: ['\\n[\\s\\t]+'],
		मिलान: अपना विषयवस्तु
		करो: { <- ['\n']. }.
}.

साँचा जब: ['सब-चिह्न-हटाएँ'] करो: {
	स्वयं चिह्न-हटाएँ.
	स्वयं कट-हटाएँ.
	स्वयं रिक्तियाँ-हटाएँ.
}.

साँचा जब: ['पाठ-में'] करो: { <- अपना विषयवस्तु.
}.
