HTTP-अनुरोध जब: ['HTTP-हेडर:'] गर: { :कुञ्जी <- प्रोग्राम सेटिङ: कुञ्जी.
}.

>> HTTP-हेडर := वस्तु नयाँ.

HTTP-हेडर जब: ['नयाँ'] गर: { <- आफू नयाँ आरम्भ-गर.
}.

HTTP-हेडर जब: ['आरम्भ-गर'] गर: {
	आफ्नो कुञ्जी := शून्य.
	आफ्नो मूल्य := शून्य.
}.

HTTP-हेडर जब: ['कुञ्जी:मूल्य:'] गर: { :कुञ्जी :मूल्य
	आफ्नो कुञ्जी := कुञ्जी.
	आफ्नो मूल्य := मूल्य.
}.

HTTP-हेडर जब: ['कुञ्जी'] गर: { <- आफ्नो कुञ्जी.
}.

HTTP-हेडर जब: ['मूल्य'] गर: { <- आफ्नो मूल्य.
}.


HTTP-हेडर जब: ['पाठमा'] गर: {
	>> पङ्क्ति := आफ्नो कुञ्जी + [': '] + आफ्नो मूल्य.
	पङ्क्ति बदल: ['\r'] ले: [''], बदल: ['\n'] ले: ['']. <- पङ्क्ति + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> वेब-कागजात := वस्तु नयाँ.

वेब-कागजात जब: ['नयाँ'] गर: { <- आफू नयाँ आरम्भ-गर.
}.

वेब-कागजात जब: ['आरम्भ-गर'] गर: {
	आफ्नो हेडरहरू := तालिका नयाँ.
	आफ्नो सत्र-आइडी := शून्य.
	आफ्नो सत्र-व्यवस्थापक := अस्थायी-फाइल-सत्र नयाँ.
	आफ्नो सत्र-डाटा := शून्य.
	आफ्नो सुरक्षित := सत्य.
	आफ्नो उही-साइट := ['Strict'].
	आफ्नो हेडरहरू-पठाइयो := असत्य.
	आफ्नो अनुरोध-http := HTTP-अनुरोध नयाँ.
}.

वेब-कागजात जब: ['अनुरोध-http:'] गर: { :अनुरोध-http
	आफ्नो अनुरोध-http := अनुरोध-http.
}. 

वेब-कागजात जब: ['सुरक्षित-सत्र-कुकी:'] गर: { :सुरक्षित
	आफू हेडर-जाँच.
	आफ्नो सुरक्षित := सुरक्षित.
}.

वेब-कागजात जब: ['उही-साइट-सत्र-कुकी:'] गर: { :मूल्य
	आफू हेडर-जाँच.
	>> विकल्पहरू := तालिका नयाँ 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	विकल्पहरू समावेश-छ: मूल्य, असत्य-भए: {
		यो-कार्य त्रुटि: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	आफ्नो उही-साइट := मूल्य.
}.

वेब-कागजात जब: ['हेडर:'] गर: { :हेडर
	आफू हेडर-जाँच.
	आफ्नो हेडरहरू अन्त्यमा-थप: हेडर.
}.

वेब-कागजात जब: ['हेडर-खाली-गर'] गर: {
	आफू हेडर-जाँच.
	आफ्नो हेडरहरू := तालिका नयाँ.
}.

वेब-कागजात जब: ['सत्र-व्यवस्थापक:'] गर: { :व्यवस्थापक
	आफू हेडर-जाँच.
	आफ्नो सत्र-व्यवस्थापक := व्यवस्थापक.
}.

वेब-कागजात जब: ['सत्र-व्यवस्थापक'] गर: { <- आफ्नो सत्र-व्यवस्थापक.
}.

वेब-कागजात जब: ['हेडर-जाँच'] गर: {
	आफ्नो हेडरहरू-पठाइयो सत्य-भए: {
		यो-कार्य त्रुटि: ['Headers already sent to client.'].
	}.
}.

वेब-कागजात जब: ['सत्र-सुरु-गर'] गर: {
	आफू हेडर-जाँच.
	>> अनुरोध-http := आफ्नो अनुरोध-http.
	>> सत्र-आइडी := अनुरोध-http cookie: ['xsid'].
	सत्र-आइडी शून्य? असत्य-भए: {
		(( ढाँचा-खोज नयाँ: ['^[A-Za-z0-9]+\\z'], मिलान: सत्र-आइडी ) = 0) सत्य-भए: {
			सत्र-आइडी := शून्य.
		}.
	}.
	सत्र-आइडी शून्य? सत्य-भए: {
		सत्र-आइडी := ढुकुटी टोकन: 30.
		>> सत्र-हेडर := HTTP-हेडर नयाँ
		कुञ्जी: ['Set-Cookie'] मूल्य: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (आफ्नो सुरक्षित यो: ['Secure'] नत्र-त्यो: ['']),
		SSITE: (आफ्नो उही-साइट),
		XSID: सत्र-आइडी
		).
		आफ्नो हेडरहरू अन्त्यमा-थप: सत्र-हेडर.
	}.
	आफ्नो सत्र-डाटा := आफ्नो सत्र-व्यवस्थापक लागि: सत्र-आइडी, लोड-गर. <- आफ्नो सत्र-डाटा. # reference
}.

वेब-कागजात जब: ['जाऊ:'] गर: { :ठेगाना
	आफू हेडर-जाँच.
	आफू हेडर-खाली-गर.
	आफ्नो हेडरहरू
	अन्त्यमा-थप: (
		HTTP-हेडर नयाँ
		कुञ्जी: ['Status'] मूल्य: ['303 See Other']
	),
	अन्त्यमा-थप: (
		HTTP-हेडर नयाँ
		कुञ्जी: ['Location'] मूल्य: ठेगाना
	).
	आफू आउटपुट-गर: ['Redirect'].
}.

वेब-कागजात जब: ['सत्र-नष्ट-गर'] गर: {
	आफू हेडर-जाँच.
	>> अनुरोध-http := आफ्नो अनुरोध-http.
	>> सत्र-आइडी := अनुरोध-http cookie: ['xsid'].
	सत्र-आइडी शून्य? असत्य-भए: {
		>> सत्र-हेडर := HTTP-हेडर नयाँ.
		>> म्याद-सकिने-समय := क्षण नयाँ वर्ष: 1970, ढाँचामा: ['%a, %d %b %Y %H:%M:%S GMT'].
		सत्र-हेडर कुञ्जी: ['Set-Cookie'] मूल्य: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: म्याद-सकिने-समय,
			SEC: (आफ्नो सुरक्षित यो: ['Secure'] नत्र-त्यो: ['']),
			SSITE: (आफ्नो उही-साइट),
			XSID: सत्र-आइडी
		).
		आफ्नो सत्र-व्यवस्थापक नष्ट-गर.
		आफ्नो हेडरहरू अन्त्यमा-थप: सत्र-हेडर.
	}.
}.


वेब-कागजात जब: ['साँचो:'] गर: { :फाइल-बाटो <- साँचो नयाँ: (फाइल नयाँ: फाइल-बाटो, पढ).
}.

वेब-कागजात जब: ['आउटपुट-गर:प्रकार:'] गर: { :नतिजा :प्रकार
	आफ्नो हेडरहरू-पठाइयो असत्य-भए: {
		आफ्नो सत्र-डाटा शून्य? असत्य-भए: {
			आफ्नो सत्र-व्यवस्थापक सुरक्षित-गर: आफ्नो सत्र-डाटा.
		}.
		आफ्नो हेडरहरू अन्त्यमा-थप: (
			HTTP-हेडर नयाँ
			कुञ्जी: ['Content-type'] मूल्य: प्रकार
		).
		आफ्नो हेडरहरू प्रत्येक: { :_ :हेडर
			आउटपुट लेख: हेडर.
		}.
		आफ्नो हेडरहरू-पठाइयो := सत्य.
		आउटपुट लेख: ['\r\n'].
	}.
	आउटपुट लेख: नतिजा.
}.

वेब-कागजात जब: ['पूरा-गर:प्रकार:'] गर: { :नतिजा :प्रकार
	आफ्नो हेडरहरू-पठाइयो असत्य-भए: {
		आफ्नो सत्र-डाटा शून्य? असत्य-भए: {
			आफ्नो सत्र-व्यवस्थापक सुरक्षित-गर: आफ्नो सत्र-डाटा.
		}.
		आफ्नो हेडरहरू अन्त्यमा-थप: (
			HTTP-हेडर नयाँ
			कुञ्जी: ['Content-type'] मूल्य: प्रकार
		).
		आफ्नो हेडरहरू अन्त्यमा-थप: (
			HTTP-हेडर नयाँ
			कुञ्जी: ['Content-Length'] मूल्य: नतिजा पाठमा bytes
		).
		आफ्नो हेडरहरू प्रत्येक: { :_ :हेडर
			आउटपुट लेख: हेडर.
		}.
		आफ्नो हेडरहरू-पठाइयो := सत्य.
		आउटपुट लेख: ['\r\n'].
	}.
	आउटपुट लेख: नतिजा.
}.

वेब-कागजात जब: ['आउटपुट-गर:'] गर: { :नतिजा
	आफू आउटपुट-गर: नतिजा प्रकार: ['text/html; charset=utf-8'].
}.

वेब-कागजात जब: ['पूरा-गर:'] गर: { :नतिजा
	आफू पूरा-गर: नतिजा प्रकार: ['text/html; charset=utf-8'].
}.

वेब-कागजात जब: ['json:'] गर: { :नतिजा
	आफू आउटपुट-गर: ( JSON jsonify: नतिजा ) प्रकार: ['application/json'].
}.

वेब-कागजात जब: ['फेला-परेन:'] गर: { :नतिजा
	आफू हेडर-खाली-गर हेडर: (
		HTTP-हेडर नयाँ कुञ्जी: ['Status'] मूल्य: ['404 Not Found']
	).
	आफू आउटपुट-गर: नतिजा.
}.


# Interface

>> सत्र := वस्तु नयाँ.

सत्र जब: ['नयाँ'] गर: { <- आफू नयाँ आरम्भ-गर लागि: शून्य.
}.

सत्र जब: ['लागि:'] गर: { :id
	आफ्नो id := id.
}.

सत्र जब: ['लोड-गर'] गर: {
	यो-कार्य त्रुटि: ['Not implemented.'].
}.

सत्र जब: ['सुरक्षित-गर:'] गर: {
	यो-कार्य त्रुटि: ['Not implemented.'].
}.

सत्र जब: ['नष्ट-गर'] गर: {
	यो-कार्य त्रुटि: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> अस्थायी-फाइल-सत्र := सत्र नयाँ.

अस्थायी-फाइल-सत्र जब: ['आरम्भ-गर'] गर: {
	आफ्नो मार्ग-सुरु := ['/tmp/sess-'].
}.

अस्थायी-फाइल-सत्र जब: ['मार्ग-उपसर्ग:'] गर: { :पाठ-शृङ्खला
	आफ्नो मार्ग-सुरु := पाठ-शृङ्खला.
}.

अस्थायी-फाइल-सत्र जब: ['सत्र-फाइल'] गर: { <- ( फाइल नयाँ: ( आफ्नो मार्ग-सुरु + आफ्नो id + ['.txt'] ) ).
}.

अस्थायी-फाइल-सत्र जब: ['लोड-गर'] गर: {
	>> सत्र-फाइल := आफू सत्र-फाइल.
	सत्र-फाइल अस्तित्वमा असत्य-भए: {
		सत्र-फाइल लेख: (शब्दकोश नयाँ कोड).
	}. <- सत्र-फाइल पढ वस्तुमा.
}.

अस्थायी-फाइल-सत्र जब: ['सुरक्षित-गर:'] गर: { :डाटा
	>> सत्र-फाइल := आफू सत्र-फाइल.
	सत्र-फाइल अस्तित्वमा सत्य-भए: {
		सत्र-फाइल लेख: डाटा कोड.
	}.
}.

अस्थायी-फाइल-सत्र जब: ['नष्ट-गर'] गर: {
	>> सत्र-फाइल := आफू सत्र-फाइल.
	सत्र-फाइल अस्तित्वमा सत्य-भए: {
		सत्र-फाइल मेट.
	}.
}.


>> URL := वस्तु नयाँ.

URL जब: ['आरम्भ-गर'] गर: {
	आफ्नो प्रोटोकल := ['https://'].
	आफ्नो होस्ट := ['localhost'].
	आफ्नो फाइल-बाटो := [''].
	आफ्नो url-प्यारामिटर := [''].
	आफ्नो hash := [''].
}.

URL जब: ['नयाँ'] गर: { <- आफू नयाँ आरम्भ-गर.
}.

URL जब: ['पाठमा'] गर: { <- (
	आफ्नो प्रोटोकल +
	आफ्नो होस्ट +
	आफ्नो फाइल-बाटो +
	आफ्नो url-प्यारामिटर +
	आफ्नो hash ).
}.

URL जब: ['प्रोटोकल:'] गर: { :प्रोटोकल
	((तालिका नयाँ ; ['http'] ; ['https']) समावेश-छ: प्रोटोकल) सत्य-भए: {
		आफ्नो प्रोटोकल := प्रोटोकल + ['://'].
	}, असत्य-भए: {
		यो-कार्य त्रुटि: ['Invalid protocol'].
	}.
}.

URL जब: ['होस्ट:'] गर: { :होस्ट
	#todo validate according to rfc
	आफ्नो होस्ट := होस्ट.
}.

URL जब: ['फाइल-बाटो:'] गर: { :फाइल-बाटो
	आफ्नो फाइल-बाटो := ['/'] + फाइल-बाटो url-इन्कोड.
}.

URL जब: ['url-प्यारामिटर:'] गर: { :नक्साङ्कन
	>> url-प्यारामिटर := तालिका नयाँ.
	नक्साङ्कन प्रत्येक: { :कुञ्जी :मूल्य
		url-प्यारामिटर अन्त्यमा-थप: कुञ्जी पाठमा url-इन्कोड + ['='] + मूल्य पाठमा url-इन्कोड.
	}.
	आफ्नो url-प्यारामिटर := ['?'] + ( url-प्यारामिटर जोड: ['&'] ).
}.

URL जब: ['ह्यास:'] गर: { :hash
	आफ्नो hash := ['#'] + hash url-इन्कोड.
}.

