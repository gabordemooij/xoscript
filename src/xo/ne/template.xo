
# ~ Simple template engine ~

>> साँचो := वस्तु नयाँ.

साँचो जब: ['नयाँ'] गर: { <- आफू नयाँ सामग्री: [''].
}.

साँचो जब: ['सामग्री:'] गर: { :सामग्री
	आफ्नो सामग्री := सामग्री. 
}.

साँचो जब: ['नयाँ:'] गर: { :सामग्री <- आफू नयाँ सामग्री: सामग्री.
}.

साँचो जब: ['काट:'] गर: { :चिन्ह
	>> सुरु-चिन्ह := (['<!-- cut:%id% -->'] %id%: चिन्ह).
	>> अन्त्य-चिन्ह := (['<!-- /cut:%id% -->'] %id%: चिन्ह).
	>> भागहरू := आफ्नो सामग्री टुक्र्याऊ: सुरु-चिन्ह.
	>> उपसर्ग := भागहरू पहिलो.
	>> भागहरू2 := भागहरू अन्तिम टुक्र्याऊ: अन्त्य-चिन्ह.
	>> प्रत्यय := भागहरू2 अन्तिम.
	>> भाग := भागहरू2 पहिलो.
	>> बाँकी := उपसर्ग + प्रत्यय.
	आफ्नो सामग्री := बाँकी. <- साँचो नयाँ: भाग.
	
}.

साँचो जब: ['प्रतिलिपि'] गर: { <- आफू नयाँ: आफू पाठमा प्रतिलिपि.
}.
	
साँचो जब: ['टाँस:साँचो:'] गर: { :अंश :id
	>> टाँस्ने-चिन्ह := (['<!-- paste:%id% -->'] %id%: id).
	आफ्नो सामग्री बदल: टाँस्ने-चिन्ह ले: ( अंश पाठमा + टाँस्ने-चिन्ह ).
}.

साँचो जब: ['तोक:मान:'] गर: { :स्थान :मूल्य
	आफ्नो सामग्री बदल: ['<!-- slot:'] + स्थान + [' -->'] ले: ( Server html-इन्कोड: मूल्य ).
}.

साँचो जब: ['तोक:html:'] गर: { :स्थान :html
	आफ्नो सामग्री बदल: ['<!-- slot:'] + स्थान + [' -->'] ले: html.
}.

साँचो जब: ['जवाफ:र:'] गर: { :स्थान :मूल्य
	आफू तोक: (स्थान सुरु: 0 लम्बाइ: (स्थान लम्बाइ - 1)) मान: मूल्य.
}.

साँचो जब: ['nl2br'] गर: {
	आफ्नो सामग्री बदल: ['\n'] ले: ['<br>'].
}.

साँचो जब: ['चिन्ह-हटाउ'] गर: {
	आफ्नो सामग्री :=
		ढाँचा-खोज
		नयाँ: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		मिलान: आफ्नो सामग्री
		गर: { <- ['']. }.
}.

साँचो जब: ['काट-हटाउ'] गर: {
	>> वस्तुहरू := तालिका नयाँ.
	ढाँचा-खोज
	नयाँ: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	मिलान: आफ्नो सामग्री
	गर: { :_ :भाग
		वस्तुहरू अन्त्यमा-थप: भाग ? 1.
	}.
	वस्तुहरू प्रत्येक: { :_ :id
		आफ्नो सामग्री :=
			ढाँचा-खोज नयाँ: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			मिलान: आफ्नो सामग्री
			गर: { <- ['']. }.
	 }.
}.

साँचो जब: ['खाली-ठाउँ-हटाउ'] गर: {
	आफ्नो सामग्री :=
		ढाँचा-खोज
		नयाँ: ['\\s*\\n'],
		मिलान: आफ्नो सामग्री
		गर: { <- ['\n']. }.
	आफ्नो सामग्री :=
		ढाँचा-खोज
		नयाँ: ['\\n[\\s\\t]+'],
		मिलान: आफ्नो सामग्री
		गर: { <- ['\n']. }.
}.

साँचो जब: ['सबै-चिन्ह-हटाउ'] गर: {
	आफू चिन्ह-हटाउ.
	आफू काट-हटाउ.
	आफू खाली-ठाउँ-हटाउ.
}.

साँचो जब: ['पाठमा'] गर: { <- आफ्नो सामग्री.
}.
