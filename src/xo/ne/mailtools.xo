>> इमेल := वस्तु नयाँ.

इमेल जब: ['आरम्भ-गर'] गर: {
	आफ्नो प्रापकहरू := तालिका नयाँ.
	आफ्नो cc := तालिका नयाँ.
	आफ्नो bcc := तालिका नयाँ.
	आफ्नो प्रेषक := शून्य.
	आफ्नो प्रेषकको-नाम := शून्य.
	आफ्नो विषय := शून्य.
	आफ्नो मुख्य-पाठ := शून्य.
}.

इमेल जब: ['नयाँ'] गर: { <- आफू नयाँ आरम्भ-गर.
}.

इमेल जब: ['प्रापकलाई:'] गर: { :गणना-सूची
	आफ्नो प्रापकहरू := गणना-सूची.
}.
 
इमेल जब: ['cc:'] गर: { :गणना-सूची
	आफ्नो cc := गणना-सूची.
}.

इमेल जब: ['bcc:'] गर: { :गणना-सूची
	आफ्नो bcc := गणना-सूची.
}.

इमेल जब: ['विषय:'] गर: { :विषय
	आफ्नो विषय := विषय.
}.

इमेल जब: ['प्रेषक:नाम:'] गर: { :प्रेषक :नाम
	आफ्नो प्रेषक := प्रेषक.
	आफ्नो प्रेषकको-नाम := नाम.
}.

इमेल जब: ['मुख्य-पाठ:'] गर: { :मुख्य-पाठ
	आफ्नो मुख्य-पाठ := मुख्य-पाठ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
इमेल जब: ['हेडर:'] गर: { :पङ्क्ति <- पङ्क्ति बदल: ['\r'] ले: [''], बदल: ['\n'] ले: [''].
}.

इमेल जब: ['पठाऊ'] गर: {
	>> f := फाइल tempwrite: आफू उत्पन्न-गर.
	प्रोग्राम प्रणाली: ['sendmail -t < '] + f फाइल-बाटो, नयाँ-पङ्क्ति.
}.

इमेल जब: ['उत्पन्न-गर'] गर: {
	>> पङ्क्ति-विच्छेद := ['\r\n'].
	>> पाठ-शृङ्खला := [''].
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['From: '] + आफ्नो प्रेषकको-नाम + [' <'] + ( आफ्नो प्रेषक ) + ['>']) + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['To: '] + ( आफ्नो प्रापकहरू जोड: [','] )) + पङ्क्ति-विच्छेद.
	आफ्नो cc गन्ती सत्य-भए: {
		पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Cc: '] + ( आफ्नो cc जोड: [','] )) + पङ्क्ति-विच्छेद.
	}.
	आफ्नो bcc गन्ती सत्य-भए: {
		पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Bcc: '] + ( आफ्नो bcc जोड: [','] )) + पङ्क्ति-विच्छेद.
	}.
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Subject: '] + आफ्नो विषय) + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: आफ्नो मुख्य-पाठ.
	पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद. <- पाठ-शृङ्खला.
}.

>> HTML-इमेल := इमेल नयाँ.

HTML-इमेल जब: ['आरम्भ-गर'] गर: {
	आफू आरम्भ-गर.
	आफ्नो संलग्नकहरू := तालिका नयाँ.
	आफ्नो सीमा := ढुकुटी टोकन: 40.
}.

HTML-इमेल जब: ['संलग्न-गर:'] गर: { :सत्र-फाइल
	>> id := आफ्नो संलग्नकहरू गन्ती.
	>> blob := सत्र-फाइल blob.
	आफ्नो संलग्नकहरू अन्त्यमा-थप: (
		शब्दकोश नयाँ
			सत्र-फाइल: सत्र-फाइल फाइल-बाटो,
			mime: ['image/'] + (Server mimetype: सत्र-फाइल फाइल-बाटो),
			डाटा: blob base64-इन्कोड
	).
	blob मुक्त. <- ['cid:attachment'] + id.
}.

HTML-इमेल जब: ['उत्पन्न-गर'] गर: {
	>> पङ्क्ति-विच्छेद := ['\r\n'].
	>> पाठ-शृङ्खला := [''].
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['From: '] + आफ्नो प्रेषकको-नाम + [' <'] + ( आफ्नो प्रेषक ) + ['>']) + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['To: '] + ( आफ्नो प्रापकहरू जोड: [','] )) + पङ्क्ति-विच्छेद.
	आफ्नो cc गन्ती सत्य-भए: {
		पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Cc: '] + ( आफ्नो cc जोड: [','] )) + पङ्क्ति-विच्छेद.
	}.
	आफ्नो bcc गन्ती सत्य-भए: {
		पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Bcc: '] + ( आफ्नो bcc जोड: [','] )) + पङ्क्ति-विच्छेद.
	}.
	पाठ-शृङ्खला अन्त्यमा-थप: (आफू हेडर: ['Subject: '] + आफ्नो विषय) + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: ['MIME-Version: 1.0'] + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Type: multipart/related; boundary="'] + आफ्नो सीमा + ['"; type=text/html'] + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: ['--'] + आफ्नो सीमा + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Type: text/html; charset=UTF-8'] + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Transfer-Encoding: 7bit'] + पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
	पाठ-शृङ्खला अन्त्यमा-थप: आफ्नो मुख्य-पाठ.
	पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
	आफ्नो संलग्नकहरू प्रत्येक: { :id :जानकारी
		>> blob := जानकारी डाटा.
		पाठ-शृङ्खला अन्त्यमा-थप: ['--'] + आफ्नो सीमा + पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Type: '] + जानकारी mime + पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Transfer-Encoding: base64'] + पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: ['Content-ID: <attachment'] + id + ['>'] + पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: ['Content-Disposition: inline; filename="'] + जानकारी सत्र-फाइल + ['"'] + पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
		>> माथिल्लो-सीमा := 76.
		>> पाठ-लम्बाइ := blob लम्बाइ.
		>> टुक्राहरू := (पाठ-लम्बाइ / माथिल्लो-सीमा) माथि-पूर्णाङ्क.
		{ :i
			>> टुक्रा := blob प्रतिलिपि सुरु: i * माथिल्लो-सीमा लम्बाइ: माथिल्लो-सीमा.
			पाठ-शृङ्खला अन्त्यमा-थप: टुक्रा + पङ्क्ति-विच्छेद.
		} * टुक्राहरू.
		पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
		पाठ-शृङ्खला अन्त्यमा-थप: पङ्क्ति-विच्छेद.
	}.
	पाठ-शृङ्खला अन्त्यमा-थप: ['--'] + आफ्नो सीमा + ['--'] + पङ्क्ति-विच्छेद. <- पाठ-शृङ्खला.
}.
