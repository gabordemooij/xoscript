>> Imèl := Objè nouvo.

Imèl lè: ['prepare'] fè: {
	pwòp moun-k-ap-resevwa := Lis nouvo.
	pwòp cc := Lis nouvo.
	pwòp bcc := Lis nouvo.
	pwòp moun-ki-voye := Anyen.
	pwòp non-moun-ki-voye := Anyen.
	pwòp sijè := Anyen.
	pwòp kò := Anyen.
}.

Imèl lè: ['nouvo'] fè: { <- tèt-li nouvo prepare.
}.

Imèl lè: ['bay:'] fè: { :enimerasyon
	pwòp moun-k-ap-resevwa := enimerasyon.
}.
 
Imèl lè: ['cc:'] fè: { :enimerasyon
	pwòp cc := enimerasyon.
}.

Imèl lè: ['bcc:'] fè: { :enimerasyon
	pwòp bcc := enimerasyon.
}.

Imèl lè: ['sijè:'] fè: { :sijè
	pwòp sijè := sijè.
}.

Imèl lè: ['moun-ki-voye:non:'] fè: { :moun-ki-voye :non
	pwòp moun-ki-voye := moun-ki-voye.
	pwòp non-moun-ki-voye := non.
}.

Imèl lè: ['kò:'] fè: { :kò
	pwòp kò := kò.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imèl lè: ['antèt:'] fè: { :liy <- liy ranplase: ['\r'] ak: [''], ranplase: ['\n'] ak: [''].
}.

Imèl lè: ['voye'] fè: {
	>> f := Fichye tempwrite: tèt-li jenere.
	Pwogram sistèm: ['sendmail -t < '] + f chemen-fichye, nouvo-liy.
}.

Imèl lè: ['jenere'] fè: {
	>> kase-liy := ['\r\n'].
	>> chèn-tèks := [''].
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['From: '] + pwòp non-moun-ki-voye + [' <'] + ( pwòp moun-ki-voye ) + ['>']) + kase-liy.
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['To: '] + ( pwòp moun-k-ap-resevwa kole-ansanm: [','] )) + kase-liy.
	pwòp cc konte vre: {
		chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Cc: '] + ( pwòp cc kole-ansanm: [','] )) + kase-liy.
	}.
	pwòp bcc konte vre: {
		chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Bcc: '] + ( pwòp bcc kole-ansanm: [','] )) + kase-liy.
	}.
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Subject: '] + pwòp sijè) + kase-liy.
	chèn-tèks ajoute-nan-fen: kase-liy.
	chèn-tèks ajoute-nan-fen: pwòp kò.
	chèn-tèks ajoute-nan-fen: kase-liy. <- chèn-tèks.
}.

>> Imèl-HTML := Imèl nouvo.

Imèl-HTML lè: ['prepare'] fè: {
	tèt-li prepare.
	pwòp atachman := Lis nouvo.
	pwòp limit := Kòfrefò jeton: 40.
}.

Imèl-HTML lè: ['tache:'] fè: { :fichye-sesyon
	>> id := pwòp atachman konte.
	>> blob := fichye-sesyon blob.
	pwòp atachman ajoute-nan-fen: (
		Diksyonè nouvo
			fichye-sesyon: fichye-sesyon chemen-fichye,
			mime: ['image/'] + (Server mimetype: fichye-sesyon chemen-fichye),
			done: blob base64-kode
	).
	blob libere. <- ['cid:attachment'] + id.
}.

Imèl-HTML lè: ['jenere'] fè: {
	>> kase-liy := ['\r\n'].
	>> chèn-tèks := [''].
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['From: '] + pwòp non-moun-ki-voye + [' <'] + ( pwòp moun-ki-voye ) + ['>']) + kase-liy.
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['To: '] + ( pwòp moun-k-ap-resevwa kole-ansanm: [','] )) + kase-liy.
	pwòp cc konte vre: {
		chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Cc: '] + ( pwòp cc kole-ansanm: [','] )) + kase-liy.
	}.
	pwòp bcc konte vre: {
		chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Bcc: '] + ( pwòp bcc kole-ansanm: [','] )) + kase-liy.
	}.
	chèn-tèks ajoute-nan-fen: (tèt-li antèt: ['Subject: '] + pwòp sijè) + kase-liy.
	chèn-tèks ajoute-nan-fen: ['MIME-Version: 1.0'] + kase-liy.
	chèn-tèks ajoute-nan-fen: ['Content-Type: multipart/related; boundary="'] + pwòp limit + ['"; type=text/html'] + kase-liy.
	chèn-tèks ajoute-nan-fen: kase-liy.
	chèn-tèks ajoute-nan-fen: ['--'] + pwòp limit + kase-liy.
	chèn-tèks ajoute-nan-fen: ['Content-Type: text/html; charset=UTF-8'] + kase-liy.
	chèn-tèks ajoute-nan-fen: ['Content-Transfer-Encoding: 7bit'] + kase-liy.
	chèn-tèks ajoute-nan-fen: kase-liy.
	chèn-tèks ajoute-nan-fen: pwòp kò.
	chèn-tèks ajoute-nan-fen: kase-liy.
	pwòp atachman chak: { :id :enfòmasyon
		>> blob := enfòmasyon done.
		chèn-tèks ajoute-nan-fen: ['--'] + pwòp limit + kase-liy.
		chèn-tèks ajoute-nan-fen: ['Content-Type: '] + enfòmasyon mime + kase-liy.
		chèn-tèks ajoute-nan-fen: ['Content-Transfer-Encoding: base64'] + kase-liy.
		chèn-tèks ajoute-nan-fen: ['Content-ID: <attachment'] + id + ['>'] + kase-liy.
		chèn-tèks ajoute-nan-fen: ['Content-Disposition: inline; filename="'] + enfòmasyon fichye-sesyon + ['"'] + kase-liy.
		chèn-tèks ajoute-nan-fen: kase-liy.
		>> pi-plis := 76.
		>> longè-tèks := blob longè.
		>> bout-yo := (longè-tèks / pi-plis) awondi-anwo.
		{ :i
			>> bout := blob kopye soti-nan: i * pi-plis longè: pi-plis.
			chèn-tèks ajoute-nan-fen: bout + kase-liy.
		} * bout-yo.
		chèn-tèks ajoute-nan-fen: kase-liy.
		chèn-tèks ajoute-nan-fen: kase-liy.
	}.
	chèn-tèks ajoute-nan-fen: ['--'] + pwòp limit + ['--'] + kase-liy. <- chèn-tèks.
}.
