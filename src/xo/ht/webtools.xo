Demann-HTTP lè: ['HTTP-antèt:'] fè: { :kle <- Pwogram paramèt: kle.
}.

>> Antèt-HTTP := Objè nouvo.

Antèt-HTTP lè: ['nouvo'] fè: { <- tèt-li nouvo prepare.
}.

Antèt-HTTP lè: ['prepare'] fè: {
	pwòp kle := Anyen.
	pwòp valè := Anyen.
}.

Antèt-HTTP lè: ['kle:valè:'] fè: { :kle :valè
	pwòp kle := kle.
	pwòp valè := valè.
}.

Antèt-HTTP lè: ['kle'] fè: { <- pwòp kle.
}.

Antèt-HTTP lè: ['valè'] fè: { <- pwòp valè.
}.


Antèt-HTTP lè: ['tèks'] fè: {
	>> liy := pwòp kle + [': '] + pwòp valè.
	liy ranplase: ['\r'] ak: [''], ranplase: ['\n'] ak: ['']. <- liy + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokiman-Wèb := Objè nouvo.

Dokiman-Wèb lè: ['nouvo'] fè: { <- tèt-li nouvo prepare.
}.

Dokiman-Wèb lè: ['prepare'] fè: {
	pwòp antèt-yo := Lis nouvo.
	pwòp id-sesyon := Anyen.
	pwòp jesyonè-sesyon := Sesyon-fichye-tanporè nouvo.
	pwòp done-sesyon := Anyen.
	pwòp sekirize := Vre.
	pwòp menm-sit := ['Strict'].
	pwòp antèt-yo-voye := Fo.
	pwòp demann-http := Demann-HTTP nouvo.
}.

Dokiman-Wèb lè: ['demann-http:'] fè: { :demann-http
	pwòp demann-http := demann-http.
}. 

Dokiman-Wèb lè: ['bonbon-sesyon-sekirize:'] fè: { :sekirize
	tèt-li verifye-antèt-yo.
	pwòp sekirize := sekirize.
}.

Dokiman-Wèb lè: ['bonbon-sesyon-menm-sit:'] fè: { :valè
	tèt-li verifye-antèt-yo.
	>> opsyon := Lis nouvo 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsyon gen: valè, fo: {
		travay-sa-a erè: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	pwòp menm-sit := valè.
}.

Dokiman-Wèb lè: ['antèt:'] fè: { :antèt
	tèt-li verifye-antèt-yo.
	pwòp antèt-yo ajoute-nan-fen: antèt.
}.

Dokiman-Wèb lè: ['efase-antèt-yo'] fè: {
	tèt-li verifye-antèt-yo.
	pwòp antèt-yo := Lis nouvo.
}.

Dokiman-Wèb lè: ['jesyonè-sesyon:'] fè: { :jesyonè
	tèt-li verifye-antèt-yo.
	pwòp jesyonè-sesyon := jesyonè.
}.

Dokiman-Wèb lè: ['jesyonè-sesyon'] fè: { <- pwòp jesyonè-sesyon.
}.

Dokiman-Wèb lè: ['verifye-antèt-yo'] fè: {
	pwòp antèt-yo-voye vre: {
		travay-sa-a erè: ['Headers already sent to client.'].
	}.
}.

Dokiman-Wèb lè: ['kòmanse-sesyon'] fè: {
	tèt-li verifye-antèt-yo.
	>> demann-http := pwòp demann-http.
	>> id-sesyon := demann-http cookie: ['xsid'].
	id-sesyon Anyen? fo: {
		(( Modèl nouvo: ['^[A-Za-z0-9]+\\z'], koresponn: id-sesyon ) = 0) vre: {
			id-sesyon := Anyen.
		}.
	}.
	id-sesyon Anyen? vre: {
		id-sesyon := Kòfrefò jeton: 30.
		>> antèt-sesyon := Antèt-HTTP nouvo
		kle: ['Set-Cookie'] valè: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (pwòp sekirize swa: ['Secure'] oswa: ['']),
		SSITE: (pwòp menm-sit),
		XSID: id-sesyon
		).
		pwòp antèt-yo ajoute-nan-fen: antèt-sesyon.
	}.
	pwòp done-sesyon := pwòp jesyonè-sesyon pou: id-sesyon, chaje. <- pwòp done-sesyon. # reference
}.

Dokiman-Wèb lè: ['ale-nan:'] fè: { :adrès
	tèt-li verifye-antèt-yo.
	tèt-li efase-antèt-yo.
	pwòp antèt-yo
	ajoute-nan-fen: (
		Antèt-HTTP nouvo
		kle: ['Status'] valè: ['303 See Other']
	),
	ajoute-nan-fen: (
		Antèt-HTTP nouvo
		kle: ['Location'] valè: adrès
	).
	tèt-li soti: ['Redirect'].
}.

Dokiman-Wèb lè: ['detwi-sesyon'] fè: {
	tèt-li verifye-antèt-yo.
	>> demann-http := pwòp demann-http.
	>> id-sesyon := demann-http cookie: ['xsid'].
	id-sesyon Anyen? fo: {
		>> antèt-sesyon := Antèt-HTTP nouvo.
		>> lè-fen := Moman nouvo ane: 1970, fòma: ['%a, %d %b %Y %H:%M:%S GMT'].
		antèt-sesyon kle: ['Set-Cookie'] valè: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: lè-fen,
			SEC: (pwòp sekirize swa: ['Secure'] oswa: ['']),
			SSITE: (pwòp menm-sit),
			XSID: id-sesyon
		).
		pwòp jesyonè-sesyon detwi.
		pwòp antèt-yo ajoute-nan-fen: antèt-sesyon.
	}.
}.


Dokiman-Wèb lè: ['gabari:'] fè: { :chemen-fichye <- Gabari nouvo: (Fichye nouvo: chemen-fichye, li-done).
}.

Dokiman-Wèb lè: ['soti:kalite:'] fè: { :rezilta :kalite
	pwòp antèt-yo-voye fo: {
		pwòp done-sesyon Anyen? fo: {
			pwòp jesyonè-sesyon sove: pwòp done-sesyon.
		}.
		pwòp antèt-yo ajoute-nan-fen: (
			Antèt-HTTP nouvo
			kle: ['Content-type'] valè: kalite
		).
		pwòp antèt-yo chak: { :_ :antèt
			Sòti ekri: antèt.
		}.
		pwòp antèt-yo-voye := Vre.
		Sòti ekri: ['\r\n'].
	}.
	Sòti ekri: rezilta.
}.

Dokiman-Wèb lè: ['fini:kalite:'] fè: { :rezilta :kalite
	pwòp antèt-yo-voye fo: {
		pwòp done-sesyon Anyen? fo: {
			pwòp jesyonè-sesyon sove: pwòp done-sesyon.
		}.
		pwòp antèt-yo ajoute-nan-fen: (
			Antèt-HTTP nouvo
			kle: ['Content-type'] valè: kalite
		).
		pwòp antèt-yo ajoute-nan-fen: (
			Antèt-HTTP nouvo
			kle: ['Content-Length'] valè: rezilta tèks bytes
		).
		pwòp antèt-yo chak: { :_ :antèt
			Sòti ekri: antèt.
		}.
		pwòp antèt-yo-voye := Vre.
		Sòti ekri: ['\r\n'].
	}.
	Sòti ekri: rezilta.
}.

Dokiman-Wèb lè: ['soti:'] fè: { :rezilta
	tèt-li soti: rezilta kalite: ['text/html; charset=utf-8'].
}.

Dokiman-Wèb lè: ['fini:'] fè: { :rezilta
	tèt-li fini: rezilta kalite: ['text/html; charset=utf-8'].
}.

Dokiman-Wèb lè: ['json:'] fè: { :rezilta
	tèt-li soti: ( JSON jsonify: rezilta ) kalite: ['application/json'].
}.

Dokiman-Wèb lè: ['pa-jwenn:'] fè: { :rezilta
	tèt-li efase-antèt-yo antèt: (
		Antèt-HTTP nouvo kle: ['Status'] valè: ['404 Not Found']
	).
	tèt-li soti: rezilta.
}.


# Interface

>> Sesyon := Objè nouvo.

Sesyon lè: ['nouvo'] fè: { <- tèt-li nouvo prepare pou: Anyen.
}.

Sesyon lè: ['pou:'] fè: { :id
	pwòp id := id.
}.

Sesyon lè: ['chaje'] fè: {
	travay-sa-a erè: ['Not implemented.'].
}.

Sesyon lè: ['sove:'] fè: {
	travay-sa-a erè: ['Not implemented.'].
}.

Sesyon lè: ['detwi'] fè: {
	travay-sa-a erè: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesyon-fichye-tanporè := Sesyon nouvo.

Sesyon-fichye-tanporè lè: ['prepare'] fè: {
	pwòp kòmansman-chemen := ['/tmp/sess-'].
}.

Sesyon-fichye-tanporè lè: ['prefiks-chemen:'] fè: { :chèn-tèks
	pwòp kòmansman-chemen := chèn-tèks.
}.

Sesyon-fichye-tanporè lè: ['fichye-sesyon'] fè: { <- ( Fichye nouvo: ( pwòp kòmansman-chemen + pwòp id + ['.txt'] ) ).
}.

Sesyon-fichye-tanporè lè: ['chaje'] fè: {
	>> fichye-sesyon := tèt-li fichye-sesyon.
	fichye-sesyon egziste fo: {
		fichye-sesyon ekri: (Diksyonè nouvo kòd).
	}. <- fichye-sesyon li-done objè.
}.

Sesyon-fichye-tanporè lè: ['sove:'] fè: { :done
	>> fichye-sesyon := tèt-li fichye-sesyon.
	fichye-sesyon egziste vre: {
		fichye-sesyon ekri: done kòd.
	}.
}.

Sesyon-fichye-tanporè lè: ['detwi'] fè: {
	>> fichye-sesyon := tèt-li fichye-sesyon.
	fichye-sesyon egziste vre: {
		fichye-sesyon efase.
	}.
}.


>> URL := Objè nouvo.

URL lè: ['prepare'] fè: {
	pwòp pwotokòl := ['https://'].
	pwòp lame := ['localhost'].
	pwòp chemen-fichye := [''].
	pwòp paramèt-url := [''].
	pwòp hash := [''].
}.

URL lè: ['nouvo'] fè: { <- tèt-li nouvo prepare.
}.

URL lè: ['tèks'] fè: { <- (
	pwòp pwotokòl +
	pwòp lame +
	pwòp chemen-fichye +
	pwòp paramèt-url +
	pwòp hash ).
}.

URL lè: ['pwotokòl:'] fè: { :pwotokòl
	((Lis nouvo ; ['http'] ; ['https']) gen: pwotokòl) vre: {
		pwòp pwotokòl := pwotokòl + ['://'].
	}, fo: {
		travay-sa-a erè: ['Invalid protocol'].
	}.
}.

URL lè: ['lame:'] fè: { :lame
	#todo validate according to rfc
	pwòp lame := lame.
}.

URL lè: ['chemen-fichye:'] fè: { :chemen-fichye
	pwòp chemen-fichye := ['/'] + chemen-fichye url-kode.
}.

URL lè: ['paramèt-url:'] fè: { :kat
	>> paramèt-url := Lis nouvo.
	kat chak: { :kle :valè
		paramèt-url ajoute-nan-fen: kle tèks url-kode + ['='] + valè tèks url-kode.
	}.
	pwòp paramèt-url := ['?'] + ( paramèt-url kole-ansanm: ['&'] ).
}.

URL lè: ['rache:'] fè: { :hash
	pwòp hash := ['#'] + hash url-kode.
}.

