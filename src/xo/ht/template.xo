
# ~ Simple template engine ~

>> Gabari := Objè nouvo.

Gabari lè: ['nouvo'] fè: { <- tèt-li nouvo kontni: [''].
}.

Gabari lè: ['kontni:'] fè: { :kontni
	pwòp kontni := kontni. 
}.

Gabari lè: ['nouvo:'] fè: { :kontni <- tèt-li nouvo kontni: kontni.
}.

Gabari lè: ['koupe:'] fè: { :mak
	>> mak-kòmansman := (['<!-- cut:%id% -->'] %id%: mak).
	>> mak-fen := (['<!-- /cut:%id% -->'] %id%: mak).
	>> pati-yo := pwòp kontni divize: mak-kòmansman.
	>> prefiks := pati-yo premye.
	>> pati-yo2 := pati-yo dènye divize: mak-fen.
	>> sifiks := pati-yo2 dènye.
	>> pati := pati-yo2 premye.
	>> rès := prefiks + sifiks.
	pwòp kontni := rès. <- Gabari nouvo: pati.
	
}.

Gabari lè: ['kopye'] fè: { <- tèt-li nouvo: tèt-li tèks kopye.
}.
	
Gabari lè: ['kole:nan:'] fè: { :ekstrè :id
	>> mak-kole := (['<!-- paste:%id% -->'] %id%: id).
	pwòp kontni ranplase: mak-kole ak: ( ekstrè tèks + mak-kole ).
}.

Gabari lè: ['fikse:valè:'] fè: { :plas :valè
	pwòp kontni ranplase: ['<!-- slot:'] + plas + [' -->'] ak: ( Server html-kode: valè ).
}.

Gabari lè: ['fikse:html:'] fè: { :plas :html
	pwòp kontni ranplase: ['<!-- slot:'] + plas + [' -->'] ak: html.
}.

Gabari lè: ['reponn:ak:'] fè: { :plas :valè
	tèt-li fikse: (plas soti-nan: 0 longè: (plas longè - 1)) valè: valè.
}.

Gabari lè: ['nl2br'] fè: {
	pwòp kontni ranplase: ['\n'] ak: ['<br>'].
}.

Gabari lè: ['ranje'] fè: {
	pwòp kontni :=
		Modèl
		nouvo: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		koresponn: pwòp kontni
		fè: { <- ['']. }.
}.

Gabari lè: ['ranje-koupe-yo'] fè: {
	>> atik := Lis nouvo.
	Modèl
	nouvo: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	koresponn: pwòp kontni
	fè: { :_ :pati
		atik ajoute-nan-fen: pati ? 1.
	}.
	atik chak: { :_ :id
		pwòp kontni :=
			Modèl nouvo: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			koresponn: pwòp kontni
			fè: { <- ['']. }.
	 }.
}.

Gabari lè: ['ranje-espas-yo'] fè: {
	pwòp kontni :=
		Modèl
		nouvo: ['\\s*\\n'],
		koresponn: pwòp kontni
		fè: { <- ['\n']. }.
	pwòp kontni :=
		Modèl
		nouvo: ['\\n[\\s\\t]+'],
		koresponn: pwòp kontni
		fè: { <- ['\n']. }.
}.

Gabari lè: ['ranje-tout'] fè: {
	tèt-li ranje.
	tèt-li ranje-koupe-yo.
	tèt-li ranje-espas-yo.
}.

Gabari lè: ['tèks'] fè: { <- pwòp kontni.
}.
