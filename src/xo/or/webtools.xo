HTTP-ଅନୁରୋଧ ଯେବେ: ['HTTP-header:'] କର: { :key <- ପ୍ରୋଗ୍ରାମ୍ ସେଟିଂ: key.
}.

>> HTTP-Header := ବସ୍ତୁ ନୂତନ.

HTTP-Header ଯେବେ: ['ନୂତନ'] କର: { <- ନିଜେ ନୂତନ init.
}.

HTTP-Header ଯେବେ: ['init'] କର: {
	ନିଜର key := ଶୂନ୍ୟ.
	ନିଜର value := ଶୂନ୍ୟ.
}.

HTTP-Header ଯେବେ: ['key:value:'] କର: { :key :value
	ନିଜର key := key.
	ନିଜର value := value.
}.

HTTP-Header ଯେବେ: ['key'] କର: { <- ନିଜର key.
}.

HTTP-Header ଯେବେ: ['value'] କର: { <- ନିଜର value.
}.


HTTP-Header ଯେବେ: ['ପାଠ୍ୟରେ'] କର: {
	>> line := ନିଜର key + [': '] + ନିଜର value.
	line ବଦଳାଅ: ['\r'] ସହିତ: [''], ବଦଳାଅ: ['\n'] ସହିତ: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := ବସ୍ତୁ ନୂତନ.

Web-Document ଯେବେ: ['ନୂତନ'] କର: { <- ନିଜେ ନୂତନ init.
}.

Web-Document ଯେବେ: ['init'] କର: {
	ନିଜର headers := ସାରଣୀ ନୂତନ.
	ନିଜର sess-id := ଶୂନ୍ୟ.
	ନିଜର session-manager := Tempfile-Session ନୂତନ.
	ନିଜର sessdata := ଶୂନ୍ୟ.
	ନିଜର secure := ସତ୍ୟ.
	ନିଜର same-site := ['Strict'].
	ନିଜର headers-out := ମିଥ୍ୟା.
	ନିଜର request := HTTP-ଅନୁରୋଧ ନୂତନ.
}.

Web-Document ଯେବେ: ['request:'] କର: { :request
	ନିଜର request := request.
}. 

Web-Document ଯେବେ: ['secure-session-cookie:'] କର: { :secure
	ନିଜେ check-headers.
	ନିଜର secure := secure.
}.

Web-Document ଯେବେ: ['same-site-session-cookie:'] କର: { :value
	ନିଜେ check-headers.
	>> options := ସାରଣୀ ନୂତନ 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options ଧାରଣ-କରେ: value, ମିଥ୍ୟା-ହେଲେ: {
		ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	ନିଜର same-site := value.
}.

Web-Document ଯେବେ: ['header:'] କର: { :header
	ନିଜେ check-headers.
	ନିଜର headers ଶେଷରେ-ଯୋଡ଼: header.
}.

Web-Document ଯେବେ: ['clear-headers'] କର: {
	ନିଜେ check-headers.
	ନିଜର headers := ସାରଣୀ ନୂତନ.
}.

Web-Document ଯେବେ: ['session-manager:'] କର: { :manager
	ନିଜେ check-headers.
	ନିଜର session-manager := manager.
}.

Web-Document ଯେବେ: ['session-manager'] କର: { <- ନିଜର session-manager.
}.

Web-Document ଯେବେ: ['check-headers'] କର: {
	ନିଜର headers-out ସତ୍ୟ-ହେଲେ: {
		ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Headers already sent to client.'].
	}.
}.

Web-Document ଯେବେ: ['session-start'] କର: {
	ନିଜେ check-headers.
	>> request := ନିଜର request.
	>> sess-id := request cookie: ['xsid'].
	sess-id ଶୂନ୍ୟ? ମିଥ୍ୟା-ହେଲେ: {
		(( ପ୍ୟାଟର୍ନ ନୂତନ: ['^[A-Za-z0-9]+\\z'], ମେଳ: sess-id ) = 0) ସତ୍ୟ-ହେଲେ: {
			sess-id := ଶୂନ୍ୟ.
		}.
	}.
	sess-id ଶୂନ୍ୟ? ସତ୍ୟ-ହେଲେ: {
		sess-id := ସିନ୍ଦୁକ ଟୋକନ୍: 30.
		>> session-header := HTTP-Header ନୂତନ
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (ନିଜର secure ଏହା: ['Secure'] ନହେଲେ: ['']),
		SSITE: (ନିଜର same-site),
		XSID: sess-id
		).
		ନିଜର headers ଶେଷରେ-ଯୋଡ଼: session-header.
	}.
	ନିଜର sessdata := ନିଜର session-manager for: sess-id, load. <- ନିଜର sessdata. # reference
}.

Web-Document ଯେବେ: ['goto:'] କର: { :url
	ନିଜେ check-headers.
	ନିଜେ clear-headers.
	ନିଜର headers
	ଶେଷରେ-ଯୋଡ଼: (
		HTTP-Header ନୂତନ
		key: ['Status'] value: ['303 See Other']
	),
	ଶେଷରେ-ଯୋଡ଼: (
		HTTP-Header ନୂତନ
		key: ['Location'] value: url
	).
	ନିଜେ out: ['Redirect'].
}.

Web-Document ଯେବେ: ['session-destroy'] କର: {
	ନିଜେ check-headers.
	>> request := ନିଜର request.
	>> sess-id := request cookie: ['xsid'].
	sess-id ଶୂନ୍ୟ? ମିଥ୍ୟା-ହେଲେ: {
		>> session-header := HTTP-Header ନୂତନ.
		>> when := ମୁହୂର୍ତ୍ତ ନୂତନ ବର୍ଷ: 1970, ଫର୍ମାଟ୍-ରେ: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (ନିଜର secure ଏହା: ['Secure'] ନହେଲେ: ['']),
			SSITE: (ନିଜର same-site),
			XSID: sess-id
		).
		ନିଜର session-manager destroy.
		ନିଜର headers ଶେଷରେ-ଯୋଡ଼: session-header.
	}.
}.


Web-Document ଯେବେ: ['template:'] କର: { :ଫାଇଲ୍-ପଥ <- Template ନୂତନ: (ଫାଇଲ୍ ନୂତନ: ଫାଇଲ୍-ପଥ, ପଢ଼).
}.

Web-Document ଯେବେ: ['out:type:'] କର: { :output :ପ୍ରକାର
	ନିଜର headers-out ମିଥ୍ୟା-ହେଲେ: {
		ନିଜର sessdata ଶୂନ୍ୟ? ମିଥ୍ୟା-ହେଲେ: {
			ନିଜର session-manager save: ନିଜର sessdata.
		}.
		ନିଜର headers ଶେଷରେ-ଯୋଡ଼: (
			HTTP-Header ନୂତନ
			key: ['Content-type'] value: ପ୍ରକାର
		).
		ନିଜର headers ପ୍ରତ୍ୟେକ: { :_ :header
			ଆଉଟପୁଟ୍ ଲେଖ: header.
		}.
		ନିଜର headers-out := ସତ୍ୟ.
		ଆଉଟପୁଟ୍ ଲେଖ: ['\r\n'].
	}.
	ଆଉଟପୁଟ୍ ଲେଖ: output.
}.

Web-Document ଯେବେ: ['finish:type:'] କର: { :output :ପ୍ରକାର
	ନିଜର headers-out ମିଥ୍ୟା-ହେଲେ: {
		ନିଜର sessdata ଶୂନ୍ୟ? ମିଥ୍ୟା-ହେଲେ: {
			ନିଜର session-manager save: ନିଜର sessdata.
		}.
		ନିଜର headers ଶେଷରେ-ଯୋଡ଼: (
			HTTP-Header ନୂତନ
			key: ['Content-type'] value: ପ୍ରକାର
		).
		ନିଜର headers ଶେଷରେ-ଯୋଡ଼: (
			HTTP-Header ନୂତନ
			key: ['Content-Length'] value: output ପାଠ୍ୟରେ bytes
		).
		ନିଜର headers ପ୍ରତ୍ୟେକ: { :_ :header
			ଆଉଟପୁଟ୍ ଲେଖ: header.
		}.
		ନିଜର headers-out := ସତ୍ୟ.
		ଆଉଟପୁଟ୍ ଲେଖ: ['\r\n'].
	}.
	ଆଉଟପୁଟ୍ ଲେଖ: output.
}.

Web-Document ଯେବେ: ['out:'] କର: { :output
	ନିଜେ out: output type: ['text/html; charset=utf-8'].
}.

Web-Document ଯେବେ: ['finish:'] କର: { :output
	ନିଜେ finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document ଯେବେ: ['json:'] କର: { :output
	ନିଜେ out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document ଯେବେ: ['not-found:'] କର: { :output
	ନିଜେ clear-headers header: (
		HTTP-Header ନୂତନ key: ['Status'] value: ['404 Not Found']
	).
	ନିଜେ out: output.
}.


# Interface

>> Session := ବସ୍ତୁ ନୂତନ.

Session ଯେବେ: ['ନୂତନ'] କର: { <- ନିଜେ ନୂତନ init for: ଶୂନ୍ୟ.
}.

Session ଯେବେ: ['for:'] କର: { :id
	ନିଜର id := id.
}.

Session ଯେବେ: ['load'] କର: {
	ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Not implemented.'].
}.

Session ଯେବେ: ['save:'] କର: {
	ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Not implemented.'].
}.

Session ଯେବେ: ['destroy'] କର: {
	ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session ନୂତନ.

Tempfile-Session ଯେବେ: ['init'] କର: {
	ନିଜର pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session ଯେବେ: ['path-prefix:'] କର: { :str
	ନିଜର pathprefix := str.
}.

Tempfile-Session ଯେବେ: ['file'] କର: { <- ( ଫାଇଲ୍ ନୂତନ: ( ନିଜର pathprefix + ନିଜର id + ['.txt'] ) ).
}.

Tempfile-Session ଯେବେ: ['load'] କର: {
	>> file := ନିଜେ file.
	file ଅଛି ମିଥ୍ୟା-ହେଲେ: {
		file ଲେଖ: (ଅଭିଧାନ ନୂତନ କୋଡ୍).
	}. <- file ପଢ଼ ବସ୍ତୁରେ.
}.

Tempfile-Session ଯେବେ: ['save:'] କର: { :data
	>> file := ନିଜେ file.
	file ଅଛି ସତ୍ୟ-ହେଲେ: {
		file ଲେଖ: data କୋଡ୍.
	}.
}.

Tempfile-Session ଯେବେ: ['destroy'] କର: {
	>> file := ନିଜେ file.
	file ଅଛି ସତ୍ୟ-ହେଲେ: {
		file ଲିଭାଅ.
	}.
}.


>> URL := ବସ୍ତୁ ନୂତନ.

URL ଯେବେ: ['init'] କର: {
	ନିଜର protocol := ['https://'].
	ନିଜର ହୋଷ୍ଟ := ['localhost'].
	ନିଜର ଫାଇଲ୍-ପଥ := [''].
	ନିଜର params := [''].
	ନିଜର hash := [''].
}.

URL ଯେବେ: ['ନୂତନ'] କର: { <- ନିଜେ ନୂତନ init.
}.

URL ଯେବେ: ['ପାଠ୍ୟରେ'] କର: { <- (
	ନିଜର protocol +
	ନିଜର ହୋଷ୍ଟ +
	ନିଜର ଫାଇଲ୍-ପଥ +
	ନିଜର params +
	ନିଜର hash ).
}.

URL ଯେବେ: ['protocol:'] କର: { :protocol
	((ସାରଣୀ ନୂତନ: ['http'] ; ['https']) ଧାରଣ-କରେ: protocol) ସତ୍ୟ-ହେଲେ: {
		ନିଜର protocol := protocol + ['://'].
	}, ମିଥ୍ୟା-ହେଲେ: {
		ଏହି-କାର୍ଯ୍ୟ ତ୍ରୁଟି: ['Invalid protocol'].
	}.
}.

URL ଯେବେ: ['ହୋଷ୍ଟ:'] କର: { :ହୋଷ୍ଟ
	#todo validate according to rfc
	ନିଜର ହୋଷ୍ଟ := ହୋଷ୍ଟ.
}.

URL ଯେବେ: ['path:'] କର: { :ଫାଇଲ୍-ପଥ
	ନିଜର ଫାଇଲ୍-ପଥ := ['/'] + ଫାଇଲ୍-ପଥ url-ଏନକୋଡ୍.
}.

URL ଯେବେ: ['params:'] କର: { :map
	>> params := ସାରଣୀ ନୂତନ.
	map ପ୍ରତ୍ୟେକ: { :key :value
		params ଶେଷରେ-ଯୋଡ଼: key ପାଠ୍ୟରେ url-ଏନକୋଡ୍ + ['='] + value ପାଠ୍ୟରେ url-ଏନକୋଡ୍.
	}.
	ନିଜର params := ['?'] + ( params ଯୋଡ଼: ['&'] ).
}.

URL ଯେବେ: ['ହ୍ୟାସ୍:'] କର: { :hash
	ନିଜର hash := ['#'] + hash url-ଏନକୋଡ୍.
}.

