HTTP-Хүсэлт ирэхэд: ['HTTP-толгой:'] гүйцэтгэ: { :түлхүүр <- Програм тохиргоо: түлхүүр.
}.

>> HTTP-Толгой := Объект шинэ.

HTTP-Толгой ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ эхлүүлэх.
}.

HTTP-Толгой ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрийн түлхүүр := Хоосон.
	өөрийн утга := Хоосон.
}.

HTTP-Толгой ирэхэд: ['түлхүүр:утга:'] гүйцэтгэ: { :түлхүүр :утга
	өөрийн түлхүүр := түлхүүр.
	өөрийн утга := утга.
}.

HTTP-Толгой ирэхэд: ['түлхүүр'] гүйцэтгэ: { <- өөрийн түлхүүр.
}.

HTTP-Толгой ирэхэд: ['утга'] гүйцэтгэ: { <- өөрийн утга.
}.


HTTP-Толгой ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: {
	>> мөр := өөрийн түлхүүр + [': '] + өөрийн утга.
	мөр солих: ['\r'] үүгээр: [''], солих: ['\n'] үүгээр: ['']. <- мөр + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Вэб-баримт := Объект шинэ.

Вэб-баримт ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ эхлүүлэх.
}.

Вэб-баримт ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрийн толгойнууд := Жагсаалт шинэ.
	өөрийн сесс-id := Хоосон.
	өөрийн сесс-менежер := Түр-файлын-сесс шинэ.
	өөрийн сессийн-өгөгдөл := Хоосон.
	өөрийн аюулгүй := Үнэн.
	өөрийн ижил-сайт := ['Strict'].
	өөрийн толгойнууд-илгээгдсэн := Худал.
	өөрийн хүсэлт := HTTP-Хүсэлт шинэ.
}.

Вэб-баримт ирэхэд: ['хүсэлт:'] гүйцэтгэ: { :хүсэлт
	өөрийн хүсэлт := хүсэлт.
}. 

Вэб-баримт ирэхэд: ['аюулгүй-сесс-cookie:'] гүйцэтгэ: { :аюулгүй
	өөрөө толгойнуудыг-шалгах.
	өөрийн аюулгүй := аюулгүй.
}.

Вэб-баримт ирэхэд: ['ижил-сайтын-сесс-cookie:'] гүйцэтгэ: { :утга
	өөрөө толгойнуудыг-шалгах.
	>> сонголтууд := Жагсаалт шинэ 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	сонголтууд агуулах: утга, худал-бол: {
		энэ-даалгавар алдаа: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	өөрийн ижил-сайт := утга.
}.

Вэб-баримт ирэхэд: ['толгой:'] гүйцэтгэ: { :толгой
	өөрөө толгойнуудыг-шалгах.
	өөрийн толгойнууд төгсгөлд-нэмэх: толгой.
}.

Вэб-баримт ирэхэд: ['толгойнуудыг-хоослох'] гүйцэтгэ: {
	өөрөө толгойнуудыг-шалгах.
	өөрийн толгойнууд := Жагсаалт шинэ.
}.

Вэб-баримт ирэхэд: ['сесс-менежер:'] гүйцэтгэ: { :менежер
	өөрөө толгойнуудыг-шалгах.
	өөрийн сесс-менежер := менежер.
}.

Вэб-баримт ирэхэд: ['сесс-менежер'] гүйцэтгэ: { <- өөрийн сесс-менежер.
}.

Вэб-баримт ирэхэд: ['толгойнуудыг-шалгах'] гүйцэтгэ: {
	өөрийн толгойнууд-илгээгдсэн үнэн-бол: {
		энэ-даалгавар алдаа: ['Headers already sent to client.'].
	}.
}.

Вэб-баримт ирэхэд: ['сессийг-эхлүүлэх'] гүйцэтгэ: {
	өөрөө толгойнуудыг-шалгах.
	>> хүсэлт := өөрийн хүсэлт.
	>> сесс-id := хүсэлт cookie: ['xsid'].
	сесс-id Хоосон? худал-бол: {
		(( Загвар шинэ: ['^[A-Za-z0-9]+\\z'], таарал: сесс-id ) = 0) үнэн-бол: {
			сесс-id := Хоосон.
		}.
	}.
	сесс-id Хоосон? үнэн-бол: {
		сесс-id := Сейф токен: 30.
		>> сессийн-толгой := HTTP-Толгой шинэ
		түлхүүр: ['Set-Cookie'] утга: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (өөрийн аюулгүй энэ: ['Secure'] эс-бөгөөс: ['']),
		SSITE: (өөрийн ижил-сайт),
		XSID: сесс-id
		).
		өөрийн толгойнууд төгсгөлд-нэмэх: сессийн-толгой.
	}.
	өөрийн сессийн-өгөгдөл := өөрийн сесс-менежер зориулж: сесс-id, ачаалах. <- өөрийн сессийн-өгөгдөл. # reference
}.

Вэб-баримт ирэхэд: ['шилжих:'] гүйцэтгэ: { :хаяг
	өөрөө толгойнуудыг-шалгах.
	өөрөө толгойнуудыг-хоослох.
	өөрийн толгойнууд
	төгсгөлд-нэмэх: (
		HTTP-Толгой шинэ
		түлхүүр: ['Status'] утга: ['303 See Other']
	),
	төгсгөлд-нэмэх: (
		HTTP-Толгой шинэ
		түлхүүр: ['Location'] утга: хаяг
	).
	өөрөө гаргах: ['Redirect'].
}.

Вэб-баримт ирэхэд: ['сессийг-устгах'] гүйцэтгэ: {
	өөрөө толгойнуудыг-шалгах.
	>> хүсэлт := өөрийн хүсэлт.
	>> сесс-id := хүсэлт cookie: ['xsid'].
	сесс-id Хоосон? худал-бол: {
		>> сессийн-толгой := HTTP-Толгой шинэ.
		>> агшин := Агшин шинэ жил: 1970, хэлбэр: ['%a, %d %b %Y %H:%M:%S GMT'].
		сессийн-толгой түлхүүр: ['Set-Cookie'] утга: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: агшин,
			SEC: (өөрийн аюулгүй энэ: ['Secure'] эс-бөгөөс: ['']),
			SSITE: (өөрийн ижил-сайт),
			XSID: сесс-id
		).
		өөрийн сесс-менежер устгаж-дуусгах.
		өөрийн толгойнууд төгсгөлд-нэмэх: сессийн-толгой.
	}.
}.


Вэб-баримт ирэхэд: ['хэв:'] гүйцэтгэ: { :зам <- Хэв шинэ: (Файл шинэ: зам, унших).
}.

Вэб-баримт ирэхэд: ['гаргах:төрөл:'] гүйцэтгэ: { :үр-дүн :төрөл
	өөрийн толгойнууд-илгээгдсэн худал-бол: {
		өөрийн сессийн-өгөгдөл Хоосон? худал-бол: {
			өөрийн сесс-менежер хадгалах: өөрийн сессийн-өгөгдөл.
		}.
		өөрийн толгойнууд төгсгөлд-нэмэх: (
			HTTP-Толгой шинэ
			түлхүүр: ['Content-type'] утга: төрөл
		).
		өөрийн толгойнууд бүр: { :_ :толгой
			Гаралт бичих: толгой.
		}.
		өөрийн толгойнууд-илгээгдсэн := Үнэн.
		Гаралт бичих: ['\r\n'].
	}.
	Гаралт бичих: үр-дүн.
}.

Вэб-баримт ирэхэд: ['дуусгах:төрөл:'] гүйцэтгэ: { :үр-дүн :төрөл
	өөрийн толгойнууд-илгээгдсэн худал-бол: {
		өөрийн сессийн-өгөгдөл Хоосон? худал-бол: {
			өөрийн сесс-менежер хадгалах: өөрийн сессийн-өгөгдөл.
		}.
		өөрийн толгойнууд төгсгөлд-нэмэх: (
			HTTP-Толгой шинэ
			түлхүүр: ['Content-type'] утга: төрөл
		).
		өөрийн толгойнууд төгсгөлд-нэмэх: (
			HTTP-Толгой шинэ
			түлхүүр: ['Content-Length'] утга: үр-дүн тэмдэгт-мөр bytes
		).
		өөрийн толгойнууд бүр: { :_ :толгой
			Гаралт бичих: толгой.
		}.
		өөрийн толгойнууд-илгээгдсэн := Үнэн.
		Гаралт бичих: ['\r\n'].
	}.
	Гаралт бичих: үр-дүн.
}.

Вэб-баримт ирэхэд: ['гаргах:'] гүйцэтгэ: { :үр-дүн
	өөрөө гаргах: үр-дүн төрөл: ['text/html; charset=utf-8'].
}.

Вэб-баримт ирэхэд: ['дуусгах:'] гүйцэтгэ: { :үр-дүн
	өөрөө дуусгах: үр-дүн төрөл: ['text/html; charset=utf-8'].
}.

Вэб-баримт ирэхэд: ['json:'] гүйцэтгэ: { :үр-дүн
	өөрөө гаргах: ( JSON jsonify: үр-дүн ) төрөл: ['application/json'].
}.

Вэб-баримт ирэхэд: ['олдсонгүй:'] гүйцэтгэ: { :үр-дүн
	өөрөө толгойнуудыг-хоослох толгой: (
		HTTP-Толгой шинэ түлхүүр: ['Status'] утга: ['404 Not Found']
	).
	өөрөө гаргах: үр-дүн.
}.


# Interface

>> Сесс := Объект шинэ.

Сесс ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ эхлүүлэх зориулж: Хоосон.
}.

Сесс ирэхэд: ['зориулж:'] гүйцэтгэ: { :id
	өөрийн id := id.
}.

Сесс ирэхэд: ['ачаалах'] гүйцэтгэ: {
	энэ-даалгавар алдаа: ['Not implemented.'].
}.

Сесс ирэхэд: ['хадгалах:'] гүйцэтгэ: {
	энэ-даалгавар алдаа: ['Not implemented.'].
}.

Сесс ирэхэд: ['устгаж-дуусгах'] гүйцэтгэ: {
	энэ-даалгавар алдаа: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Түр-файлын-сесс := Сесс шинэ.

Түр-файлын-сесс ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрийн замын-эхлэл := ['/tmp/sess-'].
}.

Түр-файлын-сесс ирэхэд: ['замын-угтвар:'] гүйцэтгэ: { :тэмдэгт-цуваа
	өөрийн замын-эхлэл := тэмдэгт-цуваа.
}.

Түр-файлын-сесс ирэхэд: ['файл'] гүйцэтгэ: { <- ( Файл шинэ: ( өөрийн замын-эхлэл + өөрийн id + ['.txt'] ) ).
}.

Түр-файлын-сесс ирэхэд: ['ачаалах'] гүйцэтгэ: {
	>> файл := өөрөө файл.
	файл байгаа худал-бол: {
		файл бичих: (Толь шинэ код).
	}. <- файл унших объект.
}.

Түр-файлын-сесс ирэхэд: ['хадгалах:'] гүйцэтгэ: { :өгөгдөл
	>> файл := өөрөө файл.
	файл байгаа үнэн-бол: {
		файл бичих: өгөгдөл код.
	}.
}.

Түр-файлын-сесс ирэхэд: ['устгаж-дуусгах'] гүйцэтгэ: {
	>> файл := өөрөө файл.
	файл байгаа үнэн-бол: {
		файл устгах.
	}.
}.


>> URL := Объект шинэ.

URL ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрийн протокол := ['https://'].
	өөрийн хост := ['localhost'].
	өөрийн зам := [''].
	өөрийн url-параметрүүд := [''].
	өөрийн hash := [''].
}.

URL ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ эхлүүлэх.
}.

URL ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- (
	өөрийн протокол +
	өөрийн хост +
	өөрийн зам +
	өөрийн url-параметрүүд +
	өөрийн hash ).
}.

URL ирэхэд: ['протокол:'] гүйцэтгэ: { :протокол
	((Жагсаалт шинэ ; ['http'] ; ['https']) агуулах: протокол) үнэн-бол: {
		өөрийн протокол := протокол + ['://'].
	}, худал-бол: {
		энэ-даалгавар алдаа: ['Invalid protocol'].
	}.
}.

URL ирэхэд: ['хост:'] гүйцэтгэ: { :хост
	#todo validate according to rfc
	өөрийн хост := хост.
}.

URL ирэхэд: ['зам:'] гүйцэтгэ: { :зам
	өөрийн зам := ['/'] + зам url-кодлох.
}.

URL ирэхэд: ['url-параметрүүд:'] гүйцэтгэ: { :харгалзуулалт
	>> url-параметрүүд := Жагсаалт шинэ.
	харгалзуулалт бүр: { :түлхүүр :утга
		url-параметрүүд төгсгөлд-нэмэх: түлхүүр тэмдэгт-мөр url-кодлох + ['='] + утга тэмдэгт-мөр url-кодлох.
	}.
	өөрийн url-параметрүүд := ['?'] + ( url-параметрүүд нэгтгэх: ['&'] ).
}.

URL ирэхэд: ['хэш:'] гүйцэтгэ: { :hash
	өөрийн hash := ['#'] + hash url-кодлох.
}.

