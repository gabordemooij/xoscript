>> Имэйл := Объект шинэ.

Имэйл ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрийн хүлээн-авагчдын-жагсаалт := Жагсаалт шинэ.
	өөрийн cc := Жагсаалт шинэ.
	өөрийн bcc := Жагсаалт шинэ.
	өөрийн илгээгч := Хоосон.
	өөрийн илгээгчийн-нэр := Хоосон.
	өөрийн сэдэв := Хоосон.
	өөрийн үндсэн-текст := Хоосон.
}.

Имэйл ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ эхлүүлэх.
}.

Имэйл ирэхэд: ['хүлээн-авагчид:'] гүйцэтгэ: { :жагсаалт-зүйлс
	өөрийн хүлээн-авагчдын-жагсаалт := жагсаалт-зүйлс.
}.
 
Имэйл ирэхэд: ['cc:'] гүйцэтгэ: { :жагсаалт-зүйлс
	өөрийн cc := жагсаалт-зүйлс.
}.

Имэйл ирэхэд: ['bcc:'] гүйцэтгэ: { :жагсаалт-зүйлс
	өөрийн bcc := жагсаалт-зүйлс.
}.

Имэйл ирэхэд: ['сэдэв:'] гүйцэтгэ: { :сэдэв
	өөрийн сэдэв := сэдэв.
}.

Имэйл ирэхэд: ['илгээгч:нэр:'] гүйцэтгэ: { :илгээгч :нэр
	өөрийн илгээгч := илгээгч.
	өөрийн илгээгчийн-нэр := нэр.
}.

Имэйл ирэхэд: ['үндсэн-текст:'] гүйцэтгэ: { :үндсэн-текст
	өөрийн үндсэн-текст := үндсэн-текст.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Имэйл ирэхэд: ['толгой:'] гүйцэтгэ: { :мөр <- мөр солих: ['\r'] үүгээр: [''], солих: ['\n'] үүгээр: [''].
}.

Имэйл ирэхэд: ['илгээх'] гүйцэтгэ: {
	>> f := Файл tempwrite: өөрөө үүсгэх.
	Програм систем: ['sendmail -t < '] + f зам, шинэ-мөр.
}.

Имэйл ирэхэд: ['үүсгэх'] гүйцэтгэ: {
	>> мөр-таслал := ['\r\n'].
	>> тэмдэгт-цуваа := [''].
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['From: '] + өөрийн илгээгчийн-нэр + [' <'] + ( өөрийн илгээгч ) + ['>']) + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['To: '] + ( өөрийн хүлээн-авагчдын-жагсаалт нэгтгэх: [','] )) + мөр-таслал.
	өөрийн cc тоо-ширхэг үнэн-бол: {
		тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Cc: '] + ( өөрийн cc нэгтгэх: [','] )) + мөр-таслал.
	}.
	өөрийн bcc тоо-ширхэг үнэн-бол: {
		тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Bcc: '] + ( өөрийн bcc нэгтгэх: [','] )) + мөр-таслал.
	}.
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Subject: '] + өөрийн сэдэв) + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: өөрийн үндсэн-текст.
	тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал. <- тэмдэгт-цуваа.
}.

>> HTML-Имэйл := Имэйл шинэ.

HTML-Имэйл ирэхэд: ['эхлүүлэх'] гүйцэтгэ: {
	өөрөө эхлүүлэх.
	өөрийн хавсралтууд := Жагсаалт шинэ.
	өөрийн хил := Сейф токен: 40.
}.

HTML-Имэйл ирэхэд: ['хавсаргах:'] гүйцэтгэ: { :файл
	>> id := өөрийн хавсралтууд тоо-ширхэг.
	>> blob := файл blob.
	өөрийн хавсралтууд төгсгөлд-нэмэх: (
		Толь шинэ
			файл: файл зам,
			mime: ['image/'] + (Server mimetype: файл зам),
			өгөгдөл: blob base64-кодлох
	).
	blob чөлөөлөх. <- ['cid:attachment'] + id.
}.

HTML-Имэйл ирэхэд: ['үүсгэх'] гүйцэтгэ: {
	>> мөр-таслал := ['\r\n'].
	>> тэмдэгт-цуваа := [''].
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['From: '] + өөрийн илгээгчийн-нэр + [' <'] + ( өөрийн илгээгч ) + ['>']) + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['To: '] + ( өөрийн хүлээн-авагчдын-жагсаалт нэгтгэх: [','] )) + мөр-таслал.
	өөрийн cc тоо-ширхэг үнэн-бол: {
		тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Cc: '] + ( өөрийн cc нэгтгэх: [','] )) + мөр-таслал.
	}.
	өөрийн bcc тоо-ширхэг үнэн-бол: {
		тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Bcc: '] + ( өөрийн bcc нэгтгэх: [','] )) + мөр-таслал.
	}.
	тэмдэгт-цуваа төгсгөлд-нэмэх: (өөрөө толгой: ['Subject: '] + өөрийн сэдэв) + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['MIME-Version: 1.0'] + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Type: multipart/related; boundary="'] + өөрийн хил + ['"; type=text/html'] + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['--'] + өөрийн хил + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Type: text/html; charset=UTF-8'] + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Transfer-Encoding: 7bit'] + мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
	тэмдэгт-цуваа төгсгөлд-нэмэх: өөрийн үндсэн-текст.
	тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
	өөрийн хавсралтууд бүр: { :id :мэдээлэл
		>> blob := мэдээлэл өгөгдөл.
		тэмдэгт-цуваа төгсгөлд-нэмэх: ['--'] + өөрийн хил + мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Type: '] + мэдээлэл mime + мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Transfer-Encoding: base64'] + мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-ID: <attachment'] + id + ['>'] + мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: ['Content-Disposition: inline; filename="'] + мэдээлэл файл + ['"'] + мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
		>> дээд-хязгаар := 76.
		>> текстийн-урт := blob урт.
		>> хэсэгхэнүүд := (текстийн-урт / дээд-хязгаар) дээш-бүхэлтгэх.
		{ :i
			>> хэсэгхэн := blob хуулах эхлэл: i * дээд-хязгаар урт: дээд-хязгаар.
			тэмдэгт-цуваа төгсгөлд-нэмэх: хэсэгхэн + мөр-таслал.
		} * хэсэгхэнүүд.
		тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
		тэмдэгт-цуваа төгсгөлд-нэмэх: мөр-таслал.
	}.
	тэмдэгт-цуваа төгсгөлд-нэмэх: ['--'] + өөрийн хил + ['--'] + мөр-таслал. <- тэмдэгт-цуваа.
}.
