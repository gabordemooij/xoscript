
# ~ Simple template engine ~

>> Хэв := Объект шинэ.

Хэв ирэхэд: ['шинэ'] гүйцэтгэ: { <- өөрөө шинэ агуулга: [''].
}.

Хэв ирэхэд: ['агуулга:'] гүйцэтгэ: { :агуулга
	өөрийн агуулга := агуулга. 
}.

Хэв ирэхэд: ['шинэ:'] гүйцэтгэ: { :агуулга <- өөрөө шинэ агуулга: агуулга.
}.

Хэв ирэхэд: ['тасдах:'] гүйцэтгэ: { :тэмдэг
	>> эхлэлийн-тэмдэг := (['<!-- cut:%id% -->'] %id%: тэмдэг).
	>> төгсгөлийн-тэмдэг := (['<!-- /cut:%id% -->'] %id%: тэмдэг).
	>> хэсэглэлүүд := өөрийн агуулга хуваах: эхлэлийн-тэмдэг.
	>> угтвар := хэсэглэлүүд эхний.
	>> хэсэглэлүүд2 := хэсэглэлүүд сүүлийн хуваах: төгсгөлийн-тэмдэг.
	>> дагавар := хэсэглэлүүд2 сүүлийн.
	>> хэсэглэл := хэсэглэлүүд2 эхний.
	>> үлдэгдэл := угтвар + дагавар.
	өөрийн агуулга := үлдэгдэл. <- Хэв шинэ: хэсэглэл.
	
}.

Хэв ирэхэд: ['хуулах'] гүйцэтгэ: { <- өөрөө шинэ: өөрөө тэмдэгт-мөр хуулах.
}.
	
Хэв ирэхэд: ['буулгах:түлхүүр:'] гүйцэтгэ: { :хэсэгчлэл :id
	>> буулгах-тэмдэг := (['<!-- paste:%id% -->'] %id%: id).
	өөрийн агуулга солих: буулгах-тэмдэг үүгээр: ( хэсэгчлэл тэмдэгт-мөр + буулгах-тэмдэг ).
}.

Хэв ирэхэд: ['тохируулах:утга:'] гүйцэтгэ: { :байр :утга
	өөрийн агуулга солих: ['<!-- slot:'] + байр + [' -->'] үүгээр: ( Server html-кодлох: утга ).
}.

Хэв ирэхэд: ['тохируулах:html:'] гүйцэтгэ: { :байр :html
	өөрийн агуулга солих: ['<!-- slot:'] + байр + [' -->'] үүгээр: html.
}.

Хэв ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :байр :утга
	өөрөө тохируулах: (байр эхлэл: 0 урт: (байр урт - 1)) утга: утга.
}.

Хэв ирэхэд: ['nl2br'] гүйцэтгэ: {
	өөрийн агуулга солих: ['\n'] үүгээр: ['<br>'].
}.

Хэв ирэхэд: ['цэгцлэх'] гүйцэтгэ: {
	өөрийн агуулга :=
		Загвар
		шинэ: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		таарал: өөрийн агуулга
		гүйцэтгэ: { <- ['']. }.
}.

Хэв ирэхэд: ['тасархайг-цэгцлэх'] гүйцэтгэ: {
	>> элементүүд := Жагсаалт шинэ.
	Загвар
	шинэ: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	таарал: өөрийн агуулга
	гүйцэтгэ: { :_ :хэсэглэл
		элементүүд төгсгөлд-нэмэх: хэсэглэл ? 1.
	}.
	элементүүд бүр: { :_ :id
		өөрийн агуулга :=
			Загвар шинэ: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			таарал: өөрийн агуулга
			гүйцэтгэ: { <- ['']. }.
	 }.
}.

Хэв ирэхэд: ['зайг-цэгцлэх'] гүйцэтгэ: {
	өөрийн агуулга :=
		Загвар
		шинэ: ['\\s*\\n'],
		таарал: өөрийн агуулга
		гүйцэтгэ: { <- ['\n']. }.
	өөрийн агуулга :=
		Загвар
		шинэ: ['\\n[\\s\\t]+'],
		таарал: өөрийн агуулга
		гүйцэтгэ: { <- ['\n']. }.
}.

Хэв ирэхэд: ['бүгдийг-цэгцлэх'] гүйцэтгэ: {
	өөрөө цэгцлэх.
	өөрөө тасархайг-цэгцлэх.
	өөрөө зайг-цэгцлэх.
}.

Хэв ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- өөрийн агуулга.
}.
