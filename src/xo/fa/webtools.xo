درخواست-HTTP هنگام: ['HTTP-سرآیند:'] انجام: { :کلید <- برنامه پیکربندی: کلید.
}.

>> سرآیند-HTTP := شیء جدید.

سرآیند-HTTP هنگام: ['جدید'] انجام: { <- خود جدید آماده-سازی.
}.

سرآیند-HTTP هنگام: ['آماده-سازی'] انجام: {
	خودم کلید := هیچ.
	خودم مقدار := هیچ.
}.

سرآیند-HTTP هنگام: ['کلید:مقدار:'] انجام: { :کلید :مقدار
	خودم کلید := کلید.
	خودم مقدار := مقدار.
}.

سرآیند-HTTP هنگام: ['کلید'] انجام: { <- خودم کلید.
}.

سرآیند-HTTP هنگام: ['مقدار'] انجام: { <- خودم مقدار.
}.


سرآیند-HTTP هنگام: ['به-رشته'] انجام: {
	>> خط := خودم کلید + [': '] + خودم مقدار.
	خط جایگزین: ['\r'] با: [''], جایگزین: ['\n'] با: ['']. <- خط + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> سند-وب := شیء جدید.

سند-وب هنگام: ['جدید'] انجام: { <- خود جدید آماده-سازی.
}.

سند-وب هنگام: ['آماده-سازی'] انجام: {
	خودم سرآیندها := لیست جدید.
	خودم شناسه-نشست := هیچ.
	خودم مدیر-نشست := نشست-فایل-موقت جدید.
	خودم دادههای-نشست := هیچ.
	خودم امن := درست.
	خودم همان-سایت := ['Strict'].
	خودم سرآیندها-ارسال-شده := نادرست.
	خودم درخواست-http := درخواست-HTTP جدید.
}.

سند-وب هنگام: ['درخواست-http:'] انجام: { :درخواست-http
	خودم درخواست-http := درخواست-http.
}. 

سند-وب هنگام: ['کوکی-نشست-امن:'] انجام: { :امن
	خود بررسی-سرآیندها.
	خودم امن := امن.
}.

سند-وب هنگام: ['کوکی-نشست-همان-سایت:'] انجام: { :مقدار
	خود بررسی-سرآیندها.
	>> گزینهها := لیست جدید 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	گزینهها دارد: مقدار, اگر-نادرست: {
		این-کار خطا: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	خودم همان-سایت := مقدار.
}.

سند-وب هنگام: ['سرآیند:'] انجام: { :سرآیند
	خود بررسی-سرآیندها.
	خودم سرآیندها بیفزا-به-پایان: سرآیند.
}.

سند-وب هنگام: ['خالی-کردن-سرآیندها'] انجام: {
	خود بررسی-سرآیندها.
	خودم سرآیندها := لیست جدید.
}.

سند-وب هنگام: ['مدیر-نشست:'] انجام: { :مدیر
	خود بررسی-سرآیندها.
	خودم مدیر-نشست := مدیر.
}.

سند-وب هنگام: ['مدیر-نشست'] انجام: { <- خودم مدیر-نشست.
}.

سند-وب هنگام: ['بررسی-سرآیندها'] انجام: {
	خودم سرآیندها-ارسال-شده اگر-درست: {
		این-کار خطا: ['Headers already sent to client.'].
	}.
}.

سند-وب هنگام: ['شروع-نشست'] انجام: {
	خود بررسی-سرآیندها.
	>> درخواست-http := خودم درخواست-http.
	>> شناسه-نشست := درخواست-http cookie: ['xsid'].
	شناسه-نشست هیچ? اگر-نادرست: {
		(( الگو جدید: ['^[A-Za-z0-9]+\\z'], تطبیق: شناسه-نشست ) = 0) اگر-درست: {
			شناسه-نشست := هیچ.
		}.
	}.
	شناسه-نشست هیچ? اگر-درست: {
		شناسه-نشست := گاوصندوق توکن: 30.
		>> سرآیند-نشست := سرآیند-HTTP جدید
		کلید: ['Set-Cookie'] مقدار: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (خودم امن یکی: ['Secure'] یا-دیگری: ['']),
		SSITE: (خودم همان-سایت),
		XSID: شناسه-نشست
		).
		خودم سرآیندها بیفزا-به-پایان: سرآیند-نشست.
	}.
	خودم دادههای-نشست := خودم مدیر-نشست برای: شناسه-نشست, بارگذاری. <- خودم دادههای-نشست. # reference
}.

سند-وب هنگام: ['برو-به:'] انجام: { :نشانی
	خود بررسی-سرآیندها.
	خود خالی-کردن-سرآیندها.
	خودم سرآیندها
	بیفزا-به-پایان: (
		سرآیند-HTTP جدید
		کلید: ['Status'] مقدار: ['303 See Other']
	),
	بیفزا-به-پایان: (
		سرآیند-HTTP جدید
		کلید: ['Location'] مقدار: نشانی
	).
	خود خروجی-بده: ['Redirect'].
}.

سند-وب هنگام: ['نابودی-نشست'] انجام: {
	خود بررسی-سرآیندها.
	>> درخواست-http := خودم درخواست-http.
	>> شناسه-نشست := درخواست-http cookie: ['xsid'].
	شناسه-نشست هیچ? اگر-نادرست: {
		>> سرآیند-نشست := سرآیند-HTTP جدید.
		>> زمان-انقضا := لحظه جدید سال: 1970, با-قالب: ['%a, %d %b %Y %H:%M:%S GMT'].
		سرآیند-نشست کلید: ['Set-Cookie'] مقدار: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: زمان-انقضا,
			SEC: (خودم امن یکی: ['Secure'] یا-دیگری: ['']),
			SSITE: (خودم همان-سایت),
			XSID: شناسه-نشست
		).
		خودم مدیر-نشست نابود-کن.
		خودم سرآیندها بیفزا-به-پایان: سرآیند-نشست.
	}.
}.


سند-وب هنگام: ['شابلون:'] انجام: { :مسیر-پرونده <- شابلون جدید: (پرونده جدید: مسیر-پرونده, بخوان).
}.

سند-وب هنگام: ['خروجی-بده:نوع:'] انجام: { :برونداد :نوع
	خودم سرآیندها-ارسال-شده اگر-نادرست: {
		خودم دادههای-نشست هیچ? اگر-نادرست: {
			خودم مدیر-نشست ذخیره: خودم دادههای-نشست.
		}.
		خودم سرآیندها بیفزا-به-پایان: (
			سرآیند-HTTP جدید
			کلید: ['Content-type'] مقدار: نوع
		).
		خودم سرآیندها هرکدام: { :_ :سرآیند
			خروجی بنویس: سرآیند.
		}.
		خودم سرآیندها-ارسال-شده := درست.
		خروجی بنویس: ['\r\n'].
	}.
	خروجی بنویس: برونداد.
}.

سند-وب هنگام: ['پایان-بده:نوع:'] انجام: { :برونداد :نوع
	خودم سرآیندها-ارسال-شده اگر-نادرست: {
		خودم دادههای-نشست هیچ? اگر-نادرست: {
			خودم مدیر-نشست ذخیره: خودم دادههای-نشست.
		}.
		خودم سرآیندها بیفزا-به-پایان: (
			سرآیند-HTTP جدید
			کلید: ['Content-type'] مقدار: نوع
		).
		خودم سرآیندها بیفزا-به-پایان: (
			سرآیند-HTTP جدید
			کلید: ['Content-Length'] مقدار: برونداد به-رشته بایت-ها
		).
		خودم سرآیندها هرکدام: { :_ :سرآیند
			خروجی بنویس: سرآیند.
		}.
		خودم سرآیندها-ارسال-شده := درست.
		خروجی بنویس: ['\r\n'].
	}.
	خروجی بنویس: برونداد.
}.

سند-وب هنگام: ['خروجی-بده:'] انجام: { :برونداد
	خود خروجی-بده: برونداد نوع: ['text/html; charset=utf-8'].
}.

سند-وب هنگام: ['پایان-بده:'] انجام: { :برونداد
	خود پایان-بده: برونداد نوع: ['text/html; charset=utf-8'].
}.

سند-وب هنگام: ['json:'] انجام: { :برونداد
	خود خروجی-بده: ( JSON jsonify: برونداد ) نوع: ['application/json'].
}.

سند-وب هنگام: ['یافت-نشد:'] انجام: { :برونداد
	خود خالی-کردن-سرآیندها سرآیند: (
		سرآیند-HTTP جدید کلید: ['Status'] مقدار: ['404 Not Found']
	).
	خود خروجی-بده: برونداد.
}.


# Interface

>> نشست := شیء جدید.

نشست هنگام: ['جدید'] انجام: { <- خود جدید آماده-سازی برای: هیچ.
}.

نشست هنگام: ['برای:'] انجام: { :id
	خودم id := id.
}.

نشست هنگام: ['بارگذاری'] انجام: {
	این-کار خطا: ['Not implemented.'].
}.

نشست هنگام: ['ذخیره:'] انجام: {
	این-کار خطا: ['Not implemented.'].
}.

نشست هنگام: ['نابود-کن'] انجام: {
	این-کار خطا: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> نشست-فایل-موقت := نشست جدید.

نشست-فایل-موقت هنگام: ['آماده-سازی'] انجام: {
	خودم آغاز-مسیر := ['/tmp/sess-'].
}.

نشست-فایل-موقت هنگام: ['پیشوند-مسیر:'] انجام: { :رشته-متنی
	خودم آغاز-مسیر := رشته-متنی.
}.

نشست-فایل-موقت هنگام: ['فایل'] انجام: { <- ( پرونده جدید: ( خودم آغاز-مسیر + خودم id + ['.txt'] ) ).
}.

نشست-فایل-موقت هنگام: ['بارگذاری'] انجام: {
	>> فایل := خود فایل.
	فایل هست اگر-نادرست: {
		فایل بنویس: (واژه-نامه جدید کد).
	}. <- فایل بخوان به-شیء.
}.

نشست-فایل-موقت هنگام: ['ذخیره:'] انجام: { :دادهها
	>> فایل := خود فایل.
	فایل هست اگر-درست: {
		فایل بنویس: دادهها کد.
	}.
}.

نشست-فایل-موقت هنگام: ['نابود-کن'] انجام: {
	>> فایل := خود فایل.
	فایل هست اگر-درست: {
		فایل پاک-کن.
	}.
}.


>> URL := شیء جدید.

URL هنگام: ['آماده-سازی'] انجام: {
	خودم پروتکل := ['https://'].
	خودم میزبان := ['localhost'].
	خودم مسیر-پرونده := [''].
	خودم پارامترهای-url := [''].
	خودم hash := [''].
}.

URL هنگام: ['جدید'] انجام: { <- خود جدید آماده-سازی.
}.

URL هنگام: ['به-رشته'] انجام: { <- (
	خودم پروتکل +
	خودم میزبان +
	خودم مسیر-پرونده +
	خودم پارامترهای-url +
	خودم hash ).
}.

URL هنگام: ['پروتکل:'] انجام: { :پروتکل
	((لیست جدید ; ['http'] ; ['https']) دارد: پروتکل) اگر-درست: {
		خودم پروتکل := پروتکل + ['://'].
	}, اگر-نادرست: {
		این-کار خطا: ['Invalid protocol'].
	}.
}.

URL هنگام: ['میزبان:'] انجام: { :میزبان
	#todo validate according to rfc
	خودم میزبان := میزبان.
}.

URL هنگام: ['مسیر-پرونده:'] انجام: { :مسیر-پرونده
	خودم مسیر-پرونده := ['/'] + مسیر-پرونده url-کدگذاری.
}.

URL هنگام: ['پارامترهای-url:'] انجام: { :نگاشت
	>> پارامترهای-url := لیست جدید.
	نگاشت هرکدام: { :کلید :مقدار
		پارامترهای-url بیفزا-به-پایان: کلید به-رشته url-کدگذاری + ['='] + مقدار به-رشته url-کدگذاری.
	}.
	خودم پارامترهای-url := ['?'] + ( پارامترهای-url بپیوند: ['&'] ).
}.

URL هنگام: ['درهم-سازی:'] انجام: { :hash
	خودم hash := ['#'] + hash url-کدگذاری.
}.

