>> ایمیل := شیء جدید.

ایمیل هنگام: ['آماده-سازی'] انجام: {
	خودم گیرندگان := لیست جدید.
	خودم cc := لیست جدید.
	خودم bcc := لیست جدید.
	خودم فرستنده := هیچ.
	خودم نام-فرستنده := هیچ.
	خودم موضوع := هیچ.
	خودم بدنه := هیچ.
}.

ایمیل هنگام: ['جدید'] انجام: { <- خود جدید آماده-سازی.
}.

ایمیل هنگام: ['به:'] انجام: { :فهرست-اقلام
	خودم گیرندگان := فهرست-اقلام.
}.
 
ایمیل هنگام: ['cc:'] انجام: { :فهرست-اقلام
	خودم cc := فهرست-اقلام.
}.

ایمیل هنگام: ['bcc:'] انجام: { :فهرست-اقلام
	خودم bcc := فهرست-اقلام.
}.

ایمیل هنگام: ['موضوع:'] انجام: { :موضوع
	خودم موضوع := موضوع.
}.

ایمیل هنگام: ['فرستنده:نام:'] انجام: { :فرستنده :نام
	خودم فرستنده := فرستنده.
	خودم نام-فرستنده := نام.
}.

ایمیل هنگام: ['بدنه:'] انجام: { :بدنه
	خودم بدنه := بدنه.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
ایمیل هنگام: ['سرآیند:'] انجام: { :خط <- خط جایگزین: ['\r'] با: [''], جایگزین: ['\n'] با: [''].
}.

ایمیل هنگام: ['بفرست'] انجام: {
	>> f := پرونده نوشتن-موقت: خود تولید-کن.
	برنامه سیستم: ['sendmail -t < '] + f مسیر-پرونده, سطر-نو.
}.

ایمیل هنگام: ['تولید-کن'] انجام: {
	>> شکست-خط := ['\r\n'].
	>> رشته-متنی := [''].
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['From: '] + خودم نام-فرستنده + [' <'] + ( خودم فرستنده ) + ['>']) + شکست-خط.
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['To: '] + ( خودم گیرندگان بپیوند: [','] )) + شکست-خط.
	خودم cc تعداد اگر-درست: {
		رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Cc: '] + ( خودم cc بپیوند: [','] )) + شکست-خط.
	}.
	خودم bcc تعداد اگر-درست: {
		رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Bcc: '] + ( خودم bcc بپیوند: [','] )) + شکست-خط.
	}.
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Subject: '] + خودم موضوع) + شکست-خط.
	رشته-متنی بیفزا-به-پایان: شکست-خط.
	رشته-متنی بیفزا-به-پایان: خودم بدنه.
	رشته-متنی بیفزا-به-پایان: شکست-خط. <- رشته-متنی.
}.

>> ایمیل-HTML := ایمیل جدید.

ایمیل-HTML هنگام: ['آماده-سازی'] انجام: {
	خود آماده-سازی.
	خودم پیوستها := لیست جدید.
	خودم مرز := گاوصندوق توکن: 40.
}.

ایمیل-HTML هنگام: ['پیوست-کن:'] انجام: { :فایل
	>> id := خودم پیوستها تعداد.
	>> blob := فایل blob.
	خودم پیوستها بیفزا-به-پایان: (
		واژه-نامه جدید
			فایل: فایل مسیر-پرونده,
			mime: ['image/'] + (Server mimetype: فایل مسیر-پرونده),
			دادهها: blob base64-کدگذاری
	).
	blob آزاد-کن. <- ['cid:attachment'] + id.
}.

ایمیل-HTML هنگام: ['تولید-کن'] انجام: {
	>> شکست-خط := ['\r\n'].
	>> رشته-متنی := [''].
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['From: '] + خودم نام-فرستنده + [' <'] + ( خودم فرستنده ) + ['>']) + شکست-خط.
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['To: '] + ( خودم گیرندگان بپیوند: [','] )) + شکست-خط.
	خودم cc تعداد اگر-درست: {
		رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Cc: '] + ( خودم cc بپیوند: [','] )) + شکست-خط.
	}.
	خودم bcc تعداد اگر-درست: {
		رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Bcc: '] + ( خودم bcc بپیوند: [','] )) + شکست-خط.
	}.
	رشته-متنی بیفزا-به-پایان: (خود سرآیند: ['Subject: '] + خودم موضوع) + شکست-خط.
	رشته-متنی بیفزا-به-پایان: ['MIME-Version: 1.0'] + شکست-خط.
	رشته-متنی بیفزا-به-پایان: ['Content-Type: multipart/related; boundary="'] + خودم مرز + ['"; type=text/html'] + شکست-خط.
	رشته-متنی بیفزا-به-پایان: شکست-خط.
	رشته-متنی بیفزا-به-پایان: ['--'] + خودم مرز + شکست-خط.
	رشته-متنی بیفزا-به-پایان: ['Content-Type: text/html; charset=UTF-8'] + شکست-خط.
	رشته-متنی بیفزا-به-پایان: ['Content-Transfer-Encoding: 7bit'] + شکست-خط.
	رشته-متنی بیفزا-به-پایان: شکست-خط.
	رشته-متنی بیفزا-به-پایان: خودم بدنه.
	رشته-متنی بیفزا-به-پایان: شکست-خط.
	خودم پیوستها هرکدام: { :id :اطلاعات
		>> blob := اطلاعات دادهها.
		رشته-متنی بیفزا-به-پایان: ['--'] + خودم مرز + شکست-خط.
		رشته-متنی بیفزا-به-پایان: ['Content-Type: '] + اطلاعات mime + شکست-خط.
		رشته-متنی بیفزا-به-پایان: ['Content-Transfer-Encoding: base64'] + شکست-خط.
		رشته-متنی بیفزا-به-پایان: ['Content-ID: <attachment'] + id + ['>'] + شکست-خط.
		رشته-متنی بیفزا-به-پایان: ['Content-Disposition: inline; filename="'] + اطلاعات فایل + ['"'] + شکست-خط.
		رشته-متنی بیفزا-به-پایان: شکست-خط.
		>> حداکثر-اندازه := 76.
		>> طول-متن := blob طول.
		>> قطعهها := (طول-متن / حداکثر-اندازه) گرد-بالا.
		{ :i
			>> قطعه := blob رونوشت آغاز: i * حداکثر-اندازه طول: حداکثر-اندازه.
			رشته-متنی بیفزا-به-پایان: قطعه + شکست-خط.
		} * قطعهها.
		رشته-متنی بیفزا-به-پایان: شکست-خط.
		رشته-متنی بیفزا-به-پایان: شکست-خط.
	}.
	رشته-متنی بیفزا-به-پایان: ['--'] + خودم مرز + ['--'] + شکست-خط. <- رشته-متنی.
}.
