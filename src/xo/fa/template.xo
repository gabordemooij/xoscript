
# ~ Simple template engine ~

>> شابلون := شیء جدید.

شابلون هنگام: ['جدید'] انجام: { <- خود جدید محتوا: [''].
}.

شابلون هنگام: ['محتوا:'] انجام: { :محتوا
	خودم محتوا := محتوا. 
}.

شابلون هنگام: ['جدید:'] انجام: { :محتوا <- خود جدید محتوا: محتوا.
}.

شابلون هنگام: ['برش:'] انجام: { :نشانگر
	>> نشانگر-آغاز := (['<!-- cut:%id% -->'] %id%: نشانگر).
	>> نشانگر-پایان := (['<!-- /cut:%id% -->'] %id%: نشانگر).
	>> بخشها := خودم محتوا جدا-کن: نشانگر-آغاز.
	>> پیشوند := بخشها نخست.
	>> بخشها2 := بخشها آخری جدا-کن: نشانگر-پایان.
	>> پسوند := بخشها2 آخری.
	>> بخش := بخشها2 نخست.
	>> باقیمانده := پیشوند + پسوند.
	خودم محتوا := باقیمانده. <- شابلون جدید: بخش.
	
}.

شابلون هنگام: ['رونوشت'] انجام: { <- خود جدید: خود به-رشته رونوشت.
}.
	
شابلون هنگام: ['بچسبان:کلید:'] انجام: { :برگزیده :id
	>> نشانگر-چسباندن := (['<!-- paste:%id% -->'] %id%: id).
	خودم محتوا جایگزین: نشانگر-چسباندن با: ( برگزیده به-رشته + نشانگر-چسباندن ).
}.

شابلون هنگام: ['تنظیم:مقدار:'] انجام: { :جایگاه :مقدار
	خودم محتوا جایگزین: ['<!-- slot:'] + جایگاه + [' -->'] با: ( Server html-کدگذاری: مقدار ).
}.

شابلون هنگام: ['تنظیم:html:'] انجام: { :جایگاه :html
	خودم محتوا جایگزین: ['<!-- slot:'] + جایگاه + [' -->'] با: html.
}.

شابلون هنگام: ['پاسخ:و:'] انجام: { :جایگاه :مقدار
	خود تنظیم: (جایگاه آغاز: 0 طول: (جایگاه طول - 1)) مقدار: مقدار.
}.

شابلون هنگام: ['nl2br'] انجام: {
	خودم محتوا جایگزین: ['\n'] با: ['<br>'].
}.

شابلون هنگام: ['زدودن-نشانه'] انجام: {
	خودم محتوا :=
		الگو
		جدید: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		تطبیق: خودم محتوا
		انجام: { <- ['']. }.
}.

شابلون هنگام: ['زدودن-برشها'] انجام: {
	>> اقلام := لیست جدید.
	الگو
	جدید: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	تطبیق: خودم محتوا
	انجام: { :_ :بخش
		اقلام بیفزا-به-پایان: بخش ? 1.
	}.
	اقلام هرکدام: { :_ :id
		خودم محتوا :=
			الگو جدید: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			تطبیق: خودم محتوا
			انجام: { <- ['']. }.
	 }.
}.

شابلون هنگام: ['زدودن-فاصلهها'] انجام: {
	خودم محتوا :=
		الگو
		جدید: ['\\s*\\n'],
		تطبیق: خودم محتوا
		انجام: { <- ['\n']. }.
	خودم محتوا :=
		الگو
		جدید: ['\\n[\\s\\t]+'],
		تطبیق: خودم محتوا
		انجام: { <- ['\n']. }.
}.

شابلون هنگام: ['زدودن-همه'] انجام: {
	خود زدودن-نشانه.
	خود زدودن-برشها.
	خود زدودن-فاصلهها.
}.

شابلون هنگام: ['به-رشته'] انجام: { <- خودم محتوا.
}.
