
# ~ Simple template engine ~

>> Virlag := Objet nei.

Virlag bei: ['nei'] maachen: { <- selwer nei inhalt: [''].
}.

Virlag bei: ['inhalt:'] maachen: { :inhalt
	eegen inhalt := inhalt. 
}.

Virlag bei: ['nei:'] maachen: { :inhalt <- selwer nei inhalt: inhalt.
}.

Virlag bei: ['ausschneiden:'] maachen: { :markéierung
	>> startmarkéierung := (['<!-- cut:%id% -->'] %id%: markéierung).
	>> ennmarkéierung := (['<!-- /cut:%id% -->'] %id%: markéierung).
	>> deeler := eegen inhalt deelen: startmarkéierung.
	>> präfix := deeler éischten.
	>> deeler2 := deeler lescht deelen: ennmarkéierung.
	>> suffix := deeler2 lescht.
	>> deel := deeler2 éischten.
	>> rescht := präfix + suffix.
	eegen inhalt := rescht. <- Virlag nei: deel.
	
}.

Virlag bei: ['kopéieren'] maachen: { <- selwer nei: selwer text kopéieren.
}.
	
Virlag bei: ['apechen:bei:'] maachen: { :schnëppel :id
	>> apechmark := (['<!-- paste:%id% -->'] %id%: id).
	eegen inhalt ersetzen: apechmark mat: ( schnëppel text + apechmark ).
}.

Virlag bei: ['setzen:wäert:'] maachen: { :plaz :wäert
	eegen inhalt ersetzen: ['<!-- slot:'] + plaz + [' -->'] mat: ( Server html-kodéieren: wäert ).
}.

Virlag bei: ['setzen:html:'] maachen: { :plaz :html
	eegen inhalt ersetzen: ['<!-- slot:'] + plaz + [' -->'] mat: html.
}.

Virlag bei: ['äntweren:an:'] maachen: { :plaz :wäert
	selwer setzen: (plaz vun: 0 längt: (plaz längt - 1)) wäert: wäert.
}.

Virlag bei: ['nl2br'] maachen: {
	eegen inhalt ersetzen: ['\n'] mat: ['<br>'].
}.

Virlag bei: ['propper-maachen'] maachen: {
	eegen inhalt :=
		Muster
		nei: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		treffer: eegen inhalt
		maachen: { <- ['']. }.
}.

Virlag bei: ['schnëtt-propper-maachen'] maachen: {
	>> elementer := Lëscht nei.
	Muster
	nei: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	treffer: eegen inhalt
	maachen: { :_ :deel
		elementer drunhänken: deel ? 1.
	}.
	elementer all: { :_ :id
		eegen inhalt :=
			Muster nei: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			treffer: eegen inhalt
			maachen: { <- ['']. }.
	 }.
}.

Virlag bei: ['leerraum-propper-maachen'] maachen: {
	eegen inhalt :=
		Muster
		nei: ['\\s*\\n'],
		treffer: eegen inhalt
		maachen: { <- ['\n']. }.
	eegen inhalt :=
		Muster
		nei: ['\\n[\\s\\t]+'],
		treffer: eegen inhalt
		maachen: { <- ['\n']. }.
}.

Virlag bei: ['alles-propper-maachen'] maachen: {
	selwer propper-maachen.
	selwer schnëtt-propper-maachen.
	selwer leerraum-propper-maachen.
}.

Virlag bei: ['text'] maachen: { <- eegen inhalt.
}.
