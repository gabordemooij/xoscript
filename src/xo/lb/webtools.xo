HTTP-Ufro bei: ['HTTP-kappzeil:'] maachen: { :schlëssel <- Programm astellung: schlëssel.
}.

>> HTTP-Kappzeil := Objet nei.

HTTP-Kappzeil bei: ['nei'] maachen: { <- selwer nei initialiséieren.
}.

HTTP-Kappzeil bei: ['initialiséieren'] maachen: {
	eegen schlëssel := Näischt.
	eegen wäert := Näischt.
}.

HTTP-Kappzeil bei: ['schlëssel:wäert:'] maachen: { :schlëssel :wäert
	eegen schlëssel := schlëssel.
	eegen wäert := wäert.
}.

HTTP-Kappzeil bei: ['schlëssel'] maachen: { <- eegen schlëssel.
}.

HTTP-Kappzeil bei: ['wäert'] maachen: { <- eegen wäert.
}.


HTTP-Kappzeil bei: ['text'] maachen: {
	>> zeil := eegen schlëssel + [': '] + eegen wäert.
	zeil ersetzen: ['\r'] mat: [''], ersetzen: ['\n'] mat: ['']. <- zeil + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Dokument := Objet nei.

Web-Dokument bei: ['nei'] maachen: { <- selwer nei initialiséieren.
}.

Web-Dokument bei: ['initialiséieren'] maachen: {
	eegen kappzeilen := Lëscht nei.
	eegen sessiouns-id := Näischt.
	eegen sessiounsverwalter := Tempfichier-Sessioun nei.
	eegen sessiounsdonnéeën := Näischt.
	eegen sécher := Wouer.
	eegen selwecht-site := ['Strict'].
	eegen kappzeilen-geschéckt := Falsch.
	eegen http-ufro := HTTP-Ufro nei.
}.

Web-Dokument bei: ['http-ufro:'] maachen: { :http-ufro
	eegen http-ufro := http-ufro.
}. 

Web-Dokument bei: ['séchere-sessiounscookie:'] maachen: { :sécher
	selwer kappzeilen-iwwerpréiwen.
	eegen sécher := sécher.
}.

Web-Dokument bei: ['same-site-sessiounscookie:'] maachen: { :wäert
	selwer kappzeilen-iwwerpréiwen.
	>> optiounen := Lëscht nei 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	optiounen huet: wäert, falsch: {
		dës-aufgab feeler: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eegen selwecht-site := wäert.
}.

Web-Dokument bei: ['kappzeil:'] maachen: { :kappzeil
	selwer kappzeilen-iwwerpréiwen.
	eegen kappzeilen drunhänken: kappzeil.
}.

Web-Dokument bei: ['kappzeilen-läschen'] maachen: {
	selwer kappzeilen-iwwerpréiwen.
	eegen kappzeilen := Lëscht nei.
}.

Web-Dokument bei: ['sessiounsverwalter:'] maachen: { :verwalter
	selwer kappzeilen-iwwerpréiwen.
	eegen sessiounsverwalter := verwalter.
}.

Web-Dokument bei: ['sessiounsverwalter'] maachen: { <- eegen sessiounsverwalter.
}.

Web-Dokument bei: ['kappzeilen-iwwerpréiwen'] maachen: {
	eegen kappzeilen-geschéckt wouer: {
		dës-aufgab feeler: ['Headers already sent to client.'].
	}.
}.

Web-Dokument bei: ['sessioun-starten'] maachen: {
	selwer kappzeilen-iwwerpréiwen.
	>> http-ufro := eegen http-ufro.
	>> sessiouns-id := http-ufro cookie: ['xsid'].
	sessiouns-id Näischt? falsch: {
		(( Muster nei: ['^[A-Za-z0-9]+\\z'], treffer: sessiouns-id ) = 0) wouer: {
			sessiouns-id := Näischt.
		}.
	}.
	sessiouns-id Näischt? wouer: {
		sessiouns-id := Tresor token: 30.
		>> sessiouns-kappzeil := HTTP-Kappzeil nei
		schlëssel: ['Set-Cookie'] wäert: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eegen sécher entweder: ['Secure'] oder: ['']),
		SSITE: (eegen selwecht-site),
		XSID: sessiouns-id
		).
		eegen kappzeilen drunhänken: sessiouns-kappzeil.
	}.
	eegen sessiounsdonnéeën := eegen sessiounsverwalter fir: sessiouns-id, lueden. <- eegen sessiounsdonnéeën. # reference
}.

Web-Dokument bei: ['goen-op:'] maachen: { :adress
	selwer kappzeilen-iwwerpréiwen.
	selwer kappzeilen-läschen.
	eegen kappzeilen
	drunhänken: (
		HTTP-Kappzeil nei
		schlëssel: ['Status'] wäert: ['303 See Other']
	),
	drunhänken: (
		HTTP-Kappzeil nei
		schlëssel: ['Location'] wäert: adress
	).
	selwer ausginn: ['Redirect'].
}.

Web-Dokument bei: ['sessioun-ofbriechen'] maachen: {
	selwer kappzeilen-iwwerpréiwen.
	>> http-ufro := eegen http-ufro.
	>> sessiouns-id := http-ufro cookie: ['xsid'].
	sessiouns-id Näischt? falsch: {
		>> sessiouns-kappzeil := HTTP-Kappzeil nei.
		>> zäitpunkt := Moment nei joer: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessiouns-kappzeil schlëssel: ['Set-Cookie'] wäert: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: zäitpunkt,
			SEC: (eegen sécher entweder: ['Secure'] oder: ['']),
			SSITE: (eegen selwecht-site),
			XSID: sessiouns-id
		).
		eegen sessiounsverwalter zerstéieren.
		eegen kappzeilen drunhänken: sessiouns-kappzeil.
	}.
}.


Web-Dokument bei: ['virlag:'] maachen: { :wee <- Virlag nei: (Fichier nei: wee, liesen).
}.

Web-Dokument bei: ['ausginn:typ:'] maachen: { :resultat :typ
	eegen kappzeilen-geschéckt falsch: {
		eegen sessiounsdonnéeën Näischt? falsch: {
			eegen sessiounsverwalter späicheren: eegen sessiounsdonnéeën.
		}.
		eegen kappzeilen drunhänken: (
			HTTP-Kappzeil nei
			schlëssel: ['Content-type'] wäert: typ
		).
		eegen kappzeilen all: { :_ :kappzeil
			Ausgab schreiwen: kappzeil.
		}.
		eegen kappzeilen-geschéckt := Wouer.
		Ausgab schreiwen: ['\r\n'].
	}.
	Ausgab schreiwen: resultat.
}.

Web-Dokument bei: ['ofschléissen:typ:'] maachen: { :resultat :typ
	eegen kappzeilen-geschéckt falsch: {
		eegen sessiounsdonnéeën Näischt? falsch: {
			eegen sessiounsverwalter späicheren: eegen sessiounsdonnéeën.
		}.
		eegen kappzeilen drunhänken: (
			HTTP-Kappzeil nei
			schlëssel: ['Content-type'] wäert: typ
		).
		eegen kappzeilen drunhänken: (
			HTTP-Kappzeil nei
			schlëssel: ['Content-Length'] wäert: resultat text bytes
		).
		eegen kappzeilen all: { :_ :kappzeil
			Ausgab schreiwen: kappzeil.
		}.
		eegen kappzeilen-geschéckt := Wouer.
		Ausgab schreiwen: ['\r\n'].
	}.
	Ausgab schreiwen: resultat.
}.

Web-Dokument bei: ['ausginn:'] maachen: { :resultat
	selwer ausginn: resultat typ: ['text/html; charset=utf-8'].
}.

Web-Dokument bei: ['ofschléissen:'] maachen: { :resultat
	selwer ofschléissen: resultat typ: ['text/html; charset=utf-8'].
}.

Web-Dokument bei: ['json:'] maachen: { :resultat
	selwer ausginn: ( JSON jsonify: resultat ) typ: ['application/json'].
}.

Web-Dokument bei: ['net-fonnt:'] maachen: { :resultat
	selwer kappzeilen-läschen kappzeil: (
		HTTP-Kappzeil nei schlëssel: ['Status'] wäert: ['404 Not Found']
	).
	selwer ausginn: resultat.
}.


# Interface

>> Sessioun := Objet nei.

Sessioun bei: ['nei'] maachen: { <- selwer nei initialiséieren fir: Näischt.
}.

Sessioun bei: ['fir:'] maachen: { :id
	eegen id := id.
}.

Sessioun bei: ['lueden'] maachen: {
	dës-aufgab feeler: ['Not implemented.'].
}.

Sessioun bei: ['späicheren:'] maachen: {
	dës-aufgab feeler: ['Not implemented.'].
}.

Sessioun bei: ['zerstéieren'] maachen: {
	dës-aufgab feeler: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfichier-Sessioun := Sessioun nei.

Tempfichier-Sessioun bei: ['initialiséieren'] maachen: {
	eegen pfadpräfix := ['/tmp/sess-'].
}.

Tempfichier-Sessioun bei: ['pfad-präfix:'] maachen: { :zeechekette
	eegen pfadpräfix := zeechekette.
}.

Tempfichier-Sessioun bei: ['fichier'] maachen: { <- ( Fichier nei: ( eegen pfadpräfix + eegen id + ['.txt'] ) ).
}.

Tempfichier-Sessioun bei: ['lueden'] maachen: {
	>> fichier := selwer fichier.
	fichier existéiert falsch: {
		fichier schreiwen: (Dictionnaire nei code).
	}. <- fichier liesen objet.
}.

Tempfichier-Sessioun bei: ['späicheren:'] maachen: { :donnéeën
	>> fichier := selwer fichier.
	fichier existéiert wouer: {
		fichier schreiwen: donnéeën code.
	}.
}.

Tempfichier-Sessioun bei: ['zerstéieren'] maachen: {
	>> fichier := selwer fichier.
	fichier existéiert wouer: {
		fichier läschen.
	}.
}.


>> URL := Objet nei.

URL bei: ['initialiséieren'] maachen: {
	eegen protokoll := ['https://'].
	eegen host := ['localhost'].
	eegen wee := [''].
	eegen url-parameter := [''].
	eegen hash := [''].
}.

URL bei: ['nei'] maachen: { <- selwer nei initialiséieren.
}.

URL bei: ['text'] maachen: { <- (
	eegen protokoll +
	eegen host +
	eegen wee +
	eegen url-parameter +
	eegen hash ).
}.

URL bei: ['protokoll:'] maachen: { :protokoll
	((Lëscht nei ; ['http'] ; ['https']) huet: protokoll) wouer: {
		eegen protokoll := protokoll + ['://'].
	}, falsch: {
		dës-aufgab feeler: ['Invalid protocol'].
	}.
}.

URL bei: ['host:'] maachen: { :host
	#todo validate according to rfc
	eegen host := host.
}.

URL bei: ['wee:'] maachen: { :wee
	eegen wee := ['/'] + wee url-kodéieren.
}.

URL bei: ['url-parameter:'] maachen: { :zouuerdnung
	>> url-parameter := Lëscht nei.
	zouuerdnung all: { :schlëssel :wäert
		url-parameter drunhänken: schlëssel text url-kodéieren + ['='] + wäert text url-kodéieren.
	}.
	eegen url-parameter := ['?'] + ( url-parameter zesummesetzen: ['&'] ).
}.

URL bei: ['hash:'] maachen: { :hash
	eegen hash := ['#'] + hash url-kodéieren.
}.

