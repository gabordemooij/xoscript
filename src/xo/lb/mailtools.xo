>> E-Mail := Objet nei.

E-Mail bei: ['initialiséieren'] maachen: {
	eegen empfänger := Lëscht nei.
	eegen cc := Lëscht nei.
	eegen bcc := Lëscht nei.
	eegen ofsender := Näischt.
	eegen ofsendernumm := Näischt.
	eegen sujet := Näischt.
	eegen textkierper := Näischt.
}.

E-Mail bei: ['nei'] maachen: { <- selwer nei initialiséieren.
}.

E-Mail bei: ['un:'] maachen: { :oplëschtung
	eegen empfänger := oplëschtung.
}.
 
E-Mail bei: ['cc:'] maachen: { :oplëschtung
	eegen cc := oplëschtung.
}.

E-Mail bei: ['bcc:'] maachen: { :oplëschtung
	eegen bcc := oplëschtung.
}.

E-Mail bei: ['sujet:'] maachen: { :sujet
	eegen sujet := sujet.
}.

E-Mail bei: ['ofsender:numm:'] maachen: { :ofsender :numm
	eegen ofsender := ofsender.
	eegen ofsendernumm := numm.
}.

E-Mail bei: ['textkierper:'] maachen: { :textkierper
	eegen textkierper := textkierper.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-Mail bei: ['kappzeil:'] maachen: { :zeil <- zeil ersetzen: ['\r'] mat: [''], ersetzen: ['\n'] mat: [''].
}.

E-Mail bei: ['schécken'] maachen: {
	>> f := Fichier tempwrite: selwer erzeugen.
	Programm system: ['sendmail -t < '] + f wee, nei-zeil.
}.

E-Mail bei: ['erzeugen'] maachen: {
	>> ëmbroch := ['\r\n'].
	>> zeechekette := [''].
	zeechekette drunhänken: (selwer kappzeil: ['From: '] + eegen ofsendernumm + [' <'] + ( eegen ofsender ) + ['>']) + ëmbroch.
	zeechekette drunhänken: (selwer kappzeil: ['To: '] + ( eegen empfänger zesummesetzen: [','] )) + ëmbroch.
	eegen cc zielen wouer: {
		zeechekette drunhänken: (selwer kappzeil: ['Cc: '] + ( eegen cc zesummesetzen: [','] )) + ëmbroch.
	}.
	eegen bcc zielen wouer: {
		zeechekette drunhänken: (selwer kappzeil: ['Bcc: '] + ( eegen bcc zesummesetzen: [','] )) + ëmbroch.
	}.
	zeechekette drunhänken: (selwer kappzeil: ['Subject: '] + eegen sujet) + ëmbroch.
	zeechekette drunhänken: ëmbroch.
	zeechekette drunhänken: eegen textkierper.
	zeechekette drunhänken: ëmbroch. <- zeechekette.
}.

>> HTML-E-Mail := E-Mail nei.

HTML-E-Mail bei: ['initialiséieren'] maachen: {
	selwer initialiséieren.
	eegen unhäng := Lëscht nei.
	eegen grenz := Tresor token: 40.
}.

HTML-E-Mail bei: ['uhänken:'] maachen: { :fichier
	>> id := eegen unhäng zielen.
	>> blob := fichier blob.
	eegen unhäng drunhänken: (
		Dictionnaire nei
			fichier: fichier wee,
			mime: ['image/'] + (Server mimetype: fichier wee),
			donnéeën: blob base64-kodéieren
	).
	blob fräiginn. <- ['cid:attachment'] + id.
}.

HTML-E-Mail bei: ['erzeugen'] maachen: {
	>> ëmbroch := ['\r\n'].
	>> zeechekette := [''].
	zeechekette drunhänken: (selwer kappzeil: ['From: '] + eegen ofsendernumm + [' <'] + ( eegen ofsender ) + ['>']) + ëmbroch.
	zeechekette drunhänken: (selwer kappzeil: ['To: '] + ( eegen empfänger zesummesetzen: [','] )) + ëmbroch.
	eegen cc zielen wouer: {
		zeechekette drunhänken: (selwer kappzeil: ['Cc: '] + ( eegen cc zesummesetzen: [','] )) + ëmbroch.
	}.
	eegen bcc zielen wouer: {
		zeechekette drunhänken: (selwer kappzeil: ['Bcc: '] + ( eegen bcc zesummesetzen: [','] )) + ëmbroch.
	}.
	zeechekette drunhänken: (selwer kappzeil: ['Subject: '] + eegen sujet) + ëmbroch.
	zeechekette drunhänken: ['MIME-Version: 1.0'] + ëmbroch.
	zeechekette drunhänken: ['Content-Type: multipart/related; boundary="'] + eegen grenz + ['"; type=text/html'] + ëmbroch.
	zeechekette drunhänken: ëmbroch.
	zeechekette drunhänken: ['--'] + eegen grenz + ëmbroch.
	zeechekette drunhänken: ['Content-Type: text/html; charset=UTF-8'] + ëmbroch.
	zeechekette drunhänken: ['Content-Transfer-Encoding: 7bit'] + ëmbroch.
	zeechekette drunhänken: ëmbroch.
	zeechekette drunhänken: eegen textkierper.
	zeechekette drunhänken: ëmbroch.
	eegen unhäng all: { :id :info
		>> blob := info donnéeën.
		zeechekette drunhänken: ['--'] + eegen grenz + ëmbroch.
		zeechekette drunhänken: ['Content-Type: '] + info mime + ëmbroch.
		zeechekette drunhänken: ['Content-Transfer-Encoding: base64'] + ëmbroch.
		zeechekette drunhänken: ['Content-ID: <attachment'] + id + ['>'] + ëmbroch.
		zeechekette drunhänken: ['Content-Disposition: inline; filename="'] + info fichier + ['"'] + ëmbroch.
		zeechekette drunhänken: ëmbroch.
		>> héichstwäert := 76.
		>> textlängt := blob längt.
		>> stécker := (textlängt / héichstwäert) opronnen.
		{ :i
			>> stéck := blob kopéieren vun: i * héichstwäert längt: héichstwäert.
			zeechekette drunhänken: stéck + ëmbroch.
		} * stécker.
		zeechekette drunhänken: ëmbroch.
		zeechekette drunhänken: ëmbroch.
	}.
	zeechekette drunhänken: ['--'] + eegen grenz + ['--'] + ëmbroch. <- zeechekette.
}.
