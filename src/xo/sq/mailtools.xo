>> Email := Objekt ri.

Email kur: ['inicializo'] bëj: {
	vetjak marrësit := Listë ri.
	vetjak cc := Listë ri.
	vetjak bcc := Listë ri.
	vetjak dërgues := Asgjë.
	vetjak emër-dërguesi := Asgjë.
	vetjak subjekt := Asgjë.
	vetjak trup := Asgjë.
}.

Email kur: ['ri'] bëj: { <- vetja ri inicializo.
}.

Email kur: ['marrës:'] bëj: { :numërim
	vetjak marrësit := numërim.
}.
 
Email kur: ['cc:'] bëj: { :numërim
	vetjak cc := numërim.
}.

Email kur: ['bcc:'] bëj: { :numërim
	vetjak bcc := numërim.
}.

Email kur: ['subjekt:'] bëj: { :subjekt
	vetjak subjekt := subjekt.
}.

Email kur: ['dërgues:emër:'] bëj: { :dërgues :emër
	vetjak dërgues := dërgues.
	vetjak emër-dërguesi := emër.
}.

Email kur: ['trup:'] bëj: { :trup
	vetjak trup := trup.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email kur: ['kokë:'] bëj: { :rresht <- rresht zëvendëso: ['\r'] me: [''], zëvendëso: ['\n'] me: [''].
}.

Email kur: ['dërgo'] bëj: {
	>> f := Skedar tempwrite: vetja gjenero.
	Program sistem: ['sendmail -t < '] + f shteg, rresht-ri.
}.

Email kur: ['gjenero'] bëj: {
	>> ndërprerje-rreshti := ['\r\n'].
	>> varg := [''].
	varg shto-në-fund: (vetja kokë: ['From: '] + vetjak emër-dërguesi + [' <'] + ( vetjak dërgues ) + ['>']) + ndërprerje-rreshti.
	varg shto-në-fund: (vetja kokë: ['To: '] + ( vetjak marrësit bashko: [','] )) + ndërprerje-rreshti.
	vetjak cc numëro vërtetë: {
		varg shto-në-fund: (vetja kokë: ['Cc: '] + ( vetjak cc bashko: [','] )) + ndërprerje-rreshti.
	}.
	vetjak bcc numëro vërtetë: {
		varg shto-në-fund: (vetja kokë: ['Bcc: '] + ( vetjak bcc bashko: [','] )) + ndërprerje-rreshti.
	}.
	varg shto-në-fund: (vetja kokë: ['Subject: '] + vetjak subjekt) + ndërprerje-rreshti.
	varg shto-në-fund: ndërprerje-rreshti.
	varg shto-në-fund: vetjak trup.
	varg shto-në-fund: ndërprerje-rreshti. <- varg.
}.

>> HTML-Email := Email ri.

HTML-Email kur: ['inicializo'] bëj: {
	vetja inicializo.
	vetjak bashkëngjitje := Listë ri.
	vetjak kufi := Kasafortë token: 40.
}.

HTML-Email kur: ['bashkëngjit:'] bëj: { :skedar
	>> id := vetjak bashkëngjitje numëro.
	>> blob := skedar blob.
	vetjak bashkëngjitje shto-në-fund: (
		Fjalor ri
			skedar: skedar shteg,
			mime: ['image/'] + (Server mimetype: skedar shteg),
			të-dhëna: blob base64-kodo
	).
	blob liro. <- ['cid:attachment'] + id.
}.

HTML-Email kur: ['gjenero'] bëj: {
	>> ndërprerje-rreshti := ['\r\n'].
	>> varg := [''].
	varg shto-në-fund: (vetja kokë: ['From: '] + vetjak emër-dërguesi + [' <'] + ( vetjak dërgues ) + ['>']) + ndërprerje-rreshti.
	varg shto-në-fund: (vetja kokë: ['To: '] + ( vetjak marrësit bashko: [','] )) + ndërprerje-rreshti.
	vetjak cc numëro vërtetë: {
		varg shto-në-fund: (vetja kokë: ['Cc: '] + ( vetjak cc bashko: [','] )) + ndërprerje-rreshti.
	}.
	vetjak bcc numëro vërtetë: {
		varg shto-në-fund: (vetja kokë: ['Bcc: '] + ( vetjak bcc bashko: [','] )) + ndërprerje-rreshti.
	}.
	varg shto-në-fund: (vetja kokë: ['Subject: '] + vetjak subjekt) + ndërprerje-rreshti.
	varg shto-në-fund: ['MIME-Version: 1.0'] + ndërprerje-rreshti.
	varg shto-në-fund: ['Content-Type: multipart/related; boundary="'] + vetjak kufi + ['"; type=text/html'] + ndërprerje-rreshti.
	varg shto-në-fund: ndërprerje-rreshti.
	varg shto-në-fund: ['--'] + vetjak kufi + ndërprerje-rreshti.
	varg shto-në-fund: ['Content-Type: text/html; charset=UTF-8'] + ndërprerje-rreshti.
	varg shto-në-fund: ['Content-Transfer-Encoding: 7bit'] + ndërprerje-rreshti.
	varg shto-në-fund: ndërprerje-rreshti.
	varg shto-në-fund: vetjak trup.
	varg shto-në-fund: ndërprerje-rreshti.
	vetjak bashkëngjitje secili: { :id :info
		>> blob := info të-dhëna.
		varg shto-në-fund: ['--'] + vetjak kufi + ndërprerje-rreshti.
		varg shto-në-fund: ['Content-Type: '] + info mime + ndërprerje-rreshti.
		varg shto-në-fund: ['Content-Transfer-Encoding: base64'] + ndërprerje-rreshti.
		varg shto-në-fund: ['Content-ID: <attachment'] + id + ['>'] + ndërprerje-rreshti.
		varg shto-në-fund: ['Content-Disposition: inline; filename="'] + info skedar + ['"'] + ndërprerje-rreshti.
		varg shto-në-fund: ndërprerje-rreshti.
		>> maksimumi := 76.
		>> gjatësi-teksti := blob gjatësi.
		>> copa := (gjatësi-teksti / maksimumi) rrumbullakos-lart.
		{ :i
			>> copë := blob kopjo nga: i * maksimumi gjatësi: maksimumi.
			varg shto-në-fund: copë + ndërprerje-rreshti.
		} * copa.
		varg shto-në-fund: ndërprerje-rreshti.
		varg shto-në-fund: ndërprerje-rreshti.
	}.
	varg shto-në-fund: ['--'] + vetjak kufi + ['--'] + ndërprerje-rreshti. <- varg.
}.
