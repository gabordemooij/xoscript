HTTP-Kërkesë kur: ['HTTP-kokë:'] bëj: { :çelës <- Program cilësim: çelës.
}.

>> Kokë-HTTP := Objekt ri.

Kokë-HTTP kur: ['ri'] bëj: { <- vetja ri inicializo.
}.

Kokë-HTTP kur: ['inicializo'] bëj: {
	vetjak çelës := Asgjë.
	vetjak vlerë := Asgjë.
}.

Kokë-HTTP kur: ['çelës:vlerë:'] bëj: { :çelës :vlerë
	vetjak çelës := çelës.
	vetjak vlerë := vlerë.
}.

Kokë-HTTP kur: ['çelës'] bëj: { <- vetjak çelës.
}.

Kokë-HTTP kur: ['vlerë'] bëj: { <- vetjak vlerë.
}.


Kokë-HTTP kur: ['tekst'] bëj: {
	>> rresht := vetjak çelës + [': '] + vetjak vlerë.
	rresht zëvendëso: ['\r'] me: [''], zëvendëso: ['\n'] me: ['']. <- rresht + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokument-Web := Objekt ri.

Dokument-Web kur: ['ri'] bëj: { <- vetja ri inicializo.
}.

Dokument-Web kur: ['inicializo'] bëj: {
	vetjak kokat := Listë ri.
	vetjak id-seance := Asgjë.
	vetjak menaxher-seancash := Seancë-skedar-i-përkohshëm ri.
	vetjak të-dhëna-seance := Asgjë.
	vetjak e-sigurt := Vërtetë.
	vetjak e-njëjta-faqe := ['Strict'].
	vetjak kokat-dërguar := Rreme.
	vetjak kërkesë := HTTP-Kërkesë ri.
}.

Dokument-Web kur: ['kërkesë:'] bëj: { :kërkesë
	vetjak kërkesë := kërkesë.
}. 

Dokument-Web kur: ['cookie-seance-e-sigurt:'] bëj: { :e-sigurt
	vetja kontrollo-kokat.
	vetjak e-sigurt := e-sigurt.
}.

Dokument-Web kur: ['cookie-seance-e-njëjta-faqe:'] bëj: { :vlerë
	vetja kontrollo-kokat.
	>> opsione := Listë ri 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsione ka: vlerë, rreme: {
		kjo-detyrë gabim: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	vetjak e-njëjta-faqe := vlerë.
}.

Dokument-Web kur: ['kokë:'] bëj: { :kokë
	vetja kontrollo-kokat.
	vetjak kokat shto-në-fund: kokë.
}.

Dokument-Web kur: ['zbraz-kokat'] bëj: {
	vetja kontrollo-kokat.
	vetjak kokat := Listë ri.
}.

Dokument-Web kur: ['menaxher-seancash:'] bëj: { :menaxher
	vetja kontrollo-kokat.
	vetjak menaxher-seancash := menaxher.
}.

Dokument-Web kur: ['menaxher-seancash'] bëj: { <- vetjak menaxher-seancash.
}.

Dokument-Web kur: ['kontrollo-kokat'] bëj: {
	vetjak kokat-dërguar vërtetë: {
		kjo-detyrë gabim: ['Headers already sent to client.'].
	}.
}.

Dokument-Web kur: ['nis-seancën'] bëj: {
	vetja kontrollo-kokat.
	>> kërkesë := vetjak kërkesë.
	>> id-seance := kërkesë cookie: ['xsid'].
	id-seance Asgjë? rreme: {
		(( Model ri: ['^[A-Za-z0-9]+\\z'], përputhje: id-seance ) = 0) vërtetë: {
			id-seance := Asgjë.
		}.
	}.
	id-seance Asgjë? vërtetë: {
		id-seance := Kasafortë token: 30.
		>> kokë-seance := Kokë-HTTP ri
		çelës: ['Set-Cookie'] vlerë: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (vetjak e-sigurt ose: ['Secure'] ose: ['']),
		SSITE: (vetjak e-njëjta-faqe),
		XSID: id-seance
		).
		vetjak kokat shto-në-fund: kokë-seance.
	}.
	vetjak të-dhëna-seance := vetjak menaxher-seancash për: id-seance, ngarko. <- vetjak të-dhëna-seance. # reference
}.

Dokument-Web kur: ['shko-te:'] bëj: { :adresë
	vetja kontrollo-kokat.
	vetja zbraz-kokat.
	vetjak kokat
	shto-në-fund: (
		Kokë-HTTP ri
		çelës: ['Status'] vlerë: ['303 See Other']
	),
	shto-në-fund: (
		Kokë-HTTP ri
		çelës: ['Location'] vlerë: adresë
	).
	vetja nxirr: ['Redirect'].
}.

Dokument-Web kur: ['shkatërro-seancën'] bëj: {
	vetja kontrollo-kokat.
	>> kërkesë := vetjak kërkesë.
	>> id-seance := kërkesë cookie: ['xsid'].
	id-seance Asgjë? rreme: {
		>> kokë-seance := Kokë-HTTP ri.
		>> çast := Moment ri vit: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		kokë-seance çelës: ['Set-Cookie'] vlerë: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: çast,
			SEC: (vetjak e-sigurt ose: ['Secure'] ose: ['']),
			SSITE: (vetjak e-njëjta-faqe),
			XSID: id-seance
		).
		vetjak menaxher-seancash shkatërro.
		vetjak kokat shto-në-fund: kokë-seance.
	}.
}.


Dokument-Web kur: ['shabllon:'] bëj: { :shteg <- Shabllon ri: (Skedar ri: shteg, lexo).
}.

Dokument-Web kur: ['nxirr:lloj:'] bëj: { :dalje :lloj
	vetjak kokat-dërguar rreme: {
		vetjak të-dhëna-seance Asgjë? rreme: {
			vetjak menaxher-seancash ruaj: vetjak të-dhëna-seance.
		}.
		vetjak kokat shto-në-fund: (
			Kokë-HTTP ri
			çelës: ['Content-type'] vlerë: lloj
		).
		vetjak kokat secili: { :_ :kokë
			Dalje shkruaj: kokë.
		}.
		vetjak kokat-dërguar := Vërtetë.
		Dalje shkruaj: ['\r\n'].
	}.
	Dalje shkruaj: dalje.
}.

Dokument-Web kur: ['përfundo:lloj:'] bëj: { :dalje :lloj
	vetjak kokat-dërguar rreme: {
		vetjak të-dhëna-seance Asgjë? rreme: {
			vetjak menaxher-seancash ruaj: vetjak të-dhëna-seance.
		}.
		vetjak kokat shto-në-fund: (
			Kokë-HTTP ri
			çelës: ['Content-type'] vlerë: lloj
		).
		vetjak kokat shto-në-fund: (
			Kokë-HTTP ri
			çelës: ['Content-Length'] vlerë: dalje tekst bytes
		).
		vetjak kokat secili: { :_ :kokë
			Dalje shkruaj: kokë.
		}.
		vetjak kokat-dërguar := Vërtetë.
		Dalje shkruaj: ['\r\n'].
	}.
	Dalje shkruaj: dalje.
}.

Dokument-Web kur: ['nxirr:'] bëj: { :dalje
	vetja nxirr: dalje lloj: ['text/html; charset=utf-8'].
}.

Dokument-Web kur: ['përfundo:'] bëj: { :dalje
	vetja përfundo: dalje lloj: ['text/html; charset=utf-8'].
}.

Dokument-Web kur: ['json:'] bëj: { :dalje
	vetja nxirr: ( JSON jsonify: dalje ) lloj: ['application/json'].
}.

Dokument-Web kur: ['nuk-u-gjet:'] bëj: { :dalje
	vetja zbraz-kokat kokë: (
		Kokë-HTTP ri çelës: ['Status'] vlerë: ['404 Not Found']
	).
	vetja nxirr: dalje.
}.


# Interface

>> Seancë := Objekt ri.

Seancë kur: ['ri'] bëj: { <- vetja ri inicializo për: Asgjë.
}.

Seancë kur: ['për:'] bëj: { :id
	vetjak id := id.
}.

Seancë kur: ['ngarko'] bëj: {
	kjo-detyrë gabim: ['Not implemented.'].
}.

Seancë kur: ['ruaj:'] bëj: {
	kjo-detyrë gabim: ['Not implemented.'].
}.

Seancë kur: ['shkatërro'] bëj: {
	kjo-detyrë gabim: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Seancë-skedar-i-përkohshëm := Seancë ri.

Seancë-skedar-i-përkohshëm kur: ['inicializo'] bëj: {
	vetjak fillim-shtegu := ['/tmp/sess-'].
}.

Seancë-skedar-i-përkohshëm kur: ['parashtesë-shtegu:'] bëj: { :varg
	vetjak fillim-shtegu := varg.
}.

Seancë-skedar-i-përkohshëm kur: ['skedar'] bëj: { <- ( Skedar ri: ( vetjak fillim-shtegu + vetjak id + ['.txt'] ) ).
}.

Seancë-skedar-i-përkohshëm kur: ['ngarko'] bëj: {
	>> skedar := vetja skedar.
	skedar ekziston rreme: {
		skedar shkruaj: (Fjalor ri kod).
	}. <- skedar lexo objekt.
}.

Seancë-skedar-i-përkohshëm kur: ['ruaj:'] bëj: { :të-dhëna
	>> skedar := vetja skedar.
	skedar ekziston vërtetë: {
		skedar shkruaj: të-dhëna kod.
	}.
}.

Seancë-skedar-i-përkohshëm kur: ['shkatërro'] bëj: {
	>> skedar := vetja skedar.
	skedar ekziston vërtetë: {
		skedar fshi.
	}.
}.


>> URL := Objekt ri.

URL kur: ['inicializo'] bëj: {
	vetjak protokoll := ['https://'].
	vetjak pritës := ['localhost'].
	vetjak shteg := [''].
	vetjak parametra-url := [''].
	vetjak hash := [''].
}.

URL kur: ['ri'] bëj: { <- vetja ri inicializo.
}.

URL kur: ['tekst'] bëj: { <- (
	vetjak protokoll +
	vetjak pritës +
	vetjak shteg +
	vetjak parametra-url +
	vetjak hash ).
}.

URL kur: ['protokoll:'] bëj: { :protokoll
	((Listë ri ; ['http'] ; ['https']) ka: protokoll) vërtetë: {
		vetjak protokoll := protokoll + ['://'].
	}, rreme: {
		kjo-detyrë gabim: ['Invalid protocol'].
	}.
}.

URL kur: ['pritës:'] bëj: { :pritës
	#todo validate according to rfc
	vetjak pritës := pritës.
}.

URL kur: ['shteg:'] bëj: { :shteg
	vetjak shteg := ['/'] + shteg url-kodo.
}.

URL kur: ['parametra-url:'] bëj: { :hartëzim
	>> parametra-url := Listë ri.
	hartëzim secili: { :çelës :vlerë
		parametra-url shto-në-fund: çelës tekst url-kodo + ['='] + vlerë tekst url-kodo.
	}.
	vetjak parametra-url := ['?'] + ( parametra-url bashko: ['&'] ).
}.

URL kur: ['hash:'] bëj: { :hash
	vetjak hash := ['#'] + hash url-kodo.
}.

