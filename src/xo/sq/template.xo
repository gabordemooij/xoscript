
# ~ Simple template engine ~

>> Shabllon := Objekt ri.

Shabllon kur: ['ri'] bëj: { <- vetja ri përmbajtje: [''].
}.

Shabllon kur: ['përmbajtje:'] bëj: { :përmbajtje
	vetjak përmbajtje := përmbajtje. 
}.

Shabllon kur: ['ri:'] bëj: { :përmbajtje <- vetja ri përmbajtje: përmbajtje.
}.

Shabllon kur: ['këput:'] bëj: { :shënues
	>> shënues-fillimi := (['<!-- cut:%id% -->'] %id%: shënues).
	>> shënues-fundi := (['<!-- /cut:%id% -->'] %id%: shënues).
	>> pjesët := vetjak përmbajtje ndaj: shënues-fillimi.
	>> parashtesë := pjesët parë.
	>> pjesët2 := pjesët fundit ndaj: shënues-fundi.
	>> prapashtesë := pjesët2 fundit.
	>> pjesë := pjesët2 parë.
	>> mbetje := parashtesë + prapashtesë.
	vetjak përmbajtje := mbetje. <- Shabllon ri: pjesë.
	
}.

Shabllon kur: ['kopjo'] bëj: { <- vetja ri: vetja tekst kopjo.
}.
	
Shabllon kur: ['ngjit:në:'] bëj: { :fragment-html :id
	>> shënues-ngjitjeje := (['<!-- paste:%id% -->'] %id%: id).
	vetjak përmbajtje zëvendëso: shënues-ngjitjeje me: ( fragment-html tekst + shënues-ngjitjeje ).
}.

Shabllon kur: ['cakto:vlerë:'] bëj: { :vend :vlerë
	vetjak përmbajtje zëvendëso: ['<!-- slot:'] + vend + [' -->'] me: ( Server html-kodo: vlerë ).
}.

Shabllon kur: ['cakto:html:'] bëj: { :vend :html
	vetjak përmbajtje zëvendëso: ['<!-- slot:'] + vend + [' -->'] me: html.
}.

Shabllon kur: ['përgjigju:dhe:'] bëj: { :vend :vlerë
	vetja cakto: (vend nga: 0 gjatësi: (vend gjatësi - 1)) vlerë: vlerë.
}.

Shabllon kur: ['nl2br'] bëj: {
	vetjak përmbajtje zëvendëso: ['\n'] me: ['<br>'].
}.

Shabllon kur: ['rregullo'] bëj: {
	vetjak përmbajtje :=
		Model
		ri: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		përputhje: vetjak përmbajtje
		bëj: { <- ['']. }.
}.

Shabllon kur: ['rregullo-prerjet'] bëj: {
	>> elemente := Listë ri.
	Model
	ri: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	përputhje: vetjak përmbajtje
	bëj: { :_ :pjesë
		elemente shto-në-fund: pjesë ? 1.
	}.
	elemente secili: { :_ :id
		vetjak përmbajtje :=
			Model ri: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			përputhje: vetjak përmbajtje
			bëj: { <- ['']. }.
	 }.
}.

Shabllon kur: ['rregullo-hapësirat'] bëj: {
	vetjak përmbajtje :=
		Model
		ri: ['\\s*\\n'],
		përputhje: vetjak përmbajtje
		bëj: { <- ['\n']. }.
	vetjak përmbajtje :=
		Model
		ri: ['\\n[\\s\\t]+'],
		përputhje: vetjak përmbajtje
		bëj: { <- ['\n']. }.
}.

Shabllon kur: ['rregullo-gjithçka'] bëj: {
	vetja rregullo.
	vetja rregullo-prerjet.
	vetja rregullo-hapësirat.
}.

Shabllon kur: ['tekst'] bëj: { <- vetjak përmbajtje.
}.
