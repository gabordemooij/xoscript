
# ~ Simple template engine ~

>> Ndebiri := Ihe ohuru.

Ndebiri mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru ọdịnaya: [''].
}.

Ndebiri mgbe-ọbịara: ['ọdịnaya:'] mee: { :ọdịnaya
	nke-ya ọdịnaya := ọdịnaya. 
}.

Ndebiri mgbe-ọbịara: ['ohuru:'] mee: { :ọdịnaya <- onwe ohuru ọdịnaya: ọdịnaya.
}.

Ndebiri mgbe-ọbịara: ['bipụ:'] mee: { :akara
	>> akara-mmalite := (['<!-- cut:%id% -->'] %id%: akara).
	>> akara-njedebe := (['<!-- /cut:%id% -->'] %id%: akara).
	>> akụkụ-niile := nke-ya ọdịnaya kewaa: akara-mmalite.
	>> nganiihu := akụkụ-niile mbụ.
	>> akụkụ-niile2 := akụkụ-niile nke-ikpeazụ kewaa: akara-njedebe.
	>> nsonye := akụkụ-niile2 nke-ikpeazụ.
	>> akụkụ := akụkụ-niile2 mbụ.
	>> fọdụrụ := nganiihu + nsonye.
	nke-ya ọdịnaya := fọdụrụ. <- Ndebiri ohuru: akụkụ.
	
}.

Ndebiri mgbe-ọbịara: ['detuo'] mee: { <- onwe ohuru: onwe ederede detuo.
}.
	
Ndebiri mgbe-ọbịara: ['mado:na:'] mee: { :mpempe :id
	>> akara-mado := (['<!-- paste:%id% -->'] %id%: id).
	nke-ya ọdịnaya dochie: akara-mado na: ( mpempe ederede + akara-mado ).
}.

Ndebiri mgbe-ọbịara: ['dozie:uru:'] mee: { :ohere :uru
	nke-ya ọdịnaya dochie: ['<!-- slot:'] + ohere + [' -->'] na: ( Server html-tinye-koodu: uru ).
}.

Ndebiri mgbe-ọbịara: ['dozie:html:'] mee: { :ohere :html
	nke-ya ọdịnaya dochie: ['<!-- slot:'] + ohere + [' -->'] na: html.
}.

Ndebiri mgbe-ọbịara: ['zaghachi:na:'] mee: { :ohere :uru
	onwe dozie: (ohere site-na: 0 ogologo: (ohere ogologo - 1)) uru: uru.
}.

Ndebiri mgbe-ọbịara: ['nl2br'] mee: {
	nke-ya ọdịnaya dochie: ['\n'] na: ['<br>'].
}.

Ndebiri mgbe-ọbịara: ['dozie'] mee: {
	nke-ya ọdịnaya :=
		Ụkpụrụ-ọchụchọ
		ohuru: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		dakọtara: nke-ya ọdịnaya
		mee: { <- ['']. }.
}.

Ndebiri mgbe-ọbịara: ['dozie-mbipụ'] mee: {
	>> ihe-niile := Ndepụta ohuru.
	Ụkpụrụ-ọchụchọ
	ohuru: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	dakọtara: nke-ya ọdịnaya
	mee: { :_ :akụkụ
		ihe-niile tinye-na-njedebe: akụkụ ? 1.
	}.
	ihe-niile nke-ọ-bụla: { :_ :id
		nke-ya ọdịnaya :=
			Ụkpụrụ-ọchụchọ ohuru: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			dakọtara: nke-ya ọdịnaya
			mee: { <- ['']. }.
	 }.
}.

Ndebiri mgbe-ọbịara: ['dozie-oghere'] mee: {
	nke-ya ọdịnaya :=
		Ụkpụrụ-ọchụchọ
		ohuru: ['\\s*\\n'],
		dakọtara: nke-ya ọdịnaya
		mee: { <- ['\n']. }.
	nke-ya ọdịnaya :=
		Ụkpụrụ-ọchụchọ
		ohuru: ['\\n[\\s\\t]+'],
		dakọtara: nke-ya ọdịnaya
		mee: { <- ['\n']. }.
}.

Ndebiri mgbe-ọbịara: ['dozie-ihe-niile'] mee: {
	onwe dozie.
	onwe dozie-mbipụ.
	onwe dozie-oghere.
}.

Ndebiri mgbe-ọbịara: ['ederede'] mee: { <- nke-ya ọdịnaya.
}.
