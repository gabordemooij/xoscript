>> Ozi-eletrọnik := Ihe ohuru.

Ozi-eletrọnik mgbe-ọbịara: ['kwadebe'] mee: {
	nke-ya ndị-nnata := Ndepụta ohuru.
	nke-ya cc := Ndepụta ohuru.
	nke-ya bcc := Ndepụta ohuru.
	nke-ya onye-ziri := Efu.
	nke-ya aha-onye-ziri := Efu.
	nke-ya isiokwu := Efu.
	nke-ya ahụ := Efu.
}.

Ozi-eletrọnik mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru kwadebe.
}.

Ozi-eletrọnik mgbe-ọbịara: ['nye:'] mee: { :ndepụta
	nke-ya ndị-nnata := ndepụta.
}.
 
Ozi-eletrọnik mgbe-ọbịara: ['cc:'] mee: { :ndepụta
	nke-ya cc := ndepụta.
}.

Ozi-eletrọnik mgbe-ọbịara: ['bcc:'] mee: { :ndepụta
	nke-ya bcc := ndepụta.
}.

Ozi-eletrọnik mgbe-ọbịara: ['isiokwu:'] mee: { :isiokwu
	nke-ya isiokwu := isiokwu.
}.

Ozi-eletrọnik mgbe-ọbịara: ['onye-ziri:aha:'] mee: { :onye-ziri :aha
	nke-ya onye-ziri := onye-ziri.
	nke-ya aha-onye-ziri := aha.
}.

Ozi-eletrọnik mgbe-ọbịara: ['ahụ:'] mee: { :ahụ
	nke-ya ahụ := ahụ.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Ozi-eletrọnik mgbe-ọbịara: ['isi:'] mee: { :ahịrị <- ahịrị dochie: ['\r'] na: [''], dochie: ['\n'] na: [''].
}.

Ozi-eletrọnik mgbe-ọbịara: ['zipu'] mee: {
	>> f := Faịlụ tempwrite: onwe mepụta.
	Mmemme sistemụ: ['sendmail -t < '] + f ụzọ-faịlụ, ahịrị-ọhụrụ.
}.

Ozi-eletrọnik mgbe-ọbịara: ['mepụta'] mee: {
	>> nkwụsị-ahịrị := ['\r\n'].
	>> eriri-ederede := [''].
	eriri-ederede tinye-na-njedebe: (onwe isi: ['From: '] + nke-ya aha-onye-ziri + [' <'] + ( nke-ya onye-ziri ) + ['>']) + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: (onwe isi: ['To: '] + ( nke-ya ndị-nnata jikọọ: [','] )) + nkwụsị-ahịrị.
	nke-ya cc ọnụ-ọgụgụ eziokwu: {
		eriri-ederede tinye-na-njedebe: (onwe isi: ['Cc: '] + ( nke-ya cc jikọọ: [','] )) + nkwụsị-ahịrị.
	}.
	nke-ya bcc ọnụ-ọgụgụ eziokwu: {
		eriri-ederede tinye-na-njedebe: (onwe isi: ['Bcc: '] + ( nke-ya bcc jikọọ: [','] )) + nkwụsị-ahịrị.
	}.
	eriri-ederede tinye-na-njedebe: (onwe isi: ['Subject: '] + nke-ya isiokwu) + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: nke-ya ahụ.
	eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị. <- eriri-ederede.
}.

>> Ozi-eletrọnik-HTML := Ozi-eletrọnik ohuru.

Ozi-eletrọnik-HTML mgbe-ọbịara: ['kwadebe'] mee: {
	onwe kwadebe.
	nke-ya mgbakwunye := Ndepụta ohuru.
	nke-ya oke := Igbe-nchekwa token: 40.
}.

Ozi-eletrọnik-HTML mgbe-ọbịara: ['tinye-mgbakwunye:'] mee: { :faịlụ-nnọkọ
	>> id := nke-ya mgbakwunye ọnụ-ọgụgụ.
	>> blob := faịlụ-nnọkọ blob.
	nke-ya mgbakwunye tinye-na-njedebe: (
		Akwụkwọ-okwu ohuru
			faịlụ-nnọkọ: faịlụ-nnọkọ ụzọ-faịlụ,
			mime: ['image/'] + (Server mimetype: faịlụ-nnọkọ ụzọ-faịlụ),
			data: blob base64-tinye-koodu
	).
	blob hapụ. <- ['cid:attachment'] + id.
}.

Ozi-eletrọnik-HTML mgbe-ọbịara: ['mepụta'] mee: {
	>> nkwụsị-ahịrị := ['\r\n'].
	>> eriri-ederede := [''].
	eriri-ederede tinye-na-njedebe: (onwe isi: ['From: '] + nke-ya aha-onye-ziri + [' <'] + ( nke-ya onye-ziri ) + ['>']) + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: (onwe isi: ['To: '] + ( nke-ya ndị-nnata jikọọ: [','] )) + nkwụsị-ahịrị.
	nke-ya cc ọnụ-ọgụgụ eziokwu: {
		eriri-ederede tinye-na-njedebe: (onwe isi: ['Cc: '] + ( nke-ya cc jikọọ: [','] )) + nkwụsị-ahịrị.
	}.
	nke-ya bcc ọnụ-ọgụgụ eziokwu: {
		eriri-ederede tinye-na-njedebe: (onwe isi: ['Bcc: '] + ( nke-ya bcc jikọọ: [','] )) + nkwụsị-ahịrị.
	}.
	eriri-ederede tinye-na-njedebe: (onwe isi: ['Subject: '] + nke-ya isiokwu) + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: ['MIME-Version: 1.0'] + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: ['Content-Type: multipart/related; boundary="'] + nke-ya oke + ['"; type=text/html'] + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: ['--'] + nke-ya oke + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: ['Content-Type: text/html; charset=UTF-8'] + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: ['Content-Transfer-Encoding: 7bit'] + nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
	eriri-ederede tinye-na-njedebe: nke-ya ahụ.
	eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
	nke-ya mgbakwunye nke-ọ-bụla: { :id :ozi
		>> blob := ozi data.
		eriri-ederede tinye-na-njedebe: ['--'] + nke-ya oke + nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: ['Content-Type: '] + ozi mime + nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: ['Content-Transfer-Encoding: base64'] + nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: ['Content-ID: <attachment'] + id + ['>'] + nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: ['Content-Disposition: inline; filename="'] + ozi faịlụ-nnọkọ + ['"'] + nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
		>> kachasị := 76.
		>> ogologo-ederede := blob ogologo.
		>> ibe-niile := (ogologo-ederede / kachasị) gbago-elu.
		{ :i
			>> ibe := blob detuo site-na: i * kachasị ogologo: kachasị.
			eriri-ederede tinye-na-njedebe: ibe + nkwụsị-ahịrị.
		} * ibe-niile.
		eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
		eriri-ederede tinye-na-njedebe: nkwụsị-ahịrị.
	}.
	eriri-ederede tinye-na-njedebe: ['--'] + nke-ya oke + ['--'] + nkwụsị-ahịrị. <- eriri-ederede.
}.
