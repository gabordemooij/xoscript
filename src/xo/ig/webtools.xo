Arịrịọ-HTTP mgbe-ọbịara: ['HTTP-isi:'] mee: { :igodo <- Mmemme ntọala: igodo.
}.

>> Isi-HTTP := Ihe ohuru.

Isi-HTTP mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru kwadebe.
}.

Isi-HTTP mgbe-ọbịara: ['kwadebe'] mee: {
	nke-ya igodo := Efu.
	nke-ya uru := Efu.
}.

Isi-HTTP mgbe-ọbịara: ['igodo:uru:'] mee: { :igodo :uru
	nke-ya igodo := igodo.
	nke-ya uru := uru.
}.

Isi-HTTP mgbe-ọbịara: ['igodo'] mee: { <- nke-ya igodo.
}.

Isi-HTTP mgbe-ọbịara: ['uru'] mee: { <- nke-ya uru.
}.


Isi-HTTP mgbe-ọbịara: ['ederede'] mee: {
	>> ahịrị := nke-ya igodo + [': '] + nke-ya uru.
	ahịrị dochie: ['\r'] na: [''], dochie: ['\n'] na: ['']. <- ahịrị + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Akwụkwọ-Weebụ := Ihe ohuru.

Akwụkwọ-Weebụ mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru kwadebe.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['kwadebe'] mee: {
	nke-ya isi-niile := Ndepụta ohuru.
	nke-ya id-nnọkọ := Efu.
	nke-ya onye-njikwa-nnọkọ := Nnọkọ-faịlụ-nwa-oge ohuru.
	nke-ya data-nnọkọ := Efu.
	nke-ya nchekwa := Eziokwu.
	nke-ya otu-saịtị := ['Strict'].
	nke-ya ezigala-isi := Ụgha.
	nke-ya arịrịọ-http := Arịrịọ-HTTP ohuru.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['arịrịọ-http:'] mee: { :arịrịọ-http
	nke-ya arịrịọ-http := arịrịọ-http.
}. 

Akwụkwọ-Weebụ mgbe-ọbịara: ['kuki-nnọkọ-nchekwa:'] mee: { :nchekwa
	onwe lelee-isi.
	nke-ya nchekwa := nchekwa.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['kuki-nnọkọ-otu-saịtị:'] mee: { :uru
	onwe lelee-isi.
	>> nhọrọ := Ndepụta ohuru 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	nhọrọ gụnyere: uru, ụgha: {
		ọrụ-a njehie: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	nke-ya otu-saịtị := uru.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['isi:'] mee: { :isi
	onwe lelee-isi.
	nke-ya isi-niile tinye-na-njedebe: isi.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['wepụ-isi'] mee: {
	onwe lelee-isi.
	nke-ya isi-niile := Ndepụta ohuru.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['onye-njikwa-nnọkọ:'] mee: { :onye-njikwa
	onwe lelee-isi.
	nke-ya onye-njikwa-nnọkọ := onye-njikwa.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['onye-njikwa-nnọkọ'] mee: { <- nke-ya onye-njikwa-nnọkọ.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['lelee-isi'] mee: {
	nke-ya ezigala-isi eziokwu: {
		ọrụ-a njehie: ['Headers already sent to client.'].
	}.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['malite-nnọkọ'] mee: {
	onwe lelee-isi.
	>> arịrịọ-http := nke-ya arịrịọ-http.
	>> id-nnọkọ := arịrịọ-http cookie: ['xsid'].
	id-nnọkọ Efu? ụgha: {
		(( Ụkpụrụ-ọchụchọ ohuru: ['^[A-Za-z0-9]+\\z'], dakọtara: id-nnọkọ ) = 0) eziokwu: {
			id-nnọkọ := Efu.
		}.
	}.
	id-nnọkọ Efu? eziokwu: {
		id-nnọkọ := Igbe-nchekwa token: 30.
		>> isi-nnọkọ := Isi-HTTP ohuru
		igodo: ['Set-Cookie'] uru: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (nke-ya nchekwa nke-a: ['Secure'] ma-ọ-bụ-nke-ahụ: ['']),
		SSITE: (nke-ya otu-saịtị),
		XSID: id-nnọkọ
		).
		nke-ya isi-niile tinye-na-njedebe: isi-nnọkọ.
	}.
	nke-ya data-nnọkọ := nke-ya onye-njikwa-nnọkọ maka: id-nnọkọ, bulite. <- nke-ya data-nnọkọ. # reference
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['gaa-na:'] mee: { :adreesị
	onwe lelee-isi.
	onwe wepụ-isi.
	nke-ya isi-niile
	tinye-na-njedebe: (
		Isi-HTTP ohuru
		igodo: ['Status'] uru: ['303 See Other']
	),
	tinye-na-njedebe: (
		Isi-HTTP ohuru
		igodo: ['Location'] uru: adreesị
	).
	onwe wepụta: ['Redirect'].
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['bibie-nnọkọ'] mee: {
	onwe lelee-isi.
	>> arịrịọ-http := nke-ya arịrịọ-http.
	>> id-nnọkọ := arịrịọ-http cookie: ['xsid'].
	id-nnọkọ Efu? ụgha: {
		>> isi-nnọkọ := Isi-HTTP ohuru.
		>> oge-njedebe := Oge ohuru afọ: 1970, usoro-ọdịdị: ['%a, %d %b %Y %H:%M:%S GMT'].
		isi-nnọkọ igodo: ['Set-Cookie'] uru: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: oge-njedebe,
			SEC: (nke-ya nchekwa nke-a: ['Secure'] ma-ọ-bụ-nke-ahụ: ['']),
			SSITE: (nke-ya otu-saịtị),
			XSID: id-nnọkọ
		).
		nke-ya onye-njikwa-nnọkọ bibie.
		nke-ya isi-niile tinye-na-njedebe: isi-nnọkọ.
	}.
}.


Akwụkwọ-Weebụ mgbe-ọbịara: ['ndebiri:'] mee: { :ụzọ-faịlụ <- Ndebiri ohuru: (Faịlụ ohuru: ụzọ-faịlụ, gụọ).
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['wepụta:ụdị:'] mee: { :nsonaazụ :ụdị
	nke-ya ezigala-isi ụgha: {
		nke-ya data-nnọkọ Efu? ụgha: {
			nke-ya onye-njikwa-nnọkọ chekwaa: nke-ya data-nnọkọ.
		}.
		nke-ya isi-niile tinye-na-njedebe: (
			Isi-HTTP ohuru
			igodo: ['Content-type'] uru: ụdị
		).
		nke-ya isi-niile nke-ọ-bụla: { :_ :isi
			Mpụta dee: isi.
		}.
		nke-ya ezigala-isi := Eziokwu.
		Mpụta dee: ['\r\n'].
	}.
	Mpụta dee: nsonaazụ.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['mechaa:ụdị:'] mee: { :nsonaazụ :ụdị
	nke-ya ezigala-isi ụgha: {
		nke-ya data-nnọkọ Efu? ụgha: {
			nke-ya onye-njikwa-nnọkọ chekwaa: nke-ya data-nnọkọ.
		}.
		nke-ya isi-niile tinye-na-njedebe: (
			Isi-HTTP ohuru
			igodo: ['Content-type'] uru: ụdị
		).
		nke-ya isi-niile tinye-na-njedebe: (
			Isi-HTTP ohuru
			igodo: ['Content-Length'] uru: nsonaazụ ederede bytes
		).
		nke-ya isi-niile nke-ọ-bụla: { :_ :isi
			Mpụta dee: isi.
		}.
		nke-ya ezigala-isi := Eziokwu.
		Mpụta dee: ['\r\n'].
	}.
	Mpụta dee: nsonaazụ.
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['wepụta:'] mee: { :nsonaazụ
	onwe wepụta: nsonaazụ ụdị: ['text/html; charset=utf-8'].
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['mechaa:'] mee: { :nsonaazụ
	onwe mechaa: nsonaazụ ụdị: ['text/html; charset=utf-8'].
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['json:'] mee: { :nsonaazụ
	onwe wepụta: ( JSON jsonify: nsonaazụ ) ụdị: ['application/json'].
}.

Akwụkwọ-Weebụ mgbe-ọbịara: ['ahụghị:'] mee: { :nsonaazụ
	onwe wepụ-isi isi: (
		Isi-HTTP ohuru igodo: ['Status'] uru: ['404 Not Found']
	).
	onwe wepụta: nsonaazụ.
}.


# Interface

>> Nnọkọ := Ihe ohuru.

Nnọkọ mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru kwadebe maka: Efu.
}.

Nnọkọ mgbe-ọbịara: ['maka:'] mee: { :id
	nke-ya id := id.
}.

Nnọkọ mgbe-ọbịara: ['bulite'] mee: {
	ọrụ-a njehie: ['Not implemented.'].
}.

Nnọkọ mgbe-ọbịara: ['chekwaa:'] mee: {
	ọrụ-a njehie: ['Not implemented.'].
}.

Nnọkọ mgbe-ọbịara: ['bibie'] mee: {
	ọrụ-a njehie: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Nnọkọ-faịlụ-nwa-oge := Nnọkọ ohuru.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['kwadebe'] mee: {
	nke-ya mmalite-ụzọ := ['/tmp/sess-'].
}.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['nganiihu-ụzọ:'] mee: { :eriri-ederede
	nke-ya mmalite-ụzọ := eriri-ederede.
}.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['faịlụ-nnọkọ'] mee: { <- ( Faịlụ ohuru: ( nke-ya mmalite-ụzọ + nke-ya id + ['.txt'] ) ).
}.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['bulite'] mee: {
	>> faịlụ-nnọkọ := onwe faịlụ-nnọkọ.
	faịlụ-nnọkọ dị ụgha: {
		faịlụ-nnọkọ dee: (Akwụkwọ-okwu ohuru koodu).
	}. <- faịlụ-nnọkọ gụọ ihe.
}.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['chekwaa:'] mee: { :data
	>> faịlụ-nnọkọ := onwe faịlụ-nnọkọ.
	faịlụ-nnọkọ dị eziokwu: {
		faịlụ-nnọkọ dee: data koodu.
	}.
}.

Nnọkọ-faịlụ-nwa-oge mgbe-ọbịara: ['bibie'] mee: {
	>> faịlụ-nnọkọ := onwe faịlụ-nnọkọ.
	faịlụ-nnọkọ dị eziokwu: {
		faịlụ-nnọkọ hichapụ.
	}.
}.


>> URL := Ihe ohuru.

URL mgbe-ọbịara: ['kwadebe'] mee: {
	nke-ya usoro-nzikọrịta := ['https://'].
	nke-ya onye-nnabata := ['localhost'].
	nke-ya ụzọ-faịlụ := [''].
	nke-ya paramita-url := [''].
	nke-ya hash := [''].
}.

URL mgbe-ọbịara: ['ohuru'] mee: { <- onwe ohuru kwadebe.
}.

URL mgbe-ọbịara: ['ederede'] mee: { <- (
	nke-ya usoro-nzikọrịta +
	nke-ya onye-nnabata +
	nke-ya ụzọ-faịlụ +
	nke-ya paramita-url +
	nke-ya hash ).
}.

URL mgbe-ọbịara: ['usoro-nzikọrịta:'] mee: { :usoro-nzikọrịta
	((Ndepụta ohuru ; ['http'] ; ['https']) gụnyere: usoro-nzikọrịta) eziokwu: {
		nke-ya usoro-nzikọrịta := usoro-nzikọrịta + ['://'].
	}, ụgha: {
		ọrụ-a njehie: ['Invalid protocol'].
	}.
}.

URL mgbe-ọbịara: ['onye-nnabata:'] mee: { :onye-nnabata
	#todo validate according to rfc
	nke-ya onye-nnabata := onye-nnabata.
}.

URL mgbe-ọbịara: ['ụzọ-faịlụ:'] mee: { :ụzọ-faịlụ
	nke-ya ụzọ-faịlụ := ['/'] + ụzọ-faịlụ url-tinye-koodu.
}.

URL mgbe-ọbịara: ['paramita-url:'] mee: { :nhazi
	>> paramita-url := Ndepụta ohuru.
	nhazi nke-ọ-bụla: { :igodo :uru
		paramita-url tinye-na-njedebe: igodo ederede url-tinye-koodu + ['='] + uru ederede url-tinye-koodu.
	}.
	nke-ya paramita-url := ['?'] + ( paramita-url jikọọ: ['&'] ).
}.

URL mgbe-ọbịara: ['hash:'] mee: { :hash
	nke-ya hash := ['#'] + hash url-tinye-koodu.
}.

