>> Email := Objeto novo.

Email em: ['init'] fazer: {
	prop recipients := Listar novo.
	prop cc := Listar novo.
	prop bcc := Listar novo.
	prop from := Nulo.
	prop from-name := Nulo.
	prop subject := Nulo.
	prop body := Nulo.
}.

Email em: ['novo'] fazer: { <- isto novo init.
}.

Email em: ['to:'] fazer: { :list
	prop recipients := list.
}.
 
Email em: ['cc:'] fazer: { :list
	prop cc := list.
}.

Email em: ['bcc:'] fazer: { :list
	prop bcc := list.
}.

Email em: ['subject:'] fazer: { :subject
	prop subject := subject.
}.

Email em: ['from:name:'] fazer: { :from :nome
	prop from := from.
	prop from-name := nome.
}.

Email em: ['body:'] fazer: { :body
	prop body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email em: ['header:'] fazer: { :line <- line substituir: ['\r'] com: [''], substituir: ['\n'] com: [''].
}.

Email em: ['send'] fazer: {
	>> f := Arquivo tempwrite: isto generate.
	Programa comando-do-sistema: ['sendmail -t < '] + f caminho, stop.
}.

Email em: ['generate'] fazer: {
	>> brk := ['\r\n'].
	>> str := [''].
	str acrescentar: (isto header: ['From: '] + prop from-name + [' <'] + ( prop from ) + ['>']) + brk.
	str acrescentar: (isto header: ['To: '] + ( prop recipients juntar: [','] )) + brk.
	prop cc conta sim: {
		str acrescentar: (isto header: ['Cc: '] + ( prop cc juntar: [','] )) + brk.
	}.
	prop bcc conta sim: {
		str acrescentar: (isto header: ['Bcc: '] + ( prop bcc juntar: [','] )) + brk.
	}.
	str acrescentar: (isto header: ['Subject: '] + prop subject) + brk.
	str acrescentar: brk.
	str acrescentar: prop body.
	str acrescentar: brk. <- str.
}.

>> HTML-Email := Email novo.

HTML-Email em: ['init'] fazer: {
	isto init.
	prop attachments := Listar novo.
	prop boundary := Cofre token: 40.
}.

HTML-Email em: ['attach:'] fazer: { :file
	>> id := prop attachments conta.
	>> blob := file blob.
	prop attachments acrescentar: (
		Mapa novo
			file: file caminho,
			mime: ['image/'] + (Server mimetype: file caminho),
			data: blob base64-codificar
	).
	blob livre. <- ['cid:attachment'] + id.
}.

HTML-Email em: ['generate'] fazer: {
	>> brk := ['\r\n'].
	>> str := [''].
	str acrescentar: (isto header: ['From: '] + prop from-name + [' <'] + ( prop from ) + ['>']) + brk.
	str acrescentar: (isto header: ['To: '] + ( prop recipients juntar: [','] )) + brk.
	prop cc conta sim: {
		str acrescentar: (isto header: ['Cc: '] + ( prop cc juntar: [','] )) + brk.
	}.
	prop bcc conta sim: {
		str acrescentar: (isto header: ['Bcc: '] + ( prop bcc juntar: [','] )) + brk.
	}.
	str acrescentar: (isto header: ['Subject: '] + prop subject) + brk.
	str acrescentar: ['MIME-Version: 1.0'] + brk.
	str acrescentar: ['Content-Type: multipart/related; boundary="'] + prop boundary + ['"; type=text/html'] + brk.
	str acrescentar: brk.
	str acrescentar: ['--'] + prop boundary + brk.
	str acrescentar: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str acrescentar: ['Content-Transfer-Encoding: 7bit'] + brk.
	str acrescentar: brk.
	str acrescentar: prop body.
	str acrescentar: brk.
	prop attachments cada-um: { :id :info
		>> blob := info data.
		str acrescentar: ['--'] + prop boundary + brk.
		str acrescentar: ['Content-Type: '] + info mime + brk.
		str acrescentar: ['Content-Transfer-Encoding: base64'] + brk.
		str acrescentar: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str acrescentar: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str acrescentar: brk.
		>> max := 76.
		>> len := blob comprimento.
		>> chunks := (len / max) cima.
		{ :i
			>> chunk := blob copiar de: i * max comprimento: max.
			str acrescentar: chunk + brk.
		} * chunks.
		str acrescentar: brk.
		str acrescentar: brk.
	}.
	str acrescentar: ['--'] + prop boundary + ['--'] + brk. <- str.
}.
