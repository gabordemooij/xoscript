>> Email := Objeto novo.

Email em: ['inicializar'] fazer: {
	prop destinatários := Listar novo.
	prop cc := Listar novo.
	prop bcc := Listar novo.
	prop remetente := Nulo.
	prop nome-remetente := Nulo.
	prop assunto := Nulo.
	prop corpo := Nulo.
}.

Email em: ['novo'] fazer: { <- isto novo inicializar.
}.

Email em: ['destinatário:'] fazer: { :lista
	prop destinatários := lista.
}.
 
Email em: ['cc:'] fazer: { :lista
	prop cc := lista.
}.

Email em: ['bcc:'] fazer: { :lista
	prop bcc := lista.
}.

Email em: ['assunto:'] fazer: { :assunto
	prop assunto := assunto.
}.

Email em: ['remetente:nome:'] fazer: { :remetente :nome
	prop remetente := remetente.
	prop nome-remetente := nome.
}.

Email em: ['corpo:'] fazer: { :corpo
	prop corpo := corpo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email em: ['cabeçalho:'] fazer: { :linha <- linha substituir: ['\r'] com: [''], substituir: ['\n'] com: [''].
}.

Email em: ['enviar'] fazer: {
	>> f := Arquivo tempwrite: isto gerar.
	Programa comando-do-sistema: ['sendmail -t < '] + f caminho, stop.
}.

Email em: ['gerar'] fazer: {
	>> quebra := ['\r\n'].
	>> cadeia := [''].
	cadeia acrescentar: (isto cabeçalho: ['From: '] + prop nome-remetente + [' <'] + ( prop remetente ) + ['>']) + quebra.
	cadeia acrescentar: (isto cabeçalho: ['To: '] + ( prop destinatários juntar: [','] )) + quebra.
	prop cc conta sim: {
		cadeia acrescentar: (isto cabeçalho: ['Cc: '] + ( prop cc juntar: [','] )) + quebra.
	}.
	prop bcc conta sim: {
		cadeia acrescentar: (isto cabeçalho: ['Bcc: '] + ( prop bcc juntar: [','] )) + quebra.
	}.
	cadeia acrescentar: (isto cabeçalho: ['Subject: '] + prop assunto) + quebra.
	cadeia acrescentar: quebra.
	cadeia acrescentar: prop corpo.
	cadeia acrescentar: quebra. <- cadeia.
}.

>> Email-HTML := Email novo.

Email-HTML em: ['inicializar'] fazer: {
	isto inicializar.
	prop anexos := Listar novo.
	prop fronteira := Cofre token: 40.
}.

Email-HTML em: ['anexar:'] fazer: { :ficheiro
	>> id := prop anexos conta.
	>> blob := ficheiro blob.
	prop anexos acrescentar: (
		Mapa novo
			ficheiro: ficheiro caminho,
			mime: ['image/'] + (Server mimetype: ficheiro caminho),
			dados: blob base64-codificar
	).
	blob livre. <- ['cid:attachment'] + id.
}.

Email-HTML em: ['gerar'] fazer: {
	>> quebra := ['\r\n'].
	>> cadeia := [''].
	cadeia acrescentar: (isto cabeçalho: ['From: '] + prop nome-remetente + [' <'] + ( prop remetente ) + ['>']) + quebra.
	cadeia acrescentar: (isto cabeçalho: ['To: '] + ( prop destinatários juntar: [','] )) + quebra.
	prop cc conta sim: {
		cadeia acrescentar: (isto cabeçalho: ['Cc: '] + ( prop cc juntar: [','] )) + quebra.
	}.
	prop bcc conta sim: {
		cadeia acrescentar: (isto cabeçalho: ['Bcc: '] + ( prop bcc juntar: [','] )) + quebra.
	}.
	cadeia acrescentar: (isto cabeçalho: ['Subject: '] + prop assunto) + quebra.
	cadeia acrescentar: ['MIME-Version: 1.0'] + quebra.
	cadeia acrescentar: ['Content-Type: multipart/related; boundary="'] + prop fronteira + ['"; type=text/html'] + quebra.
	cadeia acrescentar: quebra.
	cadeia acrescentar: ['--'] + prop fronteira + quebra.
	cadeia acrescentar: ['Content-Type: text/html; charset=UTF-8'] + quebra.
	cadeia acrescentar: ['Content-Transfer-Encoding: 7bit'] + quebra.
	cadeia acrescentar: quebra.
	cadeia acrescentar: prop corpo.
	cadeia acrescentar: quebra.
	prop anexos cada-um: { :id :info
		>> blob := info dados.
		cadeia acrescentar: ['--'] + prop fronteira + quebra.
		cadeia acrescentar: ['Content-Type: '] + info mime + quebra.
		cadeia acrescentar: ['Content-Transfer-Encoding: base64'] + quebra.
		cadeia acrescentar: ['Content-ID: <attachment'] + id + ['>'] + quebra.
		cadeia acrescentar: ['Content-Disposition: inline; filename="'] + info ficheiro + ['"'] + quebra.
		cadeia acrescentar: quebra.
		>> máximo := 76.
		>> comprimento-texto := blob comprimento.
		>> pedaços := (comprimento-texto / máximo) cima.
		{ :i
			>> pedaço := blob copiar de: i * máximo comprimento: máximo.
			cadeia acrescentar: pedaço + quebra.
		} * pedaços.
		cadeia acrescentar: quebra.
		cadeia acrescentar: quebra.
	}.
	cadeia acrescentar: ['--'] + prop fronteira + ['--'] + quebra. <- cadeia.
}.
