HTTP-Forespørgsel ved: ['HTTP-header:'] gør: { :nøgle <- Program indstilling: nøgle.
}.

>> HTTP-Header := Objekt ny.

HTTP-Header ved: ['ny'] gør: { <- selv ny initialiser.
}.

HTTP-Header ved: ['initialiser'] gør: {
	egen nøgle := Intet.
	egen værdi := Intet.
}.

HTTP-Header ved: ['nøgle:værdi:'] gør: { :nøgle :værdi
	egen nøgle := nøgle.
	egen værdi := værdi.
}.

HTTP-Header ved: ['nøgle'] gør: { <- egen nøgle.
}.

HTTP-Header ved: ['værdi'] gør: { <- egen værdi.
}.


HTTP-Header ved: ['tekst'] gør: {
	>> linje := egen nøgle + [': '] + egen værdi.
	linje erstat: ['\r'] med: [''], erstat: ['\n'] med: ['']. <- linje + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdokument := Objekt ny.

Webdokument ved: ['ny'] gør: { <- selv ny initialiser.
}.

Webdokument ved: ['initialiser'] gør: {
	egen headere := Liste ny.
	egen sessions-id := Intet.
	egen sessionshåndtering := Midlertidig-fil-session ny.
	egen sessionsdata := Intet.
	egen sikker := Sand.
	egen samme-site := ['Strict'].
	egen headere-sendt := Falsk.
	egen http-forespørgsel := HTTP-Forespørgsel ny.
}.

Webdokument ved: ['http-forespørgsel:'] gør: { :http-forespørgsel
	egen http-forespørgsel := http-forespørgsel.
}. 

Webdokument ved: ['sikker-sessionscookie:'] gør: { :sikker
	selv kontroller-headere.
	egen sikker := sikker.
}.

Webdokument ved: ['samme-site-sessionscookie:'] gør: { :værdi
	selv kontroller-headere.
	>> indstillinger := Liste ny 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	indstillinger har: værdi, falsk: {
		denne-opgave fejl: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	egen samme-site := værdi.
}.

Webdokument ved: ['header:'] gør: { :header
	selv kontroller-headere.
	egen headere tilføj: header.
}.

Webdokument ved: ['ryd-headere'] gør: {
	selv kontroller-headere.
	egen headere := Liste ny.
}.

Webdokument ved: ['sessionshåndtering:'] gør: { :håndtering
	selv kontroller-headere.
	egen sessionshåndtering := håndtering.
}.

Webdokument ved: ['sessionshåndtering'] gør: { <- egen sessionshåndtering.
}.

Webdokument ved: ['kontroller-headere'] gør: {
	egen headere-sendt sand: {
		denne-opgave fejl: ['Headers already sent to client.'].
	}.
}.

Webdokument ved: ['start-session'] gør: {
	selv kontroller-headere.
	>> http-forespørgsel := egen http-forespørgsel.
	>> sessions-id := http-forespørgsel cookie: ['xsid'].
	sessions-id Intet? falsk: {
		(( Mønster ny: ['^[A-Za-z0-9]+\\z'], match: sessions-id ) = 0) sand: {
			sessions-id := Intet.
		}.
	}.
	sessions-id Intet? sand: {
		sessions-id := Boks token: 30.
		>> sessionsheader := HTTP-Header ny
		nøgle: ['Set-Cookie'] værdi: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (egen sikker enten: ['Secure'] eller: ['']),
		SSITE: (egen samme-site),
		XSID: sessions-id
		).
		egen headere tilføj: sessionsheader.
	}.
	egen sessionsdata := egen sessionshåndtering for: sessions-id, indlæs. <- egen sessionsdata. # reference
}.

Webdokument ved: ['gå-til:'] gør: { :adresse
	selv kontroller-headere.
	selv ryd-headere.
	egen headere
	tilføj: (
		HTTP-Header ny
		nøgle: ['Status'] værdi: ['303 See Other']
	),
	tilføj: (
		HTTP-Header ny
		nøgle: ['Location'] værdi: adresse
	).
	selv udskriv: ['Redirect'].
}.

Webdokument ved: ['ødelæg-session'] gør: {
	selv kontroller-headere.
	>> http-forespørgsel := egen http-forespørgsel.
	>> sessions-id := http-forespørgsel cookie: ['xsid'].
	sessions-id Intet? falsk: {
		>> sessionsheader := HTTP-Header ny.
		>> tidspunkt := Øjeblik ny år: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessionsheader nøgle: ['Set-Cookie'] værdi: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tidspunkt,
			SEC: (egen sikker enten: ['Secure'] eller: ['']),
			SSITE: (egen samme-site),
			XSID: sessions-id
		).
		egen sessionshåndtering ødelæg.
		egen headere tilføj: sessionsheader.
	}.
}.


Webdokument ved: ['skabelon:'] gør: { :sti <- Skabelon ny: (Fil ny: sti, læs).
}.

Webdokument ved: ['udskriv:type:'] gør: { :uddata :type
	egen headere-sendt falsk: {
		egen sessionsdata Intet? falsk: {
			egen sessionshåndtering gem: egen sessionsdata.
		}.
		egen headere tilføj: (
			HTTP-Header ny
			nøgle: ['Content-type'] værdi: type
		).
		egen headere hver: { :_ :header
			Uddata skriv: header.
		}.
		egen headere-sendt := Sand.
		Uddata skriv: ['\r\n'].
	}.
	Uddata skriv: uddata.
}.

Webdokument ved: ['afslut:type:'] gør: { :uddata :type
	egen headere-sendt falsk: {
		egen sessionsdata Intet? falsk: {
			egen sessionshåndtering gem: egen sessionsdata.
		}.
		egen headere tilføj: (
			HTTP-Header ny
			nøgle: ['Content-type'] værdi: type
		).
		egen headere tilføj: (
			HTTP-Header ny
			nøgle: ['Content-Length'] værdi: uddata tekst bytes
		).
		egen headere hver: { :_ :header
			Uddata skriv: header.
		}.
		egen headere-sendt := Sand.
		Uddata skriv: ['\r\n'].
	}.
	Uddata skriv: uddata.
}.

Webdokument ved: ['udskriv:'] gør: { :uddata
	selv udskriv: uddata type: ['text/html; charset=utf-8'].
}.

Webdokument ved: ['afslut:'] gør: { :uddata
	selv afslut: uddata type: ['text/html; charset=utf-8'].
}.

Webdokument ved: ['json:'] gør: { :uddata
	selv udskriv: ( JSON jsonify: uddata ) type: ['application/json'].
}.

Webdokument ved: ['ikke-fundet:'] gør: { :uddata
	selv ryd-headere header: (
		HTTP-Header ny nøgle: ['Status'] værdi: ['404 Not Found']
	).
	selv udskriv: uddata.
}.


# Interface

>> Session := Objekt ny.

Session ved: ['ny'] gør: { <- selv ny initialiser for: Intet.
}.

Session ved: ['for:'] gør: { :id
	egen id := id.
}.

Session ved: ['indlæs'] gør: {
	denne-opgave fejl: ['Not implemented.'].
}.

Session ved: ['gem:'] gør: {
	denne-opgave fejl: ['Not implemented.'].
}.

Session ved: ['ødelæg'] gør: {
	denne-opgave fejl: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Midlertidig-fil-session := Session ny.

Midlertidig-fil-session ved: ['initialiser'] gør: {
	egen stibegyndelse := ['/tmp/sess-'].
}.

Midlertidig-fil-session ved: ['stipræfiks:'] gør: { :tegnstreng
	egen stibegyndelse := tegnstreng.
}.

Midlertidig-fil-session ved: ['fil'] gør: { <- ( Fil ny: ( egen stibegyndelse + egen id + ['.txt'] ) ).
}.

Midlertidig-fil-session ved: ['indlæs'] gør: {
	>> fil := selv fil.
	fil findes falsk: {
		fil skriv: (Ordbog ny code).
	}. <- fil læs objekt.
}.

Midlertidig-fil-session ved: ['gem:'] gør: { :data
	>> fil := selv fil.
	fil findes sand: {
		fil skriv: data code.
	}.
}.

Midlertidig-fil-session ved: ['ødelæg'] gør: {
	>> fil := selv fil.
	fil findes sand: {
		fil slet.
	}.
}.


>> URL := Objekt ny.

URL ved: ['initialiser'] gør: {
	egen protokol := ['https://'].
	egen vært := ['localhost'].
	egen sti := [''].
	egen url-parametre := [''].
	egen hash := [''].
}.

URL ved: ['ny'] gør: { <- selv ny initialiser.
}.

URL ved: ['tekst'] gør: { <- (
	egen protokol +
	egen vært +
	egen sti +
	egen url-parametre +
	egen hash ).
}.

URL ved: ['protokol:'] gør: { :protokol
	((Liste ny ; ['http'] ; ['https']) har: protokol) sand: {
		egen protokol := protokol + ['://'].
	}, falsk: {
		denne-opgave fejl: ['Invalid protocol'].
	}.
}.

URL ved: ['vært:'] gør: { :vært
	#todo validate according to rfc
	egen vært := vært.
}.

URL ved: ['sti:'] gør: { :sti
	egen sti := ['/'] + sti url-kode.
}.

URL ved: ['url-parametre:'] gør: { :tilknytning
	>> url-parametre := Liste ny.
	tilknytning hver: { :nøgle :værdi
		url-parametre tilføj: nøgle tekst url-kode + ['='] + værdi tekst url-kode.
	}.
	egen url-parametre := ['?'] + ( url-parametre saml: ['&'] ).
}.

URL ved: ['hash:'] gør: { :hash
	egen hash := ['#'] + hash url-kode.
}.

