
# ~ Simple template engine ~

>> Skabelon := Objekt ny.

Skabelon ved: ['ny'] gør: { <- selv ny indhold: [''].
}.

Skabelon ved: ['indhold:'] gør: { :indhold
	egen indhold := indhold. 
}.

Skabelon ved: ['ny:'] gør: { :indhold <- selv ny indhold: indhold.
}.

Skabelon ved: ['klip:'] gør: { :markør
	>> startmarkør := (['<!-- cut:%id% -->'] %id%: markør).
	>> slutmarkør := (['<!-- /cut:%id% -->'] %id%: markør).
	>> dele := egen indhold opdel: startmarkør.
	>> præfiks := dele første.
	>> dele2 := dele sidste opdel: slutmarkør.
	>> suffiks := dele2 sidste.
	>> del := dele2 første.
	>> rest := præfiks + suffiks.
	egen indhold := rest. <- Skabelon ny: del.
	
}.

Skabelon ved: ['kopiér'] gør: { <- selv ny: selv tekst kopiér.
}.
	
Skabelon ved: ['indsæt:ved:'] gør: { :uddrag :id
	>> indsætmarkør := (['<!-- paste:%id% -->'] %id%: id).
	egen indhold erstat: indsætmarkør med: ( uddrag tekst + indsætmarkør ).
}.

Skabelon ved: ['sæt:værdi:'] gør: { :plads :værdi
	egen indhold erstat: ['<!-- slot:'] + plads + [' -->'] med: ( Server html-kode: værdi ).
}.

Skabelon ved: ['sæt:html:'] gør: { :plads :html
	egen indhold erstat: ['<!-- slot:'] + plads + [' -->'] med: html.
}.

Skabelon ved: ['svar:og:'] gør: { :plads :værdi
	selv sæt: (plads fra: 0 længde: (plads længde - 1)) værdi: værdi.
}.

Skabelon ved: ['nl2br'] gør: {
	egen indhold erstat: ['\n'] med: ['<br>'].
}.

Skabelon ved: ['rens'] gør: {
	egen indhold :=
		Mønster
		ny: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		match: egen indhold
		gør: { <- ['']. }.
}.

Skabelon ved: ['rens-klip'] gør: {
	>> elementer := Liste ny.
	Mønster
	ny: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	match: egen indhold
	gør: { :_ :del
		elementer tilføj: del ? 1.
	}.
	elementer hver: { :_ :id
		egen indhold :=
			Mønster ny: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			match: egen indhold
			gør: { <- ['']. }.
	 }.
}.

Skabelon ved: ['rens-mellemrum'] gør: {
	egen indhold :=
		Mønster
		ny: ['\\s*\\n'],
		match: egen indhold
		gør: { <- ['\n']. }.
	egen indhold :=
		Mønster
		ny: ['\\n[\\s\\t]+'],
		match: egen indhold
		gør: { <- ['\n']. }.
}.

Skabelon ved: ['rens-alt'] gør: {
	selv rens.
	selv rens-klip.
	selv rens-mellemrum.
}.

Skabelon ved: ['tekst'] gør: { <- egen indhold.
}.
