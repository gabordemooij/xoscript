>> E-mail := Objekt ny.

E-mail ved: ['initialiser'] gør: {
	egen modtagere := Liste ny.
	egen cc := Liste ny.
	egen bcc := Liste ny.
	egen afsender := Intet.
	egen afsendernavn := Intet.
	egen emne := Intet.
	egen brødtekst := Intet.
}.

E-mail ved: ['ny'] gør: { <- selv ny initialiser.
}.

E-mail ved: ['til:'] gør: { :opremsning
	egen modtagere := opremsning.
}.
 
E-mail ved: ['cc:'] gør: { :opremsning
	egen cc := opremsning.
}.

E-mail ved: ['bcc:'] gør: { :opremsning
	egen bcc := opremsning.
}.

E-mail ved: ['emne:'] gør: { :emne
	egen emne := emne.
}.

E-mail ved: ['afsender:navn:'] gør: { :afsender :navn
	egen afsender := afsender.
	egen afsendernavn := navn.
}.

E-mail ved: ['brødtekst:'] gør: { :brødtekst
	egen brødtekst := brødtekst.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-mail ved: ['header:'] gør: { :linje <- linje erstat: ['\r'] med: [''], erstat: ['\n'] med: [''].
}.

E-mail ved: ['send'] gør: {
	>> f := Fil tempwrite: selv generer.
	Program system: ['sendmail -t < '] + f sti, stop.
}.

E-mail ved: ['generer'] gør: {
	>> linjeskift := ['\r\n'].
	>> tegnstreng := [''].
	tegnstreng tilføj: (selv header: ['From: '] + egen afsendernavn + [' <'] + ( egen afsender ) + ['>']) + linjeskift.
	tegnstreng tilføj: (selv header: ['To: '] + ( egen modtagere saml: [','] )) + linjeskift.
	egen cc antal sand: {
		tegnstreng tilføj: (selv header: ['Cc: '] + ( egen cc saml: [','] )) + linjeskift.
	}.
	egen bcc antal sand: {
		tegnstreng tilføj: (selv header: ['Bcc: '] + ( egen bcc saml: [','] )) + linjeskift.
	}.
	tegnstreng tilføj: (selv header: ['Subject: '] + egen emne) + linjeskift.
	tegnstreng tilføj: linjeskift.
	tegnstreng tilføj: egen brødtekst.
	tegnstreng tilføj: linjeskift. <- tegnstreng.
}.

>> HTML-E-mail := E-mail ny.

HTML-E-mail ved: ['initialiser'] gør: {
	selv initialiser.
	egen vedhæftninger := Liste ny.
	egen grænse := Boks token: 40.
}.

HTML-E-mail ved: ['vedhæft:'] gør: { :fil
	>> id := egen vedhæftninger antal.
	>> blob := fil blob.
	egen vedhæftninger tilføj: (
		Ordbog ny
			fil: fil sti,
			mime: ['image/'] + (Server mimetype: fil sti),
			data: blob base64-kode
	).
	blob frigiv. <- ['cid:attachment'] + id.
}.

HTML-E-mail ved: ['generer'] gør: {
	>> linjeskift := ['\r\n'].
	>> tegnstreng := [''].
	tegnstreng tilføj: (selv header: ['From: '] + egen afsendernavn + [' <'] + ( egen afsender ) + ['>']) + linjeskift.
	tegnstreng tilføj: (selv header: ['To: '] + ( egen modtagere saml: [','] )) + linjeskift.
	egen cc antal sand: {
		tegnstreng tilføj: (selv header: ['Cc: '] + ( egen cc saml: [','] )) + linjeskift.
	}.
	egen bcc antal sand: {
		tegnstreng tilføj: (selv header: ['Bcc: '] + ( egen bcc saml: [','] )) + linjeskift.
	}.
	tegnstreng tilføj: (selv header: ['Subject: '] + egen emne) + linjeskift.
	tegnstreng tilføj: ['MIME-Version: 1.0'] + linjeskift.
	tegnstreng tilføj: ['Content-Type: multipart/related; boundary="'] + egen grænse + ['"; type=text/html'] + linjeskift.
	tegnstreng tilføj: linjeskift.
	tegnstreng tilføj: ['--'] + egen grænse + linjeskift.
	tegnstreng tilføj: ['Content-Type: text/html; charset=UTF-8'] + linjeskift.
	tegnstreng tilføj: ['Content-Transfer-Encoding: 7bit'] + linjeskift.
	tegnstreng tilføj: linjeskift.
	tegnstreng tilføj: egen brødtekst.
	tegnstreng tilføj: linjeskift.
	egen vedhæftninger hver: { :id :info
		>> blob := info data.
		tegnstreng tilføj: ['--'] + egen grænse + linjeskift.
		tegnstreng tilføj: ['Content-Type: '] + info mime + linjeskift.
		tegnstreng tilføj: ['Content-Transfer-Encoding: base64'] + linjeskift.
		tegnstreng tilføj: ['Content-ID: <attachment'] + id + ['>'] + linjeskift.
		tegnstreng tilføj: ['Content-Disposition: inline; filename="'] + info fil + ['"'] + linjeskift.
		tegnstreng tilføj: linjeskift.
		>> højeste := 76.
		>> tekstlængde := blob længde.
		>> stykker := (tekstlængde / højeste) rund-op.
		{ :i
			>> stykke := blob kopiér fra: i * højeste længde: højeste.
			tegnstreng tilføj: stykke + linjeskift.
		} * stykker.
		tegnstreng tilføj: linjeskift.
		tegnstreng tilføj: linjeskift.
	}.
	tegnstreng tilføj: ['--'] + egen grænse + ['--'] + linjeskift. <- tegnstreng.
}.
