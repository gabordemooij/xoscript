>> Tölvupóstur := Hlutur nýtt.

Tölvupóstur við: ['frumstilla'] gera: {
	eigin viðtakendur := Listi nýtt.
	eigin cc := Listi nýtt.
	eigin bcc := Listi nýtt.
	eigin sendandi := Ekkert.
	eigin nafn-sendanda := Ekkert.
	eigin efni := Ekkert.
	eigin meginmál := Ekkert.
}.

Tölvupóstur við: ['nýtt'] gera: { <- sjálfur nýtt frumstilla.
}.

Tölvupóstur við: ['til:'] gera: { :upptalning
	eigin viðtakendur := upptalning.
}.
 
Tölvupóstur við: ['cc:'] gera: { :upptalning
	eigin cc := upptalning.
}.

Tölvupóstur við: ['bcc:'] gera: { :upptalning
	eigin bcc := upptalning.
}.

Tölvupóstur við: ['efni:'] gera: { :efni
	eigin efni := efni.
}.

Tölvupóstur við: ['sendandi:nafn:'] gera: { :sendandi :nafn
	eigin sendandi := sendandi.
	eigin nafn-sendanda := nafn.
}.

Tölvupóstur við: ['meginmál:'] gera: { :meginmál
	eigin meginmál := meginmál.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Tölvupóstur við: ['haus:'] gera: { :lína <- lína skipta: ['\r'] fyrir: [''], skipta: ['\n'] fyrir: [''].
}.

Tölvupóstur við: ['senda'] gera: {
	>> f := Skrá tempwrite: sjálfur búa-til.
	Forrit kerfi: ['sendmail -t < '] + f slóð, ný-lína.
}.

Tölvupóstur við: ['búa-til'] gera: {
	>> línuskil := ['\r\n'].
	>> strengur := [''].
	strengur bæta-aftast: (sjálfur haus: ['From: '] + eigin nafn-sendanda + [' <'] + ( eigin sendandi ) + ['>']) + línuskil.
	strengur bæta-aftast: (sjálfur haus: ['To: '] + ( eigin viðtakendur sameina: [','] )) + línuskil.
	eigin cc fjöldi satt: {
		strengur bæta-aftast: (sjálfur haus: ['Cc: '] + ( eigin cc sameina: [','] )) + línuskil.
	}.
	eigin bcc fjöldi satt: {
		strengur bæta-aftast: (sjálfur haus: ['Bcc: '] + ( eigin bcc sameina: [','] )) + línuskil.
	}.
	strengur bæta-aftast: (sjálfur haus: ['Subject: '] + eigin efni) + línuskil.
	strengur bæta-aftast: línuskil.
	strengur bæta-aftast: eigin meginmál.
	strengur bæta-aftast: línuskil. <- strengur.
}.

>> HTML-Tölvupóstur := Tölvupóstur nýtt.

HTML-Tölvupóstur við: ['frumstilla'] gera: {
	sjálfur frumstilla.
	eigin viðhengi := Listi nýtt.
	eigin mörk := Hvelfing tóki: 40.
}.

HTML-Tölvupóstur við: ['hengja-við:'] gera: { :skrá
	>> id := eigin viðhengi fjöldi.
	>> blob := skrá blob.
	eigin viðhengi bæta-aftast: (
		Orðabók nýtt
			skrá: skrá slóð,
			mime: ['image/'] + (Server mimetype: skrá slóð),
			gögn: blob base64-kóða
	).
	blob losa. <- ['cid:attachment'] + id.
}.

HTML-Tölvupóstur við: ['búa-til'] gera: {
	>> línuskil := ['\r\n'].
	>> strengur := [''].
	strengur bæta-aftast: (sjálfur haus: ['From: '] + eigin nafn-sendanda + [' <'] + ( eigin sendandi ) + ['>']) + línuskil.
	strengur bæta-aftast: (sjálfur haus: ['To: '] + ( eigin viðtakendur sameina: [','] )) + línuskil.
	eigin cc fjöldi satt: {
		strengur bæta-aftast: (sjálfur haus: ['Cc: '] + ( eigin cc sameina: [','] )) + línuskil.
	}.
	eigin bcc fjöldi satt: {
		strengur bæta-aftast: (sjálfur haus: ['Bcc: '] + ( eigin bcc sameina: [','] )) + línuskil.
	}.
	strengur bæta-aftast: (sjálfur haus: ['Subject: '] + eigin efni) + línuskil.
	strengur bæta-aftast: ['MIME-Version: 1.0'] + línuskil.
	strengur bæta-aftast: ['Content-Type: multipart/related; boundary="'] + eigin mörk + ['"; type=text/html'] + línuskil.
	strengur bæta-aftast: línuskil.
	strengur bæta-aftast: ['--'] + eigin mörk + línuskil.
	strengur bæta-aftast: ['Content-Type: text/html; charset=UTF-8'] + línuskil.
	strengur bæta-aftast: ['Content-Transfer-Encoding: 7bit'] + línuskil.
	strengur bæta-aftast: línuskil.
	strengur bæta-aftast: eigin meginmál.
	strengur bæta-aftast: línuskil.
	eigin viðhengi hver: { :id :upplýsingar
		>> blob := upplýsingar gögn.
		strengur bæta-aftast: ['--'] + eigin mörk + línuskil.
		strengur bæta-aftast: ['Content-Type: '] + upplýsingar mime + línuskil.
		strengur bæta-aftast: ['Content-Transfer-Encoding: base64'] + línuskil.
		strengur bæta-aftast: ['Content-ID: <attachment'] + id + ['>'] + línuskil.
		strengur bæta-aftast: ['Content-Disposition: inline; filename="'] + upplýsingar skrá + ['"'] + línuskil.
		strengur bæta-aftast: línuskil.
		>> hæst := 76.
		>> textalengd := blob lengd.
		>> bitar := (textalengd / hæst) námunda-upp.
		{ :i
			>> biti := blob afrita frá: i * hæst lengd: hæst.
			strengur bæta-aftast: biti + línuskil.
		} * bitar.
		strengur bæta-aftast: línuskil.
		strengur bæta-aftast: línuskil.
	}.
	strengur bæta-aftast: ['--'] + eigin mörk + ['--'] + línuskil. <- strengur.
}.
