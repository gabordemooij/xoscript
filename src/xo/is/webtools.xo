HTTP-Beiðni við: ['HTTP-header:'] gera: { :key <- Forrit stilling: key.
}.

>> HTTP-Header := Hlutur nýtt.

HTTP-Header við: ['nýtt'] gera: { <- sjálfur nýtt init.
}.

HTTP-Header við: ['init'] gera: {
	eigin key := Ekkert.
	eigin value := Ekkert.
}.

HTTP-Header við: ['key:value:'] gera: { :key :value
	eigin key := key.
	eigin value := value.
}.

HTTP-Header við: ['key'] gera: { <- eigin key.
}.

HTTP-Header við: ['value'] gera: { <- eigin value.
}.


HTTP-Header við: ['texti'] gera: {
	>> line := eigin key + [': '] + eigin value.
	line skipta: ['\r'] fyrir: [''], skipta: ['\n'] fyrir: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Hlutur nýtt.

Web-Document við: ['nýtt'] gera: { <- sjálfur nýtt init.
}.

Web-Document við: ['init'] gera: {
	eigin headers := Listi nýtt.
	eigin sess-id := Ekkert.
	eigin session-manager := Tempfile-Session nýtt.
	eigin sessdata := Ekkert.
	eigin secure := Satt.
	eigin same-site := ['Strict'].
	eigin headers-out := Rangt.
	eigin request := HTTP-Beiðni nýtt.
}.

Web-Document við: ['request:'] gera: { :request
	eigin request := request.
}. 

Web-Document við: ['secure-session-cookie:'] gera: { :secure
	sjálfur check-headers.
	eigin secure := secure.
}.

Web-Document við: ['same-site-session-cookie:'] gera: { :value
	sjálfur check-headers.
	>> options := Listi nýtt 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options inniheldur: value, rangt: {
		þetta-verk villa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigin same-site := value.
}.

Web-Document við: ['header:'] gera: { :header
	sjálfur check-headers.
	eigin headers bæta-aftast: header.
}.

Web-Document við: ['clear-headers'] gera: {
	sjálfur check-headers.
	eigin headers := Listi nýtt.
}.

Web-Document við: ['session-manager:'] gera: { :manager
	sjálfur check-headers.
	eigin session-manager := manager.
}.

Web-Document við: ['session-manager'] gera: { <- eigin session-manager.
}.

Web-Document við: ['check-headers'] gera: {
	eigin headers-out satt: {
		þetta-verk villa: ['Headers already sent to client.'].
	}.
}.

Web-Document við: ['session-start'] gera: {
	sjálfur check-headers.
	>> request := eigin request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ekkert? rangt: {
		(( Mynstur nýtt: ['^[A-Za-z0-9]+\\z'], samsvörun: sess-id ) = 0) satt: {
			sess-id := Ekkert.
		}.
	}.
	sess-id Ekkert? satt: {
		sess-id := Hvelfing tóki: 30.
		>> session-header := HTTP-Header nýtt
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigin secure annaðhvort: ['Secure'] eða: ['']),
		SSITE: (eigin same-site),
		XSID: sess-id
		).
		eigin headers bæta-aftast: session-header.
	}.
	eigin sessdata := eigin session-manager for: sess-id, load. <- eigin sessdata. # reference
}.

Web-Document við: ['goto:'] gera: { :url
	sjálfur check-headers.
	sjálfur clear-headers.
	eigin headers
	bæta-aftast: (
		HTTP-Header nýtt
		key: ['Status'] value: ['303 See Other']
	),
	bæta-aftast: (
		HTTP-Header nýtt
		key: ['Location'] value: url
	).
	sjálfur out: ['Redirect'].
}.

Web-Document við: ['session-destroy'] gera: {
	sjálfur check-headers.
	>> request := eigin request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ekkert? rangt: {
		>> session-header := HTTP-Header nýtt.
		>> when := Stund nýtt ár: 1970, snið: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (eigin secure annaðhvort: ['Secure'] eða: ['']),
			SSITE: (eigin same-site),
			XSID: sess-id
		).
		eigin session-manager destroy.
		eigin headers bæta-aftast: session-header.
	}.
}.


Web-Document við: ['template:'] gera: { :slóð <- Template nýtt: (Skrá nýtt: slóð, lesa).
}.

Web-Document við: ['out:type:'] gera: { :output :gerð
	eigin headers-out rangt: {
		eigin sessdata Ekkert? rangt: {
			eigin session-manager save: eigin sessdata.
		}.
		eigin headers bæta-aftast: (
			HTTP-Header nýtt
			key: ['Content-type'] value: gerð
		).
		eigin headers hver: { :_ :header
			Úttak skrifa: header.
		}.
		eigin headers-out := Satt.
		Úttak skrifa: ['\r\n'].
	}.
	Úttak skrifa: output.
}.

Web-Document við: ['finish:type:'] gera: { :output :gerð
	eigin headers-out rangt: {
		eigin sessdata Ekkert? rangt: {
			eigin session-manager save: eigin sessdata.
		}.
		eigin headers bæta-aftast: (
			HTTP-Header nýtt
			key: ['Content-type'] value: gerð
		).
		eigin headers bæta-aftast: (
			HTTP-Header nýtt
			key: ['Content-Length'] value: output texti bytes
		).
		eigin headers hver: { :_ :header
			Úttak skrifa: header.
		}.
		eigin headers-out := Satt.
		Úttak skrifa: ['\r\n'].
	}.
	Úttak skrifa: output.
}.

Web-Document við: ['out:'] gera: { :output
	sjálfur out: output type: ['text/html; charset=utf-8'].
}.

Web-Document við: ['finish:'] gera: { :output
	sjálfur finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document við: ['json:'] gera: { :output
	sjálfur out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document við: ['not-found:'] gera: { :output
	sjálfur clear-headers header: (
		HTTP-Header nýtt key: ['Status'] value: ['404 Not Found']
	).
	sjálfur out: output.
}.


# Interface

>> Session := Hlutur nýtt.

Session við: ['nýtt'] gera: { <- sjálfur nýtt init for: Ekkert.
}.

Session við: ['for:'] gera: { :id
	eigin id := id.
}.

Session við: ['load'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

Session við: ['save:'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

Session við: ['destroy'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session nýtt.

Tempfile-Session við: ['init'] gera: {
	eigin pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session við: ['path-prefix:'] gera: { :str
	eigin pathprefix := str.
}.

Tempfile-Session við: ['file'] gera: { <- ( Skrá nýtt: ( eigin pathprefix + eigin id + ['.txt'] ) ).
}.

Tempfile-Session við: ['load'] gera: {
	>> file := sjálfur file.
	file er-til rangt: {
		file skrifa: (Orðabók nýtt kóði).
	}. <- file lesa hlutur.
}.

Tempfile-Session við: ['save:'] gera: { :data
	>> file := sjálfur file.
	file er-til satt: {
		file skrifa: data kóði.
	}.
}.

Tempfile-Session við: ['destroy'] gera: {
	>> file := sjálfur file.
	file er-til satt: {
		file eyða.
	}.
}.


>> URL := Hlutur nýtt.

URL við: ['init'] gera: {
	eigin protocol := ['https://'].
	eigin hýsill := ['localhost'].
	eigin slóð := [''].
	eigin params := [''].
	eigin hash := [''].
}.

URL við: ['nýtt'] gera: { <- sjálfur nýtt init.
}.

URL við: ['texti'] gera: { <- (
	eigin protocol +
	eigin hýsill +
	eigin slóð +
	eigin params +
	eigin hash ).
}.

URL við: ['protocol:'] gera: { :protocol
	((Listi nýtt: ['http'] ; ['https']) inniheldur: protocol) satt: {
		eigin protocol := protocol + ['://'].
	}, rangt: {
		þetta-verk villa: ['Invalid protocol'].
	}.
}.

URL við: ['hýsill:'] gera: { :hýsill
	#todo validate according to rfc
	eigin hýsill := hýsill.
}.

URL við: ['path:'] gera: { :slóð
	eigin slóð := ['/'] + slóð url-kóða.
}.

URL við: ['params:'] gera: { :map
	>> params := Listi nýtt.
	map hver: { :key :value
		params bæta-aftast: key texti url-kóða + ['='] + value texti url-kóða.
	}.
	eigin params := ['?'] + ( params sameina: ['&'] ).
}.

URL við: ['tætigildi:'] gera: { :hash
	eigin hash := ['#'] + hash url-kóða.
}.

