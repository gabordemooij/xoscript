HTTP-Beiðni við: ['HTTP-haus:'] gera: { :lykill <- Forrit stilling: lykill.
}.

>> HTTP-Haus := Hlutur nýtt.

HTTP-Haus við: ['nýtt'] gera: { <- sjálfur nýtt frumstilla.
}.

HTTP-Haus við: ['frumstilla'] gera: {
	eigin lykill := Ekkert.
	eigin gildið := Ekkert.
}.

HTTP-Haus við: ['lykill:gildið:'] gera: { :lykill :gildið
	eigin lykill := lykill.
	eigin gildið := gildið.
}.

HTTP-Haus við: ['lykill'] gera: { <- eigin lykill.
}.

HTTP-Haus við: ['gildið'] gera: { <- eigin gildið.
}.


HTTP-Haus við: ['texti'] gera: {
	>> lína := eigin lykill + [': '] + eigin gildið.
	lína skipta: ['\r'] fyrir: [''], skipta: ['\n'] fyrir: ['']. <- lína + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Vefskjal := Hlutur nýtt.

Vefskjal við: ['nýtt'] gera: { <- sjálfur nýtt frumstilla.
}.

Vefskjal við: ['frumstilla'] gera: {
	eigin hausar := Listi nýtt.
	eigin setu-auðkenni := Ekkert.
	eigin setustjóri := Bráðabirgðaskrár-seta nýtt.
	eigin setugögn := Ekkert.
	eigin öruggt := Satt.
	eigin sama-vefs := ['Strict'].
	eigin hausar-sendir := Rangt.
	eigin beiðni := HTTP-Beiðni nýtt.
}.

Vefskjal við: ['beiðni:'] gera: { :beiðni
	eigin beiðni := beiðni.
}. 

Vefskjal við: ['örugg-setukaka:'] gera: { :öruggt
	sjálfur athuga-hausa.
	eigin öruggt := öruggt.
}.

Vefskjal við: ['sama-vefs-setukaka:'] gera: { :gildið
	sjálfur athuga-hausa.
	>> valkostir := Listi nýtt 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	valkostir hefur: gildið, rangt: {
		þetta-verk villa: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eigin sama-vefs := gildið.
}.

Vefskjal við: ['haus:'] gera: { :haus
	sjálfur athuga-hausa.
	eigin hausar bæta-aftast: haus.
}.

Vefskjal við: ['tæma-hausa'] gera: {
	sjálfur athuga-hausa.
	eigin hausar := Listi nýtt.
}.

Vefskjal við: ['setustjóri:'] gera: { :stjóri
	sjálfur athuga-hausa.
	eigin setustjóri := stjóri.
}.

Vefskjal við: ['setustjóri'] gera: { <- eigin setustjóri.
}.

Vefskjal við: ['athuga-hausa'] gera: {
	eigin hausar-sendir satt: {
		þetta-verk villa: ['Headers already sent to client.'].
	}.
}.

Vefskjal við: ['hefja-setu'] gera: {
	sjálfur athuga-hausa.
	>> beiðni := eigin beiðni.
	>> setu-auðkenni := beiðni cookie: ['xsid'].
	setu-auðkenni Ekkert? rangt: {
		(( Mynstur nýtt: ['^[A-Za-z0-9]+\\z'], samsvörun: setu-auðkenni ) = 0) satt: {
			setu-auðkenni := Ekkert.
		}.
	}.
	setu-auðkenni Ekkert? satt: {
		setu-auðkenni := Hvelfing tóki: 30.
		>> setuhaus := HTTP-Haus nýtt
		lykill: ['Set-Cookie'] gildið: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eigin öruggt annaðhvort: ['Secure'] eða: ['']),
		SSITE: (eigin sama-vefs),
		XSID: setu-auðkenni
		).
		eigin hausar bæta-aftast: setuhaus.
	}.
	eigin setugögn := eigin setustjóri fyrir: setu-auðkenni, hlaða. <- eigin setugögn. # reference
}.

Vefskjal við: ['fara-á:'] gera: { :vefslóð
	sjálfur athuga-hausa.
	sjálfur tæma-hausa.
	eigin hausar
	bæta-aftast: (
		HTTP-Haus nýtt
		lykill: ['Status'] gildið: ['303 See Other']
	),
	bæta-aftast: (
		HTTP-Haus nýtt
		lykill: ['Location'] gildið: vefslóð
	).
	sjálfur skrifa-út: ['Redirect'].
}.

Vefskjal við: ['eyða-setu'] gera: {
	sjálfur athuga-hausa.
	>> beiðni := eigin beiðni.
	>> setu-auðkenni := beiðni cookie: ['xsid'].
	setu-auðkenni Ekkert? rangt: {
		>> setuhaus := HTTP-Haus nýtt.
		>> tímasetning := Stund nýtt ár: 1970, snið: ['%a, %d %b %Y %H:%M:%S GMT'].
		setuhaus lykill: ['Set-Cookie'] gildið: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tímasetning,
			SEC: (eigin öruggt annaðhvort: ['Secure'] eða: ['']),
			SSITE: (eigin sama-vefs),
			XSID: setu-auðkenni
		).
		eigin setustjóri tortíma.
		eigin hausar bæta-aftast: setuhaus.
	}.
}.


Vefskjal við: ['sniðmát:'] gera: { :slóð <- Sniðmát nýtt: (Skrá nýtt: slóð, lesa).
}.

Vefskjal við: ['skrifa-út:gerð:'] gera: { :úttak :gerð
	eigin hausar-sendir rangt: {
		eigin setugögn Ekkert? rangt: {
			eigin setustjóri vista: eigin setugögn.
		}.
		eigin hausar bæta-aftast: (
			HTTP-Haus nýtt
			lykill: ['Content-type'] gildið: gerð
		).
		eigin hausar hver: { :_ :haus
			Úttak skrifa: haus.
		}.
		eigin hausar-sendir := Satt.
		Úttak skrifa: ['\r\n'].
	}.
	Úttak skrifa: úttak.
}.

Vefskjal við: ['ljúka:gerð:'] gera: { :úttak :gerð
	eigin hausar-sendir rangt: {
		eigin setugögn Ekkert? rangt: {
			eigin setustjóri vista: eigin setugögn.
		}.
		eigin hausar bæta-aftast: (
			HTTP-Haus nýtt
			lykill: ['Content-type'] gildið: gerð
		).
		eigin hausar bæta-aftast: (
			HTTP-Haus nýtt
			lykill: ['Content-Length'] gildið: úttak texti bytes
		).
		eigin hausar hver: { :_ :haus
			Úttak skrifa: haus.
		}.
		eigin hausar-sendir := Satt.
		Úttak skrifa: ['\r\n'].
	}.
	Úttak skrifa: úttak.
}.

Vefskjal við: ['skrifa-út:'] gera: { :úttak
	sjálfur skrifa-út: úttak gerð: ['text/html; charset=utf-8'].
}.

Vefskjal við: ['ljúka:'] gera: { :úttak
	sjálfur ljúka: úttak gerð: ['text/html; charset=utf-8'].
}.

Vefskjal við: ['json:'] gera: { :úttak
	sjálfur skrifa-út: ( JSON jsonify: úttak ) gerð: ['application/json'].
}.

Vefskjal við: ['fannst-ekki:'] gera: { :úttak
	sjálfur tæma-hausa haus: (
		HTTP-Haus nýtt lykill: ['Status'] gildið: ['404 Not Found']
	).
	sjálfur skrifa-út: úttak.
}.


# Interface

>> Seta := Hlutur nýtt.

Seta við: ['nýtt'] gera: { <- sjálfur nýtt frumstilla fyrir: Ekkert.
}.

Seta við: ['fyrir:'] gera: { :id
	eigin id := id.
}.

Seta við: ['hlaða'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

Seta við: ['vista:'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

Seta við: ['tortíma'] gera: {
	þetta-verk villa: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Bráðabirgðaskrár-seta := Seta nýtt.

Bráðabirgðaskrár-seta við: ['frumstilla'] gera: {
	eigin slóðarbyrjun := ['/tmp/sess-'].
}.

Bráðabirgðaskrár-seta við: ['slóðarforskeyti:'] gera: { :strengur
	eigin slóðarbyrjun := strengur.
}.

Bráðabirgðaskrár-seta við: ['skrá'] gera: { <- ( Skrá nýtt: ( eigin slóðarbyrjun + eigin id + ['.txt'] ) ).
}.

Bráðabirgðaskrár-seta við: ['hlaða'] gera: {
	>> skrá := sjálfur skrá.
	skrá er-til rangt: {
		skrá skrifa: (Orðabók nýtt kóði).
	}. <- skrá lesa hlutur.
}.

Bráðabirgðaskrár-seta við: ['vista:'] gera: { :gögn
	>> skrá := sjálfur skrá.
	skrá er-til satt: {
		skrá skrifa: gögn kóði.
	}.
}.

Bráðabirgðaskrár-seta við: ['tortíma'] gera: {
	>> skrá := sjálfur skrá.
	skrá er-til satt: {
		skrá eyða.
	}.
}.


>> URL := Hlutur nýtt.

URL við: ['frumstilla'] gera: {
	eigin samskiptaregla := ['https://'].
	eigin hýsill := ['localhost'].
	eigin slóð := [''].
	eigin url-færibreytur := [''].
	eigin hash := [''].
}.

URL við: ['nýtt'] gera: { <- sjálfur nýtt frumstilla.
}.

URL við: ['texti'] gera: { <- (
	eigin samskiptaregla +
	eigin hýsill +
	eigin slóð +
	eigin url-færibreytur +
	eigin hash ).
}.

URL við: ['samskiptaregla:'] gera: { :samskiptaregla
	((Listi nýtt ; ['http'] ; ['https']) hefur: samskiptaregla) satt: {
		eigin samskiptaregla := samskiptaregla + ['://'].
	}, rangt: {
		þetta-verk villa: ['Invalid protocol'].
	}.
}.

URL við: ['hýsill:'] gera: { :hýsill
	#todo validate according to rfc
	eigin hýsill := hýsill.
}.

URL við: ['slóð:'] gera: { :slóð
	eigin slóð := ['/'] + slóð url-kóða.
}.

URL við: ['url-færibreytur:'] gera: { :vörpun
	>> url-færibreytur := Listi nýtt.
	vörpun hver: { :lykill :gildið
		url-færibreytur bæta-aftast: lykill texti url-kóða + ['='] + gildið texti url-kóða.
	}.
	eigin url-færibreytur := ['?'] + ( url-færibreytur sameina: ['&'] ).
}.

URL við: ['tætigildi:'] gera: { :hash
	eigin hash := ['#'] + hash url-kóða.
}.

