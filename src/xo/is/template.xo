
# ~ Simple template engine ~

>> Sniðmát := Hlutur nýtt.

Sniðmát við: ['nýtt'] gera: { <- sjálfur nýtt innihald: [''].
}.

Sniðmát við: ['innihald:'] gera: { :innihald
	eigin innihald := innihald. 
}.

Sniðmát við: ['nýtt:'] gera: { :innihald <- sjálfur nýtt innihald: innihald.
}.

Sniðmát við: ['klippa:'] gera: { :merki
	>> upphafsmerki := (['<!-- cut:%id% -->'] %id%: merki).
	>> lokamerki := (['<!-- /cut:%id% -->'] %id%: merki).
	>> hlutar := eigin innihald kljúfa: upphafsmerki.
	>> forskeyti := hlutar fyrsta.
	>> hlutar2 := hlutar síðasta kljúfa: lokamerki.
	>> viðskeyti := hlutar2 síðasta.
	>> hluti := hlutar2 fyrsta.
	>> afgangur := forskeyti + viðskeyti.
	eigin innihald := afgangur. <- Sniðmát nýtt: hluti.
	
}.

Sniðmát við: ['afrita'] gera: { <- sjálfur nýtt: sjálfur texti afrita.
}.
	
Sniðmát við: ['líma:við:'] gera: { :bútur :id
	>> límmerki := (['<!-- paste:%id% -->'] %id%: id).
	eigin innihald skipta: límmerki fyrir: ( bútur texti + límmerki ).
}.

Sniðmát við: ['setja:gildi:'] gera: { :hólf :gildið
	eigin innihald skipta: ['<!-- slot:'] + hólf + [' -->'] fyrir: ( Server html-kóða: gildið ).
}.

Sniðmát við: ['setja:html:'] gera: { :hólf :html
	eigin innihald skipta: ['<!-- slot:'] + hólf + [' -->'] fyrir: html.
}.

Sniðmát við: ['svara:og:'] gera: { :hólf :gildið
	sjálfur setja: (hólf frá: 0 lengd: (hólf lengd - 1)) gildi: gildið.
}.

Sniðmát við: ['nl2br'] gera: {
	eigin innihald skipta: ['\n'] fyrir: ['<br>'].
}.

Sniðmát við: ['fága'] gera: {
	eigin innihald :=
		Mynstur
		nýtt: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		samsvörun: eigin innihald
		gera: { <- ['']. }.
}.

Sniðmát við: ['fága-klippur'] gera: {
	>> atriði := Listi nýtt.
	Mynstur
	nýtt: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	samsvörun: eigin innihald
	gera: { :_ :hluti
		atriði bæta-aftast: hluti ? 1.
	}.
	atriði hver: { :_ :id
		eigin innihald :=
			Mynstur nýtt: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			samsvörun: eigin innihald
			gera: { <- ['']. }.
	 }.
}.

Sniðmát við: ['fága-bil'] gera: {
	eigin innihald :=
		Mynstur
		nýtt: ['\\s*\\n'],
		samsvörun: eigin innihald
		gera: { <- ['\n']. }.
	eigin innihald :=
		Mynstur
		nýtt: ['\\n[\\s\\t]+'],
		samsvörun: eigin innihald
		gera: { <- ['\n']. }.
}.

Sniðmát við: ['fága-allt'] gera: {
	sjálfur fága.
	sjálfur fága-klippur.
	sjálfur fága-bil.
}.

Sniðmát við: ['texti'] gera: { <- eigin innihald.
}.
