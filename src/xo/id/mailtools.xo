>> Surel := Objek baru.

Surel saat: ['inisialisasi'] lakukan: {
	milik penerima := Daftar baru.
	milik cc := Daftar baru.
	milik bcc := Daftar baru.
	milik pengirim := Kosong.
	milik nama-pengirim := Kosong.
	milik subjek := Kosong.
	milik badan := Kosong.
}.

Surel saat: ['baru'] lakukan: { <- diri baru inisialisasi.
}.

Surel saat: ['kepada:'] lakukan: { :penyebutan
	milik penerima := penyebutan.
}.
 
Surel saat: ['cc:'] lakukan: { :penyebutan
	milik cc := penyebutan.
}.

Surel saat: ['bcc:'] lakukan: { :penyebutan
	milik bcc := penyebutan.
}.

Surel saat: ['subjek:'] lakukan: { :subjek
	milik subjek := subjek.
}.

Surel saat: ['pengirim:nama:'] lakukan: { :pengirim :nama
	milik pengirim := pengirim.
	milik nama-pengirim := nama.
}.

Surel saat: ['badan:'] lakukan: { :badan
	milik badan := badan.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Surel saat: ['tajuk:'] lakukan: { :baris <- baris ganti: ['\r'] dengan: [''], ganti: ['\n'] dengan: [''].
}.

Surel saat: ['kirim'] lakukan: {
	>> f := Berkas tempwrite: diri hasilkan.
	Program sistem: ['sendmail -t < '] + f jalur, baris-baru.
}.

Surel saat: ['hasilkan'] lakukan: {
	>> pemisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-di-akhir: (diri tajuk: ['From: '] + milik nama-pengirim + [' <'] + ( milik pengirim ) + ['>']) + pemisah-baris.
	untaian tambah-di-akhir: (diri tajuk: ['To: '] + ( milik penerima gabungkan: [','] )) + pemisah-baris.
	milik cc jumlah benar: {
		untaian tambah-di-akhir: (diri tajuk: ['Cc: '] + ( milik cc gabungkan: [','] )) + pemisah-baris.
	}.
	milik bcc jumlah benar: {
		untaian tambah-di-akhir: (diri tajuk: ['Bcc: '] + ( milik bcc gabungkan: [','] )) + pemisah-baris.
	}.
	untaian tambah-di-akhir: (diri tajuk: ['Subject: '] + milik subjek) + pemisah-baris.
	untaian tambah-di-akhir: pemisah-baris.
	untaian tambah-di-akhir: milik badan.
	untaian tambah-di-akhir: pemisah-baris. <- untaian.
}.

>> Surel-HTML := Surel baru.

Surel-HTML saat: ['inisialisasi'] lakukan: {
	diri inisialisasi.
	milik lampiran := Daftar baru.
	milik batas := Brankas token: 40.
}.

Surel-HTML saat: ['lampirkan:'] lakukan: { :berkas-sesi
	>> id := milik lampiran jumlah.
	>> blob := berkas-sesi blob.
	milik lampiran tambah-di-akhir: (
		Kamus baru
			berkas-sesi: berkas-sesi jalur,
			mime: ['image/'] + (Server mimetype: berkas-sesi jalur),
			data: blob base64-enkode
	).
	blob bebaskan. <- ['cid:attachment'] + id.
}.

Surel-HTML saat: ['hasilkan'] lakukan: {
	>> pemisah-baris := ['\r\n'].
	>> untaian := [''].
	untaian tambah-di-akhir: (diri tajuk: ['From: '] + milik nama-pengirim + [' <'] + ( milik pengirim ) + ['>']) + pemisah-baris.
	untaian tambah-di-akhir: (diri tajuk: ['To: '] + ( milik penerima gabungkan: [','] )) + pemisah-baris.
	milik cc jumlah benar: {
		untaian tambah-di-akhir: (diri tajuk: ['Cc: '] + ( milik cc gabungkan: [','] )) + pemisah-baris.
	}.
	milik bcc jumlah benar: {
		untaian tambah-di-akhir: (diri tajuk: ['Bcc: '] + ( milik bcc gabungkan: [','] )) + pemisah-baris.
	}.
	untaian tambah-di-akhir: (diri tajuk: ['Subject: '] + milik subjek) + pemisah-baris.
	untaian tambah-di-akhir: ['MIME-Version: 1.0'] + pemisah-baris.
	untaian tambah-di-akhir: ['Content-Type: multipart/related; boundary="'] + milik batas + ['"; type=text/html'] + pemisah-baris.
	untaian tambah-di-akhir: pemisah-baris.
	untaian tambah-di-akhir: ['--'] + milik batas + pemisah-baris.
	untaian tambah-di-akhir: ['Content-Type: text/html; charset=UTF-8'] + pemisah-baris.
	untaian tambah-di-akhir: ['Content-Transfer-Encoding: 7bit'] + pemisah-baris.
	untaian tambah-di-akhir: pemisah-baris.
	untaian tambah-di-akhir: milik badan.
	untaian tambah-di-akhir: pemisah-baris.
	milik lampiran setiap: { :id :info
		>> blob := info data.
		untaian tambah-di-akhir: ['--'] + milik batas + pemisah-baris.
		untaian tambah-di-akhir: ['Content-Type: '] + info mime + pemisah-baris.
		untaian tambah-di-akhir: ['Content-Transfer-Encoding: base64'] + pemisah-baris.
		untaian tambah-di-akhir: ['Content-ID: <attachment'] + id + ['>'] + pemisah-baris.
		untaian tambah-di-akhir: ['Content-Disposition: inline; filename="'] + info berkas-sesi + ['"'] + pemisah-baris.
		untaian tambah-di-akhir: pemisah-baris.
		>> maksimal := 76.
		>> panjang-teks := blob panjang.
		>> bongkahan := (panjang-teks / maksimal) bulatkan-ke-atas.
		{ :i
			>> bongkah := blob salin dari: i * maksimal panjang: maksimal.
			untaian tambah-di-akhir: bongkah + pemisah-baris.
		} * bongkahan.
		untaian tambah-di-akhir: pemisah-baris.
		untaian tambah-di-akhir: pemisah-baris.
	}.
	untaian tambah-di-akhir: ['--'] + milik batas + ['--'] + pemisah-baris. <- untaian.
}.
