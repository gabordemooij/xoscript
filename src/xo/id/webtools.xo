Permintaan-HTTP saat: ['HTTP-tajuk:'] lakukan: { :kunci-tajuk <- Program pengaturan: kunci-tajuk.
}.

>> Tajuk-HTTP := Objek baru.

Tajuk-HTTP saat: ['baru'] lakukan: { <- diri baru inisialisasi.
}.

Tajuk-HTTP saat: ['inisialisasi'] lakukan: {
	milik kunci-tajuk := Kosong.
	milik nilai := Kosong.
}.

Tajuk-HTTP saat: ['kunci-tajuk:nilai:'] lakukan: { :kunci-tajuk :nilai
	milik kunci-tajuk := kunci-tajuk.
	milik nilai := nilai.
}.

Tajuk-HTTP saat: ['kunci-tajuk'] lakukan: { <- milik kunci-tajuk.
}.

Tajuk-HTTP saat: ['nilai'] lakukan: { <- milik nilai.
}.


Tajuk-HTTP saat: ['teks'] lakukan: {
	>> baris := milik kunci-tajuk + [': '] + milik nilai.
	baris ganti: ['\r'] dengan: [''], ganti: ['\n'] dengan: ['']. <- baris + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumen-Web := Objek baru.

Dokumen-Web saat: ['baru'] lakukan: { <- diri baru inisialisasi.
}.

Dokumen-Web saat: ['inisialisasi'] lakukan: {
	milik daftar-tajuk := Daftar baru.
	milik id-sesi := Kosong.
	milik pengelola-sesi := Sesi-berkas-sementara baru.
	milik data-sesi := Kosong.
	milik aman := Benar.
	milik situs-sama := ['Strict'].
	milik tajuk-terkirim := Salah.
	milik permintaan-http := Permintaan-HTTP baru.
}.

Dokumen-Web saat: ['permintaan-http:'] lakukan: { :permintaan-http
	milik permintaan-http := permintaan-http.
}. 

Dokumen-Web saat: ['kuki-sesi-aman:'] lakukan: { :aman
	diri periksa-tajuk.
	milik aman := aman.
}.

Dokumen-Web saat: ['kuki-sesi-situs-sama:'] lakukan: { :nilai
	diri periksa-tajuk.
	>> opsi := Daftar baru 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsi memiliki: nilai, salah: {
		tugas-ini galat: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	milik situs-sama := nilai.
}.

Dokumen-Web saat: ['tajuk:'] lakukan: { :tajuk
	diri periksa-tajuk.
	milik daftar-tajuk tambah-di-akhir: tajuk.
}.

Dokumen-Web saat: ['kosongkan-tajuk'] lakukan: {
	diri periksa-tajuk.
	milik daftar-tajuk := Daftar baru.
}.

Dokumen-Web saat: ['pengelola-sesi:'] lakukan: { :pengelola
	diri periksa-tajuk.
	milik pengelola-sesi := pengelola.
}.

Dokumen-Web saat: ['pengelola-sesi'] lakukan: { <- milik pengelola-sesi.
}.

Dokumen-Web saat: ['periksa-tajuk'] lakukan: {
	milik tajuk-terkirim benar: {
		tugas-ini galat: ['Headers already sent to client.'].
	}.
}.

Dokumen-Web saat: ['mulai-sesi'] lakukan: {
	diri periksa-tajuk.
	>> permintaan-http := milik permintaan-http.
	>> id-sesi := permintaan-http cookie: ['xsid'].
	id-sesi Kosong? salah: {
		(( Pola baru: ['^[A-Za-z0-9]+\\z'], cocok: id-sesi ) = 0) benar: {
			id-sesi := Kosong.
		}.
	}.
	id-sesi Kosong? benar: {
		id-sesi := Brankas token: 30.
		>> tajuk-sesi := Tajuk-HTTP baru
		kunci-tajuk: ['Set-Cookie'] nilai: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (milik aman pilih: ['Secure'] atau: ['']),
		SSITE: (milik situs-sama),
		XSID: id-sesi
		).
		milik daftar-tajuk tambah-di-akhir: tajuk-sesi.
	}.
	milik data-sesi := milik pengelola-sesi untuk: id-sesi, muat. <- milik data-sesi. # reference
}.

Dokumen-Web saat: ['pergi-ke:'] lakukan: { :alamat
	diri periksa-tajuk.
	diri kosongkan-tajuk.
	milik daftar-tajuk
	tambah-di-akhir: (
		Tajuk-HTTP baru
		kunci-tajuk: ['Status'] nilai: ['303 See Other']
	),
	tambah-di-akhir: (
		Tajuk-HTTP baru
		kunci-tajuk: ['Location'] nilai: alamat
	).
	diri keluarkan: ['Redirect'].
}.

Dokumen-Web saat: ['hancurkan-sesi'] lakukan: {
	diri periksa-tajuk.
	>> permintaan-http := milik permintaan-http.
	>> id-sesi := permintaan-http cookie: ['xsid'].
	id-sesi Kosong? salah: {
		>> tajuk-sesi := Tajuk-HTTP baru.
		>> saat := Momen baru tahun: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		tajuk-sesi kunci-tajuk: ['Set-Cookie'] nilai: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: saat,
			SEC: (milik aman pilih: ['Secure'] atau: ['']),
			SSITE: (milik situs-sama),
			XSID: id-sesi
		).
		milik pengelola-sesi hancurkan.
		milik daftar-tajuk tambah-di-akhir: tajuk-sesi.
	}.
}.


Dokumen-Web saat: ['templat:'] lakukan: { :jalur <- Templat baru: (Berkas baru: jalur, baca).
}.

Dokumen-Web saat: ['keluarkan:tipe:'] lakukan: { :keluaran :tipe
	milik tajuk-terkirim salah: {
		milik data-sesi Kosong? salah: {
			milik pengelola-sesi simpan: milik data-sesi.
		}.
		milik daftar-tajuk tambah-di-akhir: (
			Tajuk-HTTP baru
			kunci-tajuk: ['Content-type'] nilai: tipe
		).
		milik daftar-tajuk setiap: { :_ :tajuk
			Keluaran tulis: tajuk.
		}.
		milik tajuk-terkirim := Benar.
		Keluaran tulis: ['\r\n'].
	}.
	Keluaran tulis: keluaran.
}.

Dokumen-Web saat: ['selesaikan:tipe:'] lakukan: { :keluaran :tipe
	milik tajuk-terkirim salah: {
		milik data-sesi Kosong? salah: {
			milik pengelola-sesi simpan: milik data-sesi.
		}.
		milik daftar-tajuk tambah-di-akhir: (
			Tajuk-HTTP baru
			kunci-tajuk: ['Content-type'] nilai: tipe
		).
		milik daftar-tajuk tambah-di-akhir: (
			Tajuk-HTTP baru
			kunci-tajuk: ['Content-Length'] nilai: keluaran teks bytes
		).
		milik daftar-tajuk setiap: { :_ :tajuk
			Keluaran tulis: tajuk.
		}.
		milik tajuk-terkirim := Benar.
		Keluaran tulis: ['\r\n'].
	}.
	Keluaran tulis: keluaran.
}.

Dokumen-Web saat: ['keluarkan:'] lakukan: { :keluaran
	diri keluarkan: keluaran tipe: ['text/html; charset=utf-8'].
}.

Dokumen-Web saat: ['selesaikan:'] lakukan: { :keluaran
	diri selesaikan: keluaran tipe: ['text/html; charset=utf-8'].
}.

Dokumen-Web saat: ['json:'] lakukan: { :keluaran
	diri keluarkan: ( JSON jsonify: keluaran ) tipe: ['application/json'].
}.

Dokumen-Web saat: ['tidak-ditemukan:'] lakukan: { :keluaran
	diri kosongkan-tajuk tajuk: (
		Tajuk-HTTP baru kunci-tajuk: ['Status'] nilai: ['404 Not Found']
	).
	diri keluarkan: keluaran.
}.


# Interface

>> Sesi := Objek baru.

Sesi saat: ['baru'] lakukan: { <- diri baru inisialisasi untuk: Kosong.
}.

Sesi saat: ['untuk:'] lakukan: { :id
	milik id := id.
}.

Sesi saat: ['muat'] lakukan: {
	tugas-ini galat: ['Not implemented.'].
}.

Sesi saat: ['simpan:'] lakukan: {
	tugas-ini galat: ['Not implemented.'].
}.

Sesi saat: ['hancurkan'] lakukan: {
	tugas-ini galat: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesi-berkas-sementara := Sesi baru.

Sesi-berkas-sementara saat: ['inisialisasi'] lakukan: {
	milik awal-jalur := ['/tmp/sess-'].
}.

Sesi-berkas-sementara saat: ['awalan-jalur:'] lakukan: { :untaian
	milik awal-jalur := untaian.
}.

Sesi-berkas-sementara saat: ['berkas-sesi'] lakukan: { <- ( Berkas baru: ( milik awal-jalur + milik id + ['.txt'] ) ).
}.

Sesi-berkas-sementara saat: ['muat'] lakukan: {
	>> berkas-sesi := diri berkas-sesi.
	berkas-sesi ada salah: {
		berkas-sesi tulis: (Kamus baru kode).
	}. <- berkas-sesi baca objek.
}.

Sesi-berkas-sementara saat: ['simpan:'] lakukan: { :data
	>> berkas-sesi := diri berkas-sesi.
	berkas-sesi ada benar: {
		berkas-sesi tulis: data kode.
	}.
}.

Sesi-berkas-sementara saat: ['hancurkan'] lakukan: {
	>> berkas-sesi := diri berkas-sesi.
	berkas-sesi ada benar: {
		berkas-sesi hapus.
	}.
}.


>> URL := Objek baru.

URL saat: ['inisialisasi'] lakukan: {
	milik protokol := ['https://'].
	milik hos := ['localhost'].
	milik jalur := [''].
	milik parameter-url := [''].
	milik hash := [''].
}.

URL saat: ['baru'] lakukan: { <- diri baru inisialisasi.
}.

URL saat: ['teks'] lakukan: { <- (
	milik protokol +
	milik hos +
	milik jalur +
	milik parameter-url +
	milik hash ).
}.

URL saat: ['protokol:'] lakukan: { :protokol
	((Daftar baru ; ['http'] ; ['https']) memiliki: protokol) benar: {
		milik protokol := protokol + ['://'].
	}, salah: {
		tugas-ini galat: ['Invalid protocol'].
	}.
}.

URL saat: ['hos:'] lakukan: { :hos
	#todo validate according to rfc
	milik hos := hos.
}.

URL saat: ['jalur:'] lakukan: { :jalur
	milik jalur := ['/'] + jalur url-enkode.
}.

URL saat: ['parameter-url:'] lakukan: { :pemetaan
	>> parameter-url := Daftar baru.
	pemetaan setiap: { :kunci-tajuk :nilai
		parameter-url tambah-di-akhir: kunci-tajuk teks url-enkode + ['='] + nilai teks url-enkode.
	}.
	milik parameter-url := ['?'] + ( parameter-url gabungkan: ['&'] ).
}.

URL saat: ['hash:'] lakukan: { :hash
	milik hash := ['#'] + hash url-enkode.
}.

