
# ~ Simple template engine ~

>> Templat := Objek baru.

Templat saat: ['baru'] lakukan: { <- diri baru konten: [''].
}.

Templat saat: ['konten:'] lakukan: { :konten
	milik konten := konten. 
}.

Templat saat: ['baru:'] lakukan: { :konten <- diri baru konten: konten.
}.

Templat saat: ['potong:'] lakukan: { :penanda
	>> penanda-awal := (['<!-- cut:%id% -->'] %id%: penanda).
	>> penanda-akhir := (['<!-- /cut:%id% -->'] %id%: penanda).
	>> bagian-bagian := milik konten pisahkan: penanda-awal.
	>> awalan := bagian-bagian pertama.
	>> bagian-bagian2 := bagian-bagian terakhir pisahkan: penanda-akhir.
	>> akhiran := bagian-bagian2 terakhir.
	>> bagian := bagian-bagian2 pertama.
	>> sisa := awalan + akhiran.
	milik konten := sisa. <- Templat baru: bagian.
	
}.

Templat saat: ['salin'] lakukan: { <- diri baru: diri teks salin.
}.
	
Templat saat: ['tempel:di:'] lakukan: { :cuplikan :id
	>> penanda-tempel := (['<!-- paste:%id% -->'] %id%: id).
	milik konten ganti: penanda-tempel dengan: ( cuplikan teks + penanda-tempel ).
}.

Templat saat: ['atur:nilai:'] lakukan: { :slot :nilai
	milik konten ganti: ['<!-- slot:'] + slot + [' -->'] dengan: ( Server html-enkode: nilai ).
}.

Templat saat: ['atur:html:'] lakukan: { :slot :html
	milik konten ganti: ['<!-- slot:'] + slot + [' -->'] dengan: html.
}.

Templat saat: ['tanggapi:dan:'] lakukan: { :slot :nilai
	diri atur: (slot dari: 0 panjang: (slot panjang - 1)) nilai: nilai.
}.

Templat saat: ['nl2br'] lakukan: {
	milik konten ganti: ['\n'] dengan: ['<br>'].
}.

Templat saat: ['rapikan'] lakukan: {
	milik konten :=
		Pola
		baru: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		cocok: milik konten
		lakukan: { <- ['']. }.
}.

Templat saat: ['rapikan-potongan'] lakukan: {
	>> butir := Daftar baru.
	Pola
	baru: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	cocok: milik konten
	lakukan: { :_ :bagian
		butir tambah-di-akhir: bagian ? 1.
	}.
	butir setiap: { :_ :id
		milik konten :=
			Pola baru: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			cocok: milik konten
			lakukan: { <- ['']. }.
	 }.
}.

Templat saat: ['rapikan-spasi'] lakukan: {
	milik konten :=
		Pola
		baru: ['\\s*\\n'],
		cocok: milik konten
		lakukan: { <- ['\n']. }.
	milik konten :=
		Pola
		baru: ['\\n[\\s\\t]+'],
		cocok: milik konten
		lakukan: { <- ['\n']. }.
}.

Templat saat: ['rapikan-semua'] lakukan: {
	diri rapikan.
	diri rapikan-potongan.
	diri rapikan-spasi.
}.

Templat saat: ['teks'] lakukan: { <- milik konten.
}.
