Isicelo-HTTP uma-kufika: ['HTTP-isihloko:'] yenza: { :ukhiye <- Uhlelo isilungiselelo: ukhiye.
}.

>> Isihloko-se-HTTP := Into okusha.

Isihloko-se-HTTP uma-kufika: ['okusha'] yenza: { <- uqobo okusha lungiselela.
}.

Isihloko-se-HTTP uma-kufika: ['lungiselela'] yenza: {
	okwakho ukhiye := Lutho.
	okwakho inani-elibekiwe := Lutho.
}.

Isihloko-se-HTTP uma-kufika: ['ukhiye:inani-elibekiwe:'] yenza: { :ukhiye :inani-elibekiwe
	okwakho ukhiye := ukhiye.
	okwakho inani-elibekiwe := inani-elibekiwe.
}.

Isihloko-se-HTTP uma-kufika: ['ukhiye'] yenza: { <- okwakho ukhiye.
}.

Isihloko-se-HTTP uma-kufika: ['inani-elibekiwe'] yenza: { <- okwakho inani-elibekiwe.
}.


Isihloko-se-HTTP uma-kufika: ['umbhalo'] yenza: {
	>> umugqa := okwakho ukhiye + [': '] + okwakho inani-elibekiwe.
	umugqa buyisela: ['\r'] nge: [''], buyisela: ['\n'] nge: ['']. <- umugqa + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Idokhumenti-yewebhu := Into okusha.

Idokhumenti-yewebhu uma-kufika: ['okusha'] yenza: { <- uqobo okusha lungiselela.
}.

Idokhumenti-yewebhu uma-kufika: ['lungiselela'] yenza: {
	okwakho izihloko := Uhlu okusha.
	okwakho i-id-yeseshini := Lutho.
	okwakho umphathi-weseshini := Iseshini-yefayela-lesikhashana okusha.
	okwakho idatha-yeseshini := Lutho.
	okwakho ephephile := Iqiniso.
	okwakho isayithi-elifanayo := ['Strict'].
	okwakho izihloko-zithunyelwe := Amanga.
	okwakho isicelo-http := Isicelo-HTTP okusha.
}.

Idokhumenti-yewebhu uma-kufika: ['isicelo-http:'] yenza: { :isicelo-http
	okwakho isicelo-http := isicelo-http.
}. 

Idokhumenti-yewebhu uma-kufika: ['ikhukhi-yeseshini-ephephile:'] yenza: { :ephephile
	uqobo hlola-izihloko.
	okwakho ephephile := ephephile.
}.

Idokhumenti-yewebhu uma-kufika: ['ikhukhi-yeseshini-yesayithi-elifanayo:'] yenza: { :inani-elibekiwe
	uqobo hlola-izihloko.
	>> izinketho := Uhlu okusha 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	izinketho ine: inani-elibekiwe, amanga: {
		lo-msebenzi iphutha: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	okwakho isayithi-elifanayo := inani-elibekiwe.
}.

Idokhumenti-yewebhu uma-kufika: ['isihloko:'] yenza: { :isihloko
	uqobo hlola-izihloko.
	okwakho izihloko engeza-ekugcineni: isihloko.
}.

Idokhumenti-yewebhu uma-kufika: ['susa-izihloko'] yenza: {
	uqobo hlola-izihloko.
	okwakho izihloko := Uhlu okusha.
}.

Idokhumenti-yewebhu uma-kufika: ['umphathi-weseshini:'] yenza: { :umphathi
	uqobo hlola-izihloko.
	okwakho umphathi-weseshini := umphathi.
}.

Idokhumenti-yewebhu uma-kufika: ['umphathi-weseshini'] yenza: { <- okwakho umphathi-weseshini.
}.

Idokhumenti-yewebhu uma-kufika: ['hlola-izihloko'] yenza: {
	okwakho izihloko-zithunyelwe iqiniso: {
		lo-msebenzi iphutha: ['Headers already sent to client.'].
	}.
}.

Idokhumenti-yewebhu uma-kufika: ['qala-iseshini'] yenza: {
	uqobo hlola-izihloko.
	>> isicelo-http := okwakho isicelo-http.
	>> i-id-yeseshini := isicelo-http cookie: ['xsid'].
	i-id-yeseshini Lutho? amanga: {
		(( Iphethini okusha: ['^[A-Za-z0-9]+\\z'], ukufana: i-id-yeseshini ) = 0) iqiniso: {
			i-id-yeseshini := Lutho.
		}.
	}.
	i-id-yeseshini Lutho? iqiniso: {
		i-id-yeseshini := Isisefo ithokheni: 30.
		>> isihloko-seseshini := Isihloko-se-HTTP okusha
		ukhiye: ['Set-Cookie'] inani-elibekiwe: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (okwakho ephephile lokhu: ['Secure'] noma-lokho: ['']),
		SSITE: (okwakho isayithi-elifanayo),
		XSID: i-id-yeseshini
		).
		okwakho izihloko engeza-ekugcineni: isihloko-seseshini.
	}.
	okwakho idatha-yeseshini := okwakho umphathi-weseshini okwe: i-id-yeseshini, layisha. <- okwakho idatha-yeseshini. # reference
}.

Idokhumenti-yewebhu uma-kufika: ['iya-ku:'] yenza: { :ikheli
	uqobo hlola-izihloko.
	uqobo susa-izihloko.
	okwakho izihloko
	engeza-ekugcineni: (
		Isihloko-se-HTTP okusha
		ukhiye: ['Status'] inani-elibekiwe: ['303 See Other']
	),
	engeza-ekugcineni: (
		Isihloko-se-HTTP okusha
		ukhiye: ['Location'] inani-elibekiwe: ikheli
	).
	uqobo veza: ['Redirect'].
}.

Idokhumenti-yewebhu uma-kufika: ['bhubhisa-iseshini'] yenza: {
	uqobo hlola-izihloko.
	>> isicelo-http := okwakho isicelo-http.
	>> i-id-yeseshini := isicelo-http cookie: ['xsid'].
	i-id-yeseshini Lutho? amanga: {
		>> isihloko-seseshini := Isihloko-se-HTTP okusha.
		>> isikhathi-sokuphela := Isikhathi okusha unyaka: 1970, ifomethi: ['%a, %d %b %Y %H:%M:%S GMT'].
		isihloko-seseshini ukhiye: ['Set-Cookie'] inani-elibekiwe: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: isikhathi-sokuphela,
			SEC: (okwakho ephephile lokhu: ['Secure'] noma-lokho: ['']),
			SSITE: (okwakho isayithi-elifanayo),
			XSID: i-id-yeseshini
		).
		okwakho umphathi-weseshini bhubhisa.
		okwakho izihloko engeza-ekugcineni: isihloko-seseshini.
	}.
}.


Idokhumenti-yewebhu uma-kufika: ['isifanekiso:'] yenza: { :indlela-yefayela <- Isifanekiso okusha: (Ifayela okusha: indlela-yefayela, funda).
}.

Idokhumenti-yewebhu uma-kufika: ['veza:uhlobo:'] yenza: { :umphumela :uhlobo
	okwakho izihloko-zithunyelwe amanga: {
		okwakho idatha-yeseshini Lutho? amanga: {
			okwakho umphathi-weseshini gcina: okwakho idatha-yeseshini.
		}.
		okwakho izihloko engeza-ekugcineni: (
			Isihloko-se-HTTP okusha
			ukhiye: ['Content-type'] inani-elibekiwe: uhlobo
		).
		okwakho izihloko ngamunye: { :_ :isihloko
			Okuphumayo bhala: isihloko.
		}.
		okwakho izihloko-zithunyelwe := Iqiniso.
		Okuphumayo bhala: ['\r\n'].
	}.
	Okuphumayo bhala: umphumela.
}.

Idokhumenti-yewebhu uma-kufika: ['qeda:uhlobo:'] yenza: { :umphumela :uhlobo
	okwakho izihloko-zithunyelwe amanga: {
		okwakho idatha-yeseshini Lutho? amanga: {
			okwakho umphathi-weseshini gcina: okwakho idatha-yeseshini.
		}.
		okwakho izihloko engeza-ekugcineni: (
			Isihloko-se-HTTP okusha
			ukhiye: ['Content-type'] inani-elibekiwe: uhlobo
		).
		okwakho izihloko engeza-ekugcineni: (
			Isihloko-se-HTTP okusha
			ukhiye: ['Content-Length'] inani-elibekiwe: umphumela umbhalo bytes
		).
		okwakho izihloko ngamunye: { :_ :isihloko
			Okuphumayo bhala: isihloko.
		}.
		okwakho izihloko-zithunyelwe := Iqiniso.
		Okuphumayo bhala: ['\r\n'].
	}.
	Okuphumayo bhala: umphumela.
}.

Idokhumenti-yewebhu uma-kufika: ['veza:'] yenza: { :umphumela
	uqobo veza: umphumela uhlobo: ['text/html; charset=utf-8'].
}.

Idokhumenti-yewebhu uma-kufika: ['qeda:'] yenza: { :umphumela
	uqobo qeda: umphumela uhlobo: ['text/html; charset=utf-8'].
}.

Idokhumenti-yewebhu uma-kufika: ['json:'] yenza: { :umphumela
	uqobo veza: ( JSON jsonify: umphumela ) uhlobo: ['application/json'].
}.

Idokhumenti-yewebhu uma-kufika: ['akutholakalanga:'] yenza: { :umphumela
	uqobo susa-izihloko isihloko: (
		Isihloko-se-HTTP okusha ukhiye: ['Status'] inani-elibekiwe: ['404 Not Found']
	).
	uqobo veza: umphumela.
}.


# Interface

>> Iseshini := Into okusha.

Iseshini uma-kufika: ['okusha'] yenza: { <- uqobo okusha lungiselela okwe: Lutho.
}.

Iseshini uma-kufika: ['okwe:'] yenza: { :id
	okwakho id := id.
}.

Iseshini uma-kufika: ['layisha'] yenza: {
	lo-msebenzi iphutha: ['Not implemented.'].
}.

Iseshini uma-kufika: ['gcina:'] yenza: {
	lo-msebenzi iphutha: ['Not implemented.'].
}.

Iseshini uma-kufika: ['bhubhisa'] yenza: {
	lo-msebenzi iphutha: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Iseshini-yefayela-lesikhashana := Iseshini okusha.

Iseshini-yefayela-lesikhashana uma-kufika: ['lungiselela'] yenza: {
	okwakho ukuqala-kwendlela := ['/tmp/sess-'].
}.

Iseshini-yefayela-lesikhashana uma-kufika: ['isiqalo-sendlela:'] yenza: { :uchungechunge-lombhalo
	okwakho ukuqala-kwendlela := uchungechunge-lombhalo.
}.

Iseshini-yefayela-lesikhashana uma-kufika: ['ifayela-leseshini'] yenza: { <- ( Ifayela okusha: ( okwakho ukuqala-kwendlela + okwakho id + ['.txt'] ) ).
}.

Iseshini-yefayela-lesikhashana uma-kufika: ['layisha'] yenza: {
	>> ifayela-leseshini := uqobo ifayela-leseshini.
	ifayela-leseshini ikhona amanga: {
		ifayela-leseshini bhala: (Isichazamazwi okusha ikhodi).
	}. <- ifayela-leseshini funda into.
}.

Iseshini-yefayela-lesikhashana uma-kufika: ['gcina:'] yenza: { :idatha
	>> ifayela-leseshini := uqobo ifayela-leseshini.
	ifayela-leseshini ikhona iqiniso: {
		ifayela-leseshini bhala: idatha ikhodi.
	}.
}.

Iseshini-yefayela-lesikhashana uma-kufika: ['bhubhisa'] yenza: {
	>> ifayela-leseshini := uqobo ifayela-leseshini.
	ifayela-leseshini ikhona iqiniso: {
		ifayela-leseshini susa.
	}.
}.


>> URL := Into okusha.

URL uma-kufika: ['lungiselela'] yenza: {
	okwakho iphrothokholi := ['https://'].
	okwakho umsingathi := ['localhost'].
	okwakho indlela-yefayela := [''].
	okwakho amapharamitha-url := [''].
	okwakho hash := [''].
}.

URL uma-kufika: ['okusha'] yenza: { <- uqobo okusha lungiselela.
}.

URL uma-kufika: ['umbhalo'] yenza: { <- (
	okwakho iphrothokholi +
	okwakho umsingathi +
	okwakho indlela-yefayela +
	okwakho amapharamitha-url +
	okwakho hash ).
}.

URL uma-kufika: ['iphrothokholi:'] yenza: { :iphrothokholi
	((Uhlu okusha ; ['http'] ; ['https']) ine: iphrothokholi) iqiniso: {
		okwakho iphrothokholi := iphrothokholi + ['://'].
	}, amanga: {
		lo-msebenzi iphutha: ['Invalid protocol'].
	}.
}.

URL uma-kufika: ['umsingathi:'] yenza: { :umsingathi
	#todo validate according to rfc
	okwakho umsingathi := umsingathi.
}.

URL uma-kufika: ['indlela-yefayela:'] yenza: { :indlela-yefayela
	okwakho indlela-yefayela := ['/'] + indlela-yefayela url-faka-ikhodi.
}.

URL uma-kufika: ['amapharamitha-url:'] yenza: { :ukumepha
	>> amapharamitha-url := Uhlu okusha.
	ukumepha ngamunye: { :ukhiye :inani-elibekiwe
		amapharamitha-url engeza-ekugcineni: ukhiye umbhalo url-faka-ikhodi + ['='] + inani-elibekiwe umbhalo url-faka-ikhodi.
	}.
	okwakho amapharamitha-url := ['?'] + ( amapharamitha-url hlanganisa: ['&'] ).
}.

URL uma-kufika: ['hashi:'] yenza: { :hash
	okwakho hash := ['#'] + hash url-faka-ikhodi.
}.

