
# ~ Simple template engine ~

>> Isifanekiso := Into okusha.

Isifanekiso uma-kufika: ['okusha'] yenza: { <- uqobo okusha okuqukethwe: [''].
}.

Isifanekiso uma-kufika: ['okuqukethwe:'] yenza: { :okuqukethwe
	okwakho okuqukethwe := okuqukethwe. 
}.

Isifanekiso uma-kufika: ['okusha:'] yenza: { :okuqukethwe <- uqobo okusha okuqukethwe: okuqukethwe.
}.

Isifanekiso uma-kufika: ['sika:'] yenza: { :uphawu
	>> uphawu-lokuqala := (['<!-- cut:%id% -->'] %id%: uphawu).
	>> uphawu-lokugcina := (['<!-- /cut:%id% -->'] %id%: uphawu).
	>> izingxenye := okwakho okuqukethwe hlukanisa: uphawu-lokuqala.
	>> isiqalo := izingxenye okokuqala.
	>> izingxenye2 := izingxenye okokugcina hlukanisa: uphawu-lokugcina.
	>> isijobelelo := izingxenye2 okokugcina.
	>> ingxenye := izingxenye2 okokuqala.
	>> okusele := isiqalo + isijobelelo.
	okwakho okuqukethwe := okusele. <- Isifanekiso okusha: ingxenye.
	
}.

Isifanekiso uma-kufika: ['kopisha'] yenza: { <- uqobo okusha: uqobo umbhalo kopisha.
}.
	
Isifanekiso uma-kufika: ['namathisela-ku:endaweni:'] yenza: { :isiqeshana :id
	>> uphawu-lokunamathisela := (['<!-- paste:%id% -->'] %id%: id).
	okwakho okuqukethwe buyisela: uphawu-lokunamathisela nge: ( isiqeshana umbhalo + uphawu-lokunamathisela ).
}.

Isifanekiso uma-kufika: ['setha:inani:'] yenza: { :isikhala-sokufaka :inani-elibekiwe
	okwakho okuqukethwe buyisela: ['<!-- slot:'] + isikhala-sokufaka + [' -->'] nge: ( Server html-faka-ikhodi: inani-elibekiwe ).
}.

Isifanekiso uma-kufika: ['setha:html:'] yenza: { :isikhala-sokufaka :html
	okwakho okuqukethwe buyisela: ['<!-- slot:'] + isikhala-sokufaka + [' -->'] nge: html.
}.

Isifanekiso uma-kufika: ['phendula:futhi:'] yenza: { :isikhala-sokufaka :inani-elibekiwe
	uqobo setha: (isikhala-sokufaka kusuka: 0 ubude: (isikhala-sokufaka ubude - 1)) inani: inani-elibekiwe.
}.

Isifanekiso uma-kufika: ['nl2br'] yenza: {
	okwakho okuqukethwe buyisela: ['\n'] nge: ['<br>'].
}.

Isifanekiso uma-kufika: ['hlela'] yenza: {
	okwakho okuqukethwe :=
		Iphethini
		okusha: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ukufana: okwakho okuqukethwe
		yenza: { <- ['']. }.
}.

Isifanekiso uma-kufika: ['hlela-okusikiwe'] yenza: {
	>> izinto := Uhlu okusha.
	Iphethini
	okusha: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ukufana: okwakho okuqukethwe
	yenza: { :_ :ingxenye
		izinto engeza-ekugcineni: ingxenye ? 1.
	}.
	izinto ngamunye: { :_ :id
		okwakho okuqukethwe :=
			Iphethini okusha: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ukufana: okwakho okuqukethwe
			yenza: { <- ['']. }.
	 }.
}.

Isifanekiso uma-kufika: ['hlela-izikhala'] yenza: {
	okwakho okuqukethwe :=
		Iphethini
		okusha: ['\\s*\\n'],
		ukufana: okwakho okuqukethwe
		yenza: { <- ['\n']. }.
	okwakho okuqukethwe :=
		Iphethini
		okusha: ['\\n[\\s\\t]+'],
		ukufana: okwakho okuqukethwe
		yenza: { <- ['\n']. }.
}.

Isifanekiso uma-kufika: ['hlela-konke'] yenza: {
	uqobo hlela.
	uqobo hlela-okusikiwe.
	uqobo hlela-izikhala.
}.

Isifanekiso uma-kufika: ['umbhalo'] yenza: { <- okwakho okuqukethwe.
}.
