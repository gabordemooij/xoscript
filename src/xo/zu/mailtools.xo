>> I-imeyili := Into okusha.

I-imeyili uma-kufika: ['lungiselela'] yenza: {
	okwakho abamukeli := Uhlu okusha.
	okwakho cc := Uhlu okusha.
	okwakho bcc := Uhlu okusha.
	okwakho umthumeli := Lutho.
	okwakho igama-lomthumeli := Lutho.
	okwakho isihloko-sendaba := Lutho.
	okwakho umzimba := Lutho.
}.

I-imeyili uma-kufika: ['okusha'] yenza: { <- uqobo okusha lungiselela.
}.

I-imeyili uma-kufika: ['ku:'] yenza: { :ukubala-uhlu
	okwakho abamukeli := ukubala-uhlu.
}.
 
I-imeyili uma-kufika: ['cc:'] yenza: { :ukubala-uhlu
	okwakho cc := ukubala-uhlu.
}.

I-imeyili uma-kufika: ['bcc:'] yenza: { :ukubala-uhlu
	okwakho bcc := ukubala-uhlu.
}.

I-imeyili uma-kufika: ['isihloko-sendaba:'] yenza: { :isihloko-sendaba
	okwakho isihloko-sendaba := isihloko-sendaba.
}.

I-imeyili uma-kufika: ['umthumeli:igama:'] yenza: { :umthumeli :igama
	okwakho umthumeli := umthumeli.
	okwakho igama-lomthumeli := igama.
}.

I-imeyili uma-kufika: ['umzimba:'] yenza: { :umzimba
	okwakho umzimba := umzimba.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
I-imeyili uma-kufika: ['isihloko:'] yenza: { :umugqa <- umugqa buyisela: ['\r'] nge: [''], buyisela: ['\n'] nge: [''].
}.

I-imeyili uma-kufika: ['thumela'] yenza: {
	>> f := Ifayela tempwrite: uqobo khiqiza.
	Uhlelo isistimu: ['sendmail -t < '] + f indlela-yefayela, umugqa-omusha.
}.

I-imeyili uma-kufika: ['khiqiza'] yenza: {
	>> ukuphula-umugqa := ['\r\n'].
	>> uchungechunge-lombhalo := [''].
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['From: '] + okwakho igama-lomthumeli + [' <'] + ( okwakho umthumeli ) + ['>']) + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['To: '] + ( okwakho abamukeli hlanganisa: [','] )) + ukuphula-umugqa.
	okwakho cc inani iqiniso: {
		uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Cc: '] + ( okwakho cc hlanganisa: [','] )) + ukuphula-umugqa.
	}.
	okwakho bcc inani iqiniso: {
		uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Bcc: '] + ( okwakho bcc hlanganisa: [','] )) + ukuphula-umugqa.
	}.
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Subject: '] + okwakho isihloko-sendaba) + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: okwakho umzimba.
	uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa. <- uchungechunge-lombhalo.
}.

>> I-imeyili-HTML := I-imeyili okusha.

I-imeyili-HTML uma-kufika: ['lungiselela'] yenza: {
	uqobo lungiselela.
	okwakho okunamathiselwe := Uhlu okusha.
	okwakho umngcele := Isisefo ithokheni: 40.
}.

I-imeyili-HTML uma-kufika: ['namathisela:'] yenza: { :ifayela-leseshini
	>> id := okwakho okunamathiselwe inani.
	>> blob := ifayela-leseshini blob.
	okwakho okunamathiselwe engeza-ekugcineni: (
		Isichazamazwi okusha
			ifayela-leseshini: ifayela-leseshini indlela-yefayela,
			mime: ['image/'] + (Server mimetype: ifayela-leseshini indlela-yefayela),
			idatha: blob base64-faka-ikhodi
	).
	blob khulula. <- ['cid:attachment'] + id.
}.

I-imeyili-HTML uma-kufika: ['khiqiza'] yenza: {
	>> ukuphula-umugqa := ['\r\n'].
	>> uchungechunge-lombhalo := [''].
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['From: '] + okwakho igama-lomthumeli + [' <'] + ( okwakho umthumeli ) + ['>']) + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['To: '] + ( okwakho abamukeli hlanganisa: [','] )) + ukuphula-umugqa.
	okwakho cc inani iqiniso: {
		uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Cc: '] + ( okwakho cc hlanganisa: [','] )) + ukuphula-umugqa.
	}.
	okwakho bcc inani iqiniso: {
		uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Bcc: '] + ( okwakho bcc hlanganisa: [','] )) + ukuphula-umugqa.
	}.
	uchungechunge-lombhalo engeza-ekugcineni: (uqobo isihloko: ['Subject: '] + okwakho isihloko-sendaba) + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ['MIME-Version: 1.0'] + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ['Content-Type: multipart/related; boundary="'] + okwakho umngcele + ['"; type=text/html'] + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ['--'] + okwakho umngcele + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ['Content-Type: text/html; charset=UTF-8'] + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ['Content-Transfer-Encoding: 7bit'] + ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
	uchungechunge-lombhalo engeza-ekugcineni: okwakho umzimba.
	uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
	okwakho okunamathiselwe ngamunye: { :id :ulwazi
		>> blob := ulwazi idatha.
		uchungechunge-lombhalo engeza-ekugcineni: ['--'] + okwakho umngcele + ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ['Content-Type: '] + ulwazi mime + ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ['Content-Transfer-Encoding: base64'] + ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ['Content-ID: <attachment'] + id + ['>'] + ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ['Content-Disposition: inline; filename="'] + ulwazi ifayela-leseshini + ['"'] + ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
		>> okuphezulu := 76.
		>> ubude-bombhalo := blob ubude.
		>> izingxenyana := (ubude-bombhalo / okuphezulu) khuphula-inani.
		{ :i
			>> ingxenyana := blob kopisha kusuka: i * okuphezulu ubude: okuphezulu.
			uchungechunge-lombhalo engeza-ekugcineni: ingxenyana + ukuphula-umugqa.
		} * izingxenyana.
		uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
		uchungechunge-lombhalo engeza-ekugcineni: ukuphula-umugqa.
	}.
	uchungechunge-lombhalo engeza-ekugcineni: ['--'] + okwakho umngcele + ['--'] + ukuphula-umugqa. <- uchungechunge-lombhalo.
}.
