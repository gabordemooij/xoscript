>> E-mel := Objek baharu.

E-mel apabila: ['mulakan-awal'] lakukan: {
	milik penerima := Senarai baharu.
	milik cc := Senarai baharu.
	milik bcc := Senarai baharu.
	milik pengirim := Tiada.
	milik nama-pengirim := Tiada.
	milik subjek := Tiada.
	milik badan := Tiada.
}.

E-mel apabila: ['baharu'] lakukan: { <- diri baharu mulakan-awal.
}.

E-mel apabila: ['kepada:'] lakukan: { :penyenaraian
	milik penerima := penyenaraian.
}.
 
E-mel apabila: ['cc:'] lakukan: { :penyenaraian
	milik cc := penyenaraian.
}.

E-mel apabila: ['bcc:'] lakukan: { :penyenaraian
	milik bcc := penyenaraian.
}.

E-mel apabila: ['subjek:'] lakukan: { :subjek
	milik subjek := subjek.
}.

E-mel apabila: ['pengirim:nama:'] lakukan: { :pengirim :nama
	milik pengirim := pengirim.
	milik nama-pengirim := nama.
}.

E-mel apabila: ['badan:'] lakukan: { :badan
	milik badan := badan.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-mel apabila: ['pengepala:'] lakukan: { :baris <- baris ganti: ['\r'] dengan: [''], ganti: ['\n'] dengan: [''].
}.

E-mel apabila: ['hantar'] lakukan: {
	>> f := Fail tempwrite: diri jana.
	Atur-cara sistem: ['sendmail -t < '] + f laluan, baris-baharu.
}.

E-mel apabila: ['jana'] lakukan: {
	>> pemisah-baris := ['\r\n'].
	>> rentetan := [''].
	rentetan tambah-di-hujung: (diri pengepala: ['From: '] + milik nama-pengirim + [' <'] + ( milik pengirim ) + ['>']) + pemisah-baris.
	rentetan tambah-di-hujung: (diri pengepala: ['To: '] + ( milik penerima gabungkan: [','] )) + pemisah-baris.
	milik cc bilangan benar: {
		rentetan tambah-di-hujung: (diri pengepala: ['Cc: '] + ( milik cc gabungkan: [','] )) + pemisah-baris.
	}.
	milik bcc bilangan benar: {
		rentetan tambah-di-hujung: (diri pengepala: ['Bcc: '] + ( milik bcc gabungkan: [','] )) + pemisah-baris.
	}.
	rentetan tambah-di-hujung: (diri pengepala: ['Subject: '] + milik subjek) + pemisah-baris.
	rentetan tambah-di-hujung: pemisah-baris.
	rentetan tambah-di-hujung: milik badan.
	rentetan tambah-di-hujung: pemisah-baris. <- rentetan.
}.

>> E-mel-HTML := E-mel baharu.

E-mel-HTML apabila: ['mulakan-awal'] lakukan: {
	diri mulakan-awal.
	milik lampiran := Senarai baharu.
	milik sempadan := Peti-besi token: 40.
}.

E-mel-HTML apabila: ['lampirkan:'] lakukan: { :fail-sesi
	>> id := milik lampiran bilangan.
	>> blob := fail-sesi blob.
	milik lampiran tambah-di-hujung: (
		Kamus baharu
			fail-sesi: fail-sesi laluan,
			mime: ['image/'] + (Server mimetype: fail-sesi laluan),
			data: blob base64-kodkan
	).
	blob bebaskan. <- ['cid:attachment'] + id.
}.

E-mel-HTML apabila: ['jana'] lakukan: {
	>> pemisah-baris := ['\r\n'].
	>> rentetan := [''].
	rentetan tambah-di-hujung: (diri pengepala: ['From: '] + milik nama-pengirim + [' <'] + ( milik pengirim ) + ['>']) + pemisah-baris.
	rentetan tambah-di-hujung: (diri pengepala: ['To: '] + ( milik penerima gabungkan: [','] )) + pemisah-baris.
	milik cc bilangan benar: {
		rentetan tambah-di-hujung: (diri pengepala: ['Cc: '] + ( milik cc gabungkan: [','] )) + pemisah-baris.
	}.
	milik bcc bilangan benar: {
		rentetan tambah-di-hujung: (diri pengepala: ['Bcc: '] + ( milik bcc gabungkan: [','] )) + pemisah-baris.
	}.
	rentetan tambah-di-hujung: (diri pengepala: ['Subject: '] + milik subjek) + pemisah-baris.
	rentetan tambah-di-hujung: ['MIME-Version: 1.0'] + pemisah-baris.
	rentetan tambah-di-hujung: ['Content-Type: multipart/related; boundary="'] + milik sempadan + ['"; type=text/html'] + pemisah-baris.
	rentetan tambah-di-hujung: pemisah-baris.
	rentetan tambah-di-hujung: ['--'] + milik sempadan + pemisah-baris.
	rentetan tambah-di-hujung: ['Content-Type: text/html; charset=UTF-8'] + pemisah-baris.
	rentetan tambah-di-hujung: ['Content-Transfer-Encoding: 7bit'] + pemisah-baris.
	rentetan tambah-di-hujung: pemisah-baris.
	rentetan tambah-di-hujung: milik badan.
	rentetan tambah-di-hujung: pemisah-baris.
	milik lampiran setiap: { :id :maklumat
		>> blob := maklumat data.
		rentetan tambah-di-hujung: ['--'] + milik sempadan + pemisah-baris.
		rentetan tambah-di-hujung: ['Content-Type: '] + maklumat mime + pemisah-baris.
		rentetan tambah-di-hujung: ['Content-Transfer-Encoding: base64'] + pemisah-baris.
		rentetan tambah-di-hujung: ['Content-ID: <attachment'] + id + ['>'] + pemisah-baris.
		rentetan tambah-di-hujung: ['Content-Disposition: inline; filename="'] + maklumat fail-sesi + ['"'] + pemisah-baris.
		rentetan tambah-di-hujung: pemisah-baris.
		>> had-atas := 76.
		>> panjang-teks := blob panjang.
		>> ketulan-ketulan := (panjang-teks / had-atas) bundar-ke-atas.
		{ :i
			>> ketulan := blob salin dari: i * had-atas panjang: had-atas.
			rentetan tambah-di-hujung: ketulan + pemisah-baris.
		} * ketulan-ketulan.
		rentetan tambah-di-hujung: pemisah-baris.
		rentetan tambah-di-hujung: pemisah-baris.
	}.
	rentetan tambah-di-hujung: ['--'] + milik sempadan + ['--'] + pemisah-baris. <- rentetan.
}.
