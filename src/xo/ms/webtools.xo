Permintaan-HTTP apabila: ['HTTP-pengepala:'] lakukan: { :kunci-pengepala <- Atur-cara tetapan: kunci-pengepala.
}.

>> Pengepala-HTTP := Objek baharu.

Pengepala-HTTP apabila: ['baharu'] lakukan: { <- diri baharu mulakan-awal.
}.

Pengepala-HTTP apabila: ['mulakan-awal'] lakukan: {
	milik kunci-pengepala := Tiada.
	milik nilai := Tiada.
}.

Pengepala-HTTP apabila: ['kunci-pengepala:nilai:'] lakukan: { :kunci-pengepala :nilai
	milik kunci-pengepala := kunci-pengepala.
	milik nilai := nilai.
}.

Pengepala-HTTP apabila: ['kunci-pengepala'] lakukan: { <- milik kunci-pengepala.
}.

Pengepala-HTTP apabila: ['nilai'] lakukan: { <- milik nilai.
}.


Pengepala-HTTP apabila: ['teks'] lakukan: {
	>> baris := milik kunci-pengepala + [': '] + milik nilai.
	baris ganti: ['\r'] dengan: [''], ganti: ['\n'] dengan: ['']. <- baris + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Dokumen-Web := Objek baharu.

Dokumen-Web apabila: ['baharu'] lakukan: { <- diri baharu mulakan-awal.
}.

Dokumen-Web apabila: ['mulakan-awal'] lakukan: {
	milik senarai-pengepala := Senarai baharu.
	milik id-sesi := Tiada.
	milik pengurus-sesi := Sesi-fail-sementara baharu.
	milik data-sesi := Tiada.
	milik selamat := Benar.
	milik tapak-sama := ['Strict'].
	milik pengepala-dihantar := Palsu.
	milik permintaan-http := Permintaan-HTTP baharu.
}.

Dokumen-Web apabila: ['permintaan-http:'] lakukan: { :permintaan-http
	milik permintaan-http := permintaan-http.
}. 

Dokumen-Web apabila: ['kuki-sesi-selamat:'] lakukan: { :selamat
	diri semak-pengepala.
	milik selamat := selamat.
}.

Dokumen-Web apabila: ['kuki-sesi-tapak-sama:'] lakukan: { :nilai
	diri semak-pengepala.
	>> pilihan := Senarai baharu 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	pilihan mempunyai: nilai, palsu: {
		tugas-ini ralat: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	milik tapak-sama := nilai.
}.

Dokumen-Web apabila: ['pengepala:'] lakukan: { :pengepala
	diri semak-pengepala.
	milik senarai-pengepala tambah-di-hujung: pengepala.
}.

Dokumen-Web apabila: ['kosongkan-pengepala'] lakukan: {
	diri semak-pengepala.
	milik senarai-pengepala := Senarai baharu.
}.

Dokumen-Web apabila: ['pengurus-sesi:'] lakukan: { :pengurus
	diri semak-pengepala.
	milik pengurus-sesi := pengurus.
}.

Dokumen-Web apabila: ['pengurus-sesi'] lakukan: { <- milik pengurus-sesi.
}.

Dokumen-Web apabila: ['semak-pengepala'] lakukan: {
	milik pengepala-dihantar benar: {
		tugas-ini ralat: ['Headers already sent to client.'].
	}.
}.

Dokumen-Web apabila: ['mulakan-sesi'] lakukan: {
	diri semak-pengepala.
	>> permintaan-http := milik permintaan-http.
	>> id-sesi := permintaan-http cookie: ['xsid'].
	id-sesi Tiada? palsu: {
		(( Corak baharu: ['^[A-Za-z0-9]+\\z'], padan: id-sesi ) = 0) benar: {
			id-sesi := Tiada.
		}.
	}.
	id-sesi Tiada? benar: {
		id-sesi := Peti-besi token: 30.
		>> pengepala-sesi := Pengepala-HTTP baharu
		kunci-pengepala: ['Set-Cookie'] nilai: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (milik selamat pilih: ['Secure'] atau: ['']),
		SSITE: (milik tapak-sama),
		XSID: id-sesi
		).
		milik senarai-pengepala tambah-di-hujung: pengepala-sesi.
	}.
	milik data-sesi := milik pengurus-sesi untuk: id-sesi, muatkan. <- milik data-sesi. # reference
}.

Dokumen-Web apabila: ['pergi-ke:'] lakukan: { :alamat
	diri semak-pengepala.
	diri kosongkan-pengepala.
	milik senarai-pengepala
	tambah-di-hujung: (
		Pengepala-HTTP baharu
		kunci-pengepala: ['Status'] nilai: ['303 See Other']
	),
	tambah-di-hujung: (
		Pengepala-HTTP baharu
		kunci-pengepala: ['Location'] nilai: alamat
	).
	diri keluarkan: ['Redirect'].
}.

Dokumen-Web apabila: ['musnahkan-sesi'] lakukan: {
	diri semak-pengepala.
	>> permintaan-http := milik permintaan-http.
	>> id-sesi := permintaan-http cookie: ['xsid'].
	id-sesi Tiada? palsu: {
		>> pengepala-sesi := Pengepala-HTTP baharu.
		>> ketika := Detik baharu tahun: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		pengepala-sesi kunci-pengepala: ['Set-Cookie'] nilai: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: ketika,
			SEC: (milik selamat pilih: ['Secure'] atau: ['']),
			SSITE: (milik tapak-sama),
			XSID: id-sesi
		).
		milik pengurus-sesi musnahkan.
		milik senarai-pengepala tambah-di-hujung: pengepala-sesi.
	}.
}.


Dokumen-Web apabila: ['templat:'] lakukan: { :laluan <- Templat baharu: (Fail baharu: laluan, baca).
}.

Dokumen-Web apabila: ['keluarkan:jenis:'] lakukan: { :output :jenis
	milik pengepala-dihantar palsu: {
		milik data-sesi Tiada? palsu: {
			milik pengurus-sesi simpan: milik data-sesi.
		}.
		milik senarai-pengepala tambah-di-hujung: (
			Pengepala-HTTP baharu
			kunci-pengepala: ['Content-type'] nilai: jenis
		).
		milik senarai-pengepala setiap: { :_ :pengepala
			Keluaran tulis: pengepala.
		}.
		milik pengepala-dihantar := Benar.
		Keluaran tulis: ['\r\n'].
	}.
	Keluaran tulis: output.
}.

Dokumen-Web apabila: ['selesaikan:jenis:'] lakukan: { :output :jenis
	milik pengepala-dihantar palsu: {
		milik data-sesi Tiada? palsu: {
			milik pengurus-sesi simpan: milik data-sesi.
		}.
		milik senarai-pengepala tambah-di-hujung: (
			Pengepala-HTTP baharu
			kunci-pengepala: ['Content-type'] nilai: jenis
		).
		milik senarai-pengepala tambah-di-hujung: (
			Pengepala-HTTP baharu
			kunci-pengepala: ['Content-Length'] nilai: output teks bytes
		).
		milik senarai-pengepala setiap: { :_ :pengepala
			Keluaran tulis: pengepala.
		}.
		milik pengepala-dihantar := Benar.
		Keluaran tulis: ['\r\n'].
	}.
	Keluaran tulis: output.
}.

Dokumen-Web apabila: ['keluarkan:'] lakukan: { :output
	diri keluarkan: output jenis: ['text/html; charset=utf-8'].
}.

Dokumen-Web apabila: ['selesaikan:'] lakukan: { :output
	diri selesaikan: output jenis: ['text/html; charset=utf-8'].
}.

Dokumen-Web apabila: ['json:'] lakukan: { :output
	diri keluarkan: ( JSON jsonify: output ) jenis: ['application/json'].
}.

Dokumen-Web apabila: ['tidak-dijumpai:'] lakukan: { :output
	diri kosongkan-pengepala pengepala: (
		Pengepala-HTTP baharu kunci-pengepala: ['Status'] nilai: ['404 Not Found']
	).
	diri keluarkan: output.
}.


# Interface

>> Sesi := Objek baharu.

Sesi apabila: ['baharu'] lakukan: { <- diri baharu mulakan-awal untuk: Tiada.
}.

Sesi apabila: ['untuk:'] lakukan: { :id
	milik id := id.
}.

Sesi apabila: ['muatkan'] lakukan: {
	tugas-ini ralat: ['Not implemented.'].
}.

Sesi apabila: ['simpan:'] lakukan: {
	tugas-ini ralat: ['Not implemented.'].
}.

Sesi apabila: ['musnahkan'] lakukan: {
	tugas-ini ralat: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sesi-fail-sementara := Sesi baharu.

Sesi-fail-sementara apabila: ['mulakan-awal'] lakukan: {
	milik permulaan-laluan := ['/tmp/sess-'].
}.

Sesi-fail-sementara apabila: ['awalan-laluan:'] lakukan: { :rentetan
	milik permulaan-laluan := rentetan.
}.

Sesi-fail-sementara apabila: ['fail-sesi'] lakukan: { <- ( Fail baharu: ( milik permulaan-laluan + milik id + ['.txt'] ) ).
}.

Sesi-fail-sementara apabila: ['muatkan'] lakukan: {
	>> fail-sesi := diri fail-sesi.
	fail-sesi wujud palsu: {
		fail-sesi tulis: (Kamus baharu kod).
	}. <- fail-sesi baca objek.
}.

Sesi-fail-sementara apabila: ['simpan:'] lakukan: { :data
	>> fail-sesi := diri fail-sesi.
	fail-sesi wujud benar: {
		fail-sesi tulis: data kod.
	}.
}.

Sesi-fail-sementara apabila: ['musnahkan'] lakukan: {
	>> fail-sesi := diri fail-sesi.
	fail-sesi wujud benar: {
		fail-sesi padam.
	}.
}.


>> URL := Objek baharu.

URL apabila: ['mulakan-awal'] lakukan: {
	milik protokol := ['https://'].
	milik hos := ['localhost'].
	milik laluan := [''].
	milik parameter-url := [''].
	milik hash := [''].
}.

URL apabila: ['baharu'] lakukan: { <- diri baharu mulakan-awal.
}.

URL apabila: ['teks'] lakukan: { <- (
	milik protokol +
	milik hos +
	milik laluan +
	milik parameter-url +
	milik hash ).
}.

URL apabila: ['protokol:'] lakukan: { :protokol
	((Senarai baharu ; ['http'] ; ['https']) mempunyai: protokol) benar: {
		milik protokol := protokol + ['://'].
	}, palsu: {
		tugas-ini ralat: ['Invalid protocol'].
	}.
}.

URL apabila: ['hos:'] lakukan: { :hos
	#todo validate according to rfc
	milik hos := hos.
}.

URL apabila: ['laluan:'] lakukan: { :laluan
	milik laluan := ['/'] + laluan url-kodkan.
}.

URL apabila: ['parameter-url:'] lakukan: { :pemetaan
	>> parameter-url := Senarai baharu.
	pemetaan setiap: { :kunci-pengepala :nilai
		parameter-url tambah-di-hujung: kunci-pengepala teks url-kodkan + ['='] + nilai teks url-kodkan.
	}.
	milik parameter-url := ['?'] + ( parameter-url gabungkan: ['&'] ).
}.

URL apabila: ['cincang:'] lakukan: { :hash
	milik hash := ['#'] + hash url-kodkan.
}.

