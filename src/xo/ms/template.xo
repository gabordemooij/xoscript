
# ~ Simple template engine ~

>> Templat := Objek baharu.

Templat apabila: ['baharu'] lakukan: { <- diri baharu kandungan: [''].
}.

Templat apabila: ['kandungan:'] lakukan: { :kandungan
	milik kandungan := kandungan. 
}.

Templat apabila: ['baharu:'] lakukan: { :kandungan <- diri baharu kandungan: kandungan.
}.

Templat apabila: ['potong:'] lakukan: { :penanda
	>> penanda-mula := (['<!-- cut:%id% -->'] %id%: penanda).
	>> penanda-akhir := (['<!-- /cut:%id% -->'] %id%: penanda).
	>> bahagian-bahagian := milik kandungan pisahkan: penanda-mula.
	>> awalan := bahagian-bahagian pertama.
	>> bahagian-bahagian2 := bahagian-bahagian terakhir pisahkan: penanda-akhir.
	>> akhiran := bahagian-bahagian2 terakhir.
	>> bahagian := bahagian-bahagian2 pertama.
	>> baki := awalan + akhiran.
	milik kandungan := baki. <- Templat baharu: bahagian.
	
}.

Templat apabila: ['salin'] lakukan: { <- diri baharu: diri teks salin.
}.
	
Templat apabila: ['tampal:di:'] lakukan: { :petikan :id
	>> penanda-tampal := (['<!-- paste:%id% -->'] %id%: id).
	milik kandungan ganti: penanda-tampal dengan: ( petikan teks + penanda-tampal ).
}.

Templat apabila: ['tetapkan:nilai:'] lakukan: { :slot :nilai
	milik kandungan ganti: ['<!-- slot:'] + slot + [' -->'] dengan: ( Server html-kodkan: nilai ).
}.

Templat apabila: ['tetapkan:html:'] lakukan: { :slot :html
	milik kandungan ganti: ['<!-- slot:'] + slot + [' -->'] dengan: html.
}.

Templat apabila: ['balas:dan:'] lakukan: { :slot :nilai
	diri tetapkan: (slot dari: 0 panjang: (slot panjang - 1)) nilai: nilai.
}.

Templat apabila: ['nl2br'] lakukan: {
	milik kandungan ganti: ['\n'] dengan: ['<br>'].
}.

Templat apabila: ['rapikan'] lakukan: {
	milik kandungan :=
		Corak
		baharu: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		padan: milik kandungan
		lakukan: { <- ['']. }.
}.

Templat apabila: ['rapikan-potongan'] lakukan: {
	>> item := Senarai baharu.
	Corak
	baharu: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	padan: milik kandungan
	lakukan: { :_ :bahagian
		item tambah-di-hujung: bahagian ? 1.
	}.
	item setiap: { :_ :id
		milik kandungan :=
			Corak baharu: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			padan: milik kandungan
			lakukan: { <- ['']. }.
	 }.
}.

Templat apabila: ['rapikan-ruang'] lakukan: {
	milik kandungan :=
		Corak
		baharu: ['\\s*\\n'],
		padan: milik kandungan
		lakukan: { <- ['\n']. }.
	milik kandungan :=
		Corak
		baharu: ['\\n[\\s\\t]+'],
		padan: milik kandungan
		lakukan: { <- ['\n']. }.
}.

Templat apabila: ['rapikan-semua'] lakukan: {
	diri rapikan.
	diri rapikan-potongan.
	diri rapikan-ruang.
}.

Templat apabila: ['teks'] lakukan: { <- milik kandungan.
}.
