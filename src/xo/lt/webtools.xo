HTTP-Užklausa kai: ['HTTP-antraštė:'] daryti: { :raktas <- Programa nustatymas: raktas.
}.

>> HTTP-Antraštė := Objektas naujas.

HTTP-Antraštė kai: ['naujas'] daryti: { <- pats naujas inicijuoti.
}.

HTTP-Antraštė kai: ['inicijuoti'] daryti: {
	savas raktas := Niekas.
	savas reikšmė := Niekas.
}.

HTTP-Antraštė kai: ['raktas:reikšmė:'] daryti: { :raktas :reikšmė
	savas raktas := raktas.
	savas reikšmė := reikšmė.
}.

HTTP-Antraštė kai: ['raktas'] daryti: { <- savas raktas.
}.

HTTP-Antraštė kai: ['reikšmė'] daryti: { <- savas reikšmė.
}.


HTTP-Antraštė kai: ['tekstas'] daryti: {
	>> eilutė := savas raktas + [': '] + savas reikšmė.
	eilutė pakeisti: ['\r'] į: [''], pakeisti: ['\n'] į: ['']. <- eilutė + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Žiniatinklio-dokumentas := Objektas naujas.

Žiniatinklio-dokumentas kai: ['naujas'] daryti: { <- pats naujas inicijuoti.
}.

Žiniatinklio-dokumentas kai: ['inicijuoti'] daryti: {
	savas antraštės := Sąrašas naujas.
	savas seanso-id := Niekas.
	savas seansų-tvarkytuvas := Laikinojo-failo-seansas naujas.
	savas seanso-duomenys := Niekas.
	savas saugus := Tiesa.
	savas ta-pati-svetainė := ['Strict'].
	savas antraštės-išsiųstos := Netiesa.
	savas http-užklausa := HTTP-Užklausa naujas.
}.

Žiniatinklio-dokumentas kai: ['http-užklausa:'] daryti: { :http-užklausa
	savas http-užklausa := http-užklausa.
}. 

Žiniatinklio-dokumentas kai: ['saugus-seanso-slapukas:'] daryti: { :saugus
	pats tikrinti-antraštes.
	savas saugus := saugus.
}.

Žiniatinklio-dokumentas kai: ['seanso-slapukas-ta-pati-svetainė:'] daryti: { :reikšmė
	pats tikrinti-antraštes.
	>> parinktys := Sąrašas naujas 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	parinktys turi: reikšmė, netiesa: {
		ši-užduotis klaida: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	savas ta-pati-svetainė := reikšmė.
}.

Žiniatinklio-dokumentas kai: ['antraštė:'] daryti: { :antraštė
	pats tikrinti-antraštes.
	savas antraštės pridėti: antraštė.
}.

Žiniatinklio-dokumentas kai: ['išvalyti-antraštes'] daryti: {
	pats tikrinti-antraštes.
	savas antraštės := Sąrašas naujas.
}.

Žiniatinklio-dokumentas kai: ['seansų-tvarkytuvas:'] daryti: { :tvarkytuvas
	pats tikrinti-antraštes.
	savas seansų-tvarkytuvas := tvarkytuvas.
}.

Žiniatinklio-dokumentas kai: ['seansų-tvarkytuvas'] daryti: { <- savas seansų-tvarkytuvas.
}.

Žiniatinklio-dokumentas kai: ['tikrinti-antraštes'] daryti: {
	savas antraštės-išsiųstos tiesa: {
		ši-užduotis klaida: ['Headers already sent to client.'].
	}.
}.

Žiniatinklio-dokumentas kai: ['pradėti-seansą'] daryti: {
	pats tikrinti-antraštes.
	>> http-užklausa := savas http-užklausa.
	>> seanso-id := http-užklausa cookie: ['xsid'].
	seanso-id Niekas? netiesa: {
		(( Šablonas naujas: ['^[A-Za-z0-9]+\\z'], atitikmuo: seanso-id ) = 0) tiesa: {
			seanso-id := Niekas.
		}.
	}.
	seanso-id Niekas? tiesa: {
		seanso-id := Seifas žetonas: 30.
		>> seanso-antraštė := HTTP-Antraštė naujas
		raktas: ['Set-Cookie'] reikšmė: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (savas saugus arba: ['Secure'] arba: ['']),
		SSITE: (savas ta-pati-svetainė),
		XSID: seanso-id
		).
		savas antraštės pridėti: seanso-antraštė.
	}.
	savas seanso-duomenys := savas seansų-tvarkytuvas skirta: seanso-id, įkelti. <- savas seanso-duomenys. # reference
}.

Žiniatinklio-dokumentas kai: ['eiti-į:'] daryti: { :adresas
	pats tikrinti-antraštes.
	pats išvalyti-antraštes.
	savas antraštės
	pridėti: (
		HTTP-Antraštė naujas
		raktas: ['Status'] reikšmė: ['303 See Other']
	),
	pridėti: (
		HTTP-Antraštė naujas
		raktas: ['Location'] reikšmė: adresas
	).
	pats išvesti: ['Redirect'].
}.

Žiniatinklio-dokumentas kai: ['sunaikinti-seansą'] daryti: {
	pats tikrinti-antraštes.
	>> http-užklausa := savas http-užklausa.
	>> seanso-id := http-užklausa cookie: ['xsid'].
	seanso-id Niekas? netiesa: {
		>> seanso-antraštė := HTTP-Antraštė naujas.
		>> momentas := Momentas naujas metai: 1970, formatas: ['%a, %d %b %Y %H:%M:%S GMT'].
		seanso-antraštė raktas: ['Set-Cookie'] reikšmė: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: momentas,
			SEC: (savas saugus arba: ['Secure'] arba: ['']),
			SSITE: (savas ta-pati-svetainė),
			XSID: seanso-id
		).
		savas seansų-tvarkytuvas sunaikinti.
		savas antraštės pridėti: seanso-antraštė.
	}.
}.


Žiniatinklio-dokumentas kai: ['maketas:'] daryti: { :kelias <- Maketas naujas: (Failas naujas: kelias, skaityti).
}.

Žiniatinklio-dokumentas kai: ['išvesti:tipas:'] daryti: { :išvestis :tipas
	savas antraštės-išsiųstos netiesa: {
		savas seanso-duomenys Niekas? netiesa: {
			savas seansų-tvarkytuvas išsaugoti: savas seanso-duomenys.
		}.
		savas antraštės pridėti: (
			HTTP-Antraštė naujas
			raktas: ['Content-type'] reikšmė: tipas
		).
		savas antraštės kiekvienas: { :_ :antraštė
			Išvestis rašyti: antraštė.
		}.
		savas antraštės-išsiųstos := Tiesa.
		Išvestis rašyti: ['\r\n'].
	}.
	Išvestis rašyti: išvestis.
}.

Žiniatinklio-dokumentas kai: ['užbaigti:tipas:'] daryti: { :išvestis :tipas
	savas antraštės-išsiųstos netiesa: {
		savas seanso-duomenys Niekas? netiesa: {
			savas seansų-tvarkytuvas išsaugoti: savas seanso-duomenys.
		}.
		savas antraštės pridėti: (
			HTTP-Antraštė naujas
			raktas: ['Content-type'] reikšmė: tipas
		).
		savas antraštės pridėti: (
			HTTP-Antraštė naujas
			raktas: ['Content-Length'] reikšmė: išvestis tekstas bytes
		).
		savas antraštės kiekvienas: { :_ :antraštė
			Išvestis rašyti: antraštė.
		}.
		savas antraštės-išsiųstos := Tiesa.
		Išvestis rašyti: ['\r\n'].
	}.
	Išvestis rašyti: išvestis.
}.

Žiniatinklio-dokumentas kai: ['išvesti:'] daryti: { :išvestis
	pats išvesti: išvestis tipas: ['text/html; charset=utf-8'].
}.

Žiniatinklio-dokumentas kai: ['užbaigti:'] daryti: { :išvestis
	pats užbaigti: išvestis tipas: ['text/html; charset=utf-8'].
}.

Žiniatinklio-dokumentas kai: ['json:'] daryti: { :išvestis
	pats išvesti: ( JSON jsonify: išvestis ) tipas: ['application/json'].
}.

Žiniatinklio-dokumentas kai: ['nerasta:'] daryti: { :išvestis
	pats išvalyti-antraštes antraštė: (
		HTTP-Antraštė naujas raktas: ['Status'] reikšmė: ['404 Not Found']
	).
	pats išvesti: išvestis.
}.


# Interface

>> Seansas := Objektas naujas.

Seansas kai: ['naujas'] daryti: { <- pats naujas inicijuoti skirta: Niekas.
}.

Seansas kai: ['skirta:'] daryti: { :id
	savas id := id.
}.

Seansas kai: ['įkelti'] daryti: {
	ši-užduotis klaida: ['Not implemented.'].
}.

Seansas kai: ['išsaugoti:'] daryti: {
	ši-užduotis klaida: ['Not implemented.'].
}.

Seansas kai: ['sunaikinti'] daryti: {
	ši-užduotis klaida: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Laikinojo-failo-seansas := Seansas naujas.

Laikinojo-failo-seansas kai: ['inicijuoti'] daryti: {
	savas kelio-pradžia := ['/tmp/sess-'].
}.

Laikinojo-failo-seansas kai: ['kelio-priešdėlis:'] daryti: { :simbolių-eilutė
	savas kelio-pradžia := simbolių-eilutė.
}.

Laikinojo-failo-seansas kai: ['failas'] daryti: { <- ( Failas naujas: ( savas kelio-pradžia + savas id + ['.txt'] ) ).
}.

Laikinojo-failo-seansas kai: ['įkelti'] daryti: {
	>> failas := pats failas.
	failas egzistuoja netiesa: {
		failas rašyti: (Žodynas naujas kodas).
	}. <- failas skaityti objektas.
}.

Laikinojo-failo-seansas kai: ['išsaugoti:'] daryti: { :duomenys
	>> failas := pats failas.
	failas egzistuoja tiesa: {
		failas rašyti: duomenys kodas.
	}.
}.

Laikinojo-failo-seansas kai: ['sunaikinti'] daryti: {
	>> failas := pats failas.
	failas egzistuoja tiesa: {
		failas ištrinti.
	}.
}.


>> URL := Objektas naujas.

URL kai: ['inicijuoti'] daryti: {
	savas protokolas := ['https://'].
	savas mazgas := ['localhost'].
	savas kelias := [''].
	savas url-parametrai := [''].
	savas hash := [''].
}.

URL kai: ['naujas'] daryti: { <- pats naujas inicijuoti.
}.

URL kai: ['tekstas'] daryti: { <- (
	savas protokolas +
	savas mazgas +
	savas kelias +
	savas url-parametrai +
	savas hash ).
}.

URL kai: ['protokolas:'] daryti: { :protokolas
	((Sąrašas naujas ; ['http'] ; ['https']) turi: protokolas) tiesa: {
		savas protokolas := protokolas + ['://'].
	}, netiesa: {
		ši-užduotis klaida: ['Invalid protocol'].
	}.
}.

URL kai: ['mazgas:'] daryti: { :mazgas
	#todo validate according to rfc
	savas mazgas := mazgas.
}.

URL kai: ['kelias:'] daryti: { :kelias
	savas kelias := ['/'] + kelias url-koduoti.
}.

URL kai: ['url-parametrai:'] daryti: { :atvaizdis
	>> url-parametrai := Sąrašas naujas.
	atvaizdis kiekvienas: { :raktas :reikšmė
		url-parametrai pridėti: raktas tekstas url-koduoti + ['='] + reikšmė tekstas url-koduoti.
	}.
	savas url-parametrai := ['?'] + ( url-parametrai sujungti: ['&'] ).
}.

URL kai: ['maiša:'] daryti: { :hash
	savas hash := ['#'] + hash url-koduoti.
}.

