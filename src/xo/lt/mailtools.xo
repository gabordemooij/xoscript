>> El-laiškas := Objektas naujas.

El-laiškas kai: ['inicijuoti'] daryti: {
	savas gavėjai := Sąrašas naujas.
	savas cc := Sąrašas naujas.
	savas bcc := Sąrašas naujas.
	savas siuntėjas := Niekas.
	savas siuntėjo-vardas := Niekas.
	savas tema := Niekas.
	savas laiško-tekstas := Niekas.
}.

El-laiškas kai: ['naujas'] daryti: { <- pats naujas inicijuoti.
}.

El-laiškas kai: ['kam:'] daryti: { :išvardijimas
	savas gavėjai := išvardijimas.
}.
 
El-laiškas kai: ['cc:'] daryti: { :išvardijimas
	savas cc := išvardijimas.
}.

El-laiškas kai: ['bcc:'] daryti: { :išvardijimas
	savas bcc := išvardijimas.
}.

El-laiškas kai: ['tema:'] daryti: { :tema
	savas tema := tema.
}.

El-laiškas kai: ['siuntėjas:pavadinimas:'] daryti: { :siuntėjas :pavadinimas
	savas siuntėjas := siuntėjas.
	savas siuntėjo-vardas := pavadinimas.
}.

El-laiškas kai: ['laiško-tekstas:'] daryti: { :laiško-tekstas
	savas laiško-tekstas := laiško-tekstas.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
El-laiškas kai: ['antraštė:'] daryti: { :eilutė <- eilutė pakeisti: ['\r'] į: [''], pakeisti: ['\n'] į: [''].
}.

El-laiškas kai: ['siųsti'] daryti: {
	>> f := Failas tempwrite: pats generuoti.
	Programa sistema: ['sendmail -t < '] + f kelias, nauja-eilutė.
}.

El-laiškas kai: ['generuoti'] daryti: {
	>> eilutės-lūžis := ['\r\n'].
	>> simbolių-eilutė := [''].
	simbolių-eilutė pridėti: (pats antraštė: ['From: '] + savas siuntėjo-vardas + [' <'] + ( savas siuntėjas ) + ['>']) + eilutės-lūžis.
	simbolių-eilutė pridėti: (pats antraštė: ['To: '] + ( savas gavėjai sujungti: [','] )) + eilutės-lūžis.
	savas cc kiekis tiesa: {
		simbolių-eilutė pridėti: (pats antraštė: ['Cc: '] + ( savas cc sujungti: [','] )) + eilutės-lūžis.
	}.
	savas bcc kiekis tiesa: {
		simbolių-eilutė pridėti: (pats antraštė: ['Bcc: '] + ( savas bcc sujungti: [','] )) + eilutės-lūžis.
	}.
	simbolių-eilutė pridėti: (pats antraštė: ['Subject: '] + savas tema) + eilutės-lūžis.
	simbolių-eilutė pridėti: eilutės-lūžis.
	simbolių-eilutė pridėti: savas laiško-tekstas.
	simbolių-eilutė pridėti: eilutės-lūžis. <- simbolių-eilutė.
}.

>> HTML-El-laiškas := El-laiškas naujas.

HTML-El-laiškas kai: ['inicijuoti'] daryti: {
	pats inicijuoti.
	savas priedai := Sąrašas naujas.
	savas riba := Seifas žetonas: 40.
}.

HTML-El-laiškas kai: ['pridėti-priedą:'] daryti: { :failas
	>> id := savas priedai kiekis.
	>> blob := failas blob.
	savas priedai pridėti: (
		Žodynas naujas
			failas: failas kelias,
			mime: ['image/'] + (Server mimetype: failas kelias),
			duomenys: blob base64-koduoti
	).
	blob atlaisvinti. <- ['cid:attachment'] + id.
}.

HTML-El-laiškas kai: ['generuoti'] daryti: {
	>> eilutės-lūžis := ['\r\n'].
	>> simbolių-eilutė := [''].
	simbolių-eilutė pridėti: (pats antraštė: ['From: '] + savas siuntėjo-vardas + [' <'] + ( savas siuntėjas ) + ['>']) + eilutės-lūžis.
	simbolių-eilutė pridėti: (pats antraštė: ['To: '] + ( savas gavėjai sujungti: [','] )) + eilutės-lūžis.
	savas cc kiekis tiesa: {
		simbolių-eilutė pridėti: (pats antraštė: ['Cc: '] + ( savas cc sujungti: [','] )) + eilutės-lūžis.
	}.
	savas bcc kiekis tiesa: {
		simbolių-eilutė pridėti: (pats antraštė: ['Bcc: '] + ( savas bcc sujungti: [','] )) + eilutės-lūžis.
	}.
	simbolių-eilutė pridėti: (pats antraštė: ['Subject: '] + savas tema) + eilutės-lūžis.
	simbolių-eilutė pridėti: ['MIME-Version: 1.0'] + eilutės-lūžis.
	simbolių-eilutė pridėti: ['Content-Type: multipart/related; boundary="'] + savas riba + ['"; type=text/html'] + eilutės-lūžis.
	simbolių-eilutė pridėti: eilutės-lūžis.
	simbolių-eilutė pridėti: ['--'] + savas riba + eilutės-lūžis.
	simbolių-eilutė pridėti: ['Content-Type: text/html; charset=UTF-8'] + eilutės-lūžis.
	simbolių-eilutė pridėti: ['Content-Transfer-Encoding: 7bit'] + eilutės-lūžis.
	simbolių-eilutė pridėti: eilutės-lūžis.
	simbolių-eilutė pridėti: savas laiško-tekstas.
	simbolių-eilutė pridėti: eilutės-lūžis.
	savas priedai kiekvienas: { :id :info
		>> blob := info duomenys.
		simbolių-eilutė pridėti: ['--'] + savas riba + eilutės-lūžis.
		simbolių-eilutė pridėti: ['Content-Type: '] + info mime + eilutės-lūžis.
		simbolių-eilutė pridėti: ['Content-Transfer-Encoding: base64'] + eilutės-lūžis.
		simbolių-eilutė pridėti: ['Content-ID: <attachment'] + id + ['>'] + eilutės-lūžis.
		simbolių-eilutė pridėti: ['Content-Disposition: inline; filename="'] + info failas + ['"'] + eilutės-lūžis.
		simbolių-eilutė pridėti: eilutės-lūžis.
		>> daugiausia := 76.
		>> teksto-ilgis := blob ilgis.
		>> gabalai := (teksto-ilgis / daugiausia) apvalinti-aukštyn.
		{ :i
			>> gabalas := blob kopijuoti nuo: i * daugiausia ilgis: daugiausia.
			simbolių-eilutė pridėti: gabalas + eilutės-lūžis.
		} * gabalai.
		simbolių-eilutė pridėti: eilutės-lūžis.
		simbolių-eilutė pridėti: eilutės-lūžis.
	}.
	simbolių-eilutė pridėti: ['--'] + savas riba + ['--'] + eilutės-lūžis. <- simbolių-eilutė.
}.
