
# ~ Simple template engine ~

>> Maketas := Objektas naujas.

Maketas kai: ['naujas'] daryti: { <- pats naujas turinys: [''].
}.

Maketas kai: ['turinys:'] daryti: { :turinys
	savas turinys := turinys. 
}.

Maketas kai: ['naujas:'] daryti: { :turinys <- pats naujas turinys: turinys.
}.

Maketas kai: ['iškirpti:'] daryti: { :žymė
	>> pradžios-žymė := (['<!-- cut:%id% -->'] %id%: žymė).
	>> pabaigos-žymė := (['<!-- /cut:%id% -->'] %id%: žymė).
	>> dalys := savas turinys padalinti: pradžios-žymė.
	>> priešdėlis := dalys pirmas.
	>> dalys2 := dalys paskutinis padalinti: pabaigos-žymė.
	>> priesaga := dalys2 paskutinis.
	>> dalis := dalys2 pirmas.
	>> likutis := priešdėlis + priesaga.
	savas turinys := likutis. <- Maketas naujas: dalis.
	
}.

Maketas kai: ['kopijuoti'] daryti: { <- pats naujas: pats tekstas kopijuoti.
}.
	
Maketas kai: ['įklijuoti:į:'] daryti: { :ištrauka :id
	>> įklijavimo-žymė := (['<!-- paste:%id% -->'] %id%: id).
	savas turinys pakeisti: įklijavimo-žymė į: ( ištrauka tekstas + įklijavimo-žymė ).
}.

Maketas kai: ['nustatyti:reikšmė:'] daryti: { :vieta :reikšmė
	savas turinys pakeisti: ['<!-- slot:'] + vieta + [' -->'] į: ( Server html-koduoti: reikšmė ).
}.

Maketas kai: ['nustatyti:html:'] daryti: { :vieta :html
	savas turinys pakeisti: ['<!-- slot:'] + vieta + [' -->'] į: html.
}.

Maketas kai: ['atsakyti:ir:'] daryti: { :vieta :reikšmė
	pats nustatyti: (vieta nuo: 0 ilgis: (vieta ilgis - 1)) reikšmė: reikšmė.
}.

Maketas kai: ['nl2br'] daryti: {
	savas turinys pakeisti: ['\n'] į: ['<br>'].
}.

Maketas kai: ['tvarkyti'] daryti: {
	savas turinys :=
		Šablonas
		naujas: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		atitikmuo: savas turinys
		daryti: { <- ['']. }.
}.

Maketas kai: ['tvarkyti-iškarpas'] daryti: {
	>> elementai := Sąrašas naujas.
	Šablonas
	naujas: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	atitikmuo: savas turinys
	daryti: { :_ :dalis
		elementai pridėti: dalis ? 1.
	}.
	elementai kiekvienas: { :_ :id
		savas turinys :=
			Šablonas naujas: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			atitikmuo: savas turinys
			daryti: { <- ['']. }.
	 }.
}.

Maketas kai: ['tvarkyti-tarpus'] daryti: {
	savas turinys :=
		Šablonas
		naujas: ['\\s*\\n'],
		atitikmuo: savas turinys
		daryti: { <- ['\n']. }.
	savas turinys :=
		Šablonas
		naujas: ['\\n[\\s\\t]+'],
		atitikmuo: savas turinys
		daryti: { <- ['\n']. }.
}.

Maketas kai: ['tvarkyti-viską'] daryti: {
	pats tvarkyti.
	pats tvarkyti-iškarpas.
	pats tvarkyti-tarpus.
}.

Maketas kai: ['tekstas'] daryti: { <- savas turinys.
}.
