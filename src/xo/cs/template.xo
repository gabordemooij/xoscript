
# ~ Simple template engine ~

>> Šablona := Objekt nový.

Šablona při: ['nový'] udělat: { <- sebe nový obsah: [''].
}.

Šablona při: ['obsah:'] udělat: { :obsah
	vlastní obsah := obsah. 
}.

Šablona při: ['nový:'] udělat: { :obsah <- sebe nový obsah: obsah.
}.

Šablona při: ['vyříznout:'] udělat: { :značka
	>> počáteční-značka := (['<!-- cut:%id% -->'] %id%: značka).
	>> koncová-značka := (['<!-- /cut:%id% -->'] %id%: značka).
	>> části := vlastní obsah rozdělit: počáteční-značka.
	>> předpona := části první.
	>> části2 := části poslední rozdělit: koncová-značka.
	>> přípona := části2 poslední.
	>> část := části2 první.
	>> zbytek := předpona + přípona.
	vlastní obsah := zbytek. <- Šablona nový: část.
	
}.

Šablona při: ['kopírovat'] udělat: { <- sebe nový: sebe řetězec kopírovat.
}.
	
Šablona při: ['vložit:na:'] udělat: { :úryvek :id
	>> vkládací-značka := (['<!-- paste:%id% -->'] %id%: id).
	vlastní obsah nahradit: vkládací-značka za: ( úryvek řetězec + vkládací-značka ).
}.

Šablona při: ['nastavit:na:'] udělat: { :slot :hodnota
	vlastní obsah nahradit: ['<!-- slot:'] + slot + [' -->'] za: ( Server html-kódovat: hodnota ).
}.

Šablona při: ['nastavit:html:'] udělat: { :slot :html
	vlastní obsah nahradit: ['<!-- slot:'] + slot + [' -->'] za: html.
}.

Šablona při: ['odpovědět:a:'] udělat: { :slot :hodnota
	sebe nastavit: (slot od: 0 délka: (slot délka - 1)) na: hodnota.
}.

Šablona při: ['nl2br'] udělat: {
	vlastní obsah nahradit: ['\n'] za: ['<br>'].
}.

Šablona při: ['uklidit'] udělat: {
	vlastní obsah :=
		Vzor
		nový: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		shoda: vlastní obsah
		udělat: { <- ['']. }.
}.

Šablona při: ['uklidit-výřezy'] udělat: {
	>> položky := Seznam nový.
	Vzor
	nový: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	shoda: vlastní obsah
	udělat: { :_ :část
		položky připojit: část ? 1.
	}.
	položky každý: { :_ :id
		vlastní obsah :=
			Vzor nový: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			shoda: vlastní obsah
			udělat: { <- ['']. }.
	 }.
}.

Šablona při: ['uklidit-mezery'] udělat: {
	vlastní obsah :=
		Vzor
		nový: ['\\s*\\n'],
		shoda: vlastní obsah
		udělat: { <- ['\n']. }.
	vlastní obsah :=
		Vzor
		nový: ['\\n[\\s\\t]+'],
		shoda: vlastní obsah
		udělat: { <- ['\n']. }.
}.

Šablona při: ['uklidit-vše'] udělat: {
	sebe uklidit.
	sebe uklidit-výřezy.
	sebe uklidit-mezery.
}.

Šablona při: ['řetězec'] udělat: { <- vlastní obsah.
}.
