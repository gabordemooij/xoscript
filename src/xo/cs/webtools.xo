HTTP-Požadavek při: ['HTTP-hlavička:'] udělat: { :klíč <- Program nastavení: klíč.
}.

>> HTTP-Hlavička := Objekt nový.

HTTP-Hlavička při: ['nový'] udělat: { <- sebe nový inicializovat.
}.

HTTP-Hlavička při: ['inicializovat'] udělat: {
	vlastní klíč := Nic.
	vlastní hodnota := Nic.
}.

HTTP-Hlavička při: ['klíč:hodnota:'] udělat: { :klíč :hodnota
	vlastní klíč := klíč.
	vlastní hodnota := hodnota.
}.

HTTP-Hlavička při: ['klíč'] udělat: { <- vlastní klíč.
}.

HTTP-Hlavička při: ['hodnota'] udělat: { <- vlastní hodnota.
}.


HTTP-Hlavička při: ['řetězec'] udělat: {
	>> řádek := vlastní klíč + [': '] + vlastní hodnota.
	řádek nahradit: ['\r'] za: [''], nahradit: ['\n'] za: ['']. <- řádek + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webový-dokument := Objekt nový.

Webový-dokument při: ['nový'] udělat: { <- sebe nový inicializovat.
}.

Webový-dokument při: ['inicializovat'] udělat: {
	vlastní hlavičky := Seznam nový.
	vlastní id-relace := Nic.
	vlastní správce-relací := Relace-dočasný-soubor nový.
	vlastní data-relace := Nic.
	vlastní zabezpečeno := Pravda.
	vlastní stejný-web := ['Strict'].
	vlastní hlavičky-odeslány := Nepravda.
	vlastní požadavek := HTTP-Požadavek nový.
}.

Webový-dokument při: ['požadavek:'] udělat: { :požadavek
	vlastní požadavek := požadavek.
}. 

Webový-dokument při: ['zabezpečená-relační-cookie:'] udělat: { :zabezpečeno
	sebe zkontrolovat-hlavičky.
	vlastní zabezpečeno := zabezpečeno.
}.

Webový-dokument při: ['relační-cookie-stejný-web:'] udělat: { :hodnota
	sebe zkontrolovat-hlavičky.
	>> volby := Seznam nový 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	volby má: hodnota, nepravda: {
		tato-úloha chyba: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	vlastní stejný-web := hodnota.
}.

Webový-dokument při: ['hlavička:'] udělat: { :hlavička
	sebe zkontrolovat-hlavičky.
	vlastní hlavičky připojit: hlavička.
}.

Webový-dokument při: ['vymazat-hlavičky'] udělat: {
	sebe zkontrolovat-hlavičky.
	vlastní hlavičky := Seznam nový.
}.

Webový-dokument při: ['správce-relací:'] udělat: { :správce
	sebe zkontrolovat-hlavičky.
	vlastní správce-relací := správce.
}.

Webový-dokument při: ['správce-relací'] udělat: { <- vlastní správce-relací.
}.

Webový-dokument při: ['zkontrolovat-hlavičky'] udělat: {
	vlastní hlavičky-odeslány pravda: {
		tato-úloha chyba: ['Headers already sent to client.'].
	}.
}.

Webový-dokument při: ['zahájit-relaci'] udělat: {
	sebe zkontrolovat-hlavičky.
	>> požadavek := vlastní požadavek.
	>> id-relace := požadavek cookie: ['xsid'].
	id-relace Nic? nepravda: {
		(( Vzor nový: ['^[A-Za-z0-9]+\\z'], shoda: id-relace ) = 0) pravda: {
			id-relace := Nic.
		}.
	}.
	id-relace Nic? pravda: {
		id-relace := Trezor token: 30.
		>> hlavička-relace := HTTP-Hlavička nový
		klíč: ['Set-Cookie'] hodnota: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (vlastní zabezpečeno buď: ['Secure'] nebo: ['']),
		SSITE: (vlastní stejný-web),
		XSID: id-relace
		).
		vlastní hlavičky připojit: hlavička-relace.
	}.
	vlastní data-relace := vlastní správce-relací pro: id-relace, načíst. <- vlastní data-relace. # reference
}.

Webový-dokument při: ['přejít-na:'] udělat: { :adresa
	sebe zkontrolovat-hlavičky.
	sebe vymazat-hlavičky.
	vlastní hlavičky
	připojit: (
		HTTP-Hlavička nový
		klíč: ['Status'] hodnota: ['303 See Other']
	),
	připojit: (
		HTTP-Hlavička nový
		klíč: ['Location'] hodnota: adresa
	).
	sebe vypsat: ['Redirect'].
}.

Webový-dokument při: ['zničit-relaci'] udělat: {
	sebe zkontrolovat-hlavičky.
	>> požadavek := vlastní požadavek.
	>> id-relace := požadavek cookie: ['xsid'].
	id-relace Nic? nepravda: {
		>> hlavička-relace := HTTP-Hlavička nový.
		>> okamžik := Okamžik nový rok: 1970, formát: ['%a, %d %b %Y %H:%M:%S GMT'].
		hlavička-relace klíč: ['Set-Cookie'] hodnota: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: okamžik,
			SEC: (vlastní zabezpečeno buď: ['Secure'] nebo: ['']),
			SSITE: (vlastní stejný-web),
			XSID: id-relace
		).
		vlastní správce-relací zničit.
		vlastní hlavičky připojit: hlavička-relace.
	}.
}.


Webový-dokument při: ['šablona:'] udělat: { :cesta <- Šablona nový: (Soubor nový: cesta, číst).
}.

Webový-dokument při: ['vypsat:typ:'] udělat: { :výstup :typ
	vlastní hlavičky-odeslány nepravda: {
		vlastní data-relace Nic? nepravda: {
			vlastní správce-relací uložit: vlastní data-relace.
		}.
		vlastní hlavičky připojit: (
			HTTP-Hlavička nový
			klíč: ['Content-type'] hodnota: typ
		).
		vlastní hlavičky každý: { :_ :hlavička
			Výstup psát: hlavička.
		}.
		vlastní hlavičky-odeslány := Pravda.
		Výstup psát: ['\r\n'].
	}.
	Výstup psát: výstup.
}.

Webový-dokument při: ['dokončit:typ:'] udělat: { :výstup :typ
	vlastní hlavičky-odeslány nepravda: {
		vlastní data-relace Nic? nepravda: {
			vlastní správce-relací uložit: vlastní data-relace.
		}.
		vlastní hlavičky připojit: (
			HTTP-Hlavička nový
			klíč: ['Content-type'] hodnota: typ
		).
		vlastní hlavičky připojit: (
			HTTP-Hlavička nový
			klíč: ['Content-Length'] hodnota: výstup řetězec bytes
		).
		vlastní hlavičky každý: { :_ :hlavička
			Výstup psát: hlavička.
		}.
		vlastní hlavičky-odeslány := Pravda.
		Výstup psát: ['\r\n'].
	}.
	Výstup psát: výstup.
}.

Webový-dokument při: ['vypsat:'] udělat: { :výstup
	sebe vypsat: výstup typ: ['text/html; charset=utf-8'].
}.

Webový-dokument při: ['dokončit:'] udělat: { :výstup
	sebe dokončit: výstup typ: ['text/html; charset=utf-8'].
}.

Webový-dokument při: ['json:'] udělat: { :výstup
	sebe vypsat: ( JSON jsonify: výstup ) typ: ['application/json'].
}.

Webový-dokument při: ['nenalezeno:'] udělat: { :výstup
	sebe vymazat-hlavičky hlavička: (
		HTTP-Hlavička nový klíč: ['Status'] hodnota: ['404 Not Found']
	).
	sebe vypsat: výstup.
}.


# Interface

>> Relace := Objekt nový.

Relace při: ['nový'] udělat: { <- sebe nový inicializovat pro: Nic.
}.

Relace při: ['pro:'] udělat: { :id
	vlastní id := id.
}.

Relace při: ['načíst'] udělat: {
	tato-úloha chyba: ['Not implemented.'].
}.

Relace při: ['uložit:'] udělat: {
	tato-úloha chyba: ['Not implemented.'].
}.

Relace při: ['zničit'] udělat: {
	tato-úloha chyba: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Relace-dočasný-soubor := Relace nový.

Relace-dočasný-soubor při: ['inicializovat'] udělat: {
	vlastní začátek-cesty := ['/tmp/sess-'].
}.

Relace-dočasný-soubor při: ['předpona-cesty:'] udělat: { :textový-řetězec
	vlastní začátek-cesty := textový-řetězec.
}.

Relace-dočasný-soubor při: ['soubor'] udělat: { <- ( Soubor nový: ( vlastní začátek-cesty + vlastní id + ['.txt'] ) ).
}.

Relace-dočasný-soubor při: ['načíst'] udělat: {
	>> soubor := sebe soubor.
	soubor existuje nepravda: {
		soubor psát: (Slovník nový kód).
	}. <- soubor číst objekt.
}.

Relace-dočasný-soubor při: ['uložit:'] udělat: { :data
	>> soubor := sebe soubor.
	soubor existuje pravda: {
		soubor psát: data kód.
	}.
}.

Relace-dočasný-soubor při: ['zničit'] udělat: {
	>> soubor := sebe soubor.
	soubor existuje pravda: {
		soubor smazat.
	}.
}.


>> URL := Objekt nový.

URL při: ['inicializovat'] udělat: {
	vlastní protokol := ['https://'].
	vlastní hostitel := ['localhost'].
	vlastní cesta := [''].
	vlastní url-parametry := [''].
	vlastní hash := [''].
}.

URL při: ['nový'] udělat: { <- sebe nový inicializovat.
}.

URL při: ['řetězec'] udělat: { <- (
	vlastní protokol +
	vlastní hostitel +
	vlastní cesta +
	vlastní url-parametry +
	vlastní hash ).
}.

URL při: ['protokol:'] udělat: { :protokol
	((Seznam nový ; ['http'] ; ['https']) má: protokol) pravda: {
		vlastní protokol := protokol + ['://'].
	}, nepravda: {
		tato-úloha chyba: ['Invalid protocol'].
	}.
}.

URL při: ['hostitel:'] udělat: { :hostitel
	#todo validate according to rfc
	vlastní hostitel := hostitel.
}.

URL při: ['cesta:'] udělat: { :cesta
	vlastní cesta := ['/'] + cesta url-kódovat.
}.

URL při: ['url-parametry:'] udělat: { :mapování
	>> url-parametry := Seznam nový.
	mapování každý: { :klíč :hodnota
		url-parametry připojit: klíč řetězec url-kódovat + ['='] + hodnota řetězec url-kódovat.
	}.
	vlastní url-parametry := ['?'] + ( url-parametry spojit: ['&'] ).
}.

URL při: ['heš:'] udělat: { :hash
	vlastní hash := ['#'] + hash url-kódovat.
}.

