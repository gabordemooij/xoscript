>> Email := Objekt nový.

Email při: ['inicializovat'] udělat: {
	vlastní příjemci := Seznam nový.
	vlastní cc := Seznam nový.
	vlastní bcc := Seznam nový.
	vlastní odesílatel := Nic.
	vlastní jméno-odesílatele := Nic.
	vlastní předmět := Nic.
	vlastní tělo := Nic.
}.

Email při: ['nový'] udělat: { <- sebe nový inicializovat.
}.

Email při: ['komu:'] udělat: { :výčet
	vlastní příjemci := výčet.
}.
 
Email při: ['cc:'] udělat: { :výčet
	vlastní cc := výčet.
}.

Email při: ['bcc:'] udělat: { :výčet
	vlastní bcc := výčet.
}.

Email při: ['předmět:'] udělat: { :předmět
	vlastní předmět := předmět.
}.

Email při: ['odesílatel:název:'] udělat: { :odesílatel :název
	vlastní odesílatel := odesílatel.
	vlastní jméno-odesílatele := název.
}.

Email při: ['tělo:'] udělat: { :tělo
	vlastní tělo := tělo.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email při: ['hlavička:'] udělat: { :řádek <- řádek nahradit: ['\r'] za: [''], nahradit: ['\n'] za: [''].
}.

Email při: ['odeslat'] udělat: {
	>> f := Soubor tempwrite: sebe generovat.
	Program systém: ['sendmail -t < '] + f cesta, nový-řádek.
}.

Email při: ['generovat'] udělat: {
	>> zalomení := ['\r\n'].
	>> textový-řetězec := [''].
	textový-řetězec připojit: (sebe hlavička: ['From: '] + vlastní jméno-odesílatele + [' <'] + ( vlastní odesílatel ) + ['>']) + zalomení.
	textový-řetězec připojit: (sebe hlavička: ['To: '] + ( vlastní příjemci spojit: [','] )) + zalomení.
	vlastní cc počet pravda: {
		textový-řetězec připojit: (sebe hlavička: ['Cc: '] + ( vlastní cc spojit: [','] )) + zalomení.
	}.
	vlastní bcc počet pravda: {
		textový-řetězec připojit: (sebe hlavička: ['Bcc: '] + ( vlastní bcc spojit: [','] )) + zalomení.
	}.
	textový-řetězec připojit: (sebe hlavička: ['Subject: '] + vlastní předmět) + zalomení.
	textový-řetězec připojit: zalomení.
	textový-řetězec připojit: vlastní tělo.
	textový-řetězec připojit: zalomení. <- textový-řetězec.
}.

>> HTML-Email := Email nový.

HTML-Email při: ['inicializovat'] udělat: {
	sebe inicializovat.
	vlastní přílohy := Seznam nový.
	vlastní hranice := Trezor token: 40.
}.

HTML-Email při: ['přiložit:'] udělat: { :soubor
	>> id := vlastní přílohy počet.
	>> blob := soubor blob.
	vlastní přílohy připojit: (
		Slovník nový
			soubor: soubor cesta,
			mime: ['image/'] + (Server mimetype: soubor cesta),
			data: blob base64-kódovat
	).
	blob uvolnit. <- ['cid:attachment'] + id.
}.

HTML-Email při: ['generovat'] udělat: {
	>> zalomení := ['\r\n'].
	>> textový-řetězec := [''].
	textový-řetězec připojit: (sebe hlavička: ['From: '] + vlastní jméno-odesílatele + [' <'] + ( vlastní odesílatel ) + ['>']) + zalomení.
	textový-řetězec připojit: (sebe hlavička: ['To: '] + ( vlastní příjemci spojit: [','] )) + zalomení.
	vlastní cc počet pravda: {
		textový-řetězec připojit: (sebe hlavička: ['Cc: '] + ( vlastní cc spojit: [','] )) + zalomení.
	}.
	vlastní bcc počet pravda: {
		textový-řetězec připojit: (sebe hlavička: ['Bcc: '] + ( vlastní bcc spojit: [','] )) + zalomení.
	}.
	textový-řetězec připojit: (sebe hlavička: ['Subject: '] + vlastní předmět) + zalomení.
	textový-řetězec připojit: ['MIME-Version: 1.0'] + zalomení.
	textový-řetězec připojit: ['Content-Type: multipart/related; boundary="'] + vlastní hranice + ['"; type=text/html'] + zalomení.
	textový-řetězec připojit: zalomení.
	textový-řetězec připojit: ['--'] + vlastní hranice + zalomení.
	textový-řetězec připojit: ['Content-Type: text/html; charset=UTF-8'] + zalomení.
	textový-řetězec připojit: ['Content-Transfer-Encoding: 7bit'] + zalomení.
	textový-řetězec připojit: zalomení.
	textový-řetězec připojit: vlastní tělo.
	textový-řetězec připojit: zalomení.
	vlastní přílohy každý: { :id :info
		>> blob := info data.
		textový-řetězec připojit: ['--'] + vlastní hranice + zalomení.
		textový-řetězec připojit: ['Content-Type: '] + info mime + zalomení.
		textový-řetězec připojit: ['Content-Transfer-Encoding: base64'] + zalomení.
		textový-řetězec připojit: ['Content-ID: <attachment'] + id + ['>'] + zalomení.
		textový-řetězec připojit: ['Content-Disposition: inline; filename="'] + info soubor + ['"'] + zalomení.
		textový-řetězec připojit: zalomení.
		>> nejvýše := 76.
		>> délka-textu := blob délka.
		>> kusy := (délka-textu / nejvýše) horní-celá-část.
		{ :i
			>> kus := blob kopírovat od: i * nejvýše délka: nejvýše.
			textový-řetězec připojit: kus + zalomení.
		} * kusy.
		textový-řetězec připojit: zalomení.
		textový-řetězec připojit: zalomení.
	}.
	textový-řetězec připojit: ['--'] + vlastní hranice + ['--'] + zalomení. <- textový-řetězec.
}.
