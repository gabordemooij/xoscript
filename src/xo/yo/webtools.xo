Ibeere-HTTP nigbati: ['HTTP-akọle:'] ṣe: { :kọ́kọ́rọ́ <- Eto eto: kọ́kọ́rọ́.
}.

>> Akọle-HTTP := Nkan tuntun.

Akọle-HTTP nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun múra.
}.

Akọle-HTTP nigbati: ['múra'] ṣe: {
	tirẹ kọ́kọ́rọ́ := Ofo.
	tirẹ iye := Ofo.
}.

Akọle-HTTP nigbati: ['kọ́kọ́rọ́:iye:'] ṣe: { :kọ́kọ́rọ́ :iye
	tirẹ kọ́kọ́rọ́ := kọ́kọ́rọ́.
	tirẹ iye := iye.
}.

Akọle-HTTP nigbati: ['kọ́kọ́rọ́'] ṣe: { <- tirẹ kọ́kọ́rọ́.
}.

Akọle-HTTP nigbati: ['iye'] ṣe: { <- tirẹ iye.
}.


Akọle-HTTP nigbati: ['ọrọ'] ṣe: {
	>> ìlà := tirẹ kọ́kọ́rọ́ + [': '] + tirẹ iye.
	ìlà rọpo: ['\r'] pẹlu: [''], rọpo: ['\n'] pẹlu: ['']. <- ìlà + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Ìwé-Wẹẹbu := Nkan tuntun.

Ìwé-Wẹẹbu nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun múra.
}.

Ìwé-Wẹẹbu nigbati: ['múra'] ṣe: {
	tirẹ àwọn-akọle := Akojọ tuntun.
	tirẹ id-ìpàdé := Ofo.
	tirẹ alákòóso-ìpàdé := Ìpàdé-fáìlì-ìgbà-díẹ̀ tuntun.
	tirẹ dátà-ìpàdé := Ofo.
	tirẹ aláàbò := Otitọ.
	tirẹ ojú-òpó-kan-náà := ['Strict'].
	tirẹ ti-fi-akọle-ránṣẹ́ := Irọ.
	tirẹ ìbéèrè-http := Ibeere-HTTP tuntun.
}.

Ìwé-Wẹẹbu nigbati: ['ìbéèrè-http:'] ṣe: { :ìbéèrè-http
	tirẹ ìbéèrè-http := ìbéèrè-http.
}. 

Ìwé-Wẹẹbu nigbati: ['kúkì-ìpàdé-aláàbò:'] ṣe: { :aláàbò
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	tirẹ aláàbò := aláàbò.
}.

Ìwé-Wẹẹbu nigbati: ['kúkì-ìpàdé-ojú-òpó-kan-náà:'] ṣe: { :iye
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	>> àwọn-àṣàyàn := Akojọ tuntun 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	àwọn-àṣàyàn ni-ninu: iye, irọ: {
		iṣẹ-ṣiṣe-yii aṣiṣe: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	tirẹ ojú-òpó-kan-náà := iye.
}.

Ìwé-Wẹẹbu nigbati: ['akọle:'] ṣe: { :akọle
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	tirẹ àwọn-akọle fi-kun-opin: akọle.
}.

Ìwé-Wẹẹbu nigbati: ['pa-àwọn-akọle-rẹ́'] ṣe: {
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	tirẹ àwọn-akọle := Akojọ tuntun.
}.

Ìwé-Wẹẹbu nigbati: ['alákòóso-ìpàdé:'] ṣe: { :alákòóso
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	tirẹ alákòóso-ìpàdé := alákòóso.
}.

Ìwé-Wẹẹbu nigbati: ['alákòóso-ìpàdé'] ṣe: { <- tirẹ alákòóso-ìpàdé.
}.

Ìwé-Wẹẹbu nigbati: ['ṣàyẹ̀wò-àwọn-akọle'] ṣe: {
	tirẹ ti-fi-akọle-ránṣẹ́ otitọ: {
		iṣẹ-ṣiṣe-yii aṣiṣe: ['Headers already sent to client.'].
	}.
}.

Ìwé-Wẹẹbu nigbati: ['bẹ̀rẹ̀-ìpàdé'] ṣe: {
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	>> ìbéèrè-http := tirẹ ìbéèrè-http.
	>> id-ìpàdé := ìbéèrè-http cookie: ['xsid'].
	id-ìpàdé Ofo? irọ: {
		(( Apẹrẹ tuntun: ['^[A-Za-z0-9]+\\z'], ibamu: id-ìpàdé ) = 0) otitọ: {
			id-ìpàdé := Ofo.
		}.
	}.
	id-ìpàdé Ofo? otitọ: {
		id-ìpàdé := Apoti-aabo token: 30.
		>> akọle-ìpàdé := Akọle-HTTP tuntun
		kọ́kọ́rọ́: ['Set-Cookie'] iye: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (tirẹ aláàbò boya: ['Secure'] tabi: ['']),
		SSITE: (tirẹ ojú-òpó-kan-náà),
		XSID: id-ìpàdé
		).
		tirẹ àwọn-akọle fi-kun-opin: akọle-ìpàdé.
	}.
	tirẹ dátà-ìpàdé := tirẹ alákòóso-ìpàdé fún: id-ìpàdé, gbé-wọlé. <- tirẹ dátà-ìpàdé. # reference
}.

Ìwé-Wẹẹbu nigbati: ['lọ-sí:'] ṣe: { :àdírẹ́sì
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	ara-rẹ pa-àwọn-akọle-rẹ́.
	tirẹ àwọn-akọle
	fi-kun-opin: (
		Akọle-HTTP tuntun
		kọ́kọ́rọ́: ['Status'] iye: ['303 See Other']
	),
	fi-kun-opin: (
		Akọle-HTTP tuntun
		kọ́kọ́rọ́: ['Location'] iye: àdírẹ́sì
	).
	ara-rẹ gbé-jáde: ['Redirect'].
}.

Ìwé-Wẹẹbu nigbati: ['parun-ìpàdé'] ṣe: {
	ara-rẹ ṣàyẹ̀wò-àwọn-akọle.
	>> ìbéèrè-http := tirẹ ìbéèrè-http.
	>> id-ìpàdé := ìbéèrè-http cookie: ['xsid'].
	id-ìpàdé Ofo? irọ: {
		>> akọle-ìpàdé := Akọle-HTTP tuntun.
		>> àkókò-ìparí := Akoko tuntun ọdun: 1970, ọna-kika: ['%a, %d %b %Y %H:%M:%S GMT'].
		akọle-ìpàdé kọ́kọ́rọ́: ['Set-Cookie'] iye: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: àkókò-ìparí,
			SEC: (tirẹ aláàbò boya: ['Secure'] tabi: ['']),
			SSITE: (tirẹ ojú-òpó-kan-náà),
			XSID: id-ìpàdé
		).
		tirẹ alákòóso-ìpàdé parun.
		tirẹ àwọn-akọle fi-kun-opin: akọle-ìpàdé.
	}.
}.


Ìwé-Wẹẹbu nigbati: ['àwòṣe:'] ṣe: { :ọna-faili <- Àwòṣe tuntun: (Faili tuntun: ọna-faili, ka).
}.

Ìwé-Wẹẹbu nigbati: ['gbé-jáde:oriṣi:'] ṣe: { :àbájáde :oriṣi
	tirẹ ti-fi-akọle-ránṣẹ́ irọ: {
		tirẹ dátà-ìpàdé Ofo? irọ: {
			tirẹ alákòóso-ìpàdé fipamọ́: tirẹ dátà-ìpàdé.
		}.
		tirẹ àwọn-akọle fi-kun-opin: (
			Akọle-HTTP tuntun
			kọ́kọ́rọ́: ['Content-type'] iye: oriṣi
		).
		tirẹ àwọn-akọle kọọkan: { :_ :akọle
			Ijade kọ: akọle.
		}.
		tirẹ ti-fi-akọle-ránṣẹ́ := Otitọ.
		Ijade kọ: ['\r\n'].
	}.
	Ijade kọ: àbájáde.
}.

Ìwé-Wẹẹbu nigbati: ['parí:oriṣi:'] ṣe: { :àbájáde :oriṣi
	tirẹ ti-fi-akọle-ránṣẹ́ irọ: {
		tirẹ dátà-ìpàdé Ofo? irọ: {
			tirẹ alákòóso-ìpàdé fipamọ́: tirẹ dátà-ìpàdé.
		}.
		tirẹ àwọn-akọle fi-kun-opin: (
			Akọle-HTTP tuntun
			kọ́kọ́rọ́: ['Content-type'] iye: oriṣi
		).
		tirẹ àwọn-akọle fi-kun-opin: (
			Akọle-HTTP tuntun
			kọ́kọ́rọ́: ['Content-Length'] iye: àbájáde ọrọ bytes
		).
		tirẹ àwọn-akọle kọọkan: { :_ :akọle
			Ijade kọ: akọle.
		}.
		tirẹ ti-fi-akọle-ránṣẹ́ := Otitọ.
		Ijade kọ: ['\r\n'].
	}.
	Ijade kọ: àbájáde.
}.

Ìwé-Wẹẹbu nigbati: ['gbé-jáde:'] ṣe: { :àbájáde
	ara-rẹ gbé-jáde: àbájáde oriṣi: ['text/html; charset=utf-8'].
}.

Ìwé-Wẹẹbu nigbati: ['parí:'] ṣe: { :àbájáde
	ara-rẹ parí: àbájáde oriṣi: ['text/html; charset=utf-8'].
}.

Ìwé-Wẹẹbu nigbati: ['json:'] ṣe: { :àbájáde
	ara-rẹ gbé-jáde: ( JSON jsonify: àbájáde ) oriṣi: ['application/json'].
}.

Ìwé-Wẹẹbu nigbati: ['kò-rí:'] ṣe: { :àbájáde
	ara-rẹ pa-àwọn-akọle-rẹ́ akọle: (
		Akọle-HTTP tuntun kọ́kọ́rọ́: ['Status'] iye: ['404 Not Found']
	).
	ara-rẹ gbé-jáde: àbájáde.
}.


# Interface

>> Ìpàdé := Nkan tuntun.

Ìpàdé nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun múra fún: Ofo.
}.

Ìpàdé nigbati: ['fún:'] ṣe: { :id
	tirẹ id := id.
}.

Ìpàdé nigbati: ['gbé-wọlé'] ṣe: {
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Not implemented.'].
}.

Ìpàdé nigbati: ['fipamọ́:'] ṣe: {
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Not implemented.'].
}.

Ìpàdé nigbati: ['parun'] ṣe: {
	iṣẹ-ṣiṣe-yii aṣiṣe: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Ìpàdé-fáìlì-ìgbà-díẹ̀ := Ìpàdé tuntun.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['múra'] ṣe: {
	tirẹ ìbẹ̀rẹ̀-ọ̀nà := ['/tmp/sess-'].
}.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['ìṣáájú-ọ̀nà:'] ṣe: { :okùn-ọ̀rọ̀
	tirẹ ìbẹ̀rẹ̀-ọ̀nà := okùn-ọ̀rọ̀.
}.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['fáìlì-ìpàdé'] ṣe: { <- ( Faili tuntun: ( tirẹ ìbẹ̀rẹ̀-ọ̀nà + tirẹ id + ['.txt'] ) ).
}.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['gbé-wọlé'] ṣe: {
	>> fáìlì-ìpàdé := ara-rẹ fáìlì-ìpàdé.
	fáìlì-ìpàdé wa irọ: {
		fáìlì-ìpàdé kọ: (Atumọ-ede tuntun koodu).
	}. <- fáìlì-ìpàdé ka nkan.
}.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['fipamọ́:'] ṣe: { :dátà
	>> fáìlì-ìpàdé := ara-rẹ fáìlì-ìpàdé.
	fáìlì-ìpàdé wa otitọ: {
		fáìlì-ìpàdé kọ: dátà koodu.
	}.
}.

Ìpàdé-fáìlì-ìgbà-díẹ̀ nigbati: ['parun'] ṣe: {
	>> fáìlì-ìpàdé := ara-rẹ fáìlì-ìpàdé.
	fáìlì-ìpàdé wa otitọ: {
		fáìlì-ìpàdé paarẹ.
	}.
}.


>> URL := Nkan tuntun.

URL nigbati: ['múra'] ṣe: {
	tirẹ ìlànà := ['https://'].
	tirẹ agbalejo := ['localhost'].
	tirẹ ọna-faili := [''].
	tirẹ àwọn-pàrámítà-url := [''].
	tirẹ hash := [''].
}.

URL nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun múra.
}.

URL nigbati: ['ọrọ'] ṣe: { <- (
	tirẹ ìlànà +
	tirẹ agbalejo +
	tirẹ ọna-faili +
	tirẹ àwọn-pàrámítà-url +
	tirẹ hash ).
}.

URL nigbati: ['ìlànà:'] ṣe: { :ìlànà
	((Akojọ tuntun ; ['http'] ; ['https']) ni-ninu: ìlànà) otitọ: {
		tirẹ ìlànà := ìlànà + ['://'].
	}, irọ: {
		iṣẹ-ṣiṣe-yii aṣiṣe: ['Invalid protocol'].
	}.
}.

URL nigbati: ['agbalejo:'] ṣe: { :agbalejo
	#todo validate according to rfc
	tirẹ agbalejo := agbalejo.
}.

URL nigbati: ['ọna-faili:'] ṣe: { :ọna-faili
	tirẹ ọna-faili := ['/'] + ọna-faili url-ṣe-koodu.
}.

URL nigbati: ['àwọn-pàrámítà-url:'] ṣe: { :ìyàwòrán
	>> àwọn-pàrámítà-url := Akojọ tuntun.
	ìyàwòrán kọọkan: { :kọ́kọ́rọ́ :iye
		àwọn-pàrámítà-url fi-kun-opin: kọ́kọ́rọ́ ọrọ url-ṣe-koodu + ['='] + iye ọrọ url-ṣe-koodu.
	}.
	tirẹ àwọn-pàrámítà-url := ['?'] + ( àwọn-pàrámítà-url so-pọ: ['&'] ).
}.

URL nigbati: ['haṣi:'] ṣe: { :hash
	tirẹ hash := ['#'] + hash url-ṣe-koodu.
}.

