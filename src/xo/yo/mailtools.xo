>> Imeeli := Nkan tuntun.

Imeeli nigbati: ['múra'] ṣe: {
	tirẹ àwọn-olùgbà := Akojọ tuntun.
	tirẹ cc := Akojọ tuntun.
	tirẹ bcc := Akojọ tuntun.
	tirẹ olùfiránṣẹ́ := Ofo.
	tirẹ orúkọ-olùfiránṣẹ́ := Ofo.
	tirẹ kókó-ọ̀rọ̀ := Ofo.
	tirẹ ara := Ofo.
}.

Imeeli nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun múra.
}.

Imeeli nigbati: ['sí:'] ṣe: { :ìkàsílẹ̀
	tirẹ àwọn-olùgbà := ìkàsílẹ̀.
}.
 
Imeeli nigbati: ['cc:'] ṣe: { :ìkàsílẹ̀
	tirẹ cc := ìkàsílẹ̀.
}.

Imeeli nigbati: ['bcc:'] ṣe: { :ìkàsílẹ̀
	tirẹ bcc := ìkàsílẹ̀.
}.

Imeeli nigbati: ['kókó-ọ̀rọ̀:'] ṣe: { :kókó-ọ̀rọ̀
	tirẹ kókó-ọ̀rọ̀ := kókó-ọ̀rọ̀.
}.

Imeeli nigbati: ['olùfiránṣẹ́:orukọ:'] ṣe: { :olùfiránṣẹ́ :orukọ
	tirẹ olùfiránṣẹ́ := olùfiránṣẹ́.
	tirẹ orúkọ-olùfiránṣẹ́ := orukọ.
}.

Imeeli nigbati: ['ara:'] ṣe: { :ara
	tirẹ ara := ara.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeeli nigbati: ['akọle:'] ṣe: { :ìlà <- ìlà rọpo: ['\r'] pẹlu: [''], rọpo: ['\n'] pẹlu: [''].
}.

Imeeli nigbati: ['fi-ránṣẹ́'] ṣe: {
	>> f := Faili tempwrite: ara-rẹ ṣẹ̀dá.
	Eto eto-iṣẹ: ['sendmail -t < '] + f ọna-faili, ila-tuntun.
}.

Imeeli nigbati: ['ṣẹ̀dá'] ṣe: {
	>> ìfọ́-ìlà := ['\r\n'].
	>> okùn-ọ̀rọ̀ := [''].
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['From: '] + tirẹ orúkọ-olùfiránṣẹ́ + [' <'] + ( tirẹ olùfiránṣẹ́ ) + ['>']) + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['To: '] + ( tirẹ àwọn-olùgbà so-pọ: [','] )) + ìfọ́-ìlà.
	tirẹ cc iye-nọmba otitọ: {
		okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Cc: '] + ( tirẹ cc so-pọ: [','] )) + ìfọ́-ìlà.
	}.
	tirẹ bcc iye-nọmba otitọ: {
		okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Bcc: '] + ( tirẹ bcc so-pọ: [','] )) + ìfọ́-ìlà.
	}.
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Subject: '] + tirẹ kókó-ọ̀rọ̀) + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: tirẹ ara.
	okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà. <- okùn-ọ̀rọ̀.
}.

>> Imeeli-HTML := Imeeli tuntun.

Imeeli-HTML nigbati: ['múra'] ṣe: {
	ara-rẹ múra.
	tirẹ àwọn-àsomọ́ := Akojọ tuntun.
	tirẹ ààlà := Apoti-aabo token: 40.
}.

Imeeli-HTML nigbati: ['so-mọ:'] ṣe: { :fáìlì-ìpàdé
	>> id := tirẹ àwọn-àsomọ́ iye-nọmba.
	>> blob := fáìlì-ìpàdé blob.
	tirẹ àwọn-àsomọ́ fi-kun-opin: (
		Atumọ-ede tuntun
			fáìlì-ìpàdé: fáìlì-ìpàdé ọna-faili,
			mime: ['image/'] + (Server mimetype: fáìlì-ìpàdé ọna-faili),
			dátà: blob base64-ṣe-koodu
	).
	blob tu-silẹ. <- ['cid:attachment'] + id.
}.

Imeeli-HTML nigbati: ['ṣẹ̀dá'] ṣe: {
	>> ìfọ́-ìlà := ['\r\n'].
	>> okùn-ọ̀rọ̀ := [''].
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['From: '] + tirẹ orúkọ-olùfiránṣẹ́ + [' <'] + ( tirẹ olùfiránṣẹ́ ) + ['>']) + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['To: '] + ( tirẹ àwọn-olùgbà so-pọ: [','] )) + ìfọ́-ìlà.
	tirẹ cc iye-nọmba otitọ: {
		okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Cc: '] + ( tirẹ cc so-pọ: [','] )) + ìfọ́-ìlà.
	}.
	tirẹ bcc iye-nọmba otitọ: {
		okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Bcc: '] + ( tirẹ bcc so-pọ: [','] )) + ìfọ́-ìlà.
	}.
	okùn-ọ̀rọ̀ fi-kun-opin: (ara-rẹ akọle: ['Subject: '] + tirẹ kókó-ọ̀rọ̀) + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ['MIME-Version: 1.0'] + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Type: multipart/related; boundary="'] + tirẹ ààlà + ['"; type=text/html'] + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ['--'] + tirẹ ààlà + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Type: text/html; charset=UTF-8'] + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Transfer-Encoding: 7bit'] + ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
	okùn-ọ̀rọ̀ fi-kun-opin: tirẹ ara.
	okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
	tirẹ àwọn-àsomọ́ kọọkan: { :id :ìsọfúnni
		>> blob := ìsọfúnni dátà.
		okùn-ọ̀rọ̀ fi-kun-opin: ['--'] + tirẹ ààlà + ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Type: '] + ìsọfúnni mime + ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Transfer-Encoding: base64'] + ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ['Content-ID: <attachment'] + id + ['>'] + ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ['Content-Disposition: inline; filename="'] + ìsọfúnni fáìlì-ìpàdé + ['"'] + ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
		>> tó-pọ̀-jù := 76.
		>> gígùn-ọ̀rọ̀ := blob gigun.
		>> àwọn-ègé := (gígùn-ọ̀rọ̀ / tó-pọ̀-jù) yika-soke.
		{ :i
			>> ègé := blob ṣe-ẹda lati: i * tó-pọ̀-jù gigun: tó-pọ̀-jù.
			okùn-ọ̀rọ̀ fi-kun-opin: ègé + ìfọ́-ìlà.
		} * àwọn-ègé.
		okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
		okùn-ọ̀rọ̀ fi-kun-opin: ìfọ́-ìlà.
	}.
	okùn-ọ̀rọ̀ fi-kun-opin: ['--'] + tirẹ ààlà + ['--'] + ìfọ́-ìlà. <- okùn-ọ̀rọ̀.
}.
