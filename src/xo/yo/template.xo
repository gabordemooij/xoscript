
# ~ Simple template engine ~

>> Àwòṣe := Nkan tuntun.

Àwòṣe nigbati: ['tuntun'] ṣe: { <- ara-rẹ tuntun àkóónú: [''].
}.

Àwòṣe nigbati: ['àkóónú:'] ṣe: { :àkóónú
	tirẹ àkóónú := àkóónú. 
}.

Àwòṣe nigbati: ['tuntun:'] ṣe: { :àkóónú <- ara-rẹ tuntun àkóónú: àkóónú.
}.

Àwòṣe nigbati: ['gé:'] ṣe: { :àmì
	>> àmì-ìbẹ̀rẹ̀ := (['<!-- cut:%id% -->'] %id%: àmì).
	>> àmì-ìparí := (['<!-- /cut:%id% -->'] %id%: àmì).
	>> àwọn-apá := tirẹ àkóónú pin: àmì-ìbẹ̀rẹ̀.
	>> ìṣáájú := àwọn-apá akọkọ.
	>> àwọn-apá2 := àwọn-apá ikẹhin pin: àmì-ìparí.
	>> àfòmọ́ := àwọn-apá2 ikẹhin.
	>> apá := àwọn-apá2 akọkọ.
	>> ìyókù := ìṣáájú + àfòmọ́.
	tirẹ àkóónú := ìyókù. <- Àwòṣe tuntun: apá.
	
}.

Àwòṣe nigbati: ['ṣe-ẹda'] ṣe: { <- ara-rẹ tuntun: ara-rẹ ọrọ ṣe-ẹda.
}.
	
Àwòṣe nigbati: ['lẹ̀:si:'] ṣe: { :àyọlò :id
	>> àmì-lílẹ̀ := (['<!-- paste:%id% -->'] %id%: id).
	tirẹ àkóónú rọpo: àmì-lílẹ̀ pẹlu: ( àyọlò ọrọ + àmì-lílẹ̀ ).
}.

Àwòṣe nigbati: ['ṣeto:iye:'] ṣe: { :àyè :iye
	tirẹ àkóónú rọpo: ['<!-- slot:'] + àyè + [' -->'] pẹlu: ( Server html-ṣe-koodu: iye ).
}.

Àwòṣe nigbati: ['ṣeto:html:'] ṣe: { :àyè :html
	tirẹ àkóónú rọpo: ['<!-- slot:'] + àyè + [' -->'] pẹlu: html.
}.

Àwòṣe nigbati: ['fesi:ati:'] ṣe: { :àyè :iye
	ara-rẹ ṣeto: (àyè lati: 0 gigun: (àyè gigun - 1)) iye: iye.
}.

Àwòṣe nigbati: ['nl2br'] ṣe: {
	tirẹ àkóónú rọpo: ['\n'] pẹlu: ['<br>'].
}.

Àwòṣe nigbati: ['nu'] ṣe: {
	tirẹ àkóónú :=
		Apẹrẹ
		tuntun: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		ibamu: tirẹ àkóónú
		ṣe: { <- ['']. }.
}.

Àwòṣe nigbati: ['nu-àwọn-gígé'] ṣe: {
	>> àwọn-nǹkan := Akojọ tuntun.
	Apẹrẹ
	tuntun: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	ibamu: tirẹ àkóónú
	ṣe: { :_ :apá
		àwọn-nǹkan fi-kun-opin: apá ? 1.
	}.
	àwọn-nǹkan kọọkan: { :_ :id
		tirẹ àkóónú :=
			Apẹrẹ tuntun: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			ibamu: tirẹ àkóónú
			ṣe: { <- ['']. }.
	 }.
}.

Àwòṣe nigbati: ['nu-àwọn-àlàfo'] ṣe: {
	tirẹ àkóónú :=
		Apẹrẹ
		tuntun: ['\\s*\\n'],
		ibamu: tirẹ àkóónú
		ṣe: { <- ['\n']. }.
	tirẹ àkóónú :=
		Apẹrẹ
		tuntun: ['\\n[\\s\\t]+'],
		ibamu: tirẹ àkóónú
		ṣe: { <- ['\n']. }.
}.

Àwòṣe nigbati: ['nu-gbogbo'] ṣe: {
	ara-rẹ nu.
	ara-rẹ nu-àwọn-gígé.
	ara-rẹ nu-àwọn-àlàfo.
}.

Àwòṣe nigbati: ['ọrọ'] ṣe: { <- tirẹ àkóónú.
}.
