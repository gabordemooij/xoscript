
# ~ Simple template engine ~

>> Sablon := Objektum új.

Sablon ha: ['új'] tedd: { <- maga új tartalom: [''].
}.

Sablon ha: ['tartalom:'] tedd: { :tartalom
	saját tartalom := tartalom. 
}.

Sablon ha: ['új:'] tedd: { :tartalom <- maga új tartalom: tartalom.
}.

Sablon ha: ['kivág:'] tedd: { :jelölő
	>> kezdőjelölő := (['<!-- cut:%id% -->'] %id%: jelölő).
	>> zárójelölő := (['<!-- /cut:%id% -->'] %id%: jelölő).
	>> részek := saját tartalom feloszt: kezdőjelölő.
	>> előtag := részek első.
	>> részek2 := részek utolsó feloszt: zárójelölő.
	>> utótag := részek2 utolsó.
	>> rész := részek2 első.
	>> maradék := előtag + utótag.
	saját tartalom := maradék. <- Sablon új: rész.
	
}.

Sablon ha: ['másol'] tedd: { <- maga új: maga szöveg másol.
}.
	
Sablon ha: ['beilleszt:ide:'] tedd: { :részlet :id
	>> beillesztési-jelölő := (['<!-- paste:%id% -->'] %id%: id).
	saját tartalom csere: beillesztési-jelölő erre: ( részlet szöveg + beillesztési-jelölő ).
}.

Sablon ha: ['beállít:érték:'] tedd: { :hely :érték
	saját tartalom csere: ['<!-- slot:'] + hely + [' -->'] erre: ( Server html-kódolás: érték ).
}.

Sablon ha: ['beállít:html:'] tedd: { :hely :html
	saját tartalom csere: ['<!-- slot:'] + hely + [' -->'] erre: html.
}.

Sablon ha: ['válaszol:és:'] tedd: { :hely :érték
	maga beállít: (hely ettől: 0 hossz: (hely hossz - 1)) érték: érték.
}.

Sablon ha: ['nl2br'] tedd: {
	saját tartalom csere: ['\n'] erre: ['<br>'].
}.

Sablon ha: ['tisztít'] tedd: {
	saját tartalom :=
		Minta
		új: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		egyezés: saját tartalom
		tedd: { <- ['']. }.
}.

Sablon ha: ['kivágásokat-tisztít'] tedd: {
	>> elemek := Lista új.
	Minta
	új: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	egyezés: saját tartalom
	tedd: { :_ :rész
		elemek hozzáfűz: rész ? 1.
	}.
	elemek mindegyik: { :_ :id
		saját tartalom :=
			Minta új: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			egyezés: saját tartalom
			tedd: { <- ['']. }.
	 }.
}.

Sablon ha: ['szóközöket-tisztít'] tedd: {
	saját tartalom :=
		Minta
		új: ['\\s*\\n'],
		egyezés: saját tartalom
		tedd: { <- ['\n']. }.
	saját tartalom :=
		Minta
		új: ['\\n[\\s\\t]+'],
		egyezés: saját tartalom
		tedd: { <- ['\n']. }.
}.

Sablon ha: ['mindent-tisztít'] tedd: {
	maga tisztít.
	maga kivágásokat-tisztít.
	maga szóközöket-tisztít.
}.

Sablon ha: ['szöveg'] tedd: { <- saját tartalom.
}.
