HTTP-Kérés ha: ['HTTP-fejléc:'] tedd: { :kulcs <- Program beállítás: kulcs.
}.

>> HTTP-Fejléc := Objektum új.

HTTP-Fejléc ha: ['új'] tedd: { <- maga új inicializál.
}.

HTTP-Fejléc ha: ['inicializál'] tedd: {
	saját kulcs := Semmi.
	saját érték := Semmi.
}.

HTTP-Fejléc ha: ['kulcs:érték:'] tedd: { :kulcs :érték
	saját kulcs := kulcs.
	saját érték := érték.
}.

HTTP-Fejléc ha: ['kulcs'] tedd: { <- saját kulcs.
}.

HTTP-Fejléc ha: ['érték'] tedd: { <- saját érték.
}.


HTTP-Fejléc ha: ['szöveg'] tedd: {
	>> sor := saját kulcs + [': '] + saját érték.
	sor csere: ['\r'] erre: [''], csere: ['\n'] erre: ['']. <- sor + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdokumentum := Objektum új.

Webdokumentum ha: ['új'] tedd: { <- maga új inicializál.
}.

Webdokumentum ha: ['inicializál'] tedd: {
	saját fejlécek := Lista új.
	saját munkamenet-azonosító := Semmi.
	saját munkamenet-kezelő := Ideiglenes-fájl-munkamenet új.
	saját munkamenet-adatok := Semmi.
	saját biztonságos := Igaz.
	saját azonos-webhely := ['Strict'].
	saját fejlécek-elküldve := Hamis.
	saját kérés := HTTP-Kérés új.
}.

Webdokumentum ha: ['kérés:'] tedd: { :kérés
	saját kérés := kérés.
}. 

Webdokumentum ha: ['biztonságos-munkamenet-süti:'] tedd: { :biztonságos
	maga fejlécek-ellenőrzése.
	saját biztonságos := biztonságos.
}.

Webdokumentum ha: ['azonos-webhely-munkamenet-süti:'] tedd: { :érték
	maga fejlécek-ellenőrzése.
	>> beállítások := Lista új 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	beállítások van-benne: érték, hamis: {
		ez-a-feladat hiba: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	saját azonos-webhely := érték.
}.

Webdokumentum ha: ['fejléc:'] tedd: { :fejléc
	maga fejlécek-ellenőrzése.
	saját fejlécek hozzáfűz: fejléc.
}.

Webdokumentum ha: ['fejlécek-törlése'] tedd: {
	maga fejlécek-ellenőrzése.
	saját fejlécek := Lista új.
}.

Webdokumentum ha: ['munkamenet-kezelő:'] tedd: { :kezelő
	maga fejlécek-ellenőrzése.
	saját munkamenet-kezelő := kezelő.
}.

Webdokumentum ha: ['munkamenet-kezelő'] tedd: { <- saját munkamenet-kezelő.
}.

Webdokumentum ha: ['fejlécek-ellenőrzése'] tedd: {
	saját fejlécek-elküldve igaz: {
		ez-a-feladat hiba: ['Headers already sent to client.'].
	}.
}.

Webdokumentum ha: ['munkamenet-indítása'] tedd: {
	maga fejlécek-ellenőrzése.
	>> kérés := saját kérés.
	>> munkamenet-azonosító := kérés cookie: ['xsid'].
	munkamenet-azonosító Semmi? hamis: {
		(( Minta új: ['^[A-Za-z0-9]+\\z'], egyezés: munkamenet-azonosító ) = 0) igaz: {
			munkamenet-azonosító := Semmi.
		}.
	}.
	munkamenet-azonosító Semmi? igaz: {
		munkamenet-azonosító := Széf token: 30.
		>> munkamenet-fejléc := HTTP-Fejléc új
		kulcs: ['Set-Cookie'] érték: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (saját biztonságos vagy: ['Secure'] vagy: ['']),
		SSITE: (saját azonos-webhely),
		XSID: munkamenet-azonosító
		).
		saját fejlécek hozzáfűz: munkamenet-fejléc.
	}.
	saját munkamenet-adatok := saját munkamenet-kezelő számára: munkamenet-azonosító, betölt. <- saját munkamenet-adatok. # reference
}.

Webdokumentum ha: ['ugrás:'] tedd: { :cím
	maga fejlécek-ellenőrzése.
	maga fejlécek-törlése.
	saját fejlécek
	hozzáfűz: (
		HTTP-Fejléc új
		kulcs: ['Status'] érték: ['303 See Other']
	),
	hozzáfűz: (
		HTTP-Fejléc új
		kulcs: ['Location'] érték: cím
	).
	maga kiír: ['Redirect'].
}.

Webdokumentum ha: ['munkamenet-megszüntetése'] tedd: {
	maga fejlécek-ellenőrzése.
	>> kérés := saját kérés.
	>> munkamenet-azonosító := kérés cookie: ['xsid'].
	munkamenet-azonosító Semmi? hamis: {
		>> munkamenet-fejléc := HTTP-Fejléc új.
		>> időpont := Pillanat új év: 1970, formátum: ['%a, %d %b %Y %H:%M:%S GMT'].
		munkamenet-fejléc kulcs: ['Set-Cookie'] érték: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: időpont,
			SEC: (saját biztonságos vagy: ['Secure'] vagy: ['']),
			SSITE: (saját azonos-webhely),
			XSID: munkamenet-azonosító
		).
		saját munkamenet-kezelő megsemmisít.
		saját fejlécek hozzáfűz: munkamenet-fejléc.
	}.
}.


Webdokumentum ha: ['sablon:'] tedd: { :útvonal <- Sablon új: (Fájl új: útvonal, olvas).
}.

Webdokumentum ha: ['kiír:típus:'] tedd: { :kimenet :típus
	saját fejlécek-elküldve hamis: {
		saját munkamenet-adatok Semmi? hamis: {
			saját munkamenet-kezelő ment: saját munkamenet-adatok.
		}.
		saját fejlécek hozzáfűz: (
			HTTP-Fejléc új
			kulcs: ['Content-type'] érték: típus
		).
		saját fejlécek mindegyik: { :_ :fejléc
			Kimenet ír: fejléc.
		}.
		saját fejlécek-elküldve := Igaz.
		Kimenet ír: ['\r\n'].
	}.
	Kimenet ír: kimenet.
}.

Webdokumentum ha: ['befejez:típus:'] tedd: { :kimenet :típus
	saját fejlécek-elküldve hamis: {
		saját munkamenet-adatok Semmi? hamis: {
			saját munkamenet-kezelő ment: saját munkamenet-adatok.
		}.
		saját fejlécek hozzáfűz: (
			HTTP-Fejléc új
			kulcs: ['Content-type'] érték: típus
		).
		saját fejlécek hozzáfűz: (
			HTTP-Fejléc új
			kulcs: ['Content-Length'] érték: kimenet szöveg bytes
		).
		saját fejlécek mindegyik: { :_ :fejléc
			Kimenet ír: fejléc.
		}.
		saját fejlécek-elküldve := Igaz.
		Kimenet ír: ['\r\n'].
	}.
	Kimenet ír: kimenet.
}.

Webdokumentum ha: ['kiír:'] tedd: { :kimenet
	maga kiír: kimenet típus: ['text/html; charset=utf-8'].
}.

Webdokumentum ha: ['befejez:'] tedd: { :kimenet
	maga befejez: kimenet típus: ['text/html; charset=utf-8'].
}.

Webdokumentum ha: ['json:'] tedd: { :kimenet
	maga kiír: ( JSON jsonify: kimenet ) típus: ['application/json'].
}.

Webdokumentum ha: ['nem-található:'] tedd: { :kimenet
	maga fejlécek-törlése fejléc: (
		HTTP-Fejléc új kulcs: ['Status'] érték: ['404 Not Found']
	).
	maga kiír: kimenet.
}.


# Interface

>> Munkamenet := Objektum új.

Munkamenet ha: ['új'] tedd: { <- maga új inicializál számára: Semmi.
}.

Munkamenet ha: ['számára:'] tedd: { :id
	saját id := id.
}.

Munkamenet ha: ['betölt'] tedd: {
	ez-a-feladat hiba: ['Not implemented.'].
}.

Munkamenet ha: ['ment:'] tedd: {
	ez-a-feladat hiba: ['Not implemented.'].
}.

Munkamenet ha: ['megsemmisít'] tedd: {
	ez-a-feladat hiba: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Ideiglenes-fájl-munkamenet := Munkamenet új.

Ideiglenes-fájl-munkamenet ha: ['inicializál'] tedd: {
	saját útvonal-eleje := ['/tmp/sess-'].
}.

Ideiglenes-fájl-munkamenet ha: ['útvonal-előtag:'] tedd: { :karakterlánc
	saját útvonal-eleje := karakterlánc.
}.

Ideiglenes-fájl-munkamenet ha: ['fájl'] tedd: { <- ( Fájl új: ( saját útvonal-eleje + saját id + ['.txt'] ) ).
}.

Ideiglenes-fájl-munkamenet ha: ['betölt'] tedd: {
	>> fájl := maga fájl.
	fájl létezik hamis: {
		fájl ír: (Szótár új kód).
	}. <- fájl olvas objektum.
}.

Ideiglenes-fájl-munkamenet ha: ['ment:'] tedd: { :adatok
	>> fájl := maga fájl.
	fájl létezik igaz: {
		fájl ír: adatok kód.
	}.
}.

Ideiglenes-fájl-munkamenet ha: ['megsemmisít'] tedd: {
	>> fájl := maga fájl.
	fájl létezik igaz: {
		fájl töröl.
	}.
}.


>> URL := Objektum új.

URL ha: ['inicializál'] tedd: {
	saját protokoll := ['https://'].
	saját gazdagép := ['localhost'].
	saját útvonal := [''].
	saját url-paraméterek := [''].
	saját hash := [''].
}.

URL ha: ['új'] tedd: { <- maga új inicializál.
}.

URL ha: ['szöveg'] tedd: { <- (
	saját protokoll +
	saját gazdagép +
	saját útvonal +
	saját url-paraméterek +
	saját hash ).
}.

URL ha: ['protokoll:'] tedd: { :protokoll
	((Lista új ; ['http'] ; ['https']) van-benne: protokoll) igaz: {
		saját protokoll := protokoll + ['://'].
	}, hamis: {
		ez-a-feladat hiba: ['Invalid protocol'].
	}.
}.

URL ha: ['gazdagép:'] tedd: { :gazdagép
	#todo validate according to rfc
	saját gazdagép := gazdagép.
}.

URL ha: ['útvonal:'] tedd: { :útvonal
	saját útvonal := ['/'] + útvonal url-kódolás.
}.

URL ha: ['url-paraméterek:'] tedd: { :leképezés
	>> url-paraméterek := Lista új.
	leképezés mindegyik: { :kulcs :érték
		url-paraméterek hozzáfűz: kulcs szöveg url-kódolás + ['='] + érték szöveg url-kódolás.
	}.
	saját url-paraméterek := ['?'] + ( url-paraméterek összefűz: ['&'] ).
}.

URL ha: ['hasít:'] tedd: { :hash
	saját hash := ['#'] + hash url-kódolás.
}.

