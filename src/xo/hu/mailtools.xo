>> Email := Objektum új.

Email ha: ['inicializál'] tedd: {
	saját címzettek := Lista új.
	saját cc := Lista új.
	saját bcc := Lista új.
	saját feladó := Semmi.
	saját feladó-neve := Semmi.
	saját tárgy := Semmi.
	saját levéltörzs := Semmi.
}.

Email ha: ['új'] tedd: { <- maga új inicializál.
}.

Email ha: ['címzett:'] tedd: { :felsorolás
	saját címzettek := felsorolás.
}.
 
Email ha: ['cc:'] tedd: { :felsorolás
	saját cc := felsorolás.
}.

Email ha: ['bcc:'] tedd: { :felsorolás
	saját bcc := felsorolás.
}.

Email ha: ['tárgy:'] tedd: { :tárgy
	saját tárgy := tárgy.
}.

Email ha: ['feladó:név:'] tedd: { :feladó :név
	saját feladó := feladó.
	saját feladó-neve := név.
}.

Email ha: ['levéltörzs:'] tedd: { :levéltörzs
	saját levéltörzs := levéltörzs.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email ha: ['fejléc:'] tedd: { :sor <- sor csere: ['\r'] erre: [''], csere: ['\n'] erre: [''].
}.

Email ha: ['küld'] tedd: {
	>> f := Fájl tempwrite: maga generál.
	Program rendszer: ['sendmail -t < '] + f útvonal, újsor.
}.

Email ha: ['generál'] tedd: {
	>> sortörés := ['\r\n'].
	>> karakterlánc := [''].
	karakterlánc hozzáfűz: (maga fejléc: ['From: '] + saját feladó-neve + [' <'] + ( saját feladó ) + ['>']) + sortörés.
	karakterlánc hozzáfűz: (maga fejléc: ['To: '] + ( saját címzettek összefűz: [','] )) + sortörés.
	saját cc darabszám igaz: {
		karakterlánc hozzáfűz: (maga fejléc: ['Cc: '] + ( saját cc összefűz: [','] )) + sortörés.
	}.
	saját bcc darabszám igaz: {
		karakterlánc hozzáfűz: (maga fejléc: ['Bcc: '] + ( saját bcc összefűz: [','] )) + sortörés.
	}.
	karakterlánc hozzáfűz: (maga fejléc: ['Subject: '] + saját tárgy) + sortörés.
	karakterlánc hozzáfűz: sortörés.
	karakterlánc hozzáfűz: saját levéltörzs.
	karakterlánc hozzáfűz: sortörés. <- karakterlánc.
}.

>> HTML-Email := Email új.

HTML-Email ha: ['inicializál'] tedd: {
	maga inicializál.
	saját mellékletek := Lista új.
	saját határ := Széf token: 40.
}.

HTML-Email ha: ['csatol:'] tedd: { :fájl
	>> id := saját mellékletek darabszám.
	>> blob := fájl blob.
	saját mellékletek hozzáfűz: (
		Szótár új
			fájl: fájl útvonal,
			mime: ['image/'] + (Server mimetype: fájl útvonal),
			adatok: blob base64-kódolás
	).
	blob felszabadít. <- ['cid:attachment'] + id.
}.

HTML-Email ha: ['generál'] tedd: {
	>> sortörés := ['\r\n'].
	>> karakterlánc := [''].
	karakterlánc hozzáfűz: (maga fejléc: ['From: '] + saját feladó-neve + [' <'] + ( saját feladó ) + ['>']) + sortörés.
	karakterlánc hozzáfűz: (maga fejléc: ['To: '] + ( saját címzettek összefűz: [','] )) + sortörés.
	saját cc darabszám igaz: {
		karakterlánc hozzáfűz: (maga fejléc: ['Cc: '] + ( saját cc összefűz: [','] )) + sortörés.
	}.
	saját bcc darabszám igaz: {
		karakterlánc hozzáfűz: (maga fejléc: ['Bcc: '] + ( saját bcc összefűz: [','] )) + sortörés.
	}.
	karakterlánc hozzáfűz: (maga fejléc: ['Subject: '] + saját tárgy) + sortörés.
	karakterlánc hozzáfűz: ['MIME-Version: 1.0'] + sortörés.
	karakterlánc hozzáfűz: ['Content-Type: multipart/related; boundary="'] + saját határ + ['"; type=text/html'] + sortörés.
	karakterlánc hozzáfűz: sortörés.
	karakterlánc hozzáfűz: ['--'] + saját határ + sortörés.
	karakterlánc hozzáfűz: ['Content-Type: text/html; charset=UTF-8'] + sortörés.
	karakterlánc hozzáfűz: ['Content-Transfer-Encoding: 7bit'] + sortörés.
	karakterlánc hozzáfűz: sortörés.
	karakterlánc hozzáfűz: saját levéltörzs.
	karakterlánc hozzáfűz: sortörés.
	saját mellékletek mindegyik: { :id :info
		>> blob := info adatok.
		karakterlánc hozzáfűz: ['--'] + saját határ + sortörés.
		karakterlánc hozzáfűz: ['Content-Type: '] + info mime + sortörés.
		karakterlánc hozzáfűz: ['Content-Transfer-Encoding: base64'] + sortörés.
		karakterlánc hozzáfűz: ['Content-ID: <attachment'] + id + ['>'] + sortörés.
		karakterlánc hozzáfűz: ['Content-Disposition: inline; filename="'] + info fájl + ['"'] + sortörés.
		karakterlánc hozzáfűz: sortörés.
		>> legfeljebb := 76.
		>> szöveghossz := blob hossz.
		>> darabok := (szöveghossz / legfeljebb) felfelé-kerekít.
		{ :i
			>> darab := blob másol ettől: i * legfeljebb hossz: legfeljebb.
			karakterlánc hozzáfűz: darab + sortörés.
		} * darabok.
		karakterlánc hozzáfűz: sortörés.
		karakterlánc hozzáfűz: sortörés.
	}.
	karakterlánc hozzáfűz: ['--'] + saját határ + ['--'] + sortörés. <- karakterlánc.
}.
