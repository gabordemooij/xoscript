>> דואל := אובייקט חדש.

דואל בקבלת: ['אתחל'] בצע: {
	שלי נמענים := רשימה חדש.
	שלי cc := רשימה חדש.
	שלי bcc := רשימה חדש.
	שלי שולח := כלום.
	שלי שם-שולח := כלום.
	שלי נושא := כלום.
	שלי גוף := כלום.
}.

דואל בקבלת: ['חדש'] בצע: { <- עצמי חדש אתחל.
}.

דואל בקבלת: ['אל:'] בצע: { :מנייה
	שלי נמענים := מנייה.
}.
 
דואל בקבלת: ['cc:'] בצע: { :מנייה
	שלי cc := מנייה.
}.

דואל בקבלת: ['bcc:'] בצע: { :מנייה
	שלי bcc := מנייה.
}.

דואל בקבלת: ['נושא:'] בצע: { :נושא
	שלי נושא := נושא.
}.

דואל בקבלת: ['שולח:שם:'] בצע: { :שולח :שם
	שלי שולח := שולח.
	שלי שם-שולח := שם.
}.

דואל בקבלת: ['גוף:'] בצע: { :גוף
	שלי גוף := גוף.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
דואל בקבלת: ['כותרת:'] בצע: { :שורה <- שורה החלף: ['\r'] בערך: [''], החלף: ['\n'] בערך: [''].
}.

דואל בקבלת: ['שלח'] בצע: {
	>> f := קובץ כתיבה-זמנית: עצמי צור.
	תוכנית מערכת: ['sendmail -t < '] + f נתיב-קובץ, שורה-חדשה.
}.

דואל בקבלת: ['צור'] בצע: {
	>> שבירת-שורה := ['\r\n'].
	>> מחרוזת-טקסט := [''].
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['From: '] + שלי שם-שולח + [' <'] + ( שלי שולח ) + ['>']) + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['To: '] + ( שלי נמענים אחד: [','] )) + שבירת-שורה.
	שלי cc כמות אם-אמת: {
		מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Cc: '] + ( שלי cc אחד: [','] )) + שבירת-שורה.
	}.
	שלי bcc כמות אם-אמת: {
		מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Bcc: '] + ( שלי bcc אחד: [','] )) + שבירת-שורה.
	}.
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Subject: '] + שלי נושא) + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: שלי גוף.
	מחרוזת-טקסט הוסף-בסוף: שבירת-שורה. <- מחרוזת-טקסט.
}.

>> דואל-HTML := דואל חדש.

דואל-HTML בקבלת: ['אתחל'] בצע: {
	עצמי אתחל.
	שלי קבצים-מצורפים := רשימה חדש.
	שלי גבול := כספת אסימון: 40.
}.

דואל-HTML בקבלת: ['צרף:'] בצע: { :קובץ-הפעלה
	>> id := שלי קבצים-מצורפים כמות.
	>> blob := קובץ-הפעלה blob.
	שלי קבצים-מצורפים הוסף-בסוף: (
		מילון חדש
			קובץ-הפעלה: קובץ-הפעלה נתיב-קובץ,
			mime: ['image/'] + (Server mimetype: קובץ-הפעלה נתיב-קובץ),
			נתונים: blob base64-קידוד
	).
	blob שחרר. <- ['cid:attachment'] + id.
}.

דואל-HTML בקבלת: ['צור'] בצע: {
	>> שבירת-שורה := ['\r\n'].
	>> מחרוזת-טקסט := [''].
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['From: '] + שלי שם-שולח + [' <'] + ( שלי שולח ) + ['>']) + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['To: '] + ( שלי נמענים אחד: [','] )) + שבירת-שורה.
	שלי cc כמות אם-אמת: {
		מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Cc: '] + ( שלי cc אחד: [','] )) + שבירת-שורה.
	}.
	שלי bcc כמות אם-אמת: {
		מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Bcc: '] + ( שלי bcc אחד: [','] )) + שבירת-שורה.
	}.
	מחרוזת-טקסט הוסף-בסוף: (עצמי כותרת: ['Subject: '] + שלי נושא) + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: ['MIME-Version: 1.0'] + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: ['Content-Type: multipart/related; boundary="'] + שלי גבול + ['"; type=text/html'] + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: ['--'] + שלי גבול + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: ['Content-Type: text/html; charset=UTF-8'] + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: ['Content-Transfer-Encoding: 7bit'] + שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
	מחרוזת-טקסט הוסף-בסוף: שלי גוף.
	מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
	שלי קבצים-מצורפים לכל: { :id :מידע
		>> blob := מידע נתונים.
		מחרוזת-טקסט הוסף-בסוף: ['--'] + שלי גבול + שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: ['Content-Type: '] + מידע mime + שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: ['Content-Transfer-Encoding: base64'] + שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: ['Content-ID: <attachment'] + id + ['>'] + שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: ['Content-Disposition: inline; filename="'] + מידע קובץ-הפעלה + ['"'] + שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
		>> מרבי := 76.
		>> אורך-טקסט := blob אורך.
		>> נתחים := (אורך-טקסט / מרבי) עיגול-למעלה.
		{ :i
			>> נתח := blob העתק התחלה: i * מרבי אורך: מרבי.
			מחרוזת-טקסט הוסף-בסוף: נתח + שבירת-שורה.
		} * נתחים.
		מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
		מחרוזת-טקסט הוסף-בסוף: שבירת-שורה.
	}.
	מחרוזת-טקסט הוסף-בסוף: ['--'] + שלי גבול + ['--'] + שבירת-שורה. <- מחרוזת-טקסט.
}.
