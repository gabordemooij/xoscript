
# ~ Simple template engine ~

>> שבלונה := אובייקט חדש.

שבלונה בקבלת: ['חדש'] בצע: { <- עצמי חדש תוכן: [''].
}.

שבלונה בקבלת: ['תוכן:'] בצע: { :תוכן
	שלי תוכן := תוכן. 
}.

שבלונה בקבלת: ['חדש:'] בצע: { :תוכן <- עצמי חדש תוכן: תוכן.
}.

שבלונה בקבלת: ['גזור:'] בצע: { :סמן
	>> סמן-התחלה := (['<!-- cut:%id% -->'] %id%: סמן).
	>> סמן-סוף := (['<!-- /cut:%id% -->'] %id%: סמן).
	>> חלקים := שלי תוכן פצל: סמן-התחלה.
	>> קידומת := חלקים ראשון.
	>> חלקים2 := חלקים אחרון פצל: סמן-סוף.
	>> סיומת := חלקים2 אחרון.
	>> חלק := חלקים2 ראשון.
	>> שארית := קידומת + סיומת.
	שלי תוכן := שארית. <- שבלונה חדש: חלק.
	
}.

שבלונה בקבלת: ['העתק'] בצע: { <- עצמי חדש: עצמי למחרוזת העתק.
}.
	
שבלונה בקבלת: ['הדבק:במפתח:'] בצע: { :קטע :id
	>> סמן-הדבקה := (['<!-- paste:%id% -->'] %id%: id).
	שלי תוכן החלף: סמן-הדבקה בערך: ( קטע למחרוזת + סמן-הדבקה ).
}.

שבלונה בקבלת: ['קבע:ערך:'] בצע: { :משבצת :ערך
	שלי תוכן החלף: ['<!-- slot:'] + משבצת + [' -->'] בערך: ( Server html-קידוד: ערך ).
}.

שבלונה בקבלת: ['קבע:html:'] בצע: { :משבצת :html
	שלי תוכן החלף: ['<!-- slot:'] + משבצת + [' -->'] בערך: html.
}.

שבלונה בקבלת: ['הגב:וגם:'] בצע: { :משבצת :ערך
	עצמי קבע: (משבצת התחלה: 0 אורך: (משבצת אורך - 1)) ערך: ערך.
}.

שבלונה בקבלת: ['nl2br'] בצע: {
	שלי תוכן החלף: ['\n'] בערך: ['<br>'].
}.

שבלונה בקבלת: ['טהר'] בצע: {
	שלי תוכן :=
		דפוס
		חדש: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		התאמה: שלי תוכן
		בצע: { <- ['']. }.
}.

שבלונה בקבלת: ['טהר-גזירות'] בצע: {
	>> פריטים := רשימה חדש.
	דפוס
	חדש: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	התאמה: שלי תוכן
	בצע: { :_ :חלק
		פריטים הוסף-בסוף: חלק ? 1.
	}.
	פריטים לכל: { :_ :id
		שלי תוכן :=
			דפוס חדש: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			התאמה: שלי תוכן
			בצע: { <- ['']. }.
	 }.
}.

שבלונה בקבלת: ['טהר-רווחים'] בצע: {
	שלי תוכן :=
		דפוס
		חדש: ['\\s*\\n'],
		התאמה: שלי תוכן
		בצע: { <- ['\n']. }.
	שלי תוכן :=
		דפוס
		חדש: ['\\n[\\s\\t]+'],
		התאמה: שלי תוכן
		בצע: { <- ['\n']. }.
}.

שבלונה בקבלת: ['טהר-הכל'] בצע: {
	עצמי טהר.
	עצמי טהר-גזירות.
	עצמי טהר-רווחים.
}.

שבלונה בקבלת: ['למחרוזת'] בצע: { <- שלי תוכן.
}.
