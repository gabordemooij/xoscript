בקשת-HTTP בקבלת: ['HTTP-כותרת:'] בצע: { :מפתח <- תוכנית הגדרה: מפתח.
}.

>> כותרת-HTTP := אובייקט חדש.

כותרת-HTTP בקבלת: ['חדש'] בצע: { <- עצמי חדש אתחל.
}.

כותרת-HTTP בקבלת: ['אתחל'] בצע: {
	שלי מפתח := כלום.
	שלי ערך := כלום.
}.

כותרת-HTTP בקבלת: ['מפתח:ערך:'] בצע: { :מפתח :ערך
	שלי מפתח := מפתח.
	שלי ערך := ערך.
}.

כותרת-HTTP בקבלת: ['מפתח'] בצע: { <- שלי מפתח.
}.

כותרת-HTTP בקבלת: ['ערך'] בצע: { <- שלי ערך.
}.


כותרת-HTTP בקבלת: ['למחרוזת'] בצע: {
	>> שורה := שלי מפתח + [': '] + שלי ערך.
	שורה החלף: ['\r'] בערך: [''], החלף: ['\n'] בערך: ['']. <- שורה + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> מסמך-רשת := אובייקט חדש.

מסמך-רשת בקבלת: ['חדש'] בצע: { <- עצמי חדש אתחל.
}.

מסמך-רשת בקבלת: ['אתחל'] בצע: {
	שלי כותרות := רשימה חדש.
	שלי מזהה-הפעלה := כלום.
	שלי מנהל-הפעלות := הפעלה-קובץ-זמני חדש.
	שלי נתוני-הפעלה := כלום.
	שלי מאובטח := אמת.
	שלי אותו-אתר := ['Strict'].
	שלי כותרות-נשלחו := שקר.
	שלי בקשת-http := בקשת-HTTP חדש.
}.

מסמך-רשת בקבלת: ['בקשת-http:'] בצע: { :בקשת-http
	שלי בקשת-http := בקשת-http.
}. 

מסמך-רשת בקבלת: ['עוגיית-הפעלה-מאובטחת:'] בצע: { :מאובטח
	עצמי בדוק-כותרות.
	שלי מאובטח := מאובטח.
}.

מסמך-רשת בקבלת: ['עוגיית-הפעלה-אותו-אתר:'] בצע: { :ערך
	עצמי בדוק-כותרות.
	>> אפשרויות := רשימה חדש 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	אפשרויות יש: ערך, אם-שקר: {
		משימה-זו שגיאה: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	שלי אותו-אתר := ערך.
}.

מסמך-רשת בקבלת: ['כותרת:'] בצע: { :כותרת
	עצמי בדוק-כותרות.
	שלי כותרות הוסף-בסוף: כותרת.
}.

מסמך-רשת בקבלת: ['רוקן-כותרות'] בצע: {
	עצמי בדוק-כותרות.
	שלי כותרות := רשימה חדש.
}.

מסמך-רשת בקבלת: ['מנהל-הפעלות:'] בצע: { :מנהל
	עצמי בדוק-כותרות.
	שלי מנהל-הפעלות := מנהל.
}.

מסמך-רשת בקבלת: ['מנהל-הפעלות'] בצע: { <- שלי מנהל-הפעלות.
}.

מסמך-רשת בקבלת: ['בדוק-כותרות'] בצע: {
	שלי כותרות-נשלחו אם-אמת: {
		משימה-זו שגיאה: ['Headers already sent to client.'].
	}.
}.

מסמך-רשת בקבלת: ['התחל-הפעלה'] בצע: {
	עצמי בדוק-כותרות.
	>> בקשת-http := שלי בקשת-http.
	>> מזהה-הפעלה := בקשת-http cookie: ['xsid'].
	מזהה-הפעלה כלום? אם-שקר: {
		(( דפוס חדש: ['^[A-Za-z0-9]+\\z'], התאמה: מזהה-הפעלה ) = 0) אם-אמת: {
			מזהה-הפעלה := כלום.
		}.
	}.
	מזהה-הפעלה כלום? אם-אמת: {
		מזהה-הפעלה := כספת אסימון: 30.
		>> כותרת-הפעלה := כותרת-HTTP חדש
		מפתח: ['Set-Cookie'] ערך: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (שלי מאובטח זה: ['Secure'] אחרת: ['']),
		SSITE: (שלי אותו-אתר),
		XSID: מזהה-הפעלה
		).
		שלי כותרות הוסף-בסוף: כותרת-הפעלה.
	}.
	שלי נתוני-הפעלה := שלי מנהל-הפעלות עבור: מזהה-הפעלה, טען. <- שלי נתוני-הפעלה. # reference
}.

מסמך-רשת בקבלת: ['עבור-אל:'] בצע: { :כתובת
	עצמי בדוק-כותרות.
	עצמי רוקן-כותרות.
	שלי כותרות
	הוסף-בסוף: (
		כותרת-HTTP חדש
		מפתח: ['Status'] ערך: ['303 See Other']
	),
	הוסף-בסוף: (
		כותרת-HTTP חדש
		מפתח: ['Location'] ערך: כתובת
	).
	עצמי פלוט: ['Redirect'].
}.

מסמך-רשת בקבלת: ['השמד-הפעלה'] בצע: {
	עצמי בדוק-כותרות.
	>> בקשת-http := שלי בקשת-http.
	>> מזהה-הפעלה := בקשת-http cookie: ['xsid'].
	מזהה-הפעלה כלום? אם-שקר: {
		>> כותרת-הפעלה := כותרת-HTTP חדש.
		>> מועד := רגע חדש שנה: 1970, בתבנית: ['%a, %d %b %Y %H:%M:%S GMT'].
		כותרת-הפעלה מפתח: ['Set-Cookie'] ערך: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: מועד,
			SEC: (שלי מאובטח זה: ['Secure'] אחרת: ['']),
			SSITE: (שלי אותו-אתר),
			XSID: מזהה-הפעלה
		).
		שלי מנהל-הפעלות השמד.
		שלי כותרות הוסף-בסוף: כותרת-הפעלה.
	}.
}.


מסמך-רשת בקבלת: ['שבלונה:'] בצע: { :נתיב-קובץ <- שבלונה חדש: (קובץ חדש: נתיב-קובץ, קרא).
}.

מסמך-רשת בקבלת: ['פלוט:סוג:'] בצע: { :תוצאה :סוג
	שלי כותרות-נשלחו אם-שקר: {
		שלי נתוני-הפעלה כלום? אם-שקר: {
			שלי מנהל-הפעלות שמור: שלי נתוני-הפעלה.
		}.
		שלי כותרות הוסף-בסוף: (
			כותרת-HTTP חדש
			מפתח: ['Content-type'] ערך: סוג
		).
		שלי כותרות לכל: { :_ :כותרת
			פלט כתוב: כותרת.
		}.
		שלי כותרות-נשלחו := אמת.
		פלט כתוב: ['\r\n'].
	}.
	פלט כתוב: תוצאה.
}.

מסמך-רשת בקבלת: ['סיים:סוג:'] בצע: { :תוצאה :סוג
	שלי כותרות-נשלחו אם-שקר: {
		שלי נתוני-הפעלה כלום? אם-שקר: {
			שלי מנהל-הפעלות שמור: שלי נתוני-הפעלה.
		}.
		שלי כותרות הוסף-בסוף: (
			כותרת-HTTP חדש
			מפתח: ['Content-type'] ערך: סוג
		).
		שלי כותרות הוסף-בסוף: (
			כותרת-HTTP חדש
			מפתח: ['Content-Length'] ערך: תוצאה למחרוזת בתים
		).
		שלי כותרות לכל: { :_ :כותרת
			פלט כתוב: כותרת.
		}.
		שלי כותרות-נשלחו := אמת.
		פלט כתוב: ['\r\n'].
	}.
	פלט כתוב: תוצאה.
}.

מסמך-רשת בקבלת: ['פלוט:'] בצע: { :תוצאה
	עצמי פלוט: תוצאה סוג: ['text/html; charset=utf-8'].
}.

מסמך-רשת בקבלת: ['סיים:'] בצע: { :תוצאה
	עצמי סיים: תוצאה סוג: ['text/html; charset=utf-8'].
}.

מסמך-רשת בקבלת: ['json:'] בצע: { :תוצאה
	עצמי פלוט: ( JSON jsonify: תוצאה ) סוג: ['application/json'].
}.

מסמך-רשת בקבלת: ['לא-נמצא:'] בצע: { :תוצאה
	עצמי רוקן-כותרות כותרת: (
		כותרת-HTTP חדש מפתח: ['Status'] ערך: ['404 Not Found']
	).
	עצמי פלוט: תוצאה.
}.


# Interface

>> הפעלה := אובייקט חדש.

הפעלה בקבלת: ['חדש'] בצע: { <- עצמי חדש אתחל עבור: כלום.
}.

הפעלה בקבלת: ['עבור:'] בצע: { :id
	שלי id := id.
}.

הפעלה בקבלת: ['טען'] בצע: {
	משימה-זו שגיאה: ['Not implemented.'].
}.

הפעלה בקבלת: ['שמור:'] בצע: {
	משימה-זו שגיאה: ['Not implemented.'].
}.

הפעלה בקבלת: ['השמד'] בצע: {
	משימה-זו שגיאה: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> הפעלה-קובץ-זמני := הפעלה חדש.

הפעלה-קובץ-זמני בקבלת: ['אתחל'] בצע: {
	שלי תחילת-נתיב := ['/tmp/sess-'].
}.

הפעלה-קובץ-זמני בקבלת: ['קידומת-נתיב:'] בצע: { :מחרוזת-טקסט
	שלי תחילת-נתיב := מחרוזת-טקסט.
}.

הפעלה-קובץ-זמני בקבלת: ['קובץ-הפעלה'] בצע: { <- ( קובץ חדש: ( שלי תחילת-נתיב + שלי id + ['.txt'] ) ).
}.

הפעלה-קובץ-זמני בקבלת: ['טען'] בצע: {
	>> קובץ-הפעלה := עצמי קובץ-הפעלה.
	קובץ-הפעלה קיים אם-שקר: {
		קובץ-הפעלה כתוב: (מילון חדש קוד).
	}. <- קובץ-הפעלה קרא לאובייקט.
}.

הפעלה-קובץ-זמני בקבלת: ['שמור:'] בצע: { :נתונים
	>> קובץ-הפעלה := עצמי קובץ-הפעלה.
	קובץ-הפעלה קיים אם-אמת: {
		קובץ-הפעלה כתוב: נתונים קוד.
	}.
}.

הפעלה-קובץ-זמני בקבלת: ['השמד'] בצע: {
	>> קובץ-הפעלה := עצמי קובץ-הפעלה.
	קובץ-הפעלה קיים אם-אמת: {
		קובץ-הפעלה מחק.
	}.
}.


>> URL := אובייקט חדש.

URL בקבלת: ['אתחל'] בצע: {
	שלי פרוטוקול := ['https://'].
	שלי מארח := ['localhost'].
	שלי נתיב-קובץ := [''].
	שלי פרמטרי-url := [''].
	שלי hash := [''].
}.

URL בקבלת: ['חדש'] בצע: { <- עצמי חדש אתחל.
}.

URL בקבלת: ['למחרוזת'] בצע: { <- (
	שלי פרוטוקול +
	שלי מארח +
	שלי נתיב-קובץ +
	שלי פרמטרי-url +
	שלי hash ).
}.

URL בקבלת: ['פרוטוקול:'] בצע: { :פרוטוקול
	((רשימה חדש ; ['http'] ; ['https']) יש: פרוטוקול) אם-אמת: {
		שלי פרוטוקול := פרוטוקול + ['://'].
	}, אם-שקר: {
		משימה-זו שגיאה: ['Invalid protocol'].
	}.
}.

URL בקבלת: ['מארח:'] בצע: { :מארח
	#todo validate according to rfc
	שלי מארח := מארח.
}.

URL בקבלת: ['נתיב-קובץ:'] בצע: { :נתיב-קובץ
	שלי נתיב-קובץ := ['/'] + נתיב-קובץ url-קידוד.
}.

URL בקבלת: ['פרמטרי-url:'] בצע: { :מיפוי
	>> פרמטרי-url := רשימה חדש.
	מיפוי לכל: { :מפתח :ערך
		פרמטרי-url הוסף-בסוף: מפתח למחרוזת url-קידוד + ['='] + ערך למחרוזת url-קידוד.
	}.
	שלי פרמטרי-url := ['?'] + ( פרמטרי-url אחד: ['&'] ).
}.

URL בקבלת: ['גיבוב:'] בצע: { :hash
	שלי hash := ['#'] + hash url-קידוד.
}.

