>> Imeel := Denc xees.

Imeel bu: ['waajal'] def: {
	sama jotkat-yi := Jokkalante xees.
	sama cc := Jokkalante xees.
	sama bcc := Jokkalante xees.
	sama yónnekat := Dara.
	sama turu-yónnekat := Dara.
	sama tëralin := Dara.
	sama yaram := Dara.
}.

Imeel bu: ['xees'] def: { <- man xees waajal.
}.

Imeel bu: ['ci-jotkat:'] def: { :limmu
	sama jotkat-yi := limmu.
}.
 
Imeel bu: ['cc:'] def: { :limmu
	sama cc := limmu.
}.

Imeel bu: ['bcc:'] def: { :limmu
	sama bcc := limmu.
}.

Imeel bu: ['tëralin:'] def: { :tëralin
	sama tëralin := tëralin.
}.

Imeel bu: ['yónnekat:tur:'] def: { :yónnekat :tur
	sama yónnekat := yónnekat.
	sama turu-yónnekat := tur.
}.

Imeel bu: ['yaram:'] def: { :yaram
	sama yaram := yaram.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Imeel bu: ['bopp:'] def: { :rëdd <- rëdd wuutal: ['\r'] ci: [''], wuutal: ['\n'] ci: [''].
}.

Imeel bu: ['yónne'] def: {
	>> f := Dencukaayu tempwrite: man sos.
	Prograam oordinaatëer: ['sendmail -t < '] + f xoll, taxaw.
}.

Imeel bu: ['sos'] def: {
	>> dagg-rëdd := ['\r\n'].
	>> buumu-mbind := [''].
	buumu-mbind yokk-ci-mujj: (man bopp: ['From: '] + sama turu-yónnekat + [' <'] + ( sama yónnekat ) + ['>']) + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: (man bopp: ['To: '] + ( sama jotkat-yi boole: [','] )) + dagg-rëdd.
	sama cc waññ dëgg: {
		buumu-mbind yokk-ci-mujj: (man bopp: ['Cc: '] + ( sama cc boole: [','] )) + dagg-rëdd.
	}.
	sama bcc waññ dëgg: {
		buumu-mbind yokk-ci-mujj: (man bopp: ['Bcc: '] + ( sama bcc boole: [','] )) + dagg-rëdd.
	}.
	buumu-mbind yokk-ci-mujj: (man bopp: ['Subject: '] + sama tëralin) + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: dagg-rëdd.
	buumu-mbind yokk-ci-mujj: sama yaram.
	buumu-mbind yokk-ci-mujj: dagg-rëdd. <- buumu-mbind.
}.

>> Imeel-HTML := Imeel xees.

Imeel-HTML bu: ['waajal'] def: {
	man waajal.
	sama takkukaay-yi := Jokkalante xees.
	sama dig := Wàqu-kaaraange token: 40.
}.

Imeel-HTML bu: ['takk:'] def: { :dencukaayu-ndaje
	>> id := sama takkukaay-yi waññ.
	>> blob := dencukaayu-ndaje blob.
	sama takkukaay-yi yokk-ci-mujj: (
		Listin xees
			dencukaayu-ndaje: dencukaayu-ndaje xoll,
			mime: ['image/'] + (Server mimetype: dencukaayu-ndaje xoll),
			xibaar: blob base64-koode
	).
	blob bàyyi. <- ['cid:attachment'] + id.
}.

Imeel-HTML bu: ['sos'] def: {
	>> dagg-rëdd := ['\r\n'].
	>> buumu-mbind := [''].
	buumu-mbind yokk-ci-mujj: (man bopp: ['From: '] + sama turu-yónnekat + [' <'] + ( sama yónnekat ) + ['>']) + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: (man bopp: ['To: '] + ( sama jotkat-yi boole: [','] )) + dagg-rëdd.
	sama cc waññ dëgg: {
		buumu-mbind yokk-ci-mujj: (man bopp: ['Cc: '] + ( sama cc boole: [','] )) + dagg-rëdd.
	}.
	sama bcc waññ dëgg: {
		buumu-mbind yokk-ci-mujj: (man bopp: ['Bcc: '] + ( sama bcc boole: [','] )) + dagg-rëdd.
	}.
	buumu-mbind yokk-ci-mujj: (man bopp: ['Subject: '] + sama tëralin) + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: ['MIME-Version: 1.0'] + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: ['Content-Type: multipart/related; boundary="'] + sama dig + ['"; type=text/html'] + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: dagg-rëdd.
	buumu-mbind yokk-ci-mujj: ['--'] + sama dig + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: ['Content-Type: text/html; charset=UTF-8'] + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: ['Content-Transfer-Encoding: 7bit'] + dagg-rëdd.
	buumu-mbind yokk-ci-mujj: dagg-rëdd.
	buumu-mbind yokk-ci-mujj: sama yaram.
	buumu-mbind yokk-ci-mujj: dagg-rëdd.
	sama takkukaay-yi kenn-ci-kenn: { :id :xamxam
		>> blob := xamxam xibaar.
		buumu-mbind yokk-ci-mujj: ['--'] + sama dig + dagg-rëdd.
		buumu-mbind yokk-ci-mujj: ['Content-Type: '] + xamxam mime + dagg-rëdd.
		buumu-mbind yokk-ci-mujj: ['Content-Transfer-Encoding: base64'] + dagg-rëdd.
		buumu-mbind yokk-ci-mujj: ['Content-ID: <attachment'] + id + ['>'] + dagg-rëdd.
		buumu-mbind yokk-ci-mujj: ['Content-Disposition: inline; filename="'] + xamxam dencukaayu-ndaje + ['"'] + dagg-rëdd.
		buumu-mbind yokk-ci-mujj: dagg-rëdd.
		>> gën-a-bare := 76.
		>> guddaay-mbind := blob guddaay.
		>> cër-yi := (guddaay-mbind / gën-a-bare) kaw.
		{ :i
			>> cër := blob duppitu dale: i * gën-a-bare guddaay: gën-a-bare.
			buumu-mbind yokk-ci-mujj: cër + dagg-rëdd.
		} * cër-yi.
		buumu-mbind yokk-ci-mujj: dagg-rëdd.
		buumu-mbind yokk-ci-mujj: dagg-rëdd.
	}.
	buumu-mbind yokk-ci-mujj: ['--'] + sama dig + ['--'] + dagg-rëdd. <- buumu-mbind.
}.
