
# ~ Simple template engine ~

>> Royukaay := Denc xees.

Royukaay bu: ['xees'] def: { <- man xees li-ci-biir: [''].
}.

Royukaay bu: ['li-ci-biir:'] def: { :li-ci-biir
	sama li-ci-biir := li-ci-biir. 
}.

Royukaay bu: ['xees:'] def: { :li-ci-biir <- man xees li-ci-biir: li-ci-biir.
}.

Royukaay bu: ['dog:'] def: { :màndarga
	>> màndarga-tàmbali := (['<!-- cut:%id% -->'] %id%: màndarga).
	>> màndarga-mujj := (['<!-- /cut:%id% -->'] %id%: màndarga).
	>> pàcc-yi := sama li-ci-biir xaaj: màndarga-tàmbali.
	>> njëkkaay := pàcc-yi njëkk.
	>> pàcc-yi2 := pàcc-yi mujj xaaj: màndarga-mujj.
	>> mujjaay := pàcc-yi2 mujj.
	>> pàcc := pàcc-yi2 njëkk.
	>> des := njëkkaay + mujjaay.
	sama li-ci-biir := des. <- Royukaay xees: pàcc.
	
}.

Royukaay bu: ['duppitu'] def: { <- man xees: man mbind duppitu.
}.
	
Royukaay bu: ['tapp:ci:'] def: { :tuuti-mbind :id
	>> màndarga-tapp := (['<!-- paste:%id% -->'] %id%: id).
	sama li-ci-biir wuutal: màndarga-tapp ci: ( tuuti-mbind mbind + màndarga-tapp ).
}.

Royukaay bu: ['denc:njëg:'] def: { :barab :njëg
	sama li-ci-biir wuutal: ['<!-- slot:'] + barab + [' -->'] ci: ( Server html-koode: njëg ).
}.

Royukaay bu: ['denc:html:'] def: { :barab :html
	sama li-ci-biir wuutal: ['<!-- slot:'] + barab + [' -->'] ci: html.
}.

Royukaay bu: ['tontu:ak:'] def: { :barab :njëg
	man denc: (barab dale: 0 guddaay: (barab guddaay - 1)) njëg: njëg.
}.

Royukaay bu: ['nl2br'] def: {
	sama li-ci-biir wuutal: ['\n'] ci: ['<br>'].
}.

Royukaay bu: ['setal'] def: {
	sama li-ci-biir :=
		Nataal-seet
		xees: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		méngoo: sama li-ci-biir
		def: { <- ['']. }.
}.

Royukaay bu: ['setal-dog-yi'] def: {
	>> lëf-yi := Jokkalante xees.
	Nataal-seet
	xees: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	méngoo: sama li-ci-biir
	def: { :_ :pàcc
		lëf-yi yokk-ci-mujj: pàcc ? 1.
	}.
	lëf-yi kenn-ci-kenn: { :_ :id
		sama li-ci-biir :=
			Nataal-seet xees: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			méngoo: sama li-ci-biir
			def: { <- ['']. }.
	 }.
}.

Royukaay bu: ['setal-barab-yu-wéer'] def: {
	sama li-ci-biir :=
		Nataal-seet
		xees: ['\\s*\\n'],
		méngoo: sama li-ci-biir
		def: { <- ['\n']. }.
	sama li-ci-biir :=
		Nataal-seet
		xees: ['\\n[\\s\\t]+'],
		méngoo: sama li-ci-biir
		def: { <- ['\n']. }.
}.

Royukaay bu: ['setal-lépp'] def: {
	man setal.
	man setal-dog-yi.
	man setal-barab-yu-wéer.
}.

Royukaay bu: ['mbind'] def: { <- sama li-ci-biir.
}.
