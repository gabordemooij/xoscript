Laaj-HTTP bu: ['HTTP-bopp:'] def: { :caabi <- Prograam jamono: caabi.
}.

>> Bopp-HTTP := Denc xees.

Bopp-HTTP bu: ['xees'] def: { <- man xees waajal.
}.

Bopp-HTTP bu: ['waajal'] def: {
	sama caabi := Dara.
	sama njëg := Dara.
}.

Bopp-HTTP bu: ['caabi:njëg:'] def: { :caabi :njëg
	sama caabi := caabi.
	sama njëg := njëg.
}.

Bopp-HTTP bu: ['caabi'] def: { <- sama caabi.
}.

Bopp-HTTP bu: ['njëg'] def: { <- sama njëg.
}.


Bopp-HTTP bu: ['mbind'] def: {
	>> rëdd := sama caabi + [': '] + sama njëg.
	rëdd wuutal: ['\r'] ci: [''], wuutal: ['\n'] ci: ['']. <- rëdd + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Wérukaay-Web := Denc xees.

Wérukaay-Web bu: ['xees'] def: { <- man xees waajal.
}.

Wérukaay-Web bu: ['waajal'] def: {
	sama bopp-yi := Jokkalante xees.
	sama id-ndaje := Dara.
	sama saytukatu-ndaje := Ndaje-dencukaay-bu-gàtt xees.
	sama xibaaru-ndaje := Dara.
	sama wóor := Dëgg.
	sama dalu-benn := ['Strict'].
	sama bopp-yi-yónne-nañu := Dëkkul.
	sama laaj-http := Laaj-HTTP xees.
}.

Wérukaay-Web bu: ['laaj-http:'] def: { :laaj-http
	sama laaj-http := laaj-http.
}. 

Wérukaay-Web bu: ['kuki-ndaje-bu-wóor:'] def: { :wóor
	man seet-bopp-yi.
	sama wóor := wóor.
}.

Wérukaay-Web bu: ['kuki-ndaje-dalu-benn:'] def: { :njëg
	man seet-bopp-yi.
	>> tànneef := Jokkalante xees 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	tànneef am: njëg, dëkkul: {
		liggéey-bi njuumte: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	sama dalu-benn := njëg.
}.

Wérukaay-Web bu: ['bopp:'] def: { :bopp
	man seet-bopp-yi.
	sama bopp-yi yokk-ci-mujj: bopp.
}.

Wérukaay-Web bu: ['far-bopp-yi'] def: {
	man seet-bopp-yi.
	sama bopp-yi := Jokkalante xees.
}.

Wérukaay-Web bu: ['saytukatu-ndaje:'] def: { :saytukat
	man seet-bopp-yi.
	sama saytukatu-ndaje := saytukat.
}.

Wérukaay-Web bu: ['saytukatu-ndaje'] def: { <- sama saytukatu-ndaje.
}.

Wérukaay-Web bu: ['seet-bopp-yi'] def: {
	sama bopp-yi-yónne-nañu dëgg: {
		liggéey-bi njuumte: ['Headers already sent to client.'].
	}.
}.

Wérukaay-Web bu: ['tàmbali-ndaje'] def: {
	man seet-bopp-yi.
	>> laaj-http := sama laaj-http.
	>> id-ndaje := laaj-http cookie: ['xsid'].
	id-ndaje Dara? dëkkul: {
		(( Nataal-seet xees: ['^[A-Za-z0-9]+\\z'], méngoo: id-ndaje ) = 0) dëgg: {
			id-ndaje := Dara.
		}.
	}.
	id-ndaje Dara? dëgg: {
		id-ndaje := Wàqu-kaaraange token: 30.
		>> boppu-ndaje := Bopp-HTTP xees
		caabi: ['Set-Cookie'] njëg: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (sama wóor mbaa: ['Secure'] mbaa: ['']),
		SSITE: (sama dalu-benn),
		XSID: id-ndaje
		).
		sama bopp-yi yokk-ci-mujj: boppu-ndaje.
	}.
	sama xibaaru-ndaje := sama saytukatu-ndaje ngir: id-ndaje, yeb. <- sama xibaaru-ndaje. # reference
}.

Wérukaay-Web bu: ['dem-ci:'] def: { :dëkkuwaay
	man seet-bopp-yi.
	man far-bopp-yi.
	sama bopp-yi
	yokk-ci-mujj: (
		Bopp-HTTP xees
		caabi: ['Status'] njëg: ['303 See Other']
	),
	yokk-ci-mujj: (
		Bopp-HTTP xees
		caabi: ['Location'] njëg: dëkkuwaay
	).
	man génne: ['Redirect'].
}.

Wérukaay-Web bu: ['yàq-ndaje'] def: {
	man seet-bopp-yi.
	>> laaj-http := sama laaj-http.
	>> id-ndaje := laaj-http cookie: ['xsid'].
	id-ndaje Dara? dëkkul: {
		>> boppu-ndaje := Bopp-HTTP xees.
		>> waxtu-jeex := Waxtu xees at: 1970, melo: ['%a, %d %b %Y %H:%M:%S GMT'].
		boppu-ndaje caabi: ['Set-Cookie'] njëg: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: waxtu-jeex,
			SEC: (sama wóor mbaa: ['Secure'] mbaa: ['']),
			SSITE: (sama dalu-benn),
			XSID: id-ndaje
		).
		sama saytukatu-ndaje yàq.
		sama bopp-yi yokk-ci-mujj: boppu-ndaje.
	}.
}.


Wérukaay-Web bu: ['royukaay:'] def: { :xoll <- Royukaay xees: (Dencukaayu xees: xoll, jàng).
}.

Wérukaay-Web bu: ['génne:xeetu:'] def: { :njeexit :xeetu
	sama bopp-yi-yónne-nañu dëkkul: {
		sama xibaaru-ndaje Dara? dëkkul: {
			sama saytukatu-ndaje dencal: sama xibaaru-ndaje.
		}.
		sama bopp-yi yokk-ci-mujj: (
			Bopp-HTTP xees
			caabi: ['Content-type'] njëg: xeetu
		).
		sama bopp-yi kenn-ci-kenn: { :_ :bopp
			Génn bind: bopp.
		}.
		sama bopp-yi-yónne-nañu := Dëgg.
		Génn bind: ['\r\n'].
	}.
	Génn bind: njeexit.
}.

Wérukaay-Web bu: ['jeexal:xeetu:'] def: { :njeexit :xeetu
	sama bopp-yi-yónne-nañu dëkkul: {
		sama xibaaru-ndaje Dara? dëkkul: {
			sama saytukatu-ndaje dencal: sama xibaaru-ndaje.
		}.
		sama bopp-yi yokk-ci-mujj: (
			Bopp-HTTP xees
			caabi: ['Content-type'] njëg: xeetu
		).
		sama bopp-yi yokk-ci-mujj: (
			Bopp-HTTP xees
			caabi: ['Content-Length'] njëg: njeexit mbind bytes
		).
		sama bopp-yi kenn-ci-kenn: { :_ :bopp
			Génn bind: bopp.
		}.
		sama bopp-yi-yónne-nañu := Dëgg.
		Génn bind: ['\r\n'].
	}.
	Génn bind: njeexit.
}.

Wérukaay-Web bu: ['génne:'] def: { :njeexit
	man génne: njeexit xeetu: ['text/html; charset=utf-8'].
}.

Wérukaay-Web bu: ['jeexal:'] def: { :njeexit
	man jeexal: njeexit xeetu: ['text/html; charset=utf-8'].
}.

Wérukaay-Web bu: ['json:'] def: { :njeexit
	man génne: ( JSON jsonify: njeexit ) xeetu: ['application/json'].
}.

Wérukaay-Web bu: ['gisuñu-ko:'] def: { :njeexit
	man far-bopp-yi bopp: (
		Bopp-HTTP xees caabi: ['Status'] njëg: ['404 Not Found']
	).
	man génne: njeexit.
}.


# Interface

>> Ndaje := Denc xees.

Ndaje bu: ['xees'] def: { <- man xees waajal ngir: Dara.
}.

Ndaje bu: ['ngir:'] def: { :id
	sama id := id.
}.

Ndaje bu: ['yeb'] def: {
	liggéey-bi njuumte: ['Not implemented.'].
}.

Ndaje bu: ['dencal:'] def: {
	liggéey-bi njuumte: ['Not implemented.'].
}.

Ndaje bu: ['yàq'] def: {
	liggéey-bi njuumte: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Ndaje-dencukaay-bu-gàtt := Ndaje xees.

Ndaje-dencukaay-bu-gàtt bu: ['waajal'] def: {
	sama tàmbalikuy-yoon := ['/tmp/sess-'].
}.

Ndaje-dencukaay-bu-gàtt bu: ['njëkk-yoon:'] def: { :buumu-mbind
	sama tàmbalikuy-yoon := buumu-mbind.
}.

Ndaje-dencukaay-bu-gàtt bu: ['dencukaayu-ndaje'] def: { <- ( Dencukaayu xees: ( sama tàmbalikuy-yoon + sama id + ['.txt'] ) ).
}.

Ndaje-dencukaay-bu-gàtt bu: ['yeb'] def: {
	>> dencukaayu-ndaje := man dencukaayu-ndaje.
	dencukaayu-ndaje nekk dëkkul: {
		dencukaayu-ndaje bind: (Listin xees koodu).
	}. <- dencukaayu-ndaje jàng denc.
}.

Ndaje-dencukaay-bu-gàtt bu: ['dencal:'] def: { :xibaar
	>> dencukaayu-ndaje := man dencukaayu-ndaje.
	dencukaayu-ndaje nekk dëgg: {
		dencukaayu-ndaje bind: xibaar koodu.
	}.
}.

Ndaje-dencukaay-bu-gàtt bu: ['yàq'] def: {
	>> dencukaayu-ndaje := man dencukaayu-ndaje.
	dencukaayu-ndaje nekk dëgg: {
		dencukaayu-ndaje far.
	}.
}.


>> URL := Denc xees.

URL bu: ['waajal'] def: {
	sama pàttali := ['https://'].
	sama dalalkat := ['localhost'].
	sama xoll := [''].
	sama paramet-url := [''].
	sama hash := [''].
}.

URL bu: ['xees'] def: { <- man xees waajal.
}.

URL bu: ['mbind'] def: { <- (
	sama pàttali +
	sama dalalkat +
	sama xoll +
	sama paramet-url +
	sama hash ).
}.

URL bu: ['pàttali:'] def: { :pàttali
	((Jokkalante xees ; ['http'] ; ['https']) am: pàttali) dëgg: {
		sama pàttali := pàttali + ['://'].
	}, dëkkul: {
		liggéey-bi njuumte: ['Invalid protocol'].
	}.
}.

URL bu: ['dalalkat:'] def: { :dalalkat
	#todo validate according to rfc
	sama dalalkat := dalalkat.
}.

URL bu: ['xoll:'] def: { :xoll
	sama xoll := ['/'] + xoll url-koode.
}.

URL bu: ['paramet-url:'] def: { :natal
	>> paramet-url := Jokkalante xees.
	natal kenn-ci-kenn: { :caabi :njëg
		paramet-url yokk-ci-mujj: caabi mbind url-koode + ['='] + njëg mbind url-koode.
	}.
	sama paramet-url := ['?'] + ( paramet-url boole: ['&'] ).
}.

URL bu: ['xaatim:'] def: { :hash
	sama hash := ['#'] + hash url-koode.
}.

