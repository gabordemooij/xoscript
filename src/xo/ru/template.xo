
# ~ Simple template engine ~

>> Заготовка := Объект новый.

Заготовка в: ['новый'] сделать: { <- сам новый содержимое: [''].
}.

Заготовка в: ['содержимое:'] сделать: { :содержимое
	мой содержимое := содержимое. 
}.

Заготовка в: ['новый:'] сделать: { :содержимое <- сам новый содержимое: содержимое.
}.

Заготовка в: ['вырезать:'] сделать: { :маркер
	>> начальный-маркер := (['<!-- cut:%id% -->'] %id%: маркер).
	>> конечный-маркер := (['<!-- /cut:%id% -->'] %id%: маркер).
	>> части := мой содержимое разделить: начальный-маркер.
	>> префикс := части первый.
	>> части2 := части последний разделить: конечный-маркер.
	>> суффикс := части2 последний.
	>> часть := части2 первый.
	>> остаток := префикс + суффикс.
	мой содержимое := остаток. <- Заготовка новый: часть.
	
}.

Заготовка в: ['скопировать'] сделать: { <- сам новый: сам к-тексту скопировать.
}.
	
Заготовка в: ['вставить:в:'] сделать: { :фрагмент-html :id
	>> маркер-вставки := (['<!-- paste:%id% -->'] %id%: id).
	мой содержимое заменить: маркер-вставки на: ( фрагмент-html к-тексту + маркер-вставки ).
}.

Заготовка в: ['задать:значение:'] сделать: { :слот :величина
	мой содержимое заменить: ['<!-- slot:'] + слот + [' -->'] на: ( Server html-кодировать: величина ).
}.

Заготовка в: ['задать:html:'] сделать: { :слот :html
	мой содержимое заменить: ['<!-- slot:'] + слот + [' -->'] на: html.
}.

Заготовка в: ['ответить:и:'] сделать: { :слот :величина
	сам задать: (слот от: 0 длина: (слот длина - 1)) значение: величина.
}.

Заготовка в: ['nl2br'] сделать: {
	мой содержимое заменить: ['\n'] на: ['<br>'].
}.

Заготовка в: ['подчистить'] сделать: {
	мой содержимое :=
		Шаблон
		новый: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		совпадение: мой содержимое
		выполнить: { <- ['']. }.
}.

Заготовка в: ['подчистить-вырезки'] сделать: {
	>> элементы := Список новый.
	Шаблон
	новый: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	совпадение: мой содержимое
	выполнить: { :_ :часть
		элементы добавить-в-конец: часть ? 1.
	}.
	элементы каждый: { :_ :id
		мой содержимое :=
			Шаблон новый: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			совпадение: мой содержимое
			выполнить: { <- ['']. }.
	 }.
}.

Заготовка в: ['подчистить-пробелы'] сделать: {
	мой содержимое :=
		Шаблон
		новый: ['\\s*\\n'],
		совпадение: мой содержимое
		выполнить: { <- ['\n']. }.
	мой содержимое :=
		Шаблон
		новый: ['\\n[\\s\\t]+'],
		совпадение: мой содержимое
		выполнить: { <- ['\n']. }.
}.

Заготовка в: ['подчистить-всё'] сделать: {
	сам подчистить.
	сам подчистить-вырезки.
	сам подчистить-пробелы.
}.

Заготовка в: ['к-тексту'] сделать: { <- мой содержимое.
}.
