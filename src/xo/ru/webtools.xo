HTTP-запрос в: ['HTTP-заголовок:'] сделать: { :ключ <- Программа конфигурация: ключ.
}.

>> HTTP-Заголовок := Объект новый.

HTTP-Заголовок в: ['новый'] сделать: { <- сам новый инициализировать.
}.

HTTP-Заголовок в: ['инициализировать'] сделать: {
	мой ключ := Пустой.
	мой величина := Пустой.
}.

HTTP-Заголовок в: ['ключ:величина:'] сделать: { :ключ :величина
	мой ключ := ключ.
	мой величина := величина.
}.

HTTP-Заголовок в: ['ключ'] сделать: { <- мой ключ.
}.

HTTP-Заголовок в: ['величина'] сделать: { <- мой величина.
}.


HTTP-Заголовок в: ['к-тексту'] сделать: {
	>> линия := мой ключ + [': '] + мой величина.
	линия заменить: ['\r'] на: [''], заменить: ['\n'] на: ['']. <- линия + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Объект новый.

Веб-документ в: ['новый'] сделать: { <- сам новый инициализировать.
}.

Веб-документ в: ['инициализировать'] сделать: {
	мой заголовки := Список новый.
	мой ид-сессии := Пустой.
	мой менеджер-сессий := Сессия-временный-файл новый.
	мой данные-сессии := Пустой.
	мой защищено := Истина.
	мой тот-же-сайт := ['Strict'].
	мой заголовки-отправлены := Ложь.
	мой http-запрос := HTTP-запрос новый.
}.

Веб-документ в: ['http-запрос:'] сделать: { :http-запрос
	мой http-запрос := http-запрос.
}. 

Веб-документ в: ['защищённый-cookie-сессии:'] сделать: { :защищено
	сам проверить-заголовки.
	мой защищено := защищено.
}.

Веб-документ в: ['cookie-сессии-same-site:'] сделать: { :величина
	сам проверить-заголовки.
	>> настройки := Список новый 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	настройки имеет: величина, ложь: {
		этот-блок-кода ошибка: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	мой тот-же-сайт := величина.
}.

Веб-документ в: ['заголовок:'] сделать: { :заголовок
	сам проверить-заголовки.
	мой заголовки добавить-в-конец: заголовок.
}.

Веб-документ в: ['сбросить-заголовки'] сделать: {
	сам проверить-заголовки.
	мой заголовки := Список новый.
}.

Веб-документ в: ['менеджер-сессий:'] сделать: { :менеджер
	сам проверить-заголовки.
	мой менеджер-сессий := менеджер.
}.

Веб-документ в: ['менеджер-сессий'] сделать: { <- мой менеджер-сессий.
}.

Веб-документ в: ['проверить-заголовки'] сделать: {
	мой заголовки-отправлены истина: {
		этот-блок-кода ошибка: ['Headers already sent to client.'].
	}.
}.

Веб-документ в: ['начать-сессию'] сделать: {
	сам проверить-заголовки.
	>> http-запрос := мой http-запрос.
	>> ид-сессии := http-запрос cookie: ['xsid'].
	ид-сессии пустой? ложь: {
		(( Шаблон новый: ['^[A-Za-z0-9]+\\z'], совпадение: ид-сессии ) = 0) истина: {
			ид-сессии := Пустой.
		}.
	}.
	ид-сессии пустой? истина: {
		ид-сессии := Хранилище токен: 30.
		>> заголовок-сессии := HTTP-Заголовок новый
		ключ: ['Set-Cookie'] величина: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (мой защищено либо: ['Secure'] или: ['']),
		SSITE: (мой тот-же-сайт),
		XSID: ид-сессии
		).
		мой заголовки добавить-в-конец: заголовок-сессии.
	}.
	мой данные-сессии := мой менеджер-сессий для: ид-сессии, загрузить. <- мой данные-сессии. # reference
}.

Веб-документ в: ['перейти-к:'] сделать: { :адрес
	сам проверить-заголовки.
	сам сбросить-заголовки.
	мой заголовки
	добавить-в-конец: (
		HTTP-Заголовок новый
		ключ: ['Status'] величина: ['303 See Other']
	),
	добавить-в-конец: (
		HTTP-Заголовок новый
		ключ: ['Location'] величина: адрес
	).
	сам вывести: ['Redirect'].
}.

Веб-документ в: ['уничтожить-сессию'] сделать: {
	сам проверить-заголовки.
	>> http-запрос := мой http-запрос.
	>> ид-сессии := http-запрос cookie: ['xsid'].
	ид-сессии пустой? ложь: {
		>> заголовок-сессии := HTTP-Заголовок новый.
		>> момент := Момент новый год: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		заголовок-сессии ключ: ['Set-Cookie'] величина: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: момент,
			SEC: (мой защищено либо: ['Secure'] или: ['']),
			SSITE: (мой тот-же-сайт),
			XSID: ид-сессии
		).
		мой менеджер-сессий уничтожить.
		мой заголовки добавить-в-конец: заголовок-сессии.
	}.
}.


Веб-документ в: ['заготовка:'] сделать: { :путь <- Заготовка новый: (Файл новый: путь, прочитать).
}.

Веб-документ в: ['вывести:тип:'] сделать: { :вывод :тип
	мой заголовки-отправлены ложь: {
		мой данные-сессии пустой? ложь: {
			мой менеджер-сессий сохранить: мой данные-сессии.
		}.
		мой заголовки добавить-в-конец: (
			HTTP-Заголовок новый
			ключ: ['Content-type'] величина: тип
		).
		мой заголовки каждый: { :_ :заголовок
			Выход написать: заголовок.
		}.
		мой заголовки-отправлены := Истина.
		Выход написать: ['\r\n'].
	}.
	Выход написать: вывод.
}.

Веб-документ в: ['завершить:тип:'] сделать: { :вывод :тип
	мой заголовки-отправлены ложь: {
		мой данные-сессии пустой? ложь: {
			мой менеджер-сессий сохранить: мой данные-сессии.
		}.
		мой заголовки добавить-в-конец: (
			HTTP-Заголовок новый
			ключ: ['Content-type'] величина: тип
		).
		мой заголовки добавить-в-конец: (
			HTTP-Заголовок новый
			ключ: ['Content-Length'] величина: вывод к-тексту bytes
		).
		мой заголовки каждый: { :_ :заголовок
			Выход написать: заголовок.
		}.
		мой заголовки-отправлены := Истина.
		Выход написать: ['\r\n'].
	}.
	Выход написать: вывод.
}.

Веб-документ в: ['вывести:'] сделать: { :вывод
	сам вывести: вывод тип: ['text/html; charset=utf-8'].
}.

Веб-документ в: ['завершить:'] сделать: { :вывод
	сам завершить: вывод тип: ['text/html; charset=utf-8'].
}.

Веб-документ в: ['json:'] сделать: { :вывод
	сам вывести: ( JSON jsonify: вывод ) тип: ['application/json'].
}.

Веб-документ в: ['не-найдено:'] сделать: { :вывод
	сам сбросить-заголовки заголовок: (
		HTTP-Заголовок новый ключ: ['Status'] величина: ['404 Not Found']
	).
	сам вывести: вывод.
}.


# Interface

>> Сессия := Объект новый.

Сессия в: ['новый'] сделать: { <- сам новый инициализировать для: Пустой.
}.

Сессия в: ['для:'] сделать: { :id
	мой id := id.
}.

Сессия в: ['загрузить'] сделать: {
	этот-блок-кода ошибка: ['Not implemented.'].
}.

Сессия в: ['сохранить:'] сделать: {
	этот-блок-кода ошибка: ['Not implemented.'].
}.

Сессия в: ['уничтожить'] сделать: {
	этот-блок-кода ошибка: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Сессия-временный-файл := Сессия новый.

Сессия-временный-файл в: ['инициализировать'] сделать: {
	мой начало-пути := ['/tmp/sess-'].
}.

Сессия-временный-файл в: ['префикс-пути:'] сделать: { :строчка
	мой начало-пути := строчка.
}.

Сессия-временный-файл в: ['файл'] сделать: { <- ( Файл новый: ( мой начало-пути + мой id + ['.txt'] ) ).
}.

Сессия-временный-файл в: ['загрузить'] сделать: {
	>> файл := сам файл.
	файл существует ложь: {
		файл написать: (Карта новый код).
	}. <- файл прочитать объект.
}.

Сессия-временный-файл в: ['сохранить:'] сделать: { :данные
	>> файл := сам файл.
	файл существует истина: {
		файл написать: данные код.
	}.
}.

Сессия-временный-файл в: ['уничтожить'] сделать: {
	>> файл := сам файл.
	файл существует истина: {
		файл удалить.
	}.
}.


>> URL := Объект новый.

URL в: ['инициализировать'] сделать: {
	мой протокол := ['https://'].
	мой хост := ['localhost'].
	мой путь := [''].
	мой параметры-url := [''].
	мой hash := [''].
}.

URL в: ['новый'] сделать: { <- сам новый инициализировать.
}.

URL в: ['к-тексту'] сделать: { <- (
	мой протокол +
	мой хост +
	мой путь +
	мой параметры-url +
	мой hash ).
}.

URL в: ['протокол:'] сделать: { :протокол
	((Список новый ; ['http'] ; ['https']) имеет: протокол) истина: {
		мой протокол := протокол + ['://'].
	}, ложь: {
		этот-блок-кода ошибка: ['Invalid protocol'].
	}.
}.

URL в: ['хост:'] сделать: { :хост
	#todo validate according to rfc
	мой хост := хост.
}.

URL в: ['путь:'] сделать: { :путь
	мой путь := ['/'] + путь url-кодировать.
}.

URL в: ['параметры-url:'] сделать: { :сопоставление
	>> параметры-url := Список новый.
	сопоставление каждый: { :ключ :величина
		параметры-url добавить-в-конец: ключ к-тексту url-кодировать + ['='] + величина к-тексту url-кодировать.
	}.
	мой параметры-url := ['?'] + ( параметры-url присоединить: ['&'] ).
}.

URL в: ['хеш:'] сделать: { :hash
	мой hash := ['#'] + hash url-кодировать.
}.

