# Default Session implementation, uses tempfile

>> Tempfile-Session := Session новый.

Tempfile-Session в: ['init'] сделать: {
	мой pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session в: ['path-prefix:'] сделать: { :str
	мой pathprefix := str.
}.

Tempfile-Session в: ['file'] сделать: { <- ( Файл новый: ( мой pathprefix + мой id + ['.txt'] ) ).
}.

Tempfile-Session в: ['load'] сделать: {
	>> file := сам file.
	file существует ложь: {
		file написать: (Карта новый код).
	}. <- file прочитать объект.
}.

Tempfile-Session в: ['save:'] сделать: { :data
	>> file := сам file.
	file существует истина: {
		file написать: data код.
	}.
}.

Tempfile-Session в: ['destroy'] сделать: {
	>> file := сам file.
	file существует истина: {
		file удалить.
	}.
}.


>> URL := Объект новый.

URL в: ['init'] сделать: {
	мой protocol := ['https://'].
	мой хост := ['localhost'].
	мой путь := [''].
	мой params := [''].
	мой hash := [''].
}.

URL в: ['новый'] сделать: { <- сам новый init.
}.

URL в: ['к-тексту'] сделать: { <- (
	мой protocol +
	мой хост +
	мой путь +
	мой params +
	мой hash ).
}.

URL в: ['protocol:'] сделать: { :protocol
	((Список новый: ['http'] ; ['https']) содержит: protocol) истина: {
		мой protocol := protocol + ['://'].
	}, ложь: {
		этот-блок-кода ошибка: ['Invalid protocol'].
	}.
}.

URL в: ['хост:'] сделать: { :хост
	#todo validate according to rfc
	мой хост := хост.
}.

URL в: ['path:'] сделать: { :путь
	мой путь := ['/'] + путь url-кодировать.
}.

URL в: ['params:'] сделать: { :map
	>> params := Список новый.
	map каждый: { :key :value
		params добавить-в-конец: key к-тексту url-кодировать + ['='] + value к-тексту url-кодировать.
	}.
	мой params := ['?'] + ( params присоединить: ['&'] ).
}.

URL в: ['хеш:'] сделать: { :hash
	мой hash := ['#'] + hash url-кодировать.
}.

