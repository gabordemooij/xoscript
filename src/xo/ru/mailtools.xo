>> Письмо := Объект новый.

Письмо в: ['инициализировать'] сделать: {
	мой получатели := Список новый.
	мой cc := Список новый.
	мой bcc := Список новый.
	мой отправитель := Пустой.
	мой имя-отправителя := Пустой.
	мой тема := Пустой.
	мой тело := Пустой.
}.

Письмо в: ['новый'] сделать: { <- сам новый инициализировать.
}.

Письмо в: ['кому:'] сделать: { :перечень
	мой получатели := перечень.
}.
 
Письмо в: ['cc:'] сделать: { :перечень
	мой cc := перечень.
}.

Письмо в: ['bcc:'] сделать: { :перечень
	мой bcc := перечень.
}.

Письмо в: ['тема:'] сделать: { :тема
	мой тема := тема.
}.

Письмо в: ['отправитель:имя:'] сделать: { :отправитель :имя
	мой отправитель := отправитель.
	мой имя-отправителя := имя.
}.

Письмо в: ['тело:'] сделать: { :тело
	мой тело := тело.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Письмо в: ['заголовок:'] сделать: { :линия <- линия заменить: ['\r'] на: [''], заменить: ['\n'] на: [''].
}.

Письмо в: ['отправить'] сделать: {
	>> f := Файл tempwrite: сам сгенерировать.
	Программа Системная-команда: ['sendmail -t < '] + f путь, стоп.
}.

Письмо в: ['сгенерировать'] сделать: {
	>> перенос := ['\r\n'].
	>> строчка := [''].
	строчка добавить-в-конец: (сам заголовок: ['From: '] + мой имя-отправителя + [' <'] + ( мой отправитель ) + ['>']) + перенос.
	строчка добавить-в-конец: (сам заголовок: ['To: '] + ( мой получатели присоединить: [','] )) + перенос.
	мой cc счетчик истина: {
		строчка добавить-в-конец: (сам заголовок: ['Cc: '] + ( мой cc присоединить: [','] )) + перенос.
	}.
	мой bcc счетчик истина: {
		строчка добавить-в-конец: (сам заголовок: ['Bcc: '] + ( мой bcc присоединить: [','] )) + перенос.
	}.
	строчка добавить-в-конец: (сам заголовок: ['Subject: '] + мой тема) + перенос.
	строчка добавить-в-конец: перенос.
	строчка добавить-в-конец: мой тело.
	строчка добавить-в-конец: перенос. <- строчка.
}.

>> HTML-Письмо := Письмо новый.

HTML-Письмо в: ['инициализировать'] сделать: {
	сам инициализировать.
	мой вложения := Список новый.
	мой граница := Хранилище токен: 40.
}.

HTML-Письмо в: ['прикрепить:'] сделать: { :файл
	>> id := мой вложения счетчик.
	>> blob := файл blob.
	мой вложения добавить-в-конец: (
		Карта новый
			файл: файл путь,
			mime: ['image/'] + (Server mimetype: файл путь),
			данные: blob base64-кодировать
	).
	blob свободно. <- ['cid:attachment'] + id.
}.

HTML-Письмо в: ['сгенерировать'] сделать: {
	>> перенос := ['\r\n'].
	>> строчка := [''].
	строчка добавить-в-конец: (сам заголовок: ['From: '] + мой имя-отправителя + [' <'] + ( мой отправитель ) + ['>']) + перенос.
	строчка добавить-в-конец: (сам заголовок: ['To: '] + ( мой получатели присоединить: [','] )) + перенос.
	мой cc счетчик истина: {
		строчка добавить-в-конец: (сам заголовок: ['Cc: '] + ( мой cc присоединить: [','] )) + перенос.
	}.
	мой bcc счетчик истина: {
		строчка добавить-в-конец: (сам заголовок: ['Bcc: '] + ( мой bcc присоединить: [','] )) + перенос.
	}.
	строчка добавить-в-конец: (сам заголовок: ['Subject: '] + мой тема) + перенос.
	строчка добавить-в-конец: ['MIME-Version: 1.0'] + перенос.
	строчка добавить-в-конец: ['Content-Type: multipart/related; boundary="'] + мой граница + ['"; type=text/html'] + перенос.
	строчка добавить-в-конец: перенос.
	строчка добавить-в-конец: ['--'] + мой граница + перенос.
	строчка добавить-в-конец: ['Content-Type: text/html; charset=UTF-8'] + перенос.
	строчка добавить-в-конец: ['Content-Transfer-Encoding: 7bit'] + перенос.
	строчка добавить-в-конец: перенос.
	строчка добавить-в-конец: мой тело.
	строчка добавить-в-конец: перенос.
	мой вложения каждый: { :id :инфо
		>> blob := инфо данные.
		строчка добавить-в-конец: ['--'] + мой граница + перенос.
		строчка добавить-в-конец: ['Content-Type: '] + инфо mime + перенос.
		строчка добавить-в-конец: ['Content-Transfer-Encoding: base64'] + перенос.
		строчка добавить-в-конец: ['Content-ID: <attachment'] + id + ['>'] + перенос.
		строчка добавить-в-конец: ['Content-Disposition: inline; filename="'] + инфо файл + ['"'] + перенос.
		строчка добавить-в-конец: перенос.
		>> предел := 76.
		>> длина-текста := blob длина.
		>> куски := (длина-текста / предел) больше.
		{ :i
			>> кусок := blob скопировать от: i * предел длина: предел.
			строчка добавить-в-конец: кусок + перенос.
		} * куски.
		строчка добавить-в-конец: перенос.
		строчка добавить-в-конец: перенос.
	}.
	строчка добавить-в-конец: ['--'] + мой граница + ['--'] + перенос. <- строчка.
}.
