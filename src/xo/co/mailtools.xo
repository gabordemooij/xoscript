>> Email := Ughjettu novu.

Email quandu: ['inizializà'] fà: {
	propiu destinatarii := Lista novu.
	propiu cc := Lista novu.
	propiu bcc := Lista novu.
	propiu mittente := Nunda.
	propiu nome-mittente := Nunda.
	propiu oggettu := Nunda.
	propiu corpu := Nunda.
}.

Email quandu: ['novu'] fà: { <- sè novu inizializà.
}.

Email quandu: ['destinatariu:'] fà: { :elencu
	propiu destinatarii := elencu.
}.
 
Email quandu: ['cc:'] fà: { :elencu
	propiu cc := elencu.
}.

Email quandu: ['bcc:'] fà: { :elencu
	propiu bcc := elencu.
}.

Email quandu: ['oggettu:'] fà: { :oggettu
	propiu oggettu := oggettu.
}.

Email quandu: ['mittente:nome:'] fà: { :mittente :nome
	propiu mittente := mittente.
	propiu nome-mittente := nome.
}.

Email quandu: ['corpu:'] fà: { :corpu
	propiu corpu := corpu.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email quandu: ['intestatura:'] fà: { :linea <- linea rimpiazzà: ['\r'] cù: [''], rimpiazzà: ['\n'] cù: [''].
}.

Email quandu: ['mandà'] fà: {
	>> f := Schedariu tempwrite: sè generà.
	Prugramma sistema: ['sendmail -t < '] + f caminu-di-schedariu, linea-nova.
}.

Email quandu: ['generà'] fà: {
	>> ritornu := ['\r\n'].
	>> catena := [''].
	catena aghjunghje-à-a-fine: (sè intestatura: ['From: '] + propiu nome-mittente + [' <'] + ( propiu mittente ) + ['>']) + ritornu.
	catena aghjunghje-à-a-fine: (sè intestatura: ['To: '] + ( propiu destinatarii unisce: [','] )) + ritornu.
	propiu cc cuntà veru: {
		catena aghjunghje-à-a-fine: (sè intestatura: ['Cc: '] + ( propiu cc unisce: [','] )) + ritornu.
	}.
	propiu bcc cuntà veru: {
		catena aghjunghje-à-a-fine: (sè intestatura: ['Bcc: '] + ( propiu bcc unisce: [','] )) + ritornu.
	}.
	catena aghjunghje-à-a-fine: (sè intestatura: ['Subject: '] + propiu oggettu) + ritornu.
	catena aghjunghje-à-a-fine: ritornu.
	catena aghjunghje-à-a-fine: propiu corpu.
	catena aghjunghje-à-a-fine: ritornu. <- catena.
}.

>> Email-HTML := Email novu.

Email-HTML quandu: ['inizializà'] fà: {
	sè inizializà.
	propiu aghjunte := Lista novu.
	propiu cunfine := Cascia-forte gettone: 40.
}.

Email-HTML quandu: ['attaccà:'] fà: { :schedariu
	>> id := propiu aghjunte cuntà.
	>> blob := schedariu blob.
	propiu aghjunte aghjunghje-à-a-fine: (
		Dizziunariu novu
			schedariu: schedariu caminu-di-schedariu,
			mime: ['image/'] + (Server mimetype: schedariu caminu-di-schedariu),
			dati: blob base64-cudificà
	).
	blob liberà. <- ['cid:attachment'] + id.
}.

Email-HTML quandu: ['generà'] fà: {
	>> ritornu := ['\r\n'].
	>> catena := [''].
	catena aghjunghje-à-a-fine: (sè intestatura: ['From: '] + propiu nome-mittente + [' <'] + ( propiu mittente ) + ['>']) + ritornu.
	catena aghjunghje-à-a-fine: (sè intestatura: ['To: '] + ( propiu destinatarii unisce: [','] )) + ritornu.
	propiu cc cuntà veru: {
		catena aghjunghje-à-a-fine: (sè intestatura: ['Cc: '] + ( propiu cc unisce: [','] )) + ritornu.
	}.
	propiu bcc cuntà veru: {
		catena aghjunghje-à-a-fine: (sè intestatura: ['Bcc: '] + ( propiu bcc unisce: [','] )) + ritornu.
	}.
	catena aghjunghje-à-a-fine: (sè intestatura: ['Subject: '] + propiu oggettu) + ritornu.
	catena aghjunghje-à-a-fine: ['MIME-Version: 1.0'] + ritornu.
	catena aghjunghje-à-a-fine: ['Content-Type: multipart/related; boundary="'] + propiu cunfine + ['"; type=text/html'] + ritornu.
	catena aghjunghje-à-a-fine: ritornu.
	catena aghjunghje-à-a-fine: ['--'] + propiu cunfine + ritornu.
	catena aghjunghje-à-a-fine: ['Content-Type: text/html; charset=UTF-8'] + ritornu.
	catena aghjunghje-à-a-fine: ['Content-Transfer-Encoding: 7bit'] + ritornu.
	catena aghjunghje-à-a-fine: ritornu.
	catena aghjunghje-à-a-fine: propiu corpu.
	catena aghjunghje-à-a-fine: ritornu.
	propiu aghjunte ognunu: { :id :info
		>> blob := info dati.
		catena aghjunghje-à-a-fine: ['--'] + propiu cunfine + ritornu.
		catena aghjunghje-à-a-fine: ['Content-Type: '] + info mime + ritornu.
		catena aghjunghje-à-a-fine: ['Content-Transfer-Encoding: base64'] + ritornu.
		catena aghjunghje-à-a-fine: ['Content-ID: <attachment'] + id + ['>'] + ritornu.
		catena aghjunghje-à-a-fine: ['Content-Disposition: inline; filename="'] + info schedariu + ['"'] + ritornu.
		catena aghjunghje-à-a-fine: ritornu.
		>> tettu := 76.
		>> lunghezza-testu := blob lunghezza.
		>> pezzi := (lunghezza-testu / tettu) arrutundà-insù.
		{ :i
			>> pezzu := blob cupià da: i * tettu lunghezza: tettu.
			catena aghjunghje-à-a-fine: pezzu + ritornu.
		} * pezzi.
		catena aghjunghje-à-a-fine: ritornu.
		catena aghjunghje-à-a-fine: ritornu.
	}.
	catena aghjunghje-à-a-fine: ['--'] + propiu cunfine + ['--'] + ritornu. <- catena.
}.
