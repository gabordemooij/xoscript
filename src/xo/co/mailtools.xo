>> Email := Ughjettu novu.

Email quandu: ['init'] fà: {
	propiu recipients := Lista novu.
	propiu cc := Lista novu.
	propiu bcc := Lista novu.
	propiu from := Nunda.
	propiu from-name := Nunda.
	propiu subject := Nunda.
	propiu body := Nunda.
}.

Email quandu: ['novu'] fà: { <- sè novu init.
}.

Email quandu: ['to:'] fà: { :list
	propiu recipients := list.
}.
 
Email quandu: ['cc:'] fà: { :list
	propiu cc := list.
}.

Email quandu: ['bcc:'] fà: { :list
	propiu bcc := list.
}.

Email quandu: ['subject:'] fà: { :subject
	propiu subject := subject.
}.

Email quandu: ['from:name:'] fà: { :from :nome
	propiu from := from.
	propiu from-name := nome.
}.

Email quandu: ['body:'] fà: { :body
	propiu body := body.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Email quandu: ['header:'] fà: { :line <- line rimpiazzà: ['\r'] cù: [''], rimpiazzà: ['\n'] cù: [''].
}.

Email quandu: ['send'] fà: {
	>> f := Schedariu tempwrite: sè generate.
	Prugramma sistema: ['sendmail -t < '] + f caminu-di-schedariu, linea-nova.
}.

Email quandu: ['generate'] fà: {
	>> brk := ['\r\n'].
	>> str := [''].
	str aghjunghje-à-a-fine: (sè header: ['From: '] + propiu from-name + [' <'] + ( propiu from ) + ['>']) + brk.
	str aghjunghje-à-a-fine: (sè header: ['To: '] + ( propiu recipients unisce: [','] )) + brk.
	propiu cc cuntà veru: {
		str aghjunghje-à-a-fine: (sè header: ['Cc: '] + ( propiu cc unisce: [','] )) + brk.
	}.
	propiu bcc cuntà veru: {
		str aghjunghje-à-a-fine: (sè header: ['Bcc: '] + ( propiu bcc unisce: [','] )) + brk.
	}.
	str aghjunghje-à-a-fine: (sè header: ['Subject: '] + propiu subject) + brk.
	str aghjunghje-à-a-fine: brk.
	str aghjunghje-à-a-fine: propiu body.
	str aghjunghje-à-a-fine: brk. <- str.
}.

>> HTML-Email := Email novu.

HTML-Email quandu: ['init'] fà: {
	sè init.
	propiu attachments := Lista novu.
	propiu boundary := Cascia-forte gettone: 40.
}.

HTML-Email quandu: ['attach:'] fà: { :file
	>> id := propiu attachments cuntà.
	>> blob := file blob.
	propiu attachments aghjunghje-à-a-fine: (
		Dizziunariu novu
			file: file caminu-di-schedariu,
			mime: ['image/'] + (Server mimetype: file caminu-di-schedariu),
			data: blob base64-cudificà
	).
	blob liberà. <- ['cid:attachment'] + id.
}.

HTML-Email quandu: ['generate'] fà: {
	>> brk := ['\r\n'].
	>> str := [''].
	str aghjunghje-à-a-fine: (sè header: ['From: '] + propiu from-name + [' <'] + ( propiu from ) + ['>']) + brk.
	str aghjunghje-à-a-fine: (sè header: ['To: '] + ( propiu recipients unisce: [','] )) + brk.
	propiu cc cuntà veru: {
		str aghjunghje-à-a-fine: (sè header: ['Cc: '] + ( propiu cc unisce: [','] )) + brk.
	}.
	propiu bcc cuntà veru: {
		str aghjunghje-à-a-fine: (sè header: ['Bcc: '] + ( propiu bcc unisce: [','] )) + brk.
	}.
	str aghjunghje-à-a-fine: (sè header: ['Subject: '] + propiu subject) + brk.
	str aghjunghje-à-a-fine: ['MIME-Version: 1.0'] + brk.
	str aghjunghje-à-a-fine: ['Content-Type: multipart/related; boundary="'] + propiu boundary + ['"; type=text/html'] + brk.
	str aghjunghje-à-a-fine: brk.
	str aghjunghje-à-a-fine: ['--'] + propiu boundary + brk.
	str aghjunghje-à-a-fine: ['Content-Type: text/html; charset=UTF-8'] + brk.
	str aghjunghje-à-a-fine: ['Content-Transfer-Encoding: 7bit'] + brk.
	str aghjunghje-à-a-fine: brk.
	str aghjunghje-à-a-fine: propiu body.
	str aghjunghje-à-a-fine: brk.
	propiu attachments ognunu: { :id :info
		>> blob := info data.
		str aghjunghje-à-a-fine: ['--'] + propiu boundary + brk.
		str aghjunghje-à-a-fine: ['Content-Type: '] + info mime + brk.
		str aghjunghje-à-a-fine: ['Content-Transfer-Encoding: base64'] + brk.
		str aghjunghje-à-a-fine: ['Content-ID: <attachment'] + id + ['>'] + brk.
		str aghjunghje-à-a-fine: ['Content-Disposition: inline; filename="'] + info file + ['"'] + brk.
		str aghjunghje-à-a-fine: brk.
		>> max := 76.
		>> len := blob lunghezza.
		>> chunks := (len / max) arrutundà-insù.
		{ :i
			>> chunk := blob cupià da: i * max lunghezza: max.
			str aghjunghje-à-a-fine: chunk + brk.
		} * chunks.
		str aghjunghje-à-a-fine: brk.
		str aghjunghje-à-a-fine: brk.
	}.
	str aghjunghje-à-a-fine: ['--'] + propiu boundary + ['--'] + brk. <- str.
}.
