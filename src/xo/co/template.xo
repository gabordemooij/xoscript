
# ~ Simple template engine ~

>> Sagoma := Ughjettu novu.

Sagoma quandu: ['novu'] fà: { <- sè novu cuntenutu: [''].
}.

Sagoma quandu: ['cuntenutu:'] fà: { :cuntenutu
	propiu cuntenutu := cuntenutu. 
}.

Sagoma quandu: ['novu:'] fà: { :cuntenutu <- sè novu cuntenutu: cuntenutu.
}.

Sagoma quandu: ['taglià:'] fà: { :marcatore
	>> marcatore-iniziu := (['<!-- cut:%id% -->'] %id%: marcatore).
	>> marcatore-fine := (['<!-- /cut:%id% -->'] %id%: marcatore).
	>> parti := propiu cuntenutu sparte: marcatore-iniziu.
	>> prefissu := parti primu.
	>> parti2 := parti ultimu sparte: marcatore-fine.
	>> suffissu := parti2 ultimu.
	>> parte := parti2 primu.
	>> restu := prefissu + suffissu.
	propiu cuntenutu := restu. <- Sagoma novu: parte.
	
}.

Sagoma quandu: ['cupià'] fà: { <- sè novu: sè testu cupià.
}.
	
Sagoma quandu: ['incullà:à:'] fà: { :ritagliu :id
	>> marcatore-incolla := (['<!-- paste:%id% -->'] %id%: id).
	propiu cuntenutu rimpiazzà: marcatore-incolla cù: ( ritagliu testu + marcatore-incolla ).
}.

Sagoma quandu: ['definisce:valore:'] fà: { :piazza :valore
	propiu cuntenutu rimpiazzà: ['<!-- slot:'] + piazza + [' -->'] cù: ( Server html-cudificà: valore ).
}.

Sagoma quandu: ['definisce:html:'] fà: { :piazza :html
	propiu cuntenutu rimpiazzà: ['<!-- slot:'] + piazza + [' -->'] cù: html.
}.

Sagoma quandu: ['risponde:è:'] fà: { :piazza :valore
	sè definisce: (piazza da: 0 lunghezza: (piazza lunghezza - 1)) valore: valore.
}.

Sagoma quandu: ['nl2br'] fà: {
	propiu cuntenutu rimpiazzà: ['\n'] cù: ['<br>'].
}.

Sagoma quandu: ['purificà'] fà: {
	propiu cuntenutu :=
		Mudellu
		novu: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		currispundenza: propiu cuntenutu
		fà: { <- ['']. }.
}.

Sagoma quandu: ['purificà-taglii'] fà: {
	>> elementi := Lista novu.
	Mudellu
	novu: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	currispundenza: propiu cuntenutu
	fà: { :_ :parte
		elementi aghjunghje-à-a-fine: parte ? 1.
	}.
	elementi ognunu: { :_ :id
		propiu cuntenutu :=
			Mudellu novu: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			currispundenza: propiu cuntenutu
			fà: { <- ['']. }.
	 }.
}.

Sagoma quandu: ['purificà-spazii'] fà: {
	propiu cuntenutu :=
		Mudellu
		novu: ['\\s*\\n'],
		currispundenza: propiu cuntenutu
		fà: { <- ['\n']. }.
	propiu cuntenutu :=
		Mudellu
		novu: ['\\n[\\s\\t]+'],
		currispundenza: propiu cuntenutu
		fà: { <- ['\n']. }.
}.

Sagoma quandu: ['purificà-tuttu'] fà: {
	sè purificà.
	sè purificà-taglii.
	sè purificà-spazii.
}.

Sagoma quandu: ['testu'] fà: { <- propiu cuntenutu.
}.
