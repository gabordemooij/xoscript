Dumanda-HTTP quandu: ['HTTP-intestatura:'] fà: { :chjave <- Prugramma parametru: chjave.
}.

>> Intestatura-HTTP := Ughjettu novu.

Intestatura-HTTP quandu: ['novu'] fà: { <- sè novu inizializà.
}.

Intestatura-HTTP quandu: ['inizializà'] fà: {
	propiu chjave := Nunda.
	propiu valore := Nunda.
}.

Intestatura-HTTP quandu: ['chjave:valore:'] fà: { :chjave :valore
	propiu chjave := chjave.
	propiu valore := valore.
}.

Intestatura-HTTP quandu: ['chjave'] fà: { <- propiu chjave.
}.

Intestatura-HTTP quandu: ['valore'] fà: { <- propiu valore.
}.


Intestatura-HTTP quandu: ['testu'] fà: {
	>> linea := propiu chjave + [': '] + propiu valore.
	linea rimpiazzà: ['\r'] cù: [''], rimpiazzà: ['\n'] cù: ['']. <- linea + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Ducumentu-Web := Ughjettu novu.

Ducumentu-Web quandu: ['novu'] fà: { <- sè novu inizializà.
}.

Ducumentu-Web quandu: ['inizializà'] fà: {
	propiu intestature := Lista novu.
	propiu id-sessione := Nunda.
	propiu gestore-sessione := Sessione-schedariu-tempurariu novu.
	propiu dati-sessione := Nunda.
	propiu sicuru := Veru.
	propiu stessu-situ := ['Strict'].
	propiu intestature-mandate := Falsu.
	propiu dumanda := Dumanda-HTTP novu.
}.

Ducumentu-Web quandu: ['dumanda:'] fà: { :dumanda
	propiu dumanda := dumanda.
}. 

Ducumentu-Web quandu: ['cookie-sessione-sicuru:'] fà: { :sicuru
	sè verificà-intestature.
	propiu sicuru := sicuru.
}.

Ducumentu-Web quandu: ['cookie-sessione-stessu-situ:'] fà: { :valore
	sè verificà-intestature.
	>> opzioni := Lista novu 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opzioni hà: valore, falsu: {
		sta-faccenda errore: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	propiu stessu-situ := valore.
}.

Ducumentu-Web quandu: ['intestatura:'] fà: { :intestatura
	sè verificà-intestature.
	propiu intestature aghjunghje-à-a-fine: intestatura.
}.

Ducumentu-Web quandu: ['sviutà-intestature'] fà: {
	sè verificà-intestature.
	propiu intestature := Lista novu.
}.

Ducumentu-Web quandu: ['gestore-sessione:'] fà: { :gestore
	sè verificà-intestature.
	propiu gestore-sessione := gestore.
}.

Ducumentu-Web quandu: ['gestore-sessione'] fà: { <- propiu gestore-sessione.
}.

Ducumentu-Web quandu: ['verificà-intestature'] fà: {
	propiu intestature-mandate veru: {
		sta-faccenda errore: ['Headers already sent to client.'].
	}.
}.

Ducumentu-Web quandu: ['avvià-sessione'] fà: {
	sè verificà-intestature.
	>> dumanda := propiu dumanda.
	>> id-sessione := dumanda cookie: ['xsid'].
	id-sessione Nunda? falsu: {
		(( Mudellu novu: ['^[A-Za-z0-9]+\\z'], currispundenza: id-sessione ) = 0) veru: {
			id-sessione := Nunda.
		}.
	}.
	id-sessione Nunda? veru: {
		id-sessione := Cascia-forte gettone: 30.
		>> intestatura-sessione := Intestatura-HTTP novu
		chjave: ['Set-Cookie'] valore: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (propiu sicuru o: ['Secure'] o: ['']),
		SSITE: (propiu stessu-situ),
		XSID: id-sessione
		).
		propiu intestature aghjunghje-à-a-fine: intestatura-sessione.
	}.
	propiu dati-sessione := propiu gestore-sessione per: id-sessione, caricà. <- propiu dati-sessione. # reference
}.

Ducumentu-Web quandu: ['andà-à:'] fà: { :indirizzu
	sè verificà-intestature.
	sè sviutà-intestature.
	propiu intestature
	aghjunghje-à-a-fine: (
		Intestatura-HTTP novu
		chjave: ['Status'] valore: ['303 See Other']
	),
	aghjunghje-à-a-fine: (
		Intestatura-HTTP novu
		chjave: ['Location'] valore: indirizzu
	).
	sè scrive-surtita: ['Redirect'].
}.

Ducumentu-Web quandu: ['distrughje-sessione'] fà: {
	sè verificà-intestature.
	>> dumanda := propiu dumanda.
	>> id-sessione := dumanda cookie: ['xsid'].
	id-sessione Nunda? falsu: {
		>> intestatura-sessione := Intestatura-HTTP novu.
		>> mumentu := Mumentu novu annu: 1970, furmatu: ['%a, %d %b %Y %H:%M:%S GMT'].
		intestatura-sessione chjave: ['Set-Cookie'] valore: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: mumentu,
			SEC: (propiu sicuru o: ['Secure'] o: ['']),
			SSITE: (propiu stessu-situ),
			XSID: id-sessione
		).
		propiu gestore-sessione distrughje.
		propiu intestature aghjunghje-à-a-fine: intestatura-sessione.
	}.
}.


Ducumentu-Web quandu: ['sagoma:'] fà: { :caminu-di-schedariu <- Sagoma novu: (Schedariu novu: caminu-di-schedariu, leghje).
}.

Ducumentu-Web quandu: ['scrive-surtita:tipu:'] fà: { :surtita :tipu
	propiu intestature-mandate falsu: {
		propiu dati-sessione Nunda? falsu: {
			propiu gestore-sessione salvà: propiu dati-sessione.
		}.
		propiu intestature aghjunghje-à-a-fine: (
			Intestatura-HTTP novu
			chjave: ['Content-type'] valore: tipu
		).
		propiu intestature ognunu: { :_ :intestatura
			Esciuta scrive: intestatura.
		}.
		propiu intestature-mandate := Veru.
		Esciuta scrive: ['\r\n'].
	}.
	Esciuta scrive: surtita.
}.

Ducumentu-Web quandu: ['finisce:tipu:'] fà: { :surtita :tipu
	propiu intestature-mandate falsu: {
		propiu dati-sessione Nunda? falsu: {
			propiu gestore-sessione salvà: propiu dati-sessione.
		}.
		propiu intestature aghjunghje-à-a-fine: (
			Intestatura-HTTP novu
			chjave: ['Content-type'] valore: tipu
		).
		propiu intestature aghjunghje-à-a-fine: (
			Intestatura-HTTP novu
			chjave: ['Content-Length'] valore: surtita testu bytes
		).
		propiu intestature ognunu: { :_ :intestatura
			Esciuta scrive: intestatura.
		}.
		propiu intestature-mandate := Veru.
		Esciuta scrive: ['\r\n'].
	}.
	Esciuta scrive: surtita.
}.

Ducumentu-Web quandu: ['scrive-surtita:'] fà: { :surtita
	sè scrive-surtita: surtita tipu: ['text/html; charset=utf-8'].
}.

Ducumentu-Web quandu: ['finisce:'] fà: { :surtita
	sè finisce: surtita tipu: ['text/html; charset=utf-8'].
}.

Ducumentu-Web quandu: ['json:'] fà: { :surtita
	sè scrive-surtita: ( JSON jsonify: surtita ) tipu: ['application/json'].
}.

Ducumentu-Web quandu: ['micca-trovu:'] fà: { :surtita
	sè sviutà-intestature intestatura: (
		Intestatura-HTTP novu chjave: ['Status'] valore: ['404 Not Found']
	).
	sè scrive-surtita: surtita.
}.


# Interface

>> Sessione := Ughjettu novu.

Sessione quandu: ['novu'] fà: { <- sè novu inizializà per: Nunda.
}.

Sessione quandu: ['per:'] fà: { :id
	propiu id := id.
}.

Sessione quandu: ['caricà'] fà: {
	sta-faccenda errore: ['Not implemented.'].
}.

Sessione quandu: ['salvà:'] fà: {
	sta-faccenda errore: ['Not implemented.'].
}.

Sessione quandu: ['distrughje'] fà: {
	sta-faccenda errore: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Sessione-schedariu-tempurariu := Sessione novu.

Sessione-schedariu-tempurariu quandu: ['inizializà'] fà: {
	propiu prefissupercorsu := ['/tmp/sess-'].
}.

Sessione-schedariu-tempurariu quandu: ['prefissu-percorsu:'] fà: { :catena
	propiu prefissupercorsu := catena.
}.

Sessione-schedariu-tempurariu quandu: ['schedariu'] fà: { <- ( Schedariu novu: ( propiu prefissupercorsu + propiu id + ['.txt'] ) ).
}.

Sessione-schedariu-tempurariu quandu: ['caricà'] fà: {
	>> schedariu := sè schedariu.
	schedariu esiste falsu: {
		schedariu scrive: (Dizziunariu novu codice).
	}. <- schedariu leghje ughjettu.
}.

Sessione-schedariu-tempurariu quandu: ['salvà:'] fà: { :dati
	>> schedariu := sè schedariu.
	schedariu esiste veru: {
		schedariu scrive: dati codice.
	}.
}.

Sessione-schedariu-tempurariu quandu: ['distrughje'] fà: {
	>> schedariu := sè schedariu.
	schedariu esiste veru: {
		schedariu eliminà.
	}.
}.


>> URL := Ughjettu novu.

URL quandu: ['inizializà'] fà: {
	propiu protocollu := ['https://'].
	propiu ospite := ['localhost'].
	propiu caminu-di-schedariu := [''].
	propiu parametri-url := [''].
	propiu hash := [''].
}.

URL quandu: ['novu'] fà: { <- sè novu inizializà.
}.

URL quandu: ['testu'] fà: { <- (
	propiu protocollu +
	propiu ospite +
	propiu caminu-di-schedariu +
	propiu parametri-url +
	propiu hash ).
}.

URL quandu: ['protocollu:'] fà: { :protocollu
	((Lista novu ; ['http'] ; ['https']) hà: protocollu) veru: {
		propiu protocollu := protocollu + ['://'].
	}, falsu: {
		sta-faccenda errore: ['Invalid protocol'].
	}.
}.

URL quandu: ['ospite:'] fà: { :ospite
	#todo validate according to rfc
	propiu ospite := ospite.
}.

URL quandu: ['caminu-di-schedariu:'] fà: { :caminu-di-schedariu
	propiu caminu-di-schedariu := ['/'] + caminu-di-schedariu url-cudificà.
}.

URL quandu: ['parametri-url:'] fà: { :mappa
	>> parametri-url := Lista novu.
	mappa ognunu: { :chjave :valore
		parametri-url aghjunghje-à-a-fine: chjave testu url-cudificà + ['='] + valore testu url-cudificà.
	}.
	propiu parametri-url := ['?'] + ( parametri-url unisce: ['&'] ).
}.

URL quandu: ['riassuntu:'] fà: { :hash
	propiu hash := ['#'] + hash url-cudificà.
}.

