>> E-pos := Objek nuut.

E-pos by: ['inisialiseer'] doen: {
	eie ontvangers := Lys nuut.
	eie cc := Lys nuut.
	eie bcc := Lys nuut.
	eie afsender := Niks.
	eie afsendernaam := Niks.
	eie onderwerp := Niks.
	eie boodskapteks := Niks.
}.

E-pos by: ['nuut'] doen: { <- self nuut inisialiseer.
}.

E-pos by: ['aan:'] doen: { :opsomming
	eie ontvangers := opsomming.
}.
 
E-pos by: ['cc:'] doen: { :opsomming
	eie cc := opsomming.
}.

E-pos by: ['bcc:'] doen: { :opsomming
	eie bcc := opsomming.
}.

E-pos by: ['onderwerp:'] doen: { :onderwerp
	eie onderwerp := onderwerp.
}.

E-pos by: ['afsender:naam:'] doen: { :afsender :naam
	eie afsender := afsender.
	eie afsendernaam := naam.
}.

E-pos by: ['boodskapteks:'] doen: { :boodskapteks
	eie boodskapteks := boodskapteks.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-pos by: ['kopstuk:'] doen: { :reël <- reël vervang: ['\r'] met: [''], vervang: ['\n'] met: [''].
}.

E-pos by: ['stuur'] doen: {
	>> f := Lêer tempwrite: self genereer.
	Program stelsel: ['sendmail -t < '] + f pad, nuwe-reël.
}.

E-pos by: ['genereer'] doen: {
	>> reëlbreuk := ['\r\n'].
	>> teksstring := [''].
	teksstring voeg-agter: (self kopstuk: ['From: '] + eie afsendernaam + [' <'] + ( eie afsender ) + ['>']) + reëlbreuk.
	teksstring voeg-agter: (self kopstuk: ['To: '] + ( eie ontvangers voeg-saam: [','] )) + reëlbreuk.
	eie cc tel ja: {
		teksstring voeg-agter: (self kopstuk: ['Cc: '] + ( eie cc voeg-saam: [','] )) + reëlbreuk.
	}.
	eie bcc tel ja: {
		teksstring voeg-agter: (self kopstuk: ['Bcc: '] + ( eie bcc voeg-saam: [','] )) + reëlbreuk.
	}.
	teksstring voeg-agter: (self kopstuk: ['Subject: '] + eie onderwerp) + reëlbreuk.
	teksstring voeg-agter: reëlbreuk.
	teksstring voeg-agter: eie boodskapteks.
	teksstring voeg-agter: reëlbreuk. <- teksstring.
}.

>> HTML-E-pos := E-pos nuut.

HTML-E-pos by: ['inisialiseer'] doen: {
	self inisialiseer.
	eie aanhegsels := Lys nuut.
	eie grens := Kluis token: 40.
}.

HTML-E-pos by: ['aanheg:'] doen: { :lêer
	>> id := eie aanhegsels tel.
	>> blob := lêer blob.
	eie aanhegsels voeg-agter: (
		Woordeboek nuut
			lêer: lêer pad,
			mime: ['image/'] + (Server mimetype: lêer pad),
			data: blob base64-kodeer
	).
	blob stel-vry. <- ['cid:attachment'] + id.
}.

HTML-E-pos by: ['genereer'] doen: {
	>> reëlbreuk := ['\r\n'].
	>> teksstring := [''].
	teksstring voeg-agter: (self kopstuk: ['From: '] + eie afsendernaam + [' <'] + ( eie afsender ) + ['>']) + reëlbreuk.
	teksstring voeg-agter: (self kopstuk: ['To: '] + ( eie ontvangers voeg-saam: [','] )) + reëlbreuk.
	eie cc tel ja: {
		teksstring voeg-agter: (self kopstuk: ['Cc: '] + ( eie cc voeg-saam: [','] )) + reëlbreuk.
	}.
	eie bcc tel ja: {
		teksstring voeg-agter: (self kopstuk: ['Bcc: '] + ( eie bcc voeg-saam: [','] )) + reëlbreuk.
	}.
	teksstring voeg-agter: (self kopstuk: ['Subject: '] + eie onderwerp) + reëlbreuk.
	teksstring voeg-agter: ['MIME-Version: 1.0'] + reëlbreuk.
	teksstring voeg-agter: ['Content-Type: multipart/related; boundary="'] + eie grens + ['"; type=text/html'] + reëlbreuk.
	teksstring voeg-agter: reëlbreuk.
	teksstring voeg-agter: ['--'] + eie grens + reëlbreuk.
	teksstring voeg-agter: ['Content-Type: text/html; charset=UTF-8'] + reëlbreuk.
	teksstring voeg-agter: ['Content-Transfer-Encoding: 7bit'] + reëlbreuk.
	teksstring voeg-agter: reëlbreuk.
	teksstring voeg-agter: eie boodskapteks.
	teksstring voeg-agter: reëlbreuk.
	eie aanhegsels elk: { :id :info
		>> blob := info data.
		teksstring voeg-agter: ['--'] + eie grens + reëlbreuk.
		teksstring voeg-agter: ['Content-Type: '] + info mime + reëlbreuk.
		teksstring voeg-agter: ['Content-Transfer-Encoding: base64'] + reëlbreuk.
		teksstring voeg-agter: ['Content-ID: <attachment'] + id + ['>'] + reëlbreuk.
		teksstring voeg-agter: ['Content-Disposition: inline; filename="'] + info lêer + ['"'] + reëlbreuk.
		teksstring voeg-agter: reëlbreuk.
		>> hoogste := 76.
		>> tekslengte := blob lengte.
		>> stukke := (tekslengte / hoogste) rond-op.
		{ :i
			>> stuk := blob kopieer vanaf: i * hoogste lengte: hoogste.
			teksstring voeg-agter: stuk + reëlbreuk.
		} * stukke.
		teksstring voeg-agter: reëlbreuk.
		teksstring voeg-agter: reëlbreuk.
	}.
	teksstring voeg-agter: ['--'] + eie grens + ['--'] + reëlbreuk. <- teksstring.
}.
