
# ~ Simple template engine ~

>> Sjabloon := Objek nuut.

Sjabloon by: ['nuut'] doen: { <- self nuut inhoud: [''].
}.

Sjabloon by: ['inhoud:'] doen: { :inhoud
	eie inhoud := inhoud. 
}.

Sjabloon by: ['nuut:'] doen: { :inhoud <- self nuut inhoud: inhoud.
}.

Sjabloon by: ['uitknip:'] doen: { :merker
	>> beginmerker := (['<!-- cut:%id% -->'] %id%: merker).
	>> eindmerker := (['<!-- /cut:%id% -->'] %id%: merker).
	>> dele := eie inhoud verdeel: beginmerker.
	>> voorvoegsel := dele eerste.
	>> dele2 := dele laaste verdeel: eindmerker.
	>> agtervoegsel := dele2 laaste.
	>> deel := dele2 eerste.
	>> res := voorvoegsel + agtervoegsel.
	eie inhoud := res. <- Sjabloon nuut: deel.
	
}.

Sjabloon by: ['kopieer'] doen: { <- self nuut: self teks kopieer.
}.
	
Sjabloon by: ['plak:by:'] doen: { :brokkie :id
	>> plakmerker := (['<!-- paste:%id% -->'] %id%: id).
	eie inhoud vervang: plakmerker met: ( brokkie teks + plakmerker ).
}.

Sjabloon by: ['stel:waarde:'] doen: { :gleuf :waarde
	eie inhoud vervang: ['<!-- slot:'] + gleuf + [' -->'] met: ( Server html-kodeer: waarde ).
}.

Sjabloon by: ['stel:html:'] doen: { :gleuf :html
	eie inhoud vervang: ['<!-- slot:'] + gleuf + [' -->'] met: html.
}.

Sjabloon by: ['reageer:en:'] doen: { :gleuf :waarde
	self stel: (gleuf vanaf: 0 lengte: (gleuf lengte - 1)) waarde: waarde.
}.

Sjabloon by: ['nl2br'] doen: {
	eie inhoud vervang: ['\n'] met: ['<br>'].
}.

Sjabloon by: ['skoonmaak'] doen: {
	eie inhoud :=
		Patroon
		nuut: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		passing: eie inhoud
		doen: { <- ['']. }.
}.

Sjabloon by: ['snitte-skoonmaak'] doen: {
	>> items := Lys nuut.
	Patroon
	nuut: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	passing: eie inhoud
	doen: { :_ :deel
		items voeg-agter: deel ? 1.
	}.
	items elk: { :_ :id
		eie inhoud :=
			Patroon nuut: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			passing: eie inhoud
			doen: { <- ['']. }.
	 }.
}.

Sjabloon by: ['spasies-skoonmaak'] doen: {
	eie inhoud :=
		Patroon
		nuut: ['\\s*\\n'],
		passing: eie inhoud
		doen: { <- ['\n']. }.
	eie inhoud :=
		Patroon
		nuut: ['\\n[\\s\\t]+'],
		passing: eie inhoud
		doen: { <- ['\n']. }.
}.

Sjabloon by: ['alles-skoonmaak'] doen: {
	self skoonmaak.
	self snitte-skoonmaak.
	self spasies-skoonmaak.
}.

Sjabloon by: ['teks'] doen: { <- eie inhoud.
}.
