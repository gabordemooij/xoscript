HTTP-Versoek by: ['HTTP-kopstuk:'] doen: { :sleutel <- Program instelling: sleutel.
}.

>> HTTP-Kop := Objek nuut.

HTTP-Kop by: ['nuut'] doen: { <- self nuut inisialiseer.
}.

HTTP-Kop by: ['inisialiseer'] doen: {
	eie sleutel := Niks.
	eie waarde := Niks.
}.

HTTP-Kop by: ['sleutel:waarde:'] doen: { :sleutel :waarde
	eie sleutel := sleutel.
	eie waarde := waarde.
}.

HTTP-Kop by: ['sleutel'] doen: { <- eie sleutel.
}.

HTTP-Kop by: ['waarde'] doen: { <- eie waarde.
}.


HTTP-Kop by: ['teks'] doen: {
	>> reël := eie sleutel + [': '] + eie waarde.
	reël vervang: ['\r'] met: [''], vervang: ['\n'] met: ['']. <- reël + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdokument := Objek nuut.

Webdokument by: ['nuut'] doen: { <- self nuut inisialiseer.
}.

Webdokument by: ['inisialiseer'] doen: {
	eie kopstukke := Lys nuut.
	eie sessie-id := Niks.
	eie sessiebestuurder := Tydelike-lêer-sessie nuut.
	eie sessiedata := Niks.
	eie veilig := Ja.
	eie selfde-werf := ['Strict'].
	eie kopstukke-gestuur := Nee.
	eie versoek := HTTP-Versoek nuut.
}.

Webdokument by: ['versoek:'] doen: { :versoek
	eie versoek := versoek.
}. 

Webdokument by: ['veilige-sessiekoekie:'] doen: { :veilig
	self kopstukke-nagaan.
	eie veilig := veilig.
}.

Webdokument by: ['selfde-werf-sessiekoekie:'] doen: { :waarde
	self kopstukke-nagaan.
	>> opsies := Lys nuut 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	opsies het: waarde, nee: {
		hierdie-taak fout: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	eie selfde-werf := waarde.
}.

Webdokument by: ['kopstuk:'] doen: { :kopstuk
	self kopstukke-nagaan.
	eie kopstukke voeg-agter: kopstuk.
}.

Webdokument by: ['kopstukke-skrap'] doen: {
	self kopstukke-nagaan.
	eie kopstukke := Lys nuut.
}.

Webdokument by: ['sessiebestuurder:'] doen: { :bestuurder
	self kopstukke-nagaan.
	eie sessiebestuurder := bestuurder.
}.

Webdokument by: ['sessiebestuurder'] doen: { <- eie sessiebestuurder.
}.

Webdokument by: ['kopstukke-nagaan'] doen: {
	eie kopstukke-gestuur ja: {
		hierdie-taak fout: ['Headers already sent to client.'].
	}.
}.

Webdokument by: ['sessie-begin'] doen: {
	self kopstukke-nagaan.
	>> versoek := eie versoek.
	>> sessie-id := versoek cookie: ['xsid'].
	sessie-id Niks? nee: {
		(( Patroon nuut: ['^[A-Za-z0-9]+\\z'], passing: sessie-id ) = 0) ja: {
			sessie-id := Niks.
		}.
	}.
	sessie-id Niks? ja: {
		sessie-id := Kluis token: 30.
		>> sessiekop := HTTP-Kop nuut
		sleutel: ['Set-Cookie'] waarde: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (eie veilig of: ['Secure'] of: ['']),
		SSITE: (eie selfde-werf),
		XSID: sessie-id
		).
		eie kopstukke voeg-agter: sessiekop.
	}.
	eie sessiedata := eie sessiebestuurder vir: sessie-id, laai. <- eie sessiedata. # reference
}.

Webdokument by: ['gaan-na:'] doen: { :adres
	self kopstukke-nagaan.
	self kopstukke-skrap.
	eie kopstukke
	voeg-agter: (
		HTTP-Kop nuut
		sleutel: ['Status'] waarde: ['303 See Other']
	),
	voeg-agter: (
		HTTP-Kop nuut
		sleutel: ['Location'] waarde: adres
	).
	self uitvoer: ['Redirect'].
}.

Webdokument by: ['sessie-vernietig'] doen: {
	self kopstukke-nagaan.
	>> versoek := eie versoek.
	>> sessie-id := versoek cookie: ['xsid'].
	sessie-id Niks? nee: {
		>> sessiekop := HTTP-Kop nuut.
		>> tydstip := Oomblik nuut jaar: 1970, formaat: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessiekop sleutel: ['Set-Cookie'] waarde: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tydstip,
			SEC: (eie veilig of: ['Secure'] of: ['']),
			SSITE: (eie selfde-werf),
			XSID: sessie-id
		).
		eie sessiebestuurder vernietig.
		eie kopstukke voeg-agter: sessiekop.
	}.
}.


Webdokument by: ['sjabloon:'] doen: { :pad <- Sjabloon nuut: (Lêer nuut: pad, lees).
}.

Webdokument by: ['uitvoer:tipe:'] doen: { :uitset :tipe
	eie kopstukke-gestuur nee: {
		eie sessiedata Niks? nee: {
			eie sessiebestuurder stoor: eie sessiedata.
		}.
		eie kopstukke voeg-agter: (
			HTTP-Kop nuut
			sleutel: ['Content-type'] waarde: tipe
		).
		eie kopstukke elk: { :_ :kopstuk
			Uitvoer skryf: kopstuk.
		}.
		eie kopstukke-gestuur := Ja.
		Uitvoer skryf: ['\r\n'].
	}.
	Uitvoer skryf: uitset.
}.

Webdokument by: ['afrond:tipe:'] doen: { :uitset :tipe
	eie kopstukke-gestuur nee: {
		eie sessiedata Niks? nee: {
			eie sessiebestuurder stoor: eie sessiedata.
		}.
		eie kopstukke voeg-agter: (
			HTTP-Kop nuut
			sleutel: ['Content-type'] waarde: tipe
		).
		eie kopstukke voeg-agter: (
			HTTP-Kop nuut
			sleutel: ['Content-Length'] waarde: uitset teks bytes
		).
		eie kopstukke elk: { :_ :kopstuk
			Uitvoer skryf: kopstuk.
		}.
		eie kopstukke-gestuur := Ja.
		Uitvoer skryf: ['\r\n'].
	}.
	Uitvoer skryf: uitset.
}.

Webdokument by: ['uitvoer:'] doen: { :uitset
	self uitvoer: uitset tipe: ['text/html; charset=utf-8'].
}.

Webdokument by: ['afrond:'] doen: { :uitset
	self afrond: uitset tipe: ['text/html; charset=utf-8'].
}.

Webdokument by: ['json:'] doen: { :uitset
	self uitvoer: ( JSON jsonify: uitset ) tipe: ['application/json'].
}.

Webdokument by: ['nie-gevind:'] doen: { :uitset
	self kopstukke-skrap kopstuk: (
		HTTP-Kop nuut sleutel: ['Status'] waarde: ['404 Not Found']
	).
	self uitvoer: uitset.
}.


# Interface

>> Sessie := Objek nuut.

Sessie by: ['nuut'] doen: { <- self nuut inisialiseer vir: Niks.
}.

Sessie by: ['vir:'] doen: { :id
	eie id := id.
}.

Sessie by: ['laai'] doen: {
	hierdie-taak fout: ['Not implemented.'].
}.

Sessie by: ['stoor:'] doen: {
	hierdie-taak fout: ['Not implemented.'].
}.

Sessie by: ['vernietig'] doen: {
	hierdie-taak fout: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tydelike-lêer-sessie := Sessie nuut.

Tydelike-lêer-sessie by: ['inisialiseer'] doen: {
	eie padbegin := ['/tmp/sess-'].
}.

Tydelike-lêer-sessie by: ['padvoorvoegsel:'] doen: { :teksstring
	eie padbegin := teksstring.
}.

Tydelike-lêer-sessie by: ['lêer'] doen: { <- ( Lêer nuut: ( eie padbegin + eie id + ['.txt'] ) ).
}.

Tydelike-lêer-sessie by: ['laai'] doen: {
	>> lêer := self lêer.
	lêer bestaan nee: {
		lêer skryf: (Woordeboek nuut kode).
	}. <- lêer lees objek.
}.

Tydelike-lêer-sessie by: ['stoor:'] doen: { :data
	>> lêer := self lêer.
	lêer bestaan ja: {
		lêer skryf: data kode.
	}.
}.

Tydelike-lêer-sessie by: ['vernietig'] doen: {
	>> lêer := self lêer.
	lêer bestaan ja: {
		lêer verwyder.
	}.
}.


>> URL := Objek nuut.

URL by: ['inisialiseer'] doen: {
	eie protokol := ['https://'].
	eie gasheer := ['localhost'].
	eie pad := [''].
	eie url-parameters := [''].
	eie hash := [''].
}.

URL by: ['nuut'] doen: { <- self nuut inisialiseer.
}.

URL by: ['teks'] doen: { <- (
	eie protokol +
	eie gasheer +
	eie pad +
	eie url-parameters +
	eie hash ).
}.

URL by: ['protokol:'] doen: { :protokol
	((Lys nuut ; ['http'] ; ['https']) het: protokol) ja: {
		eie protokol := protokol + ['://'].
	}, nee: {
		hierdie-taak fout: ['Invalid protocol'].
	}.
}.

URL by: ['gasheer:'] doen: { :gasheer
	#todo validate according to rfc
	eie gasheer := gasheer.
}.

URL by: ['pad:'] doen: { :pad
	eie pad := ['/'] + pad url-kodeer.
}.

URL by: ['url-parameters:'] doen: { :kartering
	>> url-parameters := Lys nuut.
	kartering elk: { :sleutel :waarde
		url-parameters voeg-agter: sleutel teks url-kodeer + ['='] + waarde teks url-kodeer.
	}.
	eie url-parameters := ['?'] + ( url-parameters voeg-saam: ['&'] ).
}.

URL by: ['hash:'] doen: { :hash
	eie hash := ['#'] + hash url-kodeer.
}.

