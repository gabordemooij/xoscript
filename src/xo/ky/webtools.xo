HTTP-Суроо-талап келгенде: ['HTTP-баш-сап:'] аткар: { :ачкыч <- Программа жөндөө: ачкыч.
}.

>> HTTP-Баш-сап := Объект жаңы.

HTTP-Баш-сап келгенде: ['жаңы'] аткар: { <- өзү жаңы баштоо.
}.

HTTP-Баш-сап келгенде: ['баштоо'] аткар: {
	өзүнүн ачкыч := Бош.
	өзүнүн маани := Бош.
}.

HTTP-Баш-сап келгенде: ['ачкыч:маани:'] аткар: { :ачкыч :маани
	өзүнүн ачкыч := ачкыч.
	өзүнүн маани := маани.
}.

HTTP-Баш-сап келгенде: ['ачкыч'] аткар: { <- өзүнүн ачкыч.
}.

HTTP-Баш-сап келгенде: ['маани'] аткар: { <- өзүнүн маани.
}.


HTTP-Баш-сап келгенде: ['текст'] аткар: {
	>> сап := өзүнүн ачкыч + [': '] + өзүнүн маани.
	сап алмаштыруу: ['\r'] буга: [''], алмаштыруу: ['\n'] буга: ['']. <- сап + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-документ := Объект жаңы.

Веб-документ келгенде: ['жаңы'] аткар: { <- өзү жаңы баштоо.
}.

Веб-документ келгенде: ['баштоо'] аткар: {
	өзүнүн баш-саптар := Тизме жаңы.
	өзүнүн сеанс-id := Бош.
	өзүнүн сеанс-башкаргычы := Убактылуу-файл-сеансы жаңы.
	өзүнүн сеанс-маалыматтары := Бош.
	өзүнүн коопсуз := Чын.
	өзүнүн бир-сайт := ['Strict'].
	өзүнүн баш-саптар-жөнөтүлдү := Жалган.
	өзүнүн http-суроо := HTTP-Суроо-талап жаңы.
}.

Веб-документ келгенде: ['http-суроо:'] аткар: { :http-суроо
	өзүнүн http-суроо := http-суроо.
}. 

Веб-документ келгенде: ['коопсуз-сеанс-cookie:'] аткар: { :коопсуз
	өзү баш-саптарды-текшерүү.
	өзүнүн коопсуз := коопсуз.
}.

Веб-документ келгенде: ['бир-сайт-сеанс-cookie:'] аткар: { :маани
	өзү баш-саптарды-текшерүү.
	>> опциялар := Тизме жаңы 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опциялар барбы: маани, жалган-болсо: {
		ушул-тапшырма ката: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	өзүнүн бир-сайт := маани.
}.

Веб-документ келгенде: ['баш-сап:'] аткар: { :баш-сап
	өзү баш-саптарды-текшерүү.
	өзүнүн баш-саптар аягына-кошуу: баш-сап.
}.

Веб-документ келгенде: ['баш-саптарды-бошотуу'] аткар: {
	өзү баш-саптарды-текшерүү.
	өзүнүн баш-саптар := Тизме жаңы.
}.

Веб-документ келгенде: ['сеанс-башкаргычы:'] аткар: { :башкаргыч
	өзү баш-саптарды-текшерүү.
	өзүнүн сеанс-башкаргычы := башкаргыч.
}.

Веб-документ келгенде: ['сеанс-башкаргычы'] аткар: { <- өзүнүн сеанс-башкаргычы.
}.

Веб-документ келгенде: ['баш-саптарды-текшерүү'] аткар: {
	өзүнүн баш-саптар-жөнөтүлдү чын-болсо: {
		ушул-тапшырма ката: ['Headers already sent to client.'].
	}.
}.

Веб-документ келгенде: ['сеансты-баштоо'] аткар: {
	өзү баш-саптарды-текшерүү.
	>> http-суроо := өзүнүн http-суроо.
	>> сеанс-id := http-суроо cookie: ['xsid'].
	сеанс-id Бош? жалган-болсо: {
		(( Үлгү жаңы: ['^[A-Za-z0-9]+\\z'], дал-келүү: сеанс-id ) = 0) чын-болсо: {
			сеанс-id := Бош.
		}.
	}.
	сеанс-id Бош? чын-болсо: {
		сеанс-id := Сейф токен: 30.
		>> сеанс-баш-сабы := HTTP-Баш-сап жаңы
		ачкыч: ['Set-Cookie'] маани: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (өзүнүн коопсуз бул: ['Secure'] же-тиги: ['']),
		SSITE: (өзүнүн бир-сайт),
		XSID: сеанс-id
		).
		өзүнүн баш-саптар аягына-кошуу: сеанс-баш-сабы.
	}.
	өзүнүн сеанс-маалыматтары := өзүнүн сеанс-башкаргычы үчүн: сеанс-id, жүктөө. <- өзүнүн сеанс-маалыматтары. # reference
}.

Веб-документ келгенде: ['өтүү:'] аткар: { :дарек
	өзү баш-саптарды-текшерүү.
	өзү баш-саптарды-бошотуу.
	өзүнүн баш-саптар
	аягына-кошуу: (
		HTTP-Баш-сап жаңы
		ачкыч: ['Status'] маани: ['303 See Other']
	),
	аягына-кошуу: (
		HTTP-Баш-сап жаңы
		ачкыч: ['Location'] маани: дарек
	).
	өзү чыгаруу: ['Redirect'].
}.

Веб-документ келгенде: ['сеансты-жок-кылуу'] аткар: {
	өзү баш-саптарды-текшерүү.
	>> http-суроо := өзүнүн http-суроо.
	>> сеанс-id := http-суроо cookie: ['xsid'].
	сеанс-id Бош? жалган-болсо: {
		>> сеанс-баш-сабы := HTTP-Баш-сап жаңы.
		>> учур := Учур жаңы жыл: 1970, формат: ['%a, %d %b %Y %H:%M:%S GMT'].
		сеанс-баш-сабы ачкыч: ['Set-Cookie'] маани: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: учур,
			SEC: (өзүнүн коопсуз бул: ['Secure'] же-тиги: ['']),
			SSITE: (өзүнүн бир-сайт),
			XSID: сеанс-id
		).
		өзүнүн сеанс-башкаргычы жок-кылуу.
		өзүнүн баш-саптар аягына-кошуу: сеанс-баш-сабы.
	}.
}.


Веб-документ келгенде: ['калып:'] аткар: { :жол <- Калып жаңы: (Файл жаңы: жол, окуу).
}.

Веб-документ келгенде: ['чыгаруу:түр:'] аткар: { :натыйжа :түр
	өзүнүн баш-саптар-жөнөтүлдү жалган-болсо: {
		өзүнүн сеанс-маалыматтары Бош? жалган-болсо: {
			өзүнүн сеанс-башкаргычы сактоо: өзүнүн сеанс-маалыматтары.
		}.
		өзүнүн баш-саптар аягына-кошуу: (
			HTTP-Баш-сап жаңы
			ачкыч: ['Content-type'] маани: түр
		).
		өзүнүн баш-саптар ар-бир: { :_ :баш-сап
			Чыгаруу жазуу: баш-сап.
		}.
		өзүнүн баш-саптар-жөнөтүлдү := Чын.
		Чыгаруу жазуу: ['\r\n'].
	}.
	Чыгаруу жазуу: натыйжа.
}.

Веб-документ келгенде: ['аяктоо:түр:'] аткар: { :натыйжа :түр
	өзүнүн баш-саптар-жөнөтүлдү жалган-болсо: {
		өзүнүн сеанс-маалыматтары Бош? жалган-болсо: {
			өзүнүн сеанс-башкаргычы сактоо: өзүнүн сеанс-маалыматтары.
		}.
		өзүнүн баш-саптар аягына-кошуу: (
			HTTP-Баш-сап жаңы
			ачкыч: ['Content-type'] маани: түр
		).
		өзүнүн баш-саптар аягына-кошуу: (
			HTTP-Баш-сап жаңы
			ачкыч: ['Content-Length'] маани: натыйжа текст bytes
		).
		өзүнүн баш-саптар ар-бир: { :_ :баш-сап
			Чыгаруу жазуу: баш-сап.
		}.
		өзүнүн баш-саптар-жөнөтүлдү := Чын.
		Чыгаруу жазуу: ['\r\n'].
	}.
	Чыгаруу жазуу: натыйжа.
}.

Веб-документ келгенде: ['чыгаруу:'] аткар: { :натыйжа
	өзү чыгаруу: натыйжа түр: ['text/html; charset=utf-8'].
}.

Веб-документ келгенде: ['аяктоо:'] аткар: { :натыйжа
	өзү аяктоо: натыйжа түр: ['text/html; charset=utf-8'].
}.

Веб-документ келгенде: ['json:'] аткар: { :натыйжа
	өзү чыгаруу: ( JSON jsonify: натыйжа ) түр: ['application/json'].
}.

Веб-документ келгенде: ['табылган-жок:'] аткар: { :натыйжа
	өзү баш-саптарды-бошотуу баш-сап: (
		HTTP-Баш-сап жаңы ачкыч: ['Status'] маани: ['404 Not Found']
	).
	өзү чыгаруу: натыйжа.
}.


# Interface

>> Сеанс := Объект жаңы.

Сеанс келгенде: ['жаңы'] аткар: { <- өзү жаңы баштоо үчүн: Бош.
}.

Сеанс келгенде: ['үчүн:'] аткар: { :id
	өзүнүн id := id.
}.

Сеанс келгенде: ['жүктөө'] аткар: {
	ушул-тапшырма ката: ['Not implemented.'].
}.

Сеанс келгенде: ['сактоо:'] аткар: {
	ушул-тапшырма ката: ['Not implemented.'].
}.

Сеанс келгенде: ['жок-кылуу'] аткар: {
	ушул-тапшырма ката: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Убактылуу-файл-сеансы := Сеанс жаңы.

Убактылуу-файл-сеансы келгенде: ['баштоо'] аткар: {
	өзүнүн жол-башы := ['/tmp/sess-'].
}.

Убактылуу-файл-сеансы келгенде: ['жол-префикси:'] аткар: { :сап-тизмеги
	өзүнүн жол-башы := сап-тизмеги.
}.

Убактылуу-файл-сеансы келгенде: ['файл'] аткар: { <- ( Файл жаңы: ( өзүнүн жол-башы + өзүнүн id + ['.txt'] ) ).
}.

Убактылуу-файл-сеансы келгенде: ['жүктөө'] аткар: {
	>> файл := өзү файл.
	файл бар жалган-болсо: {
		файл жазуу: (Сөздүк жаңы код).
	}. <- файл окуу объект.
}.

Убактылуу-файл-сеансы келгенде: ['сактоо:'] аткар: { :маалыматтар
	>> файл := өзү файл.
	файл бар чын-болсо: {
		файл жазуу: маалыматтар код.
	}.
}.

Убактылуу-файл-сеансы келгенде: ['жок-кылуу'] аткар: {
	>> файл := өзү файл.
	файл бар чын-болсо: {
		файл өчүрүү.
	}.
}.


>> URL := Объект жаңы.

URL келгенде: ['баштоо'] аткар: {
	өзүнүн протокол := ['https://'].
	өзүнүн хост := ['localhost'].
	өзүнүн жол := [''].
	өзүнүн url-параметрлери := [''].
	өзүнүн hash := [''].
}.

URL келгенде: ['жаңы'] аткар: { <- өзү жаңы баштоо.
}.

URL келгенде: ['текст'] аткар: { <- (
	өзүнүн протокол +
	өзүнүн хост +
	өзүнүн жол +
	өзүнүн url-параметрлери +
	өзүнүн hash ).
}.

URL келгенде: ['протокол:'] аткар: { :протокол
	((Тизме жаңы ; ['http'] ; ['https']) барбы: протокол) чын-болсо: {
		өзүнүн протокол := протокол + ['://'].
	}, жалган-болсо: {
		ушул-тапшырма ката: ['Invalid protocol'].
	}.
}.

URL келгенде: ['хост:'] аткар: { :хост
	#todo validate according to rfc
	өзүнүн хост := хост.
}.

URL келгенде: ['жол:'] аткар: { :жол
	өзүнүн жол := ['/'] + жол url-коддоо.
}.

URL келгенде: ['url-параметрлери:'] аткар: { :дал-келтирүү
	>> url-параметрлери := Тизме жаңы.
	дал-келтирүү ар-бир: { :ачкыч :маани
		url-параметрлери аягына-кошуу: ачкыч текст url-коддоо + ['='] + маани текст url-коддоо.
	}.
	өзүнүн url-параметрлери := ['?'] + ( url-параметрлери бириктирүү: ['&'] ).
}.

URL келгенде: ['хэш:'] аткар: { :hash
	өзүнүн hash := ['#'] + hash url-коддоо.
}.

