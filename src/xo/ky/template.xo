
# ~ Simple template engine ~

>> Калып := Объект жаңы.

Калып келгенде: ['жаңы'] аткар: { <- өзү жаңы мазмун: [''].
}.

Калып келгенде: ['мазмун:'] аткар: { :мазмун
	өзүнүн мазмун := мазмун. 
}.

Калып келгенде: ['жаңы:'] аткар: { :мазмун <- өзү жаңы мазмун: мазмун.
}.

Калып келгенде: ['кесүү:'] аткар: { :белги
	>> баштапкы-белги := (['<!-- cut:%id% -->'] %id%: белги).
	>> акыркы-белги := (['<!-- /cut:%id% -->'] %id%: белги).
	>> бөлүктөр := өзүнүн мазмун бөлүү: баштапкы-белги.
	>> префикс := бөлүктөр биринчи.
	>> бөлүктөр2 := бөлүктөр акыркы бөлүү: акыркы-белги.
	>> мүчө := бөлүктөр2 акыркы.
	>> бөлүк := бөлүктөр2 биринчи.
	>> калдык := префикс + мүчө.
	өзүнүн мазмун := калдык. <- Калып жаңы: бөлүк.
	
}.

Калып келгенде: ['көчүрүү'] аткар: { <- өзү жаңы: өзү текст көчүрүү.
}.
	
Калып келгенде: ['чаптоо:ачкыч:'] аткар: { :үзүндү :id
	>> чаптоо-белгиси := (['<!-- paste:%id% -->'] %id%: id).
	өзүнүн мазмун алмаштыруу: чаптоо-белгиси буга: ( үзүндү текст + чаптоо-белгиси ).
}.

Калып келгенде: ['коюу:маани:'] аткар: { :орун :маани
	өзүнүн мазмун алмаштыруу: ['<!-- slot:'] + орун + [' -->'] буга: ( Server html-коддоо: маани ).
}.

Калып келгенде: ['коюу:html:'] аткар: { :орун :html
	өзүнүн мазмун алмаштыруу: ['<!-- slot:'] + орун + [' -->'] буга: html.
}.

Калып келгенде: ['жооп:жана:'] аткар: { :орун :маани
	өзү коюу: (орун баштап: 0 узундук: (орун узундук - 1)) маани: маани.
}.

Калып келгенде: ['nl2br'] аткар: {
	өзүнүн мазмун алмаштыруу: ['\n'] буга: ['<br>'].
}.

Калып келгенде: ['иретке-келтирүү'] аткар: {
	өзүнүн мазмун :=
		Үлгү
		жаңы: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		дал-келүү: өзүнүн мазмун
		аткар: { <- ['']. }.
}.

Калып келгенде: ['кесиндилерди-иретке-келтирүү'] аткар: {
	>> элементтер := Тизме жаңы.
	Үлгү
	жаңы: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	дал-келүү: өзүнүн мазмун
	аткар: { :_ :бөлүк
		элементтер аягына-кошуу: бөлүк ? 1.
	}.
	элементтер ар-бир: { :_ :id
		өзүнүн мазмун :=
			Үлгү жаңы: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			дал-келүү: өзүнүн мазмун
			аткар: { <- ['']. }.
	 }.
}.

Калып келгенде: ['боштуктарды-иретке-келтирүү'] аткар: {
	өзүнүн мазмун :=
		Үлгү
		жаңы: ['\\s*\\n'],
		дал-келүү: өзүнүн мазмун
		аткар: { <- ['\n']. }.
	өзүнүн мазмун :=
		Үлгү
		жаңы: ['\\n[\\s\\t]+'],
		дал-келүү: өзүнүн мазмун
		аткар: { <- ['\n']. }.
}.

Калып келгенде: ['баарын-иретке-келтирүү'] аткар: {
	өзү иретке-келтирүү.
	өзү кесиндилерди-иретке-келтирүү.
	өзү боштуктарды-иретке-келтирүү.
}.

Калып келгенде: ['текст'] аткар: { <- өзүнүн мазмун.
}.
