>> Электрондук-кат := Объект жаңы.

Электрондук-кат келгенде: ['баштоо'] аткар: {
	өзүнүн алуучулар := Тизме жаңы.
	өзүнүн cc := Тизме жаңы.
	өзүнүн bcc := Тизме жаңы.
	өзүнүн жөнөтүүчү := Бош.
	өзүнүн жөнөтүүчүнүн-аты := Бош.
	өзүнүн тема := Бош.
	өзүнүн негизги-текст := Бош.
}.

Электрондук-кат келгенде: ['жаңы'] аткар: { <- өзү жаңы баштоо.
}.

Электрондук-кат келгенде: ['алуучуга:'] аткар: { :тизмелөө
	өзүнүн алуучулар := тизмелөө.
}.
 
Электрондук-кат келгенде: ['cc:'] аткар: { :тизмелөө
	өзүнүн cc := тизмелөө.
}.

Электрондук-кат келгенде: ['bcc:'] аткар: { :тизмелөө
	өзүнүн bcc := тизмелөө.
}.

Электрондук-кат келгенде: ['тема:'] аткар: { :тема
	өзүнүн тема := тема.
}.

Электрондук-кат келгенде: ['жөнөтүүчү:аталыш:'] аткар: { :жөнөтүүчү :аталыш
	өзүнүн жөнөтүүчү := жөнөтүүчү.
	өзүнүн жөнөтүүчүнүн-аты := аталыш.
}.

Электрондук-кат келгенде: ['негизги-текст:'] аткар: { :негизги-текст
	өзүнүн негизги-текст := негизги-текст.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Электрондук-кат келгенде: ['баш-сап:'] аткар: { :сап <- сап алмаштыруу: ['\r'] буга: [''], алмаштыруу: ['\n'] буга: [''].
}.

Электрондук-кат келгенде: ['жөнөтүү'] аткар: {
	>> f := Файл tempwrite: өзү түзүү.
	Программа система: ['sendmail -t < '] + f жол, жаңы-сап.
}.

Электрондук-кат келгенде: ['түзүү'] аткар: {
	>> сап-үзүлүшү := ['\r\n'].
	>> сап-тизмеги := [''].
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['From: '] + өзүнүн жөнөтүүчүнүн-аты + [' <'] + ( өзүнүн жөнөтүүчү ) + ['>']) + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['To: '] + ( өзүнүн алуучулар бириктирүү: [','] )) + сап-үзүлүшү.
	өзүнүн cc саны чын-болсо: {
		сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Cc: '] + ( өзүнүн cc бириктирүү: [','] )) + сап-үзүлүшү.
	}.
	өзүнүн bcc саны чын-болсо: {
		сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Bcc: '] + ( өзүнүн bcc бириктирүү: [','] )) + сап-үзүлүшү.
	}.
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Subject: '] + өзүнүн тема) + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: өзүнүн негизги-текст.
	сап-тизмеги аягына-кошуу: сап-үзүлүшү. <- сап-тизмеги.
}.

>> HTML-Электрондук-кат := Электрондук-кат жаңы.

HTML-Электрондук-кат келгенде: ['баштоо'] аткар: {
	өзү баштоо.
	өзүнүн тиркемелер := Тизме жаңы.
	өзүнүн чек := Сейф токен: 40.
}.

HTML-Электрондук-кат келгенде: ['тиркөө:'] аткар: { :файл
	>> id := өзүнүн тиркемелер саны.
	>> blob := файл blob.
	өзүнүн тиркемелер аягына-кошуу: (
		Сөздүк жаңы
			файл: файл жол,
			mime: ['image/'] + (Server mimetype: файл жол),
			маалыматтар: blob base64-коддоо
	).
	blob бошотуу. <- ['cid:attachment'] + id.
}.

HTML-Электрондук-кат келгенде: ['түзүү'] аткар: {
	>> сап-үзүлүшү := ['\r\n'].
	>> сап-тизмеги := [''].
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['From: '] + өзүнүн жөнөтүүчүнүн-аты + [' <'] + ( өзүнүн жөнөтүүчү ) + ['>']) + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['To: '] + ( өзүнүн алуучулар бириктирүү: [','] )) + сап-үзүлүшү.
	өзүнүн cc саны чын-болсо: {
		сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Cc: '] + ( өзүнүн cc бириктирүү: [','] )) + сап-үзүлүшү.
	}.
	өзүнүн bcc саны чын-болсо: {
		сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Bcc: '] + ( өзүнүн bcc бириктирүү: [','] )) + сап-үзүлүшү.
	}.
	сап-тизмеги аягына-кошуу: (өзү баш-сап: ['Subject: '] + өзүнүн тема) + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: ['MIME-Version: 1.0'] + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: ['Content-Type: multipart/related; boundary="'] + өзүнүн чек + ['"; type=text/html'] + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: ['--'] + өзүнүн чек + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: ['Content-Type: text/html; charset=UTF-8'] + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: ['Content-Transfer-Encoding: 7bit'] + сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: сап-үзүлүшү.
	сап-тизмеги аягына-кошуу: өзүнүн негизги-текст.
	сап-тизмеги аягына-кошуу: сап-үзүлүшү.
	өзүнүн тиркемелер ар-бир: { :id :маалымат
		>> blob := маалымат маалыматтар.
		сап-тизмеги аягына-кошуу: ['--'] + өзүнүн чек + сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: ['Content-Type: '] + маалымат mime + сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: ['Content-Transfer-Encoding: base64'] + сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: ['Content-ID: <attachment'] + id + ['>'] + сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: ['Content-Disposition: inline; filename="'] + маалымат файл + ['"'] + сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: сап-үзүлүшү.
		>> эң-көп := 76.
		>> текст-узундугу := blob узундук.
		>> кесимдер := (текст-узундугу / эң-көп) жогору-тегеректөө.
		{ :i
			>> кесим := blob көчүрүү баштап: i * эң-көп узундук: эң-көп.
			сап-тизмеги аягына-кошуу: кесим + сап-үзүлүшү.
		} * кесимдер.
		сап-тизмеги аягына-кошуу: сап-үзүлүшү.
		сап-тизмеги аягына-кошуу: сап-үзүлүшү.
	}.
	сап-тизмеги аягына-кошуу: ['--'] + өзүнүн чек + ['--'] + сап-үзүлүшү. <- сап-тизмеги.
}.
