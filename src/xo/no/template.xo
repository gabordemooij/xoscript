
# ~ Simple template engine ~

>> Mal := Objekt ny.

Mal ved: ['ny'] gjør: { <- selv ny innhold: [''].
}.

Mal ved: ['innhold:'] gjør: { :innhold
	egen innhold := innhold. 
}.

Mal ved: ['ny:'] gjør: { :innhold <- selv ny innhold: innhold.
}.

Mal ved: ['klipp:'] gjør: { :markør
	>> startmarkør := (['<!-- cut:%id% -->'] %id%: markør).
	>> sluttmarkør := (['<!-- /cut:%id% -->'] %id%: markør).
	>> deler := egen innhold del: startmarkør.
	>> prefiks := deler første.
	>> deler2 := deler siste del: sluttmarkør.
	>> suffiks := deler2 siste.
	>> del := deler2 første.
	>> rest := prefiks + suffiks.
	egen innhold := rest. <- Mal ny: del.
	
}.

Mal ved: ['kopier'] gjør: { <- selv ny: selv tekst kopier.
}.
	
Mal ved: ['lim-inn:ved:'] gjør: { :utdrag :id
	>> limmarkør := (['<!-- paste:%id% -->'] %id%: id).
	egen innhold erstatt: limmarkør med: ( utdrag tekst + limmarkør ).
}.

Mal ved: ['sett:verdi:'] gjør: { :plass :verdi
	egen innhold erstatt: ['<!-- slot:'] + plass + [' -->'] med: ( Server html-kode: verdi ).
}.

Mal ved: ['sett:html:'] gjør: { :plass :html
	egen innhold erstatt: ['<!-- slot:'] + plass + [' -->'] med: html.
}.

Mal ved: ['svar:og:'] gjør: { :plass :verdi
	selv sett: (plass fra: 0 lengde: (plass lengde - 1)) verdi: verdi.
}.

Mal ved: ['nl2br'] gjør: {
	egen innhold erstatt: ['\n'] med: ['<br>'].
}.

Mal ved: ['rens'] gjør: {
	egen innhold :=
		Mønster
		ny: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		treff: egen innhold
		gjør: { <- ['']. }.
}.

Mal ved: ['rens-klipp'] gjør: {
	>> elementer := Liste ny.
	Mønster
	ny: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	treff: egen innhold
	gjør: { :_ :del
		elementer legg-til-sist: del ? 1.
	}.
	elementer hver: { :_ :id
		egen innhold :=
			Mønster ny: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			treff: egen innhold
			gjør: { <- ['']. }.
	 }.
}.

Mal ved: ['rens-mellomrom'] gjør: {
	egen innhold :=
		Mønster
		ny: ['\\s*\\n'],
		treff: egen innhold
		gjør: { <- ['\n']. }.
	egen innhold :=
		Mønster
		ny: ['\\n[\\s\\t]+'],
		treff: egen innhold
		gjør: { <- ['\n']. }.
}.

Mal ved: ['rens-alt'] gjør: {
	selv rens.
	selv rens-klipp.
	selv rens-mellomrom.
}.

Mal ved: ['tekst'] gjør: { <- egen innhold.
}.
