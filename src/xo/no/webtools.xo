HTTP-Forespørsel ved: ['HTTP-hode:'] gjør: { :nøkkel <- Program innstilling: nøkkel.
}.

>> HTTP-Hode := Objekt ny.

HTTP-Hode ved: ['ny'] gjør: { <- selv ny initialiser.
}.

HTTP-Hode ved: ['initialiser'] gjør: {
	egen nøkkel := Ingenting.
	egen verdi := Ingenting.
}.

HTTP-Hode ved: ['nøkkel:verdi:'] gjør: { :nøkkel :verdi
	egen nøkkel := nøkkel.
	egen verdi := verdi.
}.

HTTP-Hode ved: ['nøkkel'] gjør: { <- egen nøkkel.
}.

HTTP-Hode ved: ['verdi'] gjør: { <- egen verdi.
}.


HTTP-Hode ved: ['tekst'] gjør: {
	>> linje := egen nøkkel + [': '] + egen verdi.
	linje erstatt: ['\r'] med: [''], erstatt: ['\n'] med: ['']. <- linje + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webdokument := Objekt ny.

Webdokument ved: ['ny'] gjør: { <- selv ny initialiser.
}.

Webdokument ved: ['initialiser'] gjør: {
	egen hoder := Liste ny.
	egen økt-id := Ingenting.
	egen øktbehandler := Midlertidig-fil-økt ny.
	egen øktdata := Ingenting.
	egen sikker := Sann.
	egen samme-nettsted := ['Strict'].
	egen hoder-sendt := Falsk.
	egen forespørsel := HTTP-Forespørsel ny.
}.

Webdokument ved: ['forespørsel:'] gjør: { :forespørsel
	egen forespørsel := forespørsel.
}. 

Webdokument ved: ['sikker-øktkake:'] gjør: { :sikker
	selv kontroller-hoder.
	egen sikker := sikker.
}.

Webdokument ved: ['samme-nettsted-øktkake:'] gjør: { :verdi
	selv kontroller-hoder.
	>> alternativer := Liste ny 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	alternativer har: verdi, falsk: {
		denne-oppgaven feil: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	egen samme-nettsted := verdi.
}.

Webdokument ved: ['hode:'] gjør: { :hode
	selv kontroller-hoder.
	egen hoder legg-til-sist: hode.
}.

Webdokument ved: ['tøm-hoder'] gjør: {
	selv kontroller-hoder.
	egen hoder := Liste ny.
}.

Webdokument ved: ['øktbehandler:'] gjør: { :behandler
	selv kontroller-hoder.
	egen øktbehandler := behandler.
}.

Webdokument ved: ['øktbehandler'] gjør: { <- egen øktbehandler.
}.

Webdokument ved: ['kontroller-hoder'] gjør: {
	egen hoder-sendt sann: {
		denne-oppgaven feil: ['Headers already sent to client.'].
	}.
}.

Webdokument ved: ['start-økt'] gjør: {
	selv kontroller-hoder.
	>> forespørsel := egen forespørsel.
	>> økt-id := forespørsel cookie: ['xsid'].
	økt-id Ingenting? falsk: {
		(( Mønster ny: ['^[A-Za-z0-9]+\\z'], treff: økt-id ) = 0) sann: {
			økt-id := Ingenting.
		}.
	}.
	økt-id Ingenting? sann: {
		økt-id := Hvelv token: 30.
		>> økthode := HTTP-Hode ny
		nøkkel: ['Set-Cookie'] verdi: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (egen sikker enten: ['Secure'] eller: ['']),
		SSITE: (egen samme-nettsted),
		XSID: økt-id
		).
		egen hoder legg-til-sist: økthode.
	}.
	egen øktdata := egen øktbehandler for: økt-id, last-inn. <- egen øktdata. # reference
}.

Webdokument ved: ['gå-til:'] gjør: { :adresse
	selv kontroller-hoder.
	selv tøm-hoder.
	egen hoder
	legg-til-sist: (
		HTTP-Hode ny
		nøkkel: ['Status'] verdi: ['303 See Other']
	),
	legg-til-sist: (
		HTTP-Hode ny
		nøkkel: ['Location'] verdi: adresse
	).
	selv skriv-ut: ['Redirect'].
}.

Webdokument ved: ['avslutt-økt'] gjør: {
	selv kontroller-hoder.
	>> forespørsel := egen forespørsel.
	>> økt-id := forespørsel cookie: ['xsid'].
	økt-id Ingenting? falsk: {
		>> økthode := HTTP-Hode ny.
		>> tidspunkt := Moment ny år: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		økthode nøkkel: ['Set-Cookie'] verdi: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tidspunkt,
			SEC: (egen sikker enten: ['Secure'] eller: ['']),
			SSITE: (egen samme-nettsted),
			XSID: økt-id
		).
		egen øktbehandler ødelegg.
		egen hoder legg-til-sist: økthode.
	}.
}.


Webdokument ved: ['mal:'] gjør: { :sti <- Mal ny: (Fil ny: sti, les).
}.

Webdokument ved: ['skriv-ut:type:'] gjør: { :utdata :type
	egen hoder-sendt falsk: {
		egen øktdata Ingenting? falsk: {
			egen øktbehandler lagre: egen øktdata.
		}.
		egen hoder legg-til-sist: (
			HTTP-Hode ny
			nøkkel: ['Content-type'] verdi: type
		).
		egen hoder hver: { :_ :hode
			Utdata skriv: hode.
		}.
		egen hoder-sendt := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: utdata.
}.

Webdokument ved: ['avslutt:type:'] gjør: { :utdata :type
	egen hoder-sendt falsk: {
		egen øktdata Ingenting? falsk: {
			egen øktbehandler lagre: egen øktdata.
		}.
		egen hoder legg-til-sist: (
			HTTP-Hode ny
			nøkkel: ['Content-type'] verdi: type
		).
		egen hoder legg-til-sist: (
			HTTP-Hode ny
			nøkkel: ['Content-Length'] verdi: utdata tekst bytes
		).
		egen hoder hver: { :_ :hode
			Utdata skriv: hode.
		}.
		egen hoder-sendt := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: utdata.
}.

Webdokument ved: ['skriv-ut:'] gjør: { :utdata
	selv skriv-ut: utdata type: ['text/html; charset=utf-8'].
}.

Webdokument ved: ['avslutt:'] gjør: { :utdata
	selv avslutt: utdata type: ['text/html; charset=utf-8'].
}.

Webdokument ved: ['json:'] gjør: { :utdata
	selv skriv-ut: ( JSON jsonify: utdata ) type: ['application/json'].
}.

Webdokument ved: ['ikke-funnet:'] gjør: { :utdata
	selv tøm-hoder hode: (
		HTTP-Hode ny nøkkel: ['Status'] verdi: ['404 Not Found']
	).
	selv skriv-ut: utdata.
}.


# Interface

>> Økt := Objekt ny.

Økt ved: ['ny'] gjør: { <- selv ny initialiser for: Ingenting.
}.

Økt ved: ['for:'] gjør: { :id
	egen id := id.
}.

Økt ved: ['last-inn'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

Økt ved: ['lagre:'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

Økt ved: ['ødelegg'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Midlertidig-fil-økt := Økt ny.

Midlertidig-fil-økt ved: ['initialiser'] gjør: {
	egen stibegynnelse := ['/tmp/sess-'].
}.

Midlertidig-fil-økt ved: ['stiprefiks:'] gjør: { :tegnstreng
	egen stibegynnelse := tegnstreng.
}.

Midlertidig-fil-økt ved: ['fil'] gjør: { <- ( Fil ny: ( egen stibegynnelse + egen id + ['.txt'] ) ).
}.

Midlertidig-fil-økt ved: ['last-inn'] gjør: {
	>> fil := selv fil.
	fil finnes falsk: {
		fil skriv: (Ordbok ny code).
	}. <- fil les objekt.
}.

Midlertidig-fil-økt ved: ['lagre:'] gjør: { :data
	>> fil := selv fil.
	fil finnes sann: {
		fil skriv: data code.
	}.
}.

Midlertidig-fil-økt ved: ['ødelegg'] gjør: {
	>> fil := selv fil.
	fil finnes sann: {
		fil slett.
	}.
}.


>> URL := Objekt ny.

URL ved: ['initialiser'] gjør: {
	egen protokoll := ['https://'].
	egen vert := ['localhost'].
	egen sti := [''].
	egen url-parametere := [''].
	egen hash := [''].
}.

URL ved: ['ny'] gjør: { <- selv ny initialiser.
}.

URL ved: ['tekst'] gjør: { <- (
	egen protokoll +
	egen vert +
	egen sti +
	egen url-parametere +
	egen hash ).
}.

URL ved: ['protokoll:'] gjør: { :protokoll
	((Liste ny ; ['http'] ; ['https']) har: protokoll) sann: {
		egen protokoll := protokoll + ['://'].
	}, falsk: {
		denne-oppgaven feil: ['Invalid protocol'].
	}.
}.

URL ved: ['vert:'] gjør: { :vert
	#todo validate according to rfc
	egen vert := vert.
}.

URL ved: ['sti:'] gjør: { :sti
	egen sti := ['/'] + sti url-kode.
}.

URL ved: ['url-parametere:'] gjør: { :tilordning
	>> url-parametere := Liste ny.
	tilordning hver: { :nøkkel :verdi
		url-parametere legg-til-sist: nøkkel tekst url-kode + ['='] + verdi tekst url-kode.
	}.
	egen url-parametere := ['?'] + ( url-parametere slå-sammen: ['&'] ).
}.

URL ved: ['hash:'] gjør: { :hash
	egen hash := ['#'] + hash url-kode.
}.

