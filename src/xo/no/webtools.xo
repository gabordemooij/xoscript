HTTP-Forespørsel ved: ['HTTP-header:'] gjør: { :key <- Program innstilling: key.
}.

>> HTTP-Header := Objekt ny.

HTTP-Header ved: ['ny'] gjør: { <- selv ny init.
}.

HTTP-Header ved: ['init'] gjør: {
	egen key := Ingenting.
	egen value := Ingenting.
}.

HTTP-Header ved: ['key:value:'] gjør: { :key :value
	egen key := key.
	egen value := value.
}.

HTTP-Header ved: ['key'] gjør: { <- egen key.
}.

HTTP-Header ved: ['value'] gjør: { <- egen value.
}.


HTTP-Header ved: ['tekst'] gjør: {
	>> line := egen key + [': '] + egen value.
	line erstatt: ['\r'] med: [''], erstatt: ['\n'] med: ['']. <- line + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Web-Document := Objekt ny.

Web-Document ved: ['ny'] gjør: { <- selv ny init.
}.

Web-Document ved: ['init'] gjør: {
	egen headers := Liste ny.
	egen sess-id := Ingenting.
	egen session-manager := Tempfile-Session ny.
	egen sessdata := Ingenting.
	egen secure := Sann.
	egen same-site := ['Strict'].
	egen headers-out := Falsk.
	egen request := HTTP-Forespørsel ny.
}.

Web-Document ved: ['request:'] gjør: { :request
	egen request := request.
}. 

Web-Document ved: ['secure-session-cookie:'] gjør: { :secure
	selv check-headers.
	egen secure := secure.
}.

Web-Document ved: ['same-site-session-cookie:'] gjør: { :value
	selv check-headers.
	>> options := Liste ny 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	options inneholder: value, falsk: {
		denne-oppgaven feil: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	egen same-site := value.
}.

Web-Document ved: ['header:'] gjør: { :header
	selv check-headers.
	egen headers legg-til-sist: header.
}.

Web-Document ved: ['clear-headers'] gjør: {
	selv check-headers.
	egen headers := Liste ny.
}.

Web-Document ved: ['session-manager:'] gjør: { :manager
	selv check-headers.
	egen session-manager := manager.
}.

Web-Document ved: ['session-manager'] gjør: { <- egen session-manager.
}.

Web-Document ved: ['check-headers'] gjør: {
	egen headers-out sann: {
		denne-oppgaven feil: ['Headers already sent to client.'].
	}.
}.

Web-Document ved: ['session-start'] gjør: {
	selv check-headers.
	>> request := egen request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ingenting? falsk: {
		(( Mønster ny: ['^[A-Za-z0-9]+\\z'], treff: sess-id ) = 0) sann: {
			sess-id := Ingenting.
		}.
	}.
	sess-id Ingenting? sann: {
		sess-id := Hvelv token: 30.
		>> session-header := HTTP-Header ny
		key: ['Set-Cookie'] value: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (egen secure enten: ['Secure'] eller: ['']),
		SSITE: (egen same-site),
		XSID: sess-id
		).
		egen headers legg-til-sist: session-header.
	}.
	egen sessdata := egen session-manager for: sess-id, load. <- egen sessdata. # reference
}.

Web-Document ved: ['goto:'] gjør: { :url
	selv check-headers.
	selv clear-headers.
	egen headers
	legg-til-sist: (
		HTTP-Header ny
		key: ['Status'] value: ['303 See Other']
	),
	legg-til-sist: (
		HTTP-Header ny
		key: ['Location'] value: url
	).
	selv out: ['Redirect'].
}.

Web-Document ved: ['session-destroy'] gjør: {
	selv check-headers.
	>> request := egen request.
	>> sess-id := request cookie: ['xsid'].
	sess-id Ingenting? falsk: {
		>> session-header := HTTP-Header ny.
		>> when := Moment ny år: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		session-header key: ['Set-Cookie'] value: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: when,
			SEC: (egen secure enten: ['Secure'] eller: ['']),
			SSITE: (egen same-site),
			XSID: sess-id
		).
		egen session-manager destroy.
		egen headers legg-til-sist: session-header.
	}.
}.


Web-Document ved: ['template:'] gjør: { :sti <- Template ny: (Fil ny: sti, les).
}.

Web-Document ved: ['out:type:'] gjør: { :output :type
	egen headers-out falsk: {
		egen sessdata Ingenting? falsk: {
			egen session-manager save: egen sessdata.
		}.
		egen headers legg-til-sist: (
			HTTP-Header ny
			key: ['Content-type'] value: type
		).
		egen headers hver: { :_ :header
			Utdata skriv: header.
		}.
		egen headers-out := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: output.
}.

Web-Document ved: ['finish:type:'] gjør: { :output :type
	egen headers-out falsk: {
		egen sessdata Ingenting? falsk: {
			egen session-manager save: egen sessdata.
		}.
		egen headers legg-til-sist: (
			HTTP-Header ny
			key: ['Content-type'] value: type
		).
		egen headers legg-til-sist: (
			HTTP-Header ny
			key: ['Content-Length'] value: output tekst bytes
		).
		egen headers hver: { :_ :header
			Utdata skriv: header.
		}.
		egen headers-out := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: output.
}.

Web-Document ved: ['out:'] gjør: { :output
	selv out: output type: ['text/html; charset=utf-8'].
}.

Web-Document ved: ['finish:'] gjør: { :output
	selv finish: output type: ['text/html; charset=utf-8'].
}.

Web-Document ved: ['json:'] gjør: { :output
	selv out: ( JSON jsonify: output ) type: ['application/json'].
}.

Web-Document ved: ['not-found:'] gjør: { :output
	selv clear-headers header: (
		HTTP-Header ny key: ['Status'] value: ['404 Not Found']
	).
	selv out: output.
}.


# Interface

>> Session := Objekt ny.

Session ved: ['ny'] gjør: { <- selv ny init for: Ingenting.
}.

Session ved: ['for:'] gjør: { :id
	egen id := id.
}.

Session ved: ['load'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

Session ved: ['save:'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

Session ved: ['destroy'] gjør: {
	denne-oppgaven feil: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tempfile-Session := Session ny.

Tempfile-Session ved: ['init'] gjør: {
	egen pathprefix := ['/tmp/sess-'].
}.

Tempfile-Session ved: ['path-prefix:'] gjør: { :str
	egen pathprefix := str.
}.

Tempfile-Session ved: ['file'] gjør: { <- ( Fil ny: ( egen pathprefix + egen id + ['.txt'] ) ).
}.

Tempfile-Session ved: ['load'] gjør: {
	>> file := selv file.
	file finnes falsk: {
		file skriv: (Ordbok ny code).
	}. <- file les objekt.
}.

Tempfile-Session ved: ['save:'] gjør: { :data
	>> file := selv file.
	file finnes sann: {
		file skriv: data code.
	}.
}.

Tempfile-Session ved: ['destroy'] gjør: {
	>> file := selv file.
	file finnes sann: {
		file slett.
	}.
}.


>> URL := Objekt ny.

URL ved: ['init'] gjør: {
	egen protocol := ['https://'].
	egen vert := ['localhost'].
	egen sti := [''].
	egen params := [''].
	egen hash := [''].
}.

URL ved: ['ny'] gjør: { <- selv ny init.
}.

URL ved: ['tekst'] gjør: { <- (
	egen protocol +
	egen vert +
	egen sti +
	egen params +
	egen hash ).
}.

URL ved: ['protocol:'] gjør: { :protocol
	((Liste ny: ['http'] ; ['https']) inneholder: protocol) sann: {
		egen protocol := protocol + ['://'].
	}, falsk: {
		denne-oppgaven feil: ['Invalid protocol'].
	}.
}.

URL ved: ['vert:'] gjør: { :vert
	#todo validate according to rfc
	egen vert := vert.
}.

URL ved: ['path:'] gjør: { :sti
	egen sti := ['/'] + sti url-kode.
}.

URL ved: ['params:'] gjør: { :map
	>> params := Liste ny.
	map hver: { :key :value
		params legg-til-sist: key tekst url-kode + ['='] + value tekst url-kode.
	}.
	egen params := ['?'] + ( params slå-sammen: ['&'] ).
}.

URL ved: ['hash:'] gjør: { :hash
	egen hash := ['#'] + hash url-kode.
}.

