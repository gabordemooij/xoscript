>> E-post := Objekt ny.

E-post ved: ['initialiser'] gjør: {
	egen mottakere := Liste ny.
	egen cc := Liste ny.
	egen bcc := Liste ny.
	egen avsender := Ingenting.
	egen avsendernavn := Ingenting.
	egen emne := Ingenting.
	egen meldingstekst := Ingenting.
}.

E-post ved: ['ny'] gjør: { <- selv ny initialiser.
}.

E-post ved: ['til:'] gjør: { :oppramsing
	egen mottakere := oppramsing.
}.
 
E-post ved: ['cc:'] gjør: { :oppramsing
	egen cc := oppramsing.
}.

E-post ved: ['bcc:'] gjør: { :oppramsing
	egen bcc := oppramsing.
}.

E-post ved: ['emne:'] gjør: { :emne
	egen emne := emne.
}.

E-post ved: ['avsender:navn:'] gjør: { :avsender :navn
	egen avsender := avsender.
	egen avsendernavn := navn.
}.

E-post ved: ['meldingstekst:'] gjør: { :meldingstekst
	egen meldingstekst := meldingstekst.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-post ved: ['hode:'] gjør: { :linje <- linje erstatt: ['\r'] med: [''], erstatt: ['\n'] med: [''].
}.

E-post ved: ['send'] gjør: {
	>> f := Fil tempwrite: selv generer.
	Program system: ['sendmail -t < '] + f sti, stop.
}.

E-post ved: ['generer'] gjør: {
	>> linjeskift := ['\r\n'].
	>> tegnstreng := [''].
	tegnstreng legg-til-sist: (selv hode: ['From: '] + egen avsendernavn + [' <'] + ( egen avsender ) + ['>']) + linjeskift.
	tegnstreng legg-til-sist: (selv hode: ['To: '] + ( egen mottakere slå-sammen: [','] )) + linjeskift.
	egen cc antall sann: {
		tegnstreng legg-til-sist: (selv hode: ['Cc: '] + ( egen cc slå-sammen: [','] )) + linjeskift.
	}.
	egen bcc antall sann: {
		tegnstreng legg-til-sist: (selv hode: ['Bcc: '] + ( egen bcc slå-sammen: [','] )) + linjeskift.
	}.
	tegnstreng legg-til-sist: (selv hode: ['Subject: '] + egen emne) + linjeskift.
	tegnstreng legg-til-sist: linjeskift.
	tegnstreng legg-til-sist: egen meldingstekst.
	tegnstreng legg-til-sist: linjeskift. <- tegnstreng.
}.

>> HTML-E-post := E-post ny.

HTML-E-post ved: ['initialiser'] gjør: {
	selv initialiser.
	egen vedlegg := Liste ny.
	egen grense := Hvelv token: 40.
}.

HTML-E-post ved: ['legg-ved:'] gjør: { :fil
	>> id := egen vedlegg antall.
	>> blob := fil blob.
	egen vedlegg legg-til-sist: (
		Ordbok ny
			fil: fil sti,
			mime: ['image/'] + (Server mimetype: fil sti),
			data: blob base64-kode
	).
	blob frigjør. <- ['cid:attachment'] + id.
}.

HTML-E-post ved: ['generer'] gjør: {
	>> linjeskift := ['\r\n'].
	>> tegnstreng := [''].
	tegnstreng legg-til-sist: (selv hode: ['From: '] + egen avsendernavn + [' <'] + ( egen avsender ) + ['>']) + linjeskift.
	tegnstreng legg-til-sist: (selv hode: ['To: '] + ( egen mottakere slå-sammen: [','] )) + linjeskift.
	egen cc antall sann: {
		tegnstreng legg-til-sist: (selv hode: ['Cc: '] + ( egen cc slå-sammen: [','] )) + linjeskift.
	}.
	egen bcc antall sann: {
		tegnstreng legg-til-sist: (selv hode: ['Bcc: '] + ( egen bcc slå-sammen: [','] )) + linjeskift.
	}.
	tegnstreng legg-til-sist: (selv hode: ['Subject: '] + egen emne) + linjeskift.
	tegnstreng legg-til-sist: ['MIME-Version: 1.0'] + linjeskift.
	tegnstreng legg-til-sist: ['Content-Type: multipart/related; boundary="'] + egen grense + ['"; type=text/html'] + linjeskift.
	tegnstreng legg-til-sist: linjeskift.
	tegnstreng legg-til-sist: ['--'] + egen grense + linjeskift.
	tegnstreng legg-til-sist: ['Content-Type: text/html; charset=UTF-8'] + linjeskift.
	tegnstreng legg-til-sist: ['Content-Transfer-Encoding: 7bit'] + linjeskift.
	tegnstreng legg-til-sist: linjeskift.
	tegnstreng legg-til-sist: egen meldingstekst.
	tegnstreng legg-til-sist: linjeskift.
	egen vedlegg hver: { :id :info
		>> blob := info data.
		tegnstreng legg-til-sist: ['--'] + egen grense + linjeskift.
		tegnstreng legg-til-sist: ['Content-Type: '] + info mime + linjeskift.
		tegnstreng legg-til-sist: ['Content-Transfer-Encoding: base64'] + linjeskift.
		tegnstreng legg-til-sist: ['Content-ID: <attachment'] + id + ['>'] + linjeskift.
		tegnstreng legg-til-sist: ['Content-Disposition: inline; filename="'] + info fil + ['"'] + linjeskift.
		tegnstreng legg-til-sist: linjeskift.
		>> høyeste := 76.
		>> tekstlengde := blob lengde.
		>> biter := (tekstlengde / høyeste) rund-opp.
		{ :i
			>> bit := blob kopier fra: i * høyeste lengde: høyeste.
			tegnstreng legg-til-sist: bit + linjeskift.
		} * biter.
		tegnstreng legg-til-sist: linjeskift.
		tegnstreng legg-til-sist: linjeskift.
	}.
	tegnstreng legg-til-sist: ['--'] + egen grense + ['--'] + linjeskift. <- tegnstreng.
}.
