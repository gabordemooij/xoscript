>> Ηλ-μήνυμα := Αντικείμενο νέο.

Ηλ-μήνυμα όταν: ['αρχικοποίησε'] κάνε: {
	δικό παραλήπτες := Λίστα νέο.
	δικό cc := Λίστα νέο.
	δικό bcc := Λίστα νέο.
	δικό αποστολέας := Κενό.
	δικό όνομα-αποστολέα := Κενό.
	δικό θέμα := Κενό.
	δικό σώμα := Κενό.
}.

Ηλ-μήνυμα όταν: ['νέο'] κάνε: { <- εαυτός νέο αρχικοποίησε.
}.

Ηλ-μήνυμα όταν: ['προς:'] κάνε: { :απαρίθμηση
	δικό παραλήπτες := απαρίθμηση.
}.
 
Ηλ-μήνυμα όταν: ['cc:'] κάνε: { :απαρίθμηση
	δικό cc := απαρίθμηση.
}.

Ηλ-μήνυμα όταν: ['bcc:'] κάνε: { :απαρίθμηση
	δικό bcc := απαρίθμηση.
}.

Ηλ-μήνυμα όταν: ['θέμα:'] κάνε: { :θέμα
	δικό θέμα := θέμα.
}.

Ηλ-μήνυμα όταν: ['αποστολέας:όνομα:'] κάνε: { :αποστολέας :όνομα
	δικό αποστολέας := αποστολέας.
	δικό όνομα-αποστολέα := όνομα.
}.

Ηλ-μήνυμα όταν: ['σώμα:'] κάνε: { :σώμα
	δικό σώμα := σώμα.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Ηλ-μήνυμα όταν: ['κεφαλίδα:'] κάνε: { :γραμμή <- γραμμή αντικατάσταση: ['\r'] με: [''], αντικατάσταση: ['\n'] με: [''].
}.

Ηλ-μήνυμα όταν: ['στείλε'] κάνε: {
	>> f := Αρχείο tempwrite: εαυτός δημιούργησε.
	Πρόγραμμα σύστημα: ['sendmail -t < '] + f διαδρομή, νέα-γραμμή.
}.

Ηλ-μήνυμα όταν: ['δημιούργησε'] κάνε: {
	>> αλλαγή-γραμμής := ['\r\n'].
	>> συμβολοσειρά := [''].
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['From: '] + δικό όνομα-αποστολέα + [' <'] + ( δικό αποστολέας ) + ['>']) + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['To: '] + ( δικό παραλήπτες συνένωση: [','] )) + αλλαγή-γραμμής.
	δικό cc πλήθος αληθές: {
		συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Cc: '] + ( δικό cc συνένωση: [','] )) + αλλαγή-γραμμής.
	}.
	δικό bcc πλήθος αληθές: {
		συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Bcc: '] + ( δικό bcc συνένωση: [','] )) + αλλαγή-γραμμής.
	}.
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Subject: '] + δικό θέμα) + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: δικό σώμα.
	συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής. <- συμβολοσειρά.
}.

>> HTML-Ηλ-μήνυμα := Ηλ-μήνυμα νέο.

HTML-Ηλ-μήνυμα όταν: ['αρχικοποίησε'] κάνε: {
	εαυτός αρχικοποίησε.
	δικό συνημμένα := Λίστα νέο.
	δικό όριο := Θησαυροφυλάκιο διακριτικό: 40.
}.

HTML-Ηλ-μήνυμα όταν: ['επισύναψε:'] κάνε: { :αρχείο
	>> id := δικό συνημμένα πλήθος.
	>> blob := αρχείο blob.
	δικό συνημμένα προσθήκη-στο-τέλος: (
		Λεξικό νέο
			αρχείο: αρχείο διαδρομή,
			mime: ['image/'] + (Server mimetype: αρχείο διαδρομή),
			δεδομένα: blob base64-κωδικοποίηση
	).
	blob αποδέσμευση. <- ['cid:attachment'] + id.
}.

HTML-Ηλ-μήνυμα όταν: ['δημιούργησε'] κάνε: {
	>> αλλαγή-γραμμής := ['\r\n'].
	>> συμβολοσειρά := [''].
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['From: '] + δικό όνομα-αποστολέα + [' <'] + ( δικό αποστολέας ) + ['>']) + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['To: '] + ( δικό παραλήπτες συνένωση: [','] )) + αλλαγή-γραμμής.
	δικό cc πλήθος αληθές: {
		συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Cc: '] + ( δικό cc συνένωση: [','] )) + αλλαγή-γραμμής.
	}.
	δικό bcc πλήθος αληθές: {
		συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Bcc: '] + ( δικό bcc συνένωση: [','] )) + αλλαγή-γραμμής.
	}.
	συμβολοσειρά προσθήκη-στο-τέλος: (εαυτός κεφαλίδα: ['Subject: '] + δικό θέμα) + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: ['MIME-Version: 1.0'] + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Type: multipart/related; boundary="'] + δικό όριο + ['"; type=text/html'] + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: ['--'] + δικό όριο + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Type: text/html; charset=UTF-8'] + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Transfer-Encoding: 7bit'] + αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
	συμβολοσειρά προσθήκη-στο-τέλος: δικό σώμα.
	συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
	δικό συνημμένα κάθε: { :id :πληροφορίες
		>> blob := πληροφορίες δεδομένα.
		συμβολοσειρά προσθήκη-στο-τέλος: ['--'] + δικό όριο + αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Type: '] + πληροφορίες mime + αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Transfer-Encoding: base64'] + αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: ['Content-ID: <attachment'] + id + ['>'] + αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: ['Content-Disposition: inline; filename="'] + πληροφορίες αρχείο + ['"'] + αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
		>> ανώτατο := 76.
		>> μήκος-κειμένου := blob μήκος.
		>> κομμάτια := (μήκος-κειμένου / ανώτατο) στρογγύλευση-πάνω.
		{ :i
			>> κομμάτι := blob αντιγραφή από: i * ανώτατο μήκος: ανώτατο.
			συμβολοσειρά προσθήκη-στο-τέλος: κομμάτι + αλλαγή-γραμμής.
		} * κομμάτια.
		συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
		συμβολοσειρά προσθήκη-στο-τέλος: αλλαγή-γραμμής.
	}.
	συμβολοσειρά προσθήκη-στο-τέλος: ['--'] + δικό όριο + ['--'] + αλλαγή-γραμμής. <- συμβολοσειρά.
}.
