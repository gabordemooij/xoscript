HTTP-Αίτημα όταν: ['HTTP-κεφαλίδα:'] κάνε: { :κλειδί <- Πρόγραμμα ρύθμιση: κλειδί.
}.

>> Κεφαλίδα-HTTP := Αντικείμενο νέο.

Κεφαλίδα-HTTP όταν: ['νέο'] κάνε: { <- εαυτός νέο αρχικοποίησε.
}.

Κεφαλίδα-HTTP όταν: ['αρχικοποίησε'] κάνε: {
	δικό κλειδί := Κενό.
	δικό τιμή := Κενό.
}.

Κεφαλίδα-HTTP όταν: ['κλειδί:τιμή:'] κάνε: { :κλειδί :τιμή
	δικό κλειδί := κλειδί.
	δικό τιμή := τιμή.
}.

Κεφαλίδα-HTTP όταν: ['κλειδί'] κάνε: { <- δικό κλειδί.
}.

Κεφαλίδα-HTTP όταν: ['τιμή'] κάνε: { <- δικό τιμή.
}.


Κεφαλίδα-HTTP όταν: ['κείμενο'] κάνε: {
	>> γραμμή := δικό κλειδί + [': '] + δικό τιμή.
	γραμμή αντικατάσταση: ['\r'] με: [''], αντικατάσταση: ['\n'] με: ['']. <- γραμμή + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Έγγραφο-Ιστού := Αντικείμενο νέο.

Έγγραφο-Ιστού όταν: ['νέο'] κάνε: { <- εαυτός νέο αρχικοποίησε.
}.

Έγγραφο-Ιστού όταν: ['αρχικοποίησε'] κάνε: {
	δικό κεφαλίδες := Λίστα νέο.
	δικό αναγνωριστικό-συνεδρίας := Κενό.
	δικό διαχειριστής-συνεδριών := Συνεδρία-προσωρινού-αρχείου νέο.
	δικό δεδομένα-συνεδρίας := Κενό.
	δικό ασφαλές := Αληθές.
	δικό ίδιος-ιστότοπος := ['Strict'].
	δικό κεφαλίδες-εστάλησαν := Ψευδές.
	δικό αίτημα := HTTP-Αίτημα νέο.
}.

Έγγραφο-Ιστού όταν: ['αίτημα:'] κάνε: { :αίτημα
	δικό αίτημα := αίτημα.
}. 

Έγγραφο-Ιστού όταν: ['ασφαλές-cookie-συνεδρίας:'] κάνε: { :ασφαλές
	εαυτός έλεγξε-κεφαλίδες.
	δικό ασφαλές := ασφαλές.
}.

Έγγραφο-Ιστού όταν: ['cookie-συνεδρίας-ίδιου-ιστότοπου:'] κάνε: { :τιμή
	εαυτός έλεγξε-κεφαλίδες.
	>> επιλογές := Λίστα νέο 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	επιλογές έχει: τιμή, ψευδές: {
		αυτή-η-εργασία λάθος: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	δικό ίδιος-ιστότοπος := τιμή.
}.

Έγγραφο-Ιστού όταν: ['κεφαλίδα:'] κάνε: { :κεφαλίδα
	εαυτός έλεγξε-κεφαλίδες.
	δικό κεφαλίδες προσθήκη-στο-τέλος: κεφαλίδα.
}.

Έγγραφο-Ιστού όταν: ['άδειασε-κεφαλίδες'] κάνε: {
	εαυτός έλεγξε-κεφαλίδες.
	δικό κεφαλίδες := Λίστα νέο.
}.

Έγγραφο-Ιστού όταν: ['διαχειριστής-συνεδριών:'] κάνε: { :διαχειριστής
	εαυτός έλεγξε-κεφαλίδες.
	δικό διαχειριστής-συνεδριών := διαχειριστής.
}.

Έγγραφο-Ιστού όταν: ['διαχειριστής-συνεδριών'] κάνε: { <- δικό διαχειριστής-συνεδριών.
}.

Έγγραφο-Ιστού όταν: ['έλεγξε-κεφαλίδες'] κάνε: {
	δικό κεφαλίδες-εστάλησαν αληθές: {
		αυτή-η-εργασία λάθος: ['Headers already sent to client.'].
	}.
}.

Έγγραφο-Ιστού όταν: ['ξεκίνα-συνεδρία'] κάνε: {
	εαυτός έλεγξε-κεφαλίδες.
	>> αίτημα := δικό αίτημα.
	>> αναγνωριστικό-συνεδρίας := αίτημα cookie: ['xsid'].
	αναγνωριστικό-συνεδρίας Κενό? ψευδές: {
		(( Μοτίβο νέο: ['^[A-Za-z0-9]+\\z'], ταίριασμα: αναγνωριστικό-συνεδρίας ) = 0) αληθές: {
			αναγνωριστικό-συνεδρίας := Κενό.
		}.
	}.
	αναγνωριστικό-συνεδρίας Κενό? αληθές: {
		αναγνωριστικό-συνεδρίας := Θησαυροφυλάκιο διακριτικό: 30.
		>> κεφαλίδα-συνεδρίας := Κεφαλίδα-HTTP νέο
		κλειδί: ['Set-Cookie'] τιμή: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (δικό ασφαλές είτε: ['Secure'] είτε: ['']),
		SSITE: (δικό ίδιος-ιστότοπος),
		XSID: αναγνωριστικό-συνεδρίας
		).
		δικό κεφαλίδες προσθήκη-στο-τέλος: κεφαλίδα-συνεδρίας.
	}.
	δικό δεδομένα-συνεδρίας := δικό διαχειριστής-συνεδριών για: αναγνωριστικό-συνεδρίας, φόρτωσε. <- δικό δεδομένα-συνεδρίας. # reference
}.

Έγγραφο-Ιστού όταν: ['μετάβαση:'] κάνε: { :διεύθυνση
	εαυτός έλεγξε-κεφαλίδες.
	εαυτός άδειασε-κεφαλίδες.
	δικό κεφαλίδες
	προσθήκη-στο-τέλος: (
		Κεφαλίδα-HTTP νέο
		κλειδί: ['Status'] τιμή: ['303 See Other']
	),
	προσθήκη-στο-τέλος: (
		Κεφαλίδα-HTTP νέο
		κλειδί: ['Location'] τιμή: διεύθυνση
	).
	εαυτός έξοδος: ['Redirect'].
}.

Έγγραφο-Ιστού όταν: ['κατάστρεψε-συνεδρία'] κάνε: {
	εαυτός έλεγξε-κεφαλίδες.
	>> αίτημα := δικό αίτημα.
	>> αναγνωριστικό-συνεδρίας := αίτημα cookie: ['xsid'].
	αναγνωριστικό-συνεδρίας Κενό? ψευδές: {
		>> κεφαλίδα-συνεδρίας := Κεφαλίδα-HTTP νέο.
		>> στιγμή := Στιγμή νέο έτος: 1970, μορφή: ['%a, %d %b %Y %H:%M:%S GMT'].
		κεφαλίδα-συνεδρίας κλειδί: ['Set-Cookie'] τιμή: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: στιγμή,
			SEC: (δικό ασφαλές είτε: ['Secure'] είτε: ['']),
			SSITE: (δικό ίδιος-ιστότοπος),
			XSID: αναγνωριστικό-συνεδρίας
		).
		δικό διαχειριστής-συνεδριών κατάστρεψε.
		δικό κεφαλίδες προσθήκη-στο-τέλος: κεφαλίδα-συνεδρίας.
	}.
}.


Έγγραφο-Ιστού όταν: ['πρότυπο:'] κάνε: { :διαδρομή <- Πρότυπο νέο: (Αρχείο νέο: διαδρομή, διάβασε).
}.

Έγγραφο-Ιστού όταν: ['έξοδος:τύπος:'] κάνε: { :αποτέλεσμα :τύπος
	δικό κεφαλίδες-εστάλησαν ψευδές: {
		δικό δεδομένα-συνεδρίας Κενό? ψευδές: {
			δικό διαχειριστής-συνεδριών αποθήκευσε: δικό δεδομένα-συνεδρίας.
		}.
		δικό κεφαλίδες προσθήκη-στο-τέλος: (
			Κεφαλίδα-HTTP νέο
			κλειδί: ['Content-type'] τιμή: τύπος
		).
		δικό κεφαλίδες κάθε: { :_ :κεφαλίδα
			Έξοδος γράψε: κεφαλίδα.
		}.
		δικό κεφαλίδες-εστάλησαν := Αληθές.
		Έξοδος γράψε: ['\r\n'].
	}.
	Έξοδος γράψε: αποτέλεσμα.
}.

Έγγραφο-Ιστού όταν: ['ολοκλήρωσε:τύπος:'] κάνε: { :αποτέλεσμα :τύπος
	δικό κεφαλίδες-εστάλησαν ψευδές: {
		δικό δεδομένα-συνεδρίας Κενό? ψευδές: {
			δικό διαχειριστής-συνεδριών αποθήκευσε: δικό δεδομένα-συνεδρίας.
		}.
		δικό κεφαλίδες προσθήκη-στο-τέλος: (
			Κεφαλίδα-HTTP νέο
			κλειδί: ['Content-type'] τιμή: τύπος
		).
		δικό κεφαλίδες προσθήκη-στο-τέλος: (
			Κεφαλίδα-HTTP νέο
			κλειδί: ['Content-Length'] τιμή: αποτέλεσμα κείμενο bytes
		).
		δικό κεφαλίδες κάθε: { :_ :κεφαλίδα
			Έξοδος γράψε: κεφαλίδα.
		}.
		δικό κεφαλίδες-εστάλησαν := Αληθές.
		Έξοδος γράψε: ['\r\n'].
	}.
	Έξοδος γράψε: αποτέλεσμα.
}.

Έγγραφο-Ιστού όταν: ['έξοδος:'] κάνε: { :αποτέλεσμα
	εαυτός έξοδος: αποτέλεσμα τύπος: ['text/html; charset=utf-8'].
}.

Έγγραφο-Ιστού όταν: ['ολοκλήρωσε:'] κάνε: { :αποτέλεσμα
	εαυτός ολοκλήρωσε: αποτέλεσμα τύπος: ['text/html; charset=utf-8'].
}.

Έγγραφο-Ιστού όταν: ['json:'] κάνε: { :αποτέλεσμα
	εαυτός έξοδος: ( JSON jsonify: αποτέλεσμα ) τύπος: ['application/json'].
}.

Έγγραφο-Ιστού όταν: ['δεν-βρέθηκε:'] κάνε: { :αποτέλεσμα
	εαυτός άδειασε-κεφαλίδες κεφαλίδα: (
		Κεφαλίδα-HTTP νέο κλειδί: ['Status'] τιμή: ['404 Not Found']
	).
	εαυτός έξοδος: αποτέλεσμα.
}.


# Interface

>> Συνεδρία := Αντικείμενο νέο.

Συνεδρία όταν: ['νέο'] κάνε: { <- εαυτός νέο αρχικοποίησε για: Κενό.
}.

Συνεδρία όταν: ['για:'] κάνε: { :id
	δικό id := id.
}.

Συνεδρία όταν: ['φόρτωσε'] κάνε: {
	αυτή-η-εργασία λάθος: ['Not implemented.'].
}.

Συνεδρία όταν: ['αποθήκευσε:'] κάνε: {
	αυτή-η-εργασία λάθος: ['Not implemented.'].
}.

Συνεδρία όταν: ['κατάστρεψε'] κάνε: {
	αυτή-η-εργασία λάθος: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Συνεδρία-προσωρινού-αρχείου := Συνεδρία νέο.

Συνεδρία-προσωρινού-αρχείου όταν: ['αρχικοποίησε'] κάνε: {
	δικό αρχή-διαδρομής := ['/tmp/sess-'].
}.

Συνεδρία-προσωρινού-αρχείου όταν: ['πρόθεμα-διαδρομής:'] κάνε: { :συμβολοσειρά
	δικό αρχή-διαδρομής := συμβολοσειρά.
}.

Συνεδρία-προσωρινού-αρχείου όταν: ['αρχείο'] κάνε: { <- ( Αρχείο νέο: ( δικό αρχή-διαδρομής + δικό id + ['.txt'] ) ).
}.

Συνεδρία-προσωρινού-αρχείου όταν: ['φόρτωσε'] κάνε: {
	>> αρχείο := εαυτός αρχείο.
	αρχείο υπάρχει ψευδές: {
		αρχείο γράψε: (Λεξικό νέο κώδικας).
	}. <- αρχείο διάβασε αντικείμενο.
}.

Συνεδρία-προσωρινού-αρχείου όταν: ['αποθήκευσε:'] κάνε: { :δεδομένα
	>> αρχείο := εαυτός αρχείο.
	αρχείο υπάρχει αληθές: {
		αρχείο γράψε: δεδομένα κώδικας.
	}.
}.

Συνεδρία-προσωρινού-αρχείου όταν: ['κατάστρεψε'] κάνε: {
	>> αρχείο := εαυτός αρχείο.
	αρχείο υπάρχει αληθές: {
		αρχείο διαγραφή.
	}.
}.


>> URL := Αντικείμενο νέο.

URL όταν: ['αρχικοποίησε'] κάνε: {
	δικό πρωτόκολλο := ['https://'].
	δικό κόμβος := ['localhost'].
	δικό διαδρομή := [''].
	δικό παράμετροι-url := [''].
	δικό hash := [''].
}.

URL όταν: ['νέο'] κάνε: { <- εαυτός νέο αρχικοποίησε.
}.

URL όταν: ['κείμενο'] κάνε: { <- (
	δικό πρωτόκολλο +
	δικό κόμβος +
	δικό διαδρομή +
	δικό παράμετροι-url +
	δικό hash ).
}.

URL όταν: ['πρωτόκολλο:'] κάνε: { :πρωτόκολλο
	((Λίστα νέο ; ['http'] ; ['https']) έχει: πρωτόκολλο) αληθές: {
		δικό πρωτόκολλο := πρωτόκολλο + ['://'].
	}, ψευδές: {
		αυτή-η-εργασία λάθος: ['Invalid protocol'].
	}.
}.

URL όταν: ['κόμβος:'] κάνε: { :κόμβος
	#todo validate according to rfc
	δικό κόμβος := κόμβος.
}.

URL όταν: ['διαδρομή:'] κάνε: { :διαδρομή
	δικό διαδρομή := ['/'] + διαδρομή url-κωδικοποίηση.
}.

URL όταν: ['παράμετροι-url:'] κάνε: { :αντιστοίχιση
	>> παράμετροι-url := Λίστα νέο.
	αντιστοίχιση κάθε: { :κλειδί :τιμή
		παράμετροι-url προσθήκη-στο-τέλος: κλειδί κείμενο url-κωδικοποίηση + ['='] + τιμή κείμενο url-κωδικοποίηση.
	}.
	δικό παράμετροι-url := ['?'] + ( παράμετροι-url συνένωση: ['&'] ).
}.

URL όταν: ['κατακερματισμός:'] κάνε: { :hash
	δικό hash := ['#'] + hash url-κωδικοποίηση.
}.

