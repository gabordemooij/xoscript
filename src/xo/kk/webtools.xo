HTTP-Сұраныс келгенде: ['HTTP-тақырыпша:'] орында: { :кілт <- Бағдарлама баптау: кілт.
}.

>> HTTP-Тақырыпша := Нысан жаңа.

HTTP-Тақырыпша келгенде: ['жаңа'] орында: { <- өзі жаңа инициализациялау.
}.

HTTP-Тақырыпша келгенде: ['инициализациялау'] орында: {
	өзінің кілт := Бос.
	өзінің мән := Бос.
}.

HTTP-Тақырыпша келгенде: ['кілт:мән:'] орында: { :кілт :мән
	өзінің кілт := кілт.
	өзінің мән := мән.
}.

HTTP-Тақырыпша келгенде: ['кілт'] орында: { <- өзінің кілт.
}.

HTTP-Тақырыпша келгенде: ['мән'] орында: { <- өзінің мән.
}.


HTTP-Тақырыпша келгенде: ['мәтін'] орында: {
	>> жол-мәтін := өзінің кілт + [': '] + өзінің мән.
	жол-мәтін ауыстыру: ['\r'] мынаған: [''], ауыстыру: ['\n'] мынаған: ['']. <- жол-мәтін + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Веб-құжат := Нысан жаңа.

Веб-құжат келгенде: ['жаңа'] орында: { <- өзі жаңа инициализациялау.
}.

Веб-құжат келгенде: ['инициализациялау'] орында: {
	өзінің тақырыпшалар := Тізім жаңа.
	өзінің сеанс-id := Бос.
	өзінің сеанс-менеджері := Уақытша-файл-сеансы жаңа.
	өзінің сеанс-деректері := Бос.
	өзінің қауіпсіз := Ақиқат.
	өзінің бір-сайт := ['Strict'].
	өзінің тақырыпшалар-жіберілді := Жалған.
	өзінің сұраныс := HTTP-Сұраныс жаңа.
}.

Веб-құжат келгенде: ['сұраныс:'] орында: { :сұраныс
	өзінің сұраныс := сұраныс.
}. 

Веб-құжат келгенде: ['қауіпсіз-сеанс-cookie:'] орында: { :қауіпсіз
	өзі тақырыпшаларды-тексеру.
	өзінің қауіпсіз := қауіпсіз.
}.

Веб-құжат келгенде: ['бір-сайт-сеанс-cookie:'] орында: { :мән
	өзі тақырыпшаларды-тексеру.
	>> опциялар := Тізім жаңа 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	опциялар бар-ма: мән, жалған-болса: {
		осы-тапсырма қате: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	өзінің бір-сайт := мән.
}.

Веб-құжат келгенде: ['тақырыпша:'] орында: { :тақырыпша
	өзі тақырыпшаларды-тексеру.
	өзінің тақырыпшалар соңына-қосу: тақырыпша.
}.

Веб-құжат келгенде: ['тақырыпшаларды-босату'] орында: {
	өзі тақырыпшаларды-тексеру.
	өзінің тақырыпшалар := Тізім жаңа.
}.

Веб-құжат келгенде: ['сеанс-менеджері:'] орында: { :менеджер
	өзі тақырыпшаларды-тексеру.
	өзінің сеанс-менеджері := менеджер.
}.

Веб-құжат келгенде: ['сеанс-менеджері'] орында: { <- өзінің сеанс-менеджері.
}.

Веб-құжат келгенде: ['тақырыпшаларды-тексеру'] орында: {
	өзінің тақырыпшалар-жіберілді ақиқат-болса: {
		осы-тапсырма қате: ['Headers already sent to client.'].
	}.
}.

Веб-құжат келгенде: ['сеансты-бастау'] орында: {
	өзі тақырыпшаларды-тексеру.
	>> сұраныс := өзінің сұраныс.
	>> сеанс-id := сұраныс cookie: ['xsid'].
	сеанс-id Бос? жалған-болса: {
		(( Үлгі жаңа: ['^[A-Za-z0-9]+\\z'], сәйкестік: сеанс-id ) = 0) ақиқат-болса: {
			сеанс-id := Бос.
		}.
	}.
	сеанс-id Бос? ақиқат-болса: {
		сеанс-id := Сейф токен: 30.
		>> сеанс-тақырыпшасы := HTTP-Тақырыпша жаңа
		кілт: ['Set-Cookie'] мән: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (өзінің қауіпсіз бұл: ['Secure'] не-ол: ['']),
		SSITE: (өзінің бір-сайт),
		XSID: сеанс-id
		).
		өзінің тақырыпшалар соңына-қосу: сеанс-тақырыпшасы.
	}.
	өзінің сеанс-деректері := өзінің сеанс-менеджері үшін: сеанс-id, жүктеу. <- өзінің сеанс-деректері. # reference
}.

Веб-құжат келгенде: ['өту:'] орында: { :мекенжай
	өзі тақырыпшаларды-тексеру.
	өзі тақырыпшаларды-босату.
	өзінің тақырыпшалар
	соңына-қосу: (
		HTTP-Тақырыпша жаңа
		кілт: ['Status'] мән: ['303 See Other']
	),
	соңына-қосу: (
		HTTP-Тақырыпша жаңа
		кілт: ['Location'] мән: мекенжай
	).
	өзі шығару: ['Redirect'].
}.

Веб-құжат келгенде: ['сеансты-жою'] орында: {
	өзі тақырыпшаларды-тексеру.
	>> сұраныс := өзінің сұраныс.
	>> сеанс-id := сұраныс cookie: ['xsid'].
	сеанс-id Бос? жалған-болса: {
		>> сеанс-тақырыпшасы := HTTP-Тақырыпша жаңа.
		>> сәт := Сәт жаңа жыл: 1970, пішім: ['%a, %d %b %Y %H:%M:%S GMT'].
		сеанс-тақырыпшасы кілт: ['Set-Cookie'] мән: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: сәт,
			SEC: (өзінің қауіпсіз бұл: ['Secure'] не-ол: ['']),
			SSITE: (өзінің бір-сайт),
			XSID: сеанс-id
		).
		өзінің сеанс-менеджері құрту.
		өзінің тақырыпшалар соңына-қосу: сеанс-тақырыпшасы.
	}.
}.


Веб-құжат келгенде: ['қалып:'] орында: { :жол <- Қалып жаңа: (Файл жаңа: жол, оқу).
}.

Веб-құжат келгенде: ['шығару:түр:'] орында: { :нәтиже :түр
	өзінің тақырыпшалар-жіберілді жалған-болса: {
		өзінің сеанс-деректері Бос? жалған-болса: {
			өзінің сеанс-менеджері сақтау: өзінің сеанс-деректері.
		}.
		өзінің тақырыпшалар соңына-қосу: (
			HTTP-Тақырыпша жаңа
			кілт: ['Content-type'] мән: түр
		).
		өзінің тақырыпшалар әрбір: { :_ :тақырыпша
			Шығыс жазу: тақырыпша.
		}.
		өзінің тақырыпшалар-жіберілді := Ақиқат.
		Шығыс жазу: ['\r\n'].
	}.
	Шығыс жазу: нәтиже.
}.

Веб-құжат келгенде: ['аяқтау:түр:'] орында: { :нәтиже :түр
	өзінің тақырыпшалар-жіберілді жалған-болса: {
		өзінің сеанс-деректері Бос? жалған-болса: {
			өзінің сеанс-менеджері сақтау: өзінің сеанс-деректері.
		}.
		өзінің тақырыпшалар соңына-қосу: (
			HTTP-Тақырыпша жаңа
			кілт: ['Content-type'] мән: түр
		).
		өзінің тақырыпшалар соңына-қосу: (
			HTTP-Тақырыпша жаңа
			кілт: ['Content-Length'] мән: нәтиже мәтін bytes
		).
		өзінің тақырыпшалар әрбір: { :_ :тақырыпша
			Шығыс жазу: тақырыпша.
		}.
		өзінің тақырыпшалар-жіберілді := Ақиқат.
		Шығыс жазу: ['\r\n'].
	}.
	Шығыс жазу: нәтиже.
}.

Веб-құжат келгенде: ['шығару:'] орында: { :нәтиже
	өзі шығару: нәтиже түр: ['text/html; charset=utf-8'].
}.

Веб-құжат келгенде: ['аяқтау:'] орында: { :нәтиже
	өзі аяқтау: нәтиже түр: ['text/html; charset=utf-8'].
}.

Веб-құжат келгенде: ['json:'] орында: { :нәтиже
	өзі шығару: ( JSON jsonify: нәтиже ) түр: ['application/json'].
}.

Веб-құжат келгенде: ['табылмады:'] орында: { :нәтиже
	өзі тақырыпшаларды-босату тақырыпша: (
		HTTP-Тақырыпша жаңа кілт: ['Status'] мән: ['404 Not Found']
	).
	өзі шығару: нәтиже.
}.


# Interface

>> Сеанс := Нысан жаңа.

Сеанс келгенде: ['жаңа'] орында: { <- өзі жаңа инициализациялау үшін: Бос.
}.

Сеанс келгенде: ['үшін:'] орында: { :id
	өзінің id := id.
}.

Сеанс келгенде: ['жүктеу'] орында: {
	осы-тапсырма қате: ['Not implemented.'].
}.

Сеанс келгенде: ['сақтау:'] орында: {
	осы-тапсырма қате: ['Not implemented.'].
}.

Сеанс келгенде: ['құрту'] орында: {
	осы-тапсырма қате: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Уақытша-файл-сеансы := Сеанс жаңа.

Уақытша-файл-сеансы келгенде: ['инициализациялау'] орында: {
	өзінің жол-басы := ['/tmp/sess-'].
}.

Уақытша-файл-сеансы келгенде: ['жол-префиксі:'] орында: { :жолдық
	өзінің жол-басы := жолдық.
}.

Уақытша-файл-сеансы келгенде: ['файл'] орында: { <- ( Файл жаңа: ( өзінің жол-басы + өзінің id + ['.txt'] ) ).
}.

Уақытша-файл-сеансы келгенде: ['жүктеу'] орында: {
	>> файл := өзі файл.
	файл бар жалған-болса: {
		файл жазу: (Сөздік жаңа код).
	}. <- файл оқу нысан.
}.

Уақытша-файл-сеансы келгенде: ['сақтау:'] орында: { :деректер
	>> файл := өзі файл.
	файл бар ақиқат-болса: {
		файл жазу: деректер код.
	}.
}.

Уақытша-файл-сеансы келгенде: ['құрту'] орында: {
	>> файл := өзі файл.
	файл бар ақиқат-болса: {
		файл жою.
	}.
}.


>> URL := Нысан жаңа.

URL келгенде: ['инициализациялау'] орында: {
	өзінің хаттама := ['https://'].
	өзінің хост := ['localhost'].
	өзінің жол := [''].
	өзінің url-параметрлері := [''].
	өзінің hash := [''].
}.

URL келгенде: ['жаңа'] орында: { <- өзі жаңа инициализациялау.
}.

URL келгенде: ['мәтін'] орында: { <- (
	өзінің хаттама +
	өзінің хост +
	өзінің жол +
	өзінің url-параметрлері +
	өзінің hash ).
}.

URL келгенде: ['хаттама:'] орында: { :хаттама
	((Тізім жаңа ; ['http'] ; ['https']) бар-ма: хаттама) ақиқат-болса: {
		өзінің хаттама := хаттама + ['://'].
	}, жалған-болса: {
		осы-тапсырма қате: ['Invalid protocol'].
	}.
}.

URL келгенде: ['хост:'] орында: { :хост
	#todo validate according to rfc
	өзінің хост := хост.
}.

URL келгенде: ['жол:'] орында: { :жол
	өзінің жол := ['/'] + жол url-кодтау.
}.

URL келгенде: ['url-параметрлері:'] орында: { :сәйкестендіру
	>> url-параметрлері := Тізім жаңа.
	сәйкестендіру әрбір: { :кілт :мән
		url-параметрлері соңына-қосу: кілт мәтін url-кодтау + ['='] + мән мәтін url-кодтау.
	}.
	өзінің url-параметрлері := ['?'] + ( url-параметрлері біріктіру: ['&'] ).
}.

URL келгенде: ['хэш:'] орында: { :hash
	өзінің hash := ['#'] + hash url-кодтау.
}.

