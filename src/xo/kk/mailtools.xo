>> Электрондық-хат := Нысан жаңа.

Электрондық-хат келгенде: ['инициализациялау'] орында: {
	өзінің алушылар := Тізім жаңа.
	өзінің cc := Тізім жаңа.
	өзінің bcc := Тізім жаңа.
	өзінің жіберуші := Бос.
	өзінің жіберуші-аты := Бос.
	өзінің тақырып := Бос.
	өзінің мәтін-денесі := Бос.
}.

Электрондық-хат келгенде: ['жаңа'] орында: { <- өзі жаңа инициализациялау.
}.

Электрондық-хат келгенде: ['алушыға:'] орында: { :тізбе
	өзінің алушылар := тізбе.
}.
 
Электрондық-хат келгенде: ['cc:'] орында: { :тізбе
	өзінің cc := тізбе.
}.

Электрондық-хат келгенде: ['bcc:'] орында: { :тізбе
	өзінің bcc := тізбе.
}.

Электрондық-хат келгенде: ['тақырып:'] орында: { :тақырып
	өзінің тақырып := тақырып.
}.

Электрондық-хат келгенде: ['жіберуші:атау:'] орында: { :жіберуші :атау
	өзінің жіберуші := жіберуші.
	өзінің жіберуші-аты := атау.
}.

Электрондық-хат келгенде: ['мәтін-денесі:'] орында: { :мәтін-денесі
	өзінің мәтін-денесі := мәтін-денесі.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
Электрондық-хат келгенде: ['тақырыпша:'] орында: { :жол-мәтін <- жол-мәтін ауыстыру: ['\r'] мынаған: [''], ауыстыру: ['\n'] мынаған: [''].
}.

Электрондық-хат келгенде: ['жіберу'] орында: {
	>> f := Файл tempwrite: өзі құру.
	Бағдарлама жүйе: ['sendmail -t < '] + f жол, жаңа-жол.
}.

Электрондық-хат келгенде: ['құру'] орында: {
	>> жол-үзілісі := ['\r\n'].
	>> жолдық := [''].
	жолдық соңына-қосу: (өзі тақырыпша: ['From: '] + өзінің жіберуші-аты + [' <'] + ( өзінің жіберуші ) + ['>']) + жол-үзілісі.
	жолдық соңына-қосу: (өзі тақырыпша: ['To: '] + ( өзінің алушылар біріктіру: [','] )) + жол-үзілісі.
	өзінің cc саны ақиқат-болса: {
		жолдық соңына-қосу: (өзі тақырыпша: ['Cc: '] + ( өзінің cc біріктіру: [','] )) + жол-үзілісі.
	}.
	өзінің bcc саны ақиқат-болса: {
		жолдық соңына-қосу: (өзі тақырыпша: ['Bcc: '] + ( өзінің bcc біріктіру: [','] )) + жол-үзілісі.
	}.
	жолдық соңына-қосу: (өзі тақырыпша: ['Subject: '] + өзінің тақырып) + жол-үзілісі.
	жолдық соңына-қосу: жол-үзілісі.
	жолдық соңына-қосу: өзінің мәтін-денесі.
	жолдық соңына-қосу: жол-үзілісі. <- жолдық.
}.

>> HTML-Электрондық-хат := Электрондық-хат жаңа.

HTML-Электрондық-хат келгенде: ['инициализациялау'] орында: {
	өзі инициализациялау.
	өзінің тіркемелер := Тізім жаңа.
	өзінің шекара := Сейф токен: 40.
}.

HTML-Электрондық-хат келгенде: ['тіркеу:'] орында: { :файл
	>> id := өзінің тіркемелер саны.
	>> blob := файл blob.
	өзінің тіркемелер соңына-қосу: (
		Сөздік жаңа
			файл: файл жол,
			mime: ['image/'] + (Server mimetype: файл жол),
			деректер: blob base64-кодтау
	).
	blob босату. <- ['cid:attachment'] + id.
}.

HTML-Электрондық-хат келгенде: ['құру'] орында: {
	>> жол-үзілісі := ['\r\n'].
	>> жолдық := [''].
	жолдық соңына-қосу: (өзі тақырыпша: ['From: '] + өзінің жіберуші-аты + [' <'] + ( өзінің жіберуші ) + ['>']) + жол-үзілісі.
	жолдық соңына-қосу: (өзі тақырыпша: ['To: '] + ( өзінің алушылар біріктіру: [','] )) + жол-үзілісі.
	өзінің cc саны ақиқат-болса: {
		жолдық соңына-қосу: (өзі тақырыпша: ['Cc: '] + ( өзінің cc біріктіру: [','] )) + жол-үзілісі.
	}.
	өзінің bcc саны ақиқат-болса: {
		жолдық соңына-қосу: (өзі тақырыпша: ['Bcc: '] + ( өзінің bcc біріктіру: [','] )) + жол-үзілісі.
	}.
	жолдық соңына-қосу: (өзі тақырыпша: ['Subject: '] + өзінің тақырып) + жол-үзілісі.
	жолдық соңына-қосу: ['MIME-Version: 1.0'] + жол-үзілісі.
	жолдық соңына-қосу: ['Content-Type: multipart/related; boundary="'] + өзінің шекара + ['"; type=text/html'] + жол-үзілісі.
	жолдық соңына-қосу: жол-үзілісі.
	жолдық соңына-қосу: ['--'] + өзінің шекара + жол-үзілісі.
	жолдық соңына-қосу: ['Content-Type: text/html; charset=UTF-8'] + жол-үзілісі.
	жолдық соңына-қосу: ['Content-Transfer-Encoding: 7bit'] + жол-үзілісі.
	жолдық соңына-қосу: жол-үзілісі.
	жолдық соңына-қосу: өзінің мәтін-денесі.
	жолдық соңына-қосу: жол-үзілісі.
	өзінің тіркемелер әрбір: { :id :ақпарат
		>> blob := ақпарат деректер.
		жолдық соңына-қосу: ['--'] + өзінің шекара + жол-үзілісі.
		жолдық соңына-қосу: ['Content-Type: '] + ақпарат mime + жол-үзілісі.
		жолдық соңына-қосу: ['Content-Transfer-Encoding: base64'] + жол-үзілісі.
		жолдық соңына-қосу: ['Content-ID: <attachment'] + id + ['>'] + жол-үзілісі.
		жолдық соңына-қосу: ['Content-Disposition: inline; filename="'] + ақпарат файл + ['"'] + жол-үзілісі.
		жолдық соңына-қосу: жол-үзілісі.
		>> ең-көп := 76.
		>> мәтін-ұзындығы := blob ұзындық.
		>> кесінділер := (мәтін-ұзындығы / ең-көп) жоғары-дөңгелектеу.
		{ :i
			>> кесінді := blob көшіру бастап: i * ең-көп ұзындық: ең-көп.
			жолдық соңына-қосу: кесінді + жол-үзілісі.
		} * кесінділер.
		жолдық соңына-қосу: жол-үзілісі.
		жолдық соңына-қосу: жол-үзілісі.
	}.
	жолдық соңына-қосу: ['--'] + өзінің шекара + ['--'] + жол-үзілісі. <- жолдық.
}.
