
# ~ Simple template engine ~

>> Қалып := Нысан жаңа.

Қалып келгенде: ['жаңа'] орында: { <- өзі жаңа мазмұн: [''].
}.

Қалып келгенде: ['мазмұн:'] орында: { :мазмұн
	өзінің мазмұн := мазмұн. 
}.

Қалып келгенде: ['жаңа:'] орында: { :мазмұн <- өзі жаңа мазмұн: мазмұн.
}.

Қалып келгенде: ['қию:'] орында: { :белгі
	>> бастапқы-белгі := (['<!-- cut:%id% -->'] %id%: белгі).
	>> соңғы-белгі := (['<!-- /cut:%id% -->'] %id%: белгі).
	>> бөліктер := өзінің мазмұн бөлу: бастапқы-белгі.
	>> префикс := бөліктер бірінші.
	>> бөліктер2 := бөліктер соңғы бөлу: соңғы-белгі.
	>> жұрнақ := бөліктер2 соңғы.
	>> бөлік := бөліктер2 бірінші.
	>> қалдық := префикс + жұрнақ.
	өзінің мазмұн := қалдық. <- Қалып жаңа: бөлік.
	
}.

Қалып келгенде: ['көшіру'] орында: { <- өзі жаңа: өзі мәтін көшіру.
}.
	
Қалып келгенде: ['кірістіру:кілт:'] орында: { :үзінді :id
	>> қою-белгісі := (['<!-- paste:%id% -->'] %id%: id).
	өзінің мазмұн ауыстыру: қою-белгісі мынаған: ( үзінді мәтін + қою-белгісі ).
}.

Қалып келгенде: ['орнату:мән:'] орында: { :орын :мән
	өзінің мазмұн ауыстыру: ['<!-- slot:'] + орын + [' -->'] мынаған: ( Server html-кодтау: мән ).
}.

Қалып келгенде: ['орнату:html:'] орында: { :орын :html
	өзінің мазмұн ауыстыру: ['<!-- slot:'] + орын + [' -->'] мынаған: html.
}.

Қалып келгенде: ['жауап:және:'] орында: { :орын :мән
	өзі орнату: (орын бастап: 0 ұзындық: (орын ұзындық - 1)) мән: мән.
}.

Қалып келгенде: ['nl2br'] орында: {
	өзінің мазмұн ауыстыру: ['\n'] мынаған: ['<br>'].
}.

Қалып келгенде: ['ретке-келтіру'] орында: {
	өзінің мазмұн :=
		Үлгі
		жаңа: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		сәйкестік: өзінің мазмұн
		орында: { <- ['']. }.
}.

Қалып келгенде: ['қиындыларды-ретке-келтіру'] орында: {
	>> элементтер := Тізім жаңа.
	Үлгі
	жаңа: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	сәйкестік: өзінің мазмұн
	орында: { :_ :бөлік
		элементтер соңына-қосу: бөлік ? 1.
	}.
	элементтер әрбір: { :_ :id
		өзінің мазмұн :=
			Үлгі жаңа: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			сәйкестік: өзінің мазмұн
			орында: { <- ['']. }.
	 }.
}.

Қалып келгенде: ['бос-орындарды-ретке-келтіру'] орында: {
	өзінің мазмұн :=
		Үлгі
		жаңа: ['\\s*\\n'],
		сәйкестік: өзінің мазмұн
		орында: { <- ['\n']. }.
	өзінің мазмұн :=
		Үлгі
		жаңа: ['\\n[\\s\\t]+'],
		сәйкестік: өзінің мазмұн
		орында: { <- ['\n']. }.
}.

Қалып келгенде: ['бәрін-ретке-келтіру'] орында: {
	өзі ретке-келтіру.
	өзі қиындыларды-ретке-келтіру.
	өзі бос-орындарды-ретке-келтіру.
}.

Қалып келгенде: ['мәтін'] орында: { <- өзінің мазмұн.
}.
