HTTP-Förfrågan vid: ['HTTP-huvud:'] gör: { :nyckel <- Program inställning: nyckel.
}.

>> HTTP-Huvud := Objekt ny.

HTTP-Huvud vid: ['ny'] gör: { <- själv ny initiera.
}.

HTTP-Huvud vid: ['initiera'] gör: {
	egen nyckel := Inget.
	egen värde := Inget.
}.

HTTP-Huvud vid: ['nyckel:värde:'] gör: { :nyckel :värde
	egen nyckel := nyckel.
	egen värde := värde.
}.

HTTP-Huvud vid: ['nyckel'] gör: { <- egen nyckel.
}.

HTTP-Huvud vid: ['värde'] gör: { <- egen värde.
}.


HTTP-Huvud vid: ['text'] gör: {
	>> rad := egen nyckel + [': '] + egen värde.
	rad ersätt: ['\r'] med: [''], ersätt: ['\n'] med: ['']. <- rad + [' \r\n'].
}.

# Web document, ties together headers, HTML and session

>> Webbdokument := Objekt ny.

Webbdokument vid: ['ny'] gör: { <- själv ny initiera.
}.

Webbdokument vid: ['initiera'] gör: {
	egen huvuden := Lista ny.
	egen sessions-id := Inget.
	egen sessionshanterare := Tillfällig-fil-session ny.
	egen sessionsdata := Inget.
	egen säker := Sann.
	egen samma-webbplats := ['Strict'].
	egen huvuden-skickade := Falsk.
	egen begäran := HTTP-Förfrågan ny.
}.

Webbdokument vid: ['begäran:'] gör: { :begäran
	egen begäran := begäran.
}. 

Webbdokument vid: ['säker-sessionskaka:'] gör: { :säker
	själv kontrollera-huvuden.
	egen säker := säker.
}.

Webbdokument vid: ['samma-webbplats-sessionskaka:'] gör: { :värde
	själv kontrollera-huvuden.
	>> alternativ := Lista ny 
		~ ['Strict']
		~ ['Lax']
		~ ['None'].
	
	alternativ har: värde, falsk: {
		denna-uppgift fel: ['Invalid same-site-session-cookie value (Choose between Strict, Lax or None).'].
	}.

	egen samma-webbplats := värde.
}.

Webbdokument vid: ['huvud:'] gör: { :huvud
	själv kontrollera-huvuden.
	egen huvuden lägg-till-sist: huvud.
}.

Webbdokument vid: ['töm-huvuden'] gör: {
	själv kontrollera-huvuden.
	egen huvuden := Lista ny.
}.

Webbdokument vid: ['sessionshanterare:'] gör: { :hanterare
	själv kontrollera-huvuden.
	egen sessionshanterare := hanterare.
}.

Webbdokument vid: ['sessionshanterare'] gör: { <- egen sessionshanterare.
}.

Webbdokument vid: ['kontrollera-huvuden'] gör: {
	egen huvuden-skickade sann: {
		denna-uppgift fel: ['Headers already sent to client.'].
	}.
}.

Webbdokument vid: ['starta-session'] gör: {
	själv kontrollera-huvuden.
	>> begäran := egen begäran.
	>> sessions-id := begäran cookie: ['xsid'].
	sessions-id Inget? falsk: {
		(( Mönster ny: ['^[A-Za-z0-9]+\\z'], matcha: sessions-id ) = 0) sann: {
			sessions-id := Inget.
		}.
	}.
	sessions-id Inget? sann: {
		sessions-id := Valv token: 30.
		>> sessionshuvud := HTTP-Huvud ny
		nyckel: ['Set-Cookie'] värde: ( ['xsid=XSID; Path=/; SEC; SameSite=SSITE; HttpOnly'] 
		SEC: (egen säker antingen: ['Secure'] eller: ['']),
		SSITE: (egen samma-webbplats),
		XSID: sessions-id
		).
		egen huvuden lägg-till-sist: sessionshuvud.
	}.
	egen sessionsdata := egen sessionshanterare för: sessions-id, läs-in. <- egen sessionsdata. # reference
}.

Webbdokument vid: ['gå-till:'] gör: { :adress
	själv kontrollera-huvuden.
	själv töm-huvuden.
	egen huvuden
	lägg-till-sist: (
		HTTP-Huvud ny
		nyckel: ['Status'] värde: ['303 See Other']
	),
	lägg-till-sist: (
		HTTP-Huvud ny
		nyckel: ['Location'] värde: adress
	).
	själv skriv-ut: ['Redirect'].
}.

Webbdokument vid: ['förstör-session'] gör: {
	själv kontrollera-huvuden.
	>> begäran := egen begäran.
	>> sessions-id := begäran cookie: ['xsid'].
	sessions-id Inget? falsk: {
		>> sessionshuvud := HTTP-Huvud ny.
		>> tidpunkt := Moment ny år: 1970, format: ['%a, %d %b %Y %H:%M:%S GMT'].
		sessionshuvud nyckel: ['Set-Cookie'] värde: ( 
			['xsid=XSID; Path=/; Expires=EXP; SEC; SameSite=SSITE; HttpOnly']
			EXP: tidpunkt,
			SEC: (egen säker antingen: ['Secure'] eller: ['']),
			SSITE: (egen samma-webbplats),
			XSID: sessions-id
		).
		egen sessionshanterare förstör.
		egen huvuden lägg-till-sist: sessionshuvud.
	}.
}.


Webbdokument vid: ['mall:'] gör: { :sökväg <- Mall ny: (Fil ny: sökväg, läs).
}.

Webbdokument vid: ['skriv-ut:typ:'] gör: { :utdata :typ
	egen huvuden-skickade falsk: {
		egen sessionsdata Inget? falsk: {
			egen sessionshanterare spara: egen sessionsdata.
		}.
		egen huvuden lägg-till-sist: (
			HTTP-Huvud ny
			nyckel: ['Content-type'] värde: typ
		).
		egen huvuden varje: { :_ :huvud
			Utdata skriv: huvud.
		}.
		egen huvuden-skickade := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: utdata.
}.

Webbdokument vid: ['avsluta:typ:'] gör: { :utdata :typ
	egen huvuden-skickade falsk: {
		egen sessionsdata Inget? falsk: {
			egen sessionshanterare spara: egen sessionsdata.
		}.
		egen huvuden lägg-till-sist: (
			HTTP-Huvud ny
			nyckel: ['Content-type'] värde: typ
		).
		egen huvuden lägg-till-sist: (
			HTTP-Huvud ny
			nyckel: ['Content-Length'] värde: utdata text bytes
		).
		egen huvuden varje: { :_ :huvud
			Utdata skriv: huvud.
		}.
		egen huvuden-skickade := Sann.
		Utdata skriv: ['\r\n'].
	}.
	Utdata skriv: utdata.
}.

Webbdokument vid: ['skriv-ut:'] gör: { :utdata
	själv skriv-ut: utdata typ: ['text/html; charset=utf-8'].
}.

Webbdokument vid: ['avsluta:'] gör: { :utdata
	själv avsluta: utdata typ: ['text/html; charset=utf-8'].
}.

Webbdokument vid: ['json:'] gör: { :utdata
	själv skriv-ut: ( JSON jsonify: utdata ) typ: ['application/json'].
}.

Webbdokument vid: ['hittades-inte:'] gör: { :utdata
	själv töm-huvuden huvud: (
		HTTP-Huvud ny nyckel: ['Status'] värde: ['404 Not Found']
	).
	själv skriv-ut: utdata.
}.


# Interface

>> Session := Objekt ny.

Session vid: ['ny'] gör: { <- själv ny initiera för: Inget.
}.

Session vid: ['för:'] gör: { :id
	egen id := id.
}.

Session vid: ['läs-in'] gör: {
	denna-uppgift fel: ['Not implemented.'].
}.

Session vid: ['spara:'] gör: {
	denna-uppgift fel: ['Not implemented.'].
}.

Session vid: ['förstör'] gör: {
	denna-uppgift fel: ['Not implemented.'].
}.

# Default Session implementation, uses tempfile

>> Tillfällig-fil-session := Session ny.

Tillfällig-fil-session vid: ['initiera'] gör: {
	egen sökvägsbörjan := ['/tmp/sess-'].
}.

Tillfällig-fil-session vid: ['sökvägsprefix:'] gör: { :teckensträng
	egen sökvägsbörjan := teckensträng.
}.

Tillfällig-fil-session vid: ['fil'] gör: { <- ( Fil ny: ( egen sökvägsbörjan + egen id + ['.txt'] ) ).
}.

Tillfällig-fil-session vid: ['läs-in'] gör: {
	>> fil := själv fil.
	fil finns falsk: {
		fil skriv: (Ordbok ny code).
	}. <- fil läs objekt.
}.

Tillfällig-fil-session vid: ['spara:'] gör: { :data
	>> fil := själv fil.
	fil finns sann: {
		fil skriv: data code.
	}.
}.

Tillfällig-fil-session vid: ['förstör'] gör: {
	>> fil := själv fil.
	fil finns sann: {
		fil radera.
	}.
}.


>> URL := Objekt ny.

URL vid: ['initiera'] gör: {
	egen protokoll := ['https://'].
	egen värd := ['localhost'].
	egen sökväg := [''].
	egen url-parametrar := [''].
	egen hash := [''].
}.

URL vid: ['ny'] gör: { <- själv ny initiera.
}.

URL vid: ['text'] gör: { <- (
	egen protokoll +
	egen värd +
	egen sökväg +
	egen url-parametrar +
	egen hash ).
}.

URL vid: ['protokoll:'] gör: { :protokoll
	((Lista ny ; ['http'] ; ['https']) har: protokoll) sann: {
		egen protokoll := protokoll + ['://'].
	}, falsk: {
		denna-uppgift fel: ['Invalid protocol'].
	}.
}.

URL vid: ['värd:'] gör: { :värd
	#todo validate according to rfc
	egen värd := värd.
}.

URL vid: ['sökväg:'] gör: { :sökväg
	egen sökväg := ['/'] + sökväg url-koda.
}.

URL vid: ['url-parametrar:'] gör: { :mappning
	>> url-parametrar := Lista ny.
	mappning varje: { :nyckel :värde
		url-parametrar lägg-till-sist: nyckel text url-koda + ['='] + värde text url-koda.
	}.
	egen url-parametrar := ['?'] + ( url-parametrar sammanfoga: ['&'] ).
}.

URL vid: ['hash:'] gör: { :hash
	egen hash := ['#'] + hash url-koda.
}.

