
# ~ Simple template engine ~

>> Mall := Objekt ny.

Mall vid: ['ny'] gör: { <- själv ny innehåll: [''].
}.

Mall vid: ['innehåll:'] gör: { :innehåll
	egen innehåll := innehåll. 
}.

Mall vid: ['ny:'] gör: { :innehåll <- själv ny innehåll: innehåll.
}.

Mall vid: ['klipp:'] gör: { :markör
	>> startmarkör := (['<!-- cut:%id% -->'] %id%: markör).
	>> slutmarkör := (['<!-- /cut:%id% -->'] %id%: markör).
	>> delar := egen innehåll dela: startmarkör.
	>> prefix := delar första.
	>> delar2 := delar sista dela: slutmarkör.
	>> suffix := delar2 sista.
	>> del := delar2 första.
	>> rest := prefix + suffix.
	egen innehåll := rest. <- Mall ny: del.
	
}.

Mall vid: ['kopiera'] gör: { <- själv ny: själv text kopiera.
}.
	
Mall vid: ['klistra:vid:'] gör: { :utdrag :id
	>> klistermarkör := (['<!-- paste:%id% -->'] %id%: id).
	egen innehåll ersätt: klistermarkör med: ( utdrag text + klistermarkör ).
}.

Mall vid: ['sätt:värde:'] gör: { :plats :värde
	egen innehåll ersätt: ['<!-- slot:'] + plats + [' -->'] med: ( Server html-koda: värde ).
}.

Mall vid: ['sätt:html:'] gör: { :plats :html
	egen innehåll ersätt: ['<!-- slot:'] + plats + [' -->'] med: html.
}.

Mall vid: ['svara:och:'] gör: { :plats :värde
	själv sätt: (plats från: 0 längd: (plats längd - 1)) värde: värde.
}.

Mall vid: ['nl2br'] gör: {
	egen innehåll ersätt: ['\n'] med: ['<br>'].
}.

Mall vid: ['putsa'] gör: {
	egen innehåll :=
		Mönster
		ny: ['\\<\\!\\-\\- (paste|slot)\\:\\S+ \\-\\-\\>'],
		matcha: egen innehåll
		gör: { <- ['']. }.
}.

Mall vid: ['putsa-klipp'] gör: {
	>> element := Lista ny.
	Mönster
	ny: ['\\<\\!\\-\\- cut\\:(\\S+) \\-\\-\\>'],
	matcha: egen innehåll
	gör: { :_ :del
		element lägg-till-sist: del ? 1.
	}.
	element varje: { :_ :id
		egen innehåll :=
			Mönster ny: ( ['(?s)\\<\\!\\-\\- cut\\:'] + id + [' \\-\\-\\>.*\\<\\!\\-\\- \\/cut\\:'] + id + [' \\-\\-\\>']),
			matcha: egen innehåll
			gör: { <- ['']. }.
	 }.
}.

Mall vid: ['putsa-mellanrum'] gör: {
	egen innehåll :=
		Mönster
		ny: ['\\s*\\n'],
		matcha: egen innehåll
		gör: { <- ['\n']. }.
	egen innehåll :=
		Mönster
		ny: ['\\n[\\s\\t]+'],
		matcha: egen innehåll
		gör: { <- ['\n']. }.
}.

Mall vid: ['putsa-allt'] gör: {
	själv putsa.
	själv putsa-klipp.
	själv putsa-mellanrum.
}.

Mall vid: ['text'] gör: { <- egen innehåll.
}.
