>> E-post := Objekt ny.

E-post vid: ['initiera'] gör: {
	egen mottagare := Lista ny.
	egen cc := Lista ny.
	egen bcc := Lista ny.
	egen avsändare := Inget.
	egen avsändarnamn := Inget.
	egen ämne := Inget.
	egen meddelandetext := Inget.
}.

E-post vid: ['ny'] gör: { <- själv ny initiera.
}.

E-post vid: ['till:'] gör: { :uppräkning
	egen mottagare := uppräkning.
}.
 
E-post vid: ['cc:'] gör: { :uppräkning
	egen cc := uppräkning.
}.

E-post vid: ['bcc:'] gör: { :uppräkning
	egen bcc := uppräkning.
}.

E-post vid: ['ämne:'] gör: { :ämne
	egen ämne := ämne.
}.

E-post vid: ['avsändare:namn:'] gör: { :avsändare :namn
	egen avsändare := avsändare.
	egen avsändarnamn := namn.
}.

E-post vid: ['meddelandetext:'] gör: { :meddelandetext
	egen meddelandetext := meddelandetext.
}.

# A line break ends a header, and sendmail -t reads the recipients from the
# headers. Remove them, otherwise a value could add recipients to the mail.
E-post vid: ['huvud:'] gör: { :rad <- rad ersätt: ['\r'] med: [''], ersätt: ['\n'] med: [''].
}.

E-post vid: ['skicka'] gör: {
	>> f := Fil tempwrite: själv generera.
	Program system: ['sendmail -t < '] + f sökväg, stop.
}.

E-post vid: ['generera'] gör: {
	>> radbrytning := ['\r\n'].
	>> teckensträng := [''].
	teckensträng lägg-till-sist: (själv huvud: ['From: '] + egen avsändarnamn + [' <'] + ( egen avsändare ) + ['>']) + radbrytning.
	teckensträng lägg-till-sist: (själv huvud: ['To: '] + ( egen mottagare sammanfoga: [','] )) + radbrytning.
	egen cc antal sann: {
		teckensträng lägg-till-sist: (själv huvud: ['Cc: '] + ( egen cc sammanfoga: [','] )) + radbrytning.
	}.
	egen bcc antal sann: {
		teckensträng lägg-till-sist: (själv huvud: ['Bcc: '] + ( egen bcc sammanfoga: [','] )) + radbrytning.
	}.
	teckensträng lägg-till-sist: (själv huvud: ['Subject: '] + egen ämne) + radbrytning.
	teckensträng lägg-till-sist: radbrytning.
	teckensträng lägg-till-sist: egen meddelandetext.
	teckensträng lägg-till-sist: radbrytning. <- teckensträng.
}.

>> HTML-E-post := E-post ny.

HTML-E-post vid: ['initiera'] gör: {
	själv initiera.
	egen bilagor := Lista ny.
	egen gräns := Valv token: 40.
}.

HTML-E-post vid: ['bifoga:'] gör: { :fil
	>> id := egen bilagor antal.
	>> blob := fil blob.
	egen bilagor lägg-till-sist: (
		Ordbok ny
			fil: fil sökväg,
			mime: ['image/'] + (Server mimetype: fil sökväg),
			data: blob base64-koda
	).
	blob frigör. <- ['cid:attachment'] + id.
}.

HTML-E-post vid: ['generera'] gör: {
	>> radbrytning := ['\r\n'].
	>> teckensträng := [''].
	teckensträng lägg-till-sist: (själv huvud: ['From: '] + egen avsändarnamn + [' <'] + ( egen avsändare ) + ['>']) + radbrytning.
	teckensträng lägg-till-sist: (själv huvud: ['To: '] + ( egen mottagare sammanfoga: [','] )) + radbrytning.
	egen cc antal sann: {
		teckensträng lägg-till-sist: (själv huvud: ['Cc: '] + ( egen cc sammanfoga: [','] )) + radbrytning.
	}.
	egen bcc antal sann: {
		teckensträng lägg-till-sist: (själv huvud: ['Bcc: '] + ( egen bcc sammanfoga: [','] )) + radbrytning.
	}.
	teckensträng lägg-till-sist: (själv huvud: ['Subject: '] + egen ämne) + radbrytning.
	teckensträng lägg-till-sist: ['MIME-Version: 1.0'] + radbrytning.
	teckensträng lägg-till-sist: ['Content-Type: multipart/related; boundary="'] + egen gräns + ['"; type=text/html'] + radbrytning.
	teckensträng lägg-till-sist: radbrytning.
	teckensträng lägg-till-sist: ['--'] + egen gräns + radbrytning.
	teckensträng lägg-till-sist: ['Content-Type: text/html; charset=UTF-8'] + radbrytning.
	teckensträng lägg-till-sist: ['Content-Transfer-Encoding: 7bit'] + radbrytning.
	teckensträng lägg-till-sist: radbrytning.
	teckensträng lägg-till-sist: egen meddelandetext.
	teckensträng lägg-till-sist: radbrytning.
	egen bilagor varje: { :id :info
		>> blob := info data.
		teckensträng lägg-till-sist: ['--'] + egen gräns + radbrytning.
		teckensträng lägg-till-sist: ['Content-Type: '] + info mime + radbrytning.
		teckensträng lägg-till-sist: ['Content-Transfer-Encoding: base64'] + radbrytning.
		teckensträng lägg-till-sist: ['Content-ID: <attachment'] + id + ['>'] + radbrytning.
		teckensträng lägg-till-sist: ['Content-Disposition: inline; filename="'] + info fil + ['"'] + radbrytning.
		teckensträng lägg-till-sist: radbrytning.
		>> högsta := 76.
		>> textlängd := blob längd.
		>> bitar := (textlängd / högsta) avrunda-uppåt.
		{ :i
			>> bit := blob kopiera från: i * högsta längd: högsta.
			teckensträng lägg-till-sist: bit + radbrytning.
		} * bitar.
		teckensträng lägg-till-sist: radbrytning.
		teckensträng lägg-till-sist: radbrytning.
	}.
	teckensträng lägg-till-sist: ['--'] + egen gräns + ['--'] + radbrytning. <- teckensträng.
}.
