{ :i
 
	(i = 0) teruskan.

	(i % 15 = 0) benar: {
		Keluaran tulis: ['FizzBuzz'], baris-baharu.
	}, teruskan.

	(i % 3 = 0) benar: {
		Keluaran tulis: ['Fizz'], baris-baharu.
	}, teruskan.

	(i % 5 = 0) benar: {
		Keluaran tulis: ['Buzz'], baris-baharu.
	}, teruskan.

	Keluaran tulis: i, baris-baharu.
 
} * 101.
