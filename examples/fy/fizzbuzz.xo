{ :i
 
	(i = 0) trochgean.

	(i % 15 = 0) ja: {
		Utfier skriuwe: ['FizzBuzz'], nije-rigel.
	}, trochgean.

	(i % 3 = 0) ja: {
		Utfier skriuwe: ['Fizz'], nije-rigel.
	}, trochgean.

	(i % 5 = 0) ja: {
		Utfier skriuwe: ['Buzz'], nije-rigel.
	}, trochgean.

	Utfier skriuwe: i, nije-rigel.
 
} * 101.
