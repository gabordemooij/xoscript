# Демонстрација сервера све у једном
#
# - Обрађивач HTTP захтева
# - Основни обрађивач сесија
# - Објекат базе података (MariaDB)
# - CURL
# - JSON
# - Шифровање
#
# SQL пример:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Програм управљање-меморијом: 4.

# ~ HTTP захтеви ~
Server иницијализуј.
>> долазни-захтев := HTTP-Захтев нови.
Излаз пиши: ['HTTP-GET a='] + ( долазни-захтев get: ['a'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST c='] + ( долазни-захтев post: ['c'] ), нови-ред. # POST


# ~ База података ~
>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], лозинка: ['pass123'], назив-базе: ['xobase'], повежи-се.

>> sql-упит := бп упит: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Листа нови ; ['abc'] ; 12.35 ; 6 ). # параметризовани упити

{  sql-упит изврши. бп потврди. } ухвати: { :e бп поништи.  }, покрени. # трансакције
Излаз пиши: ['УМЕТНУТО: '] + sql-упит insert-id, нови-ред. # ид уметања

>> sql-упит :=
бп упит: ['SELECT * FROM book order by id desc limit 2'], 
преузми: { :запис 
	Излаз пиши: запис id + [' '] + запис description + [': '] + запис price, нови-ред.
	#True break.
}. # дохватање редова

>> sql-упит :=
бп упит: ['SELECT * FROM book order by id desc limit 2'], 
преузми: { :запис 
	Излаз пиши: запис id + [' '] + запис description + [': '] + запис price, нови-ред.
	#True break.
}. # дохватање редова


# ~ CURL ~
Излаз пиши: ( Мрежа post: Ништа на: ['https://xoscript.com'] ) дужина, нови-ред. # post без података = GET

# ~ JSON ~
>> json-текст := (JSON jsonify: (Речник нови стави: (Листа нови ; 1 ; 2 ; 3) на: ['abc'])).
Излаз пиши: json-текст, нови-ред.
Излаз пиши: ((JSON објекат: json-текст) abc ? 1), нови-ред.

# ~ Шифровање ~
>> трезор := Сеф нови: ['Encryptor'].
Излаз пиши: ['шифруј:'], нови-ред.
>> x := Сеф шифруј: ['hello'] кључ: ['world'].
Излаз пиши: x, нови-ред.
Излаз пиши: ['дешифруј:'], нови-ред.
Излаз пиши: (Сеф дешифруј: x кључ: ['world']), нови-ред.


# ~ Обрађивач сесија (подразумевано се чува у /tmp) ~
Програм користи: ['sr/webtools.xo'].
>> веб := Веб-документ нови.
>> x := веб покрени-сесију.
Излаз пиши: x, нови-ред.
x user: 123.
веб уништи-сесију.
веб иди-на: ['/'].

# ~ Шаблон ~
Програм користи: ['sr/template.xo'].
>> html-код := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> шабл := Шаблон нови садржај: html-код.
>> greeting := шабл исеци: ['greeting'], копирај greeting: ['Здраво, свете!'].
шабл налепи: greeting на: ['greetings'].

Излаз пиши: ['========================='], нови-ред.
>> веб := Веб-документ нови.
веб испиши: шабл почисти-све.

# ~ Регуларни изрази ~
>> изворни-текст := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> регизраз := Образац нови: ['href="([^"]+)" target="([^"]+)"'].
>> резултат  := регизраз подударање: изворни-текст уради: { :m :x
	Излаз пиши: m, нови-ред.
	Излаз пиши: x, нови-ред.
	<- ['XXX'].
}.
Излаз пиши: резултат, нови-ред.

# ~ Помоћни алати ~
Излаз пиши: (Server html-кодирај: ['<&"' hello '"&>']), нови-ред.
Излаз пиши: (Server url-кодирај: ['https://example.com?a=6&b=1 2']), нови-ред.
Излаз пиши: (Формат нови: ['Number format: %06.0f \n'], примени: 56), нови-ред.
Излаз пиши: (Сеф токен: 20), нови-ред.
Излаз пиши: (Тренутак нови формат: ['%a, %d %b %Y %H:%M:%S']), нови-ред.
>> a := Server base64-кодирај: ['abc123'].
Излаз пиши: a, нови-ред.
Излаз пиши: (Server base64-декодирај: a), нови-ред.

>> u := URL нови.
u протокол: ['http'], домаћин: ['example.com'], путања: ['path'], параметри-url: (
	Речник нови
	a: ['1+'],
	b: 2
).
Излаз пиши: u, нови-ред.
