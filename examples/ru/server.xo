# Демонстрация сервера «всё в одном»
#
# - Обработчик HTTP-запросов
# - Простой обработчик сессий
# - Объект базы данных (MariaDB)
# - CURL
# - JSON
# - Шифрование
#
# Пример SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Программа режим-памяти: 4.

# ~ HTTP-запросы ~
Server инициализировать.
>> запрос-клиента := HTTP-запрос новый.
Выход написать: ['HTTP-GET a='] + ( запрос-клиента get: ['a'] ), стоп. # GET
Выход написать: ['HTTP-POST c='] + ( запрос-клиента post: ['c'] ), стоп. # POST


# ~ База данных ~
>> бд := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'], пароль: ['pass123'], имя-базы: ['xobase'], подключить.

>> запрос-бд := бд запрос: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметры: ( Список новый ; ['abc'] ; 12.35 ; 6 ). # параметризованные запросы

{  запрос-бд мутация. бд commit. } впоймать: { :ош бд rollback.  }, запуск. # транзакции
Выход написать: ['ВСТАВЛЕНО: '] + запрос-бд insert-id, стоп. # id вставки

>> запрос-бд :=
бд запрос: ['SELECT * FROM book order by id desc limit 2'], 
получить: { :запись 
	Выход написать: запись id + [' '] + запись description + [': '] + запись price, стоп.
	#True break.
}. # получение строк

>> запрос-бд :=
бд запрос: ['SELECT * FROM book order by id desc limit 2'], 
получить: { :запись 
	Выход написать: запись id + [' '] + запись description + [': '] + запись price, стоп.
	#True break.
}. # получение строк


# ~ CURL ~
Выход написать: ( Сеть post: Пустой в: ['https://xoscript.com'] ) длина, стоп. # post ничего = GET

# ~ JSON ~
>> текст-json := (JSON jsonify: (Карта новый разместить: (Список новый ; 1 ; 2 ; 3) в: ['abc'])).
Выход написать: текст-json, стоп.
Выход написать: ((JSON объект: текст-json) abc ? 1), стоп.

# ~ Шифрование ~
>> сейф := Хранилище новый: ['Encryptor'].
Выход написать: ['зашифровать:'], стоп.
>> зн := Хранилище шифровать: ['hello'] ключ: ['world'].
Выход написать: зн, стоп.
Выход написать: ['расшифровать:'], стоп.
Выход написать: (Хранилище расшифровать: зн ключ: ['world']), стоп.


# ~ Обработчик сессий (по умолчанию хранятся в /tmp) ~
Программа импортировать: ['ru/webtools.xo'].
>> веб := Веб-документ новый.
>> зн := веб начать-сессию.
Выход написать: зн, стоп.
зн user: 123.
веб уничтожить-сессию.
веб перейти-к: ['/'].

# ~ Шаблон ~
Программа импортировать: ['ru/template.xo'].
>> разметка := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> шбл := Заготовка новый содержимое: разметка.
>> greeting := шбл вырезать: ['greeting'], скопировать greeting: ['Привет, мир!'].
шбл вставить: greeting в: ['greetings'].

Выход написать: ['========================='], стоп.
>> веб := Веб-документ новый.
веб вывести: шбл подчистить-всё.

# ~ Регулярные выражения ~
>> исходный-текст := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> образец := Шаблон новый: ['href="([^"]+)" target="([^"]+)"'].
>> результат  := образец совпадение: исходный-текст выполнить: { :совп :зн
	Выход написать: совп, стоп.
	Выход написать: зн, стоп.
	<- ['XXX'].
}.
Выход написать: результат, стоп.

# ~ Утилиты ~
Выход написать: (Server html-кодировать: ['<&"' hello '"&>']), стоп.
Выход написать: (Server url-кодировать: ['https://example.com?a=6&b=1 2']), стоп.
Выход написать: (Формат новый: ['Number format: %06.0f \n'], применить: 56), стоп.
Выход написать: (Хранилище токен: 20), стоп.
Выход написать: (Момент новый формат: ['%a, %d %b %Y %H:%M:%S']), стоп.
>> a := Server base64-кодировать: ['abc123'].
Выход написать: a, стоп.
Выход написать: (Server base64-декодировать: a), стоп.

>> ссылка := URL новый.
ссылка протокол: ['http'], хост: ['example.com'], путь: ['path'], параметры-url: (
	Карта новый
	a: ['1+'],
	b: 2
).
Выход написать: ссылка, стоп.
