{ :i
 
	(i = 0) continua.

	(i % 15 = 0) cert: {
		Sortida escriu: ['FizzBuzz'], salt-de-línia.
	}, continua.

	(i % 3 = 0) cert: {
		Sortida escriu: ['Fizz'], salt-de-línia.
	}, continua.

	(i % 5 = 0) cert: {
		Sortida escriu: ['Buzz'], salt-de-línia.
	}, continua.

	Sortida escriu: i, salt-de-línia.
 
} * 101.
