{ :i
 
	(i = 0) kontynuuj.

	(i % 15 = 0) prawda: {
		Wyjście pisz: ['FizzBuzz'], nowa-linia.
	}, kontynuuj.

	(i % 3 = 0) prawda: {
		Wyjście pisz: ['Fizz'], nowa-linia.
	}, kontynuuj.

	(i % 5 = 0) prawda: {
		Wyjście pisz: ['Buzz'], nowa-linia.
	}, kontynuuj.

	Wyjście pisz: i, nowa-linia.
 
} * 101.
