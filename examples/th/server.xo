#
# ตัวอย่าง SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

โปรแกรม จัดการหน่วยความจำ: 4.

# ~ คำขอ HTTP ~
Server เตรียม.
>> คำขอ := HTTP-คำขอ สร้างใหม่.
แสดงผล เขียน: ['HTTP-GET a='] + ( คำขอ get: ['a'] ), ขึ้นบรรทัดใหม่. # GET
แสดงผล เขียน: ['HTTP-POST c='] + ( คำขอ post: ['c'] ), ขึ้นบรรทัดใหม่. # POST


# ~ ฐานข้อมูล ~
>> ฐข := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'], รหัสผ่าน: ['pass123'], ชื่อฐานข้อมูล: ['xobase'], เชื่อมต่อ.

>> คิวรีฐานข้อมูล := ฐข คิวรี: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], พารามิเตอร์: ( ลิสต์ สร้างใหม่ ; ['abc'] ; 12.35 ; 6 ). # คิวรีแบบมีพารามิเตอร์

{  คิวรีฐานข้อมูล ดำเนินการ. ฐข คอมมิต. } ดักจับ: { :e ฐข ย้อนกลับ.  }, เริ่ม. # ทรานแซกชัน
แสดงผล เขียน: ['แทรกแล้ว: '] + คิวรีฐานข้อมูล insert-id, ขึ้นบรรทัดใหม่. # id ที่แทรก

>> คิวรีฐานข้อมูล :=
ฐข คิวรี: ['SELECT * FROM book order by id desc limit 2'], 
ดึงข้อมูล: { :แถว 
	แสดงผล เขียน: แถว id + [' '] + แถว description + [': '] + แถว price, ขึ้นบรรทัดใหม่.
	#True break.
}. # การดึงแถว

>> คิวรีฐานข้อมูล :=
ฐข คิวรี: ['SELECT * FROM book order by id desc limit 2'], 
ดึงข้อมูล: { :แถว 
	แสดงผล เขียน: แถว id + [' '] + แถว description + [': '] + แถว price, ขึ้นบรรทัดใหม่.
	#True break.
}. # การดึงแถว


# ~ CURL ~
แสดงผล เขียน: ( เครือข่าย post: ว่าง ไปยัง: ['https://xoscript.com'] ) ความยาว, ขึ้นบรรทัดใหม่. # post ว่างเปล่า = GET

# ~ JSON ~
>> ข้อความjson := (JSON jsonify: (พจนานุกรม สร้างใหม่ ใส่: (ลิสต์ สร้างใหม่ ; 1 ; 2 ; 3) ที่: ['abc'])).
แสดงผล เขียน: ข้อความjson, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ((JSON ออบเจกต์: ข้อความjson) abc ? 1), ขึ้นบรรทัดใหม่.

# ~ การเข้ารหัส ~
>> ตู้เซฟ := ตู้นิรภัย สร้างใหม่: ['Encryptor'].
แสดงผล เขียน: ['เข้ารหัส:'], ขึ้นบรรทัดใหม่.
>> x := ตู้นิรภัย เข้ารหัสลับ: ['hello'] กุญแจ: ['world'].
แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ['ถอดรหัส:'], ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (ตู้นิรภัย ถอดรหัสลับ: x กุญแจ: ['world']), ขึ้นบรรทัดใหม่.


# ~ ตัวจัดการเซสชัน (โดยค่าเริ่มต้นจัดเก็บไว้ใน /tmp) ~
โปรแกรม ใช้: ['th/webtools.xo'].
>> เว็บ := เอกสารเว็บ สร้างใหม่.
>> x := เว็บ เริ่มเซสชัน.
แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
x user: 123.
เว็บ ทำลายเซสชัน.
เว็บ ไปที่: ['/'].

# ~ เทมเพลต ~
โปรแกรม ใช้: ['th/template.xo'].
>> โค้ดhtml := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> เทมเพลต := แม่แบบ สร้างใหม่ เนื้อหา: โค้ดhtml.
>> greeting := เทมเพลต ตัดออก: ['greeting'], คัดลอก greeting: ['สวัสดีชาวโลก!'].
เทมเพลต วาง: greeting ที่: ['greetings'].

แสดงผล เขียน: ['========================='], ขึ้นบรรทัดใหม่.
>> เว็บ := เอกสารเว็บ สร้างใหม่.
เว็บ แสดงผล: เทมเพลต ลบทั้งหมด.

# ~ นิพจน์ปกติ ~
>> ข้อความต้นทาง := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> แพทเทิร์น := แพตเทิร์น สร้างใหม่: ['href="([^"]+)" target="([^"]+)"'].
>> ผลการแทนที่  := แพทเทิร์น ตรงกับ: ข้อความต้นทาง ทำ: { :m :x
	แสดงผล เขียน: m, ขึ้นบรรทัดใหม่.
	แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
	<- ['XXX'].
}.
แสดงผล เขียน: ผลการแทนที่, ขึ้นบรรทัดใหม่.

# ~ เครื่องมืออรรถประโยชน์ ~
แสดงผล เขียน: (Server html-เข้ารหัส: ['<&"' hello '"&>']), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (Server url-เข้ารหัส: ['https://example.com?a=6&b=1 2']), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (รูปแบบ สร้างใหม่: ['Number format: %06.0f \n'], ใช้กับ: 56), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (ตู้นิรภัย โทเค็น: 20), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (ช่วงเวลา สร้างใหม่ รูปแบบ: ['%a, %d %b %Y %H:%M:%S']), ขึ้นบรรทัดใหม่.
>> a := Server base64-เข้ารหัส: ['abc123'].
แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (Server base64-ถอดรหัส: a), ขึ้นบรรทัดใหม่.

>> u := URL สร้างใหม่.
u โปรโตคอล: ['http'], โฮสต์: ['example.com'], เส้นทาง: ['path'], พารามิเตอร์-url: (
	พจนานุกรม สร้างใหม่
	a: ['1+'],
	b: 2
).
แสดงผล เขียน: u, ขึ้นบรรทัดใหม่.
