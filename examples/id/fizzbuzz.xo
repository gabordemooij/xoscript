{ :i
 
	(i = 0) lanjutkan.

	(i % 15 = 0) benar: {
		Keluaran tulis: ['FizzBuzz'], baris-baru.
	}, lanjutkan.

	(i % 3 = 0) benar: {
		Keluaran tulis: ['Fizz'], baris-baru.
	}, lanjutkan.

	(i % 5 = 0) benar: {
		Keluaran tulis: ['Buzz'], baris-baru.
	}, lanjutkan.

	Keluaran tulis: i, baris-baru.
 
} * 101.
