# Επίδειξη διακομιστή όλα-σε-ένα
#
# - Χειριστής αιτημάτων HTTP
# - Βασικός χειριστής συνεδριών
# - Αντικείμενο βάσης δεδομένων (MariaDB)
# - CURL
# - JSON
# - Κρυπτογράφηση
#
# Παράδειγμα SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Πρόγραμμα διαχείριση-μνήμης: 4.

# ~ Αιτήματα HTTP ~
Server αρχικοποίησε.
>> αίτηση := HTTP-Αίτημα νέο.
Έξοδος γράψε: ['HTTP-GET a='] + ( αίτηση get: ['a'] ), νέα-γραμμή. # GET
Έξοδος γράψε: ['HTTP-POST c='] + ( αίτηση post: ['c'] ), νέα-γραμμή. # POST


# ~ Βάση δεδομένων ~
>> βδ := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], κωδικός: ['pass123'], όνομα-βάσης: ['xobase'], συνδέσου.

>> επερώτηση := βδ ερώτημα: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], παράμετροι: ( Λίστα νέο ; ['abc'] ; 12.35 ; 6 ). # παραμετροποιημένα ερωτήματα

{  επερώτηση εκτέλεση. βδ επικύρωση. } σύλληψη: { :e βδ αναίρεση.  }, εκκίνηση. # συναλλαγές
Έξοδος γράψε: ['ΕΙΣΗΧΘΗ: '] + επερώτηση insert-id, νέα-γραμμή. # id εισαγωγής

>> επερώτηση :=
βδ ερώτημα: ['SELECT * FROM book order by id desc limit 2'], 
ανάκτηση: { :εγγραφή 
	Έξοδος γράψε: εγγραφή id + [' '] + εγγραφή description + [': '] + εγγραφή price, νέα-γραμμή.
	#True break.
}. # ανάκτηση γραμμών

>> επερώτηση :=
βδ ερώτημα: ['SELECT * FROM book order by id desc limit 2'], 
ανάκτηση: { :εγγραφή 
	Έξοδος γράψε: εγγραφή id + [' '] + εγγραφή description + [': '] + εγγραφή price, νέα-γραμμή.
	#True break.
}. # ανάκτηση γραμμών


# ~ CURL ~
Έξοδος γράψε: ( Δίκτυο post: Κενό προς: ['https://xoscript.com'] ) μήκος, νέα-γραμμή. # αποστολή χωρίς δεδομένα = GET

# ~ JSON ~
>> json-κείμενο := (JSON jsonify: (Λεξικό νέο τοποθέτηση: (Λίστα νέο ; 1 ; 2 ; 3) στο: ['abc'])).
Έξοδος γράψε: json-κείμενο, νέα-γραμμή.
Έξοδος γράψε: ((JSON αντικείμενο: json-κείμενο) abc ? 1), νέα-γραμμή.

# ~ Κρυπτογράφηση ~
>> κρύπτη := Θησαυροφυλάκιο νέο: ['Encryptor'].
Έξοδος γράψε: ['κρυπτογράφηση:'], νέα-γραμμή.
>> x := Θησαυροφυλάκιο κρυπτογράφηση: ['hello'] κλειδί: ['world'].
Έξοδος γράψε: x, νέα-γραμμή.
Έξοδος γράψε: ['αποκρυπτογράφηση:'], νέα-γραμμή.
Έξοδος γράψε: (Θησαυροφυλάκιο αποκρυπτογράφηση: x κλειδί: ['world']), νέα-γραμμή.


# ~ Χειριστής συνεδριών (αποθηκεύονται από προεπιλογή στο /tmp) ~
Πρόγραμμα χρήση: ['el/webtools.xo'].
>> σελίδα := Έγγραφο-Ιστού νέο.
>> x := σελίδα ξεκίνα-συνεδρία.
Έξοδος γράψε: x, νέα-γραμμή.
x user: 123.
σελίδα κατάστρεψε-συνεδρία.
σελίδα μετάβαση: ['/'].

# ~ Πρότυπο ~
Πρόγραμμα χρήση: ['el/template.xo'].
>> html-κώδικας := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> υπόδειγμα := Πρότυπο νέο περιεχόμενο: html-κώδικας.
>> greeting := υπόδειγμα αποκοπή: ['greeting'], αντιγραφή greeting: ['Γεια σου Κόσμε!'].
υπόδειγμα επικόλλησε: greeting στο: ['greetings'].

Έξοδος γράψε: ['========================='], νέα-γραμμή.
>> σελίδα := Έγγραφο-Ιστού νέο.
σελίδα έξοδος: υπόδειγμα συμμάζεψε-όλα.

# ~ Κανονικές εκφράσεις ~
>> πηγή := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> μοτίβο-αναζήτησης := Μοτίβο νέο: ['href="([^"]+)" target="([^"]+)"'].
>> τελικό  := μοτίβο-αναζήτησης ταίριασμα: πηγή κάνε: { :m :x
	Έξοδος γράψε: m, νέα-γραμμή.
	Έξοδος γράψε: x, νέα-γραμμή.
	<- ['XXX'].
}.
Έξοδος γράψε: τελικό, νέα-γραμμή.

# ~ Βοηθητικά εργαλεία ~
Έξοδος γράψε: (Server html-κωδικοποίηση: ['<&"' hello '"&>']), νέα-γραμμή.
Έξοδος γράψε: (Server url-κωδικοποίηση: ['https://example.com?a=6&b=1 2']), νέα-γραμμή.
Έξοδος γράψε: (Μορφή νέο: ['Number format: %06.0f \n'], εφαρμογή: 56), νέα-γραμμή.
Έξοδος γράψε: (Θησαυροφυλάκιο διακριτικό: 20), νέα-γραμμή.
Έξοδος γράψε: (Στιγμή νέο μορφή: ['%a, %d %b %Y %H:%M:%S']), νέα-γραμμή.
>> a := Server base64-κωδικοποίηση: ['abc123'].
Έξοδος γράψε: a, νέα-γραμμή.
Έξοδος γράψε: (Server base64-αποκωδικοποίηση: a), νέα-γραμμή.

>> σύνδεσμος := URL νέο.
σύνδεσμος πρωτόκολλο: ['http'], κόμβος: ['example.com'], διαδρομή: ['path'], παράμετροι-url: (
	Λεξικό νέο
	a: ['1+'],
	b: 2
).
Έξοδος γράψε: σύνδεσμος, νέα-γραμμή.
