{ :i
 
	(i = 0) συνέχεια.

	(i % 15 = 0) αληθές: {
		Έξοδος γράψε: ['FizzBuzz'], νέα-γραμμή.
	}, συνέχεια.

	(i % 3 = 0) αληθές: {
		Έξοδος γράψε: ['Fizz'], νέα-γραμμή.
	}, συνέχεια.

	(i % 5 = 0) αληθές: {
		Έξοδος γράψε: ['Buzz'], νέα-γραμμή.
	}, συνέχεια.

	Έξοδος γράψε: i, νέα-γραμμή.
 
} * 101.
