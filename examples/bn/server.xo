# অল-ইন-ওয়ান সার্ভার ডেমো
#
# - HTTP অনুরোধ হ্যান্ডলার
# - মৌলিক সেশন হ্যান্ডলার
# - ডাটাবেস অবজেক্ট (MariaDB)
# - CURL
# - JSON
# - এনক্রিপশন
#
# SQL উদাহরণ:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 4.

# ~ HTTP অনুরোধ ~
Server প্রস্তুত-করো.
>> অনুরোধ := HTTP-অনুরোধ নতুন.
আউটপুট লেখো: ['HTTP-GET a='] + ( অনুরোধ get: ['a'] ), নতুন-লাইন. # GET
আউটপুট লেখো: ['HTTP-POST c='] + ( অনুরোধ post: ['c'] ), নতুন-লাইন. # POST


# ~ ডাটাবেস ~
>> ডিবি := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'], পাসওয়ার্ড: ['pass123'], ডেটাবেস-নাম: ['xobase'], যুক্ত-হও.

>> sql-কোয়েরি := ডিবি কোয়েরি: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], প্যারামিটার: ( লিস্ট নতুন ; ['abc'] ; 12.35 ; 6 ). # প্যারামিটারযুক্ত কোয়েরি

{  sql-কোয়েরি নির্বাহ. ডিবি নিশ্চিত. } ধরো: { :e ডিবি ফিরিয়ে-নাও.  }, চালাও. # ট্রানজ্যাকশন
আউটপুট লেখো: ['সন্নিবেশিত: '] + sql-কোয়েরি insert-id, নতুন-লাইন. # সন্নিবেশিত আইডি

>> sql-কোয়েরি :=
ডিবি কোয়েরি: ['SELECT * FROM book order by id desc limit 2'], 
আনো: { :সারি 
	আউটপুট লেখো: সারি id + [' '] + সারি description + [': '] + সারি price, নতুন-লাইন.
	#True break.
}. # সারি আনা

>> sql-কোয়েরি :=
ডিবি কোয়েরি: ['SELECT * FROM book order by id desc limit 2'], 
আনো: { :সারি 
	আউটপুট লেখো: সারি id + [' '] + সারি description + [': '] + সারি price, নতুন-লাইন.
	#True break.
}. # সারি আনা


# ~ CURL ~
আউটপুট লেখো: ( নেটওয়ার্ক post: শূন্য প্রতি: ['https://xoscript.com'] ) দৈর্ঘ্য, নতুন-লাইন. # কিছু পোস্ট না করা = GET

# ~ JSON ~
>> json-লেখা := (JSON jsonify: (অভিধান নতুন রাখো: (লিস্ট নতুন ; 1 ; 2 ; 3) চাবিতে: ['abc'])).
আউটপুট লেখো: json-লেখা, নতুন-লাইন.
আউটপুট লেখো: ((JSON বস্তু: json-লেখা) abc ? 1), নতুন-লাইন.

# ~ এনক্রিপশন ~
>> ভল্ট := সিন্দুক নতুন: ['Encryptor'].
আউটপুট লেখো: ['এনক্রিপ্ট:'], নতুন-লাইন.
>> x := সিন্দুক এনক্রিপ্ট: ['hello'] চাবি: ['world'].
আউটপুট লেখো: x, নতুন-লাইন.
আউটপুট লেখো: ['ডিক্রিপ্ট:'], নতুন-লাইন.
আউটপুট লেখো: (সিন্দুক ডিক্রিপ্ট: x চাবি: ['world']), নতুন-লাইন.


# ~ সেশন হ্যান্ডলার (ডিফল্টভাবে /tmp-এ সংরক্ষিত) ~
প্রোগ্রাম ব্যবহার: ['bn/webtools.xo'].
>> পাতা := ওয়েব-নথি নতুন.
>> x := পাতা সেশন-শুরু-করো.
আউটপুট লেখো: x, নতুন-লাইন.
x user: 123.
পাতা সেশন-ধ্বংস-করো.
পাতা যাও: ['/'].

# ~ টেমপ্লেট ~
প্রোগ্রাম ব্যবহার: ['bn/template.xo'].
>> html-কোড := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> টেমপ্লেট := ছাঁচ নতুন বিষয়বস্তু: html-কোড.
>> greeting := টেমপ্লেট কাটো: ['greeting'], অনুলিপি greeting: ['হ্যালো ওয়ার্ল্ড!'].
টেমপ্লেট সাঁটো: greeting চাবিতে: ['greetings'].

আউটপুট লেখো: ['========================='], নতুন-লাইন.
>> পাতা := ওয়েব-নথি নতুন.
পাতা আউটপুট-দাও: টেমপ্লেট সব-চিহ্ন-মোছো.

# ~ রেগুলার এক্সপ্রেশন ~
>> উৎস-লেখা := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> নকশা := প্যাটার্ন নতুন: ['href="([^"]+)" target="([^"]+)"'].
>> ফল  := নকশা মিল: উৎস-লেখা করো: { :m :x
	আউটপুট লেখো: m, নতুন-লাইন.
	আউটপুট লেখো: x, নতুন-লাইন.
	<- ['XXX'].
}.
আউটপুট লেখো: ফল, নতুন-লাইন.

# ~ ইউটিলিটি ~
আউটপুট লেখো: (Server html-এনকোড: ['<&"' hello '"&>']), নতুন-লাইন.
আউটপুট লেখো: (Server url-এনকোড: ['https://example.com?a=6&b=1 2']), নতুন-লাইন.
আউটপুট লেখো: (বিন্যাস নতুন: ['Number format: %06.0f \n'], প্রয়োগ: 56), নতুন-লাইন.
আউটপুট লেখো: (সিন্দুক টোকেন: 20), নতুন-লাইন.
আউটপুট লেখো: (মুহূর্ত নতুন বিন্যাসে: ['%a, %d %b %Y %H:%M:%S']), নতুন-লাইন.
>> a := Server base64-এনকোড: ['abc123'].
আউটপুট লেখো: a, নতুন-লাইন.
আউটপুট লেখো: (Server base64-ডিকোড: a), নতুন-লাইন.

>> u := URL নতুন.
u প্রোটোকল: ['http'], হোস্ট: ['example.com'], ফাইল-পথ: ['path'], url-প্যারামিটার: (
	অভিধান নতুন
	a: ['1+'],
	b: 2
).
আউটপুট লেখো: u, নতুন-লাইন.
