# Демонстрація сервера «все в одному»
#
# - Обробник HTTP-запитів
# - Базовий обробник сесій
# - Обʼєкт бази даних (MariaDB)
# - CURL
# - JSON
# - Шифрування
#
# Приклад SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Програма керування-памʼяттю: 4.

# ~ HTTP-запити ~
Server ініціалізувати.
>> вхідний-запит := HTTP-Запит новий.
Вивід написати: ['HTTP-GET a='] + ( вхідний-запит get: ['a'] ), новий-рядок. # GET
Вивід написати: ['HTTP-POST c='] + ( вхідний-запит post: ['c'] ), новий-рядок. # POST


# ~ База даних ~
>> бд := Maria-DB новий хост: ['localhost'],
	користувач: ['xo'], пароль: ['pass123'], назва-бази: ['xobase'], підключити.

>> sql-запит := бд запит: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Список новий ; ['abc'] ; 12.35 ; 6 ). # параметризовані запити

{  sql-запит виконати. бд підтвердити. } перехопити: { :e бд відкотити.  }, запустити. # транзакції
Вивід написати: ['ВСТАВЛЕНО: '] + sql-запит insert-id, новий-рядок. # id вставлення

>> sql-запит :=
бд запит: ['SELECT * FROM book order by id desc limit 2'], 
отримати: { :запис 
	Вивід написати: запис id + [' '] + запис description + [': '] + запис price, новий-рядок.
	#True break.
}. # отримання рядків

>> sql-запит :=
бд запит: ['SELECT * FROM book order by id desc limit 2'], 
отримати: { :запис 
	Вивід написати: запис id + [' '] + запис description + [': '] + запис price, новий-рядок.
	#True break.
}. # отримання рядків


# ~ CURL ~
Вивід написати: ( Мережа post: Ніщо до: ['https://xoscript.com'] ) довжина, новий-рядок. # post без даних = GET

# ~ JSON ~
>> json-текст := (JSON jsonify: (Словник новий поставити: (Список новий ; 1 ; 2 ; 3) у: ['abc'])).
Вивід написати: json-текст, новий-рядок.
Вивід написати: ((JSON обʼєкт: json-текст) abc ? 1), новий-рядок.

# ~ Шифрування ~
>> сейф := Сховище новий: ['Encryptor'].
Вивід написати: ['зашифрувати:'], новий-рядок.
>> x := Сховище шифрувати: ['hello'] ключ: ['world'].
Вивід написати: x, новий-рядок.
Вивід написати: ['розшифрувати:'], новий-рядок.
Вивід написати: (Сховище розшифрувати: x ключ: ['world']), новий-рядок.


# ~ Обробник сесій (за замовчуванням зберігається в /tmp) ~
Програма використати: ['uk/webtools.xo'].
>> веб := Веб-документ новий.
>> x := веб почати-сесію.
Вивід написати: x, новий-рядок.
x user: 123.
веб знищити-сесію.
веб перейти-до: ['/'].

# ~ Шаблон ~
Програма використати: ['uk/template.xo'].
>> html-код := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> шаблон-сторінки := Заготовка новий вміст: html-код.
>> greeting := шаблон-сторінки вирізати: ['greeting'], копіювати greeting: ['Привіт, світе!'].
шаблон-сторінки вставити: greeting у: ['greetings'].

Вивід написати: ['========================='], новий-рядок.
>> веб := Веб-документ новий.
веб вивести: шаблон-сторінки підчистити-все.

# ~ Регулярні вирази ~
>> вхідний-текст := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> регвираз := Шаблон новий: ['href="([^"]+)" target="([^"]+)"'].
>> результат  := регвираз збіг: вхідний-текст виконати: { :m :x
	Вивід написати: m, новий-рядок.
	Вивід написати: x, новий-рядок.
	<- ['XXX'].
}.
Вивід написати: результат, новий-рядок.

# ~ Утиліти ~
Вивід написати: (Server html-кодувати: ['<&"' hello '"&>']), новий-рядок.
Вивід написати: (Server url-кодувати: ['https://example.com?a=6&b=1 2']), новий-рядок.
Вивід написати: (Формат новий: ['Number format: %06.0f \n'], застосувати: 56), новий-рядок.
Вивід написати: (Сховище токен: 20), новий-рядок.
Вивід написати: (Момент новий формат: ['%a, %d %b %Y %H:%M:%S']), новий-рядок.
>> a := Server base64-кодувати: ['abc123'].
Вивід написати: a, новий-рядок.
Вивід написати: (Server base64-декодувати: a), новий-рядок.

>> u := URL новий.
u протокол: ['http'], хост: ['example.com'], шлях: ['path'], параметри-url: (
	Словник новий
	a: ['1+'],
	b: 2
).
Вивід написати: u, новий-рядок.
