{ :i
 
	(i = 0) продовжувати.

	(i % 15 = 0) істина: {
		Вивід написати: ['FizzBuzz'], новий-рядок.
	}, продовжувати.

	(i % 3 = 0) істина: {
		Вивід написати: ['Fizz'], новий-рядок.
	}, продовжувати.

	(i % 5 = 0) істина: {
		Вивід написати: ['Buzz'], новий-рядок.
	}, продовжувати.

	Вивід написати: i, новий-рядок.
 
} * 101.
