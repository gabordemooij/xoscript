{ :i
 
	(i = 0) davom.

	(i % 15 = 0) rost-boʻlsa: {
		Chiqish yozish: ['FizzBuzz'], yangi-qator.
	}, davom.

	(i % 3 = 0) rost-boʻlsa: {
		Chiqish yozish: ['Fizz'], yangi-qator.
	}, davom.

	(i % 5 = 0) rost-boʻlsa: {
		Chiqish yozish: ['Buzz'], yangi-qator.
	}, davom.

	Chiqish yozish: i, yangi-qator.
 
} * 101.
