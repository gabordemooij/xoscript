{ :i
 
	(i = 0) nadaljuj.

	(i % 15 = 0) resnično: {
		Izhod piši: ['FizzBuzz'], nova-vrstica.
	}, nadaljuj.

	(i % 3 = 0) resnično: {
		Izhod piši: ['Fizz'], nova-vrstica.
	}, nadaljuj.

	(i % 5 = 0) resnično: {
		Izhod piši: ['Buzz'], nova-vrstica.
	}, nadaljuj.

	Izhod piši: i, nova-vrstica.
 
} * 101.
