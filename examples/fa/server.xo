# نمونه سرور جامع
#
# - پردازشگر درخواست HTTP
# - مدیریت ساده نشست
# - شیء پایگاه داده (MariaDB)
# - CURL
# - JSON
# - رمزنگاری
#
# نمونه SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

برنامه مدیریت-حافظه: 4.

# ~ درخواست HTTP ~
Server آماده-سازی.
>> درخواست := درخواست-HTTP جدید.
خروجی بنویس: ⌝'HTTP-GET a='⌜ + ﴿ درخواست get: ⌝'a'⌜ ﴾, سطر-نو. # GET
خروجی بنویس: ⌝'HTTP-POST c='⌜ + ﴿ درخواست post: ⌝'c'⌜ ﴾, سطر-نو. # POST


# ~ پایگاه داده ~
>> پد := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜, گذرواژه: ⌝'pass123'⌜, نام-پایگاه: ⌝'xobase'⌜, وصل-شو.

>> پرسمان := پد پرس-و-جو: ⌝'
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'⌜, پارامترها: ﴿ لیست جدید ; ⌝'abc'⌜ ; 12.35 ; 6 ﴾. # پرس‌وجوهای پارامتری

⎬  پرسمان اجرا-کن. پد تایید. ⎨ بگیر: ⎬ :e پد برگردان.  ⎨, اجرا. # تراکنش
خروجی بنویس: ⌝'درج شد: '⌜ + پرسمان insert-id, سطر-نو. # شناسه درج

>> پرسمان :=
پد پرس-و-جو: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
واکشی: ⎬ :سطر 
	خروجی بنویس: سطر id + ⌝' '⌜ + سطر description + ⌝': '⌜ + سطر price, سطر-نو.
	#True break.
⎨. # واکشی سطرها

>> پرسمان :=
پد پرس-و-جو: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
واکشی: ⎬ :سطر 
	خروجی بنویس: سطر id + ⌝' '⌜ + سطر description + ⌝': '⌜ + سطر price, سطر-نو.
	#True break.
⎨. # واکشی سطرها


# ~ CURL ~
خروجی بنویس: ﴿ شبکه post: هیچ به: ⌝'https://xoscript.com'⌜ ﴾ طول, سطر-نو. # ارسال خالی = GET

# ~ JSON ~
>> جیسون := ﴿JSON jsonify: ﴿واژه-نامه جدید بگذار: ﴿لیست جدید ; 1 ; 2 ; 3﴾ کلید: ⌝'abc'⌜﴾﴾.
خروجی بنویس: جیسون, سطر-نو.
خروجی بنویس: ﴿﴿JSON شیء: جیسون﴾ abc ? 1﴾, سطر-نو.

# ~ رمزنگاری ~
>> صندوقچه := گاوصندوق جدید: ⌝'Encryptor'⌜.
خروجی بنویس: ⌝'رمزگذاری:'⌜, سطر-نو.
>> x := گاوصندوق رمزگذاری: ⌝'hello'⌜ کلید: ⌝'world'⌜.
خروجی بنویس: x, سطر-نو.
خروجی بنویس: ⌝'رمزگشایی:'⌜, سطر-نو.
خروجی بنویس: ﴿گاوصندوق رمزگشایی: x کلید: ⌝'world'⌜﴾, سطر-نو.


# ~ مدیریت نشست (به طور پیش فرض در /tmp ذخیره می شود) ~
برنامه به-کار-ببر: ⌝'fa/webtools.xo'⌜.
>> صفحه := سند-وب جدید.
>> x := صفحه شروع-نشست.
خروجی بنویس: x, سطر-نو.
x user: 123.
صفحه نابودی-نشست.
صفحه برو-به: ⌝'/'⌜.

# ~ قالب ~
برنامه به-کار-ببر: ⌝'fa/template.xo'⌜.
>> کد-صفحه := ⌝'
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'⌜.

>> قالب-صفحه := شابلون جدید محتوا: کد-صفحه.
>> greeting := قالب-صفحه برش: ⌝'greeting'⌜, رونوشت greeting: ⌝'سلام دنیا!'⌜.
قالب-صفحه بچسبان: greeting کلید: ⌝'greetings'⌜.

خروجی بنویس: ⌝'========================='⌜, سطر-نو.
>> صفحه := سند-وب جدید.
صفحه خروجی-بده: قالب-صفحه زدودن-همه.

# ~ عبارات منظم ~
>> متن := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> الگوی-جستجو := الگو جدید: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> نتیجه  := الگوی-جستجو تطبیق: متن انجام: ⎬ :m :x
	خروجی بنویس: m, سطر-نو.
	خروجی بنویس: x, سطر-نو.
	<- ⌝'XXX'⌜.
⎨.
خروجی بنویس: نتیجه, سطر-نو.

# ~ ابزارهای کمکی ~
خروجی بنویس: ﴿Server html-کدگذاری: ⌝'<&"' hello '"&>'⌜﴾, سطر-نو.
خروجی بنویس: ﴿Server url-کدگذاری: ⌝'https://example.com?a=6&b=1 2'⌜﴾, سطر-نو.
خروجی بنویس: ﴿قالب جدید: ⌝'Number format: %06.0f \n'⌜, اعمال: 56﴾, سطر-نو.
خروجی بنویس: ﴿گاوصندوق توکن: 20﴾, سطر-نو.
خروجی بنویس: ﴿لحظه جدید با-قالب: ⌝'%a, %d %b %Y %H:%M:%S'⌜﴾, سطر-نو.
>> a := Server base64-کدگذاری: ⌝'abc123'⌜.
خروجی بنویس: a, سطر-نو.
خروجی بنویس: ﴿Server base64-کدگشایی: a﴾, سطر-نو.

>> آدرس := URL جدید.
آدرس پروتکل: ⌝'http'⌜, میزبان: ⌝'example.com'⌜, مسیر-پرونده: ⌝'path'⌜, پارامترهای-url: ﴿
	واژه-نامه جدید
	a: ⌝'1+'⌜,
	b: 2
﴾.
خروجی بنویس: آدرس, سطر-نو.
