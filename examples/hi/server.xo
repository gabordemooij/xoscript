# ऑल-इन-वन सर्वर डेमो
#
# - HTTP अनुरोध हैंडलर
# - बुनियादी सत्र हैंडलर
# - डेटाबेस ऑब्जेक्ट (MariaDB)
# - CURL
# - JSON
# - एन्क्रिप्शन
#
# SQL उदाहरण:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

प्रोग्राम मेमोरी-प्रबंधन: 4.

# ~ HTTP अनुरोध ~
Server आरंभ-करें.
>> अनुरोध := HTTP-अनुरोध नया.
निर्गम लिखो: ['HTTP-GET a='] + ( अनुरोध get: ['a'] ), नई-पंक्ति. # GET
निर्गम लिखो: ['HTTP-POST c='] + ( अनुरोध post: ['c'] ), नई-पंक्ति. # POST


# ~ डेटाबेस ~
>> डीबी := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'], पासवर्ड: ['pass123'], डेटाबेस-नाम: ['xobase'], जुड़ो.

>> प्रश्न := डीबी क्वेरी: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], पैरामीटर: ( सूची नया ; ['abc'] ; 12.35 ; 6 ). # पैरामीटर वाली क्वेरी

{  प्रश्न निष्पादन. डीबी पुष्टि. } पकड़ो: { :e डीबी वापस-लो.  }, चलाओ. # ट्रांज़ैक्शन
निर्गम लिखो: ['जोड़ा गया: '] + प्रश्न insert-id, नई-पंक्ति. # डाली गई आईडी

>> प्रश्न :=
डीबी क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
लाओ: { :रिकॉर्ड 
	निर्गम लिखो: रिकॉर्ड id + [' '] + रिकॉर्ड description + [': '] + रिकॉर्ड price, नई-पंक्ति.
	#True break.
}. # पंक्तियाँ लाना

>> प्रश्न :=
डीबी क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
लाओ: { :रिकॉर्ड 
	निर्गम लिखो: रिकॉर्ड id + [' '] + रिकॉर्ड description + [': '] + रिकॉर्ड price, नई-पंक्ति.
	#True break.
}. # पंक्तियाँ लाना


# ~ CURL ~
निर्गम लिखो: ( नेटवर्क post: शून्य को: ['https://xoscript.com'] ) लंबाई, नई-पंक्ति. # खाली post = GET

# ~ JSON ~
>> जेसन := (JSON jsonify: (शब्दकोश नया रखो: (सूची नया ; 1 ; 2 ; 3) कुंजी: ['abc'])).
निर्गम लिखो: जेसन, नई-पंक्ति.
निर्गम लिखो: ((JSON वस्तु: जेसन) abc ? 1), नई-पंक्ति.

# ~ एन्क्रिप्शन ~
>> कोष := तिजोरी नया: ['Encryptor'].
निर्गम लिखो: ['एन्क्रिप्ट:'], नई-पंक्ति.
>> x := तिजोरी एन्क्रिप्ट: ['hello'] कुंजी: ['world'].
निर्गम लिखो: x, नई-पंक्ति.
निर्गम लिखो: ['डिक्रिप्ट:'], नई-पंक्ति.
निर्गम लिखो: (तिजोरी डिक्रिप्ट: x कुंजी: ['world']), नई-पंक्ति.


# ~ सत्र हैंडलर (डिफ़ॉल्ट रूप से /tmp में संग्रहीत) ~
प्रोग्राम उपयोग: ['hi/webtools.xo'].
>> पृष्ठ := वेब-दस्तावेज़ नया.
>> x := पृष्ठ सत्र-आरंभ-करें.
निर्गम लिखो: x, नई-पंक्ति.
x user: 123.
पृष्ठ सत्र-नष्ट-करें.
पृष्ठ जाएँ: ['/'].

# ~ टेम्पलेट ~
प्रोग्राम उपयोग: ['hi/template.xo'].
>> मार्कअप := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> टेम्पलेट := साँचा नया विषयवस्तु: मार्कअप.
>> greeting := टेम्पलेट काटें: ['greeting'], प्रतिलिपि greeting: ['नमस्ते दुनिया!'].
टेम्पलेट चिपकाएँ: greeting कुंजी: ['greetings'].

निर्गम लिखो: ['========================='], नई-पंक्ति.
>> पृष्ठ := वेब-दस्तावेज़ नया.
पृष्ठ आउटपुट-करें: टेम्पलेट सब-चिह्न-हटाएँ.

# ~ रेगुलर एक्सप्रेशन ~
>> स्रोत := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> प्रतिरूप := पैटर्न नया: ['href="([^"]+)" target="([^"]+)"'].
>> नतीजा  := प्रतिरूप मिलान: स्रोत करो: { :m :x
	निर्गम लिखो: m, नई-पंक्ति.
	निर्गम लिखो: x, नई-पंक्ति.
	<- ['XXX'].
}.
निर्गम लिखो: नतीजा, नई-पंक्ति.

# ~ उपयोगिताएँ ~
निर्गम लिखो: (Server html-एनकोड: ['<&"' hello '"&>']), नई-पंक्ति.
निर्गम लिखो: (Server url-एनकोड: ['https://example.com?a=6&b=1 2']), नई-पंक्ति.
निर्गम लिखो: (प्रारूप नया: ['Number format: %06.0f \n'], लागू: 56), नई-पंक्ति.
निर्गम लिखो: (तिजोरी टोकन: 20), नई-पंक्ति.
निर्गम लिखो: (क्षण नया प्रारूप-में: ['%a, %d %b %Y %H:%M:%S']), नई-पंक्ति.
>> a := Server base64-एनकोड: ['abc123'].
निर्गम लिखो: a, नई-पंक्ति.
निर्गम लिखो: (Server base64-डिकोड: a), नई-पंक्ति.

>> कड़ी := URL नया.
कड़ी प्रोटोकॉल: ['http'], होस्ट: ['example.com'], फ़ाइल-पथ: ['path'], url-पैरामीटर: (
	शब्दकोश नया
	a: ['1+'],
	b: 2
).
निर्गम लिखो: कड़ी, नई-पंक्ति.
