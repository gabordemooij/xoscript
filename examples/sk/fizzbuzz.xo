{ :i
 
	(i = 0) pokračovať.

	(i % 15 = 0) pravda: {
		Výstup písať: ['FizzBuzz'], nový-riadok.
	}, pokračovať.

	(i % 3 = 0) pravda: {
		Výstup písať: ['Fizz'], nový-riadok.
	}, pokračovať.

	(i % 5 = 0) pravda: {
		Výstup písať: ['Buzz'], nový-riadok.
	}, pokračovať.

	Výstup písať: i, nový-riadok.
 
} * 101.
