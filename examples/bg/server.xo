# Демонстрация на универсален сървър
#
# - Обработчик на HTTP заявки
# - Основен обработчик на сесии
# - Обект за база данни (MariaDB)
# - CURL
# - JSON
# - Криптиране
#
# SQL пример:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Програма управление-на-паметта: 4.

# ~ HTTP заявки ~
Server инициализирай.
>> http-искане := HTTP-Заявка нов.
Изход пиши: ['HTTP-GET a='] + ( http-искане get: ['a'] ), нов-ред. # GET
Изход пиши: ['HTTP-POST c='] + ( http-искане post: ['c'] ), нов-ред. # POST


# ~ База данни ~
>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], парола: ['pass123'], име-на-база: ['xobase'], свържи-се.

>> запитване := бд заявка: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Списък нов ; ['abc'] ; 12.35 ; 6 ). # параметризирани заявки

{  запитване изпълни. бд потвърди. } прихвани: { :грешката бд отмени.  }, стартирай. # транзакции
Изход пиши: ['ВМЪКНАТО: '] + запитване insert-id, нов-ред. # идентификатор на вмъкването

>> запитване :=
бд заявка: ['SELECT * FROM book order by id desc limit 2'], 
извлечи: { :запис 
	Изход пиши: запис id + [' '] + запис description + [': '] + запис price, нов-ред.
	#True break.
}. # извличане на редове

>> запитване :=
бд заявка: ['SELECT * FROM book order by id desc limit 2'], 
извлечи: { :запис 
	Изход пиши: запис id + [' '] + запис description + [': '] + запис price, нов-ред.
	#True break.
}. # извличане на редове


# ~ CURL ~
Изход пиши: ( Мрежа post: Нищо към: ['https://xoscript.com'] ) дължина, нов-ред. # post без данни = GET

# ~ JSON ~
>> json-текст := (JSON jsonify: (Речник нов постави: (Списък нов ; 1 ; 2 ; 3) на: ['abc'])).
Изход пиши: json-текст, нов-ред.
Изход пиши: ((JSON обект: json-текст) abc ? 1), нов-ред.

# ~ Криптиране ~
>> трезор := Трезор нов: ['Encryptor'].
Изход пиши: ['криптиране:'], нов-ред.
>> x := Трезор шифровай: ['hello'] ключ: ['world'].
Изход пиши: x, нов-ред.
Изход пиши: ['декриптиране:'], нов-ред.
Изход пиши: (Трезор дешифровай: x ключ: ['world']), нов-ред.


# ~ Обработчик на сесии (по подразбиране се съхраняват в /tmp) ~
Програма използвай: ['bg/webtools.xo'].
>> страница := Уеб-документ нов.
>> x := страница започни-сесия.
Изход пиши: x, нов-ред.
x user: 123.
страница унищожи-сесия.
страница отиди-на: ['/'].

# ~ Шаблон ~
Програма използвай: ['bg/template.xo'].
>> html-код := ['
	<!-- cut:garbage -->
	<trash>
	<!-- /cut:garbage -->
	
	<p>
		
		<!-- cut:greeting -->
			<b><!-- slot:greeting --></b>
		<!-- /cut:greeting -->
		<!-- paste:greetings -->
		
		
    </p>
    
    <!-- cut:unused -->
    <span>remove this</span>
		<!-- cut:also -->
		<also>
		<!-- /cut:also -->
    <!-- /cut:unused -->
'].

>> шаблон := Образец нов съдържание: html-код.
>> greeting := шаблон изрежи: ['greeting'], копирай greeting: ['Здравей, свят!'].
шаблон вмъкни: greeting на: ['greetings'].

Изход пиши: ['========================='], нов-ред.
>> страница := Уеб-документ нов.
страница изведи: шаблон прочисти-всичко.

# ~ Регулярни изрази ~
>> изходен-текст := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> израз := Шаблон нов: ['href="([^"]+)" target="([^"]+)"'].
>> резултат  := израз съвпадение: изходен-текст изпълни: { :m :x
	Изход пиши: m, нов-ред.
	Изход пиши: x, нов-ред.
	<- ['XXX'].
}.
Изход пиши: резултат, нов-ред.

# ~ Помощни функции ~
Изход пиши: (Server html-кодирай: ['<&"' hello '"&>']), нов-ред.
Изход пиши: (Server url-кодирай: ['https://example.com?a=6&b=1 2']), нов-ред.
Изход пиши: (Формат нов: ['Number format: %06.0f \n'], приложи: 56), нов-ред.
Изход пиши: (Трезор токен: 20), нов-ред.
Изход пиши: (Момент нов формат: ['%a, %d %b %Y %H:%M:%S']), нов-ред.
>> a := Server base64-кодирай: ['abc123'].
Изход пиши: a, нов-ред.
Изход пиши: (Server base64-декодирай: a), нов-ред.

>> u := URL нов.
u протокол: ['http'], хост: ['example.com'], път: ['path'], параметри-url: (
	Речник нов
	a: ['1+'],
	b: 2
).
Изход пиши: u, нов-ред.
