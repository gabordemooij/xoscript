{ :i
 
	(i = 0) continuar.

	(i % 15 = 0) verdadero: {
		Salida escribir: ['FizzBuzz'], detener.
	}, continuar.

	(i % 3 = 0) verdadero: {
		Salida escribir: ['Fizz'], detener.
	}, continuar.

	(i % 5 = 0) verdadero: {
		Salida escribir: ['Buzz'], detener.
	}, continuar.

	Salida escribir: i, detener.
 
} * 101.
