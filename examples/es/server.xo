# Demostración de servidor todo en uno
#
# - Manejador de peticiones HTTP
# - Manejador básico de sesiones
# - Objeto de base de datos (MariaDB)
# - CURL
# - JSON
# - Cifrado
#
# Ejemplo de SQL:
# CREATE DATABASE xobase;
# CREATE USER 'xo'@'localhost' IDENTIFIED BY 'pass123';
# GRANT ALL PRIVILEGES ON xobase.* TO 'xo'@'localhost';
# FLUSH PRIVILEGES;
# ALTER DATABASE xobase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
# CREATE TABLE book ( id INT PRIMARY KEY AUTO_INCREMENT, description VARCHAR(255), price DECIMAL(10,2), rating INT(10) ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;

Programa orden: 4.

# ~ Peticiones HTTP ~
Server iniciar.
>> peticion := Petición-HTTP crear.
Salida escribir: ['HTTP-GET a='] + ( peticion obtener: ['a'] ), detener. # GET
Salida escribir: ['HTTP-POST c='] + ( peticion enviar: ['c'] ), detener. # POST


# ~ Base de datos ~
>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], contraseña: ['pass123'], nombre-base-datos: ['xobase'], conectar.

>> sentencia := bd consultar: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parámetros: ( Lista crear ; ['abc'] ; 12.35 ; 6 ). # consultas parametrizadas

{  sentencia ejecutar. bd confirmar. } capturar: { :e bd revertir.  }, empezar. # transacciones
Salida escribir: ['INSERTADO: '] + sentencia id-insertado, detener. # id insertado

>> sentencia :=
bd consultar: ['SELECT * FROM book order by id desc limit 2'], 
extraer: { :fila 
	Salida escribir: fila id + [' '] + fila description + [': '] + fila price, detener.
	#True break.
}. # obtención de filas

>> sentencia :=
bd consultar: ['SELECT * FROM book order by id desc limit 2'], 
extraer: { :fila 
	Salida escribir: fila id + [' '] + fila description + [': '] + fila price, detener.
	#True break.
}. # obtención de filas


# ~ CURL ~
Salida escribir: ( Red enviar: Nulo a: ['https://xoscript.com'] ) longitud, detener. # post vacío = GET

# ~ JSON ~
>> texto-json := (JSON jsonificar: (Diccionario crear poner: (Lista crear ; 1 ; 2 ; 3) en: ['abc'])).
Salida escribir: texto-json, detener.
Salida escribir: ((JSON objeto: texto-json) abc ? 1), detener.

# ~ Cifrado ~
>> boveda := Contenedor-seguro crear: ['Encryptor'].
Salida escribir: ['cifrar:'], detener.
>> x := Contenedor-seguro cifrar: ['hello'] clave: ['world'].
Salida escribir: x, detener.
Salida escribir: ['descifrar:'], detener.
Salida escribir: (Contenedor-seguro descifrar: x clave: ['world']), detener.


# ~ Manejador de sesiones (por defecto se guardan en /tmp) ~
Programa utilizar: ['es/webtools.xo'].
>> pagina := Documento-Web crear.
>> x := pagina empezar-sesión.
Salida escribir: x, detener.
x user: 123.
pagina borrar-sesión.
pagina ir-a: ['/'].

# ~ Plantilla ~
Programa utilizar: ['es/template.xo'].
>> codigo-html := ['
	<!-- cortar:garbage -->
	<trash>
	<!-- /cortar:garbage -->
	
	<p>
		
		<!-- cortar:greeting -->
			<b><!-- ranura:greeting --></b>
		<!-- /cortar:greeting -->
		<!-- pegar:greetings -->
		
		
    </p>
    
    <!-- cortar:unused -->
    <span>remove this</span>
		<!-- cortar:also -->
		<also>
		<!-- /cortar:also -->
    <!-- /cortar:unused -->
'].

>> molde := Plantilla crear contenido: codigo-html.
>> greeting := molde cortar: ['greeting'], copy greeting: ['¡Hola Mundo!'].
molde pegar: greeting en: ['greetings'].

Salida escribir: ['========================='], detener.
>> pagina := Documento-Web crear.
pagina salida: molde limpiar-todo.

# ~ Expresiones regulares ~
>> origen := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> patron := Patrón crear: ['href="([^"]+)" target="([^"]+)"'].
>> texto-final  := patron coincidir: origen ejecutar: { :m :x
	Salida escribir: m, detener.
	Salida escribir: x, detener.
	<- ['XXX'].
}.
Salida escribir: texto-final, detener.

# ~ Utilidades ~
Salida escribir: (Server codificar-html: ['<&"' hello '"&>']), detener.
Salida escribir: (Server codificar-url: ['https://example.com?a=6&b=1 2']), detener.
Salida escribir: (Formato crear: ['Number format: %06.0f \n'], aplicar: 56), detener.
Salida escribir: (Contenedor-seguro token: 20), detener.
Salida escribir: (Momento crear formato: ['%a, %d %b %Y %H:%M:%S']), detener.
>> a := Server codificar-base64: ['abc123'].
Salida escribir: a, detener.
Salida escribir: (Server decodificar-base64: a), detener.

>> enlace := URL crear.
enlace protocolo: ['http'], host: ['example.com'], path: ['path'], parámetros: (
	Diccionario crear
	a: ['1+'],
	b: 2
).
Salida escribir: enlace, detener.
