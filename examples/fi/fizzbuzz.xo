{ :i
 
	(i = 0) jatka.

	(i % 15 = 0) tosi: {
		Tuloste kirjoita: ['FizzBuzz'], rivinvaihto.
	}, jatka.

	(i % 3 = 0) tosi: {
		Tuloste kirjoita: ['Fizz'], rivinvaihto.
	}, jatka.

	(i % 5 = 0) tosi: {
		Tuloste kirjoita: ['Buzz'], rivinvaihto.
	}, jatka.

	Tuloste kirjoita: i, rivinvaihto.
 
} * 101.
