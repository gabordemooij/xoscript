{ :i
 
	(i = 0) pokračovat.

	(i % 15 = 0) pravda: {
		Výstup psát: ['FizzBuzz'], nový-řádek.
	}, pokračovat.

	(i % 3 = 0) pravda: {
		Výstup psát: ['Fizz'], nový-řádek.
	}, pokračovat.

	(i % 5 = 0) pravda: {
		Výstup psát: ['Buzz'], nový-řádek.
	}, pokračovat.

	Výstup psát: i, nový-řádek.
 
} * 101.
