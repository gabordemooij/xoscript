Server init.

Program memory-management: 4.

# Before running this example fill in the location to your libc
# Possible suggestions: (might be wrong, check with locate)
# Linux: ['/usr/lib/x86_64-linux-gnu/libc.so.6']
# OBSD:  ['/usr/lib/libc.so.103.0']

>> libname := None.

libname None? true: {
	Out write: ['Before running this example, provide the path to libc on this system.'], stop.
	Program end.
}.

Server link: (
 List new ;
 libname ;
 ['puts'] ;
 ( List new ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s free.

# test with struct

>> a := Blob new: 8.
a bytes: (
	List <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (List <<: ['int'], ; ['int']).

Server link: (
	List <<: ['@structtest'], ;
	['@structtest'] ;
	(List <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Out write: ['Sum test:'] + (ffitest ffisum: a), stop.

struct structfree.
struct free.
a free.
